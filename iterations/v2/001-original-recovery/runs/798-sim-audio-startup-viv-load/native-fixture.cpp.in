static void __declspec(noinline) capture_fpu(FpuSnapshot* out) {
    U mxcsr_val = 0u;
    __asm {
        fnstenv [fp_env]
        fxsave [fp_area]
        stmxcsr mxcsr_val
    }
    unsigned short cw = 0;
    unsigned short sw = 0;
    unsigned short tw = 0;
    std::memcpy(&cw, fp_env + 0, 2);
    std::memcpy(&sw, fp_env + 4, 2);
    std::memcpy(&tw, fp_env + 8, 2);
    out->control = cw;
    out->status = static_cast<unsigned short>(sw & 0x3800u);
    out->tag = tw;
    out->pad = 0;
    out->mxcsr = mxcsr_val;
    std::memcpy(out->values, fp_area + 32, 80);
    for (U i = 0u; i < 8u; ++i) {
        if ((fp_area[4u] & (1u << (((out->status >> 11u) + i) & 7u))) == 0u) {
            std::memset(out->values + i * 10u, 0, 10u);
        }
    }
}

