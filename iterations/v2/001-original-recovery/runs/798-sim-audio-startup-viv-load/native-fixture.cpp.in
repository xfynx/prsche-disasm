std::uint32_t __cdecl audio_resource_size_00566560(std::uint32_t source) {
    const B* p = reinterpret_cast<const B*>(static_cast<std::uintptr_t>(source));
    U total = 0u;
    if (p == big_v1_buf) {
        std::memcpy(&total, big_v1_buf + sizeof(big_v1_buf) - 4u, 4u);
    } else if (p == big_v2_buf) {
        std::memcpy(&total, big_v2_buf + sizeof(big_v2_buf) - 4u, 4u);
    } else if (p == big_bad_buf) {
        std::memcpy(&total, big_bad_buf + sizeof(big_bad_buf) - 4u, 4u);
    } else if (p == ocar_viv_buf) {
        std::memcpy(&total, ocar_viv_buf + sizeof(ocar_viv_buf) - 4u, 4u);
    } else if (p == cop_viv_buf) {
        std::memcpy(&total, cop_viv_buf + sizeof(cop_viv_buf) - 4u, 4u);
    }
    return total;
}

std::uint32_t __cdecl audio_resource_kind_00566520(std::uint32_t source) {
    const B* p = reinterpret_cast<const B*>(static_cast<std::uintptr_t>(source));
    if (std::memcmp(p, "BIGF", 4) == 0) {
        return 1u;
    }
    if (std::memcmp(p, "BIG4", 4) == 0) {
        return 2u;
    }
    return 0u;
}

std::uint32_t __cdecl audio_resource_data_offset_00566880(std::uint32_t source) {
    (void)source;
    return 3u;
}

std::uint32_t __cdecl audio_resource_locate_005666f0(
    std::uint32_t source, std::uint32_t name, std::uint32_t index,
    std::uint32_t out1, std::uint32_t out2) {
    (void)source;
    (void)name;
    U* p1 = reinterpret_cast<U*>(static_cast<std::uintptr_t>(out1));
    U* p2 = reinterpret_cast<U*>(static_cast<std::uintptr_t>(out2));
    if (p1 != nullptr) {
        *p1 = 0x1000u + index * 0x100u;
    }
    if (p2 != nullptr) {
        *p2 = 0x200u + index * 0x10u;
    }
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(kTrackNames[index % 3u]));
}

std::int32_t __cdecl crt_atoi_005a1f4a(const char* str) {
    return static_cast<std::int32_t>(std::atoi(str));
}

void* __cdecl resource_load_bigheader_0059dea0(const char* name, std::uint32_t flags) {
    push_event(kEvLoadBig, flags, static_cast<U>(std::strlen(name)));
    if (mock_fail_loads) {
        return nullptr;
    }
    if (std::strstr(name, "zzzwzzz.viv") != nullptr) {
        return ocar_viv_buf;
    }
    if (std::strstr(name, "zzzxeng.viv") != nullptr) {
        return cop_viv_buf;
    }
    return nullptr;
}

void* __cdecl resource_load_bigheader_quiet_0059df70(const char* name, std::uint32_t flags) {
    push_event(kEvLoadBigQuiet, flags, static_cast<U>(std::strlen(name)));
    if (mock_fail_loads) {
        return nullptr;
    }
    return trk_viv_buf;
}

bool __cdecl open_0059e040(const char* path, std::uint32_t mode, std::uint32_t flags, void** out_handle) {
    ++open_seq;
    push_event(kEvOpen, mode, flags);
    if (out_handle != nullptr) {
        *out_handle = reinterpret_cast<void*>(static_cast<std::uintptr_t>(0x7000u + open_seq));
    }
    (void)path;
    return mock_open_ret;
}

std::uint32_t __cdecl read_00533bf0(void* handle, std::uint32_t offset, void* dst, std::uint32_t bytes, std::uint32_t flags) {
    push_event(kEvRead, offset, bytes);
    (void)handle;
    (void)flags;
    if (dst != nullptr && bytes <= sizeof(kOneshotsText) - 1u) {
        std::memcpy(dst, kOneshotsText, bytes);
    }
    return bytes;
}

void* __cdecl allocate_00531ca0(const char* tag, std::int32_t bytes, std::uint32_t heap) {
    push_event(kEvAlloc, static_cast<U>(bytes), heap);
    (void)tag;
    const U aligned = (static_cast<U>(bytes) + 15u) & ~15u;
    if (alloc_cursor + aligned > sizeof(alloc_arena)) {
        fail("alloc_arena_exhausted");
    }
    void* const ptr = alloc_arena + alloc_cursor;
    alloc_cursor += aligned;
    std::memset(ptr, 0, aligned);
    return ptr;
}

std::uint32_t __cdecl free_00531f90(void* p) {
    U kind = 0u;
    if (p == ocar_viv_buf) kind = 1u;
    else if (p == trk_viv_buf) kind = 2u;
    else if (p == cop_viv_buf) kind = 3u;
    else if (p >= alloc_arena && p < alloc_arena + sizeof(alloc_arena)) kind = 4u;
    push_event(kEvFree, kind);
    return 0u;
}

