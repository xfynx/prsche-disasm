static void reset_all() {
    std::memset(&trace, 0, sizeof(trace));
    std::memset(alloc_arena, 0, sizeof(alloc_arena));
    alloc_cursor = 0u;
    open_seq = 0u;
    mock_fail_loads = false;
    mock_open_ret = true;

    std::memset(&porsche::application_state_006573e8, 0, sizeof(porsche::application_state_006573e8));
    porsche::application_audio_active_005d1734 = 0u;
    porsche::application_audio_path_prefix_0065b318 = kAudioPrefixStr;
    porsche::audio_speech_path_prefix_0065b31c = "speech/";

    std::memset(porsche::audio_queue_banks_00657308, 0x55, sizeof(porsche::audio_queue_banks_00657308));
    porsche::audio_queue_flag_00656af8 = 0x99u;
    porsche::audio_channel_flag_00657378 = 0x1234;
    porsche::audio_music_track_count_0065737c = 0x5678u;
    porsche::audio_state_byte_006573a6 = 0u;
    porsche::audio_pool_limit_00656afc = 0;
    porsche::audio_pool_base_00656acc = reinterpret_cast<B*>(0x12345678u);
}

static void finalize_trace() {
    trace.queue_flag = porsche::audio_queue_flag_00656af8;
    trace.chan_flag = porsche::audio_channel_flag_00657378;
    trace.track_count = porsche::audio_music_track_count_0065737c;
    trace.prim_handle = porsche::frame_audio_primary_handle_006573a8;
    trace.sec_handle = porsche::frame_audio_secondary_handle_006573ac;
    trace.extra_handles[0] = porsche::frame_audio_extra_handles_00656ae8[0];
    trace.extra_handles[1] = porsche::frame_audio_extra_handles_00656ae8[1];
    trace.w38c = porsche::audio_state_word_0065738c;
    trace.w39c = porsche::audio_state_word_0065739c;
    trace.w3a0 = porsche::audio_state_word_006573a0;
    trace.pool_nonnull = (porsche::audio_pool_base_00656acc != nullptr) ? 1u : 0u;
    trace.limit = porsche::audio_pool_limit_00656afc;
    trace.b3a6 = porsche::audio_state_byte_006573a6;
    std::memcpy(trace.banks, porsche::audio_queue_banks_00657308, sizeof(trace.banks));
    const U* const arena_lo = reinterpret_cast<const U*>(alloc_arena);
    const U* const arena_hi = reinterpret_cast<const U*>(alloc_arena + sizeof(alloc_arena));
    if (porsche::audio_queue_banks_00657308[0].entries_08 >= arena_lo &&
        porsche::audio_queue_banks_00657308[0].entries_08 < arena_hi) {
        const U* t0 = porsche::audio_queue_banks_00657308[0].entries_08;
        trace.bank0_pairs[0] = t0[512 * 2];
        trace.bank0_pairs[1] = t0[512 * 2 + 1];
        trace.bank0_pairs[2] = t0[12 * 2];
        trace.bank0_pairs[3] = t0[12 * 2 + 1];
        trace.bank0_pairs[4] = t0[7 * 2];
        trace.bank0_pairs[5] = t0[7 * 2 + 1];
    }
    if (porsche::audio_queue_banks_00657308[1].entries_08 >= arena_lo &&
        porsche::audio_queue_banks_00657308[1].entries_08 < arena_hi) {
        std::memcpy(trace.bank1_pairs, porsche::audio_queue_banks_00657308[1].entries_08, 10u * sizeof(U));
    }
    if (porsche::audio_queue_banks_00657308[2].entries_08 >= arena_lo &&
        porsche::audio_queue_banks_00657308[2].entries_08 < arena_hi) {
        std::memcpy(trace.bank2_pairs, porsche::audio_queue_banks_00657308[2].entries_08, 6u * sizeof(U));
    }
}

