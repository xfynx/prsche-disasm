static void write_u32(B* p, U value) {
    std::memcpy(p, &value, sizeof(value));
}

static void write_rel32(B* site, const void* target) {
    const I rel = static_cast<I>(
        reinterpret_cast<std::uintptr_t>(target) -
        (reinterpret_cast<std::uintptr_t>(site) + 4u));
    std::memcpy(site, &rel, sizeof(rel));
}

static void fail(const char* why) {
    std::printf("sim_audio_startup_viv_load_original_x86_vs_cpp=FAIL case=%u side=%u reason=%s\n",
                cases, which, why);
    std::exit(1);
}

static void push_event(U tag, U a0 = 0u, U a1 = 0u) {
    if (trace.count >= kMaxEvents) {
        fail("event_overflow");
    }
    trace.events[trace.count++] = Event{tag, a0, a1};
    ++events_total;
}

static U read_be(const void* src, U n) {
    const B* p = static_cast<const B*>(src);
    U v = 0u;
    for (U i = 0u; i < n; ++i) {
        v = (v << 8u) | p[i];
    }
    return v;
}

static U append_big_v1(B* buf, U pos, U off_val, U sz_val, const char* name) {
    buf[pos + 0] = static_cast<B>((off_val >> 16u) & 0xffu);
    buf[pos + 1] = static_cast<B>((off_val >> 8u) & 0xffu);
    buf[pos + 2] = static_cast<B>(off_val & 0xffu);
    buf[pos + 3] = static_cast<B>((sz_val >> 16u) & 0xffu);
    buf[pos + 4] = static_cast<B>((sz_val >> 8u) & 0xffu);
    buf[pos + 5] = static_cast<B>(sz_val & 0xffu);
    const U nlen = static_cast<U>(std::strlen(name)) + 1u;
    std::memcpy(buf + pos + 6u, name, nlen);
    return pos + 6u + nlen;
}

static U append_big_v2(B* buf, U pos, U off_val, U sz_val, const char* name) {
    buf[pos + 0] = static_cast<B>((off_val >> 24u) & 0xffu);
    buf[pos + 1] = static_cast<B>((off_val >> 16u) & 0xffu);
    buf[pos + 2] = static_cast<B>((off_val >> 8u) & 0xffu);
    buf[pos + 3] = static_cast<B>(off_val & 0xffu);
    buf[pos + 4] = static_cast<B>((sz_val >> 24u) & 0xffu);
    buf[pos + 5] = static_cast<B>((sz_val >> 16u) & 0xffu);
    buf[pos + 6] = static_cast<B>((sz_val >> 8u) & 0xffu);
    buf[pos + 7] = static_cast<B>(sz_val & 0xffu);
    const U nlen = static_cast<U>(std::strlen(name)) + 1u;
    std::memcpy(buf + pos + 8u, name, nlen);
    return pos + 8u + nlen;
}

static void init_big_archives() {
    std::memset(big_v1_buf, 0, sizeof(big_v1_buf));
    std::memcpy(big_v1_buf, "BIGF", 4);
    U p = append_big_v1(big_v1_buf, 6u, 0x112233u, 0x4455u, "Alpha.bnk");
    p = append_big_v1(big_v1_buf, p, 0x223344u, 0x6677u, "Beta.bnk");
    big_v1_buf[4] = static_cast<B>((p >> 24u) & 0xffu);
    big_v1_buf[5] = static_cast<B>((p >> 16u) & 0xffu);
    // Store total size in [4..7] via custom helper tag at [8..11]? No, audio_resource_size reads [4..7] in BIG!
    // Wait: BIGF has 6-byte header, while audio_resource_size reads BE32 at [4..7] -> put total in [4..7] only for BIG4!
    // For BIGF, our mock audio_resource_size reads offset 4 as 2 bytes or stores size in a side field at buf[0..1] if needed.
    // Let's make mock audio_resource_size use big_v1_len / big_v2_len stored right in buf[124..127] or BE32 at +4 for BIG4!
    write_u32(big_v1_buf + sizeof(big_v1_buf) - 4u, p);

    std::memset(big_v2_buf, 0, sizeof(big_v2_buf));
    std::memcpy(big_v2_buf, "BIG4", 4);
    p = append_big_v2(big_v2_buf, 16u, 0x10002000u, 0x300u, "First.bnk");
    p = append_big_v2(big_v2_buf, p, 0x20003000u, 0x400u, "Second.bnk");
    write_u32(big_v2_buf + sizeof(big_v2_buf) - 4u, p);

    std::memset(big_bad_buf, 0, sizeof(big_bad_buf));
    std::memcpy(big_bad_buf, "NONE", 4);
    write_u32(big_bad_buf + sizeof(big_bad_buf) - 4u, 16u);

    std::memset(ocar_viv_buf, 0, sizeof(ocar_viv_buf));
    std::memcpy(ocar_viv_buf, "BIG4", 4);
    p = append_big_v2(ocar_viv_buf, 16u, 0x100u, 0x20u, "rain.bnk");
    p = append_big_v2(ocar_viv_buf, p, 0x200u, 0x30u, "911lden.bnk");
    p = append_big_v2(ocar_viv_buf, p, 0x300u, 0x40u, "sd6bldex.bnk");
    p = append_big_v2(ocar_viv_buf, p, 0x400u, 0x50u, "boxlden.bnk");
    write_u32(ocar_viv_buf + sizeof(ocar_viv_buf) - 4u, p);

    std::memset(trk_viv_buf, 0, sizeof(trk_viv_buf));
    std::memcpy(trk_viv_buf, "BIGF", 4);

    std::memset(cop_viv_buf, 0, sizeof(cop_viv_buf));
    std::memcpy(cop_viv_buf, "BIG4", 4);
    p = append_big_v2(cop_viv_buf, 16u, 0x800u, sizeof(kOneshotsText) - 1u, "oneshots.txt");
    p = append_big_v2(cop_viv_buf, p, 0x900u, 0x111u, "horn1");
    p = append_big_v2(cop_viv_buf, p, 0xa00u, 0x222u, "siren2");
    write_u32(cop_viv_buf + sizeof(cop_viv_buf) - 4u, p);
}

