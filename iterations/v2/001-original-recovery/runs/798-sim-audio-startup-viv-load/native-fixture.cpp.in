template <typename SetupFn, typename CallFn>
static void run_case(SetupFn setup, CallFn call_target, void* x86_target, void* cpp_target) {
    ++cases;
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        reset_all();
        setup();
        void* fn = (side == 0u) ? x86_target : cpp_target;
        call_target(fn);
        capture_fpu(&trace.fp);
        finalize_trace();
        if (trace.abi_fail != 0u) {
            fail("abi");
        }
        if (side == 0u) {
            expected = trace;
        } else if (std::memcmp(&expected, &trace, sizeof(Trace)) != 0) {
            fail("mismatch");
        }
    }
}

static const B kPe5D1D60[12] = "CopSpeakBuf";
static const B kPe5D1D6C[17] = "can't find '%s'\n";
static const B kPe5D1D80[11] = "1sht index";
static const B kPe5D1D8C[14] = "copspeak temp";
static const B kPe5D1D9C[13] = "oneshots.txt";
static const B kPe5D1DAC[13] = "%szzzx%s.viv";
static const B kPe5D1DBC[4] = "eng";
static const B kPe5D1DC0[11] = "trck index";
static const B kPe5D1DCC[12] = "%strack.viv";
static const B kPe5D1DD8[13] = "sd6b%.4s.bnk";
static const B kPe5D1DE8[11] = "%s%.4s.bnk";
static const B kPe5D1DF4[5] = "ldex";
static const B kPe5D1DFC[5] = "lden";
static const B kPe5D1E04[9] = "rain.bnk";
static const B kPe5D1E10[11] = "ocar index";
static const B kPe5D1E1C[14] = "%szzzwzzz.viv";

int main() {
    if (std::memcmp(porsche::audio_copspeak_buf_tag_005d1d60, kPe5D1D60, 12u) != 0 ||
        std::memcmp(porsche::audio_cant_find_fmt_005d1d6c, kPe5D1D6C, 17u) != 0 ||
        std::memcmp(porsche::audio_1sht_index_tag_005d1d80, kPe5D1D80, 11u) != 0 ||
        std::memcmp(porsche::audio_copspeak_temp_tag_005d1d8c, kPe5D1D8C, 14u) != 0 ||
        std::memcmp(porsche::audio_oneshots_txt_005d1d9c, kPe5D1D9C, 13u) != 0 ||
        std::memcmp(porsche::audio_zzzx_viv_fmt_005d1dac, kPe5D1DAC, 13u) != 0 ||
        std::memcmp(porsche::audio_lang_eng_005d1dbc, kPe5D1DBC, 4u) != 0 ||
        std::memcmp(porsche::audio_trck_index_tag_005d1dc0, kPe5D1DC0, 11u) != 0 ||
        std::memcmp(porsche::audio_track_viv_fmt_005d1dcc, kPe5D1DCC, 12u) != 0 ||
        std::memcmp(porsche::audio_sd6b_bnk_fmt_005d1dd8, kPe5D1DD8, 13u) != 0 ||
        std::memcmp(porsche::audio_car_bnk_fmt_005d1de8, kPe5D1DE8, 11u) != 0 ||
        std::memcmp(porsche::audio_ldex_tag_005d1df4, kPe5D1DF4, 5u) != 0 ||
        std::memcmp(porsche::audio_lden_tag_005d1dfc, kPe5D1DFC, 5u) != 0 ||
        std::memcmp(porsche::audio_rain_bnk_name_005d1e04, kPe5D1E04, 9u) != 0 ||
        std::memcmp(porsche::audio_ocar_index_tag_005d1e10, kPe5D1E10, 11u) != 0 ||
        std::memcmp(porsche::audio_zzzwzzz_viv_fmt_005d1e1c, kPe5D1E1C, 14u) != 0) {
        fail("initial_data_mismatch");
    }
    if (porsche::audio_queue_flag_00656af8 != 0u ||
        porsche::audio_channel_flag_00657378 != 0 ||
        porsche::audio_music_track_count_0065737c != 0u ||
        porsche::audio_speech_path_prefix_0065b31c != nullptr) {
        fail("initial_bss_nonzero");
    }

    init_big_archives();
    patch_all_originals();

    // Case 1: big_find_entry_005665b0 kind==1 (BIGF) by case-insensitive name.
    run_case(
        []() {
            trace.out_off = 99u;
            trace.out_sz = 99u;
        },
        [](void* fn) {
            invoke_cdecl_5(fn, big_v1_buf, "BETA.BNK", 0u, &trace.out_off, &trace.out_sz, &trace.ret, &trace.abi_fail);
            if (trace.ret != 0u) {
                std::strncpy(trace.found_name, reinterpret_cast<const char*>(static_cast<std::uintptr_t>(trace.ret)), 31u);
                trace.ret = 1u;
            }
        },
        code + kOff5665B0, reinterpret_cast<void*>(&porsche::big_find_entry_005665b0));

    // Case 2: big_find_entry_005665b0 kind==2 (BIG4) by index.
    run_case(
        []() {
            trace.out_off = 99u;
            trace.out_sz = 99u;
        },
        [](void* fn) {
            invoke_cdecl_5(fn, big_v2_buf, nullptr, 1u, &trace.out_off, &trace.out_sz, &trace.ret, &trace.abi_fail);
            if (trace.ret != 0u) {
                std::strncpy(trace.found_name, reinterpret_cast<const char*>(static_cast<std::uintptr_t>(trace.ret)), 31u);
                trace.ret = 1u;
            }
        },
        code + kOff5665B0, reinterpret_cast<void*>(&porsche::big_find_entry_005665b0));

    // Case 3: big_find_entry_005665b0 not found and invalid kind zero out pointers.
    run_case(
        []() {
            trace.out_off = 0xdeadbeefu;
            trace.out_sz = 0xfeedfaceu;
        },
        [](void* fn) {
            invoke_cdecl_5(fn, big_v2_buf, "missing.bnk", 0u, &trace.out_off, &trace.out_sz, &trace.ret, &trace.abi_fail);
        },
        code + kOff5665B0, reinterpret_cast<void*>(&porsche::big_find_entry_005665b0));

    run_case(
        []() {
            trace.out_off = 0x11111111u;
            trace.out_sz = 0x22222222u;
        },
        [](void* fn) {
            invoke_cdecl_5(fn, big_bad_buf, "anything", 0u, &trace.out_off, &trace.out_sz, &trace.ret, &trace.abi_fail);
        },
        code + kOff5665B0, reinterpret_cast<void*>(&porsche::big_find_entry_005665b0));

    // Case 5: startup_sequence_call_004affd0 with audio disabled resets banks & globals only.
    run_case(
        []() {
            porsche::application_audio_active_005d1734 = 0u;
