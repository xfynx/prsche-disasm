    out.fr[r++] = porsche::frame_reset_word_00606a9c;
    out.fr[r++] = porsche::frame_reset_word_00606aa0;
    out.fr[r++] = porsche::startup_sequence_word_00606ac0;
    out.fr[r++] = porsche::startup_sequence_word_00606ac4;
    out.fr[r++] = porsche::frame_reset_word_00606ac8;
    out.fr[r++] = porsche::frame_reset_word_006280e8;
    out.fr[r++] = porsche::frame_reset_word_006280ec;
    out.fr[r++] = porsche::frame_reset_word_006280f0;
    out.fr[r++] = porsche::frame_reset_word_006280f8;
    out.fr[r++] = porsche::frame_reset_word_006280fc;
    out.fr[r++] = porsche::frame_reset_word_00628100;
    out.fr[r++] = porsche::frame_reset_source_005e99b8;
    out.arena[0] = porsche::arena_word_006573e8;
    out.arena[1] = porsche::arena_word_0065741c;
    out.arena[2] = porsche::arena_word_00657a34;
    out.arena[3] = porsche::arena_word_00657e6c;
    for (U i = 0u; i < 5u; ++i) {
        out.storage[i] = porsche::application_audio_source_storage_005e8bfc[i];
    }
    std::memcpy(out.scratch, source_scratch, sizeof(source_scratch));
    std::memcpy(out.replay, porsche::fe_replay_scratch_005ed848,
                sizeof(porsche::fe_replay_scratch_005ed848));
    out.trace_len = event_count;
    std::memcpy(out.trace, events, event_count * sizeof(Event));
}

static U cases = 0u;

static void compare(const Snapshot& original, const Snapshot& candidate,
                    const Case& item) {
    require(original.abi_fail == 0u && candidate.abi_fail == 0u,
            "cdecl stack/nonvolatile ABI");
    require(candidate.trace_len == original.trace_len, "trace length");
    for (U i = 0u; i < original.trace_len; ++i) {
        require(original.trace[i].id == candidate.trace[i].id, "call order");
        require(original.trace[i].a == candidate.trace[i].a, "call arg0");
        require(original.trace[i].b == candidate.trace[i].b, "call arg1");
        require(original.trace[i].ret == candidate.trace[i].ret, "call return");
    }
    require(std::memcmp(original.fe, candidate.fe, sizeof(original.fe)) == 0,
            "fe state");
    require(std::memcmp(original.fr, candidate.fr, sizeof(original.fr)) == 0,
            "frame reset state");
    require(std::memcmp(original.arena, candidate.arena, sizeof(original.arena)) == 0,
            "application state arena");
    require(std::memcmp(original.storage, candidate.storage,
                        sizeof(original.storage)) == 0, "audio source storage");
    require(std::memcmp(original.scratch, candidate.scratch,
                        sizeof(original.scratch)) == 0, "source scratch");
    require(std::memcmp(original.replay, candidate.replay,
                        sizeof(original.replay)) == 0, "replay scratch");
    ++cases;
}

static void run_case(void* original_fn, const void* candidate_fn,
                     const Case& item) {
    static Snapshot sa{}, sb{};
    Snapshot& a = sa;
    Snapshot& b = sb;
    std::printf("case %u %s fn=%p\n", cases, item.name, original_fn);
    std::fflush(stdout);
    reset_state(item);
    event_count = 0u;
    std::printf("  orig-invoke\n");
    std::fflush(stdout);
    a.abi_fail = invoke0(original_fn);
    std::printf("  orig-done\n");
    std::fflush(stdout);
    capture(a);
    reset_state(item);
    event_count = 0u;
    std::printf("  cand-invoke\n");
    std::fflush(stdout);
    b.abi_fail = invoke0(candidate_fn);
    std::printf("  cand-done\n");
    std::fflush(stdout);
    capture(b);
    compare(a, b, item);
}

static void verify_cases() {
    // Assert the owned production cells start as original .bss zeros before
    // the fixture applies any reset.
    require(porsche::fe_loop_word_005e99f8 == 0u &&
            porsche::fe_replay_scratch_005ed848[0] == 0u &&
            porsche::fe_replay_scratch_005ed848[0x63ffu] == 0u &&
            porsche::frame_reset_word_00606a8c == 0u &&
            porsche::frame_reset_byte_00656858 == 0u,
            "owned bss initial state");
    static const Case list[] = {
        {0u, 5u, 0x111u, 7u, 9u, 0u, 1u, 0x1234u, true, "mode 0 clears scratch"},
        {1u, 9u, 0x222u, 0u, 1u, 0u, 1u, 0u, true, "mode 1 clears scratch"},
        {2u, 5u, 0x333u, 7u, 9u, 0u, 1u, 0xabcdef01u, true, "probe ok empty storage"},
        {2u, 5u, 0x333u, 1u, 2u, 0u, 0u, 0x55aau, true, "probe zero stores 0xa"},
        {2u, 9u, 0x444u, 3u, 4u, 0u, 1u, 0x7777u, true, "state nine branch"},
        {2u, 5u, 0x555u, 8u, 8u, 3u, 1u, 0x9999u, true, "three storage slots"},
        {3u, 3u, 0x666u, 1u, 1u, 1u, 1u, 0x123u, true, "mode three one slot"},
        {0x7fffffffu, 5u, 0x777u, 2u, 2u, 2u, 1u, 0x456u, true, "high mode two slots"},
        {0xffffffffu, 7u, 0x888u, 5u, 5u, 4u, 1u, 0x8888u, true, "negative mode tail only"},
        {2u, 5u, 0x999u, 6u, 6u, 0xffffffffu, 1u, 0x1010u, true, "negative count"},
        {0u, 5u, 0x111u, 7u, 9u, 0u, 1u, 0x1234u, false, "reset source zero"},
        {0u, 9u, 0x222u, 0x55aau, 1u, 0u, 1u, 0xffffffffu, false, "reset source high"},
        {1u, 3u, 0x333u, 1u, 0u, 0u, 1u, 0xabcdef01u, false, "reset source pattern"},
    };
    for (U i = 0u; i < sizeof(list) / sizeof(list[0]); ++i) {
        const Case& item = list[i];
        if (item.run_413ea0) {
            run_case(code_413ea0, reinterpret_cast<const void*>(
                &porsche::application_main_function_00413ea0), item);
        }
        run_case(code_414eb0, reinterpret_cast<const void*>(
            &porsche::application_main_function_00414eb0), item);
    }
}

int main(int argc, char** argv) {
    (void)argc;
    (void)argv;
    AddVectoredExceptionHandler(1, crash_report);
    __try {
        install_original_bodies();
        verify_cases();
    } __except (1) {
        std::printf("fixture exception code=%08x\n", GetExceptionCode());
        std::fflush(stdout);
        return 2;
    }
    std::printf("fe_entry_leaves_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
