// ---------------------------------------------------------------------------
// ABI canary invoke (harness code): __cdecl void(void) call with preserved
// nonvolatile registers and stack pointer.
// ---------------------------------------------------------------------------
static U invoke0(const void* fn) {
    U before = 0u, frame = 0u, failed = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        jne bad
        mov failed, 0
        jmp done
    bad:
        mov failed, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    return failed;
}

