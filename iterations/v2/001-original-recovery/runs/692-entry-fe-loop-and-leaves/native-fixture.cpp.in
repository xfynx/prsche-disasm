static LONG WINAPI crash_report(EXCEPTION_POINTERS* info) {
    const U eip = info->ContextRecord->Eip;
    MEMORY_BASIC_INFORMATION mi{};
    VirtualQuery(reinterpret_cast<void*>(static_cast<std::uintptr_t>(eip)), &mi, sizeof(mi));
    std::printf("crash code=%08lx eip=%08x alloc=%p type=%lx state=%lx esp=%08x phase=%x\n"
                "  eax=%08x ebx=%08x ecx=%08x edx=%08x esi=%08x edi=%08x [esp]=%08x [esp+4]=%08x\n"
                "  body60=%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x stub=%p\n",
                info->ExceptionRecord->ExceptionCode, eip, mi.AllocationBase,
                mi.Type, mi.State, info->ContextRecord->Esp, stub_phase,
                info->ContextRecord->Eax, info->ContextRecord->Ebx,
                info->ContextRecord->Ecx, info->ContextRecord->Edx,
                info->ContextRecord->Esi, info->ContextRecord->Edi,
                *reinterpret_cast<U*>(info->ContextRecord->Esp),
                *reinterpret_cast<U*>(info->ContextRecord->Esp + 4u),
                code_414eb0[60u], code_414eb0[61u], code_414eb0[62u],
                code_414eb0[63u], code_414eb0[64u], code_414eb0[65u],
                code_414eb0[66u], code_414eb0[67u], code_414eb0[68u],
                code_414eb0[69u], code_414eb0[70u], code_414eb0[71u],
                code_414eb0[72u], code_414eb0[73u], code_414eb0[74u],
                code_414eb0[75u], code_414eb0[76u], code_414eb0[77u],
                code_414eb0[78u], code_414eb0[79u],
                static_cast<const void*>(&porsche::frame_reset_service_004a4780));
    std::fflush(stdout);
    return EXCEPTION_CONTINUE_SEARCH;
}

struct RelPatch { U off; U target_va; const void* fn; };
struct AbsPatch { U off; U expected_va; const void* target; };

static void patch_rel(unsigned char* slot, U n, U body_va,
                      const RelPatch* list, U count) {
    for (U i = 0; i < count; ++i) {
        U off = list[i].off;
        require(off + 5u <= n, "rel offset");
        require(slot[off] == 0xe8u, "rel opcode");
        I rel = 0;
        std::memcpy(&rel, slot + off + 1u, 4u);
        require(static_cast<U>(static_cast<I>(body_va + off) + 5u + rel) ==
                list[i].target_va, "rel target");
        // The displacement must be relative to the runtime copy address.
        const U replacement =
            address(list[i].fn) - (address(slot) + off + 5u);
        std::memcpy(slot + off + 1u, &replacement, 4u);
    }
}

static void patch_abs(unsigned char* slot, U n, const AbsPatch* list, U count) {
    for (U i = 0; i < count; ++i) {
        U off = list[i].off;
        require(off + 4u <= n, "abs offset");
        U current = 0u;
        std::memcpy(&current, slot + off, 4u);
        require(current == list[i].expected_va, "abs operand");
        const U replacement = address(list[i].target);
        std::memcpy(slot + off, &replacement, 4u);
    }
}

static void dump_rel_targets(unsigned char* slot, U n, U body_va) {
    std::printf("rel targets %p:", slot);
    for (U i = 0u; i + 5u <= n; ++i) {
        if (slot[i] == 0xe8u) {
            I rel = 0;
            std::memcpy(&rel, slot + i + 1u, 4u);
            std::printf(" %08x->%08x", body_va + i,
                        static_cast<U>(static_cast<I>(body_va + i) + 5u + rel));
        }
    }
    std::printf("\n");
    std::fflush(stdout);
}

static void flush(unsigned char* slot, U n) {
    require(FlushInstructionCache(GetCurrentProcess(), slot, n) != 0,
            "instruction cache");
}

