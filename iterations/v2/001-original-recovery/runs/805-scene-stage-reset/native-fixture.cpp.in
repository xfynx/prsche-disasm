using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static U cases = 0u;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", why, cases);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* base, U off = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(base) + off, 4u);
    return v;
}

static void store32(void* base, U off, U v) {
    std::memcpy(static_cast<B*>(base) + off, &v, 4u);
}

static U fnv1a(const char* s) {
    U h = 2166136261u;
    while (*s != '\0') {
        h = (h ^ static_cast<B>(*s++)) * 16777619u;
    }
    return h;
}

enum : U {
    kEvAlloc = 1u,
    kEvEnter = 2u,
    kEvNewHead = 3u,
    kEvLeave = 4u,
    kEvFormat = 5u,
    kEvTableLoad = 6u,
};

struct Event {
    U kind;
    U a;
    U b;
    U c;
};

enum : U { kMaxEvents = 32u, kObjPoolBytes = 256u, kNodePoolBytes = 256u };

struct Snapshot {
    U abi_fail;
    U ret_eax;
    U event_count;
    std::array<Event, kMaxEvents> events;
    void* owner0;
    void* owner1;
    std::array<B, kObjPoolBytes> obj_pool;
    std::array<B, kNodePoolBytes> node_pool;
    std::array<B, 0x50u> ctx_buf;
};

static Event g_events[kMaxEvents];
static U g_event_count = 0u;

static alignas(16) B g_obj_pool[kObjPoolBytes];
static alignas(16) B g_node_pool[kNodePoolBytes];
static alignas(16) B g_ctx_buf[0x50u];
static alignas(16) B g_lock_obj[0x10u];
static void* g_heap_state_ptr = g_ctx_buf;
static void* g_orig_owners[2] = {};
static U g_obj_cursor = 0u;
static U g_alloc_call = 0u;
static U g_fail_mask = 0u;
static B g_direct_obj[0x10u];
static const char* g_prefix_ptr = "Data\\Fe\\";
static const char kFmtPercentS[] = "%s";

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c};
}

namespace porsche {

RenderDisplay* render_display_00628130 = nullptr;
const char* startup_resource_prefix_0065b30c = nullptr;
