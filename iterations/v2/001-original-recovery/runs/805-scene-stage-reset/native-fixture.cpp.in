static B* code_page = nullptr;
static B* slot_00448b10 = nullptr;
static B* slot_0044d0b0 = nullptr;

static void relocate_call_rel32(
    B* slot, U orig_base_va, U off, U expected_target_va, const void* replacement) {
    require(slot[off] == 0xe8u, "CALL rel32 opcode");
    const I old_disp = static_cast<I>(load32(slot, off + 1u));
    const U actual_target = (orig_base_va + off + 5u + static_cast<U>(old_disp)) & 0xffffffffu;
    require(actual_target == expected_target_va, "CALL rel32 target VA");
    const U new_disp = address(replacement) - address(slot + off + 5u);
    store32(slot, off + 1u, new_disp);
}

static void relocate_imm32(
    B* slot, U imm_off, U expected_addr, const void* replacement) {
    const U actual = load32(slot, imm_off);
    require(actual == expected_addr, "imm32/disp32 target");
    store32(slot, imm_off, address(replacement));
}

static void init() {
    static const B body_00448b10[] = {@BODY_00448B10@};
    static const B body_0044d0b0[] = {@BODY_0044D0B0@};
    require(sizeof body_00448b10 == 167u, "167B 00448b10");
    require(sizeof body_0044d0b0 == 164u, "164B 0044d0b0");

    code_page = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                             PAGE_EXECUTE_READWRITE));
    require(code_page != nullptr, "VirtualAlloc RWX");

    slot_00448b10 = code_page + 0x000u;
    slot_0044d0b0 = code_page + 0x100u;

    std::memcpy(slot_00448b10, body_00448b10, sizeof body_00448b10);
    std::memcpy(slot_0044d0b0, body_0044d0b0, sizeof body_0044d0b0);

    // 0044d0b0
    relocate_call_rel32(slot_0044d0b0, 0x0044d0b0u, 0x01bu, 0x0059ef90u,
                        reinterpret_cast<const void*>(&porsche::startup_network_allocate_0059ef90));
    relocate_imm32(slot_0044d0b0, 0x031u, 0x005e4fe8u, &g_heap_state_ptr);
    relocate_call_rel32(slot_0044d0b0, 0x0044d0b0u, 0x03eu, 0x005322b0u,
                        reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    relocate_call_rel32(slot_0044d0b0, 0x0044d0b0u, 0x051u, 0x0059eeb0u,
                        reinterpret_cast<const void*>(&porsche::application_context_new_head_0059eeb0));
    relocate_call_rel32(slot_0044d0b0, 0x0044d0b0u, 0x065u, 0x005322c0u,
                        reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));

    // 00448b10
    relocate_call_rel32(slot_00448b10, 0x00448b10u, 0x00eu, 0x0059ef90u,
                        reinterpret_cast<const void*>(&porsche::startup_network_allocate_0059ef90));
    relocate_imm32(slot_00448b10, 0x01cu, 0x00628130u, &porsche::render_display_00628130);
    relocate_call_rel32(slot_00448b10, 0x00448b10u, 0x028u, 0x0044d0b0u, slot_0044d0b0);
    relocate_imm32(slot_00448b10, 0x033u, 0x0065b30cu, &porsche::startup_resource_prefix_0065b30c);
    relocate_imm32(slot_00448b10, 0x039u, 0x00613e04u, &g_orig_owners[0]);
    relocate_imm32(slot_00448b10, 0x043u, 0x005ccb84u, kFmtPercentS);
    relocate_call_rel32(slot_00448b10, 0x00448b10u, 0x048u, 0x005a0fbfu,
                        reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_imm32(slot_00448b10, 0x04fu, 0x005cdeacu,
                   porsche::scene_stage_reset_fsh_names_005cdeac);
    relocate_imm32(slot_00448b10, 0x086u, 0x00613e04u, &g_orig_owners[0]);
    relocate_call_rel32(slot_00448b10, 0x00448b10u, 0x08bu, 0x0044d270u,
                        reinterpret_cast<const void*>(&porsche::scene_stage_table_load_0044d270));
}

static U invoke_cdecl_0_void(const void* fn) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        mov eax, fn
        call eax
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_esp0
        mov esp, esp_before
        or abi_fail, 1
    ok_esp0:
        cmp ebx, 0x13572468
        je ok_ebx0
        or abi_fail, 2
    ok_ebx0:
        cmp esi, 0x24681357
        je ok_esi0
        or abi_fail, 4
    ok_esi0:
        cmp edi, 0x55aa33cc
        je ok_edi0
        or abi_fail, 8
    ok_edi0:
        pop edi
        pop esi
        pop ebx
    }
    return abi_fail;
}

static U invoke_thiscall_2(const void* fn, void* self, U a0, U a1, U& ret_eax) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    U out_eax = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        push a1
        push a0
        mov ecx, self
        mov eax, fn
        call eax
        mov out_eax, eax
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_espt2
        mov esp, esp_before
        or abi_fail, 1
    ok_espt2:
        cmp ebx, 0x13572468
        je ok_ebxt2
        or abi_fail, 2
    ok_ebxt2:
        cmp esi, 0x24681357
        je ok_esit2
        or abi_fail, 4
    ok_esit2:
        cmp edi, 0x55aa33cc
        je ok_edit2
        or abi_fail, 8
    ok_edit2:
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = out_eax;
    return abi_fail;
}

static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_obj_cursor = 0u;
    g_alloc_call = 0u;
    g_fail_mask = 0u;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_obj_pool, static_cast<int>(0x20u + seed), sizeof g_obj_pool);
    std::memset(g_node_pool, static_cast<int>(0x30u + seed), sizeof g_node_pool);
    std::memset(g_ctx_buf, 0, sizeof g_ctx_buf);
    std::memset(g_direct_obj, 0x55u, sizeof g_direct_obj);
    store32(g_ctx_buf, 0x28u, address(g_lock_obj));
    // Pre-populate 2 nodes on freelist by default (plus decoy node at 0x3c)
    store32(g_node_pool + 0x00u, 0x04u, address(g_node_pool + 0x10u));
    store32(g_node_pool + 0x10u, 0x04u, 0u);
    store32(g_node_pool + 0x80u, 0x04u, 0u);
    store32(g_ctx_buf, 0x3cu, address(g_node_pool + 0x80u));
    store32(g_ctx_buf, 0x40u, address(g_node_pool + 0x00u));

    g_heap_state_ptr = g_ctx_buf;
    porsche::render_display_00628130 = &porsche::g_display;
    store32(&porsche::g_display, 0x74u, 0x00c0ffeeu + seed);
    porsche::startup_resource_prefix_0065b30c = g_prefix_ptr;
    porsche::startup_context_table_owner_00613e04 = nullptr;
    porsche::scene_stage_particle_table_owner_00613e08 = nullptr;
    g_orig_owners[0] = nullptr;
    g_orig_owners[1] = nullptr;
}

static void capture(Snapshot& out, U abi_fail, U ret_eax, bool use_orig_owners) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    out.owner0 = use_orig_owners ? g_orig_owners[0] : porsche::startup_context_table_owner_00613e04;
    out.owner1 = use_orig_owners ? g_orig_owners[1] : porsche::scene_stage_particle_table_owner_00613e08;
    std::memcpy(out.obj_pool.data(), g_obj_pool, kObjPoolBytes);
    std::memcpy(out.node_pool.data(), g_node_pool, kNodePoolBytes);
    std::memcpy(out.ctx_buf.data(), g_ctx_buf, sizeof g_ctx_buf);
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c,
                tag);
    }
    require(orig.owner0 == cpp.owner0, tag);
    require(orig.owner1 == cpp.owner1, tag);
    require(orig.obj_pool == cpp.obj_pool, tag);
    require(orig.node_pool == cpp.node_pool, tag);
    require(orig.ctx_buf == cpp.ctx_buf, tag);
    ++cases;
}

template <class Setup>
static void run_ctor_case(U owner_val, U cap, Setup&& setup, const char* tag) {
    Snapshot orig{}, cpp{};
    U r0 = 0u, r1 = 0u;
    reset_fixtures(1u);
    setup();
    U f0 = invoke_thiscall_2(slot_0044d0b0, g_direct_obj, owner_val, cap, r0);
    capture(orig, f0, r0, true);
    reset_fixtures(1u);
    setup();
    U f1 = invoke_thiscall_2(
        reinterpret_cast<const void*>(&porsche::scene_stage_table_ctor_0044d0b0),
        g_direct_obj, owner_val, cap, r1);
    capture(cpp, f1, r1, false);
    check_equal(orig, cpp, tag);
}

template <class Setup>
static void run_reset_case(Setup&& setup, const char* tag) {
    Snapshot orig{}, cpp{};
    reset_fixtures(2u);
    setup();
    U f0 = invoke_cdecl_0_void(slot_00448b10);
    capture(orig, f0, 0u, true);
    reset_fixtures(2u);
    setup();
    U f1 = invoke_cdecl_0_void(
        reinterpret_cast<const void*>(&porsche::scene_stage_reset_00448b10));
    capture(cpp, f1, 0u, false);
    check_equal(orig, cpp, tag);
}

int main() {
    init();

    // 1. Direct 0044d0b0 ctor: pre-populated vs empty freelist, inner alloc fail, low-byte owner tags
    for (U owner : {0x12345600u, 0x12345678u, 0xdeadbeefu}) {
        for (bool empty_pool : {false, true}) {
            run_ctor_case(owner, 4u, [=]() {
                if (empty_pool) {
                    store32(g_ctx_buf, 0x40u, 0u);
                }
            }, "ctor ok");
        }
        run_ctor_case(owner, 9u, []() {
            g_fail_mask = 1u; // holder alloc fail
        }, "ctor alloc fail");
    }

    // 2. Full 00448b10 reset: freelist non-empty & empty, alloc failure bitmasks, prefix variations
    for (U fail_mask : {0u, 1u, 2u, 4u, 8u, 0xfu}) {
        for (bool empty_pool : {false, true}) {
            run_reset_case([=]() {
                g_fail_mask = fail_mask;
                if (empty_pool) {
                    store32(g_ctx_buf, 0x40u, 0u);
                }
            }, "reset matrix");
        }
    }
    run_reset_case([]() {
        g_prefix_ptr = "";
        porsche::startup_resource_prefix_0065b30c = g_prefix_ptr;
    }, "reset empty prefix");

    std::printf("scene_stage_reset_805_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
