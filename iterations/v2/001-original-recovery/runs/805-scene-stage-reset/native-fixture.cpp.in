static RenderDisplay g_display{};

void* __cdecl startup_network_allocate_0059ef90(U bytes) {
    const U call_idx = g_alloc_call++;
    const bool fail = ((g_fail_mask >> call_idx) & 1u) != 0u;
    record_event(kEvAlloc, bytes, fail ? 1u : 0u);
    if (fail) {
        return nullptr;
    }
    require(bytes == 0x0cu, "0059ef90 0x0c bound");
    require(g_obj_cursor + 0x10u <= kObjPoolBytes, "obj pool overflow");
    void* const p = g_obj_pool + g_obj_cursor;
    g_obj_cursor += 0x10u;
    return p;
}

void* __cdecl application_context_heap_state_005e4fe8() {
    return g_heap_state_ptr;
}

void __cdecl heap_enter_005322b0(void* lock) {
    record_event(kEvEnter, address(lock));
}

void __cdecl heap_leave_005322c0(void* lock) {
    record_event(kEvLeave, address(lock));
}

void __cdecl application_context_new_head_0059eeb0(U kind, U slot) {
    record_event(kEvNewHead, kind, slot);
    // Link two 16-byte nodes at g_node_pool + 0x40 and + 0x50
    store32(g_node_pool + 0x40u, 0x04u, address(g_node_pool + 0x50u));
    store32(g_node_pool + 0x50u, 0x04u, 0u);
    store32(g_ctx_buf, 0x40u, address(g_node_pool + 0x40u));
}

I __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 256u, format, args);
    va_end(args);
    record_event(kEvFormat, fnv1a(format), fnv1a(output));
    return n;
}

void __fastcall scene_stage_table_load_0044d270(
    void* self, void*, const char* path, U zero) {
    record_event(kEvTableLoad, address(self), fnv1a(path), zero);
}

