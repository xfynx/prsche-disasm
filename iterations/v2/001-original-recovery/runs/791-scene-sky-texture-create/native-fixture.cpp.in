static Event g_events[kMaxEvents];
static U g_event_count = 0u;

static alignas(8) B g_node_buf[0x54u];
static alignas(8) B g_chunk_buf[0x40u];
static alignas(8) B g_inner_desc[0x20u];
static alignas(8) B g_free_buf1[0x20u];
static alignas(8) B g_free_buf2[0x20u];
