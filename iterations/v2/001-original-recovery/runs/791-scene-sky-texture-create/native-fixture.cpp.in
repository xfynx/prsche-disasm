static U g_parse_extra_flags = 0u;
static void* g_parse_buf1 = nullptr;
static void* g_parse_buf2 = nullptr;
static const char kPadSpaces[] = "      ";

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u, U d = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c, d};
}

namespace porsche {

B render_mode_state_00619790[0x71] = {};
U* render_texture_format_preference_table_005def98[18] = {};

U* __cdecl startup_text_quality_mask_ptr_0044dfe0(U index) {
    record_event(kEvMaskPtr, index, g_quality_mask);
    return &g_quality_mask;
}

void* __fastcall scene_texture_descriptor_parse_0044d7e0(
    void* out_desc, void*, const void* chunk, U mode, U fourcc) {
    record_event(kEvParseDesc, address(chunk), mode, fourcc);
    store32(out_desc, 0x04u, g_parse_extra_flags);
    store32(out_desc, 0x0cu, address(g_inner_desc));
    store32(out_desc, 0x14u, address(g_parse_buf1));
    store32(out_desc, 0x18u, address(g_parse_buf2));
    return out_desc;
}

void* __cdecl startup_network_allocate_0059ef90(U bytes) {
    record_event(kEvAlloc, bytes, g_alloc_fail ? 1u : 0u);
    if (g_alloc_fail) {
        return nullptr;
    }
    require(bytes == 0x54u, "0059ef90 0x54 bound");
    return g_node_buf;
}

void* __fastcall render_resource_node_ctor_00535bc0(
    void* self, void*, const void* desc, void* parent, U flags, const char* name) {
    record_event(kEvNodeCtor, address(self), address(desc), address(parent),
                 flags ^ fnv1a(name));
    store32(self, 0x00u, flags);
    store32(self, 0x04u, address(desc));
    store32(self, 0x08u, address(parent));
    std::memset(static_cast<B*>(self) + 0x10u, 0, 12u);
    std::strncpy(reinterpret_cast<char*>(static_cast<B*>(self) + 0x10u), name, 11u);
    return self;
}

U __cdecl free_00531f90(void* block) {
    record_event(kEvFree, address(block));
    return 1u;
}

} // namespace porsche

