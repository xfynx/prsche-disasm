        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        push a0
        mov eax, fn
        call eax
        add esp, 4
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_esp1c
        mov esp, esp_before
        or abi_fail, 1
    ok_esp1c:
        cmp ebx, 0x13572468
        je ok_ebx1c
        or abi_fail, 2
    ok_ebx1c:
        cmp esi, 0x24681357
        je ok_esi1c
        or abi_fail, 4
    ok_esi1c:
        cmp edi, 0x55aa33cc
        je ok_edi1c
        or abi_fail, 8
    ok_edi1c:
        pop edi
        pop esi
        pop ebx
