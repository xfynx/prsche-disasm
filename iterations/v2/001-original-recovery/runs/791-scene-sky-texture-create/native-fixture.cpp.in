static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_quality_mask = 0u;
    g_alloc_fail = false;
    g_parse_extra_flags = 0u;
    g_parse_buf1 = nullptr;
    g_parse_buf2 = nullptr;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_node_buf, static_cast<int>(0x20u + seed), sizeof g_node_buf);
    std::memset(porsche::render_mode_state_00619790, 0,
                sizeof porsche::render_mode_state_00619790);
    for (U i = 0u; i < 18u; ++i) {
        porsche::render_texture_format_preference_table_005def98[i] = nullptr;
    }
}

static void capture(Snapshot& out, U abi_fail, U ret_eax) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    std::memcpy(out.node_bytes.data(), g_node_buf, sizeof g_node_buf);
    for (U i = 0u; i < 18u; ++i) {
        out.pref_table[i] = porsche::render_texture_format_preference_table_005def98[i];
    }
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c &&
                    orig.events[i].d == cpp.events[i].d,
                tag);
    }
    require(orig.node_bytes == cpp.node_bytes, tag);
    require(orig.pref_table == cpp.pref_table, tag);
    ++cases;
}

template <class Setup>
static void run_create_case(
    U tag_arg, U mode, U driver_flags, U extra_flags, Setup&& setup, const char* tag) {
    Snapshot orig{};
    Snapshot cpp{};
    U r0 = 0u, r1 = 0u;
    reset_fixtures(1u);
    setup();
    U f0 = invoke_cdecl_5(slot_0044da10, address(g_chunk_buf), tag_arg, mode, driver_flags, extra_flags, r0);
    capture(orig, f0, r0);
    reset_fixtures(1u);
    setup();
    U f1 = invoke_cdecl_5(
        reinterpret_cast<const void*>(&porsche::scene_sky_texture_create_0044da10),
        address(g_chunk_buf), tag_arg, mode, driver_flags, extra_flags, r1);
    capture(cpp, f1, r1);
    check_equal(orig, cpp, tag);
}

int main() {
    init();

    // 1. Direct leaf tests: 00555630, 00536460, 00554950
    {
        Snapshot orig{}, cpp{};
        reset_fixtures(1u);
        U f0 = invoke_cdecl_1_void(slot_00555630, 0x12345678u);
        capture(orig, f0, 0u);
        reset_fixtures(1u);
        U f1 = invoke_cdecl_1_void(
            reinterpret_cast<const void*>(&porsche::render_texture_noop_00555630), 0x12345678u);
        capture(cpp, f1, 0u);
        check_equal(orig, cpp, "00555630");

        reset_fixtures(1u);
        store32(g_node_buf, 0x08u, 0xabcdef01u);
        f0 = invoke_thiscall_0_void(slot_00536460, g_node_buf);
        capture(orig, f0, 0u);
        reset_fixtures(1u);
        store32(g_node_buf, 0x08u, 0xabcdef01u);
        f1 = invoke_thiscall_0_void(
            reinterpret_cast<const void*>(&porsche::render_resource_node_prepare_00536460), g_node_buf);
        capture(cpp, f1, 0u);
        check_equal(orig, cpp, "00536460");

        for (U slot : {0u, 4u, 6u, 17u}) {
            reset_fixtures(1u);
            f0 = invoke_cdecl_2_void(slot_00554950, slot, address(porsche::scene_sky_format_prefs_a_005ce52c));
            capture(orig, f0, 0u);
            reset_fixtures(1u);
            f1 = invoke_cdecl_2_void(
                reinterpret_cast<const void*>(&porsche::render_texture_format_table_set_00554950),
                slot, address(porsche::scene_sky_format_prefs_a_005ce52c));
            capture(cpp, f1, 0u);
            check_equal(orig, cpp, "00554950");
        }
    }

    // 2. 0044da10 tag < 0x20 ("CARx" + spaces) vs tag >= 0x20 (4CC + spaces),
    //    mode_state[0x18] & mode_state[0x1e] combinations, quality mask bit, buffers, alloc fail
    for (U t : {0u, 1u, 0x1fu, 0x20u, 0x41424320u, 0x534b5920u}) {
        for (U flags18 : {0u, 1u}) {
            for (U flags1e : {0u, 1u}) {
                run_create_case(t, (t & 3u) + 1u, 0x11223344u + t, 0x80u, [=]() {
                    porsche::render_mode_state_00619790[0x18u] = static_cast<B>(flags18);
                    porsche::render_mode_state_00619790[0x1eu] = static_cast<B>(flags1e);
                    g_parse_extra_flags = 0x0003u;
                    g_quality_mask = (flags18 != 0u) ? 0x00080000u : 0x00040000u;
                    g_parse_buf1 = (flags1e != 0u) ? g_free_buf1 : nullptr;
                    g_parse_buf2 = (flags18 != 0u) ? g_free_buf2 : nullptr;
                }, "create mode matrix");
            }
        }
    }

    // 3. 0044da10 alloc failure (node == nullptr, quality_mask bit clear, both free buffers present)
    run_create_case(0x534b5920u, 1u, 0x10u, 0u, []() {
        g_alloc_fail = true;
        g_quality_mask = 0u;
        g_parse_buf1 = g_free_buf1;
        g_parse_buf2 = g_free_buf2;
    }, "create alloc fail");

    std::printf("scene_sky_texture_791_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
