static void fail(const char* why) {
    std::printf("wide_compare_engines_original_x86_vs_cpp=FAIL case=%u side=%u reason=%s\n",
                cases, which, why);
    std::exit(1);
}

static U fnv1a(const void* data, std::size_t n) {
    if (!data) return 0u;
    const B* p = static_cast<const B*>(data);
    U h = 2166136261u;
    for (std::size_t i = 0; i < n; ++i) {
        h ^= p[i];
        h *= 16777619u;
    }
    return h;
}

static void record(U cid, U a0 = 0u, U a1 = 0u) {
    if (trace.count >= kMaxEvents) fail("trace_overflow");
    trace.codes[trace.count] = cid;
    trace.arg0[trace.count] = a0;
    trace.arg1[trace.count] = a1;
    ++trace.count;
    ++events_total;
}

__declspec(naked) static void __cdecl stub_chkstk() {
    __asm {
        pop ecx
        sub esp, eax
        jmp ecx
    }
}

static int __cdecl dummy_except_handler3(void*, void*, void*, void*) {
    return 1;
}

static std::int32_t __stdcall mock_increment(std::int32_t* p) {
    const std::int32_t v = ++(*p);
    record(1u, static_cast<U>(v));
    return v;
}

static std::int32_t __stdcall mock_decrement(std::int32_t* p) {
    const std::int32_t v = --(*p);
    record(2u, static_cast<U>(v));
    return v;
}

namespace porsche {

void __cdecl exit_registry_lock_api_005a4ba4(std::uint32_t id) {
    record(3u, id);
}

void __cdecl exit_registry_unlock_api_005a4c05(std::uint32_t id) {
    record(4u, id);
}

void* __cdecl context_move_005a1a40(void* dst, const void* src, std::uint32_t bytes) {
    record(5u, bytes);
    return std::memmove(dst, src, bytes);
}

void* __cdecl formatter_crt_memset_005abe90(void* dst, int value, std::uint32_t bytes) {
    record(6u, static_cast<U>(value), bytes);
    return std::memset(dst, value, bytes);
}

char* __cdecl formatter_error_copy_n_005a28a0(char* dst, const char* src, std::uint32_t n) {
    record(7u, n);
    return std::strncpy(dst, src, n);
}

int __stdcall formatter_locale_map_w(
    std::uint32_t locale, std::uint32_t flags, const std::uint16_t* in, int cch, void* out, int cap) {
    return ::LCMapStringW(locale, flags, reinterpret_cast<LPCWSTR>(in), cch, static_cast<LPWSTR>(out), cap);
}

int __stdcall formatter_locale_map_a(
    std::uint32_t locale, std::uint32_t flags, const char* in, int cch, char* out, int cap) {
    return ::LCMapStringA(locale, flags, in, cch, out, cap);
}

int __stdcall formatter_locale_to_wide(
    std::uint32_t cp, std::uint32_t flags, const char* in, int cch, std::uint16_t* out, int cap) {
    return ::MultiByteToWideChar(cp, flags, in, cch, reinterpret_cast<LPWSTR>(out), cap);
}

int __stdcall formatter_locale_from_wide(
    std::uint32_t cp, std::uint32_t flags, const std::uint16_t* in, int cch,
    char* out, int cap, const char* defch, int* used) {
    return ::WideCharToMultiByte(cp, flags, reinterpret_cast<LPCWSTR>(in), cch, out, cap, defch, used);
}

int __stdcall formatter_locale_type_w(
    std::uint32_t kind, const std::uint16_t* in, int cch, std::uint16_t* out) {
    return ::GetStringTypeW(kind, reinterpret_cast<LPCWSTR>(in), cch, out);
}

int __stdcall formatter_locale_type_a(
    std::uint32_t locale, std::uint32_t kind, const char* in, int cch, std::uint16_t* out) {
    return ::GetStringTypeA(locale, kind, in, cch, out);
}

} // namespace porsche

static void write_u32(B* p, U v) { std::memcpy(p, &v, 4u); }
static void write_rel32(B* slot, const void* target) {
    const std::int32_t rel = static_cast<std::int32_t>(
        reinterpret_cast<std::uintptr_t>(target) -
        (reinterpret_cast<std::uintptr_t>(slot) + 4u));
    std::memcpy(slot, &rel, 4u);
}

static void init_code_buffer() {
    code = static_cast<B*>(::VirtualAlloc(nullptr, kCodeBytes, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    if (!code) fail("virtual_alloc");
    std::memset(code, 0xcc, kCodeBytes);

    iat_type_w = reinterpret_cast<void*>(&porsche::formatter_locale_type_w);
    iat_type_a = reinterpret_cast<void*>(&porsche::formatter_locale_type_a);
    iat_map_w = reinterpret_cast<void*>(&porsche::formatter_locale_map_w);
    iat_map_a = reinterpret_cast<void*>(&porsche::formatter_locale_map_a);
    iat_wide_to_mb = reinterpret_cast<void*>(&porsche::formatter_locale_from_wide);
    iat_mb_to_wide = reinterpret_cast<void*>(&porsche::formatter_locale_to_wide);
    iat_compare_w = reinterpret_cast<void*>(&::CompareStringW);
    iat_compare_a = reinterpret_cast<void*>(&::CompareStringA);

    std::memcpy(code + kOff5AE901, kBody5AE901, sizeof(kBody5AE901));
    std::memcpy(code + kOff5AEA71, kBody5AEA71, sizeof(kBody5AEA71));
    std::memcpy(code + kOff5AECEF, kBody5AECEF, sizeof(kBody5AECEF));
    std::memcpy(code + kOff5AE1F7, kBody5AE1F7, sizeof(kBody5AE1F7));
    std::memcpy(code + kOff5AEAE6, kBody5AEAE6, sizeof(kBody5AEAE6));
    std::memcpy(code + kOff5AE6B6, kBody5AE6B6, sizeof(kBody5AE6B6));
    std::memcpy(code + kOff5AE8D1, kBody5AE8D1, sizeof(kBody5AE8D1));

    auto r32 = [](U base_off, U site_va, U fn_va, const void* tgt) {
        write_rel32(code + base_off + (site_va - fn_va) + 1u, tgt);
    };
    auto rhl = [](U base_off, U off, const void* ptr) {
        write_u32(code + base_off + off, static_cast<U>(reinterpret_cast<std::uintptr_t>(ptr)));
    };

    // 005ae901
    r32(kOff5AE901, 0x005ae98au, 0x005ae901u, reinterpret_cast<const void*>(&porsche::exit_registry_lock_api_005a4ba4));
    r32(kOff5AE901, 0x005ae9a9u, 0x005ae901u, code + kOff5AEA71);
    r32(kOff5AE901, 0x005ae9b7u, 0x005ae901u, code + kOff5AEA71);
    r32(kOff5AE901, 0x005ae9dcu, 0x005ae901u, reinterpret_cast<const void*>(&porsche::exit_registry_unlock_api_005a4c05));
    rhl(kOff5AE901, 20u, &porsche::formatter_text_locale_006afd80);
    rhl(kOff5AE901, 109u, &porsche::formatter_text_locale_readers_006c02e8);
    rhl(kOff5AE901, 116u, &porsche::formatter_text_increment_005b2258);
    rhl(kOff5AE901, 122u, &porsche::formatter_text_locale_writer_006c02e4);
    rhl(kOff5AE901, 131u, &porsche::formatter_text_decrement_005b2254);
    rhl(kOff5AE901, 230u, &porsche::formatter_text_decrement_005b2254);

    // 005aea71
    r32(kOff5AEA71, 0x005aeaa6u, 0x005aea71u, code + kOff5AECEF);
    r32(kOff5AEA71, 0x005aead0u, 0x005aea71u, code + kOff5AEAE6);
    rhl(kOff5AEA71, 20u, &porsche::formatter_text_locale_006afd80);
    rhl(kOff5AEA71, 91u, &porsche::formatter_text_locale_006afd80);

    // 005aecef
    r32(kOff5AECEF, 0x005aed23u, 0x005aecefu, code + kOff5AE1F7);
    rhl(kOff5AECEF, 26u, &porsche::crt_pctype_ptr_005e52d4);

    // 005ae1f7
    r32(kOff5AE1F7, 0x005ae2c5u, 0x005ae1f7u, reinterpret_cast<const void*>(&stub_chkstk));
    r32(kOff5AE1F7, 0x005ae2d5u, 0x005ae1f7u, reinterpret_cast<const void*>(&porsche::formatter_crt_memset_005abe90));
    r32(kOff5AE1F7, 0x005ae331u, 0x005ae1f7u, reinterpret_cast<const void*>(&stub_chkstk));
    r32(kOff5AE1F7, 0x005ae39bu, 0x005ae1f7u, reinterpret_cast<const void*>(&porsche::context_move_005a1a40));
    rhl(kOff5AE1F7, 6u, kSehScopeTable);
    rhl(kOff5AE1F7, 11u, reinterpret_cast<const void*>(&dummy_except_handler3));
    rhl(kOff5AE1F7, 39u, &porsche::crt_string_type_use_mode_006b0050);
    rhl(kOff5AE1F7, 58u, kDummyW);
    rhl(kOff5AE1F7, 65u, &iat_type_w);
    rhl(kOff5AE1F7, 83u, kDummyA);
    rhl(kOff5AE1F7, 91u, &iat_type_a);
    rhl(kOff5AE1F7, 107u, &porsche::crt_string_type_use_mode_006b0050);
    rhl(kOff5AE1F7, 130u, &iat_type_w);
    rhl(kOff5AE1F7, 154u, &porsche::formatter_locale_default_codepage_006afd90);
    rhl(kOff5AE1F7, 181u, &iat_wide_to_mb);
    rhl(kOff5AE1F7, 286u, &iat_wide_to_mb);
    rhl(kOff5AE1F7, 356u, &porsche::formatter_text_locale_006afd80);
    rhl(kOff5AE1F7, 393u, &iat_type_a);

    // 005aeae6
    r32(kOff5AEAE6, 0x005aeb67u, 0x005aeae6u, code + kOff5AE8D1);
    r32(kOff5AEAE6, 0x005aebd9u, 0x005aeae6u, reinterpret_cast<const void*>(&stub_chkstk));
    r32(kOff5AEAE6, 0x005aec52u, 0x005aeae6u, reinterpret_cast<const void*>(&stub_chkstk));
    r32(kOff5AEAE6, 0x005aecabu, 0x005aeae6u, reinterpret_cast<const void*>(&porsche::formatter_error_copy_n_005a28a0));
    rhl(kOff5AEAE6, 6u, kSehScopeTable);
    rhl(kOff5AEAE6, 11u, reinterpret_cast<const void*>(&dummy_except_handler3));
    rhl(kOff5AEAE6, 42u, &porsche::crt_lcmap_use_mode_006b0064);
    rhl(kOff5AEAE6, 55u, kDummyW);
    rhl(kOff5AEAE6, 68u, &iat_map_w);
    rhl(kOff5AEAE6, 78u, &porsche::crt_lcmap_use_mode_006b0064);
    rhl(kOff5AEAE6, 88u, kDummyA);
    rhl(kOff5AEAE6, 96u, &iat_map_a);
    rhl(kOff5AEAE6, 110u, &porsche::crt_lcmap_use_mode_006b0064);
    rhl(kOff5AEAE6, 140u, &porsche::crt_lcmap_use_mode_006b0064);
    rhl(kOff5AEAE6, 169u, &iat_map_w);
    rhl(kOff5AEAE6, 193u, &porsche::formatter_locale_default_codepage_006afd90);
    rhl(kOff5AEAE6, 220u, &iat_wide_to_mb);
    rhl(kOff5AEAE6, 307u, &iat_wide_to_mb);
    rhl(kOff5AEAE6, 335u, &iat_map_a);
    rhl(kOff5AEAE6, 421u, &iat_map_a);
    rhl(kOff5AEAE6, 487u, &iat_mb_to_wide);

    // 005ae6b6
    r32(kOff5AE6B6, 0x005ae70fu, 0x005ae6b6u, code + kOff5AE8D1);
    r32(kOff5AE6B6, 0x005ae726u, 0x005ae6b6u, code + kOff5AE8D1);
    r32(kOff5AE6B6, 0x005ae7c8u, 0x005ae6b6u, reinterpret_cast<const void*>(&stub_chkstk));
    r32(kOff5AE6B6, 0x005ae83eu, 0x005ae6b6u, reinterpret_cast<const void*>(&stub_chkstk));
    rhl(kOff5AE6B6, 6u, kSehScopeTable);
    rhl(kOff5AE6B6, 11u, reinterpret_cast<const void*>(&dummy_except_handler3));
    rhl(kOff5AE6B6, 42u, &porsche::crt_compare_w_use_mode_006b0058);
    rhl(kOff5AE6B6, 53u, kDummyW);
    rhl(kOff5AE6B6, 64u, &iat_compare_w);
    rhl(kOff5AE6B6, 74u, &porsche::crt_compare_w_use_mode_006b0058);
    rhl(kOff5AE6B6, 140u, &porsche::crt_compare_w_use_mode_006b0058);
    rhl(kOff5AE6B6, 166u, &iat_compare_w);
    rhl(kOff5AE6B6, 177u, kDummyA);
    rhl(kOff5AE6B6, 188u, &iat_compare_a);
    rhl(kOff5AE6B6, 198u, &porsche::crt_compare_w_use_mode_006b0058);
    rhl(kOff5AE6B6, 229u, &porsche::formatter_locale_default_codepage_006afd90);
    rhl(kOff5AE6B6, 255u, &iat_wide_to_mb);
    rhl(kOff5AE6B6, 339u, &iat_wide_to_mb);
    rhl(kOff5AE6B6, 457u, &iat_wide_to_mb);
    rhl(kOff5AE6B6, 487u, &iat_compare_a);

    ::FlushInstructionCache(::GetCurrentProcess(), code, kCodeBytes);
}

static void reset_state() {
    std::memset(&trace, 0, sizeof(trace));
    porsche::formatter_text_locale_006afd80 = 0u;
    porsche::formatter_text_locale_writer_006c02e4 = 0u;
    porsche::formatter_text_locale_readers_006c02e8 = 0;
    porsche::formatter_locale_default_codepage_006afd90 = 1252u;
    porsche::formatter_text_increment_005b2258 = &mock_increment;
    porsche::formatter_text_decrement_005b2254 = &mock_decrement;
    porsche::crt_string_type_use_mode_006b0050 = 0u;
    porsche::crt_compare_w_use_mode_006b0058 = 0u;
    porsche::crt_lcmap_use_mode_006b0064 = 0u;
}

static void compare_traces(const Trace& a, const Trace& b) {
    if (a.count != b.count || a.ret0 != b.ret0 || a.ret1 != b.ret1 ||
        a.ret2 != b.ret2 || a.ret3 != b.ret3 ||
        a.readers_after != b.readers_after || a.mode_bits != b.mode_bits ||
        a.out_hash != b.out_hash) {
        fail("trace_summary_mismatch");
    }
    for (U i = 0u; i < a.count; ++i) {
        if (a.codes[i] != b.codes[i] || a.arg0[i] != b.arg0[i] || a.arg1[i] != b.arg1[i]) {
            fail("trace_event_mismatch");
        }
    }
}

template <typename Fn>
static void run_case(Fn fn) {
    ++cases;
    which = 0u;
    reset_state();
    fn(false);
    expected = trace;

    which = 1u;
    reset_state();
    fn(true);
    compare_traces(expected, trace);
}

int main() {
    init_code_buffer();

    auto* const orig_5ae901 = reinterpret_cast<int(__cdecl*)(const wchar_t*, const wchar_t*, U)>(code + kOff5AE901);
    auto* const orig_5ae6b6 = reinterpret_cast<int(__cdecl*)(U, U, const wchar_t*, int, const wchar_t*, int, U)>(code + kOff5AE6B6);
    auto* const orig_5aea71 = reinterpret_cast<std::uint16_t(__cdecl*)(std::uint16_t)>(code + kOff5AEA71);
    auto* const orig_5aecef = reinterpret_cast<int(__cdecl*)(std::uint16_t, std::uint16_t)>(code + kOff5AECEF);
    auto* const orig_5aeae6 = reinterpret_cast<int(__cdecl*)(U, U, const wchar_t*, int, wchar_t*, int, U)>(code + kOff5AEAE6);

    // Case 1: crt_wcsnicoll_default_005ae901 C-locale (locale==0) paths: count==0, eq, lt, gt, null-term stop.
    run_case([&](bool cpp) {
        trace.ret0 = cpp ? porsche::crt_wcsnicoll_default_005ae901(L"a", L"b", 0u)
                         : orig_5ae901(L"a", L"b", 0u);
        trace.ret1 = cpp ? porsche::crt_wcsnicoll_default_005ae901(L"AbC", L"aBcz", 3u)
                         : orig_5ae901(L"AbC", L"aBcz", 3u);
        trace.ret2 = cpp ? porsche::crt_wcsnicoll_default_005ae901(L"Ab", L"abC", 3u)
                         : orig_5ae901(L"Ab", L"abC", 3u);
        trace.ret3 = cpp ? porsche::crt_wcsnicoll_default_005ae901(L"AZ", L"ax", 2u)
                         : orig_5ae901(L"AZ", L"ax", 2u);
    });

    // Case 2: crt_wcsnicoll_default_005ae901 reader lock path (locale!=0, writer==0, ASCII + non-ASCII >= 0x100).
    run_case([&](bool cpp) {
        porsche::formatter_text_locale_006afd80 = 0x0409u;
        porsche::formatter_text_locale_writer_006c02e4 = 0u;
        const wchar_t s1[] = {L'A', L'b', 0x00c4u, 0};
        const wchar_t s2[] = {L'a', L'B', 0x00e4u, 0};
        trace.ret0 = cpp ? porsche::crt_wcsnicoll_default_005ae901(s1, s2, 3u)
                         : orig_5ae901(s1, s2, 3u);
        const wchar_t w1[] = {0x0104u, L'x', 0};
        const wchar_t w2[] = {0x0105u, L'x', 0};
        trace.ret1 = cpp ? porsche::crt_wcsnicoll_default_005ae901(w1, w2, 2u)
                         : orig_5ae901(w1, w2, 2u);
        trace.readers_after = porsche::formatter_text_locale_readers_006c02e8;
        trace.mode_bits = (porsche::crt_lcmap_use_mode_006b0064 << 8u) | porsche::crt_string_type_use_mode_006b0050;
    });

    // Case 3: crt_wcsnicoll_default_005ae901 writer contention lock-19 path (writer==1) + 0xffff EOF sentinel.
    run_case([&](bool cpp) {
        porsche::formatter_text_locale_006afd80 = 0x0409u;
        porsche::formatter_text_locale_writer_006c02e4 = 1u;
        trace.ret0 = cpp ? porsche::crt_wcsnicoll_default_005ae901(L"Hello", L"heLLo", 5u)
                         : orig_5ae901(L"Hello", L"heLLo", 5u);
        trace.ret1 = static_cast<int>(cpp ? porsche::crt_towlower_lk_005aea71(0xffffu)
                                          : orig_5aea71(0xffffu));
        trace.ret2 = cpp ? porsche::crt_iswctype_lk_005aecef(0xffffu, 1u)
                         : orig_5aecef(0xffffu, 1u);
        trace.ret3 = cpp ? porsche::crt_iswctype_lk_005aecef(L'Z', 1u)
                         : orig_5aecef(L'Z', 1u);
        trace.readers_after = porsche::formatter_text_locale_readers_006c02e8;
    });

    // Case 4: crt_wcsnicoll_locale_005ae6b6 NT wide path (auto-detected mode==1) including count truncation and zero-count edges.
    run_case([&](bool cpp) {
        trace.ret0 = cpp ? porsche::crt_wcsnicoll_locale_005ae6b6(0x0409u, 0x1001u, L"Abc", 3, L"aBCZ", 3, 1252u)
                         : orig_5ae6b6(0x0409u, 0x1001u, L"Abc", 3, L"aBCZ", 3, 1252u);
        trace.ret1 = cpp ? porsche::crt_wcsnicoll_locale_005ae6b6(0x0409u, 0x1001u, L"", 5, L"a", 5, 1252u)
                         : orig_5ae6b6(0x0409u, 0x1001u, L"", 5, L"a", 5, 1252u);
        trace.ret2 = cpp ? porsche::crt_wcsnicoll_locale_005ae6b6(0x0409u, 0x1001u, L"a", 5, L"", 5, 1252u)
                         : orig_5ae6b6(0x0409u, 0x1001u, L"a", 5, L"", 5, 1252u);
        trace.ret3 = cpp ? porsche::crt_wcsnicoll_locale_005ae6b6(0x0409u, 0x1001u, L"", 5, L"", 5, 1252u)
                         : orig_5ae6b6(0x0409u, 0x1001u, L"", 5, L"", 5, 1252u);
        trace.mode_bits = porsche::crt_compare_w_use_mode_006b0058;
    });

    // Case 5: ANSI fallback path (use_mode == 2) across 005ae6b6, 005aeae6 (normal + LCMAP_SORTKEY 0x400), and 005ae1f7.
    run_case([&](bool cpp) {
        porsche::formatter_text_locale_006afd80 = 0x0409u;
        porsche::crt_compare_w_use_mode_006b0058 = 2u;
        porsche::crt_lcmap_use_mode_006b0064 = 2u;
        porsche::crt_string_type_use_mode_006b0050 = 2u;
        trace.ret0 = cpp ? porsche::crt_wcsnicoll_locale_005ae6b6(0x0409u, 0x1001u, L"Alpha", 5, L"aLpHa", 5, 0u)
                         : orig_5ae6b6(0x0409u, 0x1001u, L"Alpha", 5, L"aLpHa", 5, 0u);
        const wchar_t w_u[] = {0x0104u, 0};
        trace.ret1 = static_cast<int>(cpp ? porsche::crt_towlower_lk_005aea71(w_u[0])
                                          : orig_5aea71(w_u[0]));
        trace.ret2 = cpp ? porsche::crt_iswctype_lk_005aecef(0x0104u, 1u)
                         : orig_5aecef(0x0104u, 1u);
        char sortkey[64]{};
        trace.ret3 = cpp ? porsche::crt_lc_map_string_w_005aeae6(
                               0x0409u, 0x0400u, L"Test", 4, reinterpret_cast<wchar_t*>(sortkey), 64, 0u)
                         : orig_5aeae6(
                               0x0409u, 0x0400u, L"Test", 4, reinterpret_cast<wchar_t*>(sortkey), 64, 0u);
        trace.out_hash = fnv1a(sortkey, static_cast<std::size_t>(trace.ret3 > 0 && trace.ret3 < 64 ? trace.ret3 : 0));
    });

    std::printf("wide_compare_engines_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
