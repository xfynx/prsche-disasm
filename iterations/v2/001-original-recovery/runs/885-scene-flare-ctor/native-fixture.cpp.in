double __cdecl math_fsin_tau_005327e0(float turns) {
    static const std::uint64_t kTauBits = 0x401921fb20000000ull;
    double result = 0.0;
    __asm {
        fld dword ptr [turns]
        fmul qword ptr [kTauBits]
        fsin
        fstp qword ptr [result]
    }
    return result;
}

