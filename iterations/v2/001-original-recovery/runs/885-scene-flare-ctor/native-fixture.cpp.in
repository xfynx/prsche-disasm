static void reset_side(I weather_idx) {
    g_arena_pos = 0u;
    g_alloc_count = 0u;
    g_ev_count = 0u;
    g_events.fill(0u);
    g_flare_obj.fill(0x5au);
    g_sky_obj.fill(0u);
    std::memset(g_arena, 0, sizeof(g_arena));

    porsche::scene_flare_resource_00627e18 = nullptr;
    porsche::scene_flare_aux_00627e1c = nullptr;
    porsche::scene_route_sky_bytes_00627e38 = nullptr;
    porsche::scene_route_sky_aux_00627e3c = nullptr;
    porsche::scene_route_sky_00627e4c = g_sky_obj.data();
    porsche::scene_sky_cleanup_state_00627e5c = nullptr;
    porsche::application_state_006573e8.words_.fill(0u);
    porsche::application_state_006573e8.words_[(0x00657d9cu - porsche::application_state_base_va) / 4u] =
        static_cast<U>(weather_idx);
    porsche::install_paths_table_0065b2a0[6] = "D:\\Data\\";
    porsche::startup_resource_prefix_0065b30c = "P:\\Res\\";

    const U chunk_ptr = raw_addr(g_vfs.sky_ltmp_chunk.data());
    if (g_vfs.ltmp_chunk_idx >= 0) {
        std::memcpy(g_sky_obj.data() + 8u + static_cast<U>(g_vfs.ltmp_chunk_idx) * 4u, &chunk_ptr, 4u);
    }
}

struct Snapshot {
    std::array<U, 2048> events;
    U ev_count;
    std::array<B, 0x64u> flare_obj;
    std::array<U, 6> globals;
    std::array<B, 262144> arena_used;
    U used_bytes;
};

static Snapshot g_snap_expected{};
static Snapshot g_snap_actual{};

static void take_snapshot(Snapshot& s, U used_bytes) {
    s.events = g_events;
    s.ev_count = g_ev_count;
    s.flare_obj = g_flare_obj;
    s.globals = {
        raw_addr(porsche::scene_flare_resource_00627e18),
        raw_addr(porsche::scene_flare_aux_00627e1c),
        raw_addr(porsche::scene_route_sky_bytes_00627e38),
        raw_addr(porsche::scene_route_sky_aux_00627e3c),
        raw_addr(porsche::scene_route_sky_00627e4c),
        raw_addr(porsche::scene_sky_cleanup_state_00627e5c),
    };
    s.used_bytes = used_bytes;
    std::memcpy(s.arena_used.data(), g_arena, used_bytes);
}

static void compare_snapshots(const Snapshot& a, const Snapshot& b, const char* tag) {
    if (a.ev_count != b.ev_count) {
        std::printf("  ev_count nat=%u cpp=%u\n", a.ev_count, b.ev_count);
    }
    require(a.ev_count == b.ev_count, tag);
    for (U i = 0u; i < a.ev_count; ++i) {
        if (a.events[i] != b.events[i]) {
            const U start = (i > 12u) ? (i - 12u) : 0u;
            for (U j = start; j <= i + 4u && j < a.ev_count; ++j) {
                std::printf("  ev[%u] nat=0x%08x cpp=0x%08x\n", j, a.events[j], b.events[j]);
            }
            require(false, "events");
        }
    }
    for (U i = 0u; i < 6u; ++i) {
        if (a.globals[i] != b.globals[i]) {
            std::printf("  global[%u] nat=0x%08x cpp=0x%08x\n", i, a.globals[i], b.globals[i]);
            require(false, "globals");
        }
    }
    for (U i = 0u; i < a.flare_obj.size(); ++i) {
        if (a.flare_obj[i] != b.flare_obj[i]) {
            std::printf("  flare_obj[0x%x] nat=0x%02x cpp=0x%02x\n", i, a.flare_obj[i], b.flare_obj[i]);
            require(false, "flare_obj");
        }
    }
    require(a.used_bytes == b.used_bytes, "used_bytes");
    for (U i = 0u; i < a.used_bytes; ++i) {
        if (a.arena_used[i] != b.arena_used[i]) {
            std::printf("  arena[0x%x] nat=0x%02x cpp=0x%02x\n", i, a.arena_used[i], b.arena_used[i]);
            require(false, "arena_used");
        }
    }
}

int main() {
    require(porsche::scene_flare_resource_00627e18 == nullptr, "bss resource");
    require(porsche::scene_flare_aux_00627e1c == nullptr, "bss aux");
    require(porsche::scene_route_sky_bytes_00627e38 == nullptr, "bss sky_bytes");
    require(porsche::scene_route_sky_aux_00627e3c == nullptr, "bss sky_aux");
    require(porsche::scene_route_sky_00627e4c == nullptr, "bss sky");
    require(porsche::scene_sky_cleanup_state_00627e5c == nullptr, "bss pos");

    B* const code = prepare_native();
    U cases = 0u;

    // 1. Standalone sun_dir + math_fcos_tau precision check across turns & offsets.
    using SunDirFn = void(__cdecl*)(float, float, float, float, float, float*, float);
    using CosFn = double(__cdecl*)(float);
    const auto nat_sundir = reinterpret_cast<SunDirFn>(code + SLOT_00461090);
    const auto nat_cos = reinterpret_cast<CosFn>(code + SLOT_005327f0);
    const float turns_list[] = {0.0f, 0.125f, 0.25f, 0.375f, 0.625f, -0.15f};
    for (float t : turns_list) {
        const float c_nat = static_cast<float>(nat_cos(t));
        const float c_cpp = static_cast<float>(porsche::math_fcos_tau_005327f0(t));
        require(std::memcmp(&c_nat, &c_cpp, 4u) == 0, "math_fcos_tau");

        float v_nat[4]{}, v_cpp[4]{};
        nat_sundir(0.15f, -0.25f, t, 75.0f, 0.0004f, v_nat, 1000.0f);
        porsche::scene_flare_sun_dir_00461090(0.15f, -0.25f, t, 75.0f, 0.0004f, v_cpp, 1000.0f);
        require(std::memcmp(v_nat, v_cpp, sizeof(v_nat)) == 0, "sun_dir");
        ++cases;
    }

    // 2. Standalone cursor_a, cursor_b, cursor_c (0, 1, 3, and 400-key clamp).
    using CursorFn = void*(__fastcall*)(void*, void*, void*, void*);
    const auto nat_cura = reinterpret_cast<CursorFn>(code + SLOT_0045a2c0);
    const auto nat_curb = reinterpret_cast<CursorFn>(code + SLOT_0045a490);
    const auto nat_curc = reinterpret_cast<CursorFn>(code + SLOT_0045a970);
    static std::array<B, 405u * 0x30u> k_work{}, k_init{}, k_nat_out{};
    for (U key_cnt : {0u, 1u, 3u, 400u}) {
        g_case_id = cases;
        std::array<B, 28> c_nat{}, c_cpp{};
        void* const res_tag = g_sky_obj.data();

        k_init.fill(0xff);
        for (U i = 0u; i < key_cnt; ++i) {
            const U tm = i * 10u;
            const U v = 0x3e800000u + i;
            std::memcpy(k_init.data() + i * 8u, &tm, 4u);
            std::memcpy(k_init.data() + i * 8u + 4u, &v, 4u);
        }
        k_work = k_init;
        nat_cura(c_nat.data(), nullptr, k_work.data(), res_tag);
        k_nat_out = k_work;
        k_work = k_init;
        porsche::scene_flare_cursor_a_ctor_0045a2c0(c_cpp.data(), nullptr, k_work.data(), res_tag);
        require(c_nat == c_cpp && k_nat_out == k_work, "cursor_a");

        k_init.fill(0xff);
        for (U i = 0u; i < key_cnt; ++i) {
            const U tm = i * 12u;
            const U v = 0x1000u + i;
            std::memcpy(k_init.data() + i * 8u, &tm, 4u);
            std::memcpy(k_init.data() + i * 8u + 4u, &v, 4u);
        }
        c_nat.fill(0); c_cpp.fill(0);
        k_work = k_init;
        nat_curc(c_nat.data(), nullptr, k_work.data(), res_tag);
        k_nat_out = k_work;
        k_work = k_init;
        porsche::scene_flare_cursor_c_ctor_0045a970(c_cpp.data(), nullptr, k_work.data(), res_tag);
        require(c_nat == c_cpp && k_nat_out == k_work, "cursor_c");

        k_init.fill(0xff);
        for (U i = 0u; i < key_cnt; ++i) {
            const U tm = i * 20u;
            std::memcpy(k_init.data() + i * 0x30u, &tm, 4u);
        }
        c_nat.fill(0); c_cpp.fill(0);
        k_work = k_init;
        nat_curb(c_nat.data(), nullptr, k_work.data(), res_tag);
        k_nat_out = k_work;
        k_work = k_init;
        porsche::scene_flare_cursor_b_ctor_0045a490(c_cpp.data(), nullptr, k_work.data(), res_tag);
        require(c_nat == c_cpp && k_nat_out == k_work, "cursor_b");
        ++cases;
    }

    // 3. Standalone tokenize + chunk_get + sky_aux_ctor.
    using TokFn = I(__fastcall*)(void*, void*, char*, char*);
    const auto nat_tok = reinterpret_cast<TokFn>(code + SLOT_0045fb10);
    const char* tok_samples[] = {
        "  alpha   beta\t\ngamma\r\ndelta",
        "\t  one\n\n#comment\ntwo   ",
        "single_no_newline",
    };
    for (const char* src : tok_samples) {
        std::array<char, 128> b_nat{}, b_cpp{};
        const U len = static_cast<U>(std::strlen(src));
        std::memcpy(b_nat.data() + 1u, src, len);
        std::memcpy(b_cpp.data() + 1u, src, len);
        const I rn = nat_tok(nullptr, nullptr, b_nat.data() + 1u, b_nat.data() + 1u + len);
        const I rc = porsche::scene_flare_cfg_tokenize_0045fb10(
            nullptr, nullptr, b_cpp.data() + 1u, b_cpp.data() + 1u + len);
        require(rn == rc && b_nat == b_cpp, "tokenize");
        ++cases;
    }

    // 4. End-to-end scene_flare_ctor_0045d800 across all versions, VFS combos, weather rows, and sky modes.
    using FlareCtorFn = void*(__fastcall*)(void*, void*, const char*);
    const auto nat_flare_ctor = reinterpret_cast<FlareCtorFn>(code + SLOT_0045d800);

    static const char kTxtPartA[] =
        "# header comment\n"
        "begin\n"
        "  low|high|amazing\n"
        "  BASIC\n"
        "  flareA.fsh\n"
        "begin\n"
        "  all\n"
        "  MultiNormal\n"
        "  flareB.fsh\n"
        "begin\n"
        "  medium\n"
        "  additive\n"
        "  flareOld.fsh\n"
        "begin\n"
        "  all\n"
        "  multiadditive\n"
        "  flareC.fsh\n"
        "begin\n"
        "  amazing|high\n"
        "  multiattenuate\n"
        "  flareD.fsh\n"
        "begin\n"
        "  all\n"
        "  multimodulate\n"
        "  flareE.fsh\n"
        "begin\n"
        "  all\n"
        "  freecloud\n"
        "  cloud.fsh\n"
        "begin\n"
        "  all\n"
        "  config\n"
        "  cfg.dat\n";

    static const char kTxtPartB[] =
        "# water & unknown modes\n"
        "begin\n"
        "  all\n"
        "  basicwater\n"
        "  wb.fsh\n"
        "begin\n"
        "  all\n"
        "  multinormalwater\n"
        "  wn.fsh\n"
        "begin\n"
        "  all\n"
        "  multiadditivewater\n"
        "  wa.fsh\n"
        "begin\n"
        "  all\n"
        "  multiattenuatewater\n"
        "  wat.fsh\n"
        "begin\n"
        "  all\n"
        "  multimodulatewater\n"
        "  wm.fsh\n"
        "begin\n"
        "  all\n"
        "  unknownmode\n"
        "  unk.fsh\n";

    static const char kTxtTiny[] =
        "begin\n"
        "  low\n"
        "  multiadditivewater\n"
        "  water_only.fsh\n";

    struct Scenario {
        I weather;
        bool has_named_bin;
        bool has_def_bin;
        I bin_ver;
        bool has_named_txt;
        bool has_def_txt;
        const char* txt;
        bool has_flarepos;
        I ltmp_idx;
        U cdc_bits;
        U ce0_bits;
        U row_mask;
        U key_a;
    };

    const Scenario scenarios[] = {
        {2, true,  false, -1, true,  false, kTxtPartA, true,   3, 0x3b800000u, 0xbb800000u, 0x5u, 0xffffffffu},
        {0, false, true,   0, false, true,  kTxtTiny,  false, -1, 0x3ca3d70au, 0x00000000u, 0x0u, 0x00000000u},
        {1, true,  false,  1, true,  false, kTxtPartA, false,  1, 0xbca3d70au, 0x3f000000u, 0x3u, 0x00000005u},
        {3, true,  false,  2, true,  false, kTxtPartB, true,   0, 0x00000000u, 0xbf000000u, 0x0u, 0xffffffffu},
        {2, true,  false,  3, true,  false, kTxtTiny,  true,   2, 0x3c23d70au, 0xbc23d70au, 0x8u, 0x00000001u},
        {1, true,  false,  4, false, false, nullptr,   false, -1, 0x3f800000u, 0x00000000u, 0x2u, 0xffffffffu},
        {0, true,  false,  5, true,  false, "",        false,  4, 0x00000000u, 0x3c900000u, 0x1u, 0xffffffffu},
        {3, true,  false,  6, true,  false, kTxtPartB, true,   5, 0x3ca3d70au, 0xbca3d70au, 0x4u, 0x00000002u},
        {2, true,  false,  7, true,  false, kTxtPartA, true,   2, 0x00000000u, 0x00000000u, 0xau, 0xffffffffu},
        {1, true,  false,  8, true,  false, kTxtPartB, false, -1, 0xbf800000u, 0xbf800000u, 0x0u, 0xffffffffu},
        {3, true,  false,  9, true,  false, kTxtPartA, true,   1, 0x3c400000u, 0xbc400000u, 0xcu, 0x00000000u},
        {2, false, false,  0, true,  false, kTxtTiny,  false,  0, 0x00000000u, 0x00000000u, 0x0u, 0xffffffffu},
    };

    for (const Scenario& sc : scenarios) {
        g_case_id = cases;
        g_vfs = VfsState{};
        g_vfs.has_named_bin = sc.has_named_bin;
        g_vfs.has_default_bin = sc.has_def_bin;
        g_vfs.bin_version = sc.bin_ver;
        g_vfs.has_named_txt = sc.has_named_txt;
        g_vfs.has_default_txt = sc.has_def_txt;
        g_vfs.txt_body = sc.txt;
        g_vfs.txt_len = (sc.txt != nullptr) ? static_cast<U>(std::strlen(sc.txt)) : 0u;
        g_vfs.has_flarepos = sc.has_flarepos;
        g_vfs.ltmp_chunk_idx = sc.ltmp_idx;
        for (U r = 0u; r < 4u; ++r) {
            g_vfs.bin_seed_words[r] = ((sc.row_mask >> r) & 1u) ? (r + 1u) : 0u;
        }
        g_vfs.bin_seed_words[4] = sc.cdc_bits;
        g_vfs.bin_seed_words[5] = sc.ce0_bits;
        g_vfs.bin_seed_words[6] = 0x3e99999au; // 0.3f
        g_vfs.bin_seed_words[7] = 0x3e000000u; // 0.125f
        g_vfs.bin_seed_words[8] = 0x3a83126fu; // 0.001f
        g_vfs.bin_seed_words[9] = 0x42480000u; // 50.0f
        for (U k = 0u; k < 6u; ++k) {
            g_vfs.bin_seed_words[16u + k] = (sc.key_a == 0xffffffffu) ? 0xffffffffu : (sc.key_a + k * 5u);
        }
        for (U k = 0u; k < 4u; ++k) {
            g_vfs.bin_seed_words[24u + k] = (sc.key_a == 0xffffffffu) ? 0xffffffffu : (sc.key_a + k * 7u);
        }
        for (U i = 0u; i < 14u; ++i) {
            g_vfs.flarepos_words[i] = 0x3f000000u + i * 0x00100000u;
        }
        for (U i = 0u; i < 49u; ++i) {
            const U px = 0x01020304u * (i + 1u);
            std::memcpy(g_vfs.sky_ltmp_chunk.data() + 0x10u + i * 4u, &px, 4u);
        }

        reset_side(sc.weather);
        void* const nat_ret = nat_flare_ctor(g_flare_obj.data(), nullptr, "trackA");
        require(nat_ret == g_flare_obj.data(), "nat ret");
        const U used = g_arena_pos;
        take_snapshot(g_snap_expected, used);

        reset_side(sc.weather);
        void* const cpp_ret = porsche::scene_flare_ctor_0045d800(g_flare_obj.data(), nullptr, "trackA");
        require(cpp_ret == g_flare_obj.data(), "cpp ret");
        take_snapshot(g_snap_actual, g_arena_pos);
        compare_snapshots(g_snap_expected, g_snap_actual, "scene_flare_ctor");
        ++cases;
    }

    // 5. Allocation-failure tolerance on leaves & ctor null-alloc branches (after res/pos/aux/cfg-item).
    for (U budget : {33u, 34u, 35u, 37u, 38u}) {
        g_case_id = cases;
        g_vfs = VfsState{};
        g_vfs.has_named_txt = true;
        if (budget <= 35u) {
            g_vfs.txt_body = "";
            g_vfs.txt_len = 0u;
        } else {
            g_vfs.txt_body = kTxtTiny;
            g_vfs.txt_len = static_cast<U>(std::strlen(kTxtTiny));
        }
        g_vfs.net_alloc_budget = budget;
        reset_side(0);
        nat_flare_ctor(g_flare_obj.data(), nullptr, "nullcase");
        const U used_fail = g_arena_pos;
        take_snapshot(g_snap_expected, used_fail);

        g_vfs.net_alloc_budget = budget;
        reset_side(0);
        porsche::scene_flare_ctor_0045d800(g_flare_obj.data(), nullptr, "nullcase");
        take_snapshot(g_snap_actual, g_arena_pos);
        compare_snapshots(g_snap_expected, g_snap_actual, "alloc_fail_leaf");
        ++cases;
    }

    // Standalone null-alloc tolerance for 00459600, 00459950, 0045cc40, 004601f0.
    using VoidStrFn = void(__cdecl*)(const char*);
    using VoidFn = void(__cdecl*)();
    using VoidPtrFn = void(__cdecl*)(void*);
    const auto nat_res_init = reinterpret_cast<VoidStrFn>(code + SLOT_00459600);
    const auto nat_aux_init = reinterpret_cast<VoidFn>(code + SLOT_00459950);
    const auto nat_pos_init = reinterpret_cast<VoidPtrFn>(code + SLOT_004601f0);
    {
        g_case_id = cases;
        g_vfs = VfsState{};
        g_vfs.net_alloc_budget = 0u;
        reset_side(0);
        nat_res_init("x");
        nat_aux_init();
        nat_pos_init(g_sky_obj.data());
        const U u0 = g_arena_pos;
        take_snapshot(g_snap_expected, u0);

        g_vfs.net_alloc_budget = 0u;
        reset_side(0);
        porsche::scene_flare_resource_init_00459600("x");
        porsche::scene_flare_aux_init_00459950();
        porsche::scene_flare_pos_init_004601f0(g_sky_obj.data());
        take_snapshot(g_snap_actual, g_arena_pos);
        compare_snapshots(g_snap_expected, g_snap_actual, "standalone_null_init");
        ++cases;
    }

    std::printf("cases=%u scene_flare_ctor_original_x86_vs_cpp=PASS\n", cases);
    return 0;
}
