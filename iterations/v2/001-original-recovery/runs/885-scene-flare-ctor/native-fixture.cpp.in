void* __cdecl application_context_member_block_0059ecb0(U bytes, U heap, U source_va) {
    push_ev(0x1004u);
    push_ev(bytes);
    push_ev(heap);
    U tag_hash = 0u;
    if (source_va != 0u) {
        tag_hash = fnv1a_cstr(reinterpret_cast<const char*>(static_cast<std::uintptr_t>(source_va)));
    }
    push_ev(tag_hash);
    void* const p = arena_alloc(bytes, bytes);
    push_ev(raw_addr(p));
    return p;
}

