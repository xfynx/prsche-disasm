}

void* __cdecl startup_network_allocate_0059ef90(U bytes) {
    push_ev(0x1001u);
    push_ev(bytes);
    if (g_vfs.fail_next_net_alloc || g_vfs.net_alloc_budget == 0u) {
        g_vfs.fail_next_net_alloc = false;
        push_ev(0u);
        return nullptr;
    }
    if (g_vfs.net_alloc_budget != 0xffffffffu) {
        --g_vfs.net_alloc_budget;
    }
    void* const p = arena_alloc(bytes + 4u, bytes);
    push_ev(raw_addr(p));
    return p;
}

