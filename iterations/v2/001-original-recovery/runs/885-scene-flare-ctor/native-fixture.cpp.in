static void require(bool cond, const char* why) {
    if (!cond) {
        std::printf("divergence %s case=%u\n", why, g_case_id);
        std::exit(7);
    }
}

static inline U raw_addr(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U fnv1a_bytes(const void* data, U len) {
    const auto* p = static_cast<const B*>(data);
    U h = 2166136261u;
    for (U i = 0u; i < len; ++i) {
        h ^= p[i];
        h *= 16777619u;
    }
    return h;
}

static U fnv1a_cstr(const char* s) {
    if (s == nullptr) {
        return 0u;
    }
    return fnv1a_bytes(s, static_cast<U>(std::strlen(s)));
}

// Shared deterministic side arena reset between native and C++ halves.
struct AllocRec {
    const void* ptr;
    U size;
};

static alignas(16) B g_arena[262144];
static U g_arena_pos = 0u;
static std::array<AllocRec, 512> g_allocs{};
static U g_alloc_count = 0u;

static void* arena_alloc(U alloc_bytes, U reported_size) {
    const U aligned = (alloc_bytes + 7u) & ~7u;
    require(g_arena_pos + aligned <= sizeof(g_arena), "arena overflow");
    require(g_alloc_count < g_allocs.size(), "alloc table overflow");
    void* const p = g_arena + g_arena_pos;
    std::memset(p, 0, aligned);
    g_arena_pos += aligned;
    g_allocs[g_alloc_count++] = {p, reported_size};
    return p;
}

static U lookup_alloc_size(const void* p) {
    for (U i = 0u; i < g_alloc_count; ++i) {
        if (g_allocs[i].ptr == p) {
            return g_allocs[i].size;
        }
    }
    return 0u;
}

static std::array<U, 2048> g_events{};
static U g_ev_count = 0u;
static void push_ev(U tag) {
    require(g_ev_count < g_events.size(), "event overflow");
    g_events[g_ev_count++] = tag;
}

