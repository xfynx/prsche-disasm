static B* prepare_native() {
    B* const code = static_cast<B*>(
        VirtualAlloc(nullptr, 8192, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE));
    require(code != nullptr, "VirtualAlloc");

    std::memcpy(code + SLOT_00459600, body_00459600, sizeof(body_00459600));
    std::memcpy(code + SLOT_00459660, body_00459660, sizeof(body_00459660));
    std::memcpy(code + SLOT_00459700, body_00459700, sizeof(body_00459700));
    std::memcpy(code + SLOT_00459950, body_00459950, sizeof(body_00459950));
    std::memcpy(code + SLOT_0045a2c0, body_0045a2c0, sizeof(body_0045a2c0));
    std::memcpy(code + SLOT_0045a490, body_0045a490, sizeof(body_0045a490));
    std::memcpy(code + SLOT_0045a970, body_0045a970, sizeof(body_0045a970));
    std::memcpy(code + SLOT_0045cb80, body_0045cb80, sizeof(body_0045cb80));
    std::memcpy(code + SLOT_0045cc40, body_0045cc40, sizeof(body_0045cc40));
    std::memcpy(code + SLOT_0045d800, body_0045d800, sizeof(body_0045d800));
    std::memcpy(code + SLOT_0045fb00, body_0045fb00, sizeof(body_0045fb00));
    std::memcpy(code + SLOT_0045fb10, body_0045fb10, sizeof(body_0045fb10));
    std::memcpy(code + SLOT_0045fb80, body_0045fb80, sizeof(body_0045fb80));
    std::memcpy(code + SLOT_00460170, body_00460170, sizeof(body_00460170));
    std::memcpy(code + SLOT_004601f0, body_004601f0, sizeof(body_004601f0));
    std::memcpy(code + SLOT_00460780, body_00460780, sizeof(body_00460780));
    std::memcpy(code + SLOT_00460c70, body_00460c70, sizeof(body_00460c70));
    std::memcpy(code + SLOT_00461090, body_00461090, sizeof(body_00461090));
    std::memcpy(code + SLOT_005327f0, body_005327f0, sizeof(body_005327f0));
    std::memcpy(code + SLOT_0053bfd0, body_0053bfd0, sizeof(body_0053bfd0));

    auto patch_abs = [](B* fn, U off, U expected, U value) {
        U actual = 0u;
        std::memcpy(&actual, fn + off, 4u);
        require(actual == expected, "reloc operand mismatch");
        std::memcpy(fn + off, &value, 4u);
    };
    auto patch_rel = [](B* fn, U off, U expected_disp, U target) {
        U actual = 0u;
        std::memcpy(&actual, fn + off, 4u);
        require(actual == expected_disp, "call disp mismatch");
        const U disp = target - raw_addr(fn + off + 4u);
        std::memcpy(fn + off, &disp, 4u);
    };

    const U a_res = raw_addr(&porsche::scene_flare_resource_00627e18);
