}

static void populate_sky_bin_buffer(B* buf, U case_tag) {
    std::memcpy(buf, &g_vfs.bin_version, 4u);
    // Populate distinct payload patterns across all legacy source offsets (0x04..0x2000)
    // so v0..v8 copy/upgrade branches produce visible, material output differences.
    for (U off = 4u; off < 0x1600u; off += 4u) {
        const U val = 0x10000000u ^ (off * 0x0101u) ^ (case_tag * 0x1337u);
        std::memcpy(buf + off, &val, 4u);
    }
    // Seed 4 weather rows at 0xce8..0xdd7 (optional non-zero triggers for aux_init).
    for (U r = 0u; r < 4u; ++r) {
        const U w = g_vfs.bin_seed_words[r];
        std::memcpy(buf + 0xce8u + r * 0x3cu, &w, 4u);
    }
    // Sun & pos floats at 0x3c..0x48 and 0xcdc..0xce4 (used after upgrade).
    const U cdc = g_vfs.bin_seed_words[4];
    const U ce0 = g_vfs.bin_seed_words[5];
    const U ce4 = g_vfs.bin_seed_words[6];
    const U f3c = g_vfs.bin_seed_words[7];
    const U f44 = g_vfs.bin_seed_words[8];
    const U f48 = g_vfs.bin_seed_words[9];
    std::memcpy(buf + 0xcdcu, &cdc, 4u);
    std::memcpy(buf + 0xce0u, &ce0, 4u);
    std::memcpy(buf + 0xce4u, &ce4, 4u);
    std::memcpy(buf + 0x3cu, &f3c, 4u);
    std::memcpy(buf + 0x44u, &f44, 4u);
    std::memcpy(buf + 0x48u, &f48, 4u);
    // Optional keyframe sentinel at 0xddcu, 0x1a5cu, 0x655cu for ver == 9.
    for (U k = 0u; k < 6u; ++k) {
        const U v = g_vfs.bin_seed_words[16u + k];
        std::memcpy(buf + 0xddcu + k * 8u, &v, 4u);
        std::memcpy(buf + 0x655cu + k * 8u, &v, 4u);
    }
    for (U k = 0u; k < 4u; ++k) {
        const U v = g_vfs.bin_seed_words[24u + k];
        std::memcpy(buf + 0x1a5cu + k * 0x30u, &v, 4u);
    }
}

static void* handle_open(U ev_id, const char* name, U flags) {
    push_ev(ev_id);
    push_ev(fnv1a_cstr(name));
    push_ev(flags);
    if (name == nullptr) {
        push_ev(0u);
        return nullptr;
    }
    if (std::strstr(name, "default.bin") != nullptr) {
        if (!g_vfs.has_default_bin) {
            push_ev(0u);
            return nullptr;
        }
        auto* const p = static_cast<B*>(arena_alloc(kSkyCfgSize, kSkyCfgSize));
        populate_sky_bin_buffer(p, 0xdu);
        push_ev(raw_addr(p));
        return p;
    }
    if (std::strstr(name, ".bin") != nullptr) {
        if (!g_vfs.has_named_bin) {
            push_ev(0u);
            return nullptr;
        }
        auto* const p = static_cast<B*>(arena_alloc(kSkyCfgSize, kSkyCfgSize));
        populate_sky_bin_buffer(p, 0xbu);
        push_ev(raw_addr(p));
        return p;
    }
    if (std::strstr(name, "default.txt") != nullptr) {
        if (!g_vfs.has_default_txt) {
            push_ev(0u);
            return nullptr;
        }
        auto* const p = static_cast<B*>(arena_alloc(g_vfs.txt_len + 8u, g_vfs.txt_len));
        if (g_vfs.txt_len > 0u && g_vfs.txt_body != nullptr) {
            std::memcpy(p, g_vfs.txt_body, g_vfs.txt_len);
        }
        push_ev(raw_addr(p));
        return p;
    }
    if (std::strstr(name, ".txt") != nullptr) {
        if (!g_vfs.has_named_txt) {
            push_ev(0u);
            return nullptr;
        }
        auto* const p = static_cast<B*>(arena_alloc(g_vfs.txt_len + 8u, g_vfs.txt_len));
        if (g_vfs.txt_len > 0u && g_vfs.txt_body != nullptr) {
            std::memcpy(p, g_vfs.txt_body, g_vfs.txt_len);
        }
        push_ev(raw_addr(p));
        return p;
    }
    if (std::strstr(name, "flarepos.dat") != nullptr) {
        if (!g_vfs.has_flarepos) {
            push_ev(0u);
            return nullptr;
        }
        auto* const p = static_cast<B*>(arena_alloc(0x38u, 0x38u));
        std::memcpy(p, g_vfs.flarepos_words.data(), 0x38u);
        push_ev(raw_addr(p));
        return p;
    }
    push_ev(0u);
    return nullptr;
}

void* __cdecl resource_open_0059d8e0(const char* name, U flags) {
    return handle_open(0x1007u, name, flags);
}

void* __cdecl resource_open_quiet_0059d9b0(const char* name, U flags) {
    return handle_open(0x1008u, name, flags);
}

