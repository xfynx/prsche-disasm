}

int __cdecl formatter_float_lower_005a2248(int ch) {
    if (ch >= 'A' && ch <= 'Z') {
        return ch + ('a' - 'A');
    }
    return ch;
}

int __cdecl formatter_text_compare_n_005a2210(const char* a, const char* b, U n) {
    for (U i = 0u; i < n; ++i) {
        const unsigned char ca = static_cast<unsigned char>(a[i]);
        const unsigned char cb = static_cast<unsigned char>(b[i]);
        if (ca != cb) {
            return (ca < cb) ? -1 : 1;
        }
        if (ca == 0u) {
            return 0;
        }
    }
    return 0;
}

