I __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    std::va_list ap;
    va_start(ap, format);
    const int n = std::vsprintf(output, format, ap);
    va_end(ap);
    push_ev(0x100au);
    push_ev(fnv1a_cstr(format));
    push_ev(fnv1a_cstr(output));
    return n;
}

int __cdecl formatter_stdio_printf_005a177b(const char* fmt, ...) {
