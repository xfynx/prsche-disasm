static void reset_common() {
    std::memset(arena_buf, 0x5au, sizeof arena_buf);
    porsche::shared_runtime_word_005deb74 = 0u;
    porsche::shared_runtime_word_005deb78 = 0u;
    porsche::diagnostic_handler_005debf0 =
        reinterpret_cast<void(__cdecl*)(const char*)>(&stub_diag_handler);
    std::memset(ops_table, 0, sizeof ops_table);
    ops_table[5] = ptr_u(&stub_alloc);
    porsche::render_service_ops_005dec08 = &ops_table[0];
    alloc_fail_mode = 0u;
}

static void check_snapshots(const char* label) {
    require(expected.abi_fail == 0u && actual.abi_fail == 0u, label);
    require(std::memcmp(&expected, &actual, sizeof(Snapshot)) == 0, label);
    ++cases;
}

static void test_readers() {
    const B stream[] = {0x41u, 0x20u, 0x7fu, 0x1fu, 0x80u, 0x40u, 0x82u, 0x60u, 0xffu, 0x01u, 0x00u, 0x10u};
    for (U off = 0u; off <= 8u; ++off) {
        for (U kind = 0u; kind < 3u; ++kind) {
            void* orig_fn = (kind == 0u) ? code_573a90 : (kind == 1u ? code_573ab0 : code_573ae0);
            void* cpp_fn = (kind == 0u)
                ? reinterpret_cast<void*>(&porsche::font_read_u16_cursor_00573a90)
                : (kind == 1u
                       ? reinterpret_cast<void*>(&porsche::font_read_u8_cursor_00573ab0)
                       : reinterpret_cast<void*>(&porsche::font_read_sjis_cursor_00573ae0));
            for (U s = 0u; s < 2u; ++s) {
                side = s;
                Snapshot& dst = (s == 0u) ? expected : actual;
                std::memset(&dst, 0, sizeof dst);
                cur = &dst;
                const B* p = &stream[off];
                U abi = 0u;
                dst.ret = invoke1(s == 0u ? orig_fn : cpp_fn, ptr_u(&p), abi);
                dst.abi_fail = abi;
                dst.cursor_off = static_cast<U>(p - &stream[0]);
            }
            check_snapshots("reader");
        }
    }

    const U ac0_inputs[] = {
        0x00u, 0x1fu, 0x20u, 0x21u, 0x30u, 0x41u, 0x5au, 0x61u, 0x7au, 0x7eu,
        0x7fu, 0x80u, 0xffffu, 0x1234001fu, 0x12340020u, 0x12340041u, 0x1234007fu, 0x12340080u,
    };
    for (U v : ac0_inputs) {
        for (U s = 0u; s < 2u; ++s) {
            side = s;
            Snapshot& dst = (s == 0u) ? expected : actual;
            std::memset(&dst, 0, sizeof dst);
            cur = &dst;
            U abi = 0u;
            dst.ret = invoke1(
                s == 0u ? static_cast<void*>(code_573ac0)
                        : reinterpret_cast<void*>(&porsche::font_ascii_to_sjis_fullwidth_00573ac0),
                v, abi);
            dst.abi_fail = abi;
        }
        check_snapshots("ascii_sjis_573ac0");
    }
}

static void write_le16(B* dst, U code) {
    dst[0] = static_cast<B>(code & 0xffu);
    dst[1] = static_cast<B>((code >> 8u) & 0xffu);
}

static void test_glyph_search() {
    // 256 bytes prefix padding so negative idx reads stay safely inside buffer.
    B table_mem[256 + 16 * 11]{};
    std::memset(table_mem, 0x77, sizeof table_mem);
    B* const table = &table_mem[256];
    const U codes[7] = {0x0020u, 0x0041u, 0x0042u, 0x0044u, 0x0045u, 0x8140u, 0x8260u};
    for (U i = 0u; i < 7u; ++i) {
        write_le16(table + i * 11u, codes[i]);
    }
    const U query_codes[] = {0x001fu, 0x0020u, 0x0021u, 0x0041u, 0x0043u, 0x0045u, 0x8140u, 0x8260u, 0x9999u};
    const I counts[] = {0, 1, 2, 7};
    for (I cnt : counts) {
        for (U key : query_codes) {
            for (U s = 0u; s < 2u; ++s) {
                side = s;
                Snapshot& dst = (s == 0u) ? expected : actual;
                std::memset(&dst, 0, sizeof dst);
                cur = &dst;
                U abi = 0u;
                U res = invoke4(
                    s == 0u ? static_cast<void*>(code_53d970)
                            : reinterpret_cast<void*>(&porsche::font_bsearch_glyph_0053d970),
                    key, ptr_u(table), static_cast<U>(cnt), 11u, abi);
                dst.abi_fail = abi;
                dst.ret = (res == 0u) ? 0u : (res - ptr_u(table) + 1u);
            }
            check_snapshots("bsearch_53d970");
        }
    }

    // Direct-path + fallback cases for 0053d920
    B dense_mem[256 + 40 * 11]{};
    std::memset(dense_mem, 0x22, sizeof dense_mem);
    B* const dense = &dense_mem[256];
    for (U i = 0u; i < 38u; ++i) {
        U code = 0x0020u + i;
        if (i == 4u) {
            code = 0x0099u;
        } else if (i == 6u) {
            code = 0x0001u;
        } else if (i == 33u) {
            // Break direct-index at 'A' (0x41 = 0x20 + 33) -> falls back to bsearch
            code = 0x0042u;
        } else if (i == 34u) {
            code = 0x0043u;
        }
        write_le16(dense + i * 11u, code);
    }
    const U find_queries[] = {0x001fu, 0x0020u, 0x0025u, 0x0040u, 0x0041u, 0x0042u, 0x0043u, 0x0045u, 0x0046u, 0x8140u};
    for (U q : find_queries) {
        for (U s = 0u; s < 2u; ++s) {
            side = s;
            Snapshot& dst = (s == 0u) ? expected : actual;
            std::memset(&dst, 0, sizeof dst);
            cur = &dst;
            reset_common();
            store32(&arena_buf[0x1cu], 38u);
            store32(&arena_buf[0x28u], ptr_u(dense));
            U abi = 0u;
            U res = invoke2(
                s == 0u ? static_cast<void*>(code_53d920)
                        : reinterpret_cast<void*>(&porsche::font_find_glyph_0053d920),
                ptr_u(arena_buf), q, abi);
            dst.abi_fail = abi;
            dst.ret = (res == 0u) ? 0u : (res - ptr_u(dense) + 1u);
        }
        check_snapshots("find_glyph_53d920");
    }
}

static void test_setstate() {
    struct Case {
        I state;
        U value;
        U init_val;
    };
    const Case list[] = {
        {0, 0u, 0u},
        {1, 0u, 0u},
        {1, 0x00018000u, 0u},
        {2, 0x80000081u, 0u},
        {3, 0xffffffffu, 0u},
        {4, 0x00020000u, 0u},
        {5, 1u, 6u},
        {5, 0u, 7u},
        {6, 1u, 5u},
        {6, 2u, 7u},
        {7, 1u, 3u},
        {7, 0u, 7u},
        {8, 0x11223344u, 0x11223344u},
        {8, 0x55667788u, 0x11223344u},
        {9, 0x11223344u, 0x11223344u},
        {9, 0x99aabbccu, 0x11223344u},
        {10, 0xaabbccddu, 0xaabbccddu},
        {10, 0x01020304u, 0xaabbccddu},
        {11, 0xdeadbeefu, 0xdeadbeefu},
        {11, 0x12345678u, 0xdeadbeefu},
        {12, 0xfedcba98u, 0u},
        {13, 0x01010101u, 0u},
        {14, 0x02020202u, 0u},
        {15, 0x03030303u, 0u},
        {16, 0x04040404u, 0u},
        {17, 0u, 0u},
        {-1, 0u, 0u},
        {99, 123u, 0u},
    };
    for (const Case& c : list) {
        for (U s = 0u; s < 2u; ++s) {
            side = s;
            Snapshot& dst = (s == 0u) ? expected : actual;
            std::memset(&dst, 0, sizeof dst);
            cur = &dst;
            reset_common();
            store32(&arena_buf[0x5cu], c.init_val);
            store32(&arena_buf[0x60u], c.init_val);
            store32(&arena_buf[0x64u], c.init_val);
            store32(&arena_buf[0x68u], c.init_val);
            store32(&arena_buf[0xbcu], c.init_val);
            arena_buf[0xacu] = 0u;
            U abi = 0u;
            invoke3(
                s == 0u ? static_cast<void*>(code_53e5c0)
                        : reinterpret_cast<void*>(&porsche::font_setstate_0053e5c0),
                ptr_u(arena_buf), static_cast<U>(c.state), c.value, abi);
            dst.abi_fail = abi;
            std::memcpy(dst.arena, arena_buf, kArenaBytes);
        }
        check_snapshots("setstate_53e5c0");
    }
}

static U tag_reader(U fn_ptr) {
    if (fn_ptr == ptr_u(code_573a90) || fn_ptr == ptr_u(&porsche::font_read_u16_cursor_00573a90)) {
        return 1u;
    }
    if (fn_ptr == ptr_u(code_573ab0) || fn_ptr == ptr_u(&porsche::font_read_u8_cursor_00573ab0)) {
        return 2u;
    }
    if (fn_ptr == ptr_u(code_573ae0) || fn_ptr == ptr_u(&porsche::font_read_sjis_cursor_00573ae0)) {
        return 3u;
    }
    return fn_ptr;
}

static void test_font_create() {
    struct CreateCase {
        U fail_alloc;
        U flags;
        U num_chars;
        U word20;
        B metric10;
        B metric11;
        B metric12;
        B metric13;
        U glyph_code;
        B glyph_h;
        B glyph_yoff;
    };
    const CreateCase list[] = {
        {1u, 0x00000000u, 10u, 0x0041u, 1u, 2u, 10u, 4u, 0x0041u, 12u, 0xfeu},
        {0u, 0x00010000u, 10u, 0x0041u, 0xfcu, 0x05u, 14u, 6u, 0x0041u, 11u, 0x02u},
        {0u, 0x00020000u, 10u, 0x0041u, 2u, 3u, 16u, 5u, 0x0043u, 9u, 0xffu},
        {0u, 0x00000000u, 1u, 0x0041u, 0u, 1u, 12u, 4u, 0x0045u, 8u, 0x01u},
        {0u, 0x00000000u, 260u, 0x0041u, 1u, 1u, 12u, 3u, 0x0042u, 7u, 0x00u},
        {0u, 0x00030000u, 10u, 0x8140u, 1u, 1u, 12u, 3u, 0x0046u, 7u, 0x00u},
    };
    B font_data_mem[512]{};
    const B probe_bytes[4] = {0x41u, 0x81u, 0x40u, 0x00u};

    for (const CreateCase& c : list) {
        std::memset(font_data_mem, 0, sizeof font_data_mem);
        // Header starts at offset 16 so 0056e2a8(src, 2) prefix reads stay inside font_data_mem.
        B* const fd = &font_data_mem[16];
        fd[0x0au] = static_cast<B>(c.num_chars & 0xffu);
        fd[0x0bu] = static_cast<B>((c.num_chars >> 8u) & 0xffu);
        store32(fd + 0x0cu, c.flags);
        fd[0x10u] = c.metric10;
        fd[0x11u] = c.metric11;
        fd[0x12u] = c.metric12;
        fd[0x13u] = c.metric13;
        store32(fd + 0x14u, 0x40u); // glyph table offset
        store32(fd + 0x1cu, 0x80u); // bitmap data offset
        write_le16(fd + 0x20u, c.word20);

        B* const gtable = fd + 0x40u;
        write_le16(gtable, c.glyph_code);
        gtable[3] = c.glyph_h;
        gtable[0xau] = c.glyph_yoff;

        for (U s = 0u; s < 2u; ++s) {
            side = s;
            Snapshot& dst = (s == 0u) ? expected : actual;
            std::memset(&dst, 0, sizeof dst);
            cur = &dst;
            reset_common();
            alloc_fail_mode = c.fail_alloc;
            U abi = 0u;
            U res = invoke1(
                s == 0u ? static_cast<void*>(code_53c6c0)
                        : reinterpret_cast<void*>(&porsche::render_debug_font_create_0053c6c0),
                ptr_u(fd), abi);
            dst.abi_fail = abi;
            if (res == 0u) {
                dst.ret = 0u;
            } else {
                require(res == ptr_u(arena_buf), "alloc_ptr");
                dst.ret = 1u;
                const U reader_ptr = load32(&arena_buf[0x30u]);
                dst.reader_tag = tag_reader(reader_ptr);
                require(dst.reader_tag >= 1u && dst.reader_tag <= 3u, "reader_tag");
                const B* p = &probe_bytes[0];
                U r_abi = 0u;
                dst.reader_res = invoke1(reinterpret_cast<void*>(static_cast<std::uintptr_t>(reader_ptr)),
                                         ptr_u(&p), r_abi);
                require(r_abi == 0u, "reader_abi");
                dst.reader_adv = static_cast<U>(p - &probe_bytes[0]);

                // Canonicalize pointers relative to fd / tag before snapshot copy
                store32(&arena_buf[0x24u], load32(&arena_buf[0x24u]) - ptr_u(fd));
                store32(&arena_buf[0x28u], load32(&arena_buf[0x28u]) - ptr_u(fd));
                store32(&arena_buf[0x2cu], load32(&arena_buf[0x2cu]) - ptr_u(fd));
                store32(&arena_buf[0x30u], dst.reader_tag);
                std::memcpy(dst.arena, arena_buf, kArenaBytes);
            }
        }
        check_snapshots("create_53c6c0");
    }
}

} // namespace

int main() {
    SetUnhandledExceptionFilter(fault_handler);
    init_originals();
    test_readers();
    test_glyph_search();
    test_setstate();
    test_font_create();
    std::printf("render_debug_font_create_793_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
