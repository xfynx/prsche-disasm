std::uint32_t __cdecl render_buffer_read_word_0056e2a8(const void* src, std::int32_t bytes) {
    const auto* const p = static_cast<const std::uint8_t*>(src) + bytes - 4;
    std::uint32_t val = 0u;
    std::memcpy(&val, p, sizeof val);
    const std::uint32_t shift = static_cast<std::uint32_t>((-bytes) * 8 + 32) & 0x1fu;
    return val >> shift;
}

void __cdecl font_state_set_pair_0053eea0(
    void* obj, std::uint32_t first, std::uint32_t second) {
    if (cur != nullptr && cur->call_count < kMaxCalls) {
        cur->calls[cur->call_count++] = {1u, first, second};
    }
    store32(static_cast<B*>(obj) + 0x3cu, first);
    store32(static_cast<B*>(obj) + 0x40u, second);
}

void __cdecl font_setstatef_0053e890(void* font, std::int32_t state, float value) {
    U fbits = 0u;
    std::memcpy(&fbits, &value, sizeof fbits);
    if (cur != nullptr && cur->call_count < kMaxCalls) {
        cur->calls[cur->call_count++] = {2u, static_cast<U>(state), fbits};
    }
    switch (state) {
    case 1:
        store32(static_cast<B*>(font) + 0xb0u, fbits);
        return;
    case 2:
        store32(static_cast<B*>(font) + 0xb4u, fbits);
        return;
    case 3:
        store32(static_cast<B*>(font) + 0xb8u, fbits);
        return;
    case 18:
        store32(static_cast<B*>(font) + 0xd0u, fbits);
        return;
    case 19:
        store32(static_cast<B*>(font) + 0xd4u, fbits);
        return;
    case 20:
        store32(static_cast<B*>(font) + 0xd8u, fbits);
        return;
    case 21:
        store32(static_cast<B*>(font) + 0xdcu, fbits);
        return;
    case 22:
        store32(static_cast<B*>(font) + 0xe0u, fbits);
        return;
    case 23:
        store32(static_cast<B*>(font) + 0xe4u, fbits);
        return;
    default:
        return;
    }
}

