    for (U i = 0u; i < 96u; ++i) {
        orig_sjis_full_buf[0x20u + i] = porsche::font_ascii_to_sjis_fullwidth_005dfcc8[i];
    }

    // Relocate 00573ac0
    store32(code_573ac0 + (0x573ad9u - 0x573ac0u), ptr_u(&orig_sjis_full_buf[0]));

    // Relocate 00573ae0
