static U invoke1(void* fn, U a0, U& abi_fail) {
    U fail = 0u, before = 0u, frame = 0u, rv = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov ebx, 0x13572468
        mov esi, 0x2468ace0
        mov edi, 0x369cf147
        push a0
        mov eax, fn
        call eax
        mov rv, eax
        add esp, 4
        cmp esp, before
        je ok_esp
        mov fail, 1
    ok_esp:
        cmp ebx, 0x13572468
        jne bad_nv
        cmp esi, 0x2468ace0
        jne bad_nv
        cmp edi, 0x369cf147
        je done_nv
    bad_nv:
        mov fail, 1
    done_nv:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail | frame;
    return rv;
}

