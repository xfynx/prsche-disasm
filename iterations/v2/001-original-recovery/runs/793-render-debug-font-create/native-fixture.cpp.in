static U ptr_u(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* p) {
    U v = 0u;
    std::memcpy(&v, p, sizeof v);
    return v;
}

static void store32(void* p, U v) {
    std::memcpy(p, &v, sizeof v);
}

static void write_rel32(B* site, U dst) {
    const U src = ptr_u(site) + 4u;
    store32(site, dst - src);
}

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", why, cases, side);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* info) {
    std::printf("divergence native-fault %08lx case=%u side=%u\n",
                info->ExceptionRecord->ExceptionCode, cases, side);
    std::fflush(stdout);
    ExitProcess(7);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void* __cdecl stub_alloc(I bytes) {
    if (cur != nullptr) {
        cur->alloc_req = static_cast<U>(bytes);
    }
    if (alloc_fail_mode != 0u) {
        return nullptr;
    }
    if (bytes <= 0 || static_cast<U>(bytes) > kArenaBytes) {
        return nullptr;
    }
    return arena_buf;
}

static void __cdecl stub_diag_handler(const char* fmt, I state) {
    if (cur != nullptr && cur->diag_count < kMaxDiags) {
        DiagRec& d = cur->diags[cur->diag_count++];
        d.fmt_match = (fmt != nullptr &&
                       std::strcmp(fmt, porsche::font_setstate_invalid_state_005bbb20) == 0)
            ? 1u
            : 0u;
        const char* file = porsche::diagnostic_file_005deb74();
        d.file_match = (file != nullptr && std::strcmp(file, kDiagFile) == 0) ? 1u : 0u;
        d.line = porsche::diagnostic_line_005deb78;
        d.state = state;
    }
}

