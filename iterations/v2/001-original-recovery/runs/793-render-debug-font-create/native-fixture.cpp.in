    }
    store32(code_53e5c0 + (0x53e5d3u - 0x53e5c0u), ptr_u(&jump_53e5c0[0]));
    store32(code_53e5c0 + (0x53e773u - 0x53e5c0u), ptr_u(&kFixedScale));
    store32(code_53e5c0 + (0x53e7a4u - 0x53e5c0u), ptr_u(&kFixedScale));
