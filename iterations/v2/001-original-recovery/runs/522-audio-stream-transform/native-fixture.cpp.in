    if(actual.abi||original.abi||std::memcmp(&actual,&original,sizeof(actual))!=0){const B* a=reinterpret_cast<const B*>(&actual);const B* b=reinterpret_cast<const B*>(&original);U n=0;while(n<sizeof(actual)&&a[n]==b[n])++n;std::printf("divergence case=%u kind=%u alias=%08x channel=%u owner=%04x member=%u wide=%u pos=%08x limit=%u count=%08x start=%u output=%u/%08x table=%u codec=%u decodeflags=%u lookupflags=%u lookupresult=%08x pc=%u rc=%u depth=%u byte=%u %02x/%02x events=%u/%u ret=%08x/%08x\n",cases,kind,alias_offset,channel_id,owner_bits,member_slot,wide_mode,position_value,limit_value,count_value,loop_start,output_mode,output_delta,table_mode,codec_mode,decode_flags,lookup_flags,lookup_result,precision,rounding,depth,n,n<sizeof(actual)?a[n]:0,n<sizeof(actual)?b[n]:0,actual.count,original.count,actual.result,original.result);std::fflush(stdout);ExitProcess(1);}
