        // 3b. 006573dc == 0, 0x1c missing from table -> stores 0 into 006573dc and registers 004b0ee0.
        cfg.class_lock = 0u;
        cfg.lock_ret = 0xaa001100u;
        cfg.handler_count = 1u;
        cfg.entries[0] = {0x00000006u, 0x0053b050u};
        cfg.fullscreen = 0u;
        cfg.hook_handle = 0xdead0002u;
        cfg.hook_enabled = 1u;
        cfg.prev_activate_handler = 0u;
