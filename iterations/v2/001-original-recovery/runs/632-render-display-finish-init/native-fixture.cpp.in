    // 2. Direct checks for 0053bf20 (window_keyboard_hook_disable_0053bf20, cdecl0).
    {
        // 2a. fullscreen == 0 with active hook -> no-op.
        CaseConfig cfg{};
        cfg.fullscreen = 0u;
        cfg.hook_handle = 0x778899aau;
        cfg.hook_enabled = 1u;
        cfg.unhook_ret = 1u;
