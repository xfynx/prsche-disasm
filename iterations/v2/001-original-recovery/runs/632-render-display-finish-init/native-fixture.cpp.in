        cfg.hook_handle = 0x778899aau;
        cfg.hook_enabled = 1u;
        cfg.unhook_ret = 1u;
        run_pair(slot_53bf20, reinterpret_cast<void*>(&porsche::window_keyboard_hook_disable_0053bf20),
                 nullptr, 0u, false, false, cfg);

        // 2d. High-bit nonzero fullscreen (0x80), UnhookWindowsHookEx returns 0 -> still clears both globals.
        cfg.fullscreen = 0x80u;
        cfg.hook_handle = 0x11223344u;
        cfg.hook_enabled = 7u;
        cfg.unhook_ret = 0u;
        run_pair(slot_53bf20, reinterpret_cast<void*>(&porsche::window_keyboard_hook_disable_0053bf20),
                 nullptr, 0u, false, false, cfg);
