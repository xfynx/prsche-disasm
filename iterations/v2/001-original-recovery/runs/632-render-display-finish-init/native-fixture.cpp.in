        //     second call sees 006573dc != 0 and skips find/register.
        cfg.class_lock = 0xbb002200u;
        cfg.handler_count = 3u;
        cfg.entries[0] = {0x00000006u, 0x0053b050u};
        cfg.entries[1] = {0x0000001cu, 0x0053b040u};
        cfg.entries[2] = {0x00000100u, 0x0053b450u};
        cfg.fullscreen = 1u;
        cfg.hook_handle = 0xdead0003u;
        cfg.hook_enabled = 1u;
        cfg.prev_activate_handler = 0u;
        cfg.register_ret = 1u;
        cfg.register_inserts_entry = true;
        run_finish_twice(cfg);
