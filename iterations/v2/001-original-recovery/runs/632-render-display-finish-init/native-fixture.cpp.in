using U = std::uint32_t;
using B = std::uint8_t;

static U address(const void* p) { return reinterpret_cast<U>(p); }
static U word(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}
static void put(void* p, U o, U v) { std::memcpy(static_cast<B*>(p) + o, &v, 4u); }

enum : U {
    kMaxEvents = 24u,
};

enum EventTag : U {
    kEvHeapLockCreate = 1u,
    kEvHeapEnter = 2u,
    kEvBinarySearch = 3u,
    kEvHeapLeave = 4u,
    kEvUnhookHook = 5u,
    kEvRegisterHandler = 6u,
};

struct StateSnapshot {
    U class_lock;
    U handler_count;
    U fullscreen;
    U hook_handle;
    U hook_enabled;
    U prev_activate_handler;
    U first_entry_msg;
    U first_entry_fn;
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U arg2;
    StateSnapshot state;
};

struct Fpu {
    unsigned short control, status;
    B tag, padding[3], values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U exception[3];
    U count;
    Event events[kMaxEvents];
    StateSnapshot final_state;
    Fpu fpu;
};

static Trace trace{};
static Trace expected{};
static U cases = 0u;
static U events_total = 0u;

