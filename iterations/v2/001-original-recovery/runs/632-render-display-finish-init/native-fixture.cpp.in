std::int32_t __cdecl window_message_compare_0053a7f0(const void* a, const void* b) {
    std::uint32_t x = 0u;
    std::uint32_t y = 0u;
    std::memcpy(&x, a, 4u);
    std::memcpy(&y, b, 4u);
    return static_cast<std::int32_t>(x - y);
}

void* __cdecl original_binary_search_005a2f23(
    const void* key,
    void* base,
    std::uint32_t count,
    std::uint32_t width,
    SearchCompare compare) {
    std::uint32_t key_msg = 0u;
    std::memcpy(&key_msg, key, 4u);
    record_event(
        kEvBinarySearch,
        key_msg,
        (base == &window_handlers_0069e0e0[0]) ? 1u : 0u,
        (count << 16) | (width & 0xffffu));
    require(compare == &window_message_compare_0053a7f0, "exact comparator 0053a7f0");
    require(width == sizeof(WindowHandlerEntry), "exact 8-byte width");

    auto low = static_cast<std::uint32_t>(reinterpret_cast<std::uintptr_t>(base));
    auto high = low + (count - 1u) * width;
    while (low <= high) {
        const auto half = count >> 1u;
        if (half == 0u) {
            if (count == 0u) {
                return nullptr;
            }
            return compare(key, reinterpret_cast<void*>(low)) != 0
                ? nullptr
                : reinterpret_cast<void*>(low);
        }
        const auto middle = low + ((count & 1u) != 0u ? half : half - 1u) * width;
        const auto cmp = compare(key, reinterpret_cast<void*>(middle));
        if (cmp == 0) {
            return reinterpret_cast<void*>(middle);
        }
        if (cmp < 0) {
            high = middle - width;
            count = (count & 1u) != 0u ? half : half - 1u;
        } else {
            low = middle + width;
            count = half;
        }
    }
    return nullptr;
}

std::int32_t __stdcall window_keys_unhook_windows_hook(void* hook) {
    record_event(kEvUnhookHook, address(hook), cfg_unhook_ret, 0u);
    return static_cast<std::int32_t>(cfg_unhook_ret);
}

std::uint32_t __stdcall window_handler_register_0053a800(std::uint32_t message, std::uint32_t handler_value) {
    record_event(kEvRegisterHandler, message, handler_value, 0u);
    if (cfg_register_inserts_entry) {
        const WindowHandler handler = reinterpret_cast<WindowHandler>(
            static_cast<std::uintptr_t>(handler_value));
        bool found = false;
        for (U i = 0u; i < window_handler_count_0069e570; ++i) {
            if (window_handlers_0069e0e0[i].message == message) {
                window_handlers_0069e0e0[i].handler = handler;
                found = true;
                break;
            }
        }
        if (!found && window_handler_count_0069e570 < 128u) {
            window_handlers_0069e0e0[window_handler_count_0069e570].message = message;
            window_handlers_0069e0e0[window_handler_count_0069e570].handler = handler;
            ++window_handler_count_0069e570;
        }
    }
    return cfg_register_ret;
}

std::uint32_t __stdcall render_display_activate_callback_004b0ee0(
    void*,
    void*,
    std::uint32_t,
    std::uint32_t,
    std::int32_t,
    std::int32_t*) {
    volatile U tag = 0x4b0ee0u;
    return tag;
}

