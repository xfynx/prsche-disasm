static U invoke_call(void* fn, const U* args, U argc, bool is_stdcall, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    const U cleanup = is_stdcall ? 0u : (argc * 4u);
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, argc
        mov edx, args
    push_loop:
        test eax, eax
        jz pushed
        dec eax
        push dword ptr [edx + eax * 4]
        jmp push_loop
    pushed:
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov eax_out, eax
        add esp, cleanup
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static int exception_record(EXCEPTION_POINTERS* e) {
    trace.exception[0] = e->ExceptionRecord->ExceptionCode;
    trace.exception[1] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[0]);
    trace.exception[2] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[1]);
    return EXCEPTION_EXECUTE_HANDLER;
}

static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}

static void relocate_rel32(B* slot, U slot_va, U off, U expected_target_va, const void* target) {
    require(off >= 1u && slot[off - 1u] == 0xe8u, "exact relative call opcode");
    const U actual_target = slot_va + off + 4u + word(slot, off);
    require(actual_target == expected_target_va, "exact relative relocation target");
    const U next_ip = address(slot + off + 4u);
    put(slot, off, address(target) - next_ip);
}

static void init() {
    // Assert production initial state before fixture resets.
    require(porsche::class_lock_0069e59c == nullptr, "initial 0069e59c");
    require(porsche::window_handler_count_0069e570 == 0u, "initial 0069e570");
    require(porsche::window_fullscreen_006b7c01 == 0u, "initial 006b7c01");
    require(porsche::window_keyboard_hook_handle_0069e584 == nullptr, "initial 0069e584");
    require(porsche::window_keyboard_hook_enabled_0069e588 == 0u, "initial 0069e588");
    require(word(porsche::frame_pump_storage_bytes_006573b8() + 0x24u) == 0u, "initial 006573dc");

    iat_unhook_windows_hook_ex = reinterpret_cast<const void*>(&porsche::window_keys_unhook_windows_hook);

    static const B body_53a780[] = {@BODY_0053A780@};
    static const B body_53bf20[] = {@BODY_0053BF20@};
    static const B body_4b0eb0[] = {@BODY_004B0EB0@};
    require(sizeof body_53a780 == 101u, "101-byte original body 0053a780");
    require(sizeof body_53bf20 == 46u, "46-byte original body 0053bf20");
    require(sizeof body_4b0eb0 == 39u, "39-byte original body 004b0eb0");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                        PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "raw executable allocation");
    slot_53a780 = code + 0x000u;
    slot_53bf20 = code + 0x080u;
    slot_4b0eb0 = code + 0x0c0u;

    std::memcpy(slot_53a780, body_53a780, sizeof body_53a780);
    std::memcpy(slot_53bf20, body_53bf20, sizeof body_53bf20);
    std::memcpy(slot_4b0eb0, body_4b0eb0, sizeof body_4b0eb0);

    // Relocate 0053a780 (10 relocations).
    relocate_abs32(slot_53a780, 0x001u, 0x0069e59cu, address(&porsche::class_lock_0069e59c));
    relocate_rel32(slot_53a780, 0x0053a780u, 0x010u, 0x005321f0u,
                   reinterpret_cast<const void*>(&porsche::heap_lock_create_005321f0));
    relocate_abs32(slot_53a780, 0x015u, 0x0069e59cu, address(&porsche::class_lock_0069e59c));
    relocate_rel32(slot_53a780, 0x0053a780u, 0x01bu, 0x005322b0u,
                   reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    relocate_abs32(slot_53a780, 0x021u, 0x0069e570u, address(&porsche::window_handler_count_0069e570));
    relocate_abs32(slot_53a780, 0x02au, 0x0053a7f0u, address(reinterpret_cast<const void*>(&porsche::window_message_compare_0053a7f0)));
    relocate_abs32(slot_53a780, 0x036u, 0x0069e0e0u, address(&porsche::window_handlers_0069e0e0[0]));
    relocate_rel32(slot_53a780, 0x0053a780u, 0x040u, 0x005a2f23u,
                   reinterpret_cast<const void*>(&porsche::original_binary_search_005a2f23));
    relocate_abs32(slot_53a780, 0x04fu, 0x0069e59cu, address(&porsche::class_lock_0069e59c));
    relocate_rel32(slot_53a780, 0x0053a780u, 0x055u, 0x005322c0u,
                   reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));

    // Relocate 0053bf20 (5 relocations).
    relocate_abs32(slot_53bf20, 0x001u, 0x006b7c01u, address(&porsche::window_fullscreen_006b7c01));
    relocate_abs32(slot_53bf20, 0x00au, 0x0069e584u, address(&porsche::window_keyboard_hook_handle_0069e584));
    relocate_abs32(slot_53bf20, 0x015u, 0x005b2304u, address(&iat_unhook_windows_hook_ex));
    relocate_abs32(slot_53bf20, 0x01bu, 0x0069e584u, address(&porsche::window_keyboard_hook_handle_0069e584));
    relocate_abs32(slot_53bf20, 0x025u, 0x0069e588u, address(&porsche::window_keyboard_hook_enabled_0069e588));

    // Relocate 004b0eb0 (6 relocations).
    const U slot_6573dc = address(porsche::frame_pump_storage_bytes_006573b8() + 0x24u);
    relocate_rel32(slot_4b0eb0, 0x004b0eb0u, 0x001u, 0x0053bf20u, slot_53bf20);
    relocate_abs32(slot_4b0eb0, 0x006u, 0x006573dcu, slot_6573dc);
    relocate_rel32(slot_4b0eb0, 0x004b0eb0u, 0x011u, 0x0053a780u, slot_53a780);
    relocate_abs32(slot_4b0eb0, 0x016u, 0x004b0ee0u,
                   address(reinterpret_cast<const void*>(&porsche::render_display_activate_callback_004b0ee0)));
    relocate_abs32(slot_4b0eb0, 0x01du, 0x006573dcu, slot_6573dc);
    relocate_rel32(slot_4b0eb0, 0x004b0eb0u, 0x022u, 0x0053a800u,
                   reinterpret_cast<const void*>(&porsche::window_handler_register_0053a800));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "instruction cache");
}

struct HandlerSeed {
    U message;
    U handler_addr;
};

struct CaseConfig {
    U class_lock;
    U lock_ret;
    U enter_mutate_lock;
    U handler_count;
    HandlerSeed entries[8];
    B fullscreen;
    U hook_handle;
    U hook_enabled;
    U unhook_ret;
    U prev_activate_handler;
    U register_ret;
    bool register_inserts_entry;
};

static void apply_config(const CaseConfig& cfg) {
    porsche::class_lock_0069e59c = reinterpret_cast<void*>(static_cast<std::uintptr_t>(cfg.class_lock));
    porsche::window_handler_count_0069e570 = cfg.handler_count;
    for (U i = 0u; i < 128u; ++i) {
        porsche::window_handlers_0069e0e0[i].message = 0u;
        porsche::window_handlers_0069e0e0[i].handler = nullptr;
    }
    for (U i = 0u; i < cfg.handler_count && i < 8u; ++i) {
        porsche::window_handlers_0069e0e0[i].message = cfg.entries[i].message;
        porsche::window_handlers_0069e0e0[i].handler = reinterpret_cast<porsche::WindowHandler>(
            static_cast<std::uintptr_t>(cfg.entries[i].handler_addr));
    }

    porsche::window_fullscreen_006b7c01 = cfg.fullscreen;
    porsche::window_keyboard_hook_handle_0069e584 = reinterpret_cast<void*>(
        static_cast<std::uintptr_t>(cfg.hook_handle));
    porsche::window_keyboard_hook_enabled_0069e588 = cfg.hook_enabled;

    std::memset(test_frame_pump_storage.data(), 0, sizeof(test_frame_pump_storage));
    put(porsche::frame_pump_storage_bytes_006573b8() + 0x24u, 0u, cfg.prev_activate_handler);

    cfg_lock_ret = cfg.lock_ret;
    cfg_enter_mutate_lock = cfg.enter_mutate_lock;
    cfg_unhook_ret = cfg.unhook_ret;
    cfg_register_ret = cfg.register_ret;
    cfg_register_inserts_entry = cfg.register_inserts_entry;
}

static void compare_traces(bool check_return) {
    require(trace.abi_fail == 0u, "original ABI");
    require(expected.abi_fail == 0u, "cpp ABI");
    require(trace.exception[0] == 0u && expected.exception[0] == 0u, "no exceptions");
    if (!check_return) {
        trace.ret_eax = 0u;
        expected.ret_eax = 0u;
    }
    require(trace.ret_eax == expected.ret_eax, "return value mismatch");
    require(trace.count == expected.count, "event count mismatch");
    for (U i = 0u; i < trace.count; ++i) {
        require(std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) == 0,
                "event mismatch");
    }
    require(std::memcmp(&trace.final_state, &expected.final_state, sizeof(StateSnapshot)) == 0,
            "final state mismatch");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof(Fpu)) == 0,
            "x87/MXCSR state mismatch");
}

static void run_pair(
    void* orig_fn,
    void* cpp_fn,
    const U* args,
    U argc,
    bool is_stdcall,
    bool check_return,
    const CaseConfig& cfg) {
    ++cases;

    std::memset(&trace, 0, sizeof trace);
    apply_config(cfg);
    seed_fpu();
    __try {
        trace.abi_fail = invoke_call(orig_fn, args, argc, is_stdcall, trace.ret_eax);
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_state(trace.final_state);
    capture_fpu(trace.fpu);
    expected = trace;

    std::memset(&trace, 0, sizeof trace);
    apply_config(cfg);
    seed_fpu();
    __try {
        trace.abi_fail = invoke_call(cpp_fn, args, argc, is_stdcall, trace.ret_eax);
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_state(trace.final_state);
    capture_fpu(trace.fpu);
    events_total += trace.count;
    compare_traces(check_return);
}

static void run_finish_twice(const CaseConfig& cfg) {
    ++cases;

    std::memset(&trace, 0, sizeof trace);
    apply_config(cfg);
    seed_fpu();
    __try {
        trace.abi_fail = invoke_call(slot_4b0eb0, nullptr, 0u, false, trace.ret_eax);
        if (trace.abi_fail == 0u && trace.exception[0] == 0u) {
            trace.abi_fail = invoke_call(slot_4b0eb0, nullptr, 0u, false, trace.ret_eax);
        }
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_state(trace.final_state);
    capture_fpu(trace.fpu);
    expected = trace;

    std::memset(&trace, 0, sizeof trace);
    apply_config(cfg);
    seed_fpu();
    __try {
        trace.abi_fail = invoke_call(
            reinterpret_cast<void*>(&porsche::render_display_finish_init_004b0eb0),
            nullptr, 0u, false, trace.ret_eax);
        if (trace.abi_fail == 0u && trace.exception[0] == 0u) {
            trace.abi_fail = invoke_call(
                reinterpret_cast<void*>(&porsche::render_display_finish_init_004b0eb0),
                nullptr, 0u, false, trace.ret_eax);
        }
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_state(trace.final_state);
    capture_fpu(trace.fpu);
    events_total += trace.count;
    compare_traces(false);
}

int main() {
    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
    init();

    // 1. Direct checks for 0053a780 (window_handler_find_0053a780, stdcall1).
    {
        // 1a. Null lock -> creates lock, empty table -> returns 0.
        const U msg = 0x1cu;
        CaseConfig cfg{};
        cfg.class_lock = 0u;
        cfg.lock_ret = 0x12340000u;
        cfg.handler_count = 0u;
        run_pair(slot_53a780, reinterpret_cast<void*>(&porsche::window_handler_find_0053a780),
                 &msg, 1u, true, true, cfg);
    }

    {
        // 1b. Non-null lock, 1-entry hit and miss, plus callback lock mutation.
        CaseConfig cfg{};
        cfg.class_lock = 0x22220000u;
        cfg.lock_ret = 0x99990000u;
        cfg.handler_count = 1u;
        cfg.entries[0] = {0x1cu, 0x0053b040u};

        const U hit_msg = 0x1cu;
        run_pair(slot_53a780, reinterpret_cast<void*>(&porsche::window_handler_find_0053a780),
                 &hit_msg, 1u, true, true, cfg);

        const U miss_msg = 0x1du;
        cfg.enter_mutate_lock = 0x33330000u;
        run_pair(slot_53a780, reinterpret_cast<void*>(&porsche::window_handler_find_0053a780),
                 &miss_msg, 1u, true, true, cfg);
    }

    {
        // 1c. Multi-entry sorted table: first, middle, last, null-handler entry, miss, wraparound key.
        CaseConfig cfg{};
        cfg.class_lock = 0x55550000u;
        cfg.handler_count = 5u;
        cfg.entries[0] = {0x00000006u, 0x0053b050u};
        cfg.entries[1] = {0x0000001cu, 0x0053b040u};
        cfg.entries[2] = {0x00000100u, 0x00000000u};
