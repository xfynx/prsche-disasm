}

void* __cdecl heap_lock_create_005321f0() {
    record_event(kEvHeapLockCreate, cfg_lock_ret, 0u, 0u);
    return reinterpret_cast<void*>(static_cast<std::uintptr_t>(cfg_lock_ret));
}

void __cdecl heap_enter_005322b0(void* lock) {
    record_event(kEvHeapEnter, address(lock), 0u, 0u);
    if (cfg_enter_mutate_lock != 0u) {
        class_lock_0069e59c = reinterpret_cast<void*>(static_cast<std::uintptr_t>(cfg_enter_mutate_lock));
    }
}

void __cdecl heap_leave_005322c0(void* lock) {
    record_event(kEvHeapLeave, address(lock), 0u, 0u);
