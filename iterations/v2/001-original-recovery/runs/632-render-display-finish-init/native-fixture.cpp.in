    // 3. Direct checks for 004b0eb0 (render_display_finish_init_004b0eb0, cdecl0).
    {
        // 3a. 006573dc != 0 -> still runs 0053bf20, skips find and register.
        CaseConfig cfg{};
        cfg.fullscreen = 1u;
        cfg.hook_handle = 0xdead0001u;
        cfg.hook_enabled = 1u;
        cfg.unhook_ret = 1u;
        cfg.prev_activate_handler = 0x0053b040u;
