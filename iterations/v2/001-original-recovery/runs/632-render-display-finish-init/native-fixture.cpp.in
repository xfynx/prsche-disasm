static B* slot_53a780 = nullptr;
static B* slot_53bf20 = nullptr;
static B* slot_4b0eb0 = nullptr;
static const void* iat_unhook_windows_hook_ex = nullptr;

static B test_fullscreen_byte = 0u;
alignas(4) static std::array<std::uint32_t, 12> test_frame_pump_storage{};

static U cfg_lock_ret = 0x44440000u;
static U cfg_enter_mutate_lock = 0u;
static U cfg_unhook_ret = 1u;
static U cfg_register_ret = 1u;
static bool cfg_register_inserts_entry = false;

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static void capture_state(StateSnapshot& s) {
    s.class_lock = address(porsche::class_lock_0069e59c);
    s.handler_count = porsche::window_handler_count_0069e570;
    s.fullscreen = static_cast<U>(porsche::window_fullscreen_006b7c01);
    s.hook_handle = address(porsche::window_keyboard_hook_handle_0069e584);
    s.hook_enabled = porsche::window_keyboard_hook_enabled_0069e588;
    s.prev_activate_handler = word(porsche::frame_pump_storage_bytes_006573b8() + 0x24u);
    s.first_entry_msg = porsche::window_handler_count_0069e570 > 0u
        ? porsche::window_handlers_0069e0e0[0].message
        : 0u;
    s.first_entry_fn = porsche::window_handler_count_0069e570 > 0u
        ? address(reinterpret_cast<const void*>(porsche::window_handlers_0069e0e0[0].handler))
        : 0u;
}

static void capture_fpu(Fpu& f) {
    std::memset(&f, 0, sizeof f);
    B env[28];
    __asm {
        fxsave floating
        fnstenv env
        fldenv env
    }
    f.control = *reinterpret_cast<unsigned short*>(floating);
    f.status = *reinterpret_cast<unsigned short*>(floating + 2);
    f.tag = floating[4];
    std::memset(f.padding, 0, 3);
    f.full_tag = *reinterpret_cast<unsigned short*>(env + 8);
    f.mxcsr = *reinterpret_cast<U*>(floating + 24);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((f.status >> 11) + i) & 7u;
        if (f.tag & (1u << physical)) {
            std::memcpy(f.values + i * 10u, floating + 32u + i * 16u, 10u);
        } else {
            std::memset(f.values + i * 10u, 0, 10u);
        }
    }
}

static void seed_fpu() {
    unsigned short cw = 0x027fu;
    U mxcsr = 0x9f80u;
    __asm {
        fninit
        fldcw cw
        ldmxcsr mxcsr
        fld1
    }
}

static void record_event(U tag, U arg0 = 0u, U arg1 = 0u, U arg2 = 0u) {
    require(trace.count < kMaxEvents, "bounded event count");
    Event& e = trace.events[trace.count++];
    e.tag = tag;
    e.arg0 = arg0;
    e.arg1 = arg1;
    e.arg2 = arg2;
    capture_state(e.state);
}

namespace porsche {

void* class_lock_0069e59c = nullptr;
