static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_quality_mask = 0u;
    g_find_mode = 0u;
    g_shared_ref = 7u + seed;
    g_iter_ptr = nullptr;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_self_obj, 0, sizeof g_self_obj);
    std::memset(g_tree_hdr, 0, sizeof g_tree_hdr);
    std::memset(g_sentinel, 0, sizeof g_sentinel);
    std::memset(g_tree_nodes, 0, sizeof g_tree_nodes);
    std::memset(g_rec_buf, static_cast<int>(0x20u + seed), sizeof g_rec_buf);
    std::memset(g_entry_buf, 0x11u, sizeof g_entry_buf);
    for (U i = 0u; i < 0x54u; ++i) {
        g_src_node_a[i] = static_cast<B>((0x30u + seed + i) & 0xffu);
        g_src_node_b[i] = static_cast<B>((0x80u + seed + i) & 0xffu);
        g_dst_node[i] = static_cast<B>((0x60u + seed + i) & 0xffu);
    }
    store_ptr(g_src_node_a, 0x20u, &g_shared_ref);
    store_ptr(g_src_node_b, 0x20u, &g_shared_ref);
    for (U i = 0u; i < 28u; ++i) {
        g_state_28[i] = static_cast<B>((0x10u + i * 3u) & 0xffu);
    }

    store_ptr(g_self_obj, 0x00u, g_entry_buf); // driver
    store32(g_self_obj, 0x04u, 2u);           // mode
    store_ptr(g_self_obj, 0x08u, g_tree_hdr);
    store_ptr(g_tree_hdr, 0x00u, g_sentinel);

    // Sentinel links: parent=node0, left=node0, right=node1
    store_ptr(g_sentinel, 0x04u, g_tree_nodes[0]);
    store_ptr(g_sentinel, 0x08u, g_tree_nodes[0]);
    store_ptr(g_sentinel, 0x0cu, g_tree_nodes[1]);

    DWORD oldp = 0u;
    (void)VirtualProtect(g_vm_pages, 8192u, PAGE_READWRITE, &oldp);
}

static U query_protect(const void* addr) {
    MEMORY_BASIC_INFORMATION mbi{};
    (void)VirtualQuery(addr, &mbi, sizeof mbi);
    return mbi.Protect;
}

static void capture(Snapshot& out, U abi_fail, U ret_eax) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    std::memcpy(out.dst_node.data(), g_dst_node, sizeof g_dst_node);
    std::memcpy(out.rec_buf.data(), g_rec_buf, sizeof g_rec_buf);
    out.shared_ref = g_shared_ref;
    out.iter_ptr_addr = address(g_iter_ptr);
    out.page0_protect = query_protect(g_vm_pages);
    out.page1_protect = query_protect(g_vm_pages + 4096u);
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c &&
                    orig.events[i].d == cpp.events[i].d,
                tag);
    }
    require(orig.dst_node == cpp.dst_node, tag);
    require(orig.rec_buf == cpp.rec_buf, tag);
    require(orig.shared_ref == cpp.shared_ref, tag);
    require(orig.iter_ptr_addr == cpp.iter_ptr_addr, tag);
    require(orig.page0_protect == cpp.page0_protect, tag);
    require(orig.page1_protect == cpp.page1_protect, tag);
    ++cases;
}

static void wire_tree_for_register(U mode) {
    // node0 -> parent=sentinel, left=null, right=node1
    // node1 -> parent=node0, left=null, right=null
    store_ptr(g_tree_nodes[0], 0x04u, g_sentinel);
    store_ptr(g_tree_nodes[0], 0x08u, nullptr);
    store_ptr(g_tree_nodes[0], 0x0cu, g_tree_nodes[1]);
    store32(g_tree_nodes[0], 0x10u, 0u);
    store32(g_tree_nodes[0], 0x14u, 0x534b5920u);
    store_ptr(g_tree_nodes[0], 0x18u, g_src_node_a);

    store_ptr(g_tree_nodes[1], 0x04u, g_tree_nodes[0]);
    store_ptr(g_tree_nodes[1], 0x08u, nullptr);
    store_ptr(g_tree_nodes[1], 0x0cu, nullptr);
    store32(g_tree_nodes[1], 0x10u, 0u);
    store32(g_tree_nodes[1], 0x14u, (mode == 3u) ? 0x534b5921u : 0x534b5920u);
    store_ptr(g_tree_nodes[1], 0x18u, g_src_node_b);

    // node0 state does NOT match g_state_28 when mode != 1;
    // in mode 3 it matches first 24 bytes and differs only in bytes 24..27 (proves 0x1cu compare)
    if (mode == 1u) {
        std::memcpy(g_src_node_a + 0x38u, g_state_28, 28u);
    } else if (mode == 3u) {
        std::memcpy(g_src_node_a + 0x38u, g_state_28, 24u);
    }
    if (mode == 2u) {
        std::memcpy(g_src_node_b + 0x38u, g_state_28, 28u);
    }
}

int main() {
    init();

    // 1. 005af040 page protect tests (0 pages, 1 page RO->RW, 2 pages RO->RW)
    for (U bytes : {100u, 4096u, 5000u, 8192u}) {
        for (U ro : {1u, 0u}) {
            Snapshot orig{}, cpp{};
            reset_fixtures(1u);
            if (ro == 0u) {
                DWORD oldp = 0u;
                (void)VirtualProtect(g_vm_pages, 8192u, PAGE_READONLY, &oldp);
            }
            U f0 = invoke_cdecl_3_void(slot_005af040, address(g_vm_pages), bytes, ro);
            capture(orig, f0, 0u);
            reset_fixtures(1u);
            if (ro == 0u) {
                DWORD oldp = 0u;
                (void)VirtualProtect(g_vm_pages, 8192u, PAGE_READONLY, &oldp);
            }
            U f1 = invoke_cdecl_3_void(
                reinterpret_cast<const void*>(&porsche::application_page_protect_005af040),
                address(g_vm_pages), bytes, ro);
            capture(cpp, f1, 0u);
            check_equal(orig, cpp, "005af040");
        }
    }

    // 2. 0044d520 direct record init tests
    for (U owned : {0u, 1u}) {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(2u);
        U f0 = invoke_thiscall_4(slot_0044d520, g_rec_buf, 0x12u, 0x534b5920u,
                                 address(g_dst_node), owned, r0);
        capture(orig, f0, r0);
        reset_fixtures(2u);
        U f1 = invoke_thiscall_4(
            reinterpret_cast<const void*>(&porsche::scene_stage_entry_record_init_0044d520),
            g_rec_buf, 0x12u, 0x534b5920u, address(g_dst_node), owned, r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "0044d520");
    }

    // 3. 0044d550 direct state apply tests (null, non-null with bit 0x040000 clear/set)
    for (U state_arg : {0u, address(g_state_28)}) {
        for (U mask : {0u, 0x00040000u}) {
            Snapshot orig{}, cpp{};
            reset_fixtures(3u);
            g_quality_mask = mask;
            U f0 = invoke_thiscall_2_void(slot_0044d550, g_self_obj, address(g_dst_node), state_arg);
            capture(orig, f0, 0u);
            reset_fixtures(3u);
            g_quality_mask = mask;
            U f1 = invoke_thiscall_2_void(
                reinterpret_cast<const void*>(&porsche::scene_stage_entry_apply_state_0044d550),
                g_self_obj, address(g_dst_node), state_arg);
            capture(cpp, f1, 0u);
            check_equal(orig, cpp, "0044d550");
        }
    }

    // 4. 00536120 direct clone tests
    {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(4u);
        U f0 = invoke_thiscall_1(slot_00536120, g_dst_node, address(g_src_node_a), r0);
        capture(orig, f0, r0);
        reset_fixtures(4u);
        U f1 = invoke_thiscall_1(
            reinterpret_cast<const void*>(&porsche::scene_resource_node_clone_00536120),
            g_dst_node, address(g_src_node_a), r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "00536120");
    }

    // 5. 005365a0 direct set_name tests (empty, short, 18, 19, >19)
    for (const char* nm : {"", "AB", "SKY :CLONE", "123456789012345678", "1234567890123456789", "12345678901234567890XYZ"}) {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(5u);
        U f0 = invoke_thiscall_1(slot_005365a0, g_dst_node, address(nm), r0);
        capture(orig, f0, 0u);
        reset_fixtures(5u);
        U f1 = invoke_thiscall_1(
            reinterpret_cast<const void*>(&porsche::scene_resource_node_set_name_005365a0),
            g_dst_node, address(nm), r1);
        capture(cpp, f1, 0u);
        check_equal(orig, cpp, "005365a0");
    }

    // 6. 00423840 direct tree advance tests (right child w/ left subtree, climb parent chain, rightmost->sentinel)
    for (U start_idx : {0u, 1u, 2u, 3u}) {
        auto setup_tree = [=]() {
            // node0=root(k0), node1=left(node0), node2=right(node0)->left=node3
            store_ptr(g_tree_nodes[0], 0x04u, g_sentinel);
            store_ptr(g_tree_nodes[0], 0x08u, g_tree_nodes[1]);
            store_ptr(g_tree_nodes[0], 0x0cu, g_tree_nodes[2]);
            store_ptr(g_tree_nodes[1], 0x04u, g_tree_nodes[0]);
            store_ptr(g_tree_nodes[1], 0x08u, nullptr);
            store_ptr(g_tree_nodes[1], 0x0cu, nullptr);
            store_ptr(g_tree_nodes[2], 0x04u, g_tree_nodes[0]);
            store_ptr(g_tree_nodes[2], 0x08u, g_tree_nodes[3]);
            store_ptr(g_tree_nodes[2], 0x0cu, nullptr);
            store_ptr(g_tree_nodes[3], 0x04u, g_tree_nodes[2]);
            store_ptr(g_tree_nodes[3], 0x08u, nullptr);
            store_ptr(g_tree_nodes[3], 0x0cu, nullptr);
            store_ptr(g_sentinel, 0x04u, g_tree_nodes[0]);
            store_ptr(g_sentinel, 0x08u, g_tree_nodes[1]);
            store_ptr(g_sentinel, 0x0cu, g_tree_nodes[2]);
            g_iter_ptr = g_tree_nodes[start_idx];
        };
        Snapshot orig{}, cpp{};
        reset_fixtures(6u);
        setup_tree();
        U f0 = invoke_thiscall_0_void(slot_00423840, &g_iter_ptr);
        capture(orig, f0, 0u);
        reset_fixtures(6u);
        setup_tree();
        U f1 = invoke_thiscall_0_void(
            reinterpret_cast<const void*>(&porsche::scene_tree_node_advance_00423840),
            &g_iter_ptr);
        capture(cpp, f1, 0u);
        check_equal(orig, cpp, "00423840");
    }
    // 2-node tree (root node0, left node1): advancing from rightmost node0 hits sentinel->right == node0
    {
        auto setup_2node = []() {
            store_ptr(g_tree_nodes[0], 0x04u, g_sentinel);
            store_ptr(g_tree_nodes[0], 0x08u, g_tree_nodes[1]);
            store_ptr(g_tree_nodes[0], 0x0cu, nullptr);
            store_ptr(g_tree_nodes[1], 0x04u, g_tree_nodes[0]);
            store_ptr(g_tree_nodes[1], 0x08u, nullptr);
            store_ptr(g_tree_nodes[1], 0x0cu, nullptr);
            store_ptr(g_sentinel, 0x04u, g_tree_nodes[0]);
            store_ptr(g_sentinel, 0x08u, g_tree_nodes[1]);
            store_ptr(g_sentinel, 0x0cu, g_tree_nodes[0]);
            g_iter_ptr = g_tree_nodes[0];
        };
        Snapshot orig{}, cpp{};
        reset_fixtures(6u);
        setup_2node();
        U f0 = invoke_thiscall_0_void(slot_00423840, &g_iter_ptr);
        capture(orig, f0, 0u);
        reset_fixtures(6u);
        setup_2node();
        U f1 = invoke_thiscall_0_void(
            reinterpret_cast<const void*>(&porsche::scene_tree_node_advance_00423840),
            &g_iter_ptr);
        capture(cpp, f1, 0u);
        check_equal(orig, cpp, "00423840-end");
    }

    // 7. 0044d380 full register tests:
    //    miss + one_b=0 (prepare called), miss + one_b=1 (prepare skipped),
    //    hit node0, hit node1 after advance, miss after advance -> clone
    for (U mode : {0u, 1u, 2u, 3u}) {
        for (U one_b : {0u, 1u}) {
            if (mode != 0u && one_b == 0u) {
                continue;
            }
            for (U state_arg : {0u, address(g_state_28)}) {
                if (mode != 0u && state_arg == 0u) {
                    continue;
                }
                Snapshot orig{}, cpp{};
                U r0 = 0u, r1 = 0u;
                auto setup_reg = [=]() {
                    g_find_mode = mode;
                    g_quality_mask = 0x00040000u;
                    if (mode != 0u) {
                        wire_tree_for_register(mode);
                    }
                };
                reset_fixtures(7u);
                setup_reg();
                U f0 = invoke_thiscall_7(
                    slot_0044d380, g_self_obj, address(g_entry_buf), 0u,
                    0x534b5920u, state_arg, 1u, one_b, 0x22u, r0);
                capture(orig, f0, r0);
                reset_fixtures(7u);
                setup_reg();
                U f1 = invoke_thiscall_7(
                    reinterpret_cast<const void*>(&porsche::scene_stage_entry_register_0044d380),
                    g_self_obj, address(g_entry_buf), 0u,
                    0x534b5920u, state_arg, 1u, one_b, 0x22u, r1);
                capture(cpp, f1, r1);
                check_equal(orig, cpp, "0044d380");
            }
        }
    }

    std::printf("scene_stage_entry_register_814_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
