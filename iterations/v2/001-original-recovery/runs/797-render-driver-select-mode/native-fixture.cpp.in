static void reset_state(U ctx_flags, U state2_en, U tex_off) {
    std::memset(ctx_buf, 0, sizeof ctx_buf);
    store32(ctx_buf + 0x117e4u, ctx_flags);
    porsche::render_driver_context_0069e0d4 = ctx_buf;

    std::memset(porsche::render_thrash_exports_006bd910, 0,
                sizeof porsche::render_thrash_exports_006bd910);
    porsche::render_thrash_exports_006bd910[2] = ptr_u(&stub_thrash_alias_state);
    porsche::render_thrash_exports_006bd910[9] =
        ptr_u(&porsche::render_settings_current_device_006bd934);
    porsche::render_thrash_exports_006bd910[18] = ptr_u(&stub_select_mode);
    porsche::render_thrash_exports_006bd910[27] = ptr_u(&stub_thrash_set_state);

    for (U i = 0u; i < 6u; ++i) {
        porsche::render_driver_state_pairs_005ded30[i * 2u] = 100u + i;
        porsche::render_driver_state_pairs_005ded30[i * 2u + 1u] = 200u + i;
        porsche::render_driver_state_callbacks_005ded60[i] = (i & 1u) ? &stub_cb1 : &stub_cb0;
    }

    for (U i = 0u; i < 8u; ++i) {
        self_buf[i] = 0x11110000u + i;
    }
    self_buf[1] = ptr_u(&cfg_buf[0]);
    for (U i = 0u; i < 16u; ++i) {
        cfg_buf[i] = 0x33330000u + i;
    }

    store32(&porsche::cursor_snapshot_prefix_005de650[0], 0u);
    store32(&porsche::cursor_snapshot_prefix_005de650[4], 1024u);
    store32(&porsche::cursor_snapshot_prefix_005de650[8], 768u);
    porsche::window_shutdown_source_005de65d = 32u;

    porsche::render_driver_state2_enabled_005ded4c = state2_en;
    porsche::render_driver_tex_offset_005dedf4 = tex_off;
    porsche::render_video_mode_005deaa8 = 0xaaaa0001u;
    porsche::render_display_texture_width_005deac8 = 0xaaaa0002u;
    porsche::render_display_texture_height_005deacc = 0xaaaa0003u;
    porsche::splash_progress_format_005dead0 = 0xaaaa0004u;
    porsche::render_video_state_005dead8 = 0xaaaa0005u;
}

static void capture(Snapshot& dst, U abi_fail, U ret8) {
    dst.abi_fail = abi_fail;
    dst.ret8 = ret8;
    dst.state2_en = porsche::render_driver_state2_enabled_005ded4c;
    dst.tex_off = porsche::render_driver_tex_offset_005dedf4;
    for (U i = 0u; i < 8u; ++i) {
        dst.self_words[i] = (i == 1u)
            ? (self_buf[1] == ptr_u(&cfg_buf[0]) ? 1u : 0u)
            : (i == 4u && self_buf[4] == ptr_u(&dev_buf[0]) ? 0xdeadbeefu : self_buf[i]);
    }
    std::memcpy(dst.cfg_words, cfg_buf, sizeof cfg_buf);
    dst.ctx_flag = load32(ctx_buf + 0x117e4u);
    dst.ctx_f32_bits = load32(ctx_buf + 0x1180cu);
    dst.vid_mode = porsche::render_video_mode_005deaa8;
    dst.tex_w = porsche::render_display_texture_width_005deac8;
    dst.tex_h = porsche::render_display_texture_height_005deacc;
    dst.splash_fmt = porsche::splash_progress_format_005dead0;
    dst.vid_state = porsche::render_video_state_005dead8;
}

static void check_snapshots(const char* label) {
    require(expected.abi_fail == 0u && actual.abi_fail == 0u, label);
    require(std::memcmp(&expected, &actual, sizeof(Snapshot)) == 0, label);
    ++cases;
}

static void test_5404a0() {
    const U flags[] = {0u, 0x20000u, 0xffffffffu};
    const U vals[] = {0u, 1u, 0x4000u, 0x8000u, 0xffff8000u, 0x7fffffffu, 0x80000001u};
    for (U f : flags) {
        for (U v : vals) {
            for (U s = 0u; s < 2u; ++s) {
                side = s;
                Snapshot& dst = (s == 0u) ? expected : actual;
                std::memset(&dst, 0, sizeof dst);
                cur = &dst;
                reset_state(f, 0u, 2u);
                U abi = 0u;
                (void)invoke_cdecl2(
                    s == 0u ? static_cast<void*>(code_5404a0)
                            : reinterpret_cast<void*>(&porsche::render_driver_set_tex_state_005404a0),
                    0x18u, v, abi);
                capture(dst, abi, 0u);
            }
            check_snapshots("5404a0");
        }
    }
}

static void test_setters() {
    void* const origs[10] = {
        code_537830, code_537890, code_5378c0, code_5378e0, code_537900,
        code_537920, code_537940, code_537960, code_537980, code_5379a0,
    };
    void* const cpps[10] = {
        reinterpret_cast<void*>(&porsche::render_driver_set_state28_00537830),
        reinterpret_cast<void*>(&porsche::render_driver_set_state2_00537890),
        reinterpret_cast<void*>(&porsche::render_driver_set_state3c_005378c0),
        reinterpret_cast<void*>(&porsche::render_driver_set_state9_005378e0),
        reinterpret_cast<void*>(&porsche::render_driver_set_state15_00537900),
        reinterpret_cast<void*>(&porsche::render_driver_set_alias_e_00537920),
        reinterpret_cast<void*>(&porsche::render_driver_set_alias_16_00537940),
        reinterpret_cast<void*>(&porsche::render_driver_set_alias_17_00537960),
        reinterpret_cast<void*>(&porsche::render_driver_set_state_f_00537980),
        reinterpret_cast<void*>(&porsche::render_driver_set_state18_005379a0),
    };
    const U test_vals[] = {0u, 0x33330004u, 0x3333000cu, 0x3f800000u, 0xdeadbeefu};
    for (U idx = 0u; idx < 10u; ++idx) {
        for (U en = 0u; en < 2u; ++en) {
            for (U v : test_vals) {
                for (U s = 0u; s < 2u; ++s) {
                    side = s;
                    Snapshot& dst = (s == 0u) ? expected : actual;
                    std::memset(&dst, 0, sizeof dst);
                    cur = &dst;
                    reset_state(0x20000u, en, 5u);
                    U abi = 0u;
                    (void)invoke_fast3(s == 0u ? origs[idx] : cpps[idx], ptr_u(&cfg_buf[0]), 0u, v, abi);
                    capture(dst, abi, 0u);
                }
                check_snapshots("setter");
            }
        }
    }
}

static void test_select_mode() {
    struct Case {
        U sel_ok;
        U bind_ok;
        U mode;
        U state2_en;
        U ctx_flags;
    };
    const Case list[] = {
        {0u, 1u, 3u, 1u, 0u},
        {1u, 0u, 4u, 0u, 0u},
        {1u, 1u, 5u, 1u, 0x20000u},
        {1u, 1u, 7u, 1u, 0u},
    };
    for (const Case& c : list) {
        for (U s = 0u; s < 2u; ++s) {
            side = s;
            Snapshot& dst = (s == 0u) ? expected : actual;
            std::memset(&dst, 0, sizeof dst);
            cur = &dst;
            select_ret_mode = c.sel_ok;
            bind_ret_mode = c.bind_ok;
            reset_state(c.ctx_flags, c.state2_en, 4u);
            // Force state2 (cfg[4]) & state18 (cfg[12]) to change so callbacks fire during select_mode
            cfg_buf[4] = 0x11111111u;
            cfg_buf[12] = 0x22222222u;
            U abi = 0u;
            U rv = invoke_fast3(
                s == 0u ? static_cast<void*>(code_538b30)
                        : reinterpret_cast<void*>(&porsche::render_driver_select_mode_00538b30),
                ptr_u(&self_buf[0]), 0u, c.mode, abi);
            capture(dst, abi, rv & 0xffu);
        }
        check_snapshots("select_mode_538b30");
    }
}

