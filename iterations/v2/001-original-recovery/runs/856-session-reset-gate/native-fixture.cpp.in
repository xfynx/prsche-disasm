#define WIN32_LEAN_AND_MEAN
#include <windows.h>

#include <array>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#include "session_reset_gate_856.hpp"

namespace porsche {
namespace {
std::uint32_t application_word_storage;
}
std::uint32_t& global_00657414 = application_word_storage;
}

namespace {
using Word = std::uint32_t;
using Byte = std::uint8_t;
using namespace porsche;

const Byte original_body[] = {@BODY_004030B0@};
Word oracle_payload;
Word oracle_application_word;
Word oracle_object;
Word oracle_calls;
Word oracle_this;
Word oracle_argument;
Word candidate_calls;
Word candidate_this;
Word candidate_argument;

void require(bool ok, const char* label) {
    if (!ok) {
        std::printf("divergence %s\n", label);
        std::exit(10);
    }
}

Word read_word(const void* source) {
    Word value;
    std::memcpy(&value, source, sizeof value);
    return value;
}

extern "C" __declspec(naked) void oracle_child() {
    __asm {
        mov oracle_this, ecx
        mov eax, dword ptr [esp + 4]
        mov oracle_argument, eax
        inc oracle_calls
        ret 4
    }
}

const void* prepare_original() {
    const std::size_t size = sizeof original_body;
    auto* code = static_cast<Byte*>(
        VirtualAlloc(nullptr, size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE));
    require(code != nullptr, "oracle code allocation");
    std::memcpy(code, original_body, size);
    struct AbsoluteOperand { std::size_t offset; Word original; Word replacement; };
    const AbsoluteOperand operands[] = {
        {1u, 0x005e66b0u, reinterpret_cast<Word>(&oracle_payload)},
        {11u, 0x00657414u, reinterpret_cast<Word>(&oracle_application_word)},
        {21u, 0x005e752cu, reinterpret_cast<Word>(&oracle_object)},
    };
    for (const auto& operand : operands) {
        require(read_word(code + operand.offset) == operand.original, "absolute operand");
        std::memcpy(code + operand.offset, &operand.replacement, sizeof operand.replacement);
    }
    require(code[26] == 0xe8u, "call opcode");
    const auto target = reinterpret_cast<std::intptr_t>(&oracle_child);
    const auto next = reinterpret_cast<std::intptr_t>(code + 31u);
    const auto displacement = static_cast<std::int32_t>(target - next);
    require(next + displacement == target, "call displacement");
    std::memcpy(code + 27u, &displacement, sizeof displacement);
    DWORD old_protection = 0;
    require(VirtualProtect(code, size, PAGE_EXECUTE_READ, &old_protection) != FALSE,
            "oracle code protection");
    require(FlushInstructionCache(GetCurrentProcess(), code, size) != FALSE,
            "oracle instruction cache flush");
    return code;
}

bool invoke(const void* fn) {
    Word before = 0, frame = 0, failed = 0;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        jne bad
        jmp done
    bad:
        mov failed, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    return failed == 0;
}
} // namespace

namespace porsche {
void __fastcall session_reset_children_0040e3b0(
    SessionResetObject0040e3b0* self, void* /*unused_edx*/, const void* payload) {
    ++candidate_calls;
    candidate_this = reinterpret_cast<Word>(self);
    candidate_argument = reinterpret_cast<Word>(payload);
}
} // namespace porsche

int main() {
    static_assert(sizeof(void*) == sizeof(Word));
    const auto* original = prepare_original();
    const auto* candidate = reinterpret_cast<const void*>(&frame_reset_service_004030b0);
    constexpr std::array<Word, 4> values = {{0u, 1u, 0x12345678u, 0xffffffffu}};
    Word cases = 0;
    for (Word payload : values) {
        for (Word application_word : values) {
            for (Word object : values) {
                oracle_payload = payload;
                oracle_application_word = application_word;
                oracle_object = object;
                oracle_calls = oracle_this = oracle_argument = 0u;
                session_reset_payload_005e66b0 = reinterpret_cast<const void*>(payload);
                global_00657414 = application_word;
                session_reset_object_005e752c =
                    reinterpret_cast<SessionResetObject0040e3b0*>(object);
                candidate_calls = candidate_this = candidate_argument = 0u;
                require(invoke(original), "004030b0 original cdecl ABI");
                require(invoke(candidate), "004030b0 candidate cdecl ABI");
                require(candidate_calls == oracle_calls, "child call count");
                require(candidate_this == oracle_this, "child ECX");
                require(candidate_argument == oracle_argument, "child stack argument");
                ++cases;
            }
        }
    }
    std::printf("cases=%u session_reset_gate_original_x86_vs_cpp=PASS\n", cases);
}
