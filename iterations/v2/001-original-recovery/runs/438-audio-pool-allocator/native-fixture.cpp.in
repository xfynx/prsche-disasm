    for(U count:{0u,0xffffffffu,0xfffffffeu}) {
        base(); field(4,device(0x168)); field(0x14,count);
        wr(initial.device+0x160,0x40); wr(initial.device+0x164,0x10);
        wr(initial.device+0x158,0x80); wr(initial.device+0x15c,0x10);
