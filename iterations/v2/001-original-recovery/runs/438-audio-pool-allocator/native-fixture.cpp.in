    for(U request:{0u,1u,3u,4u,0x3ddu,0x3dcu,0x3deu,0x7ffffffcu,0x7ffffffdu,0x80000000u,0xfffffffcu,0xfffffffdu,0xffffffffu})
    for(U limit:{0u,3u,4u,0x3ddu,0x7fffffffu,0x80000000u,0xfffffff8u})
    for(U cursor:{0u,0x3fdu,0x7fffffffu,0x80000000u,0xffffffffu}) {
        base(); field(0xc,limit); field(0x10,cursor); op(ALLOC,request); op(RELEASE_RESULT,0);
        if(!run(2,id++)) return 1;
    }
    // Clamp pointer aliases: same word, limit word, separate slots, canonical cell.
    for(U start:{0u,1u,0x3ddu,0x7fffffffu,0x80000000u,0xffffffffu})
    for(U gap:{0u,1u,0x3ddu,0x7fffffffu,0x80000000u,0xffffffffu})
    for(U limit:{0u,0x3ddu,0x7fffffffu,0x80000000u}) for(U alias=0;alias<5;++alias) {
