int main() {
    using namespace porsche;
    for(auto x:application_audio_device_state_006b48c0.backing) if(x) return 80;
    for(auto x:audio_backend_lock_cs_006b1800) if(x) return 81;
    if(audio_backend_pool_006b4a18 || &audio_backend_pool_006b4a18!=reinterpret_cast<U*>(&application_audio_device_state_006b48c0[0x158])) return 82;
    if(!init()) { printf("patch failure\n"); return 83; }
    U id=0;
    // Real configure->allocate->free sequences, each intermediate state compared.
    for(U size:{0x60u,0x80u,0x100u,0x180u,0x400u}) for(U align=0;align<4;++align) for(U seed=0;seed<64;++seed) {
        const U h=0x100+align; base(h); op(CONFIGURE,arena(h),size);
        for(U i=0;i<6;++i) op(ALLOC,((seed*13+i*17)&63));
        op(RELEASE_RESULT,3); op(RELEASE_RESULT,1); op(ALLOC,(seed&15));
