// Synthetic typed callsite; exactly one/two cdecl stack arguments, actual ABI probe.
static U invoke(void* fn,U a0,U a1,U argc,U* abi) {
    U saved_sp,saved_bp,result,fail=0;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp,esp
        mov saved_bp,ebp
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,10203040h
        cmp argc,2
        jne one
        push a1
    one:
        push a0
        call fn
        mov result,eax
        mov ecx,argc
        shl ecx,2
        add esp,ecx
        cmp esp,saved_sp
        jne bad
        cmp ebp,saved_bp
        jne bad
        cmp ebx,13579bdfh
        jne bad
        cmp esi,2468ace0h
        jne bad
        cmp edi,10203040h
        je done
    bad:
        mov fail,1
    done:
        mov esp,saved_sp
        pop edi
        pop esi
        pop ebx
    }
    *abi=fail; return result;
}
