    if(!slab) return false;
    static const unsigned char bc[]={ @BODY_0058aa60@ }; memcpy(slab+C,bc,sizeof(bc));
    static const unsigned char ba[]={ @BODY_0058aae0@ }; memcpy(slab+A,ba,sizeof(ba));
    static const unsigned char br[]={ @BODY_0058ac30@ }; memcpy(slab+R,br,sizeof(br));
    static const unsigned char bi[]={ @BODY_0058aa90@ }; memcpy(slab+I,bi,sizeof(bi));
