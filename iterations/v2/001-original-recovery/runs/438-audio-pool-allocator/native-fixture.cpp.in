}
static void execute(bool cpp,Snapshot* out) {
    load();
    for(U i=0;i<operation_count;++i) {
        const auto& o=operations[i]; U a=o.a,argc=1,abi=0; void* target=nullptr; bool used=true;
        switch(o.kind) {
        case ALLOC: target=cpp?reinterpret_cast<void*>(&porsche::application_audio_backend_allocate_0058aae0):slab+A; break;
        case RELEASE: target=cpp?reinterpret_cast<void*>(&porsche::audio_backend_pool_release_0058ac30):slab+R; break;
        case CLAMP: target=cpp?reinterpret_cast<void*>(&porsche::audio_backend_pool_clamp_0058aa60):slab+C; argc=2; used=false; break;
        case FACADE: target=cpp?reinterpret_cast<void*>(&porsche::application_audio_backend_release_0058ac30):slab+R; used=false; break;
        case CONFIGURE: target=cpp?reinterpret_cast<void*>(&porsche::application_audio_backend_configure_0058aa90):slab+I; argc=2; used=false; break;
        case RELEASE_RESULT: a=results[a]; target=cpp?reinterpret_cast<void*>(&porsche::audio_backend_pool_release_0058ac30):slab+R; break;
        case FACADE_RESULT: a=results[a]; target=cpp?reinterpret_cast<void*>(&porsche::application_audio_backend_release_0058ac30):slab+R; used=false; break;
        default: ExitProcess(91);
        }
        U result=invoke(target,a,o.b,argc,&abi);
