    }
}
static bool run(U family,U id) {
    execute(false,original); execute(true,candidate);
    for(U i=0;i<operation_count;++i) {
        if(original[i].abi || candidate[i].abi || memcmp(&original[i],&candidate[i],sizeof(Snapshot))) {
            printf("divergence family=%u id=%u step=%u kind=%u return=%08x/%08x ABI=%u/%u\n",family,id,i,operations[i].kind,original[i].result,candidate[i].result,original[i].abi,candidate[i].abi); return false;
        }
    }
    ++cases; steps+=operation_count; return true;
