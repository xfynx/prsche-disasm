        pop flags
        add esp,12
        cmp esp,saved_sp
        jne bad
        cmp ebp,saved_frame
        jne bad
        cmp ebx,13579bdfh
        jne bad
        cmp esi,55667788h
        jne bad
        cmp edi,99aabbcch
        je done
    bad:mov fail,1
