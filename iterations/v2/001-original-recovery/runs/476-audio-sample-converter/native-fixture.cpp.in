// Synthetic cdecl callsite; raw original and production use the same stack and
// sentinel registers. ESP/EBP and cdecl callee GPRs checked. The actual caller
// ignores return, flags and volatile EAX/ECX/EDX, which the original preserves.
__declspec(noinline) static U invoke(void* fn,U count,U source,U destination){U saved_sp,saved_frame,fail=0;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp,esp
        mov saved_frame,ebp
        push destination
        push source
        push count
