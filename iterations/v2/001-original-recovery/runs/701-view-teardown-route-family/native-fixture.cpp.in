static LONG WINAPI fault_handler(EXCEPTION_POINTERS* info) {
    const CONTEXT& context = *info->ContextRecord;
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u "
                "eax=%08lx ebx=%08lx ecx=%08lx edx=%08lx esi=%08lx edi=%08lx\n",
                info->ExceptionRecord->ExceptionCode, context.Eip, cases, which,
                context.Eax, context.Ebx, context.Ecx, context.Edx, context.Esi,
                context.Edi);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

int main() {
    AddVectoredExceptionHandler(1u, fault_handler);
    verify_original_data();
    prepare_code();

    static const U indices[] = {0u, 1u, 2u, 3u, 0x81u, 0x7ffffffeu};
    for (U index : indices) run_route_case(index);

    for (U present = 0u; present < 2u; ++present) run_secondary_case(present);

    for (U root = 0u; root < 2u; ++root)
        for (U vec = 0u; vec < 2u; ++vec)
            for (U items = 0u; items < 4u; ++items)
                run_finish_case(root, vec, items);

    run_sync_case();

    static const U modes[] = {0u, 1u, 0x1234u, 0xffffu, 0x80000001u};
    for (U mode : modes) run_service_case(mode);

    for (U same = 0u; same < 2u; ++same) run_snapshot_case(same);
    for (U variant = 0u; variant < 2u; ++variant) run_cell_case(variant);
    for (U inner = 0u; inner < 2u; ++inner) run_movie_case(inner);

    std::printf("view_teardown_route_family_701_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
