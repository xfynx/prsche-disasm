void exec_cxx_throw_side(Snapshot* snap, bool use_x86, const char* msg) {
    cur = snap;
    porsche::RttiStdException ex{nullptr, msg, 1u};
    void* fn = use_x86
        ? static_cast<void*>(g_code_5a5304)
        : reinterpret_cast<void*>(&porsche::rtti_cxx_throw_005a5304);
    using ThrowFn = void(__stdcall*)(void*, const void*);
    __try {
        reinterpret_cast<ThrowFn>(fn)(&ex, kThrowInfoDummy);
    } __except (capture_seh(GetExceptionInformation(), snap)) {
    }
}

