static_assert(sizeof(kRaw5a5304) == 58u, "005a5304 size mismatch");

struct SehScopeEntry {
    U enclosing_level;
    const void* filter;
    const void* handler;
};

struct Eh3Registration {
    Eh3Registration* next;
    void* handler;
    SehScopeEntry* scopetable;
    I trylevel;
};

