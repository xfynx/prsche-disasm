void exec_dynamic_cast_side(
    Snapshot* snap,
    bool use_x86,
    U element,
    U vf_delta,
    const void* src_type,
    const void* dst_type,
    U is_ref,
    U base_addr) {
    cur = snap;
    U esp_b = 0u, esp_a = 0u, ebx_b = 0u, esi_b = 0u, edi_b = 0u, ebp_b = 0u;
    U ebx_a = 0u, esi_a = 0u, edi_a = 0u, ebp_a = 0u, ret = 0u;
    void* fn = use_x86
        ? static_cast<void*>(g_code_5a134b)
        : reinterpret_cast<void*>(&porsche::formatter_compare_005a134b);
    __try {
        g_x86_5a134b_active = use_x86;
        __asm {
            mov ebx_b, ebx
            mov esi_b, esi
            mov edi_b, edi
            mov ebp_b, ebp
            mov esp_b, esp
            push is_ref
            push dst_type
            push src_type
            push vf_delta
            push element
            mov eax, fn
            call eax
            add esp, 20
            mov esp_a, esp
            mov ret, eax
            mov ebx_a, ebx
            mov esi_a, esi
            mov edi_a, edi
            mov ebp_a, ebp
        }
        g_x86_5a134b_active = false;
        snap->abi_fail = (esp_b != esp_a || ebx_b != ebx_a || esi_b != esi_a ||
                          edi_b != edi_a || ebp_b != ebp_a) ? 1u : 0u;
        snap->ret = (ret == 0u) ? 0u : (ret - base_addr + 0x10000000u);
    } __except (capture_seh(GetExceptionInformation(), snap)) {
        g_x86_5a134b_active = false;
    }
}

void run_dynamic_cast(
    const char* name,
    U element,
    U vf_delta,
    const void* src_type,
    const void* dst_type,
    U is_ref,
    U base_addr) {
    ++g_cases;
    std::memset(&expected, 0, sizeof(expected));
    std::memset(&actual, 0, sizeof(actual));
    exec_dynamic_cast_side(&expected, true, element, vf_delta, src_type, dst_type, is_ref, base_addr);
    exec_dynamic_cast_side(&actual, false, element, vf_delta, src_type, dst_type, is_ref, base_addr);
    fail_if_diff(name);
}

void setup_rwx() {
    g_code_5a5088 = alloc_rwx(kRaw5a5088, sizeof(kRaw5a5088));
    write_rel32(g_code_5a5088, 0x11u, reinterpret_cast<void*>(&porsche::formatter_strlen_005a6730));
    write_rel32(g_code_5a5088, 0x18u, reinterpret_cast<void*>(&porsche::startup_network_allocate_0059ef90));
    write_rel32(g_code_5a5088, 0x29u, reinterpret_cast<void*>(&porsche::formatter_error_copy_005aa4e0));

    g_code_5a1462 = alloc_rwx(kRaw5a1462, sizeof(kRaw5a1462));
    write_rel32(g_code_5a1462, 0x08u, g_code_5a5088);

    g_code_5a12f9 = alloc_rwx(kRaw5a12f9, sizeof(kRaw5a12f9));
    write_rel32(g_code_5a12f9, 0x11u, g_code_5a5088);

