int main() {
    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
    PVOID veh = AddVectoredExceptionHandler(1u, &veh_handler_5a134b);
    setup_rwx();

    run_exception_ctor("exc-empty", "", false);
    run_exception_ctor("exc-bad-cast", "Bad dynamic_cast!", false);
    run_exception_ctor("exc-alloc-fail", "Bad dynamic_cast!", true);
    run_bad_cast_ctor("bad-cast-ctor", "Bad dynamic_cast!");
    run_non_rtti_ctor("non-rtti-ctor", "Access violation - no RTTI data!");
    run_cxx_throw("cxx-throw", "Bad dynamic_cast!");

    ObjSingle s_obj = {&vt_single.fn, 42u};
    const U s_addr = static_cast<U>(reinterpret_cast<std::uintptr_t>(&s_obj));
    run_dynamic_cast("cast-null-ptr", 0u, 0u, &td_base, &td_leaf, 0u, s_addr);
    run_dynamic_cast("cast-null-ref", 0u, 0u, &td_base, &td_leaf, 1u, s_addr);
    run_dynamic_cast("single-to-base", s_addr, 0u, &td_leaf, &td_base, 0u, s_addr);
    run_dynamic_cast("single-to-leaf", s_addr, 0u, &td_base, &td_leaf, 0u, s_addr);
    run_dynamic_cast("single-fail-ptr", s_addr, 0u, &td_base, &td_other, 0u, s_addr);
    run_dynamic_cast("single-fail-ref", s_addr, 0u, &td_base, &td_other, 1u, s_addr);
    run_dynamic_cast("single-vf-delta", s_addr + 4u, 4u, &td_base, &td_leaf, 0u, s_addr);

    ObjMulti m_obj = {&vt_multi_0.fn, 1u, &vt_multi_8.fn, &vt_multi_12.fn};
    const U m_addr = static_cast<U>(reinterpret_cast<std::uintptr_t>(&m_obj));
    run_dynamic_cast("multi-sub0-to-other", m_addr, 0u, &td_base, &td_other, 0u, m_addr);
    run_dynamic_cast("multi-sub8-to-leaf", m_addr + 8u, 0u, &td_other, &td_leaf, 0u, m_addr);
    run_dynamic_cast("multi-sub8-to-base", m_addr + 8u, 0u, &td_other, &td_base, 0u, m_addr);
    run_dynamic_cast("multi-vf-delta", m_addr + 12u, 4u, &td_other, &td_mid, 0u, m_addr);
    run_dynamic_cast("multi-fail-ref", m_addr + 8u, 0u, &td_other, &td_vbase, 1u, m_addr);

    ObjVirtual v_obj = {&vt_v.fn, vbtable_v, 11u, 99u};
    const U v_addr = static_cast<U>(reinterpret_cast<std::uintptr_t>(&v_obj));
    run_dynamic_cast("virt-to-vbase", v_addr, 0u, &td_leaf, &td_vbase, 0u, v_addr);
    run_dynamic_cast("virt-to-mid", v_addr, 0u, &td_leaf, &td_mid, 0u, v_addr);
    run_dynamic_cast("virt-ambig-ptr", v_addr, 0u, &td_leaf, &td_ambig, 0u, v_addr);
    run_dynamic_cast("virt-fail-ptr", v_addr, 0u, &td_leaf, &td_other, 0u, v_addr);
    run_dynamic_cast("virt-fail-ref", v_addr, 0u, &td_leaf, &td_other, 1u, v_addr);

    const VtableSlot vt_client = {&porsche::network_rtti_005c5190, nullptr};
    ObjSingle c_obj = {&vt_client.fn, 77u};
    const U c_addr = static_cast<U>(reinterpret_cast<std::uintptr_t>(&c_obj));
    run_dynamic_cast("net-client-to-conn", c_addr, 0u,
                     &porsche::rtti_client_type_005d0630.prefix,
                     &porsche::rtti_connection_type_005d0650.prefix, 0u, c_addr);
    run_dynamic_cast("net-client-to-host-fail", c_addr, 0u,
                     &porsche::rtti_client_type_005d0630.prefix,
                     &porsche::rtti_host_type_005d0690.prefix, 1u, c_addr);

    run_dynamic_cast("av-bad-ptr-0", 0x00000010u, 0u, &td_base, &td_leaf, 0u, 0u);
    run_dynamic_cast("av-bad-ptr-ref", 0x00000010u, 0u, &td_base, &td_leaf, 1u, 0u);

    if (veh) {
        RemoveVectoredExceptionHandler(veh);
    }
    std::printf("rtti_cast_825_original_x86_vs_cpp=PASS cases=%u\n", g_cases);
    std::fflush(nullptr);
    return 0;
}
