const char kNonRttiMsg[] = "Access violation - no RTTI data!";
const U kThrowInfoDummy[4] = {0u, 0u, 0u, 0u};
const U kCxxThrowTemplate[8] = {
    0xE06D7363u, 1u, 0u, 0u, 3u, 0x19930520u, 0u, 0u
};
using RaiseExcFn = void(__stdcall*)(DWORD, DWORD, DWORD, const ULONG_PTR*);
RaiseExcFn g_raise_exc_ptr = &RaiseException;

const U kEhSentinel = 0x5A522C85u;

int __cdecl call_eh3_filter(const void* filter_fn, U frame_ebp) {
    int rc = 0;
    __asm {
        push ebp
        mov eax, filter_fn
        mov ebp, frame_ebp
        call eax
        pop ebp
        mov rc, eax
    }
    return rc;
}

LONG CALLBACK veh_handler_5a134b(PEXCEPTION_POINTERS ep) {
    if (!g_x86_5a134b_active || !ep || !ep->ExceptionRecord || !ep->ContextRecord) {
        return EXCEPTION_CONTINUE_SEARCH;
    }
    auto* reg = reinterpret_cast<Eh3Registration*>(static_cast<std::uintptr_t>(__readfsdword(0u)));
    if (!reg || reinterpret_cast<std::uintptr_t>(reg->handler) != kEhSentinel) {
        return EXCEPTION_CONTINUE_SEARCH;
    }
    if (reg->trylevel == 0 && reg->scopetable && reg->scopetable->filter && reg->scopetable->handler) {
        reinterpret_cast<U*>(reg)[-1] = static_cast<U>(reinterpret_cast<std::uintptr_t>(ep));
        const U frame_ebp = static_cast<U>(reinterpret_cast<std::uintptr_t>(reg)) + 0x10u;
        const int take = call_eh3_filter(reg->scopetable->filter, frame_ebp);
        reg->trylevel = -1;
        __writefsdword(0u, static_cast<DWORD>(reinterpret_cast<std::uintptr_t>(reg->next)));
        if (take == 1) {
            ep->ContextRecord->Ebp = frame_ebp;
            ep->ContextRecord->Eip =
                static_cast<DWORD>(reinterpret_cast<std::uintptr_t>(reg->scopetable->handler));
            return EXCEPTION_CONTINUE_EXECUTION;
        }
        return EXCEPTION_CONTINUE_SEARCH;
    }
    __writefsdword(0u, static_cast<DWORD>(reinterpret_cast<std::uintptr_t>(reg->next)));
    return EXCEPTION_CONTINUE_SEARCH;
}

int capture_seh(EXCEPTION_POINTERS* ep, Snapshot* snap) {
    if (!ep || !ep->ExceptionRecord) {
        return EXCEPTION_CONTINUE_SEARCH;
    }
    const auto* er = ep->ExceptionRecord;
    if (er->ExceptionCode != 0xE06D7363u) {
        return EXCEPTION_CONTINUE_SEARCH;
    }
    snap->threw = 1u;
    snap->seh_code = er->ExceptionCode;
    snap->seh_flags = er->ExceptionFlags;
    snap->seh_nargs = er->NumberParameters;
    if (er->NumberParameters >= 2u) {
        snap->seh_magic = static_cast<U>(er->ExceptionInformation[0]);
        const auto* ex = reinterpret_cast<const porsche::RttiStdException*>(
            er->ExceptionInformation[1]);
        if (ex) {
            snap->do_free = ex->do_free;
            snap->has_what = (ex->what != nullptr) ? 1u : 0u;
            copy_what(snap->what, sizeof(snap->what), ex->what);
        }
    }
    return EXCEPTION_EXECUTE_HANDLER;
}

void fail_if_diff(const char* name) {
    if (expected.abi_fail != 0u || actual.abi_fail != 0u ||
        std::memcmp(&expected, &actual, sizeof(Snapshot)) != 0) {
        std::printf("divergence %s\n", name);
        std::printf("  expected: abi=%u ret=0x%08x threw=%u code=0x%08x flags=%u nargs=%u magic=0x%08x what=%s do_free=%u ev=%u\n",
                    expected.abi_fail, expected.ret, expected.threw, expected.seh_code,
                    expected.seh_flags, expected.seh_nargs, expected.seh_magic,
                    expected.what, expected.do_free, expected.ev_count);
        std::printf("  actual:   abi=%u ret=0x%08x threw=%u code=0x%08x flags=%u nargs=%u magic=0x%08x what=%s do_free=%u ev=%u\n",
                    actual.abi_fail, actual.ret, actual.threw, actual.seh_code,
                    actual.seh_flags, actual.seh_nargs, actual.seh_magic,
                    actual.what, actual.do_free, actual.ev_count);
        std::fflush(nullptr);
        ExitProcess(10u);
    }
}

