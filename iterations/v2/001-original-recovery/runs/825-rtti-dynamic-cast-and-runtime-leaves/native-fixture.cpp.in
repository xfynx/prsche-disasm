void exec_exception_ctor_side(Snapshot* snap, bool use_x86, const char* msg, bool fail_alloc) {
    cur = snap;
    g_alloc_fail = fail_alloc;
    porsche::RttiStdException ex{};
    const char* p = msg;
    const char* const* pp = &p;
    U esp_b = 0u, esp_a = 0u, ebx_b = 0u, esi_b = 0u, edi_b = 0u, ebp_b = 0u;
    U ebx_a = 0u, esi_a = 0u, edi_a = 0u, ebp_a = 0u, ret = 0u;
    void* fn = use_x86
        ? static_cast<void*>(g_code_5a5088)
        : reinterpret_cast<void*>(&porsche::rtti_exception_ctor_005a5088);
    porsche::RttiStdException* self = &ex;
    __asm {
        mov ebx_b, ebx
        mov esi_b, esi
        mov edi_b, edi
        mov ebp_b, ebp
        mov esp_b, esp
        push pp
        mov ecx, self
        mov eax, fn
        call eax
        mov esp_a, esp
        mov ret, eax
        mov ebx_a, ebx
        mov esi_a, esi
        mov edi_a, edi
        mov ebp_a, ebp
    }
    snap->abi_fail = (esp_b != esp_a || ebx_b != ebx_a || esi_b != esi_a ||
                      edi_b != edi_a || ebp_b != ebp_a) ? 1u : 0u;
    snap->ret = (ret == static_cast<U>(reinterpret_cast<std::uintptr_t>(&ex))) ? 1u : 0u;
    snap->do_free = ex.do_free;
    snap->has_what = (ex.what != nullptr) ? 1u : 0u;
    copy_what(snap->what, sizeof(snap->what), ex.what);
    if (ex.what) {
        std::free(const_cast<char*>(ex.what));
    }
    g_alloc_fail = false;
}

void run_exception_ctor(const char* name, const char* msg, bool fail_alloc) {
    ++g_cases;
    std::memset(&expected, 0, sizeof(expected));
    std::memset(&actual, 0, sizeof(actual));
    exec_exception_ctor_side(&expected, true, msg, fail_alloc);
    exec_exception_ctor_side(&actual, false, msg, fail_alloc);
    fail_if_diff(name);
}

