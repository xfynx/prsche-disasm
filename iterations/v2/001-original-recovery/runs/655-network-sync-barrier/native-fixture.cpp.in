using U = std::uint32_t;
using B = std::uint8_t;

static_assert(sizeof(porsche::network_sync_abort_str_005d0738) == 7u);
static_assert(sizeof(porsche::network_sync_wait_low2_str_005d0740) == 17u);
static_assert(sizeof(porsche::network_sync_wait_low1_str_005d0754) == 17u);
static_assert(sizeof(porsche::network_sync_wait_high2_str_005d0768) == 18u);
static_assert(sizeof(porsche::network_sync_wait_high1_str_005d077c) == 18u);

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U word(const void* p, U off = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + off, 4u);
    return v;
}

static void put_u32(void* p, U off, U v) {
    std::memcpy(static_cast<B*>(p) + off, &v, 4u);
}

static void put_u8(void* p, U off, B v) {
    static_cast<B*>(p)[off] = v;
}

static B get_u8(const void* p, U off) {
    return static_cast<const B*>(p)[off];
}

static B* code = nullptr;
static B* slot_55ff60 = nullptr;
static B* slot_48d350 = nullptr;
static B* slot_48cdf0 = nullptr;

static B orig_str_5d0738[7] = {};
static B orig_str_5d0740[17] = {};
static B orig_str_5d0754[17] = {};
static B orig_str_5d0768[18] = {};
static B orig_str_5d077c[18] = {};

static U cases = 0u;
alignas(16) static B floating[512] = {};

static B net_arena[0x100] = {};
static B self_arena[0x100] = {};
static B* active_self = net_arena;
static B receiver_a[16] = {};
static B receiver_b[16] = {};
static U lock_cell_a[2] = {};
static U lock_cell_b[2] = {};

enum EventTag : U {
    kEvKeyCb = 1u,
    kEvNetMsg = 2u,
    kEvAction = 3u,
    kEvSplash = 4u,
    kEvDiag = 5u,
    kEvSleep = 6u,
    kEvTimed = 7u,
    kEvHeapEnter = 8u,
    kEvHeapLeave = 9u,
};

struct Event {
    U tag;
    U a0;
    U a1;
    U a2;
    U a3;
    U a4;
    char text[64];
};

struct Fpu {
    unsigned short control, status;
    B tag, padding[3], values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U count;
    Event events[128];
    B final_net[0x100];
    B final_self[0x100];
    Fpu fpu;
};

static Trace trace{};
static Trace expected{};

struct ScriptStep {
    U key_ret;
    U set_e6_mask;
    U clear_e6_mask;
    U set_e7_mask;
    U clear_e7_mask;
    U new_seq_id;
    bool change_seq_id;
    B clear_be;
    B set_bf;
    B set_c5;
    bool drop_net_ptr;
    bool drop_net_active;
};

struct StubCfg {
    U key_call_ret;
    U splash_call_idx;
    U timed_call_idx;
    U diag_call_idx;
    U script_count;
    ScriptStep steps[24];
    bool diag_abort_sets_c5;
    bool diag_abort_sets_bf;
    bool diag_abort_drops_net;
    bool splash_abort_clears_c5;
    bool splash_abort_sets_c5_loop;
    U splash_trigger_at;
    U action_sets_extra_flag;
    U heap_enter_swaps_lock;
    U net_msg_updates_field;
};

static StubCfg stub_cfg{};

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_ptr(U p) {
    if (p == 0u) return 0u;
    if (p == address(receiver_a)) return 0xb1000001u;
    if (p == address(receiver_b)) return 0xb1000002u;
    if (p == address(net_arena)) return 0xb2000001u;
    if (p == address(self_arena)) return 0xb2000002u;
    if (p == address(lock_cell_a)) return 0xb3000001u;
    if (p == address(lock_cell_b)) return 0xb3000002u;
    return p;
}

static Event& push_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u, U a4 = 0u, const char* text = nullptr) {
    require(trace.count < 128u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    e.a4 = a4;
    if (text != nullptr) {
        std::snprintf(e.text, sizeof(e.text), "%s", text);
    }
    return e;
}

static std::uint32_t __cdecl fixture_key_callback() {
    const U idx = stub_cfg.timed_call_idx;
    U ret = stub_cfg.key_call_ret;
    if (idx < stub_cfg.script_count) {
        ret = stub_cfg.steps[idx].key_ret;
    }
    push_event(kEvKeyCb, ret);
    return ret;
}

namespace porsche {

void* startup_network_00628c70 = nullptr;
void* startup_input_key_callback_005df6a4 = nullptr;

void __fastcall application_network_message_0048c870(void* receiver, void* unused_edx,
    std::uint32_t message, std::uint32_t first, std::uint32_t second,
    std::uint32_t third, std::uint32_t fourth) {
    (void)unused_edx;
    push_event(kEvNetMsg, normalize_ptr(address(receiver)), message, first, second,
               (third & 0xffffu) ^ (fourth * 131u));
    // Also check exact third and fourth via an extra event or packed check:
    require(third == 0u || third == 0xdeadbeefu, "unexpected third arg");
    if (stub_cfg.net_msg_updates_field != 0u && startup_network_00628c70 != nullptr) {
        put_u8(startup_network_00628c70, 0xb8u, static_cast<B>(stub_cfg.net_msg_updates_field));
    }
}

void __cdecl network_services_action_0048da60(std::uint32_t first, std::uint32_t second) {
    push_event(kEvAction, first, second);
    if (stub_cfg.action_sets_extra_flag != 0u && startup_network_00628c70 != nullptr) {
        put_u8(startup_network_00628c70, 0xbdu, static_cast<B>(stub_cfg.action_sets_extra_flag));
    }
}

void __cdecl splash_progress_004a4a70(std::int32_t phase) {
    const U idx = stub_cfg.splash_call_idx++;
    push_event(kEvSplash, static_cast<U>(phase), idx);
    if (stub_cfg.splash_abort_clears_c5 && startup_network_00628c70 != nullptr) {
        put_u8(startup_network_00628c70, 0xc5u, 0u);
    }
    if (stub_cfg.splash_abort_sets_c5_loop && idx == stub_cfg.splash_trigger_at &&
        startup_network_00628c70 != nullptr) {
        put_u8(startup_network_00628c70, 0xc5u, 1u);
    }
}

void __cdecl render_texture_diagnostic_0055ec50(std::uint32_t channel, const char* format, ...) {
    char buf[64] = {};
    if (format != nullptr) {
        va_list args;
        va_start(args, format);
        std::vsnprintf(buf, sizeof(buf), format, args);
        va_end(args);
    }
    const U idx = stub_cfg.diag_call_idx++;
    push_event(kEvDiag, channel, idx, 0u, 0u, 0u, buf);
    if (format != nullptr && std::strcmp(format, "Abort\n") == 0) {
        if (stub_cfg.diag_abort_sets_c5 && startup_network_00628c70 != nullptr) {
            put_u8(startup_network_00628c70, 0xc5u, 1u);
        }
        if (stub_cfg.diag_abort_sets_bf && startup_network_00628c70 != nullptr) {
            put_u8(startup_network_00628c70, 0xbfu, 1u);
        }
        if (stub_cfg.diag_abort_drops_net) {
            startup_network_00628c70 = nullptr;
        }
    }
}

std::uint32_t __cdecl file_sleep_0055f740(std::uint32_t milliseconds) {
    push_event(kEvSleep, milliseconds);
    return 0u;
}

std::uint32_t __cdecl timed_callbacks_005366e0(std::uint32_t argument) {
    const U idx = stub_cfg.timed_call_idx++;
    push_event(kEvTimed, argument, idx);
    if (idx < stub_cfg.script_count) {
        const ScriptStep& st = stub_cfg.steps[idx];
        B v6 = get_u8(active_self, 0xe6u);
        v6 = static_cast<B>((v6 | st.set_e6_mask) & ~st.clear_e6_mask);
        put_u8(active_self, 0xe6u, v6);

        B v7 = get_u8(active_self, 0xe7u);
        v7 = static_cast<B>((v7 | st.set_e7_mask) & ~st.clear_e7_mask);
        put_u8(active_self, 0xe7u, v7);

        if (st.change_seq_id) {
            put_u32(net_arena, 0xdcu, st.new_seq_id);
        }
        if (st.clear_be != 0u) {
            put_u8(net_arena, 0xbeu, 0u);
        }
        if (st.set_bf != 0u) {
            put_u8(net_arena, 0xbfu, st.set_bf);
        }
        if (st.set_c5 != 0u) {
            put_u8(net_arena, 0xc5u, st.set_c5);
        }
        if (st.drop_net_active) {
            put_u32(net_arena, 0x08u, 0u);
        }
        if (st.drop_net_ptr) {
            startup_network_00628c70 = nullptr;
        }
    }
    return 0x12340000u | idx; // non-zero upper bits to verify AH/upper-EAX masking
}

void __cdecl heap_enter_005322b0(void* lock) {
    push_event(kEvHeapEnter, address(lock));
    if (stub_cfg.heap_enter_swaps_lock != 0u) {
        lock_cell_a[0] = stub_cfg.heap_enter_swaps_lock;
    }
}

void __cdecl heap_leave_005322c0(void* lock) {
    push_event(kEvHeapLeave, address(lock));
}

} // namespace porsche

static void capture_fpu(Fpu& f) {
    std::memset(&f, 0, sizeof f);
    B env[28];
    __asm {
        fxsave floating
        fnstenv env
        fldenv env
    }
    f.control = *reinterpret_cast<unsigned short*>(floating);
    f.status = *reinterpret_cast<unsigned short*>(floating + 2);
    f.tag = floating[4];
    std::memset(f.padding, 0, 3);
    f.full_tag = *reinterpret_cast<unsigned short*>(env + 8);
    f.mxcsr = *reinterpret_cast<U*>(floating + 24);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((f.status >> 11) + i) & 7u;
        if (f.tag & (1u << physical)) {
            std::memcpy(f.values + i * 10u, floating + 32u + i * 16u, 10u);
        } else {
            std::memset(f.values + i * 10u, 0, 10u);
        }
    }
}

static void seed_fpu() {
    __asm {
        fninit
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static U invoke_cdecl0_u32(void* fn, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static U invoke_cdecl0_void(void* fn) {
    U before = 0u, frame = 0u, fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
