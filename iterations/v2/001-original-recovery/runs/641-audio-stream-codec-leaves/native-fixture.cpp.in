void __cdecl heap_enter_005322b0(void* lock) {
    require(trace.count < kMaxEvents, "event overflow");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof e);
    e.tag = kEvHeapEnter;
    e.arg0 = static_cast<U>(reinterpret_cast<std::uintptr_t>(lock));
    if (active_stream_va != 0u) {
        e.stream_avail_word = rd_va(active_stream_va + 0x3cu);
        if (enter_mutates_lock != 0u) {
            wr_va(active_stream_va + 0x04u, new_lock_value);
        }
    }
    if (active_tap_va != 0u) {
        e.tap_rem_word = rd_va(active_tap_va + 0x08u);
    }
}

void __cdecl heap_leave_005322c0(void* lock) {
    require(trace.count < kMaxEvents, "event overflow");
