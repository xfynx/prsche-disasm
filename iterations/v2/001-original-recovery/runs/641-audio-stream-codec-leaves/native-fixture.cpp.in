    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        wr_va(stream_va + 0x08u, req_base);
        wr_va(stream_va + 0x0cu, num_requests);
        if (idx < 26u) {
            const U slot_va = req_base + idx * 0x128u;
            wr_va(slot_va + 0x00u, slot_id_word);
            wr_va(slot_va + 0x04u, slot_status);
