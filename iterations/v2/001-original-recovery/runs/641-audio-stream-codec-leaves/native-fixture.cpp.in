using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

enum : U {
    kArenaBytes = 8192u,
    kMaxEvents = 8u,
    kMsgCap = 128u,
};

enum EventTag : U {
    kEvHeapEnter = 1u,
    kEvHeapLeave = 2u,
    kEvSetGroup = 3u,
    kEvDiagnostic = 4u,
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U file_word;
    U line_word;
    U stream_avail_word;
    U tap_rem_word;
    char msg[kMsgCap];
};

struct Trace {
    U ret;
    U abi_fail;
    U count;
    Event events[kMaxEvents];
    U final_file_word;
    U final_line_word;
    FpuSnapshot fp;
