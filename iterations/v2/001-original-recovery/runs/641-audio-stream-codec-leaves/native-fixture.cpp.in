static void init_original_code() {
    const B body_0056bce0[] = {@BODY_0056BCE0@};
    const B body_0056bd10[] = {@BODY_0056BD10@};
    const B body_0056c380[] = {@BODY_0056C380@};
    const B body_0056c3e0[] = {@BODY_0056C3E0@};
    const B body_0056c540[] = {@BODY_0056C540@};
    static_assert(sizeof body_0056bce0 == 41u, "0056bce0 size");
    static_assert(sizeof body_0056bd10 == 83u, "0056bd10 size");
    static_assert(sizeof body_0056c380 == 90u, "0056c380 size");
    static_assert(sizeof body_0056c3e0 == 58u, "0056c3e0 size");
    static_assert(sizeof body_0056c540 == 221u, "0056c540 size");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");
    std::memset(code, 0xcc, 4096u);

    orig_56bce0 = code + 0x000u;
    orig_56bd10 = code + 0x100u;
    orig_56c380 = code + 0x200u;
    orig_56c3e0 = code + 0x300u;
    orig_56c540 = code + 0x400u;

    std::memcpy(orig_56bce0, body_0056bce0, sizeof body_0056bce0);
    std::memcpy(orig_56bd10, body_0056bd10, sizeof body_0056bd10);
    std::memcpy(orig_56c380, body_0056c380, sizeof body_0056c380);
    std::memcpy(orig_56c3e0, body_0056c3e0, sizeof body_0056c3e0);
    std::memcpy(orig_56c540, body_0056c540, sizeof body_0056c540);

    auto reloc_rel = [&](B* fn, U off, U expected_disp, const void* target) {
        require(rd(fn, off) == expected_disp, "rel disp");
        wr(fn, off, address(target) - (address(fn) + off + 4u));
    };
    auto reloc_abs = [&](B* fn, U off, U expected_va, const void* target) {
        require(rd(fn, off) == expected_va, "abs va");
        wr(fn, off, address(target));
    };

    // 0056c380 relocations
    reloc_rel(orig_56c380, 0x0du, 0xfffc5f1fu, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56c380, 0x21u, 0xfffc5f1bu, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56c380, 0x4eu, 0xffffbddeu, reinterpret_cast<const void*>(&porsche::file_operation_set_group_005681b0));

    // 0056c540 relocations
    reloc_rel(orig_56c540, 0x11u, 0xffffee2bu, reinterpret_cast<const void*>(&porsche::audio_stream_handle_validate_0056b380));
    reloc_abs(orig_56c540, 0x1du, 0x005bdd88u, porsche::stream_err_get_invalid_handle_005bdd88);
    reloc_abs(orig_56c540, 0x23u, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56c540, 0x27u, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56c540, 0x2du, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56c540, 0x37u, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_rel(orig_56c540, 0x6cu, 0xfffc5d00u, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56c540, 0x85u, 0xfffc5cf7u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");
}

static void prepare_arena() {
    for (U i = 0u; i < kArenaBytes; ++i) {
        arena[i] = static_cast<B>((i * 41u + 0x5au) & 0xffu);
    }
    porsche::shared_runtime_word_005deb74 = 0x11223344u;
    porsche::shared_runtime_word_005deb78 = 0x55667788u;
    porsche::diagnostic_handler_005debf0 =
        reinterpret_cast<void(__cdecl*)(const char*)>(mock_diagnostic_fn);
}

static void compare_traces(bool check_ret) {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "abi");
    if (check_ret) {
        require(trace.ret == expected.ret, "return");
    }
    require(trace.count == expected.count, "event_count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "ev_tag");
        require(trace.events[i].arg0 == expected.events[i].arg0, "ev_arg0");
        require(trace.events[i].arg1 == expected.events[i].arg1, "ev_arg1");
        require(trace.events[i].file_word == expected.events[i].file_word, "ev_file_word");
        require(trace.events[i].line_word == expected.events[i].line_word, "ev_line_word");
        require(trace.events[i].stream_avail_word == expected.events[i].stream_avail_word, "ev_stream_avail");
        require(trace.events[i].tap_rem_word == expected.events[i].tap_rem_word, "ev_tap_rem");
        require(std::memcmp(trace.events[i].msg, expected.events[i].msg, kMsgCap) == 0, "ev_msg");
    }
    require(trace.final_file_word == expected.final_file_word, "final_file_word");
    require(trace.final_line_word == expected.final_line_word, "final_line_word");
    require(std::memcmp(&trace.fp, &expected.fp, sizeof trace.fp) == 0, "fp");
    require(std::memcmp(trace.memory, expected.memory, kArenaBytes) == 0, "arena_memory");

    ++cases;
    events_total += trace.count;
}

static void run_ring_contains(U start, U end, U ptr) {
    active_stream_va = 0u;
    active_tap_va = 0u;
    enter_mutates_lock = 0u;
    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_ring_contains_0056bce0)
                        : reinterpret_cast<void*>(orig_56bce0);
        trace.abi_fail = invoke_3(fn, start, end, ptr);
        trace.ret = captured_return;
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces(true);
}

static void run_unlink(U head_idx, U tail_idx, U active_idx, U target_idx, U init_free) {
    // Nodes at arena + 0x200 + i*0x40 for i in 0..2; stream at arena + 0x000.
    active_stream_va = 0u;
    active_tap_va = 0u;
    enter_mutates_lock = 0u;
    const U stream_va = address(arena);
    U nodes[3] = {stream_va + 0x200u, stream_va + 0x240u, stream_va + 0x280u};
    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        wr_va(stream_va + 0x4cu, nodes[head_idx]);
        wr_va(stream_va + 0x50u, nodes[active_idx]);
        wr_va(stream_va + 0x54u, nodes[tail_idx]);
        wr_va(stream_va + 0x58u, init_free);
        for (U i = 0u; i < 3u; ++i) {
            wr_va(nodes[i] + 0x04u, i + 1u);
            wr_va(nodes[i] + 0x08u, (i > head_idx) ? nodes[i - 1u] : 0u);
            wr_va(nodes[i] + 0x0cu, (i < tail_idx) ? nodes[i + 1u] : 0u);
        }
        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_request_unlink_0056bd10)
                        : reinterpret_cast<void*>(orig_56bd10);
        trace.abi_fail = invoke_2(fn, stream_va, nodes[target_idx]);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces(false);
}

