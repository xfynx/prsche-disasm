static void run_get_valid(
    U tap_id, U tap_rem, U lock_val, U cur_chunk_off,
    std::initializer_list<ChunkSpec> chunks,
    U mutate_lock = 0u, U next_lock = 0u) {
    const U stream_va = address(arena);
    const U tap_va = stream_va + 0x200u;
    const U ring_start = stream_va + 0x400u;
    active_stream_va = stream_va;
    active_tap_va = tap_va;
    enter_mutates_lock = mutate_lock;
    new_lock_value = next_lock;

    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        wr_va(stream_va + 0x00u, 0x4d525453u); // 'STRM'
        wr_va(stream_va + 0x04u, lock_val);
        wr_va(stream_va + 0x20u, ring_start);
        wr_va(tap_va + 0x00u, stream_va);
        wr_va(tap_va + 0x04u, tap_id);
        wr_va(tap_va + 0x08u, tap_rem);
        wr_va(tap_va + 0x0cu, ring_start + cur_chunk_off);
        for (const ChunkSpec& c : chunks) {
            wr_va(ring_start + c.off + 0x00u, c.word0);
            wr_va(ring_start + c.off + 0x04u, c.word4);
        }
        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_get_0056c540)
                        : reinterpret_cast<void*>(orig_56c540);
        trace.abi_fail = invoke_1(fn, tap_va);
        trace.ret = captured_return;
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces(true);
}

int main() {
    SetUnhandledExceptionFilter(fault_handler);

    // Check initial production state before any fixture writes.
    require(porsche::shared_runtime_word_005deb74 == 0u, "initial_005deb74");
    require(porsche::shared_runtime_word_005deb78 == 0u, "initial_005deb78");

    // Check exact .rdata bytes against raw PE before relocation.
    require(sizeof porsche::stream_err_get_invalid_handle_005bdd88 == sizeof raw_str_005bdd88 &&
            std::memcmp(porsche::stream_err_get_invalid_handle_005bdd88, raw_str_005bdd88, sizeof raw_str_005bdd88) == 0,
            "rdata_005bdd88");
    require(sizeof porsche::stream_source_file_005bd978 == sizeof raw_str_005bd978 &&
            std::memcmp(porsche::stream_source_file_005bd978, raw_str_005bd978, sizeof raw_str_005bd978) == 0,
            "rdata_005bd978");

    init_original_code();

    // 1. 0056bce0: ring-buffer interval membership [start, end).
    for (U ptr : {0u, 0x0fffu, 0x1000u, 0x1001u, 0x1fffu, 0x2000u, 0x2001u}) {
        run_ring_contains(0x1000u, 0x1000u, ptr);
        run_ring_contains(0x1000u, 0x2000u, ptr);
        run_ring_contains(0x2000u, 0x1000u, ptr);
    }
    for (U ptr : {0u, 0x7fffffefu, 0x7ffffff0u, 0x7fffffffu, 0x80000000u, 0x8000000fu, 0x80000010u, 0xffffffffu}) {
        run_ring_contains(0x7ffffff0u, 0x80000010u, ptr);
        run_ring_contains(0x80000010u, 0x7ffffff0u, ptr);
        run_ring_contains(0x80000000u, 0xffffffffu, ptr);
    }

    // 2. 0056bd10: unlink request node across head/tail/active combinations.
    run_unlink(0u, 0u, 0u, 0u, 0u);
    run_unlink(0u, 0u, 0u, 0u, 0xdead0001u);
    run_unlink(0u, 1u, 0u, 0u, 0x12345678u);
    run_unlink(0u, 1u, 1u, 0u, 0x12345678u);
    run_unlink(0u, 1u, 0u, 1u, 0x12345678u);
    run_unlink(0u, 1u, 1u, 1u, 0x12345678u);
    run_unlink(0u, 2u, 0u, 1u, 0xabcdef01u);
    run_unlink(0u, 2u, 1u, 1u, 0xabcdef01u);
    run_unlink(0u, 2u, 2u, 1u, 0xabcdef01u);
    run_unlink(0u, 2u, 2u, 2u, 0xabcdef01u);

    // 3. 0056c380: consume bytes, threshold crossing, greedy flag, and file op group callback.
    run_consume(0x20010001u, 100u, 50u, 49u, 1u, 7u, 0x33u, 0u);
    run_consume(0x20010001u, 100u, 50u, 50u, 1u, 7u, 0x33u, 0u); // next == threshold -> no trigger
    run_consume(0x20010001u, 100u, 50u, 51u, 1u, 7u, 0x33u, 0u); // crosses -> triggers + callback
    run_consume(0x20010001u, 50u, 50u, 1u, 1u, 9u, 0x44u, 0u);   // prev == threshold -> triggers + callback
    run_consume(0x20010001u, 49u, 50u, 1u, 1u, 9u, 0x44u, 0u);   // prev < threshold -> no trigger
    run_consume(0x20010001u, 50u, 50u, 1u, 0u, 9u, 0x44u, 0u);   // state28 != 1 -> sets 0x38=1, no callback
    run_consume(0x20010001u, 50u, 50u, 1u, 2u, 9u, 0x44u, 0u);   // state28 == 2 -> sets 0x38=1, no callback
    run_consume(0x20010001u, 0xffffffffu, 0u, 1u, 1u, 3u, 0x11u, 0u); // signed negative prev < 0 -> no trigger
    run_consume(0x20010001u, 5u, 0u, 10u, 1u, 3u, 0x11u, 0u);         // wraps negative -> triggers
    run_consume(0x20010001u, 0x80000005u, 0u, 10u, 1u, 3u, 0x11u, 0u); // signed < 0 -> no trigger
    run_consume(0x20010001u, 50u, 50u, 1u, 1u, 9u, 0x44u, 0u, 1u, 0x30020002u); // caches lock before enter

    // 4. 0056c3e0: request lookup across bounds, id match, status, and stride.
    run_lookup(0u, 0u, 0u, 1u);
    run_lookup(0xffffffffu, 0u, 0u, 1u);
    run_lookup(0x80000000u, 0u, 0u, 1u);
    run_lookup(4u, 4u, 4u, 1u);
    run_lookup(4u, 0x00010004u, 0x00010004u, 1u);
    run_lookup(4u, 0x00010001u, 0x00010002u, 1u);
    run_lookup(4u, 0x00010001u, 0x00010001u, 0u);
    run_lookup(4u, 0x00010001u, 0x00010001u, 1u);
    run_lookup(4u, 0x00010001u, 0x00010001u, 0x80000000u);
    run_lookup(20u, 0x0000000fu, 0x0000000fu, 2u);
    run_lookup(26u, 0xdead0101u, 0xdead0101u, 4u); // req_id > 255 masked to idx 1
    run_lookup(26u, 0xdead0019u, 0xdead0019u, 4u);

    // 5. 0056c540: STREAM_get invalid handles, empty tap, draining, immediate next, skip, and wrap sentinel.
    run_get_invalid(0u, 0x4d525453u);
    run_get_invalid(1u, 0x00000000u);
    run_get_invalid(1u, 0x4d525452u);

    run_get_valid(1u, 0u, 0x40010001u, 0u, {{0u, 0x11111111u, (1u << 24u) | 32u}});
    run_get_valid(1u, 32u, 0x40010001u, 0u, {
        {0u, 0x11111111u, (1u << 24u) | 32u},
        {32u, 0x22222222u, (1u << 24u) | 32u},
    }); // rem == 0
    run_get_valid(1u, 16u, 0x40010001u, 0u, {{0u, 0x11111111u, (0xffu << 24u) | 32u}}); // rem < 0, clear 0xff
    run_get_valid(2u, 64u, 0x40010001u, 0u, {
        {0u, 0xaaaaaaaau, (2u << 24u) | 32u},
        {32u, 0xbbbbbbbbu, (2u << 24u) | 32u},
    }); // immediate next match
    run_get_valid(3u, 64u, 0x40010001u, 0u, {
        {0u, 0xaaaaaaaau, (3u << 24u) | 32u},
        {32u, 0x11111111u, (1u << 24u) | 24u},
        {56u, 0x22222222u, (5u << 24u) | 16u},
        {72u, 0x33333333u, (3u << 24u) | 32u},
    }); // skips 2 chunks
    run_get_valid(4u, 100u, 0x40010001u, 64u, {
        {64u, 0xaaaaaaaau, (4u << 24u) | 32u},
        {96u, 0x11111111u, (2u << 24u) | 20u},
        {116u, 0xffffffffu, (7u << 24u) | 12u}, // wrap sentinel
        {128u, 0x44444444u, (4u << 24u) | 16u}, // fallthrough target if sentinel missed
        {0u, 0x22222222u, (1u << 24u) | 16u},
        {16u, 0x33333333u, (4u << 24u) | 40u},
    }); // skips, wraps at -1 to ring_start, skips, matches
    run_get_valid(0x105u, 64u, 0x40010001u, 0u, {
        {0u, 0xaaaaaaaau, (5u << 24u) | 32u},
        {32u, 0xbbbbbbbbu, (5u << 24u) | 32u},
    }, 1u, 0x50050005u); // tap_id > 255 (shl 24) + re-read lock on leave

    std::printf("audio_stream_codec_leaves_original_x86_vs_cpp=PASS cases=%u events=%u\n", cases, events_total);
    return 0;
}
