// Synthetic cdecl1/2 callsite; the original callee retains rawC3 ABI.
static U invoke(void* fn,U a,U b,U argc){
    U before,saved_frame,result,fail=0;
    __asm{
        push ebx
        push esi
        push edi
        mov before,esp
        mov saved_frame,ebp
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,10203040h
        cmp argc,2
        jne one
        push b
    one:
        push a
        call fn
        mov result,eax
        mov ecx,argc
        shl ecx,2
        add esp,ecx
        cmp esp,before
        jne bad
        cmp ebp,saved_frame
        jne bad
        cmp ebx,13579bdfh
        jne bad
        cmp esi,2468ace0h
        jne bad
        cmp edi,10203040h
        je done
    bad:
        mov fail,1
    done:
        mov esp,before
        pop edi
        pop esi
        pop ebx
    }
    trace.abi|=fail;return result;
}
