using Byte=unsigned char;
using Word=std::uint32_t;
float _DAT_005b24a8=1.0f;
const float half=0.5f, scale=150.0f;
const double half_wide=0.5;
const Byte parent_bytes[]={@BODY_004581A0@}, child_bytes[]={@BODY_004583F0@};
const Byte zero_bytes[]={@BODY_004580E0@}, ftol_bytes[]={@BODY_005A0F98@};
const void* zero_original;
const void* ftol_original;
unsigned calls,cases;
Word seed;
namespace porsche {
__declspec(naked) void __fastcall scene_splt_zero_tables_004580e0(void*,void*) {
    __asm { jmp dword ptr [zero_original] }
}
__declspec(naked) std::int64_t __cdecl audio_stream_ftol_005a0f98() {
    __asm { jmp dword ptr [ftol_original] }
}
float __cdecl rand_unit_005561d0(){
    ++calls;
    seed=seed*1664525u+1013904223u;
    return static_cast<float>(seed>>16)/65536.0f;
