static U invoke_cdecl_1_void(const void* fn, U a0) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        push a0
        mov eax, fn
        call eax
        add esp, 4
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_esp1
        mov esp, esp_before
        or abi_fail, 1
    ok_esp1:
        cmp ebx, 0x13572468
        je ok_ebx1
        or abi_fail, 2
    ok_ebx1:
        cmp esi, 0x24681357
        je ok_esi1
        or abi_fail, 4
    ok_esi1:
        cmp edi, 0x55aa33cc
        je ok_edi1
        or abi_fail, 8
    ok_edi1:
        pop edi
        pop esi
        pop ebx
    }
    return abi_fail;
}

static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_open_null = false;
    std::memset(g_events, 0, sizeof g_events);
    porsche::install_paths_table_0065b2a0[6u] = g_install_prefix;
    std::memset(&porsche::application_state_006573e8, 0,
                sizeof porsche::application_state_006573e8);
    porsche::scene_route_spec_index_00628a18 = static_cast<I>(0x11110000u + seed);
    porsche::scene_route_spec_last_index_00628b28 = static_cast<I>(0x22220000u + seed);
    porsche::scene_route_spec_count_00628b2c = static_cast<I>(0x33330000u + seed);
    porsche::startup_night_shape_enabled_00628a28 = 0x5a5au;
    for (U i = 0u; i < 0x108u; ++i) {
        const B pattern = static_cast<B>((0xa0u + seed + i * 7u) & 0xffu);
        porsche::scene_route_track_spec_00628a20[i] = pattern;
        g_custom_spec_buf[i] = static_cast<B>(pattern ^ 0x33u);
    }
    std::memset(g_spec_file_buf, 0, sizeof g_spec_file_buf);
}

static void populate_spec_file(I count) {
    store32(g_spec_file_buf, 0x00u, 0x53504543u);
    store32(g_spec_file_buf, 0x04u, static_cast<U>(count));
    for (U entry_idx = 0u; entry_idx < 4u; ++entry_idx) {
        B* const dst = g_spec_file_buf + 8u + entry_idx * 0x108u;
        for (U b = 0u; b < 0x108u; ++b) {
            dst[b] = static_cast<B>((0x10u + entry_idx * 37u + b * 13u) & 0xffu);
        }
    }
    // Entry 0: positive small fields at +0x02 and +0x08
    store16(g_spec_file_buf + 8u, 0x02u, 0x0015u);
    store16(g_spec_file_buf + 8u, 0x08u, 0x0001u);
    // Entry 1: negative int16 fields to verify MOVSX sign extension
    store16(g_spec_file_buf + 8u + 0x108u, 0x02u, 0xfffdu);
    store16(g_spec_file_buf + 8u + 0x108u, 0x08u, 0x8001u);
    // Entry 2: zero night flag and boundary int16 max
    store16(g_spec_file_buf + 8u + 2u * 0x108u, 0x02u, 0x7fffu);
    store16(g_spec_file_buf + 8u + 2u * 0x108u, 0x08u, 0x0000u);
}

static void capture(Snapshot& out, U abi_fail) {
    out.abi_fail = abi_fail;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    out.spec_index = porsche::scene_route_spec_index_00628a18;
    out.spec_last_index = porsche::scene_route_spec_last_index_00628b28;
    out.spec_count = porsche::scene_route_spec_count_00628b2c;
    std::memcpy(out.track_spec.data(), porsche::scene_route_track_spec_00628a20, 0x108u);
    std::memcpy(out.custom_spec.data(), g_custom_spec_buf, 0x108u);
    out.app_7a24 = porsche::application_state_006573e8.word(0x00657a24u);
    out.app_7a30 = porsche::application_state_006573e8.word(0x00657a30u);
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c,
                tag);
    }
    require(orig.spec_index == cpp.spec_index, tag);
    require(orig.spec_last_index == cpp.spec_last_index, tag);
    require(orig.spec_count == cpp.spec_count, tag);
    require(orig.track_spec == cpp.track_spec, tag);
    require(orig.custom_spec == cpp.custom_spec, tag);
    require(orig.app_7a24 == cpp.app_7a24, tag);
    require(orig.app_7a30 == cpp.app_7a30, tag);
    ++cases;
}

template <class Setup>
static void run_default_case(void* target, Setup&& setup, const char* tag) {
    Snapshot orig{}, cpp{};
    reset_fixtures(3u);
    setup();
    U f0 = invoke_cdecl_1_void(slot_00475a60, address(target));
    capture(orig, f0);
    reset_fixtures(3u);
    setup();
    U f1 = invoke_cdecl_1_void(
        reinterpret_cast<const void*>(&porsche::scene_route_track_spec_default_00475a60),
        address(target));
    capture(cpp, f1);
    if (target == porsche::scene_route_track_spec_00628a20) {
        require(porsche::startup_night_shape_enabled_00628a28 ==
                    load16(porsche::scene_route_track_spec_00628a20, 0x08u),
                "night sync default");
    }
    check_equal(orig, cpp, tag);
}

template <class Setup>
static void run_spec_load_case(U value, Setup&& setup, bool expect_sync, const char* tag) {
    Snapshot orig{}, cpp{};
    reset_fixtures(5u);
    setup();
    U f0 = invoke_cdecl_1_void(slot_00475c80, value);
    capture(orig, f0);
    reset_fixtures(5u);
    setup();
    U f1 = invoke_cdecl_1_void(
        reinterpret_cast<const void*>(&porsche::scene_route_dispatch_00475c80),
        value);
    capture(cpp, f1);
    if (expect_sync) {
        require(porsche::startup_night_shape_enabled_00628a28 ==
                    load16(porsche::scene_route_track_spec_00628a20, 0x08u),
                "night sync load");
    }
    check_equal(orig, cpp, tag);
}

int main() {
    init();

    // 1. Direct 00475a60 default track spec builder (multiple 00657a24/00657a30 inputs and targets)
    for (U a24 : {0u, 3u, 0xffffu}) {
        for (U a30 : {0u, 1u, 0x1234u}) {
            run_default_case(g_custom_spec_buf, [=]() {
                porsche::application_state_006573e8.word(0x00657a24u) = a24;
                porsche::application_state_006573e8.word(0x00657a30u) = a30;
            }, "default custom");
        }
    }
    run_default_case(porsche::scene_route_track_spec_00628a20, []() {
        porsche::application_state_006573e8.word(0x00657a24u) = 7u;
        porsche::application_state_006573e8.word(0x00657a30u) = 1u;
    }, "default global");

    // 2. 00475c80 open failure
    run_spec_load_case(0u, []() {
        g_open_null = true;
    }, false, "open null");

    // 3. 00475c80 out-of-range fallback (index >= count)
    for (U idx : {0u, 3u, 5u}) {
        run_spec_load_case(idx, [=]() {
            populate_spec_file(idx == 0u ? 0 : 3);
            porsche::application_state_006573e8.word(0x00657a24u) = 9u;
            porsche::application_state_006573e8.word(0x00657a30u) = 1u;
        }, true, "out of range");
    }

    // 4. 00475c80 valid spec indices (including negative int16 sign extension)
    for (U idx : {0u, 1u, 2u}) {
        run_spec_load_case(idx, []() {
            populate_spec_file(3);
        }, true, "valid spec");
    }

    std::printf("scene_route_spec_795_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
