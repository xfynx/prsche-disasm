std::uint32_t& ApplicationStateArena::word(std::uint32_t va) {
    return words_[(va - application_state_base_va) / 4u];
}

std::int32_t __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 64u, format, args);
    va_end(args);
    record_event(kEvFormat, fnv1a(format), fnv1a(output));
    return n;
}

void* __cdecl resource_open_quiet_0059d9b0(const char* name, std::uint32_t flags) {
    record_event(kEvOpen, fnv1a(name), flags);
    return g_open_null ? nullptr : g_spec_file_buf;
}

int __cdecl formatter_stdio_printf_005a177b(const char* format, ...) {
    U pct_count = 0u;
    for (const char* p = format; *p != '\0'; ++p) {
        if (*p == '%') {
            ++pct_count;
        }
    }
    va_list args;
    va_start(args, format);
    const U a1 = (pct_count >= 1u) ? va_arg(args, U) : 0u;
    const U a2 = (pct_count >= 2u) ? va_arg(args, U) : 0u;
    va_end(args);
    record_event(kEvPrintf, fnv1a(format), a1, a2);
    return 1;
}

std::uint32_t __cdecl free_00531f90(void* block) {
    record_event(kEvFree, address(block));
    return 1u;
}

