    relocate_call_rel32(slot_00475c80, 0x00475c80u, 0x08au, 0x005a177bu,
                        reinterpret_cast<const void*>(&porsche::formatter_stdio_printf_005a177b));
    relocate_imm32(slot_00475c80, 0x09bu, 0x00628a20u,
