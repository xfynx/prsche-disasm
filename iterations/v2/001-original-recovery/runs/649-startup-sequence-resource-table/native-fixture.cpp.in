    // Assert production initial .data state before any fixture reset.
    require(porsche::startup_night_shape_enabled_00628a28 == 0u, "initial .data 00628a28");
    require(porsche::startup_resource_prefix_0065b30c == nullptr, "initial .data 0065b30c");
    require(porsche::startup_night_shape_buffer_0061c164 == nullptr, "initial .data 0061c164");
    require(porsche::startup_night_shape_data_0061e1cc == nullptr, "initial .data 0061e1cc");
    require(porsche::startup_context_table_owner_00613e04 == nullptr, "initial .data 00613e04");
    require(porsche::startup_head_state_a_0061bcc8 == 0u, "initial .data 0061bcc8");
    require(porsche::startup_head_state_b_0061e180 == 0u, "initial .data 0061e180");
    require(porsche::startup_head_table_entry_0061e1d4 == nullptr, "initial .data 0061e1d4");
    require(porsche::startup_sequence_flag_00619760 == 0u, "initial .data 00619760");

    static const B body_561e00[] = {@BODY_00561E00@};
    static const B body_59d9b0[] = {@BODY_0059D9B0@};
    static const B body_452590[] = {@BODY_00452590@};
    static const B body_4690d0[] = {@BODY_004690D0@};
    require(sizeof body_561e00 == 63u, "63-byte original body 00561e00");
    require(sizeof body_59d9b0 == 206u, "206-byte original body 0059d9b0");
    require(sizeof body_452590 == 198u, "198-byte original body 00452590");
    require(sizeof body_4690d0 == 17u, "17-byte original body 004690d0");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                        PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "raw executable allocation");

    slot_561e00 = code;
    slot_59d9b0 = code + 0x100u;
    slot_452590 = code + 0x200u;
    slot_4690d0 = code + 0x300u;
    std::memcpy(slot_561e00, body_561e00, sizeof body_561e00);
    std::memcpy(slot_59d9b0, body_59d9b0, sizeof body_59d9b0);
    std::memcpy(slot_452590, body_452590, sizeof body_452590);
    std::memcpy(slot_4690d0, body_4690d0, sizeof body_4690d0);

    // Relocate 00561e00.
    relocate_abs32(slot_561e00, 0x011u, 0x005df770u,
                   address(&porsche::resource_leaf_group_005df770));
    relocate_abs32(slot_561e00, 0x032u, 0x00561ce0u,
                   address(reinterpret_cast<const void*>(&porsche::resource_open_callback_00561ce0)));
    relocate_rel32(slot_561e00, 0x00561e00u, 0x029u, 0x00568e90u,
                   reinterpret_cast<const void*>(&porsche::file_device_name_00568e90));
    relocate_rel32(slot_561e00, 0x00561e00u, 0x037u, 0x00568d50u,
                   reinterpret_cast<const void*>(&porsche::resource_leaf_atomic_dispatch_00568d50));

    // Relocate 0059d9b0.
    relocate_abs32(slot_59d9b0, 0x001u, 0x006af370u,
                   address(&porsche::file_roots_enabled_006af370));
    relocate_abs32(slot_59d9b0, 0x064u, 0x006af168u,
                   address(&porsche::file_root_006af168));
    relocate_abs32(slot_59d9b0, 0x069u, 0x005cc588u, address(orig_str_5cc588));
    relocate_abs32(slot_59d9b0, 0x085u, 0x006af26cu,
                   address(&porsche::file_fallback_006af26c));
    relocate_abs32(slot_59d9b0, 0x08fu, 0x006af26cu,
                   address(&porsche::file_fallback_006af26c));
    relocate_abs32(slot_59d9b0, 0x098u, 0x005cc588u, address(orig_str_5cc588));
    relocate_abs32(slot_59d9b0, 0x0b4u, 0x006afbe4u,
                   address(&porsche::missing_file_006afbe4));
    relocate_rel32(slot_59d9b0, 0x0059d9b0u, 0x048u, 0x00561e00u, slot_561e00);
    relocate_rel32(slot_59d9b0, 0x0059d9b0u, 0x06fu, 0x005a0fbfu,
                   reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_rel32(slot_59d9b0, 0x0059d9b0u, 0x079u, 0x00561b80u,
                   reinterpret_cast<const void*>(&porsche::file_exists_00561b80));
    relocate_rel32(slot_59d9b0, 0x0059d9b0u, 0x09eu, 0x005a0fbfu,
                   reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_rel32(slot_59d9b0, 0x0059d9b0u, 0x0a8u, 0x00561b80u,
                   reinterpret_cast<const void*>(&porsche::file_exists_00561b80));

    // Relocate 00452590.
    relocate_abs32(slot_452590, 0x009u, 0x00628a28u,
                   address(&porsche::startup_night_shape_enabled_00628a28));
    relocate_abs32(slot_452590, 0x015u, 0x0065b30cu,
                   address(&porsche::startup_resource_prefix_0065b30c));
    relocate_abs32(slot_452590, 0x020u, 0x005cec88u, address(orig_str_5cec88));
    relocate_abs32(slot_452590, 0x03eu, 0x005cec7cu, address(orig_str_5cec7c));
    relocate_abs32(slot_452590, 0x048u, 0x0061c164u,
                   address(&porsche::startup_night_shape_buffer_0061c164));
    relocate_abs32(slot_452590, 0x066u, 0x0061c164u,
                   address(&porsche::startup_night_shape_buffer_0061c164));
    relocate_abs32(slot_452590, 0x079u, 0x0061c164u,
                   address(&porsche::startup_night_shape_buffer_0061c164));
    relocate_abs32(slot_452590, 0x07eu, 0x005cec74u, address(orig_str_5cec74));
    relocate_abs32(slot_452590, 0x08fu, 0x0061e1ccu,
                   address(&porsche::startup_night_shape_data_0061e1cc));
    relocate_abs32(slot_452590, 0x096u, 0x00613e04u,
