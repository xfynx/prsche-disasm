    relocate_rel32(slot_4690d0, 0x004690d0u, 0x001u, 0x00452590u, slot_452590);
    relocate_rel32(slot_4690d0, 0x004690d0u, 0x00du, 0x0047f040u,
                   reinterpret_cast<const void*>(&porsche::startup_context_table_init_0047f040));
