struct CaseEnv {
    U group;
    U atomic_ret;
    bool roots_enabled;
    const char* root_path;
    const char* fallback_path;
    U exists_mask;
    bool mutate_missing;
    void(__cdecl* missing_cb)(const char*, std::int32_t);
    std::uint16_t night_enabled;
    const char* prefix;
    U pred_size_0;
    U pred_size_1;
    bool null_shape_entry;
    void* owner;
    U state_a_seed;
    U state_b_seed;
    U lookup_ret;
    B seq_flag_seed;
};

static void setup_env(const CaseEnv& c) {
    std::memset(&trace, 0, sizeof trace);
    std::memset(loaded_arena, 0x5au, sizeof loaded_arena);
    for (U i = 0u; i < sizeof(loaded_arena); ++i) {
        loaded_arena[i] = static_cast<B>(i ^ 0x3cu);
    }
    std::memset(shape_arena, 0xa5u, sizeof shape_arena);
    std::memset(context_owner_arena, 0x11u, sizeof context_owner_arena);
    std::memset(head_entry_arena, 0x22u, sizeof head_entry_arena);

    porsche::resource_leaf_group_005df770 = c.group;
    porsche::file_roots_enabled_006af370 = c.roots_enabled ? 1 : 0;
    std::memset(porsche::file_root_006af168, 0, sizeof porsche::file_root_006af168);
    std::memset(porsche::file_fallback_006af26c, 0, sizeof porsche::file_fallback_006af26c);
    if (c.root_path != nullptr) {
        std::snprintf(porsche::file_root_006af168, sizeof porsche::file_root_006af168, "%s", c.root_path);
    }
    if (c.fallback_path != nullptr) {
        std::snprintf(porsche::file_fallback_006af26c, sizeof porsche::file_fallback_006af26c, "%s", c.fallback_path);
    }
    porsche::missing_file_006afbe4 = c.missing_cb;

    porsche::startup_night_shape_enabled_00628a28 = c.night_enabled;
    porsche::startup_resource_prefix_0065b30c = c.prefix;
    porsche::startup_night_shape_buffer_0061c164 = reinterpret_cast<void*>(0xdead0001u);
    porsche::startup_night_shape_data_0061e1cc = reinterpret_cast<void*>(0xdead0002u);
    porsche::startup_context_table_owner_00613e04 = c.owner;
    porsche::startup_head_state_a_0061bcc8 = c.state_a_seed;
    porsche::startup_head_state_b_0061e180 = c.state_b_seed;
    porsche::startup_head_table_entry_0061e1d4 = reinterpret_cast<void*>(0xdead0003u);
    porsche::startup_sequence_flag_00619760 = c.seq_flag_seed;

    stub_cfg = {};
    stub_cfg.group = c.group;
    stub_cfg.atomic_ret = c.atomic_ret;
    stub_cfg.exists_mask = c.exists_mask;
    stub_cfg.mutate_missing_on_exists = c.mutate_missing;
    stub_cfg.pred_seq = 0u;
    stub_cfg.pred_sizes[0] = c.pred_size_0;
    stub_cfg.pred_sizes[1] = c.pred_size_1;
    stub_cfg.null_shape_entry = c.null_shape_entry;
    stub_cfg.lookup_ret = c.lookup_ret;
}

static void capture_state() {
    std::memcpy(trace.final_shape, shape_arena, sizeof trace.final_shape);
    trace.final_enabled = porsche::startup_night_shape_enabled_00628a28;
    trace.final_buffer = normalize_ptr(address(porsche::startup_night_shape_buffer_0061c164));
    trace.final_data = normalize_ptr(address(porsche::startup_night_shape_data_0061e1cc));
    trace.final_state_a = porsche::startup_head_state_a_0061bcc8;
    trace.final_state_b = porsche::startup_head_state_b_0061e180;
    trace.final_head_entry = normalize_ptr(address(porsche::startup_head_table_entry_0061e1d4));
    trace.final_seq_flag = porsche::startup_sequence_flag_00619760;
    trace.final_missing_cb = normalize_missing_cb(porsche::missing_file_006afbe4);
}

static void compare_traces() {
    require(trace.abi_fail == 0u, "original ABI");
    require(expected.abi_fail == 0u, "recovered ABI");
    require(trace.ret_eax == expected.ret_eax, "return value");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "event tag");
        require(trace.events[i].a0 == expected.events[i].a0, "event a0");
        require(trace.events[i].a1 == expected.events[i].a1, "event a1");
        require(trace.events[i].a2 == expected.events[i].a2, "event a2");
        require(trace.events[i].a3 == expected.events[i].a3, "event a3");
        require(std::strcmp(trace.events[i].text, expected.events[i].text) == 0, "event text");
    }
    require(std::memcmp(trace.final_shape, expected.final_shape, sizeof trace.final_shape) == 0,
            "shape memory");
    require(trace.final_enabled == expected.final_enabled, "00628a28");
    require(trace.final_buffer == expected.final_buffer, "0061c164");
    require(trace.final_data == expected.final_data, "0061e1cc");
    require(trace.final_state_a == expected.final_state_a, "0061bcc8");
    require(trace.final_state_b == expected.final_state_b, "0061e180");
    require(trace.final_head_entry == expected.final_head_entry, "0061e1d4");
    require(trace.final_seq_flag == expected.final_seq_flag, "00619760");
    require(trace.final_missing_cb == expected.final_missing_cb, "006afbe4");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof trace.fpu) == 0, "FPU state");
    ++cases;
}

static void check_561e00(const CaseEnv& c, const char* path, U flags) {
    setup_env(c);
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl2(slot_561e00, address(path), flags, eax_orig);
    trace.ret_eax = normalize_ptr(eax_orig);
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::file_open_quiet_00561e00), address(path), flags, eax_cpp);
    trace.ret_eax = normalize_ptr(eax_cpp);
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

static void check_59d9b0(const CaseEnv& c, const char* name, U flags) {
    setup_env(c);
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl2(slot_59d9b0, address(name), flags, eax_orig);
    trace.ret_eax = normalize_ptr(eax_orig);
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::resource_open_quiet_0059d9b0), address(name), flags, eax_cpp);
    trace.ret_eax = normalize_ptr(eax_cpp);
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

static void check_452590(const CaseEnv& c) {
    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(slot_452590);
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(
        reinterpret_cast<void*>(&porsche::startup_sequence_resource_table_setup_00452590));
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

static void check_4690d0(const CaseEnv& c) {
    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(slot_4690d0);
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(
        reinterpret_cast<void*>(&porsche::startup_sequence_call_004690d0));
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

int main() {
    init();

    // 1. Direct 00561e00 coverage: varied paths, flags, group values, return bits.
    const U groups[] = {0u, 1u, 0x64u, 0x12345678u};
    const U flags_list[] = {0u, 1u, 0x10u, 0xffffffffu};
    const char* paths[] = {"", "a", "data\\night.psh", "P:\\art\\sky.fsh"};
    for (U g : groups) {
        for (U fl : flags_list) {
            CaseEnv c{};
            c.group = g;
            c.atomic_ret = (fl == 0u) ? 0u : address(loaded_arena);
            check_561e00(c, paths[(g + fl) & 3u], fl);
        }
    }

    // 2. Direct 0059d9b0 coverage: unrooted, primary hit, fallback hit, empty fallback,
    //    both miss with/without missing_file_006afbe4, mid-call mutation of 006afbe4.
    {
        // Unrooted (exercises 0..3 remainder bytes in rep movsb).
        const char* names[] = {"", "a", "ab", "abc", "abcd", "night.psh", "art\\tracks\\night.psh"};
        for (const char* nm : names) {
            CaseEnv c{};
            c.group = 0x64u;
            c.atomic_ret = address(loaded_arena);
            c.roots_enabled = false;
            check_59d9b0(c, nm, 0x42u);
        }

        // Rooted: primary hit, fallback hit, both miss + callback, empty fallback, null callback, mutated callback.
        const U masks[] = {0u, 1u, 2u, 3u};
        for (U mask : masks) {
            for (const char* fb : {"", "F:\\"}) {
                for (bool mutate : {false, true}) {
                    for (auto cb : {static_cast<void(__cdecl*)(const char*, std::int32_t)>(nullptr), &fixture_missing_a}) {
                        CaseEnv c{};
                        c.group = 0x77u;
                        c.atomic_ret = address(loaded_arena);
                        c.roots_enabled = true;
                        c.root_path = "P:\\";
                        c.fallback_path = fb;
                        c.exists_mask = mask;
                        c.mutate_missing = mutate;
                        c.missing_cb = cb;
                        check_59d9b0(c, "night.psh", 0x15u);
                    }
                }
            }
        }
    }

    // 3. Direct 00452590 coverage: night_enabled == 0 vs != 0, rooted/unrooted, entry non-null/null,
    //    distinct pred_size_0 vs pred_size_1, seeded state_a/state_b, lookup_ret null vs non-null.
    for (std::uint16_t night : {std::uint16_t(0u), std::uint16_t(1u), std::uint16_t(0x8001u)}) {
        for (bool rooted : {false, true}) {
            for (bool null_entry : {false, true}) {
                CaseEnv c{};
                c.group = 0x64u;
                c.atomic_ret = address(loaded_arena);
                c.roots_enabled = rooted;
                c.root_path = "P:\\";
                c.fallback_path = "F:\\";
                c.exists_mask = rooted ? 2u : 4u; // exercise fallback when rooted
                c.missing_cb = &fixture_missing_a;
                c.night_enabled = night;
                c.prefix = "art\\";
                c.pred_size_0 = 64u;
                c.pred_size_1 = 48u;
                c.null_shape_entry = null_entry;
                c.owner = context_owner_arena;
                c.state_a_seed = 0x11223344u;
                c.state_b_seed = 0x55667788u;
                c.lookup_ret = null_entry ? 0u : address(head_entry_arena);
                c.seq_flag_seed = 0u;
                check_452590(c);
            }
        }
    }

    // 4. End-to-end 004690d0 call chain coverage (004690d0 -> 00452590 -> 0059d9b0 -> 00561e00 + 0047f040).
    for (std::uint16_t night : {std::uint16_t(0u), std::uint16_t(1u)}) {
        for (B flag_seed : {B(0u), B(0x5au)}) {
            for (U mask : {1u, 2u}) {
                CaseEnv c{};
                c.group = 0x64u;
                c.atomic_ret = address(loaded_arena);
                c.roots_enabled = true;
                c.root_path = "P:\\";
                c.fallback_path = "F:\\";
                c.exists_mask = mask;
                c.night_enabled = night;
                c.prefix = "fe\\";
                c.pred_size_0 = 96u;
                c.pred_size_1 = 80u;
                c.null_shape_entry = false;
                c.owner = context_owner_arena;
                c.state_a_seed = 0xaabbccddu;
                c.state_b_seed = 0xeeff0011u;
                c.lookup_ret = address(head_entry_arena);
                c.seq_flag_seed = flag_seed;
                check_4690d0(c);
            }
        }
    }

    std::printf("startup_sequence_resource_table_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
