    relocate_abs32(slot_452590, 0x0adu, 0x0061e180u,
                   address(&porsche::startup_head_state_b_0061e180));
    relocate_abs32(slot_452590, 0x0bbu, 0x0061e1d4u,
                   address(&porsche::startup_head_table_entry_0061e1d4));
    relocate_rel32(slot_452590, 0x00452590u, 0x026u, 0x005a0fbfu,
                   reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_rel32(slot_452590, 0x00452590u, 0x035u, 0x0059dd00u,
