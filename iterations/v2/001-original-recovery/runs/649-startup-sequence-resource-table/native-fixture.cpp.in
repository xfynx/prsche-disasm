std::int32_t __cdecl resource_open_callback_00561ce0(std::uint32_t group, void* context) {
    (void)group;
    (void)context;
    return 0;
}

std::uint32_t __cdecl file_device_name_00568e90(const char* path) {
    U dev = 0x10u;
    if (path != nullptr) {
        for (const char* p = path; *p != '\0'; ++p) {
            dev = dev * 33u + static_cast<B>(*p);
        }
    }
    push_event(kEvDevice, dev, 0u, 0u, 0u, path);
    return dev;
}

std::int32_t __cdecl resource_leaf_atomic_dispatch_00568d50(
    ResourceLeafAtomicCallback callback,
    std::uint32_t device,
    std::uint32_t group,
    void* opaque_context) {
    const auto* ctx = static_cast<const ResourceAtomicContext*>(opaque_context);
    const U cb_ok = (callback == &resource_open_callback_00561ce0) ? 1u : 0u;
    push_event(kEvAtomic, cb_ok, device, group,
               ctx != nullptr ? ctx->opaque_08 : 0xdeadbeefu,
               ctx != nullptr ? ctx->path : nullptr);
    trace.events[trace.count - 1u].a3 =
        (ctx != nullptr ? ((ctx->opaque_08 & 0xffffu) | ((ctx->callback_diagnostic_flag & 0xffffu) << 16)) : 0u);
    return static_cast<std::int32_t>(stub_cfg.atomic_ret);
}

std::int32_t __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 256u, format, args);
    va_end(args);
    push_event(kEvFormat, 0u, 0u, 0u, 0u, output);
    return static_cast<std::int32_t>(n);
}

std::int32_t __cdecl file_exists_00561b80(const char* path) {
    std::int32_t hit = 0;
    if (path != nullptr) {
        if (std::strncmp(path, "P:\\", 3) == 0 && (stub_cfg.exists_mask & 1u) != 0u) {
            hit = 1;
        } else if (std::strncmp(path, "F:\\", 3) == 0 && (stub_cfg.exists_mask & 2u) != 0u) {
            hit = 1;
        } else if ((stub_cfg.exists_mask & 4u) != 0u) {
            hit = 1;
        }
    }
    if (stub_cfg.mutate_missing_on_exists) {
        missing_file_006afbe4 = &fixture_missing_b;
    }
    push_event(kEvExists, static_cast<U>(hit), 0u, 0u, 0u, path);
    return hit;
}

std::int32_t __cdecl resource_predicate_0059dd00(const char* path) {
    const U idx = stub_cfg.pred_seq & 1u;
    stub_cfg.pred_seq++;
    const U sz = stub_cfg.pred_sizes[idx];
    push_event(kEvPredicate, idx, sz, 0u, 0u, path);
    return static_cast<std::int32_t>(sz);
}

void* __cdecl allocate_00531ca0(const char* tag, std::int32_t size, std::uint32_t flags) {
    push_event(kEvAlloc, static_cast<U>(size), flags, 0u, 0u, tag);
    return static_cast<void*>(shape_arena);
}

void __cdecl render_copy_bytes_005563b0(const void* src, void* dst, std::uint32_t size) {
    push_event(kEvCopyBytes, normalize_ptr(address(src)), normalize_ptr(address(dst)), size, 0u);
    if (src != nullptr && dst != nullptr && size <= sizeof(shape_arena)) {
        std::memcpy(dst, src, size);
    }
}

std::uint32_t __cdecl free_00531f90(void* block) {
    push_event(kEvFree, normalize_ptr(address(block)), 0u, 0u, 0u);
    return 1u;
}

void* __cdecl shape_find_entry_0053c640(const void* shape, const void* tag) {
    const U tag_word = (tag != nullptr) ? word(tag, 0u) : 0u;
    push_event(kEvShapeFind, normalize_ptr(address(shape)), tag_word, 0u, 0u,
               static_cast<const char*>(tag));
    if (stub_cfg.null_shape_entry) {
        return nullptr;
    }
    return static_cast<void*>(shape_arena + 0x20u);
}

void* __fastcall startup_context_table_lookup_0044d320(
    void* self, void* unused_edx, std::uint32_t key0, std::uint32_t key1) {
    (void)unused_edx;
    push_event(kEvTableLookup,
               normalize_ptr(address(self)),
               key0,
               key1,
               (startup_head_state_a_0061bcc8 & 0xffffu) | ((startup_head_state_b_0061e180 & 0xffffu) << 16));
    return reinterpret_cast<void*>(static_cast<std::uintptr_t>(stub_cfg.lookup_ret));
}

void __cdecl startup_context_table_init_0047f040() {
    push_event(kEvTableInit, static_cast<U>(startup_sequence_flag_00619760), 0u, 0u, 0u);
}

