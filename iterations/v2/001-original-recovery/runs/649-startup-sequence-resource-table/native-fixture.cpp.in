static B shape_arena[0x100] = {};
static B context_owner_arena[0x40] = {};
static B head_entry_arena[0x20] = {};

enum EventTag : U {
    kEvDevice = 1u,
    kEvAtomic = 2u,
    kEvFormat = 3u,
    kEvExists = 4u,
    kEvMissing = 5u,
    kEvPredicate = 6u,
    kEvAlloc = 7u,
    kEvCopyBytes = 8u,
    kEvFree = 9u,
    kEvShapeFind = 10u,
    kEvTableLookup = 11u,
    kEvTableInit = 12u,
};

struct Event {
    U tag;
    U a0;
    U a1;
    U a2;
    U a3;
    char text[128];
};

struct Fpu {
    unsigned short control, status;
    B tag, padding[3], values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U count;
    Event events[24];
    B final_shape[0x100];
    U final_enabled;
    U final_buffer;
    U final_data;
    U final_state_a;
    U final_state_b;
    U final_head_entry;
    U final_seq_flag;
    U final_missing_cb;
    Fpu fpu;
};

static Trace trace{};
static Trace expected{};

struct StubCfg {
    U group;
    U atomic_ret;
    U exists_mask; // bit 0: primary root match, bit 1: fallback match, bit 2: unrooted match
    bool mutate_missing_on_exists;
    U pred_seq;
    U pred_sizes[2];
    bool null_shape_entry;
    U lookup_ret;
};

static StubCfg stub_cfg{};

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_ptr(U p) {
    if (p == 0u) return 0u;
    if (p >= address(loaded_arena) && p < address(loaded_arena) + sizeof(loaded_arena)) {
        return 0xa1000000u + (p - address(loaded_arena));
    }
    if (p >= address(shape_arena) && p < address(shape_arena) + sizeof(shape_arena)) {
        return 0xa2000000u + (p - address(shape_arena));
    }
    if (p == address(context_owner_arena)) return 0xa3000000u;
    if (p == address(head_entry_arena)) return 0xa4000000u;
    if (p < 0x1000u) return p; // e.g. nullptr + 0x10
    return p;
}

static void copy_text(char* dst, std::size_t cap, const char* src) {
    if (src == nullptr) {
        std::snprintf(dst, cap, "<null>");
        return;
    }
    std::snprintf(dst, cap, "%s", src);
}

static Event& push_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u, const char* text = nullptr) {
    require(trace.count < 24u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    if (text != nullptr) {
        copy_text(e.text, sizeof(e.text), text);
    }
    return e;
}

static void __cdecl fixture_missing_a(const char* name, std::int32_t code_arg) {
    push_event(kEvMissing, 1u, static_cast<U>(code_arg), 0u, 0u, name);
}

static void __cdecl fixture_missing_b(const char* name, std::int32_t code_arg) {
    push_event(kEvMissing, 2u, static_cast<U>(code_arg), 0u, 0u, name);
}

static U normalize_missing_cb(void(__cdecl* cb)(const char*, std::int32_t)) {
    if (cb == nullptr) return 0u;
    if (cb == &fixture_missing_a) return 1u;
    if (cb == &fixture_missing_b) return 2u;
    return 0xffu;
}

