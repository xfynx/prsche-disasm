    static const B body_562300[] = {@BODY_00562300@};
    static const B body_59df70[] = {@BODY_0059DF70@};
    static const B body_4ae100[] = {@BODY_004AE100@};

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");

    slot_568b50 = code + 0x000u;
    slot_533d70 = code + 0x080u;
    slot_562100 = code + 0x100u;
    slot_562300 = code + 0x340u;
