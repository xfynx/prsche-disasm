static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_ptr(U p) {
    if (p == 0u) return 0u;
    if (p >= address(&op_arena) && p < address(&op_arena) + sizeof(op_arena)) {
        return 0xa0000000u + (p - address(&op_arena));
    }
    if (p >= address(io_buf_arena) && p < address(io_buf_arena) + sizeof(io_buf_arena)) {
        return 0xa1000000u + (p - address(io_buf_arena));
    }
    if (p >= address(io_ctx_arena) && p < address(io_ctx_arena) + sizeof(io_ctx_arena)) {
        return 0xa2000000u + (p - address(io_ctx_arena));
    }
    if (p >= address(alloc_slot0) && p < address(alloc_slot0) + sizeof(alloc_slot0)) {
        return 0xa3000000u + (p - address(alloc_slot0));
    }
    if (p >= address(alloc_slot1) && p < address(alloc_slot1) + sizeof(alloc_slot1)) {
        return 0xa4000000u + (p - address(alloc_slot1));
    }
    if (p >= address(query_root_arena) && p < address(query_root_arena) + sizeof(query_root_arena)) {
        return 0xa5000000u + (p - address(query_root_arena));
    }
    if (p >= address(music_buf_arena) && p < address(music_buf_arena) + sizeof(music_buf_arena)) {
        return 0xa6000000u + (p - address(music_buf_arena));
    }
    if (p >= address(str_arena) && p < address(str_arena) + sizeof(str_arena)) {
        return 0xa7000000u + (p - address(str_arena));
    }
    if (p >= address(mgr_arena) && p < address(mgr_arena) + sizeof(mgr_arena)) {
        return 0xa8000000u + (p - address(mgr_arena));
    }
    if (p >= address(lock_arena) && p < address(lock_arena) + sizeof(lock_arena)) {
        return 0xa9000000u + (p - address(lock_arena));
    }
    if (p >= address(fake_handle_a) && p < address(fake_handle_a) + sizeof(fake_handle_a)) {
        return 0xaa000000u + (p - address(fake_handle_a));
    }
    if (last_atomic_ctx != nullptr && p == address(last_atomic_ctx)) {
        return 0xab000000u;
    }
    return p;
}

static void copy_text(char* dst, std::size_t cap, const char* src) {
    if (src == nullptr) {
        std::snprintf(dst, cap, "<null>");
        return;
    }
    std::snprintf(dst, cap, "%s", src);
}

static void push_event(
    U tag,
    U a0 = 0u,
    U a1 = 0u,
    U a2 = 0u,
    U a3 = 0u,
    U a4 = 0u,
    const char* text = nullptr) {
    require(trace.count < 32u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    e.a4 = a4;
    if (text != nullptr) {
        copy_text(e.text, sizeof(e.text), text);
    }
}

