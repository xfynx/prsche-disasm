static void seed_fpu() {
    __asm {
        fninit
        fldpi
        fld1
        fldln2
        faddp st(1), st(0)
        fsave floating
        frstor floating
    }
}

static void capture_fpu(Fpu& fpu) {
    B raw[108]{};
    U mxcsr = 0u;
    __asm {
        fsave raw
        stmxcsr mxcsr
        frstor raw
    }
    fpu.control = static_cast<unsigned short>(raw[0] | (raw[1] << 8));
    fpu.status = static_cast<unsigned short>(raw[4] | (raw[5] << 8));
    fpu.full_tag = static_cast<unsigned short>(raw[8] | (raw[9] << 8));
    fpu.tag = 0;
    for (int i = 0; i < 8; ++i) {
        if (((fpu.full_tag >> (i * 2)) & 3) != 3) {
            fpu.tag |= static_cast<B>(1u << i);
        }
    }
    std::memcpy(fpu.values, raw + 28, 80);
    fpu.mxcsr = mxcsr & 0xffffffc0u;
}

static U invoke_cdecl2(void* fn, U a0, U a1, U& out_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 0x13572468
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        push a1
        push a0
        call fn
        add esp, 8
        mov eax_out, eax
        pushfd
        pop eax
        and eax, 0x400
        jne abi_bad
        cmp esp, before
        jne abi_bad
        cmp ebp, frame
        jne abi_bad
        cmp ebx, 0x13572468
        jne abi_bad
        cmp esi, 0x2468ace0
        jne abi_bad
        cmp edi, 0x10203040
        je abi_ok
    abi_bad:
        mov fail, 1
    abi_ok:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    out_eax = eax_out;
    return fail;
}

