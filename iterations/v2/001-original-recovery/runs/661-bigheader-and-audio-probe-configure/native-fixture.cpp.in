int main() {
    // Verify production initial state BEFORE fixture resets.
    require(porsche::audio_probe_viv_prefix_0065b314 == nullptr, "initial 0065b314");
    require(std::memcmp(porsche::audio_probe_viv_fmt_005d1bf0, orig_str_5d1bf0, sizeof orig_str_5d1bf0) == 0, "005d1bf0");
    require(std::memcmp(porsche::audio_probe_buffer_name_005d1bfc, orig_str_5d1bfc, sizeof orig_str_5d1bfc) == 0, "005d1bfc");
    require(std::memcmp(porsche::audio_probe_globals_name_005d1c0c, orig_str_5d1c0c, sizeof orig_str_5d1c0c) == 0, "005d1c0c");
    require(std::memcmp(porsche::file_load_bigheader_open_err_005bcde4, orig_str_5bcde4, sizeof orig_str_5bcde4) == 0, "005bcde4");
    require(std::memcmp(porsche::file_load_bigheader_mem_err_005bce14, orig_str_5bce14, sizeof orig_str_5bce14) == 0, "005bce14");
    require(std::memcmp(porsche::file_load_bigheader_hdr_err_005bce50, orig_str_5bce50, sizeof orig_str_5bce50) == 0, "005bce50");

    load_originals();

    const CaseEnv base_env{
        {2u, 0x99887766u, false, false, 0x44332211u, true, address(fake_handle_a), 0u, 1u, 0x500u,
         false, false, 0x12345678u, false, 1u, false, 0x120u, 8u, "C:\\music\\zzz.viv", 0u, false, 0x40u},
        "R:\\", "F:\\", 0, nullptr, 0x64u, false, "audio/"
    };

    // 1. request_read_offset_00568b50
    check_568b50(base_env, fake_handle_a, 0x1234u, io_buf_arena, 0x200, 0x123400ffu, io_ctx_arena);
    check_568b50(base_env, fake_handle_a + 4, 0u, io_buf_arena + 8, -1, 0x01u, nullptr);

    // 2. file_read_offset_00533d70 (both stub-return and invoking reader -> 00568b50)
    check_533d70(base_env, fake_handle_a, 0x5500u, io_buf_arena, 0x800, 0x33u);
    {
        CaseEnv env = base_env;
        env.stub.invoke_reader_in_chunks = true;
        check_533d70(env, fake_handle_a, 0x6600u, io_buf_arena + 4, 0x400, 0x44u);
    }

    // 3. file_load_bigheader_callback_00562100
    // 3a. open fail (quiet & loud)
    {
        CaseEnv env = base_env;
        env.stub.open_ok = false;
        check_562100(env, 10u, "missing.viv", 1u, 0u);
        check_562100(env, 10u, "missing.viv", 1u, 1u);
    }
    // 3b. alloc 0xa90 fail (quiet & loud)
    {
        CaseEnv env = base_env;
        env.stub.alloc_fail_mask = 1u;
        check_562100(env, 10u, "oom1.viv", 2u, 0u);
        check_562100(env, 10u, "oom1.viv", 2u, 1u);
    }
    // 3c. invalid header kind == 0 (quiet & loud)
    {
        CaseEnv env = base_env;
        env.stub.audio_kind_ret = 0u;
        check_562100(env, 10u, "badhdr.viv", 3u, 0u);
        check_562100(env, 10u, "badhdr.viv", 3u, 1u);
    }
    // 3d. size <= 0xa90 (0x500 and exact boundary 0xa90)
    {
        CaseEnv env = base_env;
        env.stub.audio_size_ret = 0x500u;
        check_562100(env, 10u, "small.viv", 4u, 1u);
        env.stub.audio_size_ret = 0xa90u;
        check_562100(env, 10u, "exact_a90.viv", 4u, 1u);
    }
    // 3e. size > 0xa90 (0xa91 and 0x1400) success + mutate ctx in open
    {
        CaseEnv env = base_env;
        env.stub.audio_size_ret = 0xa91u;
        check_562100(env, 10u, "grow_1.viv", 5u, 1u);
        env.stub.audio_size_ret = 0x1400u;
        env.stub.mutate_ctx_in_open = true;
        check_562100(env, 10u, "grow_big.viv", 5u, 1u);
    }
    // 3f. second alloc fail (quiet & loud)
    {
        CaseEnv env = base_env;
        env.stub.audio_size_ret = 0x1200u;
        env.stub.alloc_fail_mask = 2u;
        check_562100(env, 10u, "oom2.viv", 6u, 0u);
        check_562100(env, 10u, "oom2.viv", 6u, 1u);
    }

    // 4. file_load_bigheader_quiet_00562300
    check_562300(base_env, "header_a.viv", 0u);
    {
        CaseEnv env = base_env;
        env.stub.mutate_group_in_device = true;
        check_562300(env, "header_b.viv", 7u);
    }
    {
        CaseEnv env = base_env;
        env.stub.invoke_atomic_cb = true;
        env.stub.audio_size_ret = 0x1000u;
        check_562300(env, "header_end2end.viv", 9u);
    }

    // 5. resource_load_bigheader_quiet_0059df70
    check_59df70(base_env, "unrooted.viv", 0u);
    {
        CaseEnv env = base_env;
        env.roots_enabled = 1;
        env.stub.exists_mask = 1u;
        check_59df70(env, "primary.viv", 2u);
        env.stub.exists_mask = 2u;
        check_59df70(env, "fallback.viv", 3u);
        env.stub.exists_mask = 0u;
        env.missing_cb = &fixture_missing_a;
        check_59df70(env, "missing_a.viv", 4u);
        env.stub.mutate_missing_on_exists = true;
        env.missing_cb = nullptr;
        check_59df70(env, "missing_mut.viv", 5u);
        env.fallback = "";
        env.stub.mutate_missing_on_exists = false;
        env.missing_cb = &fixture_missing_a;
        check_59df70(env, "no_fallback.viv", 6u);
    }

    // 6. application_audio_probe_configure_004ae100
    // 6a. already initialized (00656ab4 != 0) -> immediate return
    {
        CaseEnv env = base_env;
        env.preset_query_root = true;
        check_4ae100(env, 0x4000, 1u, "main");
    }
    // 6b. globals allocation fails -> stores 0 and returns
    {
        CaseEnv env = base_env;
        env.stub.alloc_fail_mask = 1u;
        check_4ae100(env, 0x4000, 1u, "main");
    }
    // 6c. signed division cases and hdr == 0 vs hdr != 0 and freelist cleanup sizes
    {
        CaseEnv env = base_env;
        env.stub.invoke_atomic_cb = true;
        env.stub.audio_size_ret = 0x800u;
        // first = 0x4000, hdr != 0, bytes = 8 (bucket 0)
        check_4ae100(env, 0x4000, 2u, "race");
        // first = -1 -> (-1)/1024 == 0 (vs wrong >> 10 == -1)
        check_4ae100(env, -1, 3u, "neg1");
        // first = -1025 -> (-1025)/1024 == -1 (vs wrong >> 10 == -2)
        check_4ae100(env, -1025, 4u, "neg1025");
        // first = -1024 -> -1
        check_4ae100(env, -1024, 5u, "neg1024");
        // hdr == 0 (missing bigheader) -> skips 00566880
        env.stub.invoke_atomic_cb = false;
        env.stub.atomic_ret = 0u;
        check_4ae100(env, 1023, 6u, "nohdr");
        // freelist boundary: str_bytes == 0x100 (uses pool bucket 31 = 0x88)
        env.stub.res_open_grow_cap = 0x100u;
        check_4ae100(env, 1024, 7u, "cap100");
        // freelist boundary: str_bytes == 0x101 (uses context_table_release_0059ecd0)
        env.stub.res_open_grow_cap = 0x101u;
        check_4ae100(env, 2048, 8u, "cap101");
        // bytes == 0 -> skips cleanup
        env.stub.res_open_zero_end = true;
        check_4ae100(env, 0, 9u, "empty");
    }

    std::printf("bigheader_audio_configure_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
