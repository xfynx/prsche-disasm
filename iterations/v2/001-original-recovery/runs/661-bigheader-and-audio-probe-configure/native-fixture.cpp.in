    capture_fpu(trace.fpu);
    expected = trace;

    ctx = {path, 0xdeadbeefu, alloc_flags, diag_flag};
    setup_env(c);
    last_atomic_ctx = &ctx;
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::file_load_bigheader_callback_00562100),
        group, address(&ctx), eax_cpp);
    trace.ret_eax = normalize_ptr(eax_cpp);
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

