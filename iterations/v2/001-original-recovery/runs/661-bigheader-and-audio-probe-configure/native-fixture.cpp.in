struct CaseEnv {
    StubCfg stub;
    const char* root;
    const char* fallback;
    char roots_enabled;
    void(__cdecl* missing_cb)(const char*, std::int32_t);
    U group;
    bool preset_query_root;
    const char* viv_prefix;
};

static void setup_env(const CaseEnv& c) {
    stub_cfg = c.stub;
    alloc_seq = 0u;
    last_atomic_ctx = nullptr;
    std::memset(&trace, 0, sizeof(trace));
    std::memset(&op_arena, 0xee, sizeof(op_arena));
    std::memset(alloc_slot0, 0x11, sizeof(alloc_slot0));
    std::memset(alloc_slot1, 0x22, sizeof(alloc_slot1));
    std::memset(query_root_arena, 0x55, sizeof(query_root_arena));
    std::memset(music_buf_arena, 0x66, sizeof(music_buf_arena));
    std::memset(str_arena, 0x77, sizeof(str_arena));
    std::memset(mgr_arena, 0, sizeof(mgr_arena));
    put(mgr_arena + 0x28u, 0x00u, address(lock_arena));
    for (U k = 0u; k < 32u; ++k) {
        put(mgr_arena + 0x28u, 0x0cu + k * 4u, 0x99000000u + k);
    }
    fixture_heap_state_005e4fe8 = mgr_arena;

    porsche::diagnostic_handler_005debf0 = &porsche::diagnostic_entry_661;
    porsche::diagnostic_file_005deb74_set(nullptr);
    porsche::diagnostic_line_005deb78 = 0u;
    porsche::resource_leaf_group_005df770 = c.group;
    std::memset(porsche::file_root_006af168, 0, sizeof(porsche::file_root_006af168));
    std::memset(porsche::file_fallback_006af26c, 0, sizeof(porsche::file_fallback_006af26c));
    if (c.root != nullptr) {
        std::snprintf(porsche::file_root_006af168, sizeof(porsche::file_root_006af168), "%s", c.root);
    }
    if (c.fallback != nullptr) {
        std::snprintf(porsche::file_fallback_006af26c, sizeof(porsche::file_fallback_006af26c), "%s", c.fallback);
    }
    porsche::file_roots_enabled_006af370 = c.roots_enabled;
    porsche::missing_file_006afbe4 = c.missing_cb;
    porsche::audio_resource_query_root_00656ab4 = c.preset_query_root ? address(query_root_arena) : 0u;
    porsche::audio_probe_viv_prefix_0065b314 = c.viv_prefix;
}

static void capture_state() {
    trace.final_op = op_arena;
    std::memcpy(trace.final_query_root, query_root_arena, sizeof(trace.final_query_root));
    std::memcpy(trace.final_alloc0, alloc_slot0, sizeof(trace.final_alloc0));
    std::memcpy(trace.final_alloc1_tail, alloc_slot1 + 0xa80u, sizeof(trace.final_alloc1_tail));
    // Normalize pointers stored in mgr_arena freelist heads & str_arena[4]
    for (U k = 0u; k < 32u; ++k) {
        const U head = word(mgr_arena + 0x28u, 0x0cu + k * 4u);
        put(mgr_arena + 0x28u, 0x0cu + k * 4u, normalize_ptr(head));
    }
    put(str_arena, 0x04u, normalize_ptr(word(str_arena, 0x04u)));
    std::memcpy(trace.final_mgr, mgr_arena, sizeof(trace.final_mgr));
    std::memcpy(trace.final_str, str_arena, sizeof(trace.final_str));
    trace.final_query_root_ptr = normalize_ptr(porsche::audio_resource_query_root_00656ab4);
    const char* const df = porsche::diagnostic_file_005deb74();
    trace.final_diag_file_ok = (df != nullptr && std::strcmp(df, orig_str_5bcd00) == 0) ? 1u : 0u;
    trace.final_diag_line = porsche::diagnostic_line_005deb78;
    trace.final_group = porsche::resource_leaf_group_005df770;
    trace.final_missing_cb = normalize_missing_cb(porsche::missing_file_006afbe4);
    // Normalize pointers in query_root_arena (+0x6c, +0x88)
    put(trace.final_query_root, 0x6cu, normalize_ptr(word(trace.final_query_root, 0x6cu)));
    put(trace.final_query_root, 0x88u, normalize_ptr(word(trace.final_query_root, 0x88u)));
}

static void compare_traces() {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "ABI");
    require(trace.ret_eax == expected.ret_eax, "EAX");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) == 0, "event");
    }
    require(std::memcmp(&trace.final_op, &expected.final_op, sizeof(trace.final_op)) == 0, "FileOperation");
    require(std::memcmp(trace.final_query_root, expected.final_query_root, sizeof(trace.final_query_root)) == 0, "query_root");
    require(std::memcmp(trace.final_alloc0, expected.final_alloc0, sizeof(trace.final_alloc0)) == 0, "alloc0");
    require(std::memcmp(trace.final_alloc1_tail, expected.final_alloc1_tail, sizeof(trace.final_alloc1_tail)) == 0, "alloc1");
    require(std::memcmp(trace.final_mgr, expected.final_mgr, sizeof(trace.final_mgr)) == 0, "mgr_arena");
    require(std::memcmp(trace.final_str, expected.final_str, sizeof(trace.final_str)) == 0, "str_arena");
    require(trace.final_query_root_ptr == expected.final_query_root_ptr, "00656ab4");
    require(trace.final_diag_file_ok == expected.final_diag_file_ok, "005deb74");
    require(trace.final_diag_line == expected.final_diag_line, "005deb78");
    require(trace.final_group == expected.final_group, "005df770");
    require(trace.final_missing_cb == expected.final_missing_cb, "006afbe4");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof(trace.fpu)) == 0, "FPU");
    ++cases;
}

static void check_568b50(
    const CaseEnv& c, void* handle, U offset, void* buf, std::int32_t size, U group, void* ctx) {
    setup_env(c);
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl6(
        slot_568b50, address(handle), offset, address(buf), static_cast<U>(size), group, address(ctx), eax_orig);
    trace.ret_eax = eax_orig;
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl6(
        reinterpret_cast<void*>(&porsche::request_read_offset_00568b50),
        address(handle), offset, address(buf), static_cast<U>(size), group, address(ctx), eax_cpp);
    trace.ret_eax = eax_cpp;
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

