static void check_562100(const CaseEnv& c, U group, const char* path, U alloc_flags, U diag_flag) {
    porsche::ResourceAtomicContext ctx{path, 0xdeadbeefu, alloc_flags, diag_flag};
    setup_env(c);
    last_atomic_ctx = &ctx;
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl2(slot_562100, group, address(&ctx), eax_orig);
    trace.ret_eax = normalize_ptr(eax_orig);
