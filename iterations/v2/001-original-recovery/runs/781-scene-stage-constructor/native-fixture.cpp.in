static U invoke_cdecl_1(const void* fn, const void* arg0, U& ret_eax) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    U out_eax = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        push arg0
        mov eax, fn
        call eax
        mov out_eax, eax
        add esp, 4
        mov esp_after, esp
