static U invoke_thiscall_0_ret(const void* fn, void* self, U& ret_eax) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    U out_eax = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        mov ecx, self
        mov eax, fn
        call eax
        mov out_eax, eax
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_esp0
        mov esp, esp_before
        or abi_fail, 1
    ok_esp0:
        cmp ebx, 0x13572468
        je ok_ebx0
        or abi_fail, 2
    ok_ebx0:
        cmp esi, 0x24681357
        je ok_esi0
        or abi_fail, 4
    ok_esi0:
        cmp edi, 0x55aa33cc
        je ok_edi0
        or abi_fail, 8
    ok_edi0:
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = out_eax;
    return abi_fail;
}

