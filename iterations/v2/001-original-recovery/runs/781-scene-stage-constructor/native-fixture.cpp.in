static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c};
}

static U __cdecl mock_ctx_size(const void* block) {
    record_event(kEvCtxSize, address(block), g_file_bytes);
    return g_file_bytes;
}

static U __cdecl mock_ctx_size_alt(const void* block) {
    record_event(kEvCtxSize, address(block), g_file_bytes ^ 0x8cu);
    return g_file_bytes + 0x8cu;
}

namespace porsche {

const char* startup_resource_prefix_0065b30c = kPrefixStr;

void* __cdecl application_context_heap_state_005e4fe8() {
    return g_heap_ctx_ptr;
}

I __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list ap;
    va_start(ap, format);
    const char* arg = va_arg(ap, const char*);
    va_end(ap);
    const int n = std::snprintf(output, 0x190u, format, arg);
    record_event(kEvFormat, fnv1a(format), fnv1a(output), static_cast<U>(n));
    return n;
}

void* __cdecl resource_open_quiet_0059d9b0(const char* name, U flags) {
    record_event(kEvOpenQuiet, fnv1a(name), flags);
    return g_open_result;
}

void* __cdecl startup_network_allocate_0059ef90(U bytes) {
    const U step = g_alloc_step++;
    record_event(kEvAlloc, bytes, step);
    if ((g_alloc_fail_mask & (1u << step)) != 0u) {
        return nullptr;
    }
    if (bytes == 0x0cu) {
        require(g_holder_idx < kMaxHolders, "holder bound");
        return g_holders[g_holder_idx++];
    }
    if (bytes == 0x8cu) {
        require(g_entry_idx < kMaxHolders, "entry bound");
        return g_entries[g_entry_idx++];
    }
    require(false, "unexpected 0059ef90 size");
    return nullptr;
}

void __cdecl context_table_release_0059ecd0(void* block) {
    record_event(kEvCtxRelease, address(block));
}

U __cdecl application_release_0059f050(void* block) {
    record_event(kEvRelease, address(block));
    return 1u;
}

void* __cdecl application_allocate_array_0059eff0(U bytes) {
    record_event(kEvAllocArray, bytes);
    require(bytes <= sizeof g_ptr_table, "array size bound");
    return g_ptr_table;
}

void __fastcall scene_flare_entries_resolve_00452120(void* self, void*) {
    void* entry = reinterpret_cast<void*>(static_cast<std::uintptr_t>(load32(self, 0x00u)));
    const U word0 = (entry != nullptr) ? load32(entry, 0x00u) : 0u;
    const U word4c = (entry != nullptr) ? load32(entry, 0x4cu) : 0u;
    record_event(kEvResolve, address(self), address(entry), word0 ^ word4c);
    store32(self, 0x04u, 0x11110000u | g_holder_idx);
    store32(self, 0x08u, 0x22220000u | g_entry_idx);
}

