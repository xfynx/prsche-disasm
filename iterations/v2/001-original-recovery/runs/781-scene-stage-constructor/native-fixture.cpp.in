    U abi_fail;
    U ret_eax;
    U event_count;
    std::array<Event, kMaxEvents> events;
    std::array<B, 0x340u> self_bytes;
    std::array<B, 0x20u> ptr_table_bytes;
    std::array<std::array<B, 0x0cu>, kMaxHolders> holder_bytes;
    std::array<std::array<B, 0x8cu>, kMaxHolders> entry_bytes;
};

