static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_holder_idx = 0u;
    g_entry_idx = 0u;
    g_alloc_step = 0u;
    g_alloc_fail_mask = 0u;
    g_open_result = nullptr;
    g_file_bytes = 0u;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_ctx_buf, 0, sizeof g_ctx_buf);
    store32(g_ctx_buf, 0x18u, address(reinterpret_cast<const void*>(&mock_ctx_size)));
    store32(g_ctx_buf, 0x1cu, address(reinterpret_cast<const void*>(&mock_ctx_size_alt)));
    for (U i = 0u; i < sizeof g_self_buf; ++i) {
        g_self_buf[i] = static_cast<B>((0x33u + i + seed) & 0xffu);
    }
    std::memset(g_ptr_table, 0xcc, sizeof g_ptr_table);
    std::memset(g_holders, 0xdd, sizeof g_holders);
    std::memset(g_entries, 0xee, sizeof g_entries);
    for (U i = 0u; i < sizeof g_file_data; ++i) {
        g_file_data[i] = static_cast<B>((0x11u + i * 3u + seed) & 0xffu);
    }
    // Stamp distinct entry words inside g_file_data records (stride 0x8c)
    for (U k = 0u; k < 4u; ++k) {
        store32(g_file_data, k * 0x8cu, 0x464c5230u + k);
        store32(g_file_data, k * 0x8cu + 0x4cu, 10u + k);
    }
}

static void capture(Snapshot& out, U abi_fail, U ret_eax) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    std::memcpy(out.self_bytes.data(), g_self_buf, sizeof g_self_buf);
    std::memcpy(out.ptr_table_bytes.data(), g_ptr_table, sizeof g_ptr_table);
    for (U i = 0u; i < kMaxHolders; ++i) {
        std::memcpy(out.holder_bytes[i].data(), g_holders[i], sizeof g_holders[i]);
        std::memcpy(out.entry_bytes[i].data(), g_entries[i], sizeof g_entries[i]);
    }
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c,
                tag);
    }
    require(orig.self_bytes == cpp.self_bytes, tag);
    require(orig.ptr_table_bytes == cpp.ptr_table_bytes, tag);
    for (U i = 0u; i < kMaxHolders; ++i) {
        require(orig.holder_bytes[i] == cpp.holder_bytes[i], tag);
        require(orig.entry_bytes[i] == cpp.entry_bytes[i], tag);
    }
    ++cases;
}

template <class Setup>
static void run_stage_ctor_case(Setup&& setup, const char* tag) {
    Snapshot orig{};
    Snapshot cpp{};
    U ret_orig = 0u;
    U ret_cpp = 0u;
    reset_fixtures(1u);
    setup();
    capture(orig, invoke_thiscall_0_ret(slot_004522b0, g_self_buf, ret_orig), ret_orig);
    reset_fixtures(1u);
    setup();
    capture(cpp, invoke_thiscall_0_ret(
        reinterpret_cast<const void*>(&porsche::scene_stage_constructor_004522b0),
        g_self_buf, ret_cpp), ret_cpp);
    check_equal(orig, cpp, tag);
}

int main() {
    init();

    // 1. Direct 0059ece0 size queries
    for (U sz : {0u, 140u, 420u, 0x12345u}) {
        Snapshot orig{};
        Snapshot cpp{};
        U ret_orig = 0u;
        U ret_cpp = 0u;
        reset_fixtures(2u);
        g_file_bytes = sz;
        capture(orig, invoke_cdecl_1(slot_0059ece0, g_file_data, ret_orig), ret_orig);
        reset_fixtures(2u);
        g_file_bytes = sz;
        capture(cpp, invoke_cdecl_1(
            reinterpret_cast<const void*>(&porsche::context_table_size_0059ece0),
            g_file_data, ret_cpp), ret_cpp);
        check_equal(orig, cpp, "0059ece0 size");
    }

    // 2. Direct 004524a0 entry ctor
    for (U tag : {0x6e756c6cu, 0u, 0x12345678u, 0xffffffffu}) {
        Snapshot orig{};
        Snapshot cpp{};
        U ret_orig = 0u;
        U ret_cpp = 0u;
        reset_fixtures(3u);
        capture(orig, invoke_thiscall_1_ret(slot_004524a0, g_entries[0], tag, ret_orig), ret_orig);
        reset_fixtures(3u);
        capture(cpp, invoke_thiscall_1_ret(
            reinterpret_cast<const void*>(&porsche::scene_flare_entry_ctor_004524a0),
            g_entries[0], tag, ret_cpp), ret_cpp);
        check_equal(orig, cpp, "004524a0 ctor");
    }

    // 3. 004522b0 missing flare.dat (fallback default entry)
    run_stage_ctor_case([]() {
        g_open_result = nullptr;
    }, "ctor missing file");

    // 4. 004522b0 missing flare.dat with entry alloc failure (holder non-null, entry null)
    run_stage_ctor_case([]() {
        g_open_result = nullptr;
        g_alloc_fail_mask = 2u;
    }, "ctor missing file entry null");

    // 5. 004522b0 missing flare.dat with holder alloc failure
    run_stage_ctor_case([]() {
        g_open_result = nullptr;
        g_alloc_fail_mask = 1u;
    }, "ctor missing file holder null");

    // 6. 004522b0 empty flare.dat (0 bytes)
    run_stage_ctor_case([]() {
        g_open_result = g_file_data;
        g_file_bytes = 0u;
    }, "ctor empty file");

    // 7. 004522b0 1, 2, and 3 records (140B each)
    for (U n : {1u, 2u, 3u}) {
        run_stage_ctor_case([n]() {
            g_open_result = g_file_data;
            g_file_bytes = n * 0x8cu;
        }, "ctor n records");
    }

    // 8. 004522b0 2 records with holder 0 alloc failure (tests holder==null continue path)
    run_stage_ctor_case([]() {
        g_open_result = g_file_data;
        g_file_bytes = 2u * 0x8cu;
        g_alloc_fail_mask = 1u;
    }, "ctor multi holder0 fail");

    std::printf("scene_stage_constructor_781_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
