};

enum EventTag : U {
    kEvShutdownChannel = 1u,
    kEvFree = 2u,
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Event {
    U tag;
    U arg0;
};

struct Trace {
    I ret;
    U abi_fail;
    U count;
    Event events[kMaxEvents];
    U head;
    U read_pos;
    U tail;
    porsche::SimAudioRecord00656528 records[32];
    porsche::AudioQueueRequest00656b00 ring[64];
    porsche::AudioQueueRequest00656b00 req_out;
    FpuSnapshot fp;
};

alignas(16) static B fp_area[512];
static B fp_env[28];

static Trace trace{};
static Trace expected{};

static U cases = 0u;
static U events_total = 0u;
static U which = 0u;
static I captured_ret = 0;

static B* code = nullptr;

static const U kEntriesBank0[] = { 0x1001u, 0x200u, 0x1002u, 0u, 0x1003u, 0x400u };
static const U kEntriesBank1[] = { 0x2001u, 0x100u };
static const U kEntriesBank2[] = {
    0x3000u, 0x111u, 0x3001u, 0x222u, 0x3002u, 0x333u, 0x3003u, 0x444u,
    0x3004u, 0x555u, 0x3005u, 0x666u, 0x3006u, 0x777u, 0x3007u, 0x888u,
    0x3008u, 0x999u
};

static const B kBody4A8570[239] = { @BODY_004A8570@ };
static const B kBody4A83E0[162] = { @BODY_004A83E0@ };
static const B kBody4AF8D0[40] = { @BODY_004AF8D0@ };
static const B kBody4B05A0[209] = { @BODY_004B05A0@ };
static const B kBody4B0CF0[59] = { @BODY_004B0CF0@ };

static void write_u32(B* p, U value) {
    std::memcpy(p, &value, sizeof(value));
}

static void write_rel32(B* site, const void* target) {
    const std::int32_t rel = static_cast<std::int32_t>(
        reinterpret_cast<std::uintptr_t>(target) -
        (reinterpret_cast<std::uintptr_t>(site) + 4u));
    std::memcpy(site, &rel, sizeof(rel));
}

static void fail(const char* why) {
    std::printf("sim_audio_queue_original_x86_vs_cpp=FAIL case=%u side=%u reason=%s\n",
                cases, which, why);
    std::exit(1);
}

static void push_event(U tag, U arg0) {
    if (trace.count >= kMaxEvents) {
        fail("event_overflow");
    }
    trace.events[trace.count++] = Event{tag, arg0};
    ++events_total;
}

namespace porsche {
void __cdecl application_audio_shutdown_channels_005659f0(std::int32_t channel) {
    push_event(kEvShutdownChannel, static_cast<U>(channel));
}

std::uint32_t __cdecl free_00531f90(void* p) {
    push_event(kEvFree, static_cast<U>(reinterpret_cast<std::uintptr_t>(p)));
    return 0u;
}
} // namespace porsche

static void __declspec(noinline) capture_fpu(FpuSnapshot* out) {
    U mxcsr_val = 0u;
    __asm {
        fnstenv [fp_env]
        fxsave [fp_area]
        stmxcsr mxcsr_val
    }
    unsigned short cw = 0;
    unsigned short sw = 0;
    unsigned short tw = 0;
    std::memcpy(&cw, fp_env + 0, 2);
    std::memcpy(&sw, fp_env + 4, 2);
    std::memcpy(&tw, fp_env + 8, 2);
    out->control = cw;
    out->status = static_cast<unsigned short>(sw & 0x3800u);
    out->tag = tw;
    out->pad = 0;
    out->mxcsr = mxcsr_val;
    std::memcpy(out->values, fp_area + 32, 80);
    for (U i = 0u; i < 8u; ++i) {
        if ((fp_area[4u] & (1u << (((out->status >> 11u) + i) & 7u))) == 0u) {
            std::memset(out->values + i * 10u, 0, 10u);
        }
    }
}

