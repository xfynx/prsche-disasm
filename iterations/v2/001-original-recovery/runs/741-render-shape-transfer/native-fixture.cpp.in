static U ptr(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U rd(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void wr(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", msg, cases, side);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx case=%u side=%u\n",
                p->ExceptionRecord->ExceptionCode,
                p->ContextRecord->Eip,
                cases,
                side);
    std::fflush(stdout);
    ExitProcess(1);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void record_event(U kind, U a0, U a1 = 0u, U a2 = 0u, U a3 = 0u) {
    require(trace.event_count < kMaxEvents, "event capacity");
    trace.events[trace.event_count++] = {
        kind, a0, a1, a2, a3,
        shared_runtime_word_005deb78,
        ptr(reinterpret_cast<const void*>(render_shape_stage1_fn_006a6424)),
        ptr(reinterpret_cast<const void*>(render_shape_stage2_fn_006a6428))
    };
}

static void __cdecl test_diag_handler(const char* fmt, U code_val) {
    require(fmt != nullptr && std::strcmp(fmt, render_shape_invalid_fmt_005c073c) == 0, "diag fmt");
    const auto* file = reinterpret_cast<const char*>(
        static_cast<std::uintptr_t>(shared_runtime_word_005deb74));
    require(file != nullptr && std::strcmp(file, render_shape_source_file_005c0764) == 0, "diag file");
    record_event(1u, code_val);
}

static void __cdecl span_slot_fn(U slot_id, void* dst, const void* src, U count) {
    const auto* s = static_cast<const B*>(src);
    auto* d = static_cast<B*>(dst);
    const U src_off = (s >= primary_shape && s < primary_shape + kShapeBufBytes)
        ? static_cast<U>(s - primary_shape)
        : ((s >= converted_shape && s < converted_shape + kShapeBufBytes)
            ? (0x1000u + static_cast<U>(s - converted_shape))
            : 0x9999u);
    const U dst_off = static_cast<U>(d - dst_buf);
    record_event(10u + slot_id, dst_off, src_off, count);
    for (U i = 0u; i < count; ++i) {
        d[i] = static_cast<B>((s[i] ^ (0x11u * (slot_id + 1u))) & 0xffu);
    }
}

static void __cdecl span_0(void* d, const void* s, U c) { span_slot_fn(0u, d, s, c); }
static void __cdecl span_1(void* d, const void* s, U c) { span_slot_fn(1u, d, s, c); }
static void __cdecl span_2(void* d, const void* s, U c) { span_slot_fn(2u, d, s, c); }
static void __cdecl span_3(void* d, const void* s, U c) { span_slot_fn(3u, d, s, c); }
static void __cdecl span_4(void* d, const void* s, U c) { span_slot_fn(4u, d, s, c); }
static void __cdecl span_override(void* d, const void* s, U c) { span_slot_fn(5u, d, s, c); }

static void __cdecl row_conv_fn(void* dst, const void* src, U count) {
    const auto* s = static_cast<const B*>(src);
    auto* d = static_cast<B*>(dst);
    const U src_off = static_cast<U>(s - primary_shape);
    record_event(20u, src_off, count);
    for (U i = 0u; i < count; ++i) {
        d[i] = static_cast<B>((s[i] + 0x5au) & 0xffu);
    }
}

static void __cdecl stage2_fn(void* dst, const void* src, U count) {
    const auto* s = static_cast<const B*>(src);
    auto* d = static_cast<B*>(dst);
    const U dst_off = static_cast<U>(d - dst_buf);
    record_event(21u, dst_off, count);
    for (U i = 0u; i < count; ++i) {
        d[i] = static_cast<B>((s[i] ^ 0x3cu) & 0xffu);
    }
}

namespace porsche {

std::uint32_t __cdecl render_descriptor_bits_00537f90(const void* shape) {
    const B t = *static_cast<const B*>(shape);
    if (t == 0x7au) return 4u;
    if (t == 0x7bu) return 8u;
    if (t == 0x7du) return 15u;
    if (t == 0x7eu) return 16u;
    if (t == 0x7fu) return 24u;
    if (t == 0x6du) return 32u;
    return 0u;
}

std::int32_t __cdecl splash_shape_row_stride_005712f0(const void* shape) {
    const auto* const bytes = static_cast<const B*>(shape);
    const I width = static_cast<I>(static_cast<std::int16_t>(
        bytes[4] | (static_cast<U>(bytes[5]) << 8u)));
    if (bytes[0] == 0x7bu) {
        return width;
    }
    I bpp = static_cast<I>(render_descriptor_bits_00537f90(shape));
    if (bpp == 15) {
        bpp = 16;
    }
    return (bpp * width + 7) >> 3;
}

std::uint32_t __cdecl free_00531f90(void* p) {
    record_event(4u, (p == converted_shape) ? 1u : 0u);
    return 1u;
}

void* __cdecl render_shape_row_converter_00534b90(
    const void* shape, std::uint32_t target_type, std::int32_t direct_mode) {
    record_event(2u, *static_cast<const B*>(shape), target_type, static_cast<U>(direct_mode));
    if (g_conv_mode == 1u) {
        return reinterpret_cast<void*>(&row_conv_fn);
    }
    return nullptr;
}

void* __cdecl render_shape_convert_type_00534d40(
    const void* shape, std::uint32_t target_type,
    std::int32_t use_dither, std::int32_t direct_mode) {
    record_event(3u, *static_cast<const B*>(shape), target_type,
                 static_cast<U>(use_dither), static_cast<U>(direct_mode));
    return converted_shape;
}

} // namespace porsche

static __declspec(naked) void stub_chkstk_005a1e90() {
    __asm {
        pop ecx
        cmp eax, 1000h
        jb short done_probe
    probe_loop:
        sub esp, 1000h
        test dword ptr [esp], eax
        sub eax, 1000h
        cmp eax, 1000h
        jae short probe_loop
    done_probe:
        sub esp, eax
        test dword ptr [esp], eax
        jmp ecx
    }
}

static void invoke_cdecl4_void(void* fn, U a0, U a1, U a2, U a3, U& abi_fail) {
    U fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push a3
        push a2
        push a1
        push a0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        add esp, 16
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
}

static void invoke_cdecl3_void(void* fn, U a0, U a1, U a2, U& abi_fail) {
    U fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push a2
        push a1
        push a0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        add esp, 12
