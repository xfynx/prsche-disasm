enum : U {
    kMaxEvents = 64u,
    kShapeBufBytes = 256u,
    kDstBufBytes = 1024u,
};

struct Event {
    U kind;
    U a0;
    U a1;
    U a2;
    U a3;
    U diag_line;
    U stage1_ptr;
    U stage2_ptr;
};

struct Trace {
    U abi_fail;
    U event_count;
    Event events[kMaxEvents];
    B dst_after[kDstBufBytes];
    U diag_file_nonnull;
    U diag_line_after;
