    patch_abs(slot_571630, sizeof b_571630, 0x006a6424u, ptr(&render_shape_stage1_fn_006a6424), 3u);
    patch_rel(slot_571630, 0x8eu, 0x00571630u, 0x00534b90u, ptr(reinterpret_cast<void*>(&render_shape_row_converter_00534b90)));
