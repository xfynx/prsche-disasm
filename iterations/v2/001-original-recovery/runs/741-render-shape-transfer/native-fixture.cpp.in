        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
}

static void patch_abs(B* base, U size, U old_va, U new_va, U expected_hits) {
    U hits = 0u;
    for (U i = 0u; i + 4u <= size; ++i) {
        if (rd(base, i) == old_va) {
            wr(base, i, new_va);
            ++hits;
            i += 3u;
        }
    }
    require(hits == expected_hits, "patch_abs count");
}

static void patch_rel(B* base, U offset, U va_start, U orig_target, U new_target) {
    require(base[offset] == 0xe8u, "patch_rel opcode");
    const U decoded = va_start + offset + 5u + rd(base, offset + 1u);
    require(decoded == orig_target, "patch_rel orig target");
    wr(base, offset + 1u, new_target - (ptr(base) + offset + 5u));
}

static void verify_initial_pe_state(const char* pe_path) {
    require(render_shape_stage1_fn_006a6424 == nullptr, "C++ initial 006a6424");
    require(render_shape_stage2_fn_006a6428 == nullptr, "C++ initial 006a6428");

    FILE* f = std::fopen(pe_path, "rb");
    require(f != nullptr, "open PE");
    std::fseek(f, 0, SEEK_END);
    const long len = std::ftell(f);
    std::rewind(f);
    auto* pe = new B[static_cast<std::size_t>(len)];
    require(std::fread(pe, 1, static_cast<std::size_t>(len), f) == static_cast<std::size_t>(len), "read PE");
    std::fclose(f);

    const U nt = rd(pe, 0x3cu);
    const U base = rd(pe, nt + 52u);
    const U sections = pe[nt + 6u] | (static_cast<U>(pe[nt + 7u]) << 8u);
    const U optional = pe[nt + 20u] | (static_cast<U>(pe[nt + 21u]) << 8u);

    auto read_va_u32 = [&](U va) -> U {
        for (U i = 0u; i < sections; ++i) {
            const B* s = pe + nt + 24u + optional + i * 40u;
            const U vs = rd(s, 8u), rva = rd(s, 12u), rawsize = rd(s, 16u), raw = rd(s, 20u);
            const U delta = va - base - rva;
            if (delta < vs && delta + 4u <= vs) {
                if (delta + 4u <= rawsize) return rd(pe, raw + delta);
                return 0u;
            }
        }
        require(false, "VA not in PE");
        return 0u;
    };

    require(read_va_u32(0x006a6424u) == 0u, "PE initial 006a6424");
    require(read_va_u32(0x006a6428u) == 0u, "PE initial 006a6428");
    delete[] pe;
}

