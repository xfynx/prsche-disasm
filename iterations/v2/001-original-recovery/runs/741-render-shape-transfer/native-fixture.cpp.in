static void seed_shape(B* buf, B type_byte, std::int16_t w, std::int16_t h, B salt) {
    std::memset(buf, 0, kShapeBufBytes);
    buf[0] = type_byte;
    std::memcpy(buf + 4, &w, 2u);
    std::memcpy(buf + 6, &h, 2u);
    for (U i = 0x10u; i < kShapeBufBytes; ++i) {
        buf[i] = static_cast<B>((i * 29u + salt) & 0xffu);
    }
}

static void prepare_state(
    B dst_type, B dst_bpp, B dst_storage_bits, U pitch,
    I clip_l, I clip_t, I clip_r, I clip_b,
    B shape_type, std::int16_t shape_w, std::int16_t shape_h,
    B conv_type, std::int16_t conv_w, std::int16_t conv_h,
    U conv_mode) {
    std::memset(&trace, 0, sizeof trace);
    for (U i = 0u; i < 12u; ++i) {
        window_shutdown_config_005de620[i] = 0x20000000u + i;
    }
    window_shutdown_config_005de620[3] =
        static_cast<U>(dst_type) |
        (static_cast<U>(dst_bpp) << 8u) |
        (static_cast<U>(dst_storage_bits) << 16u);
    window_shutdown_config_005de620[5] = static_cast<U>(clip_l);
    window_shutdown_config_005de620[6] = static_cast<U>(clip_t);
    window_shutdown_config_005de620[7] = static_cast<U>(clip_r);
    window_shutdown_config_005de620[8] = static_cast<U>(clip_b);
    window_shutdown_config_005de620[9] = pitch;
    window_shutdown_state_005de64c = ptr(dst_buf + 64u);

    shared_runtime_word_005deb74 = 0u;
    shared_runtime_word_005deb78 = 0u;
    diagnostic_handler_005debf0 = reinterpret_cast<void(__cdecl*)(const char*)>(&test_diag_handler);

    render_shape_stage1_fn_006a6424 = reinterpret_cast<RenderShapeSpanFn>(0x12345678u);
    render_shape_stage2_fn_006a6428 = reinterpret_cast<RenderShapeSpanFn>(0x87654321u);
    g_conv_mode = conv_mode;

    seed_shape(primary_shape, shape_type, shape_w, shape_h, 3u);
    seed_shape(converted_shape, conv_type, conv_w, conv_h, 77u);
    for (U i = 0u; i < kDstBufBytes; ++i) {
        dst_buf[i] = static_cast<B>((i * 17u + 5u) & 0xffu);
    }
}

static void snapshot_state() {
    require(trace.abi_fail == 0u, "ABI check");
    std::memcpy(trace.dst_after, dst_buf, sizeof trace.dst_after);
    trace.diag_file_nonnull = (shared_runtime_word_005deb74 != 0u) ? 1u : 0u;
    trace.diag_line_after = shared_runtime_word_005deb78;
    trace.stage1_after = ptr(reinterpret_cast<const void*>(render_shape_stage1_fn_006a6424));
    trace.stage2_after = ptr(reinterpret_cast<const void*>(render_shape_stage2_fn_006a6428));
}

static void run_571630_case(
    B dst_type, B dst_bpp, B dst_storage_bits, U pitch,
    I clip_l, I clip_t, I clip_r, I clip_b,
    B shape_type, std::int16_t shape_w, std::int16_t shape_h,
    B conv_type, std::int16_t conv_w, std::int16_t conv_h,
    I x, I y,
    bool use_override_fn, U mode_flag, U override_dst_type, U conv_mode) {
    ++cases;
    const void* table[8] = {
        reinterpret_cast<const void*>(&span_0),
        reinterpret_cast<const void*>(&span_1),
        reinterpret_cast<const void*>(&span_2),
        reinterpret_cast<const void*>(&span_3),
        reinterpret_cast<const void*>(&span_4),
        use_override_fn ? reinterpret_cast<const void*>(&span_override) : nullptr,
        reinterpret_cast<const void*>(static_cast<std::uintptr_t>(mode_flag)),
        reinterpret_cast<const void*>(static_cast<std::uintptr_t>(override_dst_type)),
    };
    for (side = 0u; side < 2u; ++side) {
        prepare_state(dst_type, dst_bpp, dst_storage_bits, pitch,
                      clip_l, clip_t, clip_r, clip_b,
                      shape_type, shape_w, shape_h,
                      conv_type, conv_w, conv_h, conv_mode);
        void* const fn = (side == 0u)
            ? static_cast<void*>(slot_571630)
            : reinterpret_cast<void*>(&render_shape_transfer_00571630);
        invoke_cdecl4_void(fn, ptr(primary_shape), static_cast<U>(x), static_cast<U>(y), ptr(table),
                           trace.abi_fail);
        snapshot_state();
        if (side == 0u) {
            expected = trace;
        } else {
            require(std::memcmp(&trace, &expected, sizeof trace) == 0, "00571630 trace match");
        }
    }
}

static void run_5719c0_case(U dst_off, U count) {
    ++cases;
    for (side = 0u; side < 2u; ++side) {
        prepare_state(0x7bu, 8u, 8u, 64u, 0, 0, 64, 64,
                      0x7bu, 8, 8, 0x7bu, 8, 8, 0u);
        render_shape_stage1_fn_006a6424 = &row_conv_fn;
        render_shape_stage2_fn_006a6428 = &stage2_fn;
        void* const fn = (side == 0u)
            ? static_cast<void*>(slot_5719c0)
            : reinterpret_cast<void*>(&render_shape_two_stage_span_005719c0);
        invoke_cdecl3_void(fn, ptr(dst_buf + dst_off), ptr(primary_shape + 0x10u), count, trace.abi_fail);
        snapshot_state();
        if (side == 0u) {
            expected = trace;
        } else {
            require(std::memcmp(&trace, &expected, sizeof trace) == 0, "005719c0 trace match");
        }
    }
}

int main(int argc, char** argv) {
    AddVectoredExceptionHandler(1, fault_handler);
    require(argc == 2, "PE path argument");
    init_fixture(argv[1]);

    // 1. Direct transfer (shape type == target type) across all 5 bpp slots (8, 15, 16, 24, 32)
    // and both fast-path (pitch==row_bytes, no clipping) and per-row (pitch > row_bytes)
    const struct { B type; B bpp; B storage; } modes[] = {
        {0x7bu, 8u, 8u},
        {0x7du, 15u, 16u},
        {0x7eu, 16u, 16u},
        {0x7fu, 24u, 24u},
        {0x6du, 32u, 32u},
    };
    for (const auto& m : modes) {
        const U tight_pitch = (static_cast<U>(m.storage) * 6u) >> 3u;
        // Fast path
        run_571630_case(m.type, m.bpp, m.storage, tight_pitch,
                        0, 0, 16, 16, m.type, 6, 4, m.type, 6, 4,
                        0, 0, false, 0u, 0u, 0u);
        // Strided + clipped all 4 sides
        run_571630_case(m.type, m.bpp, m.storage, tight_pitch + 8u,
                        2, 1, 6, 4, m.type, 8, 6, m.type, 8, 6,
                        0, 0, false, 0u, 0u, 0u);
        // Override fn (table[5] != null)
        run_571630_case(m.type, m.bpp, m.storage, tight_pitch + 4u,
                        0, 0, 16, 16, 0x7au, 6, 4, m.type, 6, 4,
                        1, 1, true, 1u, 0u, 0u);
    }

    // 2. Conversion paths: row_conv (mode_flag=2 single-stage vs mode_flag=0/1 two-stage via 005719c0)
    // and type_conv (00534d40 allocated shape + 00531f90 free, including use_dither=0/1)
    for (U mode_flag : {0u, 1u, 2u}) {
        // Row converter returned (conv_mode = 1)
        run_571630_case(0x7eu, 16u, 16u, 16u, 0, 0, 16, 16,
                        0x7bu, 5, 3, 0x7eu, 5, 3, 1, 1, false, mode_flag, 0u, 1u);
        // Override dest type (table[7] != 0) with row converter
        run_571630_case(0x7bu, 8u, 8u, 16u, 0, 0, 16, 16,
                        0x7au, 6, 4, 0x7bu, 6, 4, 0, 0, false, mode_flag, 0x7eu, 1u);
        // Type converter returned (conv_mode = 0 -> calls 00534d40 & frees via 00531f90)
        run_571630_case(0x7eu, 16u, 16u, 16u, 0, 0, 16, 16,
                        0x7bu, 5, 3, 0x7eu, 5, 3, 2, 1, false, mode_flag, 0u, 0u);
    }

    // 3. 4bpp sub-byte odd-width clipping (verifies sar3 rounding on left/right/top/bottom clip)
    run_571630_case(0x7au, 8u, 8u, 16u, 3, 1, 8, 4,
                    0x7au, 9, 5, 0x7au, 9, 5, 0, 0, true, 0u, 0u, 0u);

    // 4. Fully clipped off-screen (width<=0 or height<=0), including freeing allocated converted shape
    run_571630_case(0x7eu, 16u, 16u, 16u, 10, 10, 20, 20,
                    0x7bu, 4, 4, 0x7eu, 4, 4, 0, 0, false, 1u, 0u, 0u);
    run_571630_case(0x7bu, 8u, 8u, 16u, 10, 10, 20, 20,
                    0x7bu, 4, 4, 0x7bu, 4, 4, 10, 25, false, 0u, 0u, 0u);

    // 5. Invalid shape type diagnostic path (00537f90 == 0 -> sets 005deb74/78 & calls 005debf0)
    // Clipped out afterwards so no pixel draw occurs
    run_571630_case(0x7bu, 8u, 8u, 16u, 10, 10, 20, 20,
                    0x99u, 4, 4, 0x7bu, 4, 4, 0, 0, false, 0u, 0u, 0u);

    // 6. Direct 005719c0 cases across counts
    for (U count : {1u, 4u, 15u, 64u, 128u}) {
        run_5719c0_case(64u, count);
    }

    std::printf("render_shape_transfer_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
