    kEvAlloc = 1u, kEvSlotObject = 2u, kEvRootCtor = 3u, kEvStageCtor = 4u,
    kEvFormatter = 5u, kEvElemKind = 6u, kEvFeService = 7u, kEvRouteDispatch = 8u,
};
enum : U { kMaxEvents = 128u, kPoolBytes = 0x600u, kMaxScript = 16u, kMaxCases = 96u };

struct Event { U kind, a, b, c, d, e; };

struct Spec {
    U fn, a0, a1;
    U fail_alloc, ctor_mode;
    U vec_count;
