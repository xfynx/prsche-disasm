static void reset_runtime(const Spec& spec) {
    event_count = 0u;
    pool_used = 0u;
    alloc_call = 0u;
    fail_alloc_at = spec.fail_alloc;
    fmt_call = 0u;
    kind_call = 0u;
    ctor_mode = spec.ctor_mode;
    std::memset(pool, 0xd0, sizeof pool);
    std::memset(events, 0, sizeof events);
    std::memset(vec_elements, 0, sizeof vec_elements);
    for (U i = 0u; i < 6u; ++i) {
        vec_elements[i] = spec.elements[i];
    }
    vec_header[0] = address(vec_elements);
    vec_header[1] = address(vec_elements) + spec.vec_count * 4u;
    for (U i = 0u; i < kMaxScript; ++i) {
        fmt_script[i] = spec.fmt[i];
        kind_script[i] = spec.kind[i];
    }
    scene_elem_vector_00628168 = vec_header;
    scene_elem_count_vector_00628178 = vec_header;
    application_state_006573e8.word(0x00657430u) = spec.arena;
    std::memset(view_slot_table_00627e80, 0, sizeof view_slot_table_00627e80);
    view_slot_table_00627e80[0xc0u] = static_cast<B>(spec.slot0);
    view_slot_table_00627e80[0x1ccu] = static_cast<B>(spec.slot1);
    frame_reset_word_006280f0 = spec.prefill[0];
    frame_reset_word_006280ec = spec.prefill[1];
    frame_reset_word_006280e8 = spec.prefill[2];
    frame_reset_word_00628100 = spec.prefill[3];
    frame_reset_word_006280fc = spec.prefill[4];
    frame_reset_word_006280f8 = spec.prefill[5];
    entry_fe_flag_word_006280e0 = spec.prefill[6];
    entry_fe_flag_word_006280e4 = spec.prefill[7];
    entry_fe_frame_word_00606ad4 = spec.prefill[8];
    scene_route_root_object_0061bc38 =
        reinterpret_cast<void*>(static_cast<std::uintptr_t>(spec.prefill[9]));
    scene_transfer_object_0061bcc0 =
        reinterpret_cast<void*>(static_cast<std::uintptr_t>(spec.prefill[9] + 4u));
}

static void invoke_original(const Spec& spec, U& abi, U& eax) {
    switch (spec.fn) {
        case 0u: eax = invoke_cdecl0(slot_0046d960, abi); break;
        case 1u: eax = invoke_cdecl0(slot_0046d890, abi); break;
        case 2u: eax = invoke_cdecl2(slot_004659e0, spec.a0, spec.a1, abi); break;
        case 3u: eax = invoke_cdecl2(slot_00475d70, spec.a0, spec.a1, abi); break;
        case 4u: eax = invoke_cdecl1(slot_0044fae0, spec.a0, abi); break;
        case 5u: eax = invoke_cdecl0(slot_004521c0, abi); break;
        case 6u: eax = invoke_fast2(slot_0044b960, spec.a0, abi); break;
        default: require(false, "bad case function");
    }
}

static void invoke_cpp(const Spec& spec, U& abi, U& eax) {
    switch (spec.fn) {
        case 0u: eax = invoke_cdecl0(reinterpret_cast<void*>(&entry_fe_call_0046d960), abi); break;
        case 1u: eax = invoke_cdecl0(reinterpret_cast<void*>(&entry_fe_call_0046d890), abi); break;
        case 2u: eax = invoke_cdecl2(reinterpret_cast<void*>(&entry_fe_call_004659e0), spec.a0, spec.a1, abi); break;
        case 3u: eax = invoke_cdecl2(reinterpret_cast<void*>(&scene_route_select_00475d70), spec.a0, spec.a1, abi); break;
        case 4u: eax = invoke_cdecl1(reinterpret_cast<void*>(&scene_route_root_0044fae0), spec.a0, abi); break;
        case 5u: eax = invoke_cdecl0(reinterpret_cast<void*>(&call_scene_legacy_723), abi); break;
        case 6u: eax = invoke_fast2(reinterpret_cast<void*>(&scene_transfer_slot_0044b960), spec.a0, abi); break;
        default: require(false, "bad case function");
    }
}

static Spec make_spec(U fn) {
    Spec s{};
    s.fn = fn;
    for (U i = 0u; i < 6u; ++i) {
        s.elements[i] = 0x1000u + i * 0x24u;
    }
    for (U i = 0u; i < kMaxScript; ++i) {
        s.fmt[i] = 0u;
        s.kind[i] = 0u;
    }
    s.arena = 1u;
    s.prefill[9] = 0u;
    return s;
}

static Spec all_cases[kMaxCases];

static U build_cases() {
    Spec* const cases = all_cases;
    U built = 0u;
    // d960: (end-begin)>>2 across zero, positive, negative and odd spans.
    for (U n = 0u; n < 10u; ++n) {
        Spec s = make_spec(0u);
        s.vec_count = n;
        if (n == 9u) {
            // Negative signed span: (end - begin) = -8.
            s.vec_count = static_cast<U>(-2);
        }
        cases[built++] = s;
    }
    // d890: vector length, formatter result, kind result and arena gate.
    for (U n = 0u; n <= 4u; ++n) {
        for (U variant = 0u; variant < 3u; ++variant) {
            Spec s = make_spec(1u);
            s.vec_count = n;
            for (U i = 0u; i < 6u; ++i) {
                s.fmt[i] = (variant == 0u) ? 0u : (0x9000u + i * 4u);
            }
            for (U i = 0u; i < kMaxScript; ++i) {
                s.kind[i] = (variant == 1u) ? 1u : 2u;
            }
            s.arena = (variant == 2u) ? 1u : 0u;
            cases[built++] = s;
        }
    }
    for (U n = 0u; n < 2u; ++n) {
        Spec s = make_spec(1u);
        s.vec_count = 4u;
        s.fmt[0] = 0x8000u;
        s.fmt[1] = 0u;
        s.fmt[2] = 0x9000u;
        s.fmt[3] = 0u;
        s.kind[0] = 7u;
        s.kind[1] = 1u;
        s.arena = n;
        cases[built++] = s;
    }
    // 659e0: both slot indices, both flag bits, both service args.
    const U seconds[4] = {0u, 10u, 0xffffffffu, 0x7fu};
    for (U first = 0u; first < 2u; ++first) {
        for (U f = 0u; f < 4u; ++f) {
            Spec s = make_spec(2u);
            s.a0 = first;
            s.a1 = seconds[f];
            s.slot0 = (f & 1u) != 0u ? 1u : 0u;
            s.slot1 = (f & 2u) != 0u ? 1u : 0u;
            for (U i = 0u; i < 9u; ++i) {
                s.prefill[i] = 0xa0000000u + i * 0x11u;
            }
            cases[built++] = s;
        }
    }
    // 75d70: selector index to + 2*from in {0,1,2,3}.
    for (U from = 0u; from < 2u; ++from) {
        for (U to = 0u; to < 2u; ++to) {
            for (U variant = 0u; variant < 2u; ++variant) {
                Spec s = make_spec(3u);
                s.a0 = from + variant * 4u;
                s.a1 = to;
                // Keep index in range: to + 2*(from+4*variant) <= 3 for variant 0.
                if (variant != 0u) {
                    s.a0 = from;
                    s.arena = static_cast<U>(variant);
                }
                cases[built++] = s;
            }
        }
    }
    // 4fae0 / 521c0: allocation failure and constructor return variants.
    for (U fail = 0u; fail < 2u; ++fail) {
        for (U mode = 0u; mode < 3u; ++mode) {
            Spec s = make_spec(4u);
            s.fail_alloc = fail;
            s.ctor_mode = mode;
            s.a0 = 0x12340000u;
            cases[built++] = s;
            Spec t = make_spec(5u);
            t.fail_alloc = fail;
            t.ctor_mode = mode;
            cases[built++] = t;
        }
    }
    // 4b960: first allocation failure, second allocation failure, success.
    for (U fail = 0u; fail < 3u; ++fail) {
        Spec s = make_spec(6u);
        s.fail_alloc = fail;
        s.a0 = address(pool + 0x400u);
        cases[built++] = s;
    }
    require(built <= kMaxCases, "case capacity");
    return built;
}

int main() {
    require(scene_legacy_address_723() == reinterpret_cast<void*>(&scene_transfer_enter_004521c0), "legacy address identity");
    AddVectoredExceptionHandler(1u, fault_handler);
    // Production initial state is asserted before any fixture reset.
    require(scene_route_root_object_0061bc38 == nullptr, "init route root");
    require(scene_transfer_object_0061bcc0 == nullptr, "init transfer object");
    require(entry_fe_flag_word_006280e0 == 0u &&
            entry_fe_flag_word_006280e4 == 0u &&
            entry_fe_frame_word_00606ad4 == 0u, "init entry words");
    require(scene_elem_vector_00628168 == nullptr &&
            scene_elem_count_vector_00628178 == nullptr, "init vector pointers");
    init_bodies();

    const U case_count = build_cases();
    U count = 0u;
    for (U case_index = 0u; case_index < case_count; ++case_index) {
        const Spec& spec = all_cases[case_index];
        ++count;
        g_case = case_index;
        g_fn = spec.fn;
        g_a0 = spec.a0;
        g_a1 = spec.a1;
        U original_abi = 0u, cpp_abi = 0u, original_eax = 0u, cpp_eax = 0u;
        g_side = 0u;
        reset_runtime(spec);
        invoke_original(spec, original_abi, original_eax);
        Snapshot expected{};
        capture(expected, original_abi, original_eax);

        g_side = 1u;
        reset_runtime(spec);
        invoke_cpp(spec, cpp_abi, cpp_eax);
        Snapshot actual{};
        capture(actual, cpp_abi, cpp_eax);
        assert_same(expected, actual);
    }
    std::printf("entry_fe_scene_leaves_original_x86_vs_cpp=PASS cases=%u\n", count);
    return 0;
}
