struct Snapshot {
    U event_count, abi_fail, eax;
    Event events[kMaxEvents];
    U root_object, transfer_object, e0, e4, ad4;
    U frame[6];
    U slot_bytes[2];
    U arena;
    U header[2];
    U elements[8];
    B pool[kPoolBytes];
    U pool_used, alloc_call, fmt_call, kind_call;
};

static void capture(Snapshot& out, U abi_fail, U eax) {
    out.event_count = event_count;
    out.abi_fail = abi_fail;
    out.eax = eax;
    std::memcpy(out.events, events, event_count * sizeof(Event));
    out.root_object = address(scene_route_root_object_0061bc38);
    out.transfer_object = address(scene_transfer_object_0061bcc0);
    out.e0 = entry_fe_flag_word_006280e0;
    out.e4 = entry_fe_flag_word_006280e4;
    out.ad4 = entry_fe_frame_word_00606ad4;
    out.frame[0] = frame_reset_word_006280f0;
    out.frame[1] = frame_reset_word_006280ec;
    out.frame[2] = frame_reset_word_006280e8;
    out.frame[3] = frame_reset_word_00628100;
    out.frame[4] = frame_reset_word_006280fc;
    out.frame[5] = frame_reset_word_006280f8;
    out.slot_bytes[0] = view_slot_table_00627e80[0xc0u];
    out.slot_bytes[1] = view_slot_table_00627e80[0x1ccu];
    out.arena = application_state_006573e8.word(0x00657430u);
    out.header[0] = vec_header[0];
    out.header[1] = vec_header[1];
    std::memcpy(out.elements, vec_elements, sizeof vec_elements);
    std::memcpy(out.pool, pool, sizeof pool);
    out.pool_used = pool_used;
    out.alloc_call = alloc_call;
    out.fmt_call = fmt_call;
    out.kind_call = kind_call;
}

static void assert_same(const Snapshot& expected, const Snapshot& actual) {
    require(actual.abi_fail == 0u, "original abi");
    if (actual.event_count != expected.event_count) {
        std::printf("counts expected=%u actual=%u exp_eax=%u act_eax=%u fn=%u a0=%u a1=%u\n",
                    expected.event_count, actual.event_count,
                    expected.eax, actual.eax, g_fn, g_a0, g_a1);
        std::printf(" slot exp=%u/%u act=%u/%u arena exp=%u act=%u\n",
                    expected.slot_bytes[0], expected.slot_bytes[1],
                    actual.slot_bytes[0], actual.slot_bytes[1],
                    expected.arena, actual.arena);
        for (U i = 0u; i < expected.event_count && i < 12u; ++i) {
            std::printf(" exp[%u] k=%u a=%u b=%u\n", i, expected.events[i].kind,
                        expected.events[i].a, expected.events[i].b);
        }
        for (U i = 0u; i < actual.event_count && i < 12u; ++i) {
            std::printf(" act[%u] k=%u a=%u b=%u\n", i, actual.events[i].kind,
                        actual.events[i].a, actual.events[i].b);
        }
    }
    require(actual.event_count == expected.event_count, "event count");
    for (U i = 0u; i < expected.event_count; ++i) {
        require(actual.events[i].kind == expected.events[i].kind, "event kind");
        require(actual.events[i].a == expected.events[i].a, "event a");
        require(actual.events[i].b == expected.events[i].b, "event b");
        require(actual.events[i].c == expected.events[i].c, "event c");
        require(actual.events[i].d == expected.events[i].d, "event d");
        require(actual.events[i].e == expected.events[i].e, "event e");
    }
    // Void bodies have an unspecified EAX epilogue value; only value-returning
    // bodies (count/search and the fastcall slot builder) are compared here.
    if (g_fn == 0u || g_fn == 1u || g_fn == 6u) {
        require(actual.eax == expected.eax, "return value");
    }
    require(actual.root_object == expected.root_object, "route root global");
    require(actual.transfer_object == expected.transfer_object, "transfer global");
    require(actual.e0 == expected.e0, "entry flag e0");
    require(actual.e4 == expected.e4, "entry flag e4");
    require(actual.ad4 == expected.ad4, "entry frame ad4");
    for (U i = 0u; i < 6u; ++i) {
        require(actual.frame[i] == expected.frame[i], "frame reset word");
    }
    require(actual.slot_bytes[0] == expected.slot_bytes[0], "slot byte 0");
    require(actual.slot_bytes[1] == expected.slot_bytes[1], "slot byte 1");
    require(actual.arena == expected.arena, "arena flag");
    require(actual.header[0] == expected.header[0] &&
            actual.header[1] == expected.header[1], "vector header");
    require(std::memcmp(actual.elements, expected.elements,
                        sizeof expected.elements) == 0, "vector elements");
    require(std::memcmp(actual.pool, expected.pool, sizeof expected.pool) == 0,
            "control pool");
    require(actual.pool_used == expected.pool_used, "pool use");
    require(actual.alloc_call == expected.alloc_call, "alloc count");
    require(actual.fmt_call == expected.fmt_call, "formatter count");
    require(actual.kind_call == expected.kind_call, "kind count");
}

static U invoke_cdecl0(void* fn, U& fail) {
    U before = 0u, frame = 0u, result = 0u, bad_flag = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0a5a5a500h
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov result, eax
        cmp esp, before
        jne bad_label
        cmp ebp, frame
        jne bad_label
        cmp ebx, 13579bdfh
        jne bad_label
        cmp esi, 2468ace0h
        jne bad_label
        cmp edi, 10203040h
        je done
    bad_label:
        mov bad_flag, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    fail = bad_flag;
    return result;
}

