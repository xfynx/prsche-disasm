static Event events[kMaxEvents];
static U event_count = 0u;
static B pool[kPoolBytes];
static U pool_used = 0u;
static U alloc_call = 0u;
static U fail_alloc_at = 0u;
static U fmt_call = 0u;
static U kind_call = 0u;
static U ctor_mode = 0u;
static U vec_header[2];
static U vec_elements[8];
static U fmt_script[kMaxScript];
static U kind_script[kMaxScript];
static B* code = nullptr;

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load_dword(const void* p, U offset = 0u) {
    U value = 0u;
    std::memcpy(&value, static_cast<const B*>(p) + offset, 4u);
    return value;
}

static void store_dword(void* p, U offset, U value) {
    std::memcpy(static_cast<B*>(p) + offset, &value, 4u);
}

static U g_case = 0u;
static U g_side = 0u;
static U g_fn = 0u;
static U g_a0 = 0u;
static U g_a1 = 0u;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", why, g_case, g_side);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx events=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip,
                event_count);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void record(U kind, U a, U b, U c, U d, U e) {
    require(event_count < kMaxEvents, "event overflow");
    Event& out = events[event_count++];
    out.kind = kind;
    out.a = a;
    out.b = b;
    out.c = c;
    out.d = d;
    out.e = e;
}

// ---- Controlled opaque callees (the same functions both sides call) ---------
void* __cdecl porsche::render_allocate_0059ef90(U size) {
    ++alloc_call;
    U result = 0u;
    if (alloc_call != fail_alloc_at && pool_used + size <= kPoolBytes) {
        result = address(pool + pool_used);
        pool_used += size;
        std::memset(pool + pool_used - size, 0xcc, size);
    }
    record(kEvAlloc, size, result, alloc_call, 0u, 0u);
    return reinterpret_cast<void*>(result);
}

void* __cdecl porsche::scene_slot_object_004211d0(U size, U zero) {
    U result = 0u;
    if (pool_used + 0x40u <= kPoolBytes) {
        result = address(pool + pool_used);
        pool_used += 0x40u;
        std::memset(pool + pool_used - 0x40u, 0, 0x40u);
    }
    record(kEvSlotObject, size, zero, result, 0u, 0u);
    return reinterpret_cast<void*>(result);
}

void* __fastcall porsche::scene_root_constructor_0044fb40(void* self, void* unused_edx,
                                                           void* root) {
    (void)unused_edx;
    U result = ctor_mode == 0u ? address(self)
             : ctor_mode == 1u ? address(pool + 0x500u)
                               : 0u;
    record(kEvRootCtor, address(self), address(root), result, 0u, 0u);
    return reinterpret_cast<void*>(result);
}

void* __fastcall porsche::scene_stage_constructor_004522b0(void* self, void* unused_edx) {
    (void)unused_edx;
    U result = ctor_mode == 0u ? address(self)
             : ctor_mode == 1u ? address(pool + 0x540u)
                               : 0u;
    record(kEvStageCtor, address(self), result, 0u, 0u, 0u);
    return reinterpret_cast<void*>(result);
}

U __cdecl porsche::formatter_compare_005a134b(U element, U arg1, const void* scene_rtti,
                                              const void* camera_rtti, U arg4) {
    const U result = fmt_call < kMaxScript ? fmt_script[fmt_call] : 0u;
    record(kEvFormatter, element, arg1, address(scene_rtti),
           address(camera_rtti), arg4);
    ++fmt_call;
    return result;
}

U __fastcall porsche::scene_elem_kind_00469b50(void* object, void* unused_edx) {
    (void)unused_edx;
    const U result = kind_call < kMaxScript ? kind_script[kind_call] : 0u;
    record(kEvElemKind, address(object), result, 0u, 0u, 0u);
    ++kind_call;
    return result;
}

void __cdecl porsche::entry_fe_service_00465790(U first, U second) {
    record(kEvFeService, first, second, 0u, 0u, 0u);
}

void __cdecl porsche::scene_route_dispatch_00475c80(U value) {
