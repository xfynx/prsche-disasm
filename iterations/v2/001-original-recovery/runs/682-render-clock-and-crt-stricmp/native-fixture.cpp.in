static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U rd(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void wr(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", msg, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode,
                p->ContextRecord->Eip,
                cases,
                which);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void push_event(U kind, U a0 = 0u, U a1 = 0u) {
    if (trace.count < kMaxEvents) {
        Event& ev = trace.events[trace.count++];
        ev.kind = kind;
        ev.a0 = a0;
        ev.a1 = a1;
    }
}

static I __stdcall stub_qpf(I64* frequency) {
    require(frequency != nullptr, "qpf frequency nonnull");
    *frequency = cfg.qpf_freq;
    push_event(kEvQpf, static_cast<U>(cfg.qpf_freq), static_cast<U>(cfg.qpf_ret));
    return cfg.qpf_ret;
}

static I __stdcall stub_get_version_ex_a(void* version_information) {
    require(version_information != nullptr, "osvi nonnull");
    const U size_field = rd(version_information, 0u);
    require(size_field == 0x94u, "osvi size == 0x94");
    wr(version_information, 0x04u, cfg.os_major);
    wr(version_information, 0x08u, cfg.os_minor);
    wr(version_information, 0x0cu, cfg.os_build);
    wr(version_information, 0x10u, cfg.os_platform);
    push_event(kEvGetVersionEx, cfg.os_platform, cfg.os_minor);
    return cfg.os_ret;
}

namespace porsche {

int __cdecl formatter_float_classify_005a2eae(int c, int mask) {
    push_event(kEvClassify, static_cast<U>(c), static_cast<U>(mask));
    const U entry = classify_table[static_cast<U>(c) & 0xffu];
    return ((entry & static_cast<U>(mask)) != 0u) ? static_cast<int>(entry) : 0;
}

std::uint32_t __cdecl cpu_check_cpuid_support_00574e50() {
    push_event(kEvCpuidSupport, cfg.cpuid_support, 0u);
    return cfg.cpuid_support;
}

void __cdecl cpu_query_cpuid_00574e6b(std::uint32_t* out_regs, std::uint32_t leaf) {
    require(out_regs != nullptr, "cpuid out_regs nonnull");
    push_event(kEvCpuidQuery, leaf, 0u);
    out_regs[0] = 0u;
    out_regs[1] = 0u;
    out_regs[2] = 0u;
    out_regs[3] = 0u;
    if (leaf == 0u) {
        out_regs[0] = static_cast<U>(cfg.max_leaf);
        std::memcpy(&out_regs[1], cfg.vendor + 0, 4u);
        std::memcpy(&out_regs[2], cfg.vendor + 4, 4u);
        std::memcpy(&out_regs[3], cfg.vendor + 8, 4u);
    } else if (leaf == 1u) {
        out_regs[0] = cfg.leaf1_eax;
        out_regs[2] = cfg.leaf1_edx;
    } else if (leaf == 2u) {
        out_regs[0] = 0x01020304u;
    } else if (leaf == 3u) {
        out_regs[1] = cfg.leaf3_ebx;
        out_regs[2] = cfg.leaf3_edx;
        out_regs[3] = cfg.leaf3_ecx;
    } else if (leaf == 0x80000000u) {
        out_regs[0] = cfg.ext_max_leaf;
    } else if (leaf == 0x80000001u) {
        out_regs[2] = cfg.ext1_edx;
    }
}

std::uint32_t __cdecl cpu_check_div_flags_00574e89() {
    push_event(kEvDivFlags, cfg.div_flags_ret, 0u);
    return cfg.div_flags_ret;
}

const char* __cdecl application_diagnostic_environment_005a3050(const char* name) {
    require(name != nullptr, "env name nonnull");
    if (std::strcmp(name, "ISMMX") == 0) {
        push_event(kEvEnv, 1u, cfg.env_mmx != nullptr ? 1u : 0u);
        return cfg.env_mmx;
    }
    if (std::strcmp(name, "ISK3D") == 0) {
        push_event(kEvEnv, 2u, cfg.env_k3d != nullptr ? 1u : 0u);
        return cfg.env_k3d;
    }
    if (std::strcmp(name, "ISKNI") == 0) {
        push_event(kEvEnv, 3u, cfg.env_kni != nullptr ? 1u : 0u);
        return cfg.env_kni;
    }
    if (std::strcmp(name, "ISMOVNT") == 0) {
        push_event(kEvEnv, 4u, cfg.env_movnt != nullptr ? 1u : 0u);
        return cfg.env_movnt;
    }
    push_event(kEvEnv, 99u, 0u);
    return nullptr;
}

