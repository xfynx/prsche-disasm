    porsche::cpu_has_movnt_005deb2c = 0xbcbcbcbcu;
    porsche::copy_flag_005deb30 = 0xdedededeu;
    porsche::cpu_is_cyrix_005deb34 = 0xf0f0f0f0u;
    porsche::cpu_is_amd_005deb38 = 0x01020304u;
    porsche::cpu_is_centaur_005deb3c = 0x05060708u;
}

static void capture_globals() {
    trace.clock_hz = porsche::render_clock_hz_005deae4;
    std::memcpy(trace.vendor, porsche::cpu_vendor_005deae8, sizeof trace.vendor);
    std::memcpy(trace.serial, porsche::cpu_serial_005deaf8, sizeof trace.serial);
    trace.family = porsche::cpu_family_005deb04;
    trace.model = porsche::cpu_model_005deb08;
    trace.stepping = porsche::cpu_stepping_005deb0c;
    trace.flag_p5 = porsche::copy_flag_005deb10;
    trace.flag_p6 = porsche::cpu_has_p6_005deb14;
    trace.flag_mmx = porsche::copy_flag_005deb18;
    trace.flag_kni = porsche::shared_runtime_word_005deb1c;
    trace.flag_3dnow = porsche::cpu_has_3dnow_005deb20;
    trace.flag_rdtsc = porsche::cpu_has_rdtsc_005deb24;
    trace.flag_cmov = porsche::cpu_has_cmov_005deb28;
    trace.flag_movnt = porsche::cpu_has_movnt_005deb2c;
    trace.flag_intel = porsche::copy_flag_005deb30;
    trace.flag_cyrix = porsche::cpu_is_cyrix_005deb34;
    trace.flag_amd = porsche::cpu_is_amd_005deb38;
    trace.flag_centaur = porsche::cpu_is_centaur_005deb3c;
}

static void assert_traces_match() {
    require(expected.abi_fail == 0u, "original abi fail");
    require(trace.abi_fail == 0u, "cpp abi fail");
    require(expected.df_nonzero == 0u, "original df nonzero");
    require(trace.df_nonzero == 0u, "cpp df nonzero");
    require(trace.ret_i32 == expected.ret_i32, "return i32");
    require(trace.ret_u32 == expected.ret_u32, "return u32");
    require(trace.count == expected.count, "event count");
    require(std::memcmp(trace.events, expected.events, trace.count * sizeof(Event)) == 0,
            "event trace");
    require(trace.clock_hz == expected.clock_hz, "clock_hz");
    require(std::memcmp(trace.vendor, expected.vendor, sizeof trace.vendor) == 0, "vendor");
    require(std::memcmp(trace.serial, expected.serial, sizeof trace.serial) == 0, "serial");
    require(trace.family == expected.family, "family");
    require(trace.model == expected.model, "model");
    require(trace.stepping == expected.stepping, "stepping");
    require(trace.flag_p5 == expected.flag_p5, "flag p5");
    require(trace.flag_p6 == expected.flag_p6, "flag p6");
    require(trace.flag_mmx == expected.flag_mmx, "flag mmx");
    require(trace.flag_kni == expected.flag_kni, "flag kni");
    require(trace.flag_3dnow == expected.flag_3dnow, "flag 3dnow");
    require(trace.flag_rdtsc == expected.flag_rdtsc, "flag rdtsc");
    require(trace.flag_cmov == expected.flag_cmov, "flag cmov");
    require(trace.flag_movnt == expected.flag_movnt, "flag movnt");
    require(trace.flag_intel == expected.flag_intel, "flag intel");
    require(trace.flag_cyrix == expected.flag_cyrix, "flag cyrix");
    require(trace.flag_amd == expected.flag_amd, "flag amd");
    require(trace.flag_centaur == expected.flag_centaur, "flag centaur");
}

static void run_str_parse(bool use_atoi, I char_width, const char* input) {
    ++cases;
    void* const orig_fn = use_atoi ? slot_5a1f4a : slot_5a1ebf;
    void* const cpp_fn = use_atoi
        ? reinterpret_cast<void*>(&porsche::crt_atoi_005a1f4a)
        : reinterpret_cast<void*>(&porsche::crt_atol_005a1ebf);
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        poison_globals();
        porsche::formatter_float_character_width_005e54dc = char_width;
        porsche::formatter_ctype_table_005e52d0 = ctype_table;
        std::memset(&trace, 0, sizeof trace);
        void* const fn = (side == 0u) ? orig_fn : cpp_fn;
        trace.ret_i32 = invoke_cdecl1(fn, address(input), trace.abi_fail, trace.df_nonzero);
        trace.ret_u32 = static_cast<U>(trace.ret_i32);
        capture_globals();
        if (side == 0u) {
            expected = trace;
        }
    }
    assert_traces_match();
}

static void run_render_clock(const CpuStubCfg& c, bool via_mode_forward) {
    ++cases;
    void* const cpp_fn = via_mode_forward
        ? reinterpret_cast<void*>(&porsche::render_mode_clock_00555bc0)
        : reinterpret_cast<void*>(&porsche::render_clock_00555bc0);
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        cfg = c;
        poison_globals();
        porsche::formatter_float_character_width_005e54dc = 1;
        porsche::formatter_ctype_table_005e52d0 = ctype_table;
        std::memset(&trace, 0, sizeof trace);
        void* const fn = (side == 0u) ? slot_555bc0 : cpp_fn;
        trace.ret_u32 = invoke_cdecl0(fn, trace.abi_fail, trace.df_nonzero);
        trace.ret_i32 = static_cast<I>(trace.ret_u32);
        capture_globals();
        if (side == 0u) {
            expected = trace;
        }
    }
    assert_traces_match();
}

static U make_leaf1_eax(U family, U model, U stepping) {
    return ((family & 0xfu) << 8) | ((model & 0xfu) << 4) | (stepping & 0xfu);
}

static U make_leaf1_edx(bool rdtsc, bool cmov, bool mmx, bool sse) {
    return (rdtsc ? (1u << 4) : 0u)
         | (cmov ? (1u << 15) : 0u)
         | (mmx ? (1u << 23) : 0u)
         | (sse ? (1u << 25) : 0u);
}

int main(int argc, char**) {
    if (argc < 1) {
        return 2;
    }
    AddVectoredExceptionHandler(1u, fault_handler);

    // Production initial state checks before fixture mutations.
    require(porsche::render_clock_hz_005deae4 == 0u, "initial 005deae4 == 0");
    for (U i = 0u; i < 16u; ++i) {
        require(porsche::cpu_vendor_005deae8[i] == 0, "initial 005deae8 == 0");
    }
    for (U i = 0u; i < 3u; ++i) {
        require(porsche::cpu_serial_005deaf8[i] == 0u, "initial 005deaf8 == 0");
    }
    require(porsche::cpu_family_005deb04 == 0u, "initial 005deb04 == 0");
    require(porsche::cpu_model_005deb08 == 0u, "initial 005deb08 == 0");
    require(porsche::cpu_stepping_005deb0c == 0u, "initial 005deb0c == 0");
    require(porsche::cpu_has_3dnow_005deb20 == 0u, "initial 005deb20 == 0");
    require(porsche::cpu_has_cmov_005deb28 == 0u, "initial 005deb28 == 0");
    require(porsche::cpu_has_movnt_005deb2c == 0u, "initial 005deb2c == 0");
    require(porsche::cpu_is_centaur_005deb3c == 0u, "initial 005deb3c == 0");
    require(porsche::render_clock_get_version_ex_a != nullptr, "default GetVersionExA nonnull");
    {
        B osvi[0x94] = {};
        wr(osvi, 0u, 0x94u);
        require(porsche::render_clock_get_version_ex_a(osvi) != 0, "default host GetVersionExA");
    }

    init_tables();
    init_fixture();
    porsche::render_clock_query_performance_frequency = stub_qpf;
    porsche::render_clock_get_version_ex_a = stub_get_version_ex_a;

    // 1. 005a1ebf (atol) and 005a1f4a (atoi) across width <= 1 and width > 1.
    static const char* const str_inputs[] = {
        "",
        "   \t\n\r\v\f",
        "0",
        "-0",
        "+0",
        "42",
        "  \t+42xyz",
        "  \r-42xyz",
        "--42",
        "-+42",
        "+-42",
        "- 42",
        "+ 42",
        "0000123",
        "2147483647",
        "-2147483648",
        "2147483648",
        "-2147483649",
        "999999999999",
        "-999999999999",
        "A123",
        "\x85\x85+12\xa3",
        "\x85-\xa3\x34",
        "\x86\x39",
    };
    static const I widths[] = {-1, 0, 1, 2};
    for (I w : widths) {
        for (const char* s : str_inputs) {
            run_str_parse(false, w, s);
            run_str_parse(true, w, s);
        }
    }

    // 2. 00555bc0: no CPUID support + div_flags 0 / 1 + QPF 0 / nonzero.
    {
        CpuStubCfg base{};
        std::memcpy(base.vendor, "GenuineIntel", 13);
        base.cpuid_support = 0u;
        base.div_flags_ret = 0u;
        base.qpf_freq = 0;
        base.qpf_ret = 1;
        base.rdtsc_hz = 450000000;
        base.div_hz = 233000000;
        run_render_clock(base, false);

        base.div_flags_ret = 1u;
        base.qpf_freq = 10000000;
        run_render_clock(base, false);

        // High 32 bits non-zero, low 32 bits zero: must skip measurement and call quantize(0).
        base.qpf_freq = static_cast<I64>(0x0000000100000000ULL);
        run_render_clock(base, false);
    }

    // 3. 00555bc0: CPUID supported with max_leaf <= 0 (0 and -1).
    for (I max_leaf : {-1, 0}) {
        CpuStubCfg c{};
        std::memcpy(c.vendor, "GenuineIntel", 13);
        c.cpuid_support = 1u;
        c.max_leaf = max_leaf;
        c.qpf_freq = 3579545;
        c.qpf_ret = 1;
        c.rdtsc_hz = 500000000;
        c.div_hz = 166000000;
        run_render_clock(c, false);
    }

    // 4. 00555bc0: All vendors, family thresholds (4, 5, 6), feature bits, extended CPUID,
    // OS version checks (Win95 vs Win98 vs WinNT), env overrides, leaf 2, leaf 3, and forwarding.
    static const char* const vendors[] = {
        "GenuineIntel",
        "AuthenticAMD",
        "CyrixInstead",
        "CentaurHauls",
        "UnknownCpuId",
    };
    for (const char* v : vendors) {
        for (U fam : {4u, 5u, 6u}) {
            CpuStubCfg c{};
            std::memcpy(c.vendor, v, 13);
            c.cpuid_support = 1u;
            c.max_leaf = (fam == 6u) ? 3 : 1;
            c.leaf1_eax = make_leaf1_eax(fam, 3u, 7u);
            c.leaf1_edx = make_leaf1_edx(fam >= 5u, fam >= 6u, fam >= 5u, fam >= 6u && v[0] == 'G');
            c.ext_max_leaf = (v[0] == 'A') ? 0x80000001u : 0x80000000u;
            c.ext1_edx = (v[0] == 'A') ? 0x80000000u : 0u;
            c.leaf3_ecx = 0x11223344u;
            c.leaf3_edx = 0x55667788u;
            c.leaf3_ebx = 0x99aabbcdu;
            c.os_major = 4u;
            c.os_minor = 10u;
            c.os_platform = 1u;
            c.os_ret = 1;
            c.qpf_freq = 10000000;
            c.qpf_ret = 1;
            c.rdtsc_hz = 733000000;
            c.div_hz = 133000000;
            run_render_clock(c, false);
        }
    }

    // Leaf 2 only (max_leaf == 2) + extended 0x7fffffff + Win95 clears SSE + WinNT keeps SSE.
    {
        CpuStubCfg c{};
        std::memcpy(c.vendor, "GenuineIntel", 13);
        c.cpuid_support = 1u;
        c.max_leaf = 2;
        c.leaf1_eax = make_leaf1_eax(6u, 8u, 1u);
        c.leaf1_edx = make_leaf1_edx(true, true, true, true);
        c.ext_max_leaf = 0x7fffffffu;
        c.ext1_edx = 0x80000000u;
        c.os_major = 4u;
        c.os_minor = 0u;
        c.os_platform = 1u; // Win95: clears 005deb1c
        c.os_ret = 1;
        c.qpf_freq = 10000000;
        c.qpf_ret = 1;
        c.rdtsc_hz = 800000000;
        c.div_hz = 200000000;
        run_render_clock(c, false);

        // Win95 + ISKNI env override restores 005deb1c, plus all 4 env overrides with whitespace/signs.
        c.env_mmx = "  +0 ";
        c.env_k3d = "\t1";
        c.env_kni = " 1 ";
        c.env_movnt = " -1 ";
        c.max_leaf = 3;
        c.leaf3_ecx = 0x0a0b0c0du;
        c.leaf3_edx = 0x0e0f1011u;
        c.leaf3_ebx = 0x12131415u;
        run_render_clock(c, false);

        // WinNT + no RDTSC uses measure_div_loop, plus render_mode_clock_00555bc0 forwarding.
        c.leaf1_edx = make_leaf1_edx(false, true, true, true);
        c.env_mmx = nullptr;
        c.env_k3d = nullptr;
        c.env_kni = nullptr;
        c.env_movnt = nullptr;
        c.os_major = 5u;
        c.os_minor = 0u;
        c.os_platform = 2u;
        run_render_clock(c, true);
    }

    // Extended max_leaf == 0x80000000 (unsigned boundary: must NOT query 0x80000001).
    {
        CpuStubCfg c{};
        std::memcpy(c.vendor, "AuthenticAMD", 13);
        c.cpuid_support = 1u;
        c.max_leaf = 1;
        c.leaf1_eax = make_leaf1_eax(6u, 1u, 2u);
        c.leaf1_edx = make_leaf1_edx(true, true, true, false);
        c.ext_max_leaf = 0x80000000u;
        c.ext1_edx = 0x80000000u;
        c.os_major = 5u;
        c.os_minor = 1u;
        c.os_platform = 2u;
        c.os_ret = 1;
        c.qpf_freq = 10000000;
        c.qpf_ret = 1;
        c.rdtsc_hz = 900000000;
        c.div_hz = 250000000;
        run_render_clock(c, false);
    }

    std::printf("render_clock_stricmp_682_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
