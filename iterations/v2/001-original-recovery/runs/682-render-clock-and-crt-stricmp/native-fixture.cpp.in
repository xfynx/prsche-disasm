}

std::int32_t __cdecl render_clock_quantize_hz_00555a10(std::int32_t raw_hz) {
    push_event(kEvQuantize, static_cast<U>(raw_hz), 0u);
    return static_cast<I>(static_cast<U>(raw_hz) + 12345u);
}

