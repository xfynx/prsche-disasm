static U invoke_cdecl0(void* fn, U& abi_fail, U& df_bad) {
    U out = 0u;
    U fail = 0u;
    U df = 0u;
    U before = 0u;
    U frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        pushfd
        pop eax
        test eax, 00000400h
        jz df_ok
        mov df, 1
df_ok:
        cld
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
    df_bad = df;
    return out;
}

static I invoke_cdecl1(void* fn, U arg0, U& abi_fail, U& df_bad) {
    I out = 0;
    U fail = 0u;
    U df = 0u;
    U before = 0u;
    U frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        add esp, 4
        pushfd
        pop eax
        test eax, 00000400h
        jz df_ok
        mov df, 1
df_ok:
        cld
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
    df_bad = df;
    return out;
}

static void relocate_abs(B* p, U n, U old_va, U replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 4u <= n; ++i) {
        if (rd(p, i) == old_va) {
            wr(p, i, replacement);
            ++found;
            i += 3u;
        }
    }
    require(found == expected_count, "abs relocation count");
}

static void relocate_rel(B* p, U n, U va_base, U target_va, U replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 5u <= n; ++i) {
        if (p[i] == 0xe8u && (va_base + i + 5u + rd(p, i + 1u)) == target_va) {
            wr(p, i + 1u, replacement - (address(p) + i + 5u));
            ++found;
            i += 4u;
        }
    }
    require(found == expected_count, "rel relocation count");
}

static void init_tables() {
    std::memset(ctype_table, 0, sizeof ctype_table);
    std::memset(classify_table, 0, sizeof classify_table);

    for (U c = '0'; c <= '9'; ++c) {
        ctype_table[c * 2u] = 0x04u;
        classify_table[c] = 0x04u;
    }
    const char spaces[] = {' ', '\t', '\n', '\r', '\v', '\f'};
    for (char sc : spaces) {
        const U c = static_cast<unsigned char>(sc);
        ctype_table[c * 2u] = 0x08u;
        classify_table[c] = 0x08u;
    }
    // High-byte and non-space/non-digit bit checks.
    ctype_table[0x41u * 2u] = 0x01u; // 'A': upper, not space/digit
    ctype_table[0x85u * 2u] = 0x08u; // custom space byte > 127
    ctype_table[0xa3u * 2u] = 0x04u; // custom digit byte > 127
    ctype_table[0x86u * 2u] = 0x10u; // non-8, non-4 bit

    classify_table[0x41u] = 0x01u;
    classify_table[0x85u] = 0x108u; // bit 8 + _SPACE (0x08)
    classify_table[0xa3u] = 0x204u; // bit 9 + _DIGIT (0x04)
    classify_table[0x86u] = 0x10u;
}

