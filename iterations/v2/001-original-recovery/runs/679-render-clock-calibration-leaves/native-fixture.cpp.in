static StubCfg cfg{};
static U qpc_counter_val = 0u;
static U qpc_base_val = 0u;
static U qpc_phase = 0u;
static U qpc_iter_polls = 0u;
static Trace trace{};
static Trace expected{};
static U cases = 0u;
static U which = 0u;

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U rd(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void wr(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", msg, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode,
                p->ContextRecord->Eip,
                cases,
                which);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void seed_fpu() {
    const unsigned short cw = 0x037fu;
    const U mx = 0x1f80u;
    __asm {
        fninit
        fldcw cw
        ldmxcsr mx
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static void capture_fpu(FpuSnapshot& fp) {
    std::memset(&fp, 0, sizeof fp);
    std::memset(fp_area, 0, sizeof fp_area);
    __asm {
        fxsave fp_area
        fnstenv fp_env
        fldenv fp_env
    }
    fp.control = static_cast<unsigned short>(rd(fp_area, 0u));
    fp.status = static_cast<unsigned short>(rd(fp_area, 2u));
    fp.tag = static_cast<unsigned short>(rd(fp_env, 8u));
    fp.pad = 0u;
    fp.mxcsr = rd(fp_area, 24u);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((static_cast<U>(fp.status) >> 11u) + i) & 7u;
        if ((fp_area[4u] & (1u << physical)) != 0u) {
            std::memcpy(fp.values + i * 10u, fp_area + 32u + i * 16u, 10u);
        }
    }
}

static void push_event(U kind, U a0 = 0u, U a1 = 0u) {
    if (trace.count < kMaxEvents) {
        Event& ev = trace.events[trace.count++];
        ev.kind = kind;
        ev.a0 = a0;
        ev.a1 = a1;
    }
}

static I __stdcall stub_qpf(I64* frequency) {
    ++trace.qpf_calls;
    require(frequency != nullptr, "qpf frequency nonnull");
    *frequency = cfg.qpf_freq;
    push_event(kEvQpf, static_cast<U>(cfg.qpf_freq), static_cast<U>(cfg.qpf_ret));
    return cfg.qpf_ret;
}

static I __stdcall stub_qpc(I64* performance_count) {
    ++trace.qpc_calls;
    if (performance_count == nullptr) {
        trace.qpc_null_seen = 1u;
        return 0;
    }

    U out_low = 0u;
    if (cfg.qpc_mode == kQpcStepEveryCall) {
        qpc_counter_val += cfg.qpc_step;
        out_low = qpc_counter_val;
    } else if (cfg.qpc_mode == kQpcScriptedPerIter) {
        // Phase 0: initial start_qpc
        // Phase 1: poll loop 1 (equal_polls equal, neg_polls negative, then +1)
        // Phase 2: t0_qpc
        // Phase 3: poll loop 2 (equal_polls equal, neg_polls negative, then +step)
        if (qpc_phase == 0u) {
            qpc_counter_val += 100u;
            qpc_base_val = qpc_counter_val;
            out_low = qpc_base_val;
            qpc_iter_polls = 0u;
            qpc_phase = 1u;
        } else if (qpc_phase == 1u) {
            if (qpc_iter_polls < cfg.qpc_equal_polls) {
                out_low = qpc_base_val;
                ++qpc_iter_polls;
            } else if (qpc_iter_polls < cfg.qpc_equal_polls + cfg.qpc_neg_polls) {
                out_low = qpc_base_val - 2u;
                ++qpc_iter_polls;
            } else {
                qpc_counter_val = qpc_base_val + 1u;
                out_low = qpc_counter_val;
                qpc_phase = 2u;
            }
        } else if (qpc_phase == 2u) {
            qpc_counter_val += 10u;
            qpc_base_val = qpc_counter_val;
            out_low = qpc_base_val;
            qpc_iter_polls = 0u;
            qpc_phase = 3u;
        } else {
            if (qpc_iter_polls < cfg.qpc_equal_polls) {
                out_low = qpc_base_val;
                ++qpc_iter_polls;
            } else if (qpc_iter_polls < cfg.qpc_equal_polls + cfg.qpc_neg_polls) {
                out_low = qpc_base_val - 3u;
                ++qpc_iter_polls;
            } else {
                qpc_counter_val = qpc_base_val + cfg.qpc_step;
                out_low = qpc_counter_val;
                qpc_phase = 0u;
            }
        }
    } else if (cfg.qpc_mode == kQpcTimeoutLoop1Iter0) {
        if (trace.qpc_calls <= 1000001u) {
            out_low = 0x1000u;
        } else {
            qpc_counter_val += cfg.qpc_step;
            out_low = qpc_counter_val;
        }
    } else if (cfg.qpc_mode == kQpcTimeoutLoop2Iter0) {
        if (trace.qpc_calls == 1u) {
            out_low = 0x1000u;
        } else if (trace.qpc_calls == 2u) {
            out_low = 0x1001u;
        } else if (trace.qpc_calls <= 1000003u) {
            out_low = 0x2000u;
        } else {
            qpc_counter_val += cfg.qpc_step;
            out_low = qpc_counter_val;
        }
    }

    *performance_count =
        (static_cast<I64>(0x12345678u) << 32) | static_cast<I64>(out_low);
    if (cfg.log_qpc != 0u) {
        push_event(kEvQpc, out_low, 0u);
    }
    return static_cast<I>(out_low ^ 0x5a5a0001u);
}

