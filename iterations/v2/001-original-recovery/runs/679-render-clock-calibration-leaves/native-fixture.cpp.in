static I invoke_cdecl0(void* fn, FpuSnapshot& fp_out, U& abi_fail, U& df_bad) {
    I out = 0;
    U fail = 0u;
    U df = 0u;
    U before = 0u;
    U frame = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        pushfd
        pop eax
        test eax, 00000400h
        jz df_ok
        mov df, 1
df_ok:
        cld
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
    df_bad = df;
    return out;
}

static I invoke_cdecl1(void* fn, U arg0, FpuSnapshot& fp_out, U& abi_fail, U& df_bad) {
    I out = 0;
    U fail = 0u;
    U df = 0u;
    U before = 0u;
    U frame = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        add esp, 4
        pushfd
        pop eax
        test eax, 00000400h
        jz df_ok
        mov df, 1
df_ok:
        cld
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
    df_bad = df;
    return out;
}

static void relocate_abs(B* p, U n, U old_va, U replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 4u <= n; ++i) {
        if (rd(p, i) == old_va) {
            wr(p, i, replacement);
            ++found;
            i += 3u;
        }
    }
    require(found == expected_count, "abs relocation count");
}

static void relocate_rel(B* p, U n, U va_base, U target_va, U replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 5u <= n; ++i) {
        if (p[i] == 0xe8u && (va_base + i + 5u + rd(p, i + 1u)) == target_va) {
            wr(p, i + 1u, replacement - (address(p) + i + 5u));
            ++found;
            i += 4u;
        }
    }
    require(found == expected_count, "rel relocation count");
}

static void init_fixture() {
    static const B body_555a10[431] = {@BODY_00555A10@};
    static const B body_555fa0[270] = {@BODY_00555FA0@};
    static const B body_5560b0[278] = {@BODY_005560B0@};

    code = static_cast<B*>(
        VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc code");

    slot_555a10 = code + 0x000u;
    slot_555fa0 = code + 0x200u;
    slot_5560b0 = code + 0x380u;

    std::memcpy(slot_555a10, body_555a10, sizeof body_555a10);
    std::memcpy(slot_555fa0, body_555fa0, sizeof body_555fa0);
    std::memcpy(slot_5560b0, body_5560b0, sizeof body_5560b0);

    // 00555a10 relocations (18 total .rdata refs)
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005b3f30u, address(rdata_5b3f30), 1u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005b2468u, address(rdata_5b2468), 3u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005b2408u, address(rdata_5b2408), 1u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005bc374u, address(rdata_5bc374), 1u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005bc370u, address(rdata_5bc370), 1u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005b27a4u, address(rdata_5b27a4), 3u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005b24c0u, address(rdata_5b24c0), 3u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005bc368u, address(rdata_5bc368), 3u);
    relocate_abs(slot_555a10, sizeof body_555a10, 0x005b24a8u, address(rdata_5b24a8), 2u);

    // 00555fa0 relocations (IAT slots + 005deb24)
    iat_qpf = reinterpret_cast<void*>(&stub_qpf);
    iat_qpc = reinterpret_cast<void*>(&stub_qpc);
    relocate_abs(slot_555fa0, sizeof body_555fa0, 0x005b214cu, address(&iat_qpf), 1u);
    relocate_abs(slot_555fa0, sizeof body_555fa0, 0x005b2154u, address(&iat_qpc), 1u);
    relocate_abs(
        slot_555fa0, sizeof body_555fa0, 0x005deb24u, address(&porsche::cpu_has_rdtsc_005deb24), 2u);

    // 005560b0 relocations (calls + globals + .rdata)
    relocate_rel(slot_5560b0, sizeof body_5560b0, 0x005560b0u, 0x0053c380u,
                 address(reinterpret_cast<void*>(&stub_wait_orig)), 1u);
    relocate_rel(slot_5560b0, sizeof body_5560b0, 0x005560b0u, 0x0053c2e0u,
                 address(reinterpret_cast<void*>(&stub_clock_orig)), 1u);
    relocate_abs(
        slot_5560b0, sizeof body_5560b0, 0x005deb48u, address(&porsche::timer_rate_005deb48), 1u);
    relocate_abs(slot_5560b0, sizeof body_5560b0, 0x006b7c7cu,
                 address(&porsche::clock_worker_iterations_006b7c7c), 2u);
    relocate_abs(
        slot_5560b0, sizeof body_5560b0, 0x005deb38u, address(&porsche::cpu_is_amd_005deb38), 1u);
    relocate_abs(
        slot_5560b0, sizeof body_5560b0, 0x005deb14u, address(&porsche::cpu_has_p6_005deb14), 1u);
    relocate_abs(
        slot_5560b0, sizeof body_5560b0, 0x005deb10u, address(&porsche::copy_flag_005deb10), 1u);
    relocate_abs(
        slot_5560b0, sizeof body_5560b0, 0x005deb34u, address(&porsche::cpu_is_cyrix_005deb34), 1u);
    relocate_abs(slot_5560b0, sizeof body_5560b0, 0x005bc3d8u, address(rdata_5bc3d8), 1u);
    relocate_abs(slot_5560b0, sizeof body_5560b0, 0x005bc3dcu, address(rdata_5bc3dc), 1u);
    relocate_abs(slot_5560b0, sizeof body_5560b0, 0x005bc3e0u, address(rdata_5bc3e0), 1u);
