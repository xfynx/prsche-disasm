static void capture_globals() {
    trace.flag_p6 = porsche::cpu_has_p6_005deb14;
    trace.flag_rdtsc = porsche::cpu_has_rdtsc_005deb24;
    trace.flag_pentium = porsche::copy_flag_005deb10;
    trace.flag_cyrix = porsche::cpu_is_cyrix_005deb34;
    trace.flag_amd = porsche::cpu_is_amd_005deb38;
    trace.timer_rate = porsche::timer_rate_005deb48;
    trace.clock_iter = porsche::clock_worker_iterations_006b7c7c;
}

static void assert_traces_match(bool check_events) {
    require(expected.abi_fail == 0u, "original abi fail");
    require(trace.abi_fail == 0u, "cpp abi fail");
    require(expected.df_nonzero == 0u, "original df nonzero");
    require(trace.df_nonzero == 0u, "cpp df nonzero");
    require(trace.ret_i32 == expected.ret_i32, "return i32");
    require(trace.qpf_calls == expected.qpf_calls, "qpf call count");
    require(trace.qpc_calls == expected.qpc_calls, "qpc call count");
    require(trace.qpc_null_seen == expected.qpc_null_seen, "qpc null");
    if (check_events) {
        require(trace.count == expected.count, "event count");
        require(std::memcmp(trace.events, expected.events, trace.count * sizeof(Event)) == 0,
                "event trace");
    }
    require(trace.flag_p6 == expected.flag_p6, "flag p6");
    require(trace.flag_rdtsc == expected.flag_rdtsc, "flag rdtsc");
    require(trace.flag_pentium == expected.flag_pentium, "flag pentium");
    require(trace.flag_cyrix == expected.flag_cyrix, "flag cyrix");
    require(trace.flag_amd == expected.flag_amd, "flag amd");
    require(trace.timer_rate == expected.timer_rate, "timer rate");
    require(trace.clock_iter == expected.clock_iter, "clock iter");
    require(trace.fp.control == expected.fp.control, "fpu control");
    require((expected.fp.status & 0x3800u) == 0u && (trace.fp.status & 0x3800u) == 0u,
            "fpu TOP");
    require(expected.fp.tag == 0xffffu && trace.fp.tag == 0xffffu, "fpu empty tag");
    require((trace.fp.mxcsr & ~0x3fu) == (expected.fp.mxcsr & ~0x3fu), "fpu mxcsr control");
    require(std::memcmp(trace.fp.values, expected.fp.values, sizeof trace.fp.values) == 0,
            "fpu stack values");
}

static void run_quantize(I raw_hz) {
    ++cases;
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::render_clock_quantize_hz_00555a10);
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        std::memset(&trace, 0, sizeof trace);
        void* const fn = (side == 0u) ? slot_555a10 : cpp_fn;
        trace.ret_i32 = invoke_cdecl1(fn, static_cast<U>(raw_hz), trace.fp, trace.abi_fail, trace.df_nonzero);
        capture_globals();
        if (side == 0u) {
            expected = trace;
        }
    }
    assert_traces_match(false);
}

static void run_qpc_rdtsc(U rdtsc_flag, const StubCfg& c) {
    ++cases;
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::render_clock_measure_qpc_rdtsc_00555fa0);
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        cfg = c;
        qpc_counter_val = 0x1000u;
        qpc_base_val = 0u;
        qpc_phase = 0u;
        qpc_iter_polls = 0u;
        porsche::cpu_has_rdtsc_005deb24 = rdtsc_flag;
        std::memset(&trace, 0, sizeof trace);
        void* const fn = (side == 0u) ? slot_555fa0 : cpp_fn;
        trace.ret_i32 = invoke_cdecl0(fn, trace.fp, trace.abi_fail, trace.df_nonzero);
        capture_globals();
        if (side == 0u) {
            expected = trace;
        }
    }
    assert_traces_match(c.log_qpc != 0u);
}

static void run_div_loop(
    U amd, U p6, U pentium, U cyrix, U timer_rate, U clock_iter) {
    ++cases;
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::render_clock_measure_div_loop_005560b0);
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        porsche::cpu_is_amd_005deb38 = amd;
        porsche::cpu_has_p6_005deb14 = p6;
        porsche::copy_flag_005deb10 = pentium;
        porsche::cpu_is_cyrix_005deb34 = cyrix;
        porsche::timer_rate_005deb48 = timer_rate;
        porsche::clock_worker_iterations_006b7c7c = clock_iter;
        std::memset(&trace, 0, sizeof trace);
        void* const fn = (side == 0u) ? slot_5560b0 : cpp_fn;
        trace.ret_i32 = invoke_cdecl0(fn, trace.fp, trace.abi_fail, trace.df_nonzero);
        capture_globals();
        if (side == 0u) {
            expected = trace;
        }
    }
    assert_traces_match(true);
}

int main(int argc, char**) {
    if (argc < 1) {
        return 2;
    }
    AddVectoredExceptionHandler(1u, fault_handler);

    // Production initial state checks before fixture mutations.
    require(porsche::cpu_has_p6_005deb14 == 0u, "initial 005deb14 == 0");
    require(porsche::cpu_has_rdtsc_005deb24 == 1u, "initial 005deb24 == 1");
    require(porsche::cpu_is_cyrix_005deb34 == 0u, "initial 005deb34 == 0");
    require(porsche::cpu_is_amd_005deb38 == 0u, "initial 005deb38 == 0");
    require(porsche::render_clock_query_performance_frequency != nullptr, "default qpf nonnull");
    require(porsche::render_clock_query_performance_counter != nullptr, "default qpc nonnull");
    {
        I64 host_freq = 0;
        I64 host_cnt = 0;
        require(porsche::render_clock_query_performance_frequency(&host_freq) != 0 && host_freq > 0,
                "default host qpf");
        require(porsche::render_clock_query_performance_counter(&host_cnt) != 0, "default host qpc");
    }

    init_fixture();
    porsche::render_clock_query_performance_frequency = stub_qpf;
    porsche::render_clock_query_performance_counter = stub_qpc;

    // 1. 00555a10: rounding boundaries, thresholds (52, 188, 292, 392), and MHz sweep.
    static const I raw_boundaries[] = {
        static_cast<I>(0x80000000u),
        -2147000000,
        -1924000000,
        -1920000000,
        -960000000,
        -487000000,
        -500001,
        -500000,
        -499999,
        -1,
        0,
        499999,
        500000,
        500001,
        0x7ff85edf,
        0x7ff85ee0,
        0x7fffffff,
    };
    for (I raw_hz : raw_boundaries) {
        run_quantize(raw_hz);
    }
    for (I mhz = 0; mhz <= 600; ++mhz) {
        run_quantize(mhz * 1000000);
    }
    for (I mhz = 633; mhz <= 2147; mhz += 33) {
        run_quantize(mhz * 1000000);
    }
    run_quantize(2131000000);

    // 2. 00555fa0: deterministic QPF/QPC with 005deb24 == 0 and 005deb24 != 0.
    for (U rdtsc_flag : {0u, 1u, 0x80000000u}) {
        run_qpc_rdtsc(rdtsc_flag, StubCfg{10000000, 1, kQpcStepEveryCall, 2000000u, 0u, 0u, 1u});
        run_qpc_rdtsc(rdtsc_flag, StubCfg{5, 0, kQpcStepEveryCall, 1u, 0u, 0u, 1u});
        run_qpc_rdtsc(rdtsc_flag, StubCfg{4, 1, kQpcStepEveryCall, 1u, 0u, 0u, 1u});
        run_qpc_rdtsc(rdtsc_flag, StubCfg{0, 1, kQpcStepEveryCall, 1u, 0u, 0u, 1u});
        run_qpc_rdtsc(rdtsc_flag, StubCfg{-10, 1, kQpcStepEveryCall, 1u, 0u, 0u, 1u});
        run_qpc_rdtsc(rdtsc_flag,
                      StubCfg{(static_cast<I64>(0x77777777u) << 32) | 25LL, 1,
                              kQpcScriptedPerIter, 5u, 2u, 2u, 1u});
    }
    // Timeout countdown (0xf4240 = 1,000,000) in wait loop 1 and wait loop 2.
    run_qpc_rdtsc(0u, StubCfg{5, 1, kQpcTimeoutLoop1Iter0, 1u, 0u, 0u, 0u});
    run_qpc_rdtsc(0u, StubCfg{5, 1, kQpcTimeoutLoop2Iter0, 1u, 0u, 0u, 0u});

    // 3. 005560b0: 5-iteration calibration with controlled 0053c380/0053c2e0 and timer_rate <= 3.
    static const U flag_combos[7][4] = {
        {1u, 1u, 1u, 1u},
        {0u, 1u, 1u, 1u},
        {0u, 0u, 1u, 1u},
        {0u, 0u, 0u, 1u},
        {0u, 0u, 0u, 0u},
        {0x80000000u, 0u, 0u, 0u},
        {0u, 0x00000002u, 0u, 0u},
    };
    static const U timer_rates[] = {
        0u, 1u, 2u, 3u, 0xffffffffu, 0xfffffffcu, 0x80000000u,
    };
    for (const auto& fc : flag_combos) {
        for (U rate : timer_rates) {
            run_div_loop(fc[0], fc[1], fc[2], fc[3], rate, 0x12345678u);
        }
    }
    run_div_loop(0u, 1u, 0u, 0u, 0u, 0xffffffffu);

    std::printf("render_clock_calibration_leaves_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
