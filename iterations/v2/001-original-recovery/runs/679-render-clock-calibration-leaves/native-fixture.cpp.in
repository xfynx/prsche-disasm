enum : U {
    kMaxEvents = 64u,
};

enum EventKind : U {
    kEvQpf = 1u,
    kEvQpc = 2u,
    kEvWait = 3u,
    kEvClock = 4u,
};

struct Event {
    U kind;
    U a0;
    U a1;
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U df_nonzero;
    I ret_i32;
    U qpf_calls;
    U qpc_calls;
    U qpc_null_seen;
    U count;
    Event events[kMaxEvents];
    U flag_p6;
    U flag_rdtsc;
    U flag_pentium;
    U flag_cyrix;
    U flag_amd;
    U timer_rate;
    U clock_iter;
    FpuSnapshot fp;
};

enum QpcMode : U {
    kQpcStepEveryCall = 0u,
    kQpcScriptedPerIter = 1u,
    kQpcTimeoutLoop1Iter0 = 2u,
    kQpcTimeoutLoop2Iter0 = 3u,
};

struct StubCfg {
    I64 qpf_freq;
    I qpf_ret;
    U qpc_mode;
    U qpc_step;
    U qpc_equal_polls;
    U qpc_neg_polls;
    U log_qpc;
};

