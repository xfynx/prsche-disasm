using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static U cases = 0u;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", why, cases);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* base, U off = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(base) + off, 4u);
    return v;
}

static void store32(void* base, U off, U v) {
    std::memcpy(static_cast<B*>(base) + off, &v, 4u);
}

enum : U {
    kEvQuery = 1u,
    kEvAlloc = 2u,
    kEvInit320 = 3u,
    kEvInit600 = 4u,
};

struct Event {
    U kind;
    U a;
    U b;
    U c;
};

enum : U { kMaxEvents = 32u };

struct Snapshot {
    U abi_fail;
    U ret_eax;
    U event_count;
    std::array<Event, kMaxEvents> events;
    std::array<B, 0x40u> self_bytes;
    std::array<B, 0x20u> indices_bytes;
    std::array<B, 0x40u> passes_bytes;
    std::array<B, 0x820u> alloc_buf_bytes;
};

static Event g_events[kMaxEvents];
static U g_event_count = 0u;
static U g_alloc_index = 0u;
static U g_alloc_fail_mask = 0u;
static void* g_query_result = nullptr;
static U g_query_count = 0u;

static alignas(8) B g_self_buf[0x40u];
static alignas(8) B g_indices_buf[0x20u];
static alignas(8) B g_passes_buf[0x40u];
static alignas(8) B g_alloc_buf[0x820u];
static alignas(8) B g_list_nodes[6][0x30u];
static alignas(8) B g_parent_group[0x20u];
static alignas(8) B g_query_entries[8][0x08u];

struct MockQueryObject {
    virtual void __thiscall slot_00() {}
    virtual void __thiscall slot_04() {}
    virtual void __thiscall slot_08() {}
    virtual void* __thiscall query_slots_0c(U* out_count);
};

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c};
}

void* __thiscall MockQueryObject::query_slots_0c(U* out_count) {
    record_event(kEvQuery, address(this), address(out_count), *out_count);
    *out_count = g_query_count;
    return g_query_result;
}

static MockQueryObject g_mock_query_proto;

namespace porsche {

void* __cdecl render_allocate_0059ef90(std::uint32_t size) {
    const U idx = g_alloc_index++;
    record_event(kEvAlloc, size, idx);
    if ((g_alloc_fail_mask & (1u << idx)) != 0u) {
        return nullptr;
    }
    if (size <= sizeof g_indices_buf && idx == 0u && g_query_result != nullptr) {
        return g_indices_buf;
    }
    if (size <= sizeof g_passes_buf && idx == 1u && g_query_result != nullptr) {
        return g_passes_buf;
    }
    require(size <= sizeof g_alloc_buf, "alloc size bound");
    return g_alloc_buf;
}

void* __fastcall scene_pass_init_0053f320(
    void* self, void*, std::uint32_t kind, std::uint32_t subkind) {
    record_event(kEvInit320, address(self), kind, subkind);
    store32(self, 0x0cu, kind);
    store32(self, 0x00u, 0x005bbc3cu);
    store32(self, 0x10u, subkind);
    store32(self, 0x24u, 0u);
    store32(self, 0x28u, 0u);
    return self;
}

void* __fastcall scene_pass_init_alt_0053f600(
    void* self, void*, std::uint32_t subkind) {
    record_event(kEvInit600, address(self), subkind);
    store32(self, 0x0cu, 0u);
    store32(self, 0x10u, subkind);
    store32(self, 0x24u, 0u);
    store32(self, 0x28u, 0u);
    store32(self, 0x00u, 0x005bbc60u);
    return self;
}

} // namespace porsche

static B* code_page = nullptr;
static B* slot_0053f380 = nullptr;
static B* slot_0053f980 = nullptr;
static B* slot_0053fd60 = nullptr;
