// Native x86-vs-C++ differential fixture for Run778:
//   0053f380..0053f425 (166B) porsche::scene_pass_compile_0053f380
//   0053f980..0053fce1 (866B) porsche::scene_pass_factory_default_0053f980
//   0053fd60..0053fd80 ( 33B) porsche::scene_pass_init_kind1_0053fd60
//   00574ab0..00574aca ( 27B) porsche::scene_pass_init_kind2_00574ab0
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

#include <array>
