static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_tex_idx = 0u;
    g_lookup_idx = 0u;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_holder_buf, 0xaa, sizeof g_holder_buf);
    std::memset(g_entry_buf, 0xbb, sizeof g_entry_buf);
    std::memset(g_sky_buf, 0, sizeof g_sky_buf);
    std::memset(g_archive_buf, 0, sizeof g_archive_buf);
    std::memset(&g_render_display, 0, sizeof g_render_display);

    store32(g_holder_buf, 0x00u, address(g_entry_buf));
    store32(g_sky_buf, 0x04u, address(g_archive_buf));
    store32(g_render_display.bytes, 0x74u, address(g_driver_buf));

    porsche::render_display_00628130 = &g_render_display;
    porsche::startup_context_table_owner_00613e04 = g_table_owner;
    porsche::scene_flare_table_00627e48 = g_table_owner;
    porsche::scene_route_sky_00627e4c = g_sky_buf;

    // Populate archive at g_archive_buf with 3 records: "SUN ", "HALO", "SUN " (duplicate!).
    // Each record is (4-byte tag word, 4-byte relative offset).
    store32(g_archive_buf, 0x08u, 3u);
    std::memcpy(g_archive_buf + 0x10u, "SUN ", 4u);
    store32(g_archive_buf, 0x14u, 0x100u);
    std::memcpy(g_archive_buf + 0x18u, "HALO", 4u);
    store32(g_archive_buf, 0x1cu, 0x120u);
    std::memcpy(g_archive_buf + 0x20u, "SUN ", 4u);
    store32(g_archive_buf, 0x24u, 0x140u + seed);
}

static void capture(Snapshot& out, U abi_fail, U ret_eax) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    std::memcpy(out.holder_bytes.data(), g_holder_buf, sizeof g_holder_buf);
    std::memcpy(out.sky_bytes.data(), g_sky_buf, sizeof g_sky_buf);
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c &&
                    orig.events[i].d == cpp.events[i].d,
                tag);
    }
    require(orig.holder_bytes == cpp.holder_bytes, tag);
    require(orig.sky_bytes == cpp.sky_bytes, tag);
    ++cases;
}

template <class Setup>
static void run_resolve_case(Setup&& setup, const char* tag) {
    Snapshot orig{};
    Snapshot cpp{};
    U ret_orig = 0u;
    U ret_cpp = 0u;
    reset_fixtures(1u);
    setup();
    capture(orig, invoke_thiscall_0(slot_00452120, g_holder_buf, ret_orig), 0u);
    reset_fixtures(1u);
    setup();
    capture(cpp, invoke_thiscall_0(
        reinterpret_cast<const void*>(&porsche::scene_flare_entries_resolve_00452120),
        g_holder_buf, ret_cpp), 0u);
    check_equal(orig, cpp, tag);
}

int main() {
    init();

    // 1. Direct getters 0045dd80 and 0045cfb0
    {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(1u);
        U f0 = invoke_cdecl_0(slot_0045dd80, r0);
        capture(orig, f0, r0);
        reset_fixtures(1u);
        U f1 = invoke_cdecl_0(
            reinterpret_cast<const void*>(&porsche::scene_flare_table_get_0045dd80), r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "0045dd80");

        reset_fixtures(1u);
        f0 = invoke_thiscall_0(slot_0045cfb0, g_table_owner, r0);
        capture(orig, f0, r0);
        reset_fixtures(1u);
        f1 = invoke_thiscall_0(
            reinterpret_cast<const void*>(&porsche::scene_route_sky_get_0045cfb0), g_table_owner, r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "0045cfb0");
    }

    // 2. Direct 0053c680: empty archive, match first, match duplicate from tail, miss
    for (const char* nm : {"SUN ", "HALO", "NONE"}) {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(2u);
        U f0 = invoke_cdecl_2(slot_0053c680, address(g_archive_buf), address(nm), r0);
        capture(orig, f0, r0);
        reset_fixtures(2u);
        U f1 = invoke_cdecl_2(
            reinterpret_cast<const void*>(&porsche::scene_chunk_find_tag_0053c680),
            address(g_archive_buf), address(nm), r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "0053c680 populated");

        reset_fixtures(2u);
        store32(g_archive_buf, 0x08u, 0u);
        f0 = invoke_cdecl_2(slot_0053c680, address(g_archive_buf), address(nm), r0);
        capture(orig, f0, r0);
        reset_fixtures(2u);
        store32(g_archive_buf, 0x08u, 0u);
        f1 = invoke_cdecl_2(
            reinterpret_cast<const void*>(&porsche::scene_chunk_find_tag_0053c680),
            address(g_archive_buf), address(nm), r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "0053c680 empty");
    }

    // 3. Direct 00460b50: cold insert, warm cache hit, miss, full 40-slot fallback, slot>=20 hit & insert
    for (U mode : {0u, 1u, 2u, 3u, 4u, 5u}) {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        auto setup = [mode]() {
            if (mode == 1u) {
                store32(g_sky_buf, 0x08u + 3u * 4u, address(g_archive_buf + 0x80u));
                std::memcpy(g_sky_buf + 0xa8u + 3u * 6u, "HALO", 5u);
            } else if (mode == 3u) {
                for (U i = 0u; i < 40u; ++i) {
                    store32(g_sky_buf, 0x08u + i * 4u, address(g_archive_buf + 0x90u));
                    std::memcpy(g_sky_buf + 0xa8u + i * 6u, "OTHR", 5u);
                }
            } else if (mode == 4u) {
                store32(g_sky_buf, 0x08u + 25u * 4u, address(g_archive_buf + 0x80u));
                std::memcpy(g_sky_buf + 0xa8u + 25u * 6u, "HALO", 5u);
            } else if (mode == 5u) {
                for (U i = 0u; i < 25u; ++i) {
                    store32(g_sky_buf, 0x08u + i * 4u, address(g_archive_buf + 0x90u));
                    std::memcpy(g_sky_buf + 0xa8u + i * 6u, "OTHR", 5u);
                }
            }
        };
        const char* name = (mode == 2u) ? "MISS" : "HALO";
        reset_fixtures(3u);
        setup();
        U f0 = invoke_thiscall_1(slot_00460b50, g_sky_buf, address(name), r0);
        capture(orig, f0, r0);
        reset_fixtures(3u);
        setup();
        U f1 = invoke_thiscall_1(
            reinterpret_cast<const void*>(&porsche::scene_sky_find_name_00460b50),
            g_sky_buf, address(name), r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "00460b50");
    }

    // 4. Direct 00460b10 (byte-reversed tag) + 00460c80 (cached vs uncached texture)
    {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        const U tag_sun = 0x53554e20u; // "SUN " in big-endian word -> reversed to "SUN "
        const U tag_halo = 0x48414c4fu; // "HALO"
        for (U t : {tag_sun, tag_halo, 0x4d495353u}) {
            reset_fixtures(4u);
            U f0 = invoke_thiscall_1(slot_00460b10, g_sky_buf, t, r0);
            capture(orig, f0, r0);
            reset_fixtures(4u);
            U f1 = invoke_thiscall_1(
                reinterpret_cast<const void*>(&porsche::scene_sky_find_tag_00460b10),
                g_sky_buf, t, r1);
            capture(cpp, f1, r1);
            check_equal(orig, cpp, "00460b10");
        }

        // 00460c80 uncached vs cached
        for (U cached : {0u, 1u}) {
            auto setup = [cached]() {
                store32(g_sky_buf, 0x08u + 2u * 4u, address(g_archive_buf + 0x100u));
                if (cached != 0u) {
                    store32(g_sky_buf, 0x198u + 2u * 4u, address(g_tex_results[5]));
                }
            };
            reset_fixtures(4u);
            setup();
            U f0 = invoke_thiscall_1(slot_00460c80, g_sky_buf, 2u, r0);
            capture(orig, f0, r0);
            reset_fixtures(4u);
            setup();
            U f1 = invoke_thiscall_1(
                reinterpret_cast<const void*>(&porsche::scene_sky_texture_get_00460c80),
                g_sky_buf, 2u, r1);
            capture(cpp, f1, r1);
            check_equal(orig, cpp, "00460c80");
        }
    }

    // 5. Full 00452120 resolve cases:
    // - Both "null"
    run_resolve_case([]() {
        store32(g_entry_buf, 0x04u, 0x6e756c6cu);
        store32(g_entry_buf, 0x08u, 0x6e756c6cu);
    }, "resolve both null");

    // - Both found in sky archive (slot0 = "SUN ", slot1 = "HALO")
    run_resolve_case([]() {
        store32(g_entry_buf, 0x04u, 0x53554e20u);
        store32(g_entry_buf, 0x08u, 0x48414c4fu);
    }, "resolve both sky hit");

    // - Both miss sky archive -> fallback bswap32 lookup via 0044d320
    run_resolve_case([]() {
        store32(g_entry_buf, 0x04u, 0x41424344u);
        store32(g_entry_buf, 0x08u, 0x31323334u);
    }, "resolve both fallback");

    // - Mixed: slot0 sky hit (repeated tag hits cache on slot1!), and null+fallback
    run_resolve_case([]() {
        store32(g_entry_buf, 0x04u, 0x53554e20u);
        store32(g_entry_buf, 0x08u, 0x53554e20u);
    }, "resolve repeat sky cache hit");

    run_resolve_case([]() {
        store32(g_entry_buf, 0x04u, 0x6e756c6cu);
        store32(g_entry_buf, 0x08u, 0x58595a30u);
    }, "resolve null + fallback");

    std::printf("scene_flare_resolve_786_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
