static alignas(8) B g_lookup_results[4][0x10u];
static alignas(8) porsche::RenderDisplay g_render_display;
static U g_tex_idx = 0u;
static U g_lookup_idx = 0u;

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u, U d = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c, d};
}

namespace porsche {

RenderDisplay* render_display_00628130 = nullptr;
void* startup_context_table_owner_00613e04 = nullptr;

U __cdecl render_buffer_read_word_0056e2a8(const void* src, I bytes) {
    const U word = load32(src, static_cast<U>(bytes - 4));
    const U shift = static_cast<U>((-bytes) * 8 + 0x20);
    const U out = word >> shift;
    record_event(kEvReadWord, out, static_cast<U>(bytes));
    return out;
}

void* __cdecl scene_sky_texture_create_0044da10(
    const void* chunk, U tag, U mode, void* driver, U flags) {
    const U idx = g_tex_idx++;
    require(idx < 8u, "tex bound");
    record_event(kEvTexCreate, address(chunk), tag, mode, (address(driver) ^ flags));
    return g_tex_results[idx];
}

void* __fastcall startup_context_table_lookup_0044d320(
    void* self, void*, U key0, U key1) {
    const U idx = g_lookup_idx++;
    require(idx < 4u, "lookup bound");
    record_event(kEvCtxLookup, address(self), key0, key1);
    return g_lookup_results[idx];
}

