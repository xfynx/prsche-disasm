              ptr_u(reinterpret_cast<void*>(&porsche::ff_effect_initialize_00411d20)));
    patch_abs(s_4121b0, 0x07u, 0x005e940cu, ptr_u(porsche::frame_control_ff_state_005e9408 + 0x04u));
    patch_abs(s_4121b0, 0x13u, 0x00657424u, ptr_u(&porsche::global_00657424));
    patch_abs(s_4121b0, 0x1bu, 0x005e8b34u, ptr_u(&porsche::application_player_object_table_005e8b34[0]));
    patch_abs(s_4121b0, 0x22u, 0x005e9414u, ptr_u(porsche::frame_control_ff_state_005e9408 + 0x0cu));
    patch_abs(s_4121b0, 0x28u, 0x00606ad0u, ptr_u(&porsche::startup_frame_tick_table_00606ad0));
    patch_abs(s_4121b0, 0x2du, 0x004123e0u,
