static void patch_rel(B* base, U off, U src_va, U target_va, U dst) {
    const U insn_next_va = src_va + off + 4u;
    require(static_cast<U>(static_cast<I>(insn_next_va) + static_cast<I>(load32(base + off))) == target_va,
            "patch_rel-mismatch");
    const I new_rel = static_cast<I>(dst - (ptr_u(base + off) + 4u));
    std::memcpy(base + off, &new_rel, sizeof new_rel);
}

static void patch_abs(B* base, U off, U expected_va, U actual_addr) {
    require(load32(base + off) == expected_va, "patch_abs-mismatch");
    std::memcpy(base + off, &actual_addr, sizeof actual_addr);
}

static B* setup_original_code() {
