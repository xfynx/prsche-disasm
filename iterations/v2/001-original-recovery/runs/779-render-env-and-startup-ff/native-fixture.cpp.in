    patch_abs(s_4121b0, 0x34u, 0x005e9534u, ptr_u(porsche::frame_control_ff_state_005e9408 + 0x12cu));
    patch_abs(s_4121b0, 0x3eu, 0x005e9418u, ptr_u(porsche::frame_control_ff_state_005e9408 + 0x10u));
    patch_abs(s_4121b0, 0x44u, 0x005e941cu, ptr_u(porsche::frame_control_ff_state_005e9408 + 0x14u));
    patch_rel(s_4121b0, 0x49u, 0x004121b0u, 0x00414c30u,
