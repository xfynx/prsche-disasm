    B* const mem = static_cast<B*>(
        VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(mem != nullptr, "virtualalloc");
    std::memset(mem, 0xcc, 4096u);

    B* const s_573030 = mem + 0x000u;
    B* const s_4121b0 = mem + 0x100u;
    std::memcpy(s_573030, body_573030, sizeof body_573030);
    std::memcpy(s_4121b0, body_4121b0, sizeof body_4121b0);

    // 00573030 patches
    patch_abs(s_573030, 0x15u, 0x005c0838u, ptr_u(&porsche::render_environment_fmt_005c0838[0]));
    patch_rel(s_573030, 0x1bu, 0x00573030u, 0x005a0fbfu,
              ptr_u(reinterpret_cast<void*>(&porsche::formatter_entry_005a0fbf)));
    patch_rel(s_573030, 0x25u, 0x00573030u, 0x005a38c7u,
              ptr_u(reinterpret_cast<void*>(&porsche::crt_putenv_005a38c7)));

    // 004121b0 patches
