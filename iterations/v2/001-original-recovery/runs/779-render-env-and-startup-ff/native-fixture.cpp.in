    static const B body_4121b0[] = { @BODY_004121B0@ };
    static_assert(sizeof body_573030 == 50u, "00573030 size");
    static_assert(sizeof str_5c0838 == 6u, "005c0838 size");
    static_assert(sizeof body_4121b0 == 124u, "004121b0 size");
