static void capture(Snapshot& out, U abi_fail, U ret) {
    std::memset(&out, 0, sizeof out);
    out.abi_fail = abi_fail;
    out.ret = ret;
    out.event_count = event_count;
    std::memcpy(out.events, events, sizeof events);
    std::memcpy(out.ff_state, porsche::frame_control_ff_state_005e9408, sizeof out.ff_state);
    out.global_657424 = porsche::global_00657424;
    out.player0 = porsche::application_player_object_table_005e8b34[0];
    out.tick_table_token = (porsche::startup_frame_tick_table_00606ad0 == &g_table_sentinel) ? 1u : 0u;
}

static void compare_snapshots(const char* label) {
    require(expected.abi_fail == 0u && trace.abi_fail == 0u, label);
    require(std::memcmp(&expected, &trace, sizeof(Snapshot)) == 0, label);
}

