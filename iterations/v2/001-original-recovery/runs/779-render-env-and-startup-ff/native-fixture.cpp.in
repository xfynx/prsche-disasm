}

static void store32(void* p, U v) {
    std::memcpy(p, &v, sizeof v);
}

static void record_event(U type, U a, U b, U c, U d, const char* txt) {
    if (event_count < kMaxEvents) {
        Event& ev = events[event_count++];
        std::memset(&ev, 0, sizeof ev);
        ev.type = type;
        ev.a = a;
        ev.b = b;
        ev.c = c;
        ev.d = d;
        if (txt != nullptr) {
            std::size_t n = std::strlen(txt);
            if (n >= sizeof ev.text) {
                n = sizeof ev.text - 1u;
            }
            std::memcpy(ev.text, txt, n);
            ev.text[n] = '\0';
        }
    }
}

