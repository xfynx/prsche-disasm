static void run_env_case(const char* name, const char* value, U ignored, U p_ret) {
    B* const fn_orig = code + 0x000u;
    void* const fn_cpp = reinterpret_cast<void*>(&porsche::render_environment_00573030);
    U abi_orig = 0u, abi_cpp = 0u;

    side = 0u;
    reset_state(0u, 0u, false, 0u, 0u, p_ret);
    const U r_orig = invoke_cdecl3(fn_orig, ptr_u(name), ptr_u(value), ignored, abi_orig);
    capture(expected, abi_orig, r_orig);

    side = 1u;
    reset_state(0u, 0u, false, 0u, 0u, p_ret);
    const U r_cpp = invoke_cdecl3(fn_cpp, ptr_u(name), ptr_u(value), ignored, abi_cpp);
    capture(trace, abi_cpp, r_cpp);

    compare_snapshots("00573030");
    ++cases;
}

static void run_startup_case(U global_val, U player_val, bool table_present, U i_mode, U ins_mode) {
    B* const fn_orig = code + 0x100u;
    void* const fn_cpp = reinterpret_cast<void*>(&porsche::startup_sequence_call_004121b0);
    U abi_orig = 0u, abi_cpp = 0u;

    side = 0u;
    reset_state(global_val, player_val, table_present, i_mode, ins_mode, 0u);
    invoke_cdecl0_void(fn_orig, abi_orig);
    capture(expected, abi_orig, 0u);

    side = 1u;
    reset_state(global_val, player_val, table_present, i_mode, ins_mode, 0u);
    invoke_cdecl0_void(fn_cpp, abi_cpp);
    capture(trace, abi_cpp, 0u);

    compare_snapshots("004121b0");
    ++cases;
}

} // namespace

int main() {
    AddVectoredExceptionHandler(1, fault);
    code = setup_original_code();

    run_env_case("THRUST_VAR", "1", 0u, 0u);
    run_env_case("DISPLAY", "voodoo3", 99u, 0xffffffffu);
    run_env_case("EMPTY_VAL", "", 1u, 1u);

    for (U g : {0xffffffffu, 0u, 1u, 2u, 3u}) {
        for (bool tbl : {false, true}) {
            for (U i_mode : {0u, 1u, 2u}) {
                for (U ins_mode : {0u, 1u}) {
                    run_startup_case(g, 0x11223344u + i_mode, tbl, i_mode, ins_mode);
                }
            }
        }
    }

    std::printf("render_env_startup_ff_779_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
