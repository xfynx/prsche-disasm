    patch_abs(s_4121b0, 0x5bu, 0x005e9410u, ptr_u(porsche::frame_control_ff_state_005e9408 + 0x08u));
    patch_rel(s_4121b0, 0x61u, 0x004121b0u, 0x00533480u,
