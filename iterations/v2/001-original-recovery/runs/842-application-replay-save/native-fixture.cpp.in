enum : U {
    kOff413FD0 = 0x0000u,
    kOff59E170 = 0x0100u,
    kOff562460 = 0x0180u,
    kOff562390 = 0x0200u,
    kCodeBytes = 0x0400u,
    kMaxEvents = 32u,
};

struct Trace {
    U count;
    U codes[kMaxEvents];
    U arg0[kMaxEvents];
    U arg1[kMaxEvents];
    U arg2[kMaxEvents];
    int ret0;
    U diag_line;
    U tail_word;
    U snap_hash;
    U snap_word15;
};

static Trace trace{};
static Trace expected{};
static U cases = 0u;
static U events_total = 0u;
