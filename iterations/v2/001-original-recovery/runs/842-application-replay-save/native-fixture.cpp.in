static const char kFmtConcat[5] = "%s%s";
static int mock_open_ok = 1;
static U mock_written_bytes = 0u;
static int mock_dispatch_forward = 1;
static void* const kFakeHandle = reinterpret_cast<void*>(static_cast<std::uintptr_t>(0x12345678u));

static const B kBody413FD0[142] = { @BODY_00413FD0@ };
static const B kBody59E170[64] = { @BODY_0059E170@ };
static const B kBody562460[71] = { @BODY_00562460@ };
static const B kBody562390[194] = { @BODY_00562390@ };

static void fail(const char* why) {
    std::printf("application_replay_save_original_x86_vs_cpp=FAIL case=%u side=%u reason=%s\n",
                cases, which, why);
    std::exit(1);
}

static U fnv1a(const void* data, std::size_t n) {
    if (!data) return 0u;
    const B* p = static_cast<const B*>(data);
    U h = 2166136261u;
    for (std::size_t i = 0; i < n; ++i) {
        h ^= p[i];
        h *= 16777619u;
    }
    return h;
}

static void record(U cid, U a0 = 0u, U a1 = 0u, U a2 = 0u) {
    if (trace.count >= kMaxEvents) fail("trace_overflow");
    trace.codes[trace.count] = cid;
    trace.arg0[trace.count] = a0;
    trace.arg1[trace.count] = a1;
    trace.arg2[trace.count] = a2;
    ++trace.count;
    ++events_total;
}

static void __cdecl mock_diag_sink(const char* fmt, ...) {
    char buf[512]{};
    va_list ap;
    va_start(ap, fmt);
    (void)std::vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    const char* file = reinterpret_cast<const char*>(static_cast<std::uintptr_t>(porsche::shared_runtime_word_005deb74));
    record(1u, fnv1a(buf, std::strlen(buf)), porsche::shared_runtime_word_005deb78, file ? fnv1a(file, std::strlen(file)) : 0u);
    trace.diag_line = porsche::shared_runtime_word_005deb78;
}

namespace porsche {

std::int32_t __cdecl formatter_entry_005a0fbf(char* out, const char* fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    const int n = std::vsprintf(out, fmt, ap);
    va_end(ap);
    record(2u, fnv1a(out, std::strlen(out)));
    return n;
}

int __cdecl formatter_stdio_printf_005a177b(const char* fmt, ...) {
    char buf[256]{};
    va_list ap;
    va_start(ap, fmt);
    const int n = std::vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    record(3u, fnv1a(buf, std::strlen(buf)));
    return n;
}

std::uint32_t __cdecl file_device_name_00568e90(const char* path) {
    record(4u, fnv1a(path, std::strlen(path)));
    return 0x77u;
}

std::int32_t __cdecl resource_leaf_atomic_dispatch_00568d50(
    ResourceLeafAtomicCallback cb, std::uint32_t device, std::uint32_t group, void* context) {
    auto* ctx = static_cast<ResourceAtomicContext*>(context);
    record(5u, device, group, ctx->callback_diagnostic_flag);
    if (!mock_dispatch_forward) return 0;
    return cb(group, context);
}

bool __cdecl file_open_00533b90(const char* path, std::uint32_t mode, std::uint32_t group, void** out_handle) {
    record(6u, fnv1a(path, std::strlen(path)), mode, group);
    if (!mock_open_ok) {
        *out_handle = nullptr;
        return false;
    }
    *out_handle = kFakeHandle;
    return true;
}

std::uint32_t __cdecl file_read_offset_00533d70(
    void* handle, std::uint32_t offset, void* buffer, std::int32_t size, std::uint32_t group) {
    const std::size_t sample_len = (static_cast<U>(size) < sizeof(replay_snapshot_005e9a20))
                                       ? static_cast<std::size_t>(size)
                                       : sizeof(replay_snapshot_005e9a20);
    record(7u, static_cast<U>(reinterpret_cast<std::uintptr_t>(handle)), static_cast<U>(size), group);
    record(8u, offset, fnv1a(buffer, sample_len));
    return mock_written_bytes;
}

std::uint32_t __cdecl close_00533da0(void* handle, std::uint32_t group) {
    record(9u, static_cast<U>(reinterpret_cast<std::uintptr_t>(handle)), group);
    return 1u;
}

