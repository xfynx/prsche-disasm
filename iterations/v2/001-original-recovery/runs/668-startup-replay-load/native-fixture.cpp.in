static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_handle(const void* p) {
    if (p == nullptr) return 0u;
    if (p == &handle_primary_token) return 0xb1000001u;
    if (p == &handle_fallback_token) return 0xb1000002u;
    return 0xb1ffffffu;
}

static U normalize_buf(const void* p) {
    if (p == nullptr) return 0u;
    if (p == porsche::replay_snapshot_005e9a20) return 0xc1000000u;
    return address(p);
}

static void copy_text(char* dst, std::size_t cap, const char* src) {
    if (src == nullptr) {
        std::snprintf(dst, cap, "<null>");
        return;
    }
    std::snprintf(dst, cap, "%s", src);
}

static Event& push_event(
    U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u, const char* text = nullptr) {
    require(trace.count < 16u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    if (text != nullptr) {
        copy_text(e.text, sizeof(e.text), text);
    }
    return e;
}

namespace porsche {

std::int32_t __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    std::va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 80u, format, args);
    va_end(args);
    push_event(kEvFormat, static_cast<U>(n), 0u, 0u, 0u, output);
    return static_cast<std::int32_t>(n);
}

bool __cdecl open_0059e040(
    const char* name, std::uint32_t mode, std::uint32_t group, void** handle) {
    const U idx = open_call_index++;
    const bool is_primary = (idx == 0u);
    const bool set_h = is_primary ? stub_cfg.open_primary_set_handle : stub_cfg.open_fallback_set_handle;
    const bool ret_v = is_primary ? stub_cfg.open_primary_ret : stub_cfg.open_fallback_ret;
    if (handle != nullptr && set_h) {
        *handle = is_primary ? &handle_primary_token : &handle_fallback_token;
    }
    push_event(
        kEvOpen,
        mode,
        group,
        replay_mode_flag_00606858,
        (handle != nullptr && *handle != nullptr) ? 1u : 0u,
        name);
    return ret_v;
}

std::int32_t __cdecl size_00533de0(void* handle, std::uint32_t group) {
    push_event(kEvSize, normalize_handle(handle), group);
    return static_cast<std::int32_t>(stub_cfg.file_size);
}

std::uint32_t __cdecl read_00533bf0(
    void* handle, std::uint32_t offset, void* buffer, std::uint32_t bytes, std::uint32_t group) {
    push_event(kEvRead, normalize_handle(handle), offset, normalize_buf(buffer), group);
    require(bytes <= sizeof(replay_snapshot_005e9a20), "bounded read size");
    B* const dst = static_cast<B*>(buffer);
    for (U i = 0u; i < bytes; ++i) {
        dst[i] = static_cast<B>((stub_cfg.read_seed + i * 17u + (i >> 8)) & 0xffu);
    }
    return bytes;
}

std::uint32_t __cdecl close_00533da0(void* handle, std::uint32_t group) {
    push_event(kEvClose, normalize_handle(handle), group);
    return 1u;
}

int __cdecl formatter_stdio_printf_005a177b(const char* format, ...) {
    char buf[128]{};
    std::va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(buf, sizeof(buf), format, args);
    va_end(args);
    push_event(kEvPrintf, static_cast<U>(n), 0u, 0u, 0u, buf);
    return n;
}

} // namespace porsche

static void capture_fpu(Fpu& f) {
    std::memset(&f, 0, sizeof f);
    B env[28];
    __asm {
        fxsave floating
        fnstenv env
        fldenv env
    }
    f.control = *reinterpret_cast<unsigned short*>(floating);
    f.status = *reinterpret_cast<unsigned short*>(floating + 2);
    f.tag = floating[4];
    std::memset(f.padding, 0, 3);
    f.full_tag = *reinterpret_cast<unsigned short*>(env + 8);
    f.mxcsr = *reinterpret_cast<U*>(floating + 24);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((f.status >> 11) + i) & 7u;
        if (f.tag & (1u << physical)) {
            std::memcpy(f.values + i * 10u, floating + 32u + i * 16u, 10u);
        } else {
            std::memset(f.values + i * 10u, 0, 10u);
        }
    }
}

static void seed_fpu() {
    __asm {
        fninit
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static U invoke_cdecl0(void* fn) {
    U before = 0u, frame = 0u, fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}

static void relocate_rel32(B* slot, U base_va, U off, U orig_target, const void* target) {
    const U insn_va = base_va + off + 4u;
    const U expected_rel = orig_target - insn_va;
    require(word(slot, off) == expected_rel, "exact relative offset");
    const U new_rel = address(target) - (address(slot) + off + 4u);
    put(slot, off, new_rel);
}

static U arena_ptr(U va) {
    return address(porsche::application_state_006573e8.bytes()) +
        (va - porsche::application_state_base_va);
}

