struct CaseEnv {
    const char* root;
    const char* filename;
    U mode_00657424;
    U flag_0065741c;
    U init_global_005e99f4;
    U init_state_005e99fc;
    U init_tail_005ed844;
    U init_saved_00606a80;
    U init_flag_00606858;
    U app_seed;
    U snap_seed;
    StubCfg stub;
};

static void setup_env(const CaseEnv& c) {
    std::memset(&trace, 0, sizeof(trace));
    open_call_index = 0u;
    stub_cfg = c.stub;

    porsche::engine_service_root_0065b360 = c.root;
    std::memset(porsche::replay_filename_00699f34, 0, sizeof(porsche::replay_filename_00699f34));
    if (c.filename != nullptr) {
        std::snprintf(
            porsche::replay_filename_00699f34,
            sizeof(porsche::replay_filename_00699f34),
            "%s",
            c.filename);
    }

    porsche::global_005e99f4 = c.init_global_005e99f4;
    porsche::replay_state_005e99fc = c.init_state_005e99fc;
    porsche::replay_tail_word_005ed844 = c.init_tail_005ed844;
    porsche::replay_saved_word_00606a80 = c.init_saved_00606a80;
    porsche::replay_mode_flag_00606858 = c.init_flag_00606858;

    for (U i = 0u; i < porsche::application_state_word_count; ++i) {
        porsche::application_state_006573e8.words()[i] = c.app_seed + i * 0x01010103u;
        porsche::replay_snapshot_005e9a20[i] = c.snap_seed + i * 0x02030507u;
    }
    porsche::application_state_006573e8.word(0x00657424u) = c.mode_00657424;
    porsche::application_state_006573e8.word(0x0065741cu) = c.flag_0065741c;
}

static void capture_state() {
    trace.final_global_005e99f4 = porsche::global_005e99f4;
    trace.final_replay_state_005e99fc = porsche::replay_state_005e99fc;
    trace.final_replay_tail_word_005ed844 = porsche::replay_tail_word_005ed844;
    trace.final_replay_saved_word_00606a80 = porsche::replay_saved_word_00606a80;
    trace.final_replay_mode_flag_00606858 = porsche::replay_mode_flag_00606858;
    std::memcpy(
        trace.final_snapshot,
        porsche::replay_snapshot_005e9a20,
        sizeof(trace.final_snapshot));
    std::memcpy(
        trace.final_app_state,
        porsche::application_state_006573e8.words().data(),
        sizeof(trace.final_app_state));
    capture_fpu(trace.fpu);
}

static void compare_traces() {
    require(trace.abi_fail == 0u, "original ABI");
    require(expected.abi_fail == 0u, "recovered ABI");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "event tag");
        require(trace.events[i].a0 == expected.events[i].a0, "event a0");
        require(trace.events[i].a1 == expected.events[i].a1, "event a1");
        require(trace.events[i].a2 == expected.events[i].a2, "event a2");
        require(trace.events[i].a3 == expected.events[i].a3, "event a3");
        require(std::strcmp(trace.events[i].text, expected.events[i].text) == 0, "event text");
    }
    require(trace.final_global_005e99f4 == expected.final_global_005e99f4, "005e99f4");
    require(trace.final_replay_state_005e99fc == expected.final_replay_state_005e99fc, "005e99fc");
    require(
        trace.final_replay_tail_word_005ed844 == expected.final_replay_tail_word_005ed844,
        "005ed844");
    require(
        trace.final_replay_saved_word_00606a80 == expected.final_replay_saved_word_00606a80,
        "00606a80");
    require(
        trace.final_replay_mode_flag_00606858 == expected.final_replay_mode_flag_00606858,
        "00606858");
    require(
        std::memcmp(trace.final_snapshot, expected.final_snapshot, sizeof(trace.final_snapshot)) == 0,
        "005e9a20 snapshot");
    require(
        std::memcmp(trace.final_app_state, expected.final_app_state, sizeof(trace.final_app_state)) == 0,
        "006573e8 app state");
    require(trace.fpu.control == expected.fpu.control, "x87 control");
    require(trace.fpu.status == expected.fpu.status, "x87 status");
    require(trace.fpu.tag == expected.fpu.tag, "x87 tag");
    require(trace.fpu.full_tag == expected.fpu.full_tag, "x87 full tag");
    require(trace.fpu.mxcsr == expected.fpu.mxcsr, "mxcsr");
    require(std::memcmp(trace.fpu.values, expected.fpu.values, 80u) == 0, "x87 stack");
}

static void verify_replay_load_case(const CaseEnv& env) {
    ++cases;
    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(slot_4146f0);
    capture_state();
    expected = trace;

    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(reinterpret_cast<void*>(&porsche::replay_load_004146f0));
    capture_state();
    compare_traces();
}

static void verify_startup_call_case(const CaseEnv& env) {
    ++cases;
    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(slot_413cf0);
    capture_state();
    expected = trace;

    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(
        reinterpret_cast<void*>(&porsche::startup_sequence_call_00413cf0));
    capture_state();
    compare_traces();
}

int main() {
    init();

    // 1. replay_load_004146f0 direct paths.
    verify_replay_load_case({
        "c:\\porsche\\", "custom01.rpl",
        2u, 0x11u, 2u, 0x22u, 0x33u, 0x44u, 0x55u,
        0x10000001u, 0x20000001u,
        {true, true, false, false, 0x3e24u, 0x11u},
    });
    // open_0059e040 returns false while populating handle != nullptr -> primary still succeeds.
    verify_replay_load_case({
        "d:\\nfs5\\", "race.rpl",
        2u, 0x12u, 2u, 0x23u, 0x34u, 0x45u, 0x56u,
        0x11110000u, 0x22220000u,
        {true, false, false, false, 0x400u, 0x37u},
    });
    // open_0059e040 returns true while leaving handle == nullptr -> falls back to replay.rpl.
    verify_replay_load_case({
        "e:\\pu\\", "missing.rpl",
        2u, 0x13u, 2u, 0x24u, 0x35u, 0x46u, 0x57u,
        0x33330000u, 0x44440000u,
        {false, true, true, true, 0x800u, 0x5bu},
    });
    // Both primary and fallback fail -> clears global_005e99f4 = 0.
    verify_replay_load_case({
        "f:\\game\\", "nope.rpl",
        2u, 0x14u, 2u, 0x25u, 0x36u, 0x47u, 0x58u,
        0x55550000u, 0x66660000u,
        {false, true, false, false, 0u, 0x7fu},
    });
    // Zero-byte primary read.
    verify_replay_load_case({
        "", "empty.rpl",
        1u, 0x15u, 7u, 0x26u, 0x37u, 0x48u, 0x59u,
        0x77770000u, 0x88880000u,
        {true, true, false, false, 0u, 0x99u},
    });

    // 2. startup_sequence_call_00413cf0 mode == 2 (primary hit, fallback hit, total miss).
    verify_startup_call_case({
        "c:\\porsche\\", "demo01.rpl",
        2u, 0xa1b2c3d4u, 0u, 0xdeadbeefu, 0x13572468u, 0x99887766u, 0x55443322u,
        0x10203040u, 0x50607080u,
        {true, true, false, false, 0x3e24u, 0x41u},
    });
    verify_startup_call_case({
        "c:\\porsche\\", "missing2.rpl",
        2u, 0x77665544u, 9u, 0xabcdef01u, 0x24681357u, 0x11223344u, 0x88776655u,
        0x01020304u, 0xa0b0c0d0u,
        {false, false, true, true, 0x2000u, 0x83u},
    });
    verify_startup_call_case({
        "d:\\data\\", "none.rpl",
        2u, 0x19283746u, 5u, 0xfeedfaceu, 0x0f1e2d3cu, 0x0a0b0c0du, 0x1a2b3c4du,
        0x12345678u, 0x87654321u,
        {false, true, false, false, 0u, 0xc5u},
    });

    // 3. startup_sequence_call_00413cf0 mode != 2 (0, 1, 3 -> snapshot save).
    verify_startup_call_case({
        "c:\\porsche\\", "unused.rpl",
        0u, 0x11112222u, 9u, 0x33334444u, 0x55556666u, 0x77778888u, 0x9999aaaau,
        0x0a1b2c3du, 0x4e5f6071u,
        {false, false, false, false, 0u, 0u},
    });
    verify_startup_call_case({
        "c:\\porsche\\", "unused.rpl",
        1u, 0x22223333u, 0u, 0x44445555u, 0x66667777u, 0x88889999u, 0xaaaabbbbu,
        0x13243546u, 0x5768798au,
        {true, true, true, true, 0x100u, 0x12u},
    });
    verify_startup_call_case({
        "c:\\porsche\\", "unused.rpl",
        3u, 0x33334444u, 2u, 0x55556666u, 0x77778888u, 0x9999aaaau, 0xbbbbccccu,
        0x9a8b7c6du, 0x5e4f3021u,
        {false, false, false, false, 0u, 0u},
    });

    std::printf("startup_replay_load_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
