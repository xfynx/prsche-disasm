    compare_traces("render_copy_bytes_005563b0", false);
}

static void test_16bit_mode(U initial_val, I mode_flag, U seed) {
    auto setup = [&]() {
        reset_pattern(seed);
        porsche::render_texture_format_preferences_005dedcc[10] = initial_val;
    };
    U ret_eax = 0u, abi_fail = 0u;

    g_which = 1u;
    setup();
    seed_fpu();
    invoke_cdecl1(g_orig_554930, static_cast<U>(mode_flag), ret_eax, abi_fail);
    capture_trace(abi_fail, 0u);
    g_expected = g_trace;

    g_which = 2u;
    setup();
    seed_fpu();
    invoke_cdecl1(reinterpret_cast<void*>(&porsche::render_texture_format_16bit_mode_00554930),
                  static_cast<U>(mode_flag), ret_eax, abi_fail);
    capture_trace(abi_fail, 0u);
    compare_traces("render_texture_format_16bit_mode_00554930", false);
}

static void test_slot_bind(
    I stage_index,
    U value,
    U width,
    U height,
    U format_a,
    U format_b,
    U flags,
    U xor_a,
    U xor_b,
    I select_ret,
    U slot_ret,
    U seed) {
    auto setup = [&]() {
        reset_pattern(seed);
        g_select_xor_a = xor_a;
        g_select_xor_b = xor_b;
        g_select_ret = select_ret;
        g_slot_ret = slot_ret;
    };
    U ret_eax = 0u, abi_fail = 0u;

    g_which = 1u;
    setup();
    seed_fpu();
    invoke_cdecl7(g_orig_555640, static_cast<U>(stage_index), value, width, height,
                  format_a, format_b, flags, ret_eax, abi_fail);
    capture_trace(abi_fail, 0u);
    g_expected = g_trace;

    g_which = 2u;
    setup();
    seed_fpu();
    invoke_cdecl7(reinterpret_cast<void*>(&porsche::render_texture_slot_bind_00555640),
                  static_cast<U>(stage_index), value, width, height,
                  format_a, format_b, flags, ret_eax, abi_fail);
    capture_trace(abi_fail, 0u);
    compare_traces("render_texture_slot_bind_00555640", false);
}

int main() {
    init();

    // 1. shape_find_entry_0053c640
    {
        const U empty_k[1] = {0u};
        const U empty_o[1] = {0u};
        test_shape_find(0u, empty_k, empty_o, "nght", 1u);

        const U one_k[1] = {0x6e676874u}; // "nght" big-endian
        const U one_o[1] = {0x120u};
        test_shape_find(1u, one_k, one_o, "nght", 2u);
        test_shape_find(1u, one_k, one_o, "glat", 3u);

        const U multi_k[4] = {0x676c6169u, 0x676c6174u, 0x6e676874u, 0x676c6174u};
        const U multi_o[4] = {0x200u, 0x300u, 0x400u, 0x500u};
        test_shape_find(4u, multi_k, multi_o, "glai", 4u); // index 0 (first)
        test_shape_find(4u, multi_k, multi_o, "nght", 5u); // index 2 (middle)
        test_shape_find(4u, multi_k, multi_o, "glat", 6u); // duplicate at 1 and 3 -> must pick 3!
        test_shape_find(4u, multi_k, multi_o, "none", 7u); // miss

        const U prefix_k[2] = {0x00006e67u, 0x6e674142u};
        const U prefix_o[2] = {0x240u, 0x340u};
        test_shape_find(2u, prefix_k, prefix_o, "ngAB", 8u); // catches 2-byte vs 4-byte read
    }

    // 2. render_memmove_00556370
    test_memmove(0x100u, 0x200u, 32u, 10u);  // dst < src disjoint
    test_memmove(0x300u, 0x100u, 32u, 11u);  // dst > src + size disjoint
    test_memmove(0x120u, 0x100u, 32u, 12u);  // dst == src + size (exact edge -> heap_copy_dispatch)
    test_memmove(0x100u, 0x100u, 32u, 13u);  // dst == src (exact edge -> heap_copy_dispatch)
    test_memmove(0x100u, 0x100u, 0u, 14u);   // size == 0, dst == src
    test_memmove(0x200u, 0x100u, 0u, 15u);   // size == 0, dst > src
    test_memmove(0x101u, 0x100u, 33u, 16u);  // overlap +1
    test_memmove(0x107u, 0x100u, 25u, 17u);  // overlap +7
    test_memmove(0x11fu, 0x100u, 32u, 18u);  // overlap +(size - 1)
    test_memmove(0x100u, 0x108u, 24u, 19u);  // dst < src with overlap -> still calls heap_copy_dispatch

    // 3. render_copy_bytes_005563b0
    test_copy_bytes(0x100u, 0x400u, 48u, 20u); // src < dst disjoint
    test_copy_bytes(0x400u, 0x100u, 48u, 21u); // dst < src disjoint
    test_copy_bytes(0x100u, 0x105u, 29u, 22u); // src < dst overlap -> backward copy
    test_copy_bytes(0x105u, 0x100u, 29u, 23u); // dst < src overlap -> heap_copy_dispatch
    test_copy_bytes(0x100u, 0x120u, 32u, 24u); // dst == src + size
    test_copy_bytes(0x100u, 0x100u, 0u, 25u);  // size == 0

    // 4. render_texture_format_16bit_mode_00554930
    test_16bit_mode(2u, 0, 30u);
    test_16bit_mode(4u, 0, 31u);
    test_16bit_mode(99u, 0, 32u);
    test_16bit_mode(4u, 1, 33u);
    test_16bit_mode(4u, -1, 34u);
    test_16bit_mode(4u, static_cast<I>(0x80000000u), 35u);
    test_16bit_mode(2u, 0x12345678, 36u);

    // 5. render_texture_slot_bind_00555640
    // Early-return guards (zero calls):
    test_slot_bind(0, 0x11111111u, 0u, 0u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 40u);         // width == 0
    test_slot_bind(0, 0x11111111u, 64u, 32u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 41u);       // width != height
    test_slot_bind(0, 0x11111111u, 48u, 48u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 42u);       // non-power-of-two (48)
    test_slot_bind(0, 0x11111111u, 3u, 3u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 43u);         // non-power-of-two (3)
    test_slot_bind(-1, 0x11111111u, 64u, 64u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 44u);      // stage < 0 (-1)
    test_slot_bind(static_cast<I>(0x80000000u), 0x11111111u, 64u, 64u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 45u);
    test_slot_bind(3, 0x11111111u, 64u, 64u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 46u);       // stage == 3
    test_slot_bind(0x7fffffff, 0x11111111u, 64u, 64u, 1u, 2u, 3u, 0u, 0u, 0, 0u, 47u);

    // Valid calls across stages 0..2, mutated format_a/format_b, slots 0..31, and 0x80000000u width:
    test_slot_bind(0, 0xa1b2c3d4u, 1u, 1u, 3u, 5u, 0x10u, 0u, 0u, 0, 0u, 50u);
    test_slot_bind(1, 0x12345678u, 64u, 64u, 2u, 7u, 0x20u, 0x0f00u, 0x00f0u, -1, 0u, 51u);
    test_slot_bind(2, 0x89abcdefu, 256u, 256u, 6u, 4u, 0x03u, 0x11u, 0x22u, 1, 5u, 52u);
    test_slot_bind(0, 0xdeadbeefu, 128u, 128u, 9u, 1u, 0xffu, 0x33u, 0x44u, 0, 31u, 53u);
    test_slot_bind(2, 0xfeedfaceu, 512u, 512u, 11u, 8u, 0u, 0x55u, 0x66u, -7, 31u, 54u);
    test_slot_bind(1, 0x00c0ffeeu, 0x80000000u, 0x80000000u, 4u, 2u, 7u, 1u, 2u, 0, 12u, 55u);

    std::printf("render_startup_text_leaves_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                g_cases, g_events_total);
    return 0;
}
