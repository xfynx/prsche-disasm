static void reloc_abs32(B* slot, U off, U orig, const void* target) {
    require(rd32(slot, off) == orig, "abs32-orig");
    wr32(slot, off, address(target));
}

static void reloc_rel32(B* slot, U off, U orig, const void* target) {
    require(rd32(slot, off) == orig, "rel32-orig");
    const U next_eip = address(slot) + off + 4u;
    wr32(slot, off, address(target) - next_eip);
}

static void init() {
    SetUnhandledExceptionFilter(fault_handler);

    // Assert production initial .data 005dedf4 against raw PE bytes before any fixture mutation.
    static const B orig_data_005dedf4[] = {@BODY_005DEDF4@};
    require(sizeof orig_data_005dedf4 == 4u, "4B-data-005dedf4");
    require(std::memcmp(&porsche::render_texture_format_preferences_005dedcc[10], orig_data_005dedf4, 4u) == 0,
            "initial-005dedf4");

    // Assert zero-initialized BSS 006a33f8..006a39f7 before any fixture mutation.
    for (U i = 0u; i < sizeof porsche::render_texture_slots_006a33f8; ++i) {
        require(porsche::render_texture_slots_006a33f8[i] == 0u, "initial-bss-006a33f8");
    }

    static const B b_53c640[] = {@BODY_0053C640@};
    static const B b_556370[] = {@BODY_00556370@};
    static const B b_5563b0[] = {@BODY_005563B0@};
    static const B b_554930[] = {@BODY_00554930@};
    static const B b_555640[] = {@BODY_00555640@};
    require(sizeof b_53c640 == 63u, "size-53c640");
    require(sizeof b_556370 == 61u, "size-556370");
    require(sizeof b_5563b0 == 24u, "size-5563b0");
    require(sizeof b_554930 == 19u, "size-554930");
    require(sizeof b_555640 == 95u, "size-555640");

    g_code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(g_code != nullptr, "rwx-alloc");

    g_orig_53c640 = g_code + 0x000u;
    g_orig_556370 = g_code + 0x100u;
    g_orig_5563b0 = g_code + 0x200u;
    g_orig_554930 = g_code + 0x300u;
    g_orig_555640 = g_code + 0x400u;

    std::memcpy(g_orig_53c640, b_53c640, sizeof b_53c640);
    std::memcpy(g_orig_556370, b_556370, sizeof b_556370);
    std::memcpy(g_orig_5563b0, b_5563b0, sizeof b_5563b0);
    std::memcpy(g_orig_554930, b_554930, sizeof b_554930);
    std::memcpy(g_orig_555640, b_555640, sizeof b_555640);

    reloc_rel32(g_orig_53c640, 0x09u, 0x00031c5bu,
                reinterpret_cast<const void*>(&porsche::render_buffer_read_word_0056e2a8));
    reloc_rel32(g_orig_556370, 0x34u, 0xfffdc038u,
                reinterpret_cast<const void*>(&porsche::heap_copy_dispatch_005323e0));
    reloc_rel32(g_orig_5563b0, 0x10u, 0xffffffacu, g_orig_556370);
    reloc_abs32(g_orig_554930, 0x0eu, 0x005dedf4u,
                &porsche::render_texture_format_preferences_005dedcc[10]);
    reloc_rel32(g_orig_555640, 0x2fu, 0xfffff1adu,
                reinterpret_cast<const void*>(&porsche::render_texture_select_00554820));
    reloc_rel32(g_orig_555640, 0x44u, 0xfffff548u,
                reinterpret_cast<const void*>(&porsche::render_texture_slot_00554bd0));
    reloc_abs32(g_orig_555640, 0x58u, 0x006a3410u,
                porsche::render_texture_slots_006a33f8 + 0x18u);

    FlushInstructionCache(GetCurrentProcess(), g_code, 4096u);
}

static void compare_traces(const char* label, bool check_ret) {
    require(g_expected.abi_fail == 0u, "orig-abi");
    require(g_trace.abi_fail == 0u, "cpp-abi");
    if (check_ret) {
        require(g_trace.ret_eax == g_expected.ret_eax, label);
    }
    require(g_trace.event_count == g_expected.event_count, "event-count");
    for (U i = 0u; i < g_expected.event_count; ++i) {
        require(std::memcmp(&g_trace.events[i], &g_expected.events[i], sizeof(Event)) == 0, label);
    }
    require(g_trace.pref_slot_005dedf4 == g_expected.pref_slot_005dedf4, label);
    require(std::memcmp(&g_trace.fp, &g_expected.fp, sizeof(FpuSnapshot)) == 0, "fpu");
    require(std::memcmp(g_trace.arena, g_expected.arena, kArenaBytes) == 0, label);
    require(std::memcmp(g_trace.prefs, g_expected.prefs, sizeof g_trace.prefs) == 0, label);
    require(std::memcmp(g_trace.slots, g_expected.slots, sizeof g_trace.slots) == 0, label);
    ++g_cases;
}

static void reset_pattern(U seed) {
    std::memset(&g_trace, 0, sizeof g_trace);
    for (U i = 0u; i < kArenaBytes; ++i) {
        g_arena[i] = static_cast<B>((i * 37u + seed * 13u + 5u) & 0xffu);
    }
    for (U i = 0u; i < sizeof porsche::render_texture_slots_006a33f8; ++i) {
        porsche::render_texture_slots_006a33f8[i] = static_cast<B>((i * 19u + seed + 3u) & 0xffu);
    }
    porsche::render_texture_format_preferences_005dedcc[10] = 2u;
}

static void test_shape_find(U count, const U* keys, const U* offsets, const char* tag_bytes, U seed) {
    auto setup = [&]() {
        reset_pattern(seed);
        wr32(g_arena, 0x00u, 0x53485031u);
        wr32(g_arena, 0x04u, 0x1000u);
        wr32(g_arena, 0x08u, count);
        wr32(g_arena, 0x0cu, 0xdeadbeefu);
        for (U i = 0u; i < count; ++i) {
            wr32(g_arena, 0x10u + i * 8u, keys[i]);
            wr32(g_arena, 0x14u + i * 8u, offsets[i]);
        }
        std::memcpy(g_arena + 0x800u, tag_bytes, 4u);
    };

    const U shape_va = address(g_arena);
    const U tag_va = address(g_arena + 0x800u);
    U ret_eax = 0u, abi_fail = 0u;

    g_which = 1u;
    setup();
    seed_fpu();
    invoke_cdecl2(g_orig_53c640, shape_va, tag_va, ret_eax, abi_fail);
    capture_trace(abi_fail, ret_eax);
    g_expected = g_trace;

    g_which = 2u;
    setup();
    seed_fpu();
    invoke_cdecl2(reinterpret_cast<void*>(&porsche::shape_find_entry_0053c640),
                  shape_va, tag_va, ret_eax, abi_fail);
    capture_trace(abi_fail, ret_eax);
    compare_traces("shape_find_entry_0053c640", true);
}

static void test_memmove(U dst_off, U src_off, U size, U seed) {
    auto setup = [&]() {
        reset_pattern(seed);
    };
    const U dst_va = address(g_arena + dst_off);
    const U src_va = address(g_arena + src_off);
    U ret_eax = 0u, abi_fail = 0u;

    g_which = 1u;
    setup();
    seed_fpu();
    invoke_cdecl3(g_orig_556370, dst_va, src_va, size, ret_eax, abi_fail);
    capture_trace(abi_fail, 0u);
    g_expected = g_trace;

    g_which = 2u;
    setup();
    seed_fpu();
    invoke_cdecl3(reinterpret_cast<void*>(&porsche::render_memmove_00556370),
                  dst_va, src_va, size, ret_eax, abi_fail);
    capture_trace(abi_fail, 0u);
    compare_traces("render_memmove_00556370", false);
}

static void test_copy_bytes(U src_off, U dst_off, U size, U seed) {
    auto setup = [&]() {
        reset_pattern(seed);
    };
    const U src_va = address(g_arena + src_off);
    const U dst_va = address(g_arena + dst_off);
    U ret_eax = 0u, abi_fail = 0u;

    g_which = 1u;
    setup();
