using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

enum : U {
    kArenaBytes = 4096u,
    kMaxEvents = 8u,
};

enum EventTag : U {
    kEvReadWord = 1u,
    kEvHeapCopy = 2u,
    kEvSelect = 3u,
    kEvSlot = 4u,
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U arg2;
    U arg3;
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U event_count;
    Event events[kMaxEvents];
    U pref_slot_005dedf4;
    FpuSnapshot fp;
    B arena[kArenaBytes];
    std::uint32_t prefs[115];
    B slots[32u * 48u];
};

alignas(64) static B g_arena[kArenaBytes];
alignas(16) static B g_fp_area[512];
static B g_fp_env[28];

static Trace g_trace{};
static Trace g_expected{};
static U g_cases = 0u;
static U g_events_total = 0u;
static U g_which = 0u;

static U g_select_xor_a = 0u;
static U g_select_xor_b = 0u;
static I g_select_ret = 0;
static U g_slot_ret = 0u;

static B* g_code = nullptr;
static B* g_orig_53c640 = nullptr;
static B* g_orig_556370 = nullptr;
static B* g_orig_5563b0 = nullptr;
static B* g_orig_554930 = nullptr;
static B* g_orig_555640 = nullptr;

static U address(const void* p) { return reinterpret_cast<U>(p); }

static U rd32(const void* p, U off = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + off, 4u);
    return v;
}

static void wr32(void* p, U off, U v) {
    std::memcpy(static_cast<B*>(p) + off, &v, 4u);
}

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", why, g_cases, g_which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip, g_cases, g_which);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void record_event(U tag, U a0, U a1, U a2, U a3) {
    require(g_trace.event_count < kMaxEvents, "event-overflow");
    Event& ev = g_trace.events[g_trace.event_count++];
    ev.tag = tag;
    ev.arg0 = a0;
    ev.arg1 = a1;
    ev.arg2 = a2;
    ev.arg3 = a3;
    ++g_events_total;
}

namespace porsche {

std::uint8_t render_texture_slots_006a33f8[32 * 48]{};

std::uint32_t __cdecl render_buffer_read_word_0056e2a8(const void* src, std::int32_t bytes) {
    record_event(kEvReadWord, address(src), static_cast<U>(bytes), 0u, 0u);
    const auto* p = static_cast<const B*>(src);
    U value = 0u;
    for (I i = 0; i < bytes && i < 4; ++i) {
        value = (value << 8u) | static_cast<U>(p[i]);
    }
    return value;
}

void __cdecl heap_copy_dispatch_005323e0(void* dst, const void* src, std::uint32_t size) {
    record_event(kEvHeapCopy, address(dst), address(src), size, 0u);
    auto* d = static_cast<B*>(dst);
    const auto* s = static_cast<const B*>(src);
    for (U i = 0u; i < size; ++i) {
        d[i] = s[i];
    }
}

std::int32_t __cdecl render_texture_select_00554820(std::uint32_t* format_a, std::uint32_t* format_b) {
    const U a = *format_a;
    const U b = *format_b;
    record_event(kEvSelect, a, b, 0u, 0u);
    *format_a = a ^ g_select_xor_a;
    *format_b = b ^ g_select_xor_b;
    return g_select_ret;
}

std::uint32_t __cdecl render_texture_slot_00554bd0(
    std::uint32_t width,
    std::uint32_t formatA,
    std::uint32_t formatB,
    std::uint32_t flags) {
    record_event(kEvSlot, width, formatA, formatB, flags);
    return g_slot_ret;
}

} // namespace porsche

static void seed_fpu() {
    __asm {
        fninit
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static void capture_fpu(FpuSnapshot& fp) {
    std::memset(&fp, 0, sizeof fp);
    __asm {
        fxsave g_fp_area
        fnstenv g_fp_env
        fldenv g_fp_env
    }
    fp.control = *reinterpret_cast<unsigned short*>(g_fp_area);
    fp.status = *reinterpret_cast<unsigned short*>(g_fp_area + 2);
    fp.tag = *reinterpret_cast<unsigned short*>(g_fp_env + 8);
    fp.pad = 0u;
    fp.mxcsr = rd32(g_fp_area, 24u);
    const B mask = g_fp_area[4];
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((fp.status >> 11) + i) & 7u;
        if (mask & (1u << physical)) {
            std::memcpy(fp.values + i * 10u, g_fp_area + 32u + i * 16u, 10u);
        }
    }
}

static void capture_trace(U abi_fail, U ret_eax) {
    g_trace.abi_fail = abi_fail;
    g_trace.ret_eax = ret_eax;
    g_trace.pref_slot_005dedf4 = porsche::render_texture_format_preferences_005dedcc[10];
    capture_fpu(g_trace.fp);
    std::memcpy(g_trace.arena, g_arena, kArenaBytes);
    std::memcpy(g_trace.prefs, porsche::render_texture_format_preferences_005dedcc, sizeof g_trace.prefs);
    std::memcpy(g_trace.slots, porsche::render_texture_slots_006a33f8, sizeof g_trace.slots);
}

static void invoke_cdecl1(void* fn, U a0, U& ret_eax, U& abi_fail) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        push a0
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        call fn
        add esp, 4
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je ok
    bad:
        mov fail, 1
    ok:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    abi_fail = fail;
}

