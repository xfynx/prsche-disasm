        const auto* s=pe+nt+24+optional+i*40;const U rva=rd(s+12),vs=rd(s+8),rawsize=rd(s+16),raw=rd(s+20);
        const U delta=va[j]-base-rva;if(delta>=vs||sizes[j]>vs-delta)continue;found=true;
