static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", msg, cases, side);
        std::fflush(stdout);
        ExitProcess(10u);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx eax=%08lx esp=%08lx ebp=%08lx case=%u side=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip,
                p->ContextRecord->Eax, p->ContextRecord->Esp, p->ContextRecord->Ebp,
                cases, side);
    std::fflush(stdout);
    ExitProcess(10u);
}

static U arena_norm(const void* p) {
    const auto u = ptr(p);
    if (u >= ptr(heap_arena) && u < ptr(heap_arena) + sizeof(heap_arena)) {
        return 0x10000000u + (u - ptr(heap_arena));
    }
    if (u == ptr(dst_buf)) return 0x20000000u;
    if (u == ptr(dst_clut_buf)) return 0x21000000u;
    if (u == ptr(src_clut_buf)) return 0x22000000u;
    if (u == ptr(porsche::render_depthconv_palette_scratch_006bda20)) return 0x30000000u;
    return u;
}

static U str_tag(const char* s) {
    return (s != nullptr) ? fnv1a(s, std::strlen(s)) : 0u;
}

