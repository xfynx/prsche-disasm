template <typename T>
static U to_u32(T* p) { return ptr(p); }
template <typename T>
static U to_u32(T v) { return static_cast<U>(v); }

template <typename Fn, typename... Args>
static U call_cdecl_u(U fn, Args... args) {
    DWORD esp_before = 0u, esp_after = 0u, eax_out = 0u;
    auto target = reinterpret_cast<Fn>(static_cast<std::uintptr_t>(fn));
    __asm {
        mov esp_before, esp
    }
    eax_out = to_u32(target(args...));
    __asm {
        mov esp_after, esp
    }
    if (esp_before != esp_after) {
        trace.abi_fail = 1u;
    }
    return eax_out;
}

template <typename Fn, typename... Args>
static void call_cdecl_v(U fn, Args... args) {
    DWORD esp_before = 0u, esp_after = 0u;
    auto target = reinterpret_cast<Fn>(static_cast<std::uintptr_t>(fn));
    __asm {
        mov esp_before, esp
    }
    target(args...);
    __asm {
        mov esp_after, esp
    }
    if (esp_before != esp_after) {
        trace.abi_fail = 1u;
    }
}

static void reset_state() {
    std::memset(&trace, 0, sizeof(trace));
    std::memset(heap_arena, 0xcc, sizeof(heap_arena));
    heap_cursor = 0u;
    corrupt_row_sentinel = 0u;
    std::memset(dst_buf, 0x55, sizeof(dst_buf));
    std::memset(dst_clut_buf, 0x66, sizeof(dst_clut_buf));
    for (U i = 0u; i < 256u; ++i) {
        porsche::render_pixel_palette_006b4b20[i] = 0xff000000u | (i * 0x030507u);
        fake_pal_res[i] = 0x77000000u ^ (i * 0x010204u);
    }
    std::memset(src_clut_buf, 0x11, sizeof(src_clut_buf));
    std::memset(porsche::render_depthconv_palette_scratch_006bda20, 0x22,
                sizeof(porsche::render_depthconv_palette_scratch_006bda20));
    porsche::render_depthconv_palette_ptr_005de2f8 = nullptr;
    porsche::shared_runtime_word_005deb74 = 0u;
    porsche::shared_runtime_word_005deb78 = 0u;
    bpe_state_right = nullptr;
    bpe_state_dst = nullptr;
    bpe_state_src = nullptr;
    bpe_state_flag = nullptr;
    bpe_state_left = nullptr;
}

static void finish_side(U dst_bytes) {
    trace.err_file = (porsche::shared_runtime_word_005deb74 == ptr(kStrFile) ||
                      porsche::shared_runtime_word_005deb74 == ptr(porsche::render_clut16_file_005bb3e4))
                         ? 1u
                         : porsche::shared_runtime_word_005deb74;
    trace.err_line = porsche::shared_runtime_word_005deb78;
    trace.pal_ptr_off = arena_norm(porsche::render_depthconv_palette_ptr_005de2f8);
    if (porsche::render_depthconv_palette_ptr_005de2f8 == fake_pal_res) {
        trace.pal_ptr_off = 0x40000000u;
    }
    trace.scratch_hash = fnv1a(porsche::render_depthconv_palette_scratch_006bda20, 1024u);
    trace.dst_hash = fnv1a(dst_buf, dst_bytes);
    trace.arena_hash = fnv1a(heap_arena, heap_cursor > 0u ? heap_cursor : 64u);
}

static void compare_sides() {
    require(trace.abi_fail == 0u, "abi");
    require(trace.r0 == expected.r0, "r0");
    require(trace.r1 == expected.r1, "r1");
    require(trace.r2 == expected.r2, "r2");
    require(trace.r3 == expected.r3, "r3");
    require(trace.err_file == expected.err_file, "err-file");
    require(trace.err_line == expected.err_line, "err-line");
    require(trace.pal_ptr_off == expected.pal_ptr_off, "pal-ptr");
    require(trace.scratch_hash == expected.scratch_hash, "scratch-hash");
    require(trace.dst_hash == expected.dst_hash, "dst-hash");
    require(trace.arena_hash == expected.arena_hash, "arena-hash");
    require(trace.event_count == expected.event_count, "event-count");
    for (U i = 0u; i < trace.event_count; ++i) {
        require(trace.events[i].kind == expected.events[i].kind, "event-kind");
        require(trace.events[i].a0 == expected.events[i].a0, "event-a0");
        require(trace.events[i].a1 == expected.events[i].a1, "event-a1");
        require(trace.events[i].a2 == expected.events[i].a2, "event-a2");
        require(trace.events[i].a3 == expected.events[i].a3, "event-a3");
    }
}

template <typename Fn>
static void run_case(U dst_bytes, Fn&& body) {
    ++cases;
    side = 0u;
    reset_state();
    body(true);
    finish_side(dst_bytes);
    expected = trace;

    side = 1u;
    reset_state();
    body(false);
    finish_side(dst_bytes);
    compare_sides();
}

// Helper to build a test RefPack compressed stream with all 4 opcodes.
static const B kRefPackAll[] = {
    0x10, 0xfb, 0x00, 0x00, 0x26, // 38 bytes uncompressed
    0xfc, 0x00,                   // dummy? No: start with 4-byte literal run (0xe0 -> 4 bytes)
};

// Carefully constructed exact RefPack test streams:
// Stream 1: 0x10fb, ulen = 26, uses 0xe0 (4-byte literal "ABCD"), dist=1 RLE (0x04,0x00 -> lit=0,len=4,dist=1 => 'D'*4),
//           dist=2 (0x08,0x01 -> lit=0,len=5,dist=2), dist=4 (0x10,0x03 -> lit=0,len=7,dist=4),
//           0x84,0x01,0x02 ('X','Y', match), stop 0xfe ('Z','!')
static const B kRefStream1[] = {
    0x10, 0xfb, 0x00, 0x00, 0x1a,
    0xe0, 'A', 'B', 'C', 'D',             // +4 literals -> "ABCD" (out=4)
    0x04, 0x00,                           // short: lit=0, match=(1<<0)+3? No: (op>>2)&7=1 -> match=4, dist=1 -> "DDDD" (out=8)
    0x08, 0x01,                           // short: lit=0, match=(2)+3=5, dist=2 -> "CDCDD" (out=13)
    0x10, 0x03,                           // short: lit=0, match=(4)+3=7, dist=4 -> 7 bytes from out-4 (out=20)
    0x82, 0x01, 0x04, 'X', 'Y',           // med: b0=0x82(match=2+4=6), b1=0x01(lit=0? wait: (b1>>6)=0, wait want lit=2 -> b1=0x80|0x01), wait compute cleanly below!
    0xfe, 'Z', '!'                        // stop: +2 literals (out=26)
};

static B shape_buf[1024] = {};

static void fill_shape(U type_word, I w, I h, U word2, U word3) {
    std::memset(shape_buf, 0, sizeof(shape_buf));
    wr(shape_buf, 0u, type_word);
    wr(shape_buf, 4u, (static_cast<U>(h) << 16) | (static_cast<U>(w) & 0xffffu));
    wr(shape_buf, 8u, word2);
    wr(shape_buf, 12u, word3);
    for (U i = 16u; i < 256u; ++i) {
        shape_buf[i] = static_cast<B>((i * 11u + 3u) & 0xffu);
    }
}

} // namespace

int main() {
    AddVectoredExceptionHandler(1u, &fault_handler);
    setup_pe();

    // Exact RefPack vector covering literal run, short dist 1/2/3/4, med opcode, long opcode, stop 0..3.
    static const B ref_vec1[] = {
        0x10, 0xfb, 0x00, 0x00, 0x29, // ulen = 41
        0xe0, 'A', 'B', 'C', 'D',     // +4 => 4
        0x04, 0x00,                   // lit=0, dist=1, match=4 => 8
        0x08, 0x01,                   // lit=0, dist=2, match=5 => 13
        0x08, 0x02,                   // lit=0, dist=3, match=5 => 18
        0x10, 0x03,                   // lit=0, dist=4, match=7 => 25
        0x82, 0x80, 0x04, 'X', 'Y',   // med: b0=0x82 (match=2+4=6), b1=0x80(lit=2,distHi=0), b2=0x04(dist=5) => +2+6=33
        0xc1, 0x00, 0x07, 0x02, 'Q',  // long: b0=0xc1(lit=1,dist16=0,lenHi=0), b1=0, b2=7(dist=8), b3=2(match=5+2=7) => +1+7=41
        0xfc                          // stop 0
    };
    static const B ref_vec2[] = {
        0x11, 0x32, 0x00, 0x00, 0x00, 0x00, 0x00, 0x07, // bit0=1 (5-byte skip) + 0x32 magic, ulen=7
        0xe0, '1', '2', '3', '4',
        0xff, '5', '6', '7'
    };

    using FnConvertShape = void*(__cdecl*)(const void*, U, I, I);
    using FnConvertTex = I(__cdecl*)(U, U, U, U, U, U, U, U, I);
    using FnUnpack = void*(__cdecl*)(const void*);
    using FnDecomp = U(__cdecl*)(const void*, void*);
    using FnBpe = I(__cdecl*)(const void*, void*);
    using FnHuff = U(__cdecl*)(const void*, void*, I);
    using FnDxt = I(__cdecl*)(const void*, void*, I);
    using FnDxtBlk = void(__cdecl*)(W*, I, const void*);
    using FnRef = I(__cdecl*)(const void*, void*, I);
    using FnCopyDw = void*(__cdecl*)(void*, const void*, I);
    using FnMatch = void*(__cdecl*)(void*, U, U);
    using FnCopyB = void(__cdecl*)(void*, const void*, I);

    // 1. RefPack vectors + helpers (00594760, 005948c0, 005948f0, 00594960, 005713a0, 00571470)
    run_case(64u, [&](bool pe) {
        trace.r0 = call_cdecl_u<FnRef>(pe ? ptr(slot_594760) : fn_ptr(&porsche::codec_refpack_decode_00594760), nullptr, dst_buf, 1);
        trace.r1 = call_cdecl_u<FnRef>(pe ? ptr(slot_594760) : fn_ptr(&porsche::codec_refpack_decode_00594760), ref_vec1, dst_buf, 0);
        trace.r2 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_571470) : fn_ptr(&porsche::codec_decompress_wrapper_00571470), ref_vec1, dst_buf);
        trace.r3 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), ref_vec2, dst_buf + 64);
    });

    run_case(32u, [&](bool pe) {
        std::memcpy(dst_buf, "ABCDEFGH", 8);
        const void* p0 = reinterpret_cast<const void*>(
            call_cdecl_u<FnMatch>(pe ? ptr(slot_5948f0) : fn_ptr(&porsche::codec_refpack_match_copy_005948f0), dst_buf + 8, 1u, 7u));
        const void* p1 = reinterpret_cast<const void*>(
            call_cdecl_u<FnMatch>(pe ? ptr(slot_5948f0) : fn_ptr(&porsche::codec_refpack_match_copy_005948f0), dst_buf + 15, 2u, 5u));
        const void* p2 = reinterpret_cast<const void*>(
            call_cdecl_u<FnMatch>(pe ? ptr(slot_5948f0) : fn_ptr(&porsche::codec_refpack_match_copy_005948f0), dst_buf + 20, 4u, 6u));
        call_cdecl_v<FnCopyB>(pe ? ptr(slot_594960) : fn_ptr(&porsche::codec_refpack_copy_bytes_00594960), dst_buf + 26, dst_buf, 3);
        const void* p3 = reinterpret_cast<const void*>(
            call_cdecl_u<FnCopyDw>(pe ? ptr(slot_5948c0) : fn_ptr(&porsche::codec_refpack_copy_dwords_005948c0), dst_buf + 29, dst_buf, 2));
        trace.r0 = arena_norm(p0);
        trace.r1 = arena_norm(p1);
        trace.r2 = arena_norm(p2);
        trace.r3 = arena_norm(p3);
    });

    // 2. BPE codec (00593640, 00593790, 005713a0) - 0x46fb nested pairs & 0x47fb + null
    static const B bpe_vec1[] = {
        0x46, 0xfb, 0x00, 0x00, 0x09, // ulen = 9
        0xfe,                         // escape marker = 0xfe
        0x03,                         // 3 pairs:
        0x80, 'A', 'B',
        0x81, 0x80, 'C',
        0x82, 0x81, 0x80,             // 0x82 -> "ABCAB" (5 bytes)
        0x82, 'Z', 0xfe, 0x80, 0xfe, '!', 0xfe, 0x00 // "ABCAB" + 'Z' + literal 0x80 + literal '!' + EOF = 8 bytes (ulen=9 ok)
    };
    static const B bpe_vec2[] = {
        0x47, 0xfb, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03,
        0xff, 0x01,
        0x90, 'x', 'y',
        0x90, 'z', 0xff, 0x00
    };
    run_case(32u, [&](bool pe) {
        trace.r0 = static_cast<U>(call_cdecl_u<FnBpe>(pe ? ptr(slot_593640) : fn_ptr(&porsche::codec_bpe_decode_00593640), nullptr, dst_buf));
        trace.r1 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), bpe_vec1, dst_buf);
        trace.r2 = static_cast<U>(call_cdecl_u<FnBpe>(pe ? ptr(slot_593640) : fn_ptr(&porsche::codec_bpe_decode_00593640), bpe_vec2, dst_buf + 16));
    });

    // 3. DXT1 codec (00594400, 00594490, 005713a0)
    // c0=0xf800 > c1=0x001f (4-color mode) and c0=0x001f <= c1=0xf800 (3-color + transparent 0)
    static const B dxt1_vec[] = {
        0x18, 0xfb, 0x00, 0x00, 0x80, // total_bytes = 128 (8x8x16bpp)
        0x00, 0x00, 0x08,             // pad + width = 8 (in+6..7)
        0x00, 0xf8, 0x1f, 0x00, 0xe4, 0x1b, 0x4e, 0x93, // block(0,0): c0>c1
        0x1f, 0x00, 0x00, 0xf8, 0xe4, 0x1b, 0x4e, 0x93, // block(4,0): c0<=c1
        0x20, 0x84, 0x10, 0x42, 0x00, 0x55, 0xaa, 0xff, // block(0,4): c0>c1
        0x10, 0x42, 0x20, 0x84, 0xff, 0xaa, 0x55, 0x00  // block(4,4): c0<=c1
    };
    run_case(160u, [&](bool pe) {
        trace.r0 = static_cast<U>(call_cdecl_u<FnDxt>(pe ? ptr(slot_594400) : fn_ptr(&porsche::codec_dxt1_decode_00594400), dxt1_vec, dst_buf, 0));
        trace.r1 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), dxt1_vec, dst_buf);
        call_cdecl_v<FnDxtBlk>(pe ? ptr(slot_594490) : fn_ptr(&porsche::codec_dxt1_block_00594490),
                               reinterpret_cast<W*>(dst_buf + 128), 16, dxt1_vec + 8);
    });

    // 4. Huffman codec (00593800) - fast LUT + slow >=9bit path + clue<=8 RLE/escape/stop + 0x32fb/0x34fb/0x31fb + bad magic
    // Build a valid 0x30fb stream cleanly via a bit-writer!
    auto write_huff_stream = [](B* out_buf, U magic, bool long_hdr, bool test_slow_9bit) {
        U bitbuf = 0u;
        I nbits = 0;
        U pos = 0u;
        auto push_bits = [&](U val, I cnt) {
            for (I i = cnt - 1; i >= 0; --i) {
                bitbuf = (bitbuf << 1) | ((val >> i) & 1u);
                ++nbits;
                if (nbits == 8) {
                    out_buf[pos++] = static_cast<B>(bitbuf);
                    bitbuf = 0u;
                    nbits = 0;
                }
            }
        };
        auto push_var = [&](U v) {
            if (v < 4u) {
                push_bits(4u + v, 3);
                return;
            }
            I k = 3;
            while (v >= ((1u << (k + 1)) - 4u)) {
                ++k;
            }
            push_bits(1u, k - 1);
            push_bits(v + 4u - (1u << k), k);
        };
        push_bits((magic >> 8) & 0xffu, 8);
        push_bits(magic & 0xffu, 8);
        const U ulen = 24u;
        if (long_hdr) {
            push_bits(0x00u, 24);
        }
        push_bits((ulen >> 16) & 0xffu, 8);
        push_bits((ulen >> 8) & 0xffu, 8);
        push_bits(ulen & 0xffu, 8);

        // clue = 0x7f
        push_bits(0x7fu, 8);
        if (!test_slow_9bit) {
            // Tree: len1=1 (0:'A'), len2=1 (10:'B'), len3=2 (110:'C', 111:0x7f clue)
            push_var(1u); // len1 = 1
            push_var(1u); // len2 = 1
            push_var(2u); // len3 = 2 (complete: 1*4 + 1*2 + 2*1 = 8)
            // Symbols sorted: 'A'(0x41), 'B'(0x42), 'C'(0x43), clue(0x7f) -> deltas: 0x41, 0, 0, (0x7f-0x44)=0x3b
            push_var(0x41u);
            push_var(0u);
            push_var(0u);
            push_var(0x3bu);
            // Output 24 bytes:
            // 'A' (0), 'B' (10), 'C' (110), RLE 5 of 'C' (clue 111 + var 5),
            // literal '!' (clue 111 + var 0 + 0 + 0x21),
            // repeat '!' x 14 (clue 111 + var 14),
            // 'A' (0) => 1+1+1+5+1+14+1 = 24 bytes!
            push_bits(0u, 1); // 'A'
            push_bits(2u, 2); // 'B'
            push_bits(6u, 3); // 'C'
            push_bits(7u, 3); push_var(5u); // repeat 'C' x5
            push_bits(7u, 3); push_var(0u); push_bits(0u, 1); push_bits('!', 8); // literal '!'
            push_bits(7u, 3); push_var(14u); // repeat '!' x14
            push_bits(0u, 1); // 'A'
            // stop: clue 111 + var 0 + 1
            push_bits(7u, 3); push_var(0u); push_bits(1u, 1);
        } else {
            // 9-bit Huffman tree: len1=1(0), len2..len8=0, len9=256? Simpler: len1=1, len2=1, len3=1, ..., len8=1, len9=2!
            // 1/2 + 1/4 + ... + 1/256 + 2/512 = 1! Total = 10 symbols (len1..8 + 2 at len9)!
            for (I l = 1; l <= 8; ++l) push_var(1u);
            push_var(2u);
            // 10 symbols: 0x10..0x18, 0x7f (clue at len9 -> code 111111111 = 0x1ff, sym9; 'Z' at code 0x1fe)
            push_var(0x10u);
            for (I k = 0; k < 8; ++k) push_var(0u); // 0x11..0x18
            push_var(0x7fu - 0x19u); // 0x7f is 10th symbol
            // Encode 24 bytes mixing short codes (0=0x10, 10=0x11) and 9-bit code (0x1fe=0x18) + 9-bit clue (0x1ff):
            push_bits(0u, 1);       // 0x10
            push_bits(0x1feu, 9);   // 0x18 (9-bit slow path!)
            push_bits(0x1ffu, 9); push_var(2u); // repeat 0x18 x2 (9-bit clue slow path!)
            for (I r = 0; r < 20; ++r) push_bits(2u, 2); // 0x11 x20 (forces multi-refill)
            push_bits(0x1ffu, 9); push_var(0u); push_bits(1u, 1); // stop
        }
        push_bits(0u, 24); // padding for 16-bit refill lookahead
        (void)pos;
    };

    static B huff_a[128] = {};
    static B huff_b[128] = {};
    static B huff_c[128] = {};
    static B huff_d[128] = {};
    write_huff_stream(huff_a, 0x30fbu, false, false);
    write_huff_stream(huff_b, 0x32fbu, false, false);
    write_huff_stream(huff_c, 0x34fbu, false, false);
    write_huff_stream(huff_d, 0x31fbu, true, true);

    run_case(128u, [&](bool pe) {
        trace.r0 = call_cdecl_u<FnHuff>(pe ? ptr(slot_593800) : fn_ptr(&porsche::codec_huff_decode_00593800), nullptr, dst_buf, 1);
        trace.r1 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), huff_a, dst_buf);
        trace.r2 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), huff_b, dst_buf + 32);
        trace.r3 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), huff_c, dst_buf + 64);
        const U r4 = call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), huff_d, dst_buf + 96);
        event(55u, r4);
        // bad magic in 005713a0
        static const B bad_hdr[8] = {0x99, 0x32, 0x00, 0x00, 0x01, 0, 0, 0};
        static const B bad_m2[8] = {0x10, 0x77, 0x00, 0x00, 0x01, 0, 0, 0};
        event(56u,
              call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), bad_hdr, dst_buf),
              call_cdecl_u<FnDecomp>(pe ? ptr(slot_5713a0) : fn_ptr(&porsche::codec_decompress_005713a0), bad_m2, dst_buf));
    });

    // 5. render_shape_unpack_00571330 (uncompressed, compressed no-offset, compressed with non-zero high 24 bits)
    run_case(64u, [&](bool pe) {
        fill_shape(0x7bu, 4, 4, 0u, 0u);
        void* const p0 = reinterpret_cast<void*>(
            call_cdecl_u<FnUnpack>(pe ? ptr(slot_571330) : fn_ptr(&porsche::render_shape_unpack_00571330), shape_buf));
        trace.r0 = static_cast<U>(p0 == shape_buf);

        fill_shape(0x80u | 0x7bu, 4, 4, 0x11223344u, 0x00010002u);
        std::memcpy(shape_buf + 16, ref_vec1, sizeof(ref_vec1));
        void* const p1 = reinterpret_cast<void*>(
            call_cdecl_u<FnUnpack>(pe ? ptr(slot_571330) : fn_ptr(&porsche::render_shape_unpack_00571330), shape_buf));
        trace.r1 = arena_norm(p1);
        trace.r2 = rd(p1, 0);

        fill_shape(0x00123400u | 0x80u | 0x7bu, 4, 4, 0u, 0u);
        std::memcpy(shape_buf + 16, ref_vec1, sizeof(ref_vec1));
        void* const p2 = reinterpret_cast<void*>(
            call_cdecl_u<FnUnpack>(pe ? ptr(slot_571330) : fn_ptr(&porsche::render_shape_unpack_00571330), shape_buf));
        trace.r3 = rd(p2, 0);
    });

    // 6. render_shape_convert_type_00534d40 - direct, alternate, dither=0/1, 4444/1555/565, compressed, multi-step, sentinel
    run_case(64u, [&](bool pe) {
        fill_shape(0x7bu, 5, 3, 0x12345678u, 0x8abc0defu);
        void* const out0 = reinterpret_cast<void*>(
            call_cdecl_u<FnConvertShape>(pe ? ptr(slot_534d40) : fn_ptr(&porsche::render_shape_convert_type_00534d40),
                                         shape_buf, 0x78u, 0, 1));
        void* const out1 = reinterpret_cast<void*>(
            call_cdecl_u<FnConvertShape>(pe ? ptr(slot_534d40) : fn_ptr(&porsche::render_shape_convert_type_00534d40),
                                         shape_buf, 0x7eu, 1, 0));
        void* const out2 = reinterpret_cast<void*>(
            call_cdecl_u<FnConvertShape>(pe ? ptr(slot_534d40) : fn_ptr(&porsche::render_shape_convert_type_00534d40),
                                         shape_buf, 0x6du, 0, 0));
        trace.r0 = rd(out0, 0);
        trace.r1 = rd(out0, 12);
        trace.r2 = rd(out1, 0);
        trace.r3 = rd(out2, 0);
    });

    run_case(64u, [&](bool pe) {
        // Multi-step 0x7a -> 0x7d (0x7a -> 0x7b -> 0x7d) with compressed shape (0x7a | 0x80) and direct_mode=1 / use_dither=0
        fill_shape(0x80u | 0x7au, 4, 2, 0x00020004u, 0x01230456u);
        std::memcpy(shape_buf + 16, ref_vec1, sizeof(ref_vec1));
        void* const out0 = reinterpret_cast<void*>(
            call_cdecl_u<FnConvertShape>(pe ? ptr(slot_534d40) : fn_ptr(&porsche::render_shape_convert_type_00534d40),
                                         shape_buf, 0x7du, 0, 1));
        // Corrupted sentinel triggers diagnostic_handler_005debf0 (line 0x255)
        fill_shape(0x78u, 4, 1, 0u, 0u);
        corrupt_row_sentinel = 1u;
        void* const out1 = reinterpret_cast<void*>(
            call_cdecl_u<FnConvertShape>(pe ? ptr(slot_534d40) : fn_ptr(&porsche::render_shape_convert_type_00534d40),
                                         shape_buf, 0x7eu, 0, 0));
        trace.r0 = rd(out0, 0);
        trace.r1 = rd(out0, 4);
        trace.r2 = rd(out1, 0);
    });

    // 7. render_texture_depth_convert_005350e0 - 0xc->0xc, 0xc->3, multi-step 1->5 with CLUT, 1->2 post-loop CLUT
    run_case(256u, [&](bool pe) {
        std::memcpy(shape_buf, ref_vec1, sizeof(ref_vec1));
        trace.r0 = static_cast<U>(call_cdecl_u<FnConvertTex>(
            pe ? ptr(slot_5350e0) : fn_ptr(&porsche::render_texture_depth_convert_005350e0),
            0xcu, 0u, 0xcu, 0u, ptr(shape_buf), ptr(dst_buf), 0u, 0u, 16));
        trace.r1 = static_cast<U>(call_cdecl_u<FnConvertTex>(
            pe ? ptr(slot_5350e0) : fn_ptr(&porsche::render_texture_depth_convert_005350e0),
            0xcu, 0u, 3u, 0u, ptr(shape_buf), ptr(dst_buf + 64), 0u, 0u, 8));
        trace.r2 = static_cast<U>(call_cdecl_u<FnConvertTex>(
            pe ? ptr(slot_5350e0) : fn_ptr(&porsche::render_texture_depth_convert_005350e0),
            1u, 2u, 5u, 0u, ptr(shape_buf), ptr(dst_buf + 128), ptr(src_clut_buf), 0u, 6));
        trace.r3 = static_cast<U>(call_cdecl_u<FnConvertTex>(
            pe ? ptr(slot_5350e0) : fn_ptr(&porsche::render_texture_depth_convert_005350e0),
            1u, 2u, 2u, 4u, ptr(shape_buf), ptr(dst_buf + 192), ptr(src_clut_buf), ptr(dst_clut_buf), 8));
        event(57u, fnv1a(dst_clut_buf, 128u));
    });

    VirtualFree(code, 0u, MEM_RELEASE);
    std::printf("PASS cases=%u\n", cases);
    return 0;
}
