#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include "session_extension_pool_864.hpp"
using namespace porsche;
using W = std::uint32_t;
using B = std::uint8_t;
struct State { W before; W flags[10]; W after; W count; W tail; B records[10][0xa0]; W end; };
static const B wrapper[] = {@BODY_00406710@};
static const B clear_a[] = {@BODY_0040B490@};
static const B clear_b[] = {@BODY_0040B4B0@};
static const B allocator[] = {@BODY_0040B530@};
static const B release_body[] = {@BODY_0040B570@};
static State original;
static W calls, candidate_calls, comparisons;
static void require(bool ok, const char* why) { if (!ok) { std::printf("divergence %s\n",why); std::exit(10); } }
static W word(const void* p) { W v; std::memcpy(&v,p,4); return v; }
static void child() {
    for (W f : original.flags) require(f == 0,"original clear before child");
    require(original.count == 0,"original count before child"); ++calls;
}
namespace porsche {
void __cdecl session_extension_service_00406520() {
    for (W f : session_extension_flags_005e7484) require(f == 0,"candidate clear before child");
    require(session_extension_count_005e747c == 0,"candidate count before child"); ++candidate_calls;
}
}
static void rel(B* code, unsigned offset, const void* destination) {
    W d = reinterpret_cast<W>(destination) - reinterpret_cast<W>(code+offset+4);
    std::memcpy(code+offset,&d,4);
}
static void* relocate(const B* source, unsigned n, bool wrap=false, void* clear=nullptr) {
    B* code = static_cast<B*>(VirtualAlloc(nullptr,n,MEM_COMMIT|MEM_RESERVE,PAGE_READWRITE));
    require(code != nullptr,"allocate code"); std::memcpy(code,source,n);
    if (wrap) {
        require(n==10 && code[0]==0xe8 && code[5]==0xe9,"wrapper opcodes");
        require(0x406715u+word(code+1)==0x40b4b0u && 0x40671au+word(code+6)==0x406520u,"wrapper original targets");
        rel(code,1,clear); rel(code,6,&child);
    } else {
        const W from[] = {0x5e7484,0x5e747c,0x5e74ac,0x5e6e38,0x5e7478};
        const W to[] = {reinterpret_cast<W>(original.flags),reinterpret_cast<W>(&original.count),reinterpret_cast<W>(original.flags+10),reinterpret_cast<W>(original.records),reinterpret_cast<W>(original.records+10)};
        for (unsigned i=0;i+4<=n;++i) for(unsigned j=0;j<5;++j) if(word(code+i)==from[j]) { std::memcpy(code+i,to+j,4); i+=3; break; }
    }
    DWORD old; require(VirtualProtect(code,n,PAGE_EXECUTE_READ,&old)!=0,"protect code");
    require(FlushInstructionCache(GetCurrentProcess(),code,n)!=0,"flush code"); return code;
}
static W invoke(const void* fn, W argument) {
    W saved, frame, result, fail=0;
    __asm {
        push ebx
        push esi
        push edi
        mov saved,esp
        mov frame,ebp
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,10203040h
        push argument
        call fn
        add esp,4
        mov result,eax
        cmp esp,saved
        jne bad
        cmp ebp,frame
        jne bad
        cmp ebx,13579bdfh
        jne bad
        cmp esi,2468ace0h
        jne bad
        cmp edi,10203040h
        jne bad
        jmp done
    bad:
        mov fail,1
    done:
        mov esp,saved
        pop edi
        pop esi
        pop ebx
    }
    require(!fail,"cdecl stack and nonvolatile registers"); return result;
}
static void reset(unsigned mask) {
    std::memset(&original,0xa7,sizeof original);
    for(unsigned i=0;i<10;++i) original.flags[i] = mask&(1u<<i) ? (i&1 ? 0x80000000u : 0x10203040u) : 0;
    original.count=0x91ab35cdu;
    std::memcpy(session_extension_flags_005e7484,original.flags,sizeof original.flags);
    session_extension_count_005e747c=original.count;
    std::memcpy(session_extension_records_005e6e38,original.records,sizeof original.records);
}
static void compare() {
    require(std::memcmp(original.flags,session_extension_flags_005e7484,sizeof original.flags)==0,"exact flags");
    require(original.count==session_extension_count_005e747c,"separate counter");
    require(std::memcmp(original.records,session_extension_records_005e6e38,sizeof original.records)==0,"untouched records");
    require(original.before==0xa7a7a7a7 && original.after==0xa7a7a7a7 && original.tail==0xa7a7a7a7 && original.end==0xa7a7a7a7,"original state guards");
    for(const auto& record:original.records) for(B b:record) require(b==0xa7,"original record preservation");
    ++comparisons;
}
int main() {
    for(W f:session_extension_flags_005e7484) require(f==0,"production initial flags");
    require(session_extension_count_005e747c==0,"production initial counter");
    for(const auto& r:session_extension_records_005e6e38) for(B b:r) require(b==0,"production initial records");
    require(sizeof clear_a==22 && sizeof clear_b==22 && !std::memcmp(clear_a,clear_b,22),"byte-identical clears");
    void* a=relocate(clear_a,sizeof clear_a); void* b=relocate(clear_b,sizeof clear_b);
    void* alloc=relocate(allocator,sizeof allocator); void* release=relocate(release_body,sizeof release_body);
    void* wrap=relocate(wrapper,sizeof wrapper,true,b);
    const W sizes[]={0,1,0xa0,0xa1,0xffffffff};
    for(unsigned mask=0;mask<1024;++mask) {
        reset(mask); invoke(a,0); invoke(&session_extension_clear_0040b490,0); compare();
        reset(mask); invoke(b,0); invoke(&session_extension_clear_0040b4b0,0); compare();
        reset(mask); calls=candidate_calls=0; invoke(wrap,0); invoke(&frame_reset_service_00406710,0);
        require(calls==1 && candidate_calls==1,"one child call"); compare();
        for(W size:sizes) {
            reset(mask); W x=invoke(alloc,size); W y=invoke(&session_extension_allocate_0040b530,size);
            W expected=10; for(W i=0;i<10;++i) if(!(mask&(1u<<i))) {expected=i;break;}
            require(x==(expected==10 ? 0 : reinterpret_cast<W>(original.records[expected])),"original allocation pointer");
            require(y==(expected==10 ? 0 : reinterpret_cast<W>(session_extension_records_005e6e38[expected])),"candidate allocation pointer"); compare();
        }
        for(unsigned index=0;index<15;++index) {
            reset(mask); W x,y;
            if(index<10) { x=reinterpret_cast<W>(original.records[index]); y=reinterpret_cast<W>(session_extension_records_005e6e38[index]); }
            else if(index==10) x=y=0;
            else if(index==11) {x=reinterpret_cast<W>(original.records)+1;y=reinterpret_cast<W>(session_extension_records_005e6e38)+1;}
            else if(index==12) {x=reinterpret_cast<W>(original.records+10);y=reinterpret_cast<W>(session_extension_records_005e6e38+10);}
            else if(index==13) {x=reinterpret_cast<W>(original.records)-0xa0;y=reinterpret_cast<W>(session_extension_records_005e6e38)-0xa0;}
            else x=y=0xffffffff;
            invoke(release,x); invoke(&session_extension_release_0040b570,y); compare();
        }
        reset(mask); invoke(a,0); invoke(&session_extension_clear_0040b490,0); compare();
        reset(mask); invoke(b,0); invoke(&session_extension_clear_0040b4b0,0); compare();
        reset(mask); calls=candidate_calls=0; invoke(wrap,0); invoke(&frame_reset_service_00406710,0);
        require(calls==1 && candidate_calls==1,"ordered child call exactly once"); compare();
    }
    std::printf("session_extension_pool_original_x86_vs_cpp=PASS cases=%u\n",comparisons);
}
