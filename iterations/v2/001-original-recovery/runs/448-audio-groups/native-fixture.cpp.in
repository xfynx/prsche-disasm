// Synthetic cdecl0..3 callsite with a one-page seed covering original0x800
// scratch; checked ESP and nonvolatile registers. No seed enters production.
static U invoke(void* fn,U a,U b,U c,U argc){
    U before,frame,result,fail=0;
    __asm {
        push ebx
        push esi
        push edi
        mov before,esp
        mov frame,ebp
        lea edi,[esp-1000h]
        mov ecx,400h
        mov eax,seed
        rep stosd
        cmp argc,3
        jne two
        push c
    two:
        cmp argc,2
        jb one
        push b
    one:
        cmp argc,1
        jb call_now
        push a
    call_now:
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,10203040h
        call fn
        mov result,eax
        mov ecx,argc
        shl ecx,2
        add esp,ecx
        cmp esp,before
        jne bad
        cmp ebp,frame
        jne bad
        cmp ebx,13579bdfh
        jne bad
        cmp esi,2468ace0h
        jne bad
        cmp edi,10203040h
        je done
    bad:
        mov fail,1
    done:
        mov esp,before
        pop edi
        pop esi
        pop ebx
