std::uint32_t __cdecl application_release_0059f050(void* object) {
    const U tag = encoded_pointer(object);
    U kind = kEvAppReleaseDisplay;
    if (tag != 0xffffffffu && (tag >> 16u) == kTagPool) {
        kind = ((tag & 0xffffu) == 0x100u) ? kEvAppRelease7c : kEvAppRelease6c;
    }
    record_event(kind, tag);
    return 1u;
}

void* __cdecl render_allocate_0059ef90(U size) {
    void* result = nullptr;
    if (!((size == 0x38u && case_fail_alloc38 != 0u) ||
          (size == 8u && case_fail_alloc8 != 0u))) {
        result = pool + pool_used;
        pool_used += (size + 3u) & ~3u;
    }
    if (size == 0x38u) {
        record_event(kEvAlloc38, case_fail_alloc38, pool_used);
    } else if (size == 8u) {
        record_event(kEvAlloc8, case_fail_alloc8, pool_used);
    } else {
        record_event(kEvAllocOther, size, pool_used);
    }
    return result;
}

