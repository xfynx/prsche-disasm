// Bounded fixture transport of the accepted locale-off case-folded compare
// (formatter_search_compare_005ae3c0, formatter_search.cpp).
std::int32_t __cdecl formatter_search_compare_005ae3c0(const char* left,
                                                       const char* right) {
    U a = 0xffu;
    U b;
    while (a != 0u) {
        a = static_cast<U>(static_cast<B>(*right++));
        b = static_cast<U>(static_cast<B>(*left++));
        if (a == b) {
            continue;
        }
        const U right_fold = (a >= 'A' && a <= 'Z') ? (a + 32u) : a;
        a = (b >= 'A' && b <= 'Z') ? (b + 32u) : b;
        if (a != right_fold) {
            const std::int32_t result = (a < right_fold) ? -1 : 1;
            record_event(kEvRouteProbe, static_cast<U>(result));
            return result;
        }
    }
    const std::int32_t result = static_cast<std::int8_t>(a);
    record_event(kEvRouteProbe, static_cast<U>(result));
    return result;
}

