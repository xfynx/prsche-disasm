static void __fastcall device_release_slot0(void* self, void* unused_edx,
                                            U argument);
static void __fastcall core_release_slot1(void* self, void* unused_edx,
                                          U argument);

static B pool[kPoolBytes];
static U pool_used = 0u;
static B route_object[kRouteObjectBytes];
static RenderDisplay display_object = {};
static B device_object[0x40u];
static U device_vtable[2u] = {};
static B core_object[4u];
static U core_vtable[2u] = {};
static B service_object_mirror[0x30u];
// Bytes of the service object that the original 00473100 writes; the four
// gap bytes (0x03, 0x0b, 0x26, 0x27) keep caller-stack garbage in the
// original and are never read by the downstream snapshot copy, so the
// fixture compares and hashes only the observed bytes.
static const U service_observed[44u] = {
    0u, 1u, 2u, 4u, 5u, 6u, 7u, 8u, 9u, 10u, 12u, 13u, 14u, 15u,
    16u, 17u, 18u, 19u, 20u, 21u, 22u, 23u, 24u, 25u, 26u, 27u, 28u, 29u,
    30u, 31u, 32u, 33u, 34u, 35u, 36u, 37u, 40u, 41u, 42u, 43u, 44u, 45u,
    46u, 47u,
};
static U service_hash(const B* object) {
    U hash = 0x811c9dc5u;
    for (U offset : service_observed) {
        hash = (hash ^ object[offset]) * 0x01000193u;
    }
    return hash;
}
static bool service_equal(const B* left, const B* right) {
    for (U offset : service_observed) {
        if (left[offset] != right[offset]) {
            return false;
        }
    }
    return true;
}
static U case_fail_alloc38 = 0u;
static U case_fail_alloc8 = 0u;

static Event events[kMaxEvents];
static U event_count = 0u;
static U cases = 0u;
static U which = 0u;

static Snapshot saved{};

static B* slot_004640b0 = nullptr;
static B* slot_00467740 = nullptr;
static B* slot_00468fb0 = nullptr;

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u, U d = 0u) {
    if (event_count < kMaxEvents) {
        events[event_count++] = Event{kind, a, b, c, d};
    } else {
        require(false, "event overflow");
    }
}

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load_dword(const void* base, U offset) {
    U value;
    std::memcpy(&value, static_cast<const B*>(base) + offset, 4u);
    return value;
}

static void store_dword(void* base, U offset, U value) {
    std::memcpy(static_cast<B*>(base) + offset, &value, 4u);
}

static void store_word16(void* base, U offset, std::uint16_t value) {
    std::memcpy(static_cast<B*>(base) + offset, &value, 2u);
}

static U fnv(const void* p, U count) {
    U hash = 0x811c9dc5u;
    const B* bytes = static_cast<const B*>(p);
    for (U i = 0u; i < count; ++i) {
        hash = (hash ^ bytes[i]) * 0x01000193u;
    }
    return hash;
}

static U tag_of(const void* p) {
    struct Span { const void* base; U span; U tag; };
    const Span spans[] = {
        {view_slot_table_00627e80, 0x218u, kTagSlotTable},
        {route_object_registry_table_005e8c00, 36u, kTagRegistry},
        {&application_state_006573e8, sizeof(ApplicationStateArena), kTagArena},
        {route_object, kRouteObjectBytes, kTagRouteObject},
        {&display_object, 0x80u, kTagDisplay},
        {device_object, 0x40u, kTagDevice},
        {device_vtable, sizeof device_vtable, kTagDeviceVtable},
        {core_object, 4u, kTagCore},
        {core_vtable, sizeof core_vtable, kTagCoreVtable},
        {pool, kPoolBytes, kTagPool},
        {view_setup_camera_005cf620, 12u, kTagCamera},
        {view_castle_string_005cf760, 7u, kTagCastle},
    };
    const U value = address(p);
    for (const Span& span : spans) {
        const U base = address(span.base);
        if (value >= base && value - base < span.span) {
            return (span.tag << 16u) | (value - base);
        }
    }
    return kTagNone;
}

static U required_tag(const void* p, const char* why) {
    const U tag = tag_of(p);
    if (tag == kTagNone) {
        std::printf("divergence untagged-pointer %s case=%u which=%u\n", why,
                    cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
    return tag;
}

static U encoded_pointer(const void* p) {
    if (p == nullptr) {
        return 0xffffffffu;
    }
    return required_tag(p, "unknown pointer");
}

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", why, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

// Controlled endpoint with the original 00473100 body contract:
// word[0]=mode, byte[2]=0, dword[4]=-1, bytes[8..10]=0, word[0x24]=0,
// dwords[0x28,0x2c,0x14,0x0c,0x1c,0x18]=0, dwords[0x10,0x20]=0x3f800000.
namespace porsche {
void __fastcall view_slot_service_00473100(void* self, void* unused_edx,
                                           U mode) {
    (void)unused_edx;
    B* const object = static_cast<B*>(self);
    store_word16(object, 0x00u, static_cast<std::uint16_t>(mode & 0xffffu));
    object[0x02u] = 0u;
    store_dword(object, 0x04u, 0xffffffffu);
    object[0x08u] = 0u;
    object[0x09u] = 0u;
    object[0x0au] = 0u;
    store_word16(object, 0x24u, 0u);
    store_dword(object, 0x28u, 0u);
    store_dword(object, 0x2cu, 0u);
    store_dword(object, 0x14u, 0u);
    store_dword(object, 0x0cu, 0u);
    store_dword(object, 0x10u, 0x3f800000u);
    store_dword(object, 0x1cu, 0u);
    store_dword(object, 0x18u, 0u);
    store_dword(object, 0x20u, 0x3f800000u);
    std::memcpy(service_object_mirror, object, 0x30u);
    record_event(kEvViewSlotService, mode, service_hash(object));
}

// Controlled endpoint with the original 00473190 field-snapshot copy.
void __fastcall view_slot_snapshot_00473190(void* self, void* unused_edx,
                                            const void* source) {
    (void)unused_edx;
    B* const target = static_cast<B*>(self);
    const B* const from = static_cast<const B*>(source);
    const U self_tag = required_tag(self, "snapshot target");
    if (target != from) {
        std::uint16_t word;
        std::memcpy(&word, from + 0x00u, 2u);
        std::memcpy(target + 0x00u, &word, 2u);
        target[0x02u] = from[0x02u];
        target[0x08u] = from[0x08u];
        target[0x09u] = from[0x09u];
        target[0x0au] = from[0x0au];
        for (U field = 0u; field < 3u; ++field) {
            store_dword(target, 0x0cu + field * 4u,
                        load_dword(from, 0x0cu + field * 4u));
        }
        for (U field = 0u; field < 3u; ++field) {
            store_dword(target, 0x18u + field * 4u,
                        load_dword(from, 0x18u + field * 4u));
        }
        std::uint16_t tail_word;
        std::memcpy(&tail_word, from + 0x24u, 2u);
        std::memcpy(target + 0x24u, &tail_word, 2u);
        store_dword(target, 0x04u, load_dword(from, 0x04u));
        store_dword(target, 0x28u, load_dword(from, 0x28u));
        store_dword(target, 0x2cu, load_dword(from, 0x2cu));
    }
    record_event(kEvViewSlotSnapshot, self_tag, service_hash(from));
}

void __cdecl view_route_counter_00465cf0(I index) {
