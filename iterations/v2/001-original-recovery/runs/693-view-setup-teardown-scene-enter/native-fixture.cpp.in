ApplicationStateArena application_state_006573e8{};
RenderCore* render_core_0065b39c = nullptr;
RenderDisplay* render_display_00628130 = nullptr;

std::size_t ApplicationStateArena::checked_offset(U va, std::size_t length)
    const {
    if (va < application_state_base_va) {
        return 0u;
    }
    const std::size_t offset =
        static_cast<std::size_t>(va - application_state_base_va);
    if (offset > application_state_bytes ||
        length > application_state_bytes - offset) {
        return 0u;
    }
    return offset;
}

U& ApplicationStateArena::word(U va) {
    return words_[checked_offset(va, sizeof(U)) / sizeof(U)];
}

const U& ApplicationStateArena::word(U va) const {
    return words_[checked_offset(va, sizeof(U)) / sizeof(U)];
}
