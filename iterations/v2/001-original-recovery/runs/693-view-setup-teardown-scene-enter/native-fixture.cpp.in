static LONG WINAPI fault_handler(EXCEPTION_POINTERS* info) {
    const CONTEXT& context = *info->ContextRecord;
    std::printf(
        "native-fault %08lx eip=%08lx case=%u which=%u "
        "eax=%08lx ebx=%08lx ecx=%08lx edx=%08lx esi=%08lx edi=%08lx\n",
        info->ExceptionRecord->ExceptionCode, context.Eip, cases, which,
        context.Eax, context.Ebx, context.Ecx, context.Edx, context.Esi,
        context.Edi);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

int main() {
    AddVectoredExceptionHandler(1u, fault_handler);
    verify_original_data();
    prepare_code();

    static const U modes[] = {0u, 1u, 2u, 0x80000000u, 0x7fffffffu};
    static const U route_indices[] = {0u, 3u, 8u};
    static const B camera_bytes[] = {0u, 2u, 0xffu};
    static const char* const names[] = {"castle", "CAStle", "harbor-town"};
    for (U mode : modes) {
        for (U route_index : route_indices) {
            for (U camera = 0u; camera < 3u; ++camera) {
                for (U prefill = 0u; prefill < 2u; ++prefill) {
                    run_view_case(mode, route_index, camera_bytes[camera],
                                  prefill, names[camera]);
                }
            }
        }
    }

    for (U display = 0u; display < 2u; ++display) {
        for (U state_7c = 0u; state_7c < 2u; ++state_7c) {
            for (U device = 0u; device < 2u; ++device) {
                for (U state_6c = 0u; state_6c < 2u; ++state_6c) {
                    for (U core = 0u; core < 2u; ++core) {
                        run_teardown_case(display, state_7c, device, state_6c,
                                          core);
                    }
                }
            }
        }
    }

    for (U fail_alloc8 = 0u; fail_alloc8 < 2u; ++fail_alloc8) {
        for (U seed = 0u; seed < 4u; ++seed) {
            run_scene_case(fail_alloc8, seed);
        }
    }

    std::printf(
        "application_view_lifecycle_original_x86_vs_cpp=PASS cases=%u\n",
        cases);
    return 0;
}
