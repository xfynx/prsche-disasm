using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;
using namespace porsche;

enum : U {
    kTagNone = 0u, kTagSlotTable = 1u, kTagRegistry = 2u, kTagArena = 3u,
    kTagRouteObject = 4u, kTagDisplay = 5u, kTagDevice = 6u,
    kTagDeviceVtable = 7u, kTagCore = 8u, kTagCoreVtable = 9u,
    kTagPool = 10u, kTagCamera = 11u, kTagCastle = 12u,
};

enum : U {
    kEvViewSlotService = 1u, kEvViewSlotSnapshot = 2u, kEvRouteCounter = 3u,
    kEvRouteProbe = 4u, kEvRouteFinish = 5u, kEvTeardownSync = 6u,
    kEvTeardownProbe = 7u, kEvAppRelease7c = 8u, kEvDeviceRelease = 9u,
    kEvAppRelease6c = 10u, kEvTeardownReset34 = 11u, kEvTeardownReset14 = 12u,
    kEvAppReleaseDisplay = 13u, kEvTeardownFinish = 14u, kEvCoreRelease = 15u,
    kEvAlloc38 = 16u, kEvBufferCtor = 17u, kEvModeUpdate = 18u,
    kEvServiceNoop = 19u, kEvService36080 = 20u, kEvThrCleanup = 21u,
    kEvSceneReset = 22u, kEvAlloc8 = 23u, kEvSceneSlot = 24u,
    kEvRouteSelect = 25u, kEvRouteRoot = 26u, kEvRouteBind = 27u,
    kEvSplash = 28u, kEvStageF240 = 29u, kEvStage51490 = 30u,
    kEvStage552b0 = 31u, kEvStage3ed00 = 32u, kEvStage55f60 = 33u,
    kEvStage58b80 = 34u, kEvTransferEnter = 35u, kEvTeardownRelease7c = 36u,
    kEvTeardownRelease6c = 37u, kEvAllocOther = 38u,
};

struct Event {
    U kind;
    U a;
    U b;
    U c;
    U d;
};

constexpr U kMaxEvents = 128u;
constexpr U kPoolBytes = 0x200u;
constexpr U kRouteObjectBytes = 0x1100u;

struct Fpu {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    B values[80];
    U mxcsr;
};

struct Snapshot {
    U event_count;
    Event events[kMaxEvents];
    B slots[0x218u];
    U camera[3u];
    U flag;
    B string_byte;
    B scene_flag;
    U scene_buffer;
    U transfer_state;
    B castle[7u];
    B service_mirror[0x30u];
    B pool[kPoolBytes];
    U pool_used;
    B route_object[kRouteObjectBytes];
    B display[0x80u];
    B device[0x40u];
    B core[4u];
    U display_ptr;
    U core_ptr;
    U eax;
};

