// Display-device vtable slot zero: this=ECX, one pushed argument (value 1),
// stdcall cleanup of 4 bytes. Transported through the fastcall form.
static void __fastcall device_release_slot0(void* self, void* unused_edx,
                                            U argument) {
    (void)unused_edx;
    record_event(kEvDeviceRelease, required_tag(self, "device self"),
                 argument);
}

// Core vtable slot one, same transport.
static void __fastcall core_release_slot1(void* self, void* unused_edx,
                                          U argument) {
    (void)unused_edx;
    record_event(kEvCoreRelease, required_tag(self, "core self"), argument);
}

alignas(16) static B fp_area[512] = {};

static void seed_fpu() {
    const unsigned short control = 0x037fu;
    __asm {
        fninit
        fldcw control
        cld
    }
}

static void capture_fpu(Fpu& out) {
    std::memset(&out, 0, sizeof out);
    __asm {
        fxsave fp_area
    }
    out.control = static_cast<unsigned short>(load_dword(fp_area, 0u) & 0xffffu);
    out.status =
        static_cast<unsigned short>((load_dword(fp_area, 0u) >> 16u) & 0xffffu);
    out.tag = fp_area[4u];
    out.mxcsr = load_dword(fp_area, 24u);
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(out.values + i * 10u, fp_area + 32u + i * 16u, 10u);
    }
}

static U invoke_body(void* fn, U& abi_fail, Fpu& fpu) {
    U before = 0u;
    U frame = 0u;
    U fail = 0u;
    U result = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0a5a5a500h
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov result, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fpu);
    abi_fail = fail;
    return result;
}

static void set_abs(B* body, U size, U old, const void* replacement,
                    U expected) {
    U found = 0u;
    const U target = address(replacement);
    for (U i = 0u; i + 4u <= size; ++i) {
        if (load_dword(body, i) == old) {
            store_dword(body, i, target);
            ++found;
            i += 3u;
        }
    }
    require(found == expected, "absolute relocation count");
}

static void set_rel(B* body, U size, U original_va, U target_va,
                    const void* replacement, U expected, B opcode) {
    U found = 0u;
    const U target = address(replacement);
    for (U i = 0u; i + 5u <= size; ++i) {
        if (body[i] == opcode &&
            ((original_va + i + 5u + static_cast<I>(load_dword(body, i + 1u))) &
             0xffffffffu) == target_va) {
            store_dword(body, i + 1u, target - address(body + i + 5u));
            ++found;
            i += 4u;
        }
    }
    require(found == expected, "relative relocation count");
}

static void capture(Snapshot& out) {
    out.event_count = event_count;
    std::memcpy(out.events, events, event_count * sizeof(Event));
    std::memcpy(out.slots, view_slot_table_00627e80, 0x218u);
    std::memcpy(out.camera, view_setup_camera_005cf620, 12u);
    out.flag = view_route_flag_005cf584;
    out.string_byte = view_route_string_005cf5d8;
    out.scene_flag = scene_flag_00619800;
    out.scene_buffer = encoded_pointer(scene_buffer_0062814c);
    out.transfer_state = encoded_pointer(scene_transfer_state_0061976c);
    std::memcpy(out.castle, view_castle_string_005cf760, 7u);
    std::memcpy(out.service_mirror, service_object_mirror, 0x30u);
    std::memcpy(out.pool, pool, kPoolBytes);
    out.pool_used = pool_used;
    std::memcpy(out.route_object, route_object, kRouteObjectBytes);
    std::memcpy(out.display, display_object.bytes, 0x80u);
    std::memcpy(out.device, device_object, 0x40u);
    std::memcpy(out.core, core_object, 4u);
    out.display_ptr = encoded_pointer(render_display_00628130);
    out.core_ptr = encoded_pointer(render_core_0065b39c);
}

static void assert_same(const Snapshot& expected, const Snapshot& actual) {
    require(actual.event_count == expected.event_count, "event count");
    for (U i = 0u; i < expected.event_count; ++i) {
        require(actual.events[i].kind == expected.events[i].kind, "event kind");
        require(actual.events[i].a == expected.events[i].a, "event a");
        require(actual.events[i].b == expected.events[i].b, "event b");
        require(actual.events[i].c == expected.events[i].c, "event c");
        require(actual.events[i].d == expected.events[i].d, "event d");
    }
    require(std::memcmp(actual.slots, expected.slots, 0x218u) == 0,
            "view slots");
    require(std::memcmp(actual.camera, expected.camera, 12u) == 0, "camera");
    require(actual.flag == expected.flag, "route flag");
    require(actual.string_byte == expected.string_byte, "route string byte");
    require(actual.scene_flag == expected.scene_flag, "scene flag");
    require(actual.scene_buffer == expected.scene_buffer, "scene buffer");
    require(actual.transfer_state == expected.transfer_state,
            "transfer state");
    require(std::memcmp(actual.castle, expected.castle, 7u) == 0, "castle");
    require(service_equal(actual.service_mirror, expected.service_mirror),
            "service object");
    require(actual.pool_used == expected.pool_used, "pool used");
    require(std::memcmp(actual.pool, expected.pool, kPoolBytes) == 0, "pool");
    require(std::memcmp(actual.route_object, expected.route_object,
                        kRouteObjectBytes) == 0,
            "route object");
    require(std::memcmp(actual.display, expected.display, 0x80u) == 0,
            "display");
    require(std::memcmp(actual.device, expected.device, 0x40u) == 0, "device");
    require(std::memcmp(actual.core, expected.core, 4u) == 0, "core");
    require(actual.display_ptr == expected.display_ptr, "display global");
    require(actual.core_ptr == expected.core_ptr, "core global");
}

static void verify_original_data() {
    // Raw original .data bytes from the pinned PE.
    static const B flag_witness[4] = {0x01u, 0x00u, 0x00u, 0x00u};
    static const B camera_witness[12] = {0x00u, 0x00u, 0x00u, 0x00u, 0xcdu,
                                         0xccu, 0xccu, 0x3eu, 0x66u, 0x66u,
                                         0x66u, 0x3fu};
    static const B castle_witness[7] = {0x63u, 0x61u, 0x73u, 0x74u, 0x6cu,
                                        0x65u, 0x00u};
    U flag_init;
    std::memcpy(&flag_init, flag_witness, 4u);
    require(view_route_flag_005cf584 == flag_init, "original 005cf584 init");
    require(view_route_string_005cf5d8 == 0x02u, "original 005cf5d8 init");
    require(std::memcmp(view_setup_camera_005cf620, camera_witness, 12u) == 0,
            "original 005cf620 bytes");
    require(std::memcmp(view_castle_string_005cf760, castle_witness, 7u) == 0,
            "original 005cf760 bytes");
    require(scene_buffer_0062814c == nullptr, "original 0062814c init");
    require(scene_transfer_state_0061976c == nullptr, "original 0061976c init");
    require(scene_flag_00619800 == 0u, "original 00619800 init");
}

static void reset_state() {
    std::memset(view_slot_table_00627e80, 0, 0x218u);
    std::memset(route_object_registry_table_005e8c00, 0, 36u);
    view_setup_camera_005cf620[0] = 0x00000000u;
    view_setup_camera_005cf620[1] = 0x3eccccccu;
    view_setup_camera_005cf620[2] = 0x3f666666u;
    view_route_flag_005cf584 = 1u;
    view_route_string_005cf5d8 = 2u;
    std::memcpy(view_castle_string_005cf760, "castle", 7u);
    scene_buffer_0062814c = nullptr;
    scene_transfer_state_0061976c = nullptr;
    scene_flag_00619800 = 0u;
    std::memset(pool, 0xcdu, kPoolBytes);
    pool_used = 0u;
    std::memset(display_object.bytes, 0, 0x80u);
    std::memset(device_object, 0, 0x40u);
    std::memset(core_object, 0, 4u);
    render_display_00628130 = nullptr;
    render_core_0065b39c = nullptr;
    event_count = 0u;
    std::memset(service_object_mirror, 0, 0x30u);
    std::memset(route_object, 0, kRouteObjectBytes);
    application_state_006573e8.word(0x00657404u) = 0u;
    application_state_006573e8.word(0x0065741cu) = 0u;
    application_state_006573e8.word(0x00657a24u) = 0u;
    application_state_006573e8.word(0x00657a30u) = 0u;
    for (U i = 0u; i < 8u; ++i) {
        application_state_006573e8.word(0x00657444u + i * 4u) = 0u;
    }
}

static void fill_route_object(U seed) {
    U state = 0x1234567u + seed * 0x9e3779b9u;
    for (U i = 0u; i < kRouteObjectBytes; ++i) {
        state = state * 1664525u + 1013904223u;
        route_object[i] = static_cast<B>(state >> 24);
    }
}

static void setup_view_case(U mode, U route_index, B camera_byte, U prefill,
                            const char* name) {
    reset_state();
    case_fail_alloc38 = 0u;
    case_fail_alloc8 = 0u;
    application_state_006573e8.word(0x00657404u) = mode;
    application_state_006573e8.word(0x0065741cu) = route_index;
    view_route_string_005cf5d8 = camera_byte;
    fill_route_object(route_index + prefill * 37u);
    route_object_registry_table_005e8c00[route_index] = route_object;
    if (prefill != 0u) {
        for (U i = 0u; i < 0x218u; ++i) {
            view_slot_table_00627e80[i] = static_cast<B>(0x31u + i);
        }
    }
    // 0x00657444 is the arena name buffer handed to the compare endpoint.
    std::memcpy(reinterpret_cast<B*>(&application_state_006573e8) +
                    (0x00657444u - application_state_base_va),
                name, std::strlen(name) + 1u);
}

static void run_view_case(U mode, U route_index, B camera_byte, U prefill,
                          const char* name) {
    ++cases;
    Snapshot current{};
    Fpu fpu[2] = {};
    U abi_fail[2] = {};
    U eax[2] = {};
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        setup_view_case(mode, route_index, camera_byte, prefill, name);
        void* const fn =
            (side == 0u)
                ? slot_004640b0
                : reinterpret_cast<void*>(&application_main_function_004640b0);
        eax[side] = invoke_body(fn, abi_fail[side], fpu[side]);
        capture(current);
        if (side == 0u) {
            saved = current;
        }
    }
    require(abi_fail[0] == 0u, "original abi fail");
    require(abi_fail[1] == 0u, "cpp abi fail");
    require(eax[0] == eax[1], "return value");
    require(std::memcmp(&fpu[0], &fpu[1], sizeof(Fpu)) == 0, "fpu state");
    assert_same(saved, current);
}

static void prepare_teardown_objects(U device_present, U state_7c,
                                     U state_6c) {
    device_vtable[0] = 0u;
    device_vtable[1] = 0u;
    core_vtable[0] = 0u;
    core_vtable[1] =
        address(reinterpret_cast<const void*>(&core_release_slot1));
    store_dword(core_object, 0u, address(core_vtable));
    render_core_0065b39c = reinterpret_cast<RenderCore*>(core_object);
    device_vtable[0] =
        address(reinterpret_cast<const void*>(&device_release_slot0));
    store_dword(device_object, 0u, address(device_vtable));
    store_dword(device_object, 0x04u, 0x11223344u);
    store_dword(device_object, 0x08u, 0x55667788u);
    render_display_00628130 = &display_object;
    store_dword(display_object.bytes, 0x70u,
                device_present != 0u ? address(device_object) : 0u);
    store_dword(display_object.bytes, 0x74u, address(&display_object));
    store_dword(display_object.bytes, 0x7cu,
                state_7c != 0u ? address(pool + 0x100u) : 0u);
    store_dword(display_object.bytes, 0x6cu,
                state_6c != 0u ? address(pool + 0x140u) : 0u);
}

static void run_teardown_case(U display_present, U state_7c, U device_present,
                              U state_6c, U core_present) {
    ++cases;
    Snapshot current{};
    Fpu fpu[2] = {};
    U abi_fail[2] = {};
    U eax[2] = {};
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        reset_state();
        case_fail_alloc38 = 0u;
        case_fail_alloc8 = 0u;
        // Reserved pool cells for the display-held objects.
        store_dword(pool, 0x100u, 0x1a2b3c4du);
        store_dword(pool, 0x140u, 0x5e6f7081u);
        if (display_present != 0u) {
            prepare_teardown_objects(device_present, state_7c, state_6c);
        } else {
            core_vtable[0] = 0u;
            core_vtable[1] =
                address(reinterpret_cast<const void*>(&core_release_slot1));
            store_dword(core_object, 0u, address(core_vtable));
            render_core_0065b39c = core_present != 0u
                ? reinterpret_cast<RenderCore*>(core_object)
                : nullptr;
        }
        void* const fn =
            (side == 0u)
                ? slot_00467740
                : reinterpret_cast<void*>(&application_main_function_00467740);
        eax[side] = invoke_body(fn, abi_fail[side], fpu[side]);
        capture(current);
        if (side == 0u) {
            saved = current;
        }
    }
    require(abi_fail[0] == 0u, "original abi fail");
    require(abi_fail[1] == 0u, "cpp abi fail");
    require(eax[0] == eax[1], "return value");
    require(std::memcmp(&fpu[0], &fpu[1], sizeof(Fpu)) == 0, "fpu state");
    assert_same(saved, current);
}

static void run_scene_case(U fail_alloc8, U seed) {
    ++cases;
    Snapshot current{};
    Fpu fpu[2] = {};
    U abi_fail[2] = {};
    U eax[2] = {};
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        reset_state();
        case_fail_alloc38 = 0u;
        case_fail_alloc8 = fail_alloc8;
        application_state_006573e8.word(0x00657a24u) = 0x111u + seed;
        application_state_006573e8.word(0x00657a30u) = 0x222u + seed * 3u;
        // The original dereferences the display global without a null check;
        // a non-null display with a populated device payload is the covered
        // domain.
        device_vtable[0] = 0u;
        device_vtable[1] = 0u;
        core_vtable[0] = 0u;
        core_vtable[1] =
            address(reinterpret_cast<const void*>(&core_release_slot1));
        store_dword(core_object, 0u, address(core_vtable));
        render_core_0065b39c = reinterpret_cast<RenderCore*>(core_object);
        device_vtable[0] =
            address(reinterpret_cast<const void*>(&device_release_slot0));
        store_dword(device_object, 0u, address(device_vtable));
        store_dword(device_object, 0x04u, address(device_object + 0x08u));
        for (U field = 0u; field < 14u; ++field) {
            store_dword(device_object, 0x08u + field * 4u,
                        0x3a000000u + field * 0x010101u + seed * 0x1000u);
        }
        render_display_00628130 = &display_object;
        store_dword(display_object.bytes, 0x70u, address(device_object));
        store_dword(display_object.bytes, 0x74u, address(&display_object));
        void* const fn =
            (side == 0u)
                ? slot_00468fb0
                : reinterpret_cast<void*>(&startup_sequence_call_00468fb0);
        eax[side] = invoke_body(fn, abi_fail[side], fpu[side]);
        capture(current);
        if (side == 0u) {
            saved = current;
        }
    }
    require(abi_fail[0] == 0u, "original abi fail");
    require(abi_fail[1] == 0u, "cpp abi fail");
    require(eax[0] == eax[1], "return value");
    require(std::memcmp(&fpu[0], &fpu[1], sizeof(Fpu)) == 0, "fpu state");
    assert_same(saved, current);
}

