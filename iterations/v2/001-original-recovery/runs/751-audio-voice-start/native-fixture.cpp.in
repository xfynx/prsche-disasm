static U invoke_4(void* fn,U a0,U a1,U a2,U a3) {
    U saved_sp=0u,saved_bp=0u,fail=0u;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp,esp
        mov saved_bp,ebp
        push a3
        push a2
        push a1
        push a0
        mov ebx,0x13579bdf
        mov esi,0x2468ace0
        mov edi,0x10203040
        call fn
        mov captured_return,eax
        add esp,16
        cmp esp,saved_sp
        jne bad_abi
        cmp ebp,saved_bp
        jne bad_abi
        cmp ebx,0x13579bdf
        jne bad_abi
        cmp esi,0x2468ace0
        jne bad_abi
        cmp edi,0x10203040
        je ok_abi
    bad_abi:
        mov fail,1
    ok_abi:
        mov esp,saved_sp
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static void init_original() {
    static const B parent[] = {@BODY_005612A0@};
    static const B helper[] = {@BODY_00561180@};
    code=static_cast<B*>(VirtualAlloc(nullptr,4096u,MEM_COMMIT|MEM_RESERVE,PAGE_EXECUTE_READWRITE));
    require(code!=nullptr,"code alloc");
    orig_5612a0=code;
    orig_561180=code+1024u;
    std::memcpy(orig_5612a0,parent,sizeof parent);
    std::memcpy(orig_561180,helper,sizeof helper);
    auto rel=[](B* fn,U off,const void* target){ wr(fn,off,address(target)-address(fn+off+4u)); };
    wr(orig_5612a0,0x07u,address(&porsche::application_audio_device_state_006b48c0[0xdcu]));
    wr(orig_5612a0,0x43u,address(porsche::audio_stream_slots_006b7cc0));
    wr(orig_5612a0,0x158u,address(&backend_base));
    wr(orig_5612a0,0x2a6u,address(&backend_base));
    rel(orig_5612a0,0x04cu,reinterpret_cast<const void*>(porsche::audio_backend_lock_005896d0));
    rel(orig_5612a0,0x0cfu,reinterpret_cast<const void*>(porsche::audio_group_step_0058a970));
    rel(orig_5612a0,0x0fbu,reinterpret_cast<const void*>(porsche::audio_backend_candidate_range_0058a4b0));
    rel(orig_5612a0,0x116u,reinterpret_cast<const void*>(porsche::audio_backend_allocate_voice_005898f0));
    rel(orig_5612a0,0x145u,orig_561180);
    rel(orig_5612a0,0x235u,reinterpret_cast<const void*>(porsche::audio_voice_recompute_pitch_00589f40));
    rel(orig_5612a0,0x23fu,reinterpret_cast<const void*>(porsche::audio_voice_recompute_gain_00589df0));
    rel(orig_5612a0,0x24au,reinterpret_cast<const void*>(porsche::audio_voice_recompute_send_00589d70));
    rel(orig_5612a0,0x286u,reinterpret_cast<const void*>(porsche::audio_voice_backend_start_005897c0));
    rel(orig_5612a0,0x2b0u,reinterpret_cast<const void*>(porsche::audio_backend_voice_finalize_00589c00));
    rel(orig_5612a0,0x2dcu,reinterpret_cast<const void*>(porsche::audio_group_step_0058a970));
    rel(orig_5612a0,0x2f0u,reinterpret_cast<const void*>(porsche::audio_backend_unlock_005896f0));
    rel(orig_5612a0,0x306u,reinterpret_cast<const void*>(porsche::audio_backend_unlock_005896f0));
    wr(orig_561180,0x22u,address(&backend_base));
    FlushInstructionCache(GetCurrentProcess(),code,4096u);
}
static void reset() {
    std::memset(arena,0xa5,sizeof arena);
    std::memset(&porsche::application_audio_device_state_006b48c0,0,sizeof porsche::application_audio_device_state_006b48c0);
    std::memset(porsche::audio_stream_slots_006b7cc0,0,sizeof porsche::audio_stream_slots_006b7cc0);
    std::memset(&trace,0,sizeof trace);
    std::memset(candidates,0,sizeof candidates);
    std::memset(voices,0,sizeof voices);
    std::memset(handles,0,sizeof handles);
    std::memset(starts,0,sizeof starts);
    candidate_count=candidate_cursor=allocation_count=allocation_cursor=start_count=start_cursor=0u;
    backend_base=address(arena+0x2000u);
}
static void finish(U abi_fail) {
    trace.ret=captured_return;
    trace.abi_fail=abi_fail;
    std::memcpy(trace.device,porsche::application_audio_device_state_006b48c0.backing.data(),sizeof trace.device);
    std::memcpy(trace.slots,porsche::audio_stream_slots_006b7cc0,sizeof trace.slots);
    std::memcpy(trace.memory,arena,sizeof trace.memory);
    capture_fp(trace.fp);
}
static void compare() {
    require(trace.abi_fail==0u&&expected.abi_fail==0u,"abi");
    require(trace.ret==expected.ret,"return");
    require(trace.count==expected.count,"event count");
    require(std::memcmp(trace.events,expected.events,trace.count*sizeof(Event))==0,"events");
    require(std::memcmp(trace.device,expected.device,sizeof trace.device)==0,"device");
    require(std::memcmp(trace.slots,expected.slots,sizeof trace.slots)==0,"slots");
    require(std::memcmp(trace.memory,expected.memory,sizeof trace.memory)==0,"memory");
    require(std::memcmp(&trace.fp,&expected.fp,sizeof trace.fp)==0,"fpu");
    ++cases; events_total+=trace.count;
}
template <typename Setup> static void run_case(Setup setup) {
    B* const header=arena+0x0400u;
    B* const params=arena+0x0500u;
    B* const descriptor=arena+0x0600u;
    which=0u; reset(); setup(); U fail=invoke_4(orig_5612a0,3u,address(header),address(params),address(descriptor)); finish(fail); expected=trace;
    which=1u; reset(); setup(); fail=invoke_4(reinterpret_cast<void*>(porsche::audio_stream_voice_start_005612a0),3u,address(header),address(params),address(descriptor)); finish(fail); compare();
}
static void common(B*& header,B*& params,B*& descriptor,B*& slot) {
    header=arena+0x0400u; params=arena+0x0500u; descriptor=arena+0x0600u; slot=arena+0x1000u;
    porsche::application_audio_device_state_006b48c0[0xdcu]=1u;
    porsche::application_audio_device_state_006b48c0[0x1du]=5u;
    porsche::application_audio_device_state_006b48c0[0xe4u]=12u;
    porsche::application_audio_device_state_006b48c0[0xe5u]=0u;
    porsche::audio_stream_slots_006b7cc0[3]=address(slot);
    wr(header,0u,0x11220234u); wr8(header,2u,2u);
    wr16(params,0u,0x2345u); wr8(params,3u,0x31u); wr8(params,4u,0x32u); wr8(params,5u,0x33u); wr8(params,6u,0xfeu);
    wr(params,0x14u,0xa1a2a3a4u); wr(params,0x18u,0xb1b2b3b4u);
    wr8(descriptor,7u,0x3eu); wr8(descriptor,8u,0xfeu); wr8(descriptor,9u,0x41u); wr8(descriptor,0x0au,0x42u);
    wr16(descriptor,0x0cu,0x3456u); wr16(descriptor,0x0eu,0x4567u); wr16(descriptor,0x12u,0x5678u); wr16(descriptor,0x14u,0x6789u); wr16(descriptor,0x18u,0x789au);
    wr(slot,0u,0x0badbeefu); wr8(slot,0x36u,2u);
    wr16(arena+0x2000u+0x70u,4u,10u); wr16(arena+0x2000u+0x70u,6u,30u);
    wr16(arena+0x2000u+0x70u*2u,4u,0xfffbu); wr16(arena+0x2000u+0x70u*2u,6u,7u);
}
static void add_candidate(U value) { require(candidate_count<kMaxScript,"candidate script"); candidates[candidate_count++]=value; }
static void add_allocation(I voice,U handle) { require(allocation_count<kMaxScript,"allocation script"); voices[allocation_count]=voice; handles[allocation_count++]=handle; }
static void add_start(I result) { require(start_count<kMaxScript,"start result script"); starts[start_count++]=result; }

int main() {
    AddVectoredExceptionHandler(1,fault_handler);
    init_original();
    run_case([]{});
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); });
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); add_candidate(4u); add_allocation(-9,0x99887766u); });
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); wr16(arena+0x2000u+0x70u,4u,30u); add_candidate(4u); add_allocation(1,0x12340101u); add_start(0); });
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); add_candidate(4u); add_allocation(0,0x12340000u); add_start(0); });
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); add_candidate(0x10u); add_candidate(4u); add_allocation(2,0x12340202u); add_allocation(-9,0x12340303u); add_start(-7); });
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); add_candidate(0x10u); add_candidate(4u); add_allocation(2,0x12340404u); add_allocation(1,0x12340505u); add_start(-6); add_start(3); });
    run_case([]{ B *h,*p,*d,*s; common(h,p,d,s); wr8(h,2u,0u); wr8(s,0x36u,0u); wr8(d,0x0bu,1u); add_candidate(4u); add_allocation(1,0x12340606u); add_start(0); });
    std::printf("audio_voice_start_original_x86_vs_cpp=PASS cases=%u events=%u\n",cases,events_total);
    return 0;
}
