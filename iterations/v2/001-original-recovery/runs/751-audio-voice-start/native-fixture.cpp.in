enum : U { kArenaBytes = 32768u, kMaxEvents = 96u, kMaxScript = 8u };
enum EventTag : U {
    kLock=1u, kUnlock, kStep, kRange, kAllocate, kPitch, kGain, kSend, kStart, kFinalize
};
struct Event { U value[12]; };
struct FpuSnapshot { unsigned short control,status,tag,pad; B values[80]; U mxcsr; };
struct Trace {
    U ret, abi_fail, count;
    Event events[kMaxEvents];
    B device[0x18c];
    U slots[16];
    B memory[kArenaBytes];
    FpuSnapshot fp;
};

alignas(256) static B arena[kArenaBytes];
alignas(16) static B fp_area[512];
static B fp_env[28];
static Trace trace{}, expected{};
static U candidates[kMaxScript]{}, candidate_count=0u, candidate_cursor=0u;
static I voices[kMaxScript]{};
static U handles[kMaxScript]{}, allocation_count=0u, allocation_cursor=0u;
static I starts[kMaxScript]{};
static U start_count=0u, start_cursor=0u;
static U cases=0u, events_total=0u, which=0u, captured_return=0u;
static B* code=nullptr;
static B* orig_5612a0=nullptr;
static B* orig_561180=nullptr;
static U backend_base=0u;

static U address(const void* p) { return static_cast<U>(reinterpret_cast<std::uintptr_t>(p)); }
static U rd(const void* p,U o=0u) { U v=0u; std::memcpy(&v,static_cast<const B*>(p)+o,4u); return v; }
static void wr(void* p,U o,U v) { std::memcpy(static_cast<B*>(p)+o,&v,4u); }
static void wr16(void* p,U o,std::uint16_t v) { std::memcpy(static_cast<B*>(p)+o,&v,2u); }
static void wr8(void* p,U o,B v) { std::memcpy(static_cast<B*>(p)+o,&v,1u); }
static void require(bool ok,const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n",why,cases,which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}
static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode,p->ContextRecord->Eip,cases,which);
    std::fflush(stdout);
    ExitProcess(1);
    return EXCEPTION_CONTINUE_SEARCH;
}
static Event& event(U tag) {
    require(trace.count<kMaxEvents,"event overflow");
    Event& e=trace.events[trace.count++];
    std::memset(&e,0,sizeof e);
    e.value[0]=tag;
    return e;
}
static void capture_fp(FpuSnapshot& fp) {
    __asm fxsave fp_area
    __asm fnstenv fp_env
    __asm fldenv fp_env
    fp.control=static_cast<unsigned short>(rd(fp_area,0u));
    fp.status=static_cast<unsigned short>(rd(fp_area,2u));
    fp.tag=static_cast<unsigned short>(rd(fp_env,8u));
    fp.pad=0u;
    fp.mxcsr=rd(fp_area,24u);
    for (U i=0u;i<8u;++i) {
        std::memcpy(fp.values+i*10u,fp_area+32u+i*16u,10u);
        if ((fp_area[4u]&(1u<<(((fp.status>>11u)+i)&7u)))==0u) std::memset(fp.values+i*10u,0,10u);
    }
}

namespace porsche {
ApplicationAudioDeviceStateStorage application_audio_device_state_006b48c0{};
U audio_stream_slots_006b7cc0[16]{};
U& audio_backend_channels_006b4a00=backend_base;

void __cdecl audio_backend_lock_005896d0() { event(kLock); }
void __cdecl audio_backend_unlock_005896f0() { event(kUnlock); }
U __cdecl audio_group_step_0058a970(U* out,const void*) {
    const U result=candidate_cursor<candidate_count?candidates[candidate_cursor++]:0u;
    Event& e=event(kStep); e.value[1]=*out; e.value[2]=result;
    ++*out;
    return result;
}
void __cdecl audio_backend_candidate_range_0058a4b0(U candidate,U* first,U* last) {
    if ((candidate&4u)!=0u) { *first=0u; *last=application_audio_device_state_006b48c0[0x1du]; }
    else if ((candidate&0x10u)!=0u) { *first=application_audio_device_state_006b48c0[0x1du]; *last=static_cast<U>(static_cast<std::uint16_t>(application_audio_device_state_006b48c0[0xe4u] | (application_audio_device_state_006b48c0[0xe5u]<<8u))); }
    Event& e=event(kRange); e.value[1]=candidate; e.value[2]=*first; e.value[3]=*last;
}
I __cdecl audio_backend_allocate_voice_005898f0(I channel_count,U priority,U* handle,U first,U last) {
    require(allocation_cursor<allocation_count,"allocation script");
    const U n=allocation_cursor++;
    *handle=handles[n];
    Event& e=event(kAllocate); e.value[1]=static_cast<U>(channel_count); e.value[2]=priority;
    e.value[3]=first; e.value[4]=last; e.value[5]=*handle; e.value[6]=static_cast<U>(voices[n]);
    return voices[n];
}
void __cdecl audio_voice_recompute_pitch_00589f40(U slot) { Event& e=event(kPitch); e.value[1]=slot; }
void __cdecl audio_voice_recompute_gain_00589df0(U slot) { Event& e=event(kGain); e.value[1]=slot; }
void __cdecl audio_voice_recompute_send_00589d70(U bus,U slot) { Event& e=event(kSend); e.value[1]=bus; e.value[2]=slot; }
I __cdecl audio_voice_backend_start_005897c0(U stream,U voice,U candidate,U d0e,U d12,U d14,const void* header,const void* p0c,const void* p14) {
    require(start_cursor<start_count,"start script");
    const I result=starts[start_cursor++];
    Event& e=event(kStart); e.value[1]=stream; e.value[2]=voice; e.value[3]=candidate;
    e.value[4]=d0e; e.value[5]=d12; e.value[6]=d14; e.value[7]=address(header);
    e.value[8]=address(p0c); e.value[9]=address(p14); e.value[10]=static_cast<U>(result);
