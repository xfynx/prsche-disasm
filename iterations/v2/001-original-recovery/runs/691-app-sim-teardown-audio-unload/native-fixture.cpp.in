static int exception_record(EXCEPTION_POINTERS* e) {
    trace.exception[0] = e->ExceptionRecord->ExceptionCode;
    trace.exception[1] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[0]);
    trace.exception[2] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[1]);
    return EXCEPTION_EXECUTE_HANDLER;
}

static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}

static void relocate_call(B* slot, U off, U orig_va, U orig_target, const void* target) {
    const U actual = orig_va + 4u + word(slot, off);
    require(actual == orig_target, "exact relative call target");
    const U rel = address(target) - (address(slot) + off + 4u);
    put(slot, off, rel);
}

static U arena_word_address(U va) {
    return address(&porsche::application_state_006573e8.words()[(va - kArenaBase) / 4u]);
}

static void init() {
    // Assert production initial state against raw PE bytes before any reset.
    static const B raw_5d1a1c[] = {@STR_005D1A1C@};
    static const B raw_5d1a20[] = {@STR_005D1A20@};
    static const B raw_5d6e60[] = {@STR_005D6E60@};
