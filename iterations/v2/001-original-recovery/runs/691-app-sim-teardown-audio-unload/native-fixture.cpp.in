}

struct DeinitPlayer {
    const char* name_17c;
    U descriptor_00;
    U descriptor_08;
    const char* name_534;
    U object_52c;
    U setup_block[0x96];
};

struct DeinitCfg {
    I count_658080;
    DeinitPlayer players[3];
};

static void setup_deinit(const DeinitCfg& s) {
    reset_common();
    put(porsche::application_state_006573e8.words().data(), (0x00658080u - kArenaBase), static_cast<U>(s.count_658080));
    for (U i = 0u; i < 3u; ++i) {
        std::uint8_t* const object = object_buf[i];
        // Scenarios with count==0 leave the unused players default-constructed
        // (null names). Keep their backing cells deterministic without reading
        // a null string; the recovered bodies never index those players.
        const char* const name_17c = s.players[i].name_17c ? s.players[i].name_17c : "";
        const char* const name_534 = s.players[i].name_534 ? s.players[i].name_534 : "";
        std::memcpy(descriptor_buf[i] + 0x17cu, name_17c,
                    std::strlen(name_17c) + 1u);
        put(descriptor_buf[i], 0x00u, s.players[i].descriptor_00);
        put(descriptor_buf[i], 0x08u, s.players[i].descriptor_08);
        std::memcpy(descriptor_buf[i] + 0x534u, name_534,
                    std::strlen(name_534) + 1u);
        put(object, 0x558u, address(descriptor_buf[i]));
        put(object, 0x55cu, 0x7777u);
        put(object, 0x52cu, s.players[i].object_52c);
        put(object, 0xb6cu, 0x11110000u + i);
        put(object, 0xb70u, 0x22220000u + i);
        put(object, 0xb74u, 0x33330000u + i);
        std::memset(object + 0xb78u, 0x5au, 0x40u);
        std::memset(object + 0xbb8u, 0x5bu, 0x80u);
        for (U k = 0u; k < 0x96u; ++k) {
            put(object, 0xad4u + k * 4u, s.players[i].setup_block[k]);
        }
        porsche::application_player_object_table_005e8b34[i] = address(object);
        for (U k = 0u; k < 0x96u; ++k) {
            porsche::application_player_setup_table_005e75a0[i * 0x96u + k] = 0xdead0000u + k;
        }
    }
}

static void run_deinit_pair(const DeinitCfg& s) {
    ++cases;

    cpp_side = false;
    std::memset(&trace, 0, sizeof(trace));
    setup_deinit(s);
    __try {
        trace.abi_fail = invoke_cdecl0(slot_4b68f0);
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_trace();
    expected = trace;

    cpp_side = true;
    std::memset(&trace, 0, sizeof(trace));
    setup_deinit(s);
    __try {
        trace.abi_fail = invoke_cdecl0(
            reinterpret_cast<void*>(&porsche::application_main_function_004b68f0));
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_trace();
    compare_traces();
}

static DeinitPlayer deinit_player(const char* name17c, U d0, U d8, const char* name534, U f52c) {
    DeinitPlayer p{};
    p.name_17c = name17c;
    p.descriptor_00 = d0;
    p.descriptor_08 = d8;
    p.name_534 = name534;
    p.object_52c = f52c;
    for (U k = 0u; k < 0x96u; ++k) {
        p.setup_block[k] = 0x5a5a0000u + k * 0x101u;
    }
    return p;
}

int main() {
    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
    init();

    // ---- 004a88a0 scenarios ----
    {
        UnloadCfg s = unload_base();
        s.gate_657c94 = 5u;
        run_unload_pair(s);
        s.gate_657c94 = 0u;
        run_unload_pair(s); // empty everything: free loops, no load loop
    }
    {
        UnloadCfg s = unload_base();
        s.table[0] = {5, -1, 0};
        s.table[1] = {5, 7, 0x12345678u};
        s.table[2] = {5, 0, 0u};
        s.table[3] = {5, -2, 0x9abcdef0u};
        s.table[4] = {-1, 7, 0x1111u};
        s.table[5] = {-2, -1, 0};
        s.table[31] = {5, 9, 0x2222u};
        s.state_5e99f4 = 2u;
        run_unload_pair(s);
    }
    {
        UnloadCfg s = unload_base();
        s.frame_pairs[0][0] = 0u;
        s.frame_pairs[0][1] = 44u;
        s.frame_pairs[1][0] = 0x80000000u;
        s.frame_pairs[1][1] = 0xffffffffu;
        s.frame_pairs[72][0] = 0x11223344u;
        s.frame_pairs[72][1] = 0x55667788u;
        s.byte_656868 = 1u;
        s.state_5e99f4 = 1u;
        run_unload_pair(s);
        s.byte_656868 = 0u;
        run_unload_pair(s);
    }
    {
        UnloadCfg s = unload_base();
        s.active_5d1734 = 1u;
        s.word_5d1750 = 0u;
        s.clock_len = 2u;
        s.clock_seq[0] = 10u;
        s.clock_seq[1] = 20u;
        run_unload_pair(s); // <=0 word_5d1750: straight to tail
        s.word_5d1750 = -1;
        run_unload_pair(s);
    }
    {
        UnloadCfg s = unload_base();
        s.active_5d1734 = 1u;
        s.word_5d1750 = 0x7f;
        s.clock_len = 3u;
        s.clock_seq[0] = 10u;
        s.clock_seq[1] = 20u;
        s.clock_seq[2] = 20u; // second check equal to deadline-0x280+20 < 0x280
        run_unload_pair(s); // one full iteration then success (no a8570 call, mode != 1)
    }
    {
        UnloadCfg s = unload_base();
        s.active_5d1734 = 1u;
        s.word_5d1750 = 0x7f;
        s.mode_657a24 = 1u;
        s.clock_len = 3u;
        s.clock_seq[0] = 10u;
        s.clock_seq[1] = 0x200u; // inside [0x180,0x280): distinguishes the timeout constant
        s.clock_seq[2] = 0x80000000u; // deadline (0x290) <= now -> exit after retry
        s.a8570_len = 4u;
        s.a8570_seq[0] = -1;
        s.a8570_seq[1] = -1;
        s.a8570_seq[2] = 5;
        run_unload_pair(s); // mode==1, a8570 fails twice then succeeds on retry
    }
    {
        UnloadCfg s = unload_base();
        s.active_5d1734 = 1u;
        s.word_5d1750 = 0x7f;
        s.count_658080 = 2;
        s.arena_record_count = 2u;
        s.arena_records[0][0] = 0x41u;
        s.arena_records[0][1] = 2u;
        s.arena_records[1][0] = 0x42u;
        s.arena_records[1][1] = 3u; // >2: original skips; a >=2 mutation would process it
        s.mode_657a24 = 2u;
        s.clock_len = 3u;
        s.clock_seq[0] = 10u;
        s.clock_seq[1] = 20u;
        s.clock_seq[2] = 0x80000000u;
        s.b04d0_len = 4u;
        s.b04d0_seq[0] = 0x5555;
        s.b04d0_seq[1] = -1;
        s.b04d0_seq[2] = 0x6666;
        s.a8570_len = 4u;
        s.a8570_seq[0] = 11;
        s.a8570_seq[1] = -1;
        run_unload_pair(s); // record0: b04d0 ok both, record1: mode!=2 skip
    }
    {
        UnloadCfg s = unload_base();
        s.active_5d1734 = 1u;
        s.word_5d1750 = 0x7f;
        s.count_658080 = 2;
        s.arena_record_count = 2u;
        s.arena_records[0][0] = 0x41u;
        s.arena_records[0][1] = 2u;
        s.arena_records[1][0] = 0x42u;
        s.arena_records[1][1] = 2u;
        s.mode_657a24 = 1u;
        s.clock_len = 2u;
        s.clock_seq[0] = 10u;
        s.clock_seq[1] = 0x80000000u;
        s.b04d0_len = 8u;
        s.b04d0_seq[0] = 100;
        s.b04d0_seq[1] = 200;
        s.b04d0_seq[2] = 300;
        s.b04d0_seq[3] = 400;
        s.a8570_len = 8u;
        s.a8570_seq[0] = -1;  // mode==1 path fails
        s.a8570_seq[1] = -1;  // record0 second call fails
        s.a8570_seq[2] = -1;  // record1 first call fails
        s.a8570_seq[3] = -1;  // record1 second call fails -> retry
        s.a8570_seq[4] = 1;
        s.a8570_seq[5] = 2;
        s.a8570_seq[6] = 3;
        s.a8570_seq[7] = 4;
        s.b04d0_seq[4] = 100;
        s.b04d0_seq[5] = 200;
        s.b04d0_seq[6] = 300;
        s.b04d0_seq[7] = 400;
        run_unload_pair(s); // full retry: all four a8570 calls fail, second round succeeds
    }
    {
        UnloadCfg s = unload_base();
        s.active_5d1734 = 1u;
        s.word_5d1750 = 0x7f;
        s.count_658080 = 1;
        s.arena_record_count = 1u;
        s.arena_records[0][0] = 0x41u;
        s.arena_records[0][1] = 2u;
        s.mode_657a24 = 1u;
        s.clock_len = 4u;
        s.clock_seq[0] = 10u;
        s.clock_seq[1] = 20u;
        s.clock_seq[2] = 20u;
        s.clock_seq[3] = 0x80000000u;
        s.b04d0_len = 2u;
        s.b04d0_seq[0] = 0x5555;
        s.b04d0_seq[1] = 0x6666;
        s.a8570_len = 2u;
        s.a8570_seq[0] = -1;
        s.a8570_seq[1] = -1;
        s.a8570_decrements_count = 1u;
        run_unload_pair(s); // stub decrements 00658080 -> loop shrinks
    }
    {
        UnloadCfg s = unload_base();
        s.state_5e99f4 = 0xfffffffeu; // signed -2 < 2 -> tail runs
        run_unload_pair(s);
        s.state_5e99f4 = 2u;
        run_unload_pair(s); // tail skipped
        s.state_5e99f4 = 3u;
        run_unload_pair(s);
    }
    {
        UnloadCfg s = unload_base();
        s.ae470_writes = 1u;
        run_unload_pair(s); // 004ae470 writes through the passed pointer
    }
    {
        UnloadCfg s = unload_base();
        s.stop_ret = 0xfeedf00du;
        s.free_ret = 0xdeadbeefu;
        s.pump_ret = 0x99999999u;
        run_unload_pair(s); // unused returns recorded
    }

    // ---- 004a8cd0 scenarios ----
    {
        PlaylistCfg s{};
        s.active_5d1734 = 0u;
        s.mode_657c98 = 1;
        s.track_index = 1u;
        s.preset_6564f0 = 0x1234u;
        s.preset_6564c0 = 0x5678u;
        run_playlist_pair(s); // inactive -> untouched presets
    }
    {
        PlaylistCfg s{};
        s.active_5d1734 = 1u;
        s.mode_657c98 = 3;
        s.track_index = 1u;
        s.preset_6564f0 = 0x1234u;
        s.preset_6564c0 = 0x5678u;
        run_playlist_pair(s); // mode > 2 -> untouched presets
        s.mode_657c98 = static_cast<I>(0x80000003u);
        run_playlist_pair(s); // signed > 2
    }
    {
        PlaylistCfg s{};
        s.active_5d1734 = 1u;
        s.mode_657c98 = 0;
        s.track_index = 1u;
        s.preset_6564f0 = 5u;
        s.preset_6564c0 = 6u;
        run_playlist_pair(s); // no prefix
        s.mode_657c98 = 1;
        run_playlist_pair(s); // still no prefix (1 > 1 false)
        s.mode_657c98 = 2;
        run_playlist_pair(s); // prefix appended
        s.mode_657c98 = static_cast<I>(0xfffffffeu);
        run_playlist_pair(s); // signed -2: <=2 and not >1
    }
    {
        PlaylistCfg s{};
        s.active_5d1734 = 1u;
        s.mode_657c98 = 2;
        s.track_index = 0u;
        run_playlist_pair(s); // empty track string
        s.track_index = 2u;
        run_playlist_pair(s); // 63-char track string
        s.track_index = 3u;
        run_playlist_pair(s); // 1-char track string
    }
    {
        PlaylistCfg s{};
        s.active_5d1734 = 1u;
        s.mode_657c98 = 2;
        s.track_index = 1u;
        s.acc10_bumps_mode = 1u;
        run_playlist_pair(s); // stub bumps 00657c98 between the two reads
    }

    // ---- 004b68f0 scenarios ----
    {
        DeinitCfg s{};
        s.count_658080 = 0;
        run_deinit_pair(s); // no players, only teardown calls + logs
    }
    {
        DeinitCfg s{};
        s.count_658080 = 1;
        s.players[0] = deinit_player("carname", 11u, 22u, "sndname", 0x33445566u);
        run_deinit_pair(s);
    }
    {
        DeinitCfg s{};
        s.count_658080 = 3;
        s.players[0] = deinit_player("", 0u, 0u, "", 0u);
        s.players[1] = deinit_player("a", 0xffffffffu, 0x80000000u, "b", 0x7fffffffu);
        s.players[2] = deinit_player("long_track_name_here_0123456789012345678901234567890123456789012345",
                                     3u, 4u, "long_snd_name_here_01234567890123456789012345678901234567",
                                     0xf0f0f0f0u);
        run_deinit_pair(s); // empty + short + long strings, REP tail shapes
    }
    {
        DeinitCfg s{};
        s.count_658080 = -1;
        s.players[0] = deinit_player("carname", 1u, 2u, "sndname", 3u);
        run_deinit_pair(s); // signed negative count skips the loop
        s.count_658080 = 0x80000000u;
        run_deinit_pair(s);
    }
    {
        DeinitCfg s{};
        s.count_658080 = 2;
        s.players[0] = deinit_player("car", 7u, 8u, "snd", 9u);
        s.players[1] = deinit_player("car2", 70u, 80u, "snd2", 90u);
        run_deinit_pair(s);
    }

    require(VirtualFree(code, 0u, MEM_RELEASE) != 0, "raw cleanup");
    std::printf("app_sim_teardown_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
