                  reinterpret_cast<const void*>(&porsche::application_sim_boundary_004a6c90));

    // ---- 004b68f0 relocations (slot VA 0x004b68f0) ----
    relocate_abs32(slot_4b68f0, 0x0cu, 0x00658080u, arena_word_address(0x00658080u));
    static const U kObjectOffs[] = {0x22u, 0x58u, 0x6du, 0x83u, 0x96u, 0xcfu};
