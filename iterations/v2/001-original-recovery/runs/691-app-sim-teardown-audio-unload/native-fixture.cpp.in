    require(sizeof raw_5d1a1c == 4u && std::memcmp(porsche::application_audio_lil_text_005d1a1c, raw_5d1a1c, 4u) == 0,
            "raw .data 005d1a1c");
    require(sizeof raw_5d1a20 == 12u && std::memcmp(porsche::application_audio_bank_suffix_005d1a20, raw_5d1a20, 12u) == 0,
            "raw .data 005d1a20");
    require(sizeof raw_5d6e60 == 6u && std::memcmp(porsche::sim_deinit_done_log_005d6e60, raw_5d6e60, 6u) == 0,
            "raw .data 005d6e60");
    require(sizeof raw_5d6e68 == 13u && std::memcmp(porsche::sim_deinit_log_005d6e68, raw_5d6e68, 13u) == 0,
            "raw .data 005d6e68");
    require(porsche::application_audio_path_prefix_0065b318 == nullptr, "loader-zero 0065b318");
    for (U i = 0u; i < 32u; ++i) {
        require(word(porsche::application_audio_records_00656528, i * 0x18u) == 0u,
                "loader-zero 00656528 table");
    }
    for (U i = 0u; i < 8u; ++i) {
        require(word(porsche::application_audio_records_006564a0, i * 0x10u) == 0u,
                "loader-zero 006564a0 records");
    }
    require(word(porsche::frame_services_records_00656180.data()) == 0u, "loader-zero 00656180");
    require(porsche::frame_services_byte_00656868 == 0 && porsche::frame_services_byte_00656869 == 0,
            "loader-zero 00656868/69");
    require(porsche::frame_services_words_005d1740[0] == 0x7fu &&
            porsche::frame_services_words_005d1740[1] == 0x7fu &&
            porsche::frame_services_words_005d1740[2] == 0x7fu &&
            porsche::frame_services_words_005d1740[3] == 0x7fu &&
            porsche::frame_services_words_005d1740[4] == 0x7fu, "raw .data 005d1740");
    require(porsche::global_005e99f4 == 0u, "loader-zero 005e99f4");
    require(porsche::application_audio_active_005d1734 == 0u, "loader-zero 005d1734");
    require(arena_word(0x00657c94u) == 0u && arena_word(0x00657c98u) == 0u &&
            arena_word(0x00657a24u) == 0u && arena_word(0x00658080u) == 0u &&
            arena_word(0x00657cb8u) == 0u && arena_word(0x00657cbcu) == 0u,
