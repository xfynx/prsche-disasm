__declspec(noinline) static U invoke_cdecl0(void* fn) {
    U before = 0u, frame = 0u, fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        cld
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static void reset_common() {
    std::memset(porsche::application_state_006573e8.words().data(), 0, 0x3e24u);
    std::memset(porsche::application_audio_records_00656528, 0, 0x300u);
    std::memset(porsche::application_audio_records_006564a0, 0, 0x80u);
    std::memset(porsche::frame_services_records_00656180.data(), 0, 146u * 4u);
    porsche::frame_services_byte_00656868 = 0;
    porsche::frame_services_byte_00656869 = 0;
    porsche::frame_services_words_005d1740[0] = 0x7fu;
    porsche::frame_services_words_005d1740[1] = 0x7fu;
    porsche::frame_services_words_005d1740[2] = 0x7fu;
    porsche::frame_services_words_005d1740[3] = 0x7fu;
    porsche::frame_services_words_005d1740[4] = 0x7fu;
    porsche::application_audio_active_005d1734 = 0u;
    porsche::global_005e99f4 = 0u;
    porsche::application_audio_path_prefix_0065b318 = nullptr;
    std::memset(porsche::application_player_object_table_005e8b34, 0, 16u * 4u);
    std::memset(porsche::application_player_setup_table_005e75a0, 0,
                0x96u * 8u * 4u);
    for (U i = 0u; i < 8u; ++i) {
        std::memset(object_buf[i], 0, 0x1000u);
        std::memset(descriptor_buf[i], 0, 0x600u);
    }
    for (U i = 0u; i < 4u; ++i) {
        std::memset(track_buf[i], 0, 64u);
    }
    std::strcpy(track_buf[0], "");
    std::strcpy(track_buf[1], "abc");
    std::strcpy(track_buf[2],
                "track00track11track22track33track44track55track66track77track88");
    std::strcpy(track_buf[3], "q");
    clock_idx = 0u;
    a8570_idx = 0u;
    b04d0_idx = 0u;
}

static void capture_trace() {
    std::memcpy(trace.final_arena, porsche::application_state_006573e8.words().data(),
                0x3e24u);
    std::memcpy(trace.final_records_656528, porsche::application_audio_records_00656528, 0x300u);
    std::memcpy(trace.final_records_6564a0, porsche::application_audio_records_006564a0, 0x80u);
    std::memcpy(trace.final_frame_records, porsche::frame_services_records_00656180.data(), 146u * 4u);
    trace.final_flag_656868[0] = porsche::frame_services_byte_00656868;
    trace.final_flag_656868[1] = porsche::frame_services_byte_00656869;
    std::memcpy(trace.final_words_5d1740, porsche::frame_services_words_005d1740.data(), 20u);
    trace.final_active_5d1734 = porsche::application_audio_active_005d1734;
    trace.final_5e99f4 = porsche::global_005e99f4;
    trace.final_track_ptr = address(porsche::application_audio_path_prefix_0065b318);
    std::memcpy(trace.final_object_table, porsche::application_player_object_table_005e8b34, 16u * 4u);
    std::memcpy(trace.final_setup_table, porsche::application_player_setup_table_005e75a0,
                0x96u * 8u * 4u);
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(trace.final_objects[i], object_buf[i], 0x1000u);
        std::memcpy(trace.final_descriptors[i], descriptor_buf[i], 0x600u);
    }
    std::memcpy(trace.final_track, track_buf, 256u);
}

static void compare_traces() {
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < expected.count; ++i) {
        const Event& a = trace.events[i];
        const Event& b = expected.events[i];
        require(a.tag == b.tag && a.a0 == b.a0 && a.a1 == b.a1 && a.a2 == b.a2 && a.a3 == b.a3,
                "event fields");
        require(std::memcmp(a.s0, b.s0, sizeof(a.s0)) == 0, "event string");
    }
    require(trace.abi_fail == expected.abi_fail, "abi preservation");
    require(trace.exception[0] == expected.exception[0] &&
            trace.exception[1] == expected.exception[1] &&
            trace.exception[2] == expected.exception[2], "exceptions");
    require(std::memcmp(trace.final_arena, expected.final_arena, sizeof(trace.final_arena)) == 0,
            "final arena");
    require(std::memcmp(trace.final_records_656528, expected.final_records_656528, 0x300u) == 0,
            "final 00656528 table");
    require(std::memcmp(trace.final_records_6564a0, expected.final_records_6564a0, 0x80u) == 0,
            "final 006564a0 records");
    require(std::memcmp(trace.final_frame_records, expected.final_frame_records, 146u * 4u) == 0,
            "final 00656180 records");
    require(trace.final_flag_656868[0] == expected.final_flag_656868[0] &&
            trace.final_flag_656868[1] == expected.final_flag_656868[1], "final 00656868 bytes");
    require(std::memcmp(trace.final_words_5d1740, expected.final_words_5d1740, 20u) == 0,
            "final 005d1740 words");
    require(trace.final_active_5d1734 == expected.final_active_5d1734, "final 005d1734");
    require(trace.final_5e99f4 == expected.final_5e99f4, "final 005e99f4");
    require(trace.final_track_ptr == expected.final_track_ptr, "final 0065b318");
    require(std::memcmp(trace.final_object_table, expected.final_object_table, 16u * 4u) == 0,
            "final 005e8b34");
    require(std::memcmp(trace.final_setup_table, expected.final_setup_table, 0x96u * 8u * 4u) == 0,
            "final 005e75a0");
    for (U i = 0u; i < 8u; ++i) {
        require(std::memcmp(trace.final_objects[i], expected.final_objects[i], 0x1000u) == 0,
                "final object bytes");
        require(std::memcmp(trace.final_descriptors[i], expected.final_descriptors[i], 0x600u) == 0,
                "final descriptor bytes");
    }
    require(std::memcmp(trace.final_track, expected.final_track, 256u) == 0, "final track strings");
}

// Per-record init for the 00656528 table; untouched records default to
// channel=-1, handle=-1, data=0.
struct UnloadRecord {
    I channel;
    I handle;
    U data;
};

struct UnloadCfg {
    U gate_657c94;
    U active_5d1734;
    I word_5d1750;
    U mode_657a24;
    I count_658080;
    U arena_records[4][2]; // [i] = {object, mode} for the 0065808c records
    U arena_record_count;
    U state_5e99f4;
    U word_657cb8;
    U word_657cbc;
    U byte_656868;
    UnloadRecord table[32];
    U frame_pairs[73][2];
    U stop_ret;
    U free_ret;
    U pump_ret;
    U clock_seq[8];
    U clock_len;
    I a8570_seq[8];
    U a8570_len;
    I b04d0_seq[8];
    U b04d0_len;
    U a8570_decrements_count;
    U ae470_writes;
};

static void setup_unload(const UnloadCfg& s) {
    reset_common();
    put(porsche::application_state_006573e8.words().data(), (0x00657c94u - kArenaBase), s.gate_657c94);
    put(porsche::application_state_006573e8.words().data(), (0x00657a24u - kArenaBase), s.mode_657a24);
    put(porsche::application_state_006573e8.words().data(), (0x00658080u - kArenaBase), static_cast<U>(s.count_658080));
    put(porsche::application_state_006573e8.words().data(), (0x00657cb8u - kArenaBase), s.word_657cb8);
    put(porsche::application_state_006573e8.words().data(), (0x00657cbcu - kArenaBase), s.word_657cbc);
    B* arena = porsche::application_state_006573e8.bytes();
    for (U i = 0u; i < s.arena_record_count && i < 4u; ++i) {
        put(arena, 0xca4u + i * 0x580u, s.arena_records[i][0]);
        put(arena, 0xca4u + i * 0x580u + 8u, s.arena_records[i][1]);
    }
    porsche::frame_services_words_005d1740[4] = static_cast<U>(s.word_5d1750);
    porsche::application_audio_active_005d1734 = s.active_5d1734;
    porsche::global_005e99f4 = s.state_5e99f4;
    porsche::frame_services_byte_00656868 = static_cast<B>(s.byte_656868 != 0u ? 1u : 0u);
    porsche::frame_services_byte_00656869 = static_cast<B>(s.byte_656868 != 0u ? 1u : 0u);
    for (U i = 0u; i < 32u; ++i) {
        porsche::application_audio_records_00656528[i].channel_04 = s.table[i].channel;
        porsche::application_audio_records_00656528[i].handle_08 = s.table[i].handle;
        porsche::application_audio_records_00656528[i].data_14 = s.table[i].data;
    }
    for (U i = 0u; i < 73u; ++i) {
        porsche::frame_services_records_00656180[i * 2u] = s.frame_pairs[i][0];
        porsche::frame_services_records_00656180[i * 2u + 1u] = s.frame_pairs[i][1];
    }
    cfg = ScenarioCfg{};
    cfg.stop_ret = s.stop_ret;
    cfg.free_ret = s.free_ret;
    cfg.pump_ret = s.pump_ret;
    cfg.a8570_decrements_count = s.a8570_decrements_count;
    cfg.ae470_writes = s.ae470_writes;
    cfg.clock_len = s.clock_len;
    for (U i = 0u; i < s.clock_len && i < 8u; ++i) cfg.clock_seq[i] = s.clock_seq[i];
    cfg.a8570_len = s.a8570_len;
    for (U i = 0u; i < s.a8570_len && i < 8u; ++i) cfg.a8570_seq[i] = s.a8570_seq[i];
    cfg.b04d0_len = s.b04d0_len;
    for (U i = 0u; i < s.b04d0_len && i < 8u; ++i) cfg.b04d0_seq[i] = s.b04d0_seq[i];
}

static void run_unload_pair(const UnloadCfg& s) {
    ++cases;

    cpp_side = false;
    std::memset(&trace, 0, sizeof(trace));
    setup_unload(s);
    __try {
        trace.abi_fail = invoke_cdecl0(slot_4a88a0);
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_trace();
    expected = trace;

    cpp_side = true;
    std::memset(&trace, 0, sizeof(trace));
    setup_unload(s);
    __try {
        trace.abi_fail = invoke_cdecl0(
            reinterpret_cast<void*>(&porsche::application_main_function_004a88a0));
    } __except (exception_record(GetExceptionInformation())) {
    }
    capture_trace();
    compare_traces();
}

static UnloadCfg unload_base() {
    UnloadCfg s{};
    s.gate_657c94 = 0u;
    s.active_5d1734 = 0u;
    s.word_5d1750 = 0x7f;
    s.mode_657a24 = 0u;
    s.count_658080 = 0;
    s.arena_record_count = 0u;
    s.state_5e99f4 = 3u;
    s.word_657cb8 = 0x1234u;
    s.word_657cbc = 0x5678u;
    s.byte_656868 = 0u;
    for (U i = 0u; i < 32u; ++i) {
        s.table[i].channel = -1;
        s.table[i].handle = -1;
        s.table[i].data = 0u;
    }
    for (U i = 0u; i < 73u; ++i) {
        s.frame_pairs[i][0] = 0xffffffffu;
        s.frame_pairs[i][1] = 0xffffffffu;
    }
    s.stop_ret = 7u;
    s.free_ret = 9u;
    s.pump_ret = 3u;
    s.clock_len = 1u;
    s.clock_seq[0] = 100u;
    s.a8570_len = 1u;
    s.a8570_seq[0] = 22;
    s.b04d0_len = 1u;
    s.b04d0_seq[0] = 33;
    return s;
}

