    static_assert(sizeof body_0056baf0 == 491u, "0056baf0 size");
    static_assert(sizeof body_0056bd70 == 193u, "0056bd70 size");
    static_assert(sizeof body_0056be40 == 435u, "0056be40 size");
    static_assert(sizeof body_0056c000 == 60u, "0056c000 size");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");
    std::memset(code, 0xcc, 4096u);

    orig_56baf0 = code + 0x000u;
    orig_56bd70 = code + 0x200u;
    orig_56be40 = code + 0x300u;
    orig_56c000 = code + 0x500u;

    std::memcpy(orig_56baf0, body_0056baf0, sizeof body_0056baf0);
    std::memcpy(orig_56bd70, body_0056bd70, sizeof body_0056bd70);
    std::memcpy(orig_56be40, body_0056be40, sizeof body_0056be40);
    std::memcpy(orig_56c000, body_0056c000, sizeof body_0056c000);

    auto reloc_rel = [&](B* fn, U off, U expected_disp, const void* target) {
        require(rd(fn, off) == expected_disp, "rel disp");
        wr(fn, off, address(target) - (address(fn) + off + 4u));
    };
    auto reloc_abs = [&](B* fn, U off, U expected_va, const void* target) {
        require(rd(fn, off) == expected_va, "abs va");
        wr(fn, off, address(target));
    };

    // 0056baf0 relocations
    reloc_rel(orig_56baf0, 0x039u, 0xfffc6783u, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56baf0, 0x061u, 0x0000018bu, reinterpret_cast<const void*>(&porsche::audio_stream_ring_contains_0056bce0));
    reloc_rel(orig_56baf0, 0x06fu, 0x000001adu, reinterpret_cast<const void*>(&porsche::audio_stream_request_unlink_0056bd10));
    reloc_rel(orig_56baf0, 0x085u, 0xfffc6747u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56baf0, 0x16fu, 0x0000010du, orig_56bd70);
    reloc_rel(orig_56baf0, 0x1a2u, 0xffffce7au, reinterpret_cast<const void*>(&porsche::request_read_00568b10));
    reloc_abs(orig_56baf0, 0x1b4u, 0x005bdc70u, porsche::stream_err_unable_to_read_005bdc70);
    reloc_abs(orig_56baf0, 0x1bau, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56baf0, 0x1beu, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56baf0, 0x1c4u, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56baf0, 0x1ceu, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_abs(orig_56baf0, 0x1dau, 0x0056bd70u, orig_56bd70);
    reloc_rel(orig_56baf0, 0x1e0u, 0xffffc3ecu, reinterpret_cast<const void*>(&porsche::operation_callback_005680c0));

    // 0056bd70 relocations
    reloc_rel(orig_56bd70, 0x035u, 0xffffc047u, reinterpret_cast<const void*>(&porsche::operation_complete_00567df0));
    reloc_rel(orig_56bd70, 0x061u, 0x0000006bu, orig_56be40);
    reloc_rel(orig_56bd70, 0x076u, 0xfffffa76u, reinterpret_cast<const void*>(&porsche::audio_stream_codec_advance_0056b860));
    reloc_rel(orig_56bd70, 0x08fu, 0xfffffcedu, orig_56baf0);
    reloc_rel(orig_56bd70, 0x09fu, 0xfffc649du, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56bd70, 0x0acu, 0xfffc64a0u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56bd70, 0x0b6u, 0xfffffa36u, reinterpret_cast<const void*>(&porsche::audio_stream_codec_advance_0056b860));

    // 0056be40 relocations
