                    0x60010001u, 1u, 0x10u, 0x20u, thresh34, flag38, queued3c,
                    ring_start,
                    static_cast<U>(static_cast<I>(ring_start) + write44_off),
                    static_cast<U>(static_cast<I>(ring_start) + write48_off),
                    static_cast<U>(filters.size()), 2u, 0x99990001u, 0u, 0u, 0u);
