// 4. 0056baf0 tests
static void run_refill(
    U read40_off, U write44_off, U write48_off, U ring_end_off,
    U active_idx, std::initializer_list<ReqSpec> reqs,
    std::initializer_list<ChunkSpec> chunks,
    U req_read_ret, U src_pos164,
    std::initializer_list<ChunkSpec> mem_src_chunks,
    U fill_pattern = 0u) {
    const U codec_va = address(arena);
    const U filter_va = codec_va + 0x200u;
    const U tap_va = codec_va + 0x280u;
    const U req_base = codec_va + 0x400u;
    const U ring_start = codec_va + 0x1000u;
    const U ring_end = codec_va + ring_end_off;

    active_stream_va = codec_va;
    active_tap_va = tap_va;
    enter_mutates_lock = 0u;
    mock_op_complete_bytes = 0x2000u;
    mock_request_read_ret = req_read_ret;
    mock_request_read_fill = fill_pattern;
    mock_request_read_fill_byte = 0x5au;

    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        setup_codec(codec_va, filter_va, tap_va, req_base, ring_start, ring_end,
                    0x60010003u, 1u, 0x33u, 0x44u, 100u, 1u, 0u,
                    ring_start + read40_off,
                    ring_start + write44_off,
                    ring_start + write48_off,
                    1u, 1u, 0x88880001u, src_pos164, 0u, 0u);
        wr_va(tap_va + 0x00u, codec_va);
        wr_va(tap_va + 0x04u, 1u);
        wr_va(tap_va + 0x08u, 0u);
        wr_va(tap_va + 0x0cu, 0u);
        setup_filters(filter_va, {{0xffff0000u, 0x12340000u, 1}});
        setup_requests(codec_va, req_base, ring_start, active_idx, reqs);
        for (const auto& c : chunks) {
            wr_va(ring_start + c.off + 0x00u, c.word0);
            wr_va(ring_start + c.off + 0x04u, c.word4);
        }
        for (const auto& c : mem_src_chunks) {
            wr_va(address(arena) + c.off + 0x00u, c.word0);
            wr_va(address(arena) + c.off + 0x04u, c.word4);
        }

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_refill_0056baf0)
                        : reinterpret_cast<void*>(orig_56baf0);
        trace.abi_fail = invoke_2(fn, codec_va, 0x77u);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces(false);
}

int main() {
    SetUnhandledExceptionFilter(fault_handler);

    // Check initial production state before any fixture writes.
    require(porsche::shared_runtime_word_005deb74 == 0u, "initial_005deb74");
    require(porsche::shared_runtime_word_005deb78 == 0u, "initial_005deb78");

    // Check exact .rdata bytes against raw PE before relocation.
    require(sizeof porsche::stream_err_unable_to_read_005bdc70 == sizeof raw_str_005bdc70 &&
            std::memcmp(porsche::stream_err_unable_to_read_005bdc70, raw_str_005bdc70, sizeof raw_str_005bdc70) == 0,
            "rdata_005bdc70");
    require(sizeof porsche::stream_err_invalid_chunk_005bdc98 == sizeof raw_str_005bdc98 &&
            std::memcmp(porsche::stream_err_invalid_chunk_005bdc98, raw_str_005bdc98, sizeof raw_str_005bdc98) == 0,
            "rdata_005bdc98");
    require(sizeof porsche::stream_err_abort_tap_005bdcdc == sizeof raw_str_005bdcdc &&
            std::memcmp(porsche::stream_err_abort_tap_005bdcdc, raw_str_005bdcdc, sizeof raw_str_005bdcdc) == 0,
            "rdata_005bdcdc");
    require(sizeof porsche::stream_source_file_005bd978 == sizeof raw_str_005bd978 &&
            std::memcmp(porsche::stream_source_file_005bd978, raw_str_005bd978, sizeof raw_str_005bd978) == 0,
            "rdata_005bd978");

    init_original_code();

    // 1. 0056c000: match_tap (0 filters, negative count, first match, masked later match, miss)
    run_match_tap(0u, {{0xffffffffu, 0x11223344u, 1}}, 0x11223344u);
    run_match_tap(0xffffffffu, {{0xffffffffu, 0x11223344u, 1}}, 0x11223344u);
    run_match_tap(3u, {{0xffff0000u, 0x11110000u, 1}, {0x00ff00ffu, 0x00220044u, 2}, {0xffffffffu, 0xdeadbeefu, -1}}, 0xaa22bb44u);
    run_match_tap(2u, {{0xffff0000u, 0x11110000u, 1}, {0x00ff00ffu, 0x00220044u, 2}}, 0x99999999u);

    // 2. 0056be40: process_ring
    // < 8 bytes and negative signed difference
    run_process_ring(0, 7, 2u, 0xfeedfaceu, 64u, 1u, 0u, {{0xffff0000u, 0x12340000u, 1}}, {});
    run_process_ring(32, 28, 2u, 0xfeedfaceu, 64u, 1u, 0u, {{0xffff0000u, 0x12340000u, 1}}, {});
    // Invalid chunk size high byte non-zero (formats 8 bytes in %02x diagnostic)
    run_process_ring(0, 16, 2u, 0xfeedfaceu, 64u, 1u, 0u, {{0xffff0000u, 0x12340000u, 1}},
                     {{0u, 0xaabbccddu, 0x01000010u}});
    // Chunk size extends past write_limit
    run_process_ring(0, 16, 2u, 0xfeedfaceu, 64u, 1u, 0u, {{0xffff0000u, 0x12340000u, 1}},
                     {{0u, 0x12345678u, 20u}});
    // Abort tap (-2) and non-abort negative tap (-1), with normal status=2 and lock mutation
    run_process_ring(0, 48, 2u, 0xfeedfaceu, 64u, 1u, 0u,
                     {{0xffff0000u, 0x11110000u, -1}, {0xffff0000u, 0x22220000u, 1}},
                     {{0u, 0x33330001u, 16u}, {16u, 0x11110002u, 16u}, {32u, 0x22220003u, 16u}},
                     0u, 0u, 1u, 0x70070001u);
    // Abort tap (-2) when req->status == 4 (skip mark & advance)
    run_process_ring(0, 16, 4u, 0xfeedfaceu, 64u, 1u, 0u,
                     {{0xffff0000u, 0x22220000u, 1}},
                     {{0u, 0x33330001u, 16u}});
    // Matched tap >= 1 when req->status == 4 (writes tag bits, skips tap/queued update, returns 0)
    run_process_ring(0, 16, 4u, 0xfeedfaceu, 64u, 1u, 0u,
                     {{0xffff0000u, 0x12340000u, 2}},
                     {{0u, 0x12345678u, 16u}});
    // Matched tap 1 & 2, threshold cross (queued < thresh -> queued >= thresh clears flag38=0), tap0_bytes != 0 keeps tap+0xc
    run_process_ring(0, 32, 2u, 0xfeedfaceu, 40u, 1u, 20u,
                     {{0xffff0000u, 0x11110000u, 1}, {0xffff0000u, 0x22220000u, 2}},
                     {{0u, 0x11110001u, 16u}, {16u, 0x22220002u, 16u}},
                     8u, 0x80u, 1u, 0x70070002u);
    // Threshold already satisfied (old_queued >= thresh) -> preserves flag38=1
    run_process_ring(0, 16, 2u, 0xfeedfaceu, 40u, 1u, 40u,
                     {{0xffff0000u, 0x11110000u, 1}},
                     {{0u, 0x11110001u, 16u}});
    // Sentinel match stops loop immediately and returns 1
    run_process_ring(0, 32, 2u, 0x11119999u, 64u, 1u, 0u,
                     {{0xffff0000u, 0x11110000u, 1}},
                     {{0u, 0x11119999u, 16u}, {16u, 0x11110002u, 16u}});

    // 3. 0056bd70: read_done
    // Memory-backed: exact EOF (pos164 + bytes16c == len11c) -> status=3, advance
    run_read_done(1u, 2u, 100u, 116u, 16u, 0u, 0xfeedfaceu, 0u, 0u, 0u, 0x6000u,
                  {{0u, 0x12340001u, 16u}});
    // Memory-backed: not EOF, no sentinel -> calls refill, which sees avail < 0x2000 -> state28=2
    run_read_done(1u, 2u, 0u, 1000u, 16u, 0u, 0xfeedfaceu, 0u, 0u, 0u, 0x1800u,
                  {{0u, 0x12340001u, 16u}});
    // File-backed: short read (mock_bytes < expected16c) -> status=3, advance
    run_read_done(0u, 2u, 0u, 10000u, 0x2000u, 16u, 0xfeedfaceu, 0u, 0u, 0u, 0x6000u,
                  {{0u, 0x12340001u, 16u}});
    // File-backed: full read, sentinel found -> status=3, advance
    run_read_done(0u, 2u, 0u, 20000u, 32u, 32u, 0x12349999u, 0u, 0u, 0u, 0x6000u,
                  {{0u, 0x12349999u, 16u}, {16u, 0x12340001u, 16u}});
    // File-backed: status == 4 -> skips status=3 write & lock, calls advance directly
    run_read_done(0u, 4u, 0u, 20000u, 32u, 32u, 0xfeedfaceu, 0u, 0u, 0u, 0x6000u,
                  {{0u, 0x12340001u, 16u}});
    // File-backed: full read, no sentinel, status != 4 -> calls refill -> request_read fails (op_id=0 -> diagnostic)
    run_read_done(0u, 2u, 0u, 20000u, 16u, 16u, 0xfeedfaceu, 0u, 0u, 0u, 0x6000u,
                  {{0u, 0x12340001u, 16u}});

    // 4. 0056baf0: refill
    // Cleanup loop: 0xfffffffe skip + 0xffffffff wrap + unlink finished head requests, then read40 > write48 with avail < 0x2000 -> state28=2
    run_refill(0x3000u, 0x1000u, 0x1000u, 0x6000u, 1u,
               {{1u, 3u, 0u, 0u, 0x1000u, 0xfeedfaceu, 0x0000u},
                {2u, 2u, 0u, 0u, 0x1000u, 0xfeedfaceu, 0x0000u}},
               {{0x3000u, 0xfffffffeu, 16u},
                {0x3010u, 0xffffffffu, 8u},
                {0x0000u, 0x12340001u, 16u}},
               0u, 0u, {});
    // read40 <= write48, space at end < 0x2000, head_space == tail_bytes (< tail_bytes + 1) -> state28=2 without wrap
    run_refill(0x0008u, 0x4500u, 0x4508u, 0x6000u, 0u,
               {{1u, 2u, 0u, 0u, 0x1000u, 0xfeedfaceu, 0u}},
               {{0x0008u, 0x12340001u, 16u}, {0x4500u, 0xaabbccddu, 16u}},
               0u, 0u, {});
    // Wrap copy succeeds (head_space >= tail_bytes + 1), post-wrap avail == 0x1fff < 0x2000 -> state28=2
    run_refill(0x2008u, 0x4500u, 0x4508u, 0x6000u, 0u,
               {{1u, 2u, 0u, 0u, 0x1000u, 0xfeedfaceu, 0u}},
               {{0x2008u, 0x12340001u, 16u}, {0x4500u, 0xaabbccddu, 16u}},
               0u, 0u, {});
    // Wrap copy succeeds and post-wrap avail == exactly 0x2000 -> initiates file read (op_id = 0x5555) + operation_callback
    run_refill(0x2009u, 0x4500u, 0x4508u, 0x6000u, 0u,
               {{1u, 2u, 0u, 0u, 0x1000u, 0xfeedfaceu, 0u}},
               {{0x2009u, 0x12340001u, 16u}, {0x4500u, 0xaabbccddu, 0x00000010u}},
               0x5555u, 0x40u, {}, 1u);
    // File-backed request_read failure (returns 0) -> reports 0x321 diagnostic
    run_refill(0x0000u, 0x0000u, 0x0000u, 0x6000u, 0u,
               {{1u, 2u, 0u, 0u, 0x1000u, 0xfeedfaceu, 0u}},
               {}, 0u, 0x80u, {}, 0u);
    // Memory-backed refill with clamping (pos164=0x10 + avail > len11c=0x30) -> copies remaining 0x20, read_done sets status=3, advance
    run_refill(0x0000u, 0x0000u, 0x0000u, 0x4000u, 0u,
               {{1u, 2u, 1u, 0x6800u, 0x0030u, 0x12349999u, 0u}},
               {}, 0u, 0x10u,
               {{0x6800u, 0x12340001u, 16u}, {0x6810u, 0x12349999u, 16u}});
    // Memory-backed refill without clamping (pos164 + avail <= req_len) -> copies avail, read_done -> process_ring -> refill stops with state28=2
    run_refill(0x0000u, 0x0000u, 0x0000u, 0x2100u, 0u,
               {{1u, 2u, 1u, 0x5000u, 0x4000u, 0xfeedfaceu, 0u}},
               {}, 0u, 0u,
               {{0x5000u, 0x12340001u, 16u}, {0x5010u, 0x12340002u, 16u}});

    std::printf("audio_stream_codec_refill_original_x86_vs_cpp=PASS cases=%u events=%u\n", cases, events_total);
    return 0;
}
