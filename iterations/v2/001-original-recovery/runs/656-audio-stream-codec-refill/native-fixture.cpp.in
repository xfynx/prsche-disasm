    U buf_off;
};

static void setup_codec(
    U codec_va, U filter_va, U tap_va, U req_base, U ring_start, U ring_end,
    U lock_val, U state28, U val2c, U val30, U thresh34, U flag38, U queued3c,
    U read40, U write44, U write48, U num_filters, U num_taps,
    U file_handle160, U pos164, U op_id168, U req_bytes16c) {
    wr_va(codec_va + 0x00u, 0x4d525453u);
    wr_va(codec_va + 0x04u, lock_val);
    wr_va(codec_va + 0x08u, req_base);
    wr_va(codec_va + 0x0cu, 8u);
    wr_va(codec_va + 0x10u, filter_va);
    wr_va(codec_va + 0x14u, num_filters);
    wr_va(codec_va + 0x18u, tap_va);
    wr_va(codec_va + 0x1cu, num_taps);
    wr_va(codec_va + 0x20u, ring_start);
    wr_va(codec_va + 0x24u, ring_end);
    wr_va(codec_va + 0x28u, state28);
    wr_va(codec_va + 0x2cu, val2c);
    wr_va(codec_va + 0x30u, val30);
    wr_va(codec_va + 0x34u, thresh34);
    wr_va(codec_va + 0x38u, flag38);
    wr_va(codec_va + 0x3cu, queued3c);
    wr_va(codec_va + 0x40u, read40);
    wr_va(codec_va + 0x44u, write44);
    wr_va(codec_va + 0x48u, write48);
    wr_va(codec_va + 0x4cu, 0u);
    wr_va(codec_va + 0x50u, 0u);
    wr_va(codec_va + 0x54u, 0u);
    wr_va(codec_va + 0x58u, 0u);
    wr_va(codec_va + 0x160u, file_handle160);
    wr_va(codec_va + 0x164u, pos164);
    wr_va(codec_va + 0x168u, op_id168);
    wr_va(codec_va + 0x16cu, req_bytes16c);
}

static void setup_filters(U filter_va, std::initializer_list<FilterSpec> specs) {
    U idx = 0u;
    for (const auto& s : specs) {
        const U p = filter_va + idx * 0x0cu;
        wr_va(p + 0x00u, s.mask);
        wr_va(p + 0x04u, s.value);
        wr_va(p + 0x08u, static_cast<U>(s.tap_idx));
        ++idx;
    }
}

static void setup_requests(
    U codec_va, U req_base, U ring_start, U active_idx,
    std::initializer_list<ReqSpec> specs) {
    const U count = static_cast<U>(specs.size());
    U idx = 0u;
    for (const auto& r : specs) {
        const U p = req_base + idx * 0x128u;
        wr_va(p + 0x00u, r.id);
        wr_va(p + 0x04u, r.status);
        wr_va(p + 0x08u, (idx > 0u) ? (req_base + (idx - 1u) * 0x128u) : 0u);
        wr_va(p + 0x0cu, (idx + 1u < count) ? (req_base + (idx + 1u) * 0x128u) : 0u);
        wr_va(p + 0x10u, r.type10);
        wr_va(p + 0x118u, (r.src_off != 0u) ? (address(arena) + r.src_off) : 0u);
        wr_va(p + 0x11cu, r.len11c);
        wr_va(p + 0x120u, r.sentinel120);
        wr_va(p + 0x124u, ring_start + r.buf_off);
        ++idx;
    }
    if (count > 0u) {
        wr_va(codec_va + 0x4cu, req_base);
        wr_va(codec_va + 0x50u, req_base + active_idx * 0x128u);
        wr_va(codec_va + 0x54u, req_base + (count - 1u) * 0x128u);
    }
}

// 1. 0056c000 tests
static void run_match_tap(U num_filters_raw, std::initializer_list<FilterSpec> filters, U tag_word) {
    active_stream_va = 0u;
    active_tap_va = 0u;
    enter_mutates_lock = 0u;
    const U codec_va = address(arena);
    const U filter_va = codec_va + 0x200u;
    const U hdr_va = codec_va + 0x300u;

    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        setup_codec(codec_va, filter_va, codec_va + 0x280u, codec_va + 0x400u,
                    codec_va + 0x1000u, codec_va + 0x6000u,
                    0x50000001u, 1u, 0x10u, 0x20u, 100u, 0u, 0u,
                    codec_va + 0x1000u, codec_va + 0x1000u, codec_va + 0x1000u,
                    num_filters_raw, 2u, 0u, 0u, 0u, 0u);
        setup_filters(filter_va, filters);
        wr_va(hdr_va, tag_word);

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_match_tap_0056c000)
                        : reinterpret_cast<void*>(orig_56c000);
        trace.abi_fail = invoke_2(fn, codec_va, hdr_va);
        trace.ret = captured_return;
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces(true);
}

// 2. 0056be40 tests
static void run_process_ring(
    I write44_off, I write48_off, U req_status, U sentinel,
    U thresh34, U flag38, U queued3c,
    std::initializer_list<FilterSpec> filters,
    std::initializer_list<ChunkSpec> chunks,
    U tap0_bytes = 0u, U tap0_cur_off = 0u,
