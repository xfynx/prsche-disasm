static bool check(const char* family,U validate=0){
 setup();execute(false,validate);expected=trace;original_world=work;U executed=mask,ds=decodes,rm=removes,cb=subscribers,cm=coms;execute(true,validate);
 bool bad=trace.abi||expected.abi||memcmp(&trace,&expected,sizeof trace)||memcmp(&work,&original_world,sizeof work);
 if(bad){printf("divergence family=%s case=%u mode=%u events=%u/%u ABI=%x/%x decodes=%u/%u callbacks=%u/%u\n",family,cases,mode,trace.count,expected.count,trace.abi,expected.abi,decodes,ds,subscribers,cb);const B* a=reinterpret_cast<const B*>(&trace);const B* b=reinterpret_cast<const B*>(&expected);for(U i=0;i<sizeof trace;++i)if(a[i]!=b[i]){printf("trace_byte=%x got=%02x want=%02x event=%u\n",i,a[i],b[i],i>12?(i-12)/sizeof(Event):0);break;}return false;}
 printf("case=%u family=%s mode=%u original_subset=%03x decode=%u remove=%u subscriber=%u com=%u scenes=%u\n",cases,family,mode,executed,ds,rm,cb,cm,trace.count);++cases;scenes+=trace.count;return true;
}
int main(int argc,char** argv){
 if(argc!=2||!rawdata(argv[1])||!init()){puts("divergence original-raw-data-or-patches");return 1;}
 base();if(!check("validate-valid",1))return 1;base();if(!check("validate-negative",2))return 1;
 base();outer_count=0;if(!check("outer-zero"))return 1;base();outer_count=0x80000000;if(!check("outer-signed-negative"))return 1;
 base();if(!check("outer-full"))return 1;
 for(U m=1;m<=11;++m){base();mode=m;if(!check("observer-change"))return 1;}
 base();kind=4;prefix=1;continuation=1;if(!check("kind4-prefix8-multiFE"))return 1;
 base();continuation=1;record_count=4;outer_count=1;if(!check("bounded-four-multiFE"))return 1;
 base();record_count=0;if(!check("no-token14"))return 1;
 for(U c:{0u,0x80u,0xffu}){base();subscriber_count=c;if(!check("signed-subscribers"))return 1;}
 base();device_on=0;if(!check("no-device"))return 1;base();zero_handle=1;if(!check("zero-handle"))return 1;
 base();missing_map=1;if(!check("null-map"))return 1;base();missing_key=1;if(!check("missing-key"))return 1;
 base();clear_flag=0;if(!check("retain-relative-slot"))return 1;base();missing_item=1;outer_count=3;if(!check("missing-middle-item"))return 1;
 base();seed=0xdeadbeef;if(!check("opaque-seed"))return 1;
 base();first_large=1;seed=0xdeadbeef;continuation=1;outer_count=1;if(!check("opaque-first-large-multiFE"))return 1;
 direct_mode=true;
 base();if(!check("direct-frozen-TUs"))return 1;
 base();kind=4;prefix=1;continuation=1;record_count=4;outer_count=1;if(!check("direct-multiFE"))return 1;
 base();device_on=0;subscriber_count=0;if(!check("direct-no-observers"))return 1;
 printf("audio_group_composition_original_x86_vs_cpp=PASS cases=%u intermediate_scenes=%u full_record_map_slot_scratch=PASS original_raw_data=PASS\n",cases,scenes);return 0;
}
