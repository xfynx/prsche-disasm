static void run_abort_scenario(
    U num_taps,
    U tap0_id, U tap0_rem, U tap0_cur_off,
    U tap1_id, U tap1_rem, U tap1_cur_off,
    U read40_off, U write44_off,
    U avail3c, U thresh34, U state28,
    std::initializer_list<ReqSpec> reqs,
    U head_idx, U active_idx, U tail_idx,
    U target_req_id,
    std::initializer_list<ChunkSpec> chunks) {
    const U stream_va = address(arena);
    const U tap_base = stream_va + 0x200u;
    const U ring_start = stream_va + 0x400u;
    const U ring_end = stream_va + 0x800u;
    const U req_base = stream_va + 0x900u; // 8 * 0x128 = 0x940 -> fits inside 8 KiB arena!
    active_stream_va = stream_va;
    active_tap_va = tap_base;
    enter_mutates_lock = 0u;
    destroy_wait_iters = 0u;

    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        setup_stream_base(stream_va, tap_base, req_base, ring_start, ring_end,
                          0x40010001u, state28, 0x96u, 0x32u, thresh34, 0u, avail3c,
                          ring_start + read40_off, ring_start + write44_off,
                          num_taps, 0x66660001u, 0x99u);
        wr_va(stream_va + 0x0cu, static_cast<U>(reqs.size()));

        U idx = 0u;
        const U nreq = static_cast<U>(reqs.size());
        for (const ReqSpec& r : reqs) {
            const U node = req_base + idx * 0x128u;
            wr_va(node + 0x00u, r.id);
            wr_va(node + 0x04u, r.status);
            wr_va(node + 0x08u, (idx > 0u) ? (req_base + (idx - 1u) * 0x128u) : 0u);
            wr_va(node + 0x0cu, (idx + 1u < nreq) ? (req_base + (idx + 1u) * 0x128u) : 0u);
            wr_va(node + 0x124u, ring_start + r.buf_off);
            ++idx;
        }
        if (nreq > 0u) {
            wr_va(stream_va + 0x4cu, req_base + head_idx * 0x128u);
            wr_va(stream_va + 0x50u, req_base + active_idx * 0x128u);
            wr_va(stream_va + 0x54u, req_base + tail_idx * 0x128u);
        }

        wr_va(tap_base + 0x00u, stream_va);
        if (num_taps > 0u) {
            wr_va(tap_base + 0x04u, tap0_id);
            wr_va(tap_base + 0x08u, tap0_rem);
            wr_va(tap_base + 0x0cu, ring_start + tap0_cur_off);
        }
        if (num_taps > 1u) {
            wr_va(tap_base + 0x10u, stream_va);
            wr_va(tap_base + 0x14u, tap1_id);
            wr_va(tap_base + 0x18u, tap1_rem);
            wr_va(tap_base + 0x1cu, ring_start + tap1_cur_off);
        }

        for (const ChunkSpec& c : chunks) {
            wr_va(ring_start + c.off + 0x00u, c.word0);
            wr_va(ring_start + c.off + 0x04u, c.word4);
        }

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_abort_node_0056c140)
                        : reinterpret_cast<void*>(orig_56c140);
        trace.abi_fail = invoke_2(fn, tap_base, target_req_id);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        trace.storage_hash = hash_storage();
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

