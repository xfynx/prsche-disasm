        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

static void run_release_chunk(
    U chunk_off_signed_mode, U chunk_word0, U chunk_word4,
    U state28, U val2c, U val30, U thresh34, U flag38, U avail3c,
    U mutate_lock = 0u, U next_lock = 0u) {
    const U stream_va = address(arena);
    const U tap_va = stream_va + 0x200u;
    const U ring_start = stream_va + 0x400u;
    const U ring_end = stream_va + 0x500u;
    active_stream_va = stream_va;
    active_tap_va = 0u;
    enter_mutates_lock = mutate_lock;
    new_lock_value = next_lock;
    destroy_wait_iters = 0u;

    U chunk_va = ring_start;
    if (chunk_off_signed_mode == 1u) {
        chunk_va = ring_start - 4u; // below ring_start
    } else if (chunk_off_signed_mode == 2u) {
        chunk_va = ring_end - 8u; // exact inclusive upper bound
    } else if (chunk_off_signed_mode == 3u) {
        chunk_va = ring_end - 7u; // 1 byte above upper bound
    }

    for (int side = 0; side < 2; ++side) {
        which = static_cast<U>(side);
        prepare_arena();
        setup_stream_base(stream_va, tap_va, stream_va + 0x800u, ring_start, ring_end,
                          0x20010001u, state28, val2c, val30, thresh34, flag38, avail3c,
                          ring_start, ring_start + 0x40u, 1u, 0x44440001u, 0x77u);
        wr_va(tap_va + 0x00u, stream_va);
        wr_va(tap_va + 0x04u, 1u);
        wr_va(chunk_va + 0x00u, chunk_word0);
        wr_va(chunk_va + 0x04u, chunk_word4);
        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_release_chunk_0056c620)
                        : reinterpret_cast<void*>(orig_56c620);
        trace.abi_fail = invoke_2(fn, tap_va, chunk_va);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        trace.storage_hash = hash_storage();
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

