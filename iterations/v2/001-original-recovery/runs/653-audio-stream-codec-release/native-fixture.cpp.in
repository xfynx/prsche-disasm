static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", why, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip, cases, which);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void capture_fp(FpuSnapshot& fp) {
    __asm fxsave fp_area
    __asm fnstenv fp_env
    __asm fldenv fp_env
    fp.control = static_cast<unsigned short>(rd(fp_area, 0u));
    fp.status = static_cast<unsigned short>(rd(fp_area, 2u));
    fp.tag = static_cast<unsigned short>(rd(fp_env, 8u));
    fp.pad = 0u;
    fp.mxcsr = rd(fp_area, 24u);
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(fp.values + i * 10u, fp_area + 32u + i * 16u, 10u);
        if ((fp_area[4u] & (1u << (((fp.status >> 11u) + i) & 7u))) == 0u) {
            std::memset(fp.values + i * 10u, 0, 10u);
        }
    }
}

static void copy_bounded(char* dst, U cap, const char* src) {
    std::memset(dst, 0, cap);
    if (src == nullptr) {
        return;
    }
    for (U i = 0u; i + 1u < cap && src[i] != '\0'; ++i) {
        dst[i] = src[i];
    }
}

static U hash_storage() {
    U h = 2166136261u;
    const auto* bytes = reinterpret_cast<const B*>(&porsche::audio_stream_service_storage_006b7740);
    for (U i = 0u; i < sizeof porsche::audio_stream_service_storage_006b7740; ++i) {
        h ^= bytes[i];
        h *= 16777619u;
    }
    return h;
}

static void __cdecl mock_diagnostic_fn(const char* fmt, ...) {
    require(trace.count < kMaxEvents, "event overflow");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof e);
    e.tag = kEvDiagnostic;
    e.file_word = porsche::shared_runtime_word_005deb74;
    e.line_word = porsche::shared_runtime_word_005deb78;
    copy_bounded(e.msg, sizeof e.msg, fmt);
}

