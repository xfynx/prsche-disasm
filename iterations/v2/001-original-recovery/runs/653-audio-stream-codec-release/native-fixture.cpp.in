int main() {
    SetUnhandledExceptionFilter(fault_handler);

    // Check initial production state before any fixture writes.
    require(porsche::shared_runtime_word_005deb74 == 0u, "initial_005deb74");
    require(porsche::shared_runtime_word_005deb78 == 0u, "initial_005deb78");
    {
        B zero_storage[sizeof porsche::audio_stream_service_storage_006b7740]{};
        require(std::memcmp(&porsche::audio_stream_service_storage_006b7740,
                            zero_storage, sizeof zero_storage) == 0,
                "initial_006b7740");
    }

    // Check exact .rdata bytes against raw PE before relocation.
    require(sizeof porsche::stream_err_destroy_invalid_handle_005bdaa0 == sizeof raw_str_005bdaa0 &&
            std::memcmp(porsche::stream_err_destroy_invalid_handle_005bdaa0, raw_str_005bdaa0, sizeof raw_str_005bdaa0) == 0,
            "rdata_005bdaa0");
    require(sizeof porsche::stream_err_cancelrequest_invalid_handle_005bdd30 == sizeof raw_str_005bdd30 &&
            std::memcmp(porsche::stream_err_cancelrequest_invalid_handle_005bdd30, raw_str_005bdd30, sizeof raw_str_005bdd30) == 0,
            "rdata_005bdd30");
    require(sizeof porsche::stream_err_kill_invalid_handle_005bdd60 == sizeof raw_str_005bdd60 &&
            std::memcmp(porsche::stream_err_kill_invalid_handle_005bdd60, raw_str_005bdd60, sizeof raw_str_005bdd60) == 0,
            "rdata_005bdd60");
    require(sizeof porsche::stream_err_release_wrong_stream_005bddac == sizeof raw_str_005bddac &&
            std::memcmp(porsche::stream_err_release_wrong_stream_005bddac, raw_str_005bddac, sizeof raw_str_005bddac) == 0,
            "rdata_005bddac");
    require(sizeof porsche::stream_err_release_already_released_005bdde8 == sizeof raw_str_005bdde8 &&
            std::memcmp(porsche::stream_err_release_already_released_005bdde8, raw_str_005bdde8, sizeof raw_str_005bdde8) == 0,
            "rdata_005bdde8");
    require(sizeof porsche::stream_err_release_invalid_handle_005bde1c == sizeof raw_str_005bde1c &&
            std::memcmp(porsche::stream_err_release_invalid_handle_005bde1c, raw_str_005bde1c, sizeof raw_str_005bde1c) == 0,
            "rdata_005bde1c");
    require(sizeof porsche::stream_source_file_005bd978 == sizeof raw_str_005bd978 &&
            std::memcmp(porsche::stream_source_file_005bd978, raw_str_005bd978, sizeof raw_str_005bd978) == 0,
            "rdata_005bd978");

    init_original_code();

    // 1. 0056c620: STREAM_release invalid handles, range checks, sentinel check, consume, and refill paths.
    run_release_invalid(0u, 0x4d525453u);
    run_release_invalid(1u, 0x00000000u);
    run_release_invalid(1u, 0x4d525452u);
    run_release_chunk(1u, 0x11111111u, 32u, 0u, 150u, 50u, 20u, 0u, 64u); // below ring_start
    run_release_chunk(3u, 0x11111111u, 32u, 0u, 150u, 50u, 20u, 0u, 64u); // above ring_end - 8
    run_release_chunk(2u, 0x11111111u, 8u, 0u, 150u, 50u, 20u, 0u, 64u);  // exact ring_end - 8 valid
    run_release_chunk(0u, 0xfffffffeu, 32u, 0u, 150u, 50u, 20u, 0u, 64u); // already released
    run_release_chunk(0u, 0x11111111u, 32u, 1u, 150u, 50u, 40u, 0u, 64u); // state28 == 1, threshold crossed
    run_release_chunk(0u, 0x22222222u, 24u, 2u, 150u, 50u, 10u, 0u, 64u); // state28 == 2, flag38 == 0 -> refill(val2c)
    run_release_chunk(0u, 0x33333333u, 24u, 2u, 150u, 50u, 10u, 1u, 64u); // state28 == 2, flag38 != 0 -> refill(val30)
    run_release_chunk(0u, 0x44444444u, 16u, 2u, 150u, 50u, 50u, 0u, 64u, 1u, 0x70070007u); // lock re-read + threshold

    // 2. 00566e10: service release indirection through chunk_data_va[-4] and audio_stream_service_storage_006b7740.
    run_service_release(0u, 0x00000000u, 32u, 0u);
    run_service_release(3u, 0xdead0003u, 24u, 2u);
    run_service_release(15u, 0x4455000fu, 16u, 1u);

    // 3. 0056c140: STREAM_cancelrequest invalid handles, status 1/4/lookup miss, Case A (walk/wrap/skip/empty), Case B (get+release).
    run_abort_invalid(0u, 0x4d525453u);
    run_abort_invalid(1u, 0x4d525452u);
    run_abort_scenario(1u, 1u, 32u, 0u, 0u, 0u, 0u, 0u, 32u, 32u, 10u, 1u,
                       {{0u, 3u, 0u}}, 0u, 0u, 0u, 99u, {}); // lookup miss
    run_abort_scenario(1u, 1u, 32u, 0u, 0u, 0u, 0u, 0u, 32u, 32u, 10u, 1u,
                       {{5u, 4u, 0u}}, 0u, 0u, 0u, 5u, {}); // status == 4 guard
    run_abort_scenario(1u, 1u, 32u, 0u, 0u, 0u, 0u, 0u, 32u, 32u, 10u, 1u,
                       {{5u, 1u, 0u}}, 0u, 0u, 0u, 5u, {}); // status == 1 -> unlink only
    run_abort_scenario(1u, 1u, 32u, 0u, 0u, 0u, 0u, 0u, 0u, 32u, 10u, 1u,
                       {{5u, 2u, 0u}}, 0u, 0u, 0u, 5u,
                       {{0u, 0x11111111u, (1u << 24u) | 16u}, {16u, 0xffffffffu, 0u}}); // Case A empty range (start==end)
    run_abort_scenario(2u,
                       1u, 48u, 16u,
                       2u, 32u, 16u,
                       0u, 32u, 80u, 40u, 1u,
                       {{0u, 3u, 0u}, {1u, 2u, 48u}, {2u, 1u, 112u}},
                       0u, 0u, 2u, 1u,
                       {
                           {48u, 0xaaaa1111u, (1u << 24u) | 16u},
                           {64u, 0xbbbb2222u, (2u << 24u) | 16u},
                           {80u, 0xffffffffu, 0u},
                           {0u, 0xcccc3333u, (1u << 24u) | 16u},
                           {16u, 0xdddd4444u, (9u << 24u) | 16u},
                       }); // next->status == 1 -> end_ptr=write44, Case A wrap + tag match/skip
    run_abort_scenario(1u, 1u, 64u, 64u, 0u, 0u, 0u,
                       0u, 128u, 64u, 20u, 1u,
                       {{0u, 3u, 0u}, {1u, 2u, 48u}, {2u, 3u, 96u}},
                       0u, 0u, 2u, 1u,
                       {
                           {64u, 0x11111111u, (1u << 24u) | 16u},
                           {80u, 0x22222222u, (1u << 24u) | 16u},
                           {96u, 0x33333333u, (1u << 24u) | 16u},
                       }); // Case B: tap_cur inside [start_ptr, end_ptr), calls get + release until outside [48, 96)
    run_abort_scenario(1u, 1u, 24u, 64u, 0u, 0u, 0u,
                       0u, 128u, 64u, 20u, 1u,
                       {{0u, 3u, 0u}, {1u, 2u, 48u}, {2u, 3u, 112u}},
                       0u, 0u, 2u, 1u,
                       {
                           {64u, 0x11111111u, (1u << 24u) | 24u},
                           {88u, 0x22222222u, (1u << 24u) | 16u},
                       }); // Case B: stops when tap_rem hits 0
    run_abort_scenario(0u, 0u, 0u, 0u, 0u, 0u, 0u,
                       0u, 32u, 32u, 10u, 1u,
                       {{0u, 2u, 0u}}, 0u, 0u, 0u, 0u, {}); // num_taps == 0

    // 4. 0056c420: STREAM_kill invalid handles, empty tail early return, abort loop, unlink loop, ring mark+wrap, state28 clear.
    run_reset_invalid(0u, 0x4d525453u);
    run_reset_invalid(1u, 0x4d525452u);
    run_reset_scenario(1u, 32u, 0u, 0u, 0u, 0u, 32u, 32u, 10u, 2u, {}, 0u, 0u, 0u, {}); // tail == 0 -> early return, keeps state28=2
    run_reset_scenario(2u, 32u, 0u, 16u, 48u, 48u, 32u, 64u, 20u, 2u,
                       {{0u, 3u, 0u}, {1u, 3u, 48u}, {2u, 2u, 64u}, {3u, 1u, 96u}},
                       0u, 1u, 3u,
                       {
                           {48u, 0x11111111u, (3u << 24u) | 16u},
                           {64u, 0xffffffffu, 0u},
                           {0u, 0x22222222u, (1u << 24u) | 32u},
                       }); // aborts status=1 then status=2, unlinks head!=active, marks ring + clears state28 2->0
    run_reset_scenario(1u, 16u, 0u, 0u, 0u, 0u, 0u, 16u, 5u, 1u,
                       {{0u, 3u, 0u}}, 0u, 0u, 0u, {}); // read==write, state28=1 preserved

    // 5. 0056b3b0: STREAM_destroy invalid handles, non-waiting teardown, waiting loop (thread=0 and thread=1).
    run_destroy_invalid(0u, 0x4d525453u);
    run_destroy_invalid(1u, 0x4d525452u);
    run_destroy_valid(0u, 0, 0u, 0u);  // state28==0, empty queue
    run_destroy_valid(2u, 0, 0u, 1u);  // state28==2 -> reset clears to 0 -> skips wait loop
    run_destroy_valid(1u, 0, 2u, 1u);  // state28==1, thread_ret==0 -> sleeps twice without pump
    run_destroy_valid(1u, 1, 2u, 1u);  // state28==1, thread_ret==1 -> pumps + sleeps twice

    std::printf("audio_stream_codec_release_original_x86_vs_cpp=PASS cases=%u events=%u\n", cases, events_total);
    return 0;
}
