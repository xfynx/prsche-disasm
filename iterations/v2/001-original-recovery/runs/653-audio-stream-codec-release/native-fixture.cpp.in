static void run_destroy_valid(U state28, I thread_ret, U wait_iters, U with_queue) {
    const U stream_va = address(arena);
    const U tap_base = stream_va + 0x200u;
    const U ring_start = stream_va + 0x400u;
    const U ring_end = stream_va + 0x800u;
