        wr_va(tap_base + 0x04u, 1u);
        wr_va(tap_base + 0x08u, 32u);
        wr_va(tap_base + 0x0cu, ring_start);
        if (with_queue != 0u) {
            wr_va(stream_va + 0x0cu, 1u);
            wr_va(req_base + 0x00u, 0u);
            wr_va(req_base + 0x04u, 3u);
            wr_va(req_base + 0x124u, ring_start);
            wr_va(stream_va + 0x4cu, req_base);
            wr_va(stream_va + 0x50u, req_base);
            wr_va(stream_va + 0x54u, req_base);
            wr_va(ring_start + 0x00u, 0x11111111u);
            wr_va(ring_start + 0x04u, (1u << 24u) | 32u);
        }

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_destroy_0056b3b0)
