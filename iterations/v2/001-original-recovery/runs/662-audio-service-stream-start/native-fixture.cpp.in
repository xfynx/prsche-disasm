struct StartCase {
    B active;
    bool lookup_found;
    I max_slots;
    I cur_slots;
    U chan_serial;
    U channel_tag;
    U stream_flags;
    U offset_or_size;
    U arg4;
    bool has_free_req;
};

static void run_stream_start(const StartCase& c) {
    const U codec_va = address(arena);
    const U req0_va = address(arena) + 0x400u;
    const U req1_va = address(arena) + 0x600u;
    const U handle_va = address(arena) + 0xa00u;
    const U path_va = address(arena) + 0xb00u;
    const U data_va = address(arena) + 0xd00u;
    const U chan_va = address(arena) + 0x1000u;
    const U entries_va = address(arena) + 0x1100u;

    for (U side = 0u; side < 2u; ++side) {
        which = side;
        prepare_arena();
        active_codec_va = 0u;
        enter_mutates_lock = 0u;
        porsche::application_audio_device_state_006b48c0[0xdc] = c.active;
        porsche::audio_stream_request_serial_006a5df0 = 0x7100u;

        setup_codec_for_queue(codec_va, handle_va, 0x4d525453u, c.has_free_req,
                              req0_va, req1_va, 0u, 0u, 0x120u, 0x240u, false);

        const char* pstr = "sfx/engine.asf";
        std::memcpy(arena + (path_va - address(arena)), pstr, std::strlen(pstr) + 1u);

        // Prepare 'SCEl' (0x6c454353) chunk chain for arg4 == 1
        wr_va(data_va + 0x00u, 0x52444853u);
        wr_va(data_va + 0x04u, 0x28u);
        wr_va(data_va + 0x28u, 0x6c454353u);
        wr_va(data_va + 0x2cu, 0x18u);

        wr_va(chan_va + 0x00u, entries_va);
        wr_va(chan_va + 0x04u, handle_va);
        wr_va(chan_va + 0x10u, c.chan_serial);
        wr_u8(chan_va + 0x15u, static_cast<B>(static_cast<std::int8_t>(c.max_slots)));
        wr_u8(chan_va + 0x16u, static_cast<B>(static_cast<std::int8_t>(c.cur_slots)));

        mock_lookup_ret = c.lookup_found ? chan_va : 0u;
        const U arg2 = (c.arg4 == 1u) ? data_va : path_va;

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_service_stream_start_00567550)
                        : reinterpret_cast<void*>(orig_567550);
        trace.abi_fail = invoke_5(fn, c.channel_tag, c.stream_flags, arg2, c.offset_or_size, c.arg4);
        trace.ret = captured_return;
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        trace.final_req_serial = porsche::audio_stream_request_serial_006a5df0;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0u) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

int main() {
    SetUnhandledExceptionFilter(fault_handler);

    // Check initial production state before any fixture writes.
    require(porsche::audio_stream_request_serial_006a5df0 == 0u, "initial_006a5df0");
    require(porsche::shared_runtime_word_005deb74 == 0u, "initial_005deb74");
    require(porsche::shared_runtime_word_005deb78 == 0u, "initial_005deb78");
    require(porsche::application_audio_device_state_006b48c0[0xdc] == 0u, "initial_006b499c");

    // Check exact .rdata bytes against raw PE before relocation.
    require(sizeof porsche::stream_err_queuefile_invalid_005bdbd0 == sizeof raw_str_005bdbd0 &&
            std::memcmp(porsche::stream_err_queuefile_invalid_005bdbd0, raw_str_005bdbd0, sizeof raw_str_005bdbd0) == 0,
            "rdata_005bdbd0");
    require(sizeof porsche::stream_err_queuemem_invalid_005bdd04 == sizeof raw_str_005bdd04 &&
            std::memcmp(porsche::stream_err_queuemem_invalid_005bdd04, raw_str_005bdd04, sizeof raw_str_005bdd04) == 0,
            "rdata_005bdd04");
    require(sizeof porsche::stream_source_file_005bd978 == sizeof raw_str_005bd978 &&
            std::memcmp(porsche::stream_source_file_005bd978, raw_str_005bd978, sizeof raw_str_005bd978) == 0,
            "rdata_005bd978");

    init_original_code();

    // 1. 0056b790: audio_stream_codec_alloc_request_0056b790
    run_alloc_request(false, 0x1000u, 0x12345678u, 0u);
    run_alloc_request(true, 0x00001200u, 0xdeadbe77u, 1u);
    run_alloc_request(true, 0xffffff00u, 0x99887742u, 0u);

    // 2. 0056b800: audio_stream_codec_enqueue_request_0056b800
    run_enqueue_request(false, 1u);
    run_enqueue_request(true, 1u);

    // 3. 0056b690: audio_stream_codec_queue_file_0056b690
    run_queue_file(0u, true, 0u, 0u, 0x10u, 0x20u, false, 10u, 0u, 0x80u, 0x6c454353u, 0u);
    run_queue_file(2u, true, 0u, 0u, 0x10u, 0x20u, false, 10u, 0u, 0x80u, 0x6c454353u, 0u);
    run_queue_file(1u, false, 0u, 0u, 0x10u, 0x20u, false, 10u, 0u, 0x80u, 0x6c454353u, 0u);
    run_queue_file(1u, true, 0u, 0u, 0x110u, 0x220u, false, 14u, 0u, 0x400u, 0x6c454353u, 0u);
    run_queue_file(1u, true, 0u, 1u, 0x110u, 0x220u, true, 0x110u, 1u, 0x800u, 0x54414731u, 0u);
    run_queue_file(1u, true, 2u, 0u, 0x110u, 0x220u, false, 0x102u, 3u, 0x1200u, 0x54414732u, 1u);

    // 4. 0056c040: audio_stream_codec_queue_memory_0056c040
    run_queue_memory(0u, true, 0u, 0x100u, 1u, 0x6c454353u, 0u);
    run_queue_memory(2u, true, 0u, 0x100u, 1u, 0x6c454353u, 0u);
    run_queue_memory(1u, false, 0u, 0x100u, 1u, 0x6c454353u, 0u);
    run_queue_memory(1u, true, 0u, 0x450u, 1u, 0x6c454353u, 0u);
    run_queue_memory(1u, true, 0u, 0u, 1u, 0x6c454353u, 0u);
    run_queue_memory(1u, true, 0u, 0u, 3u, 0x6c454353u, 0u);
    run_queue_memory(1u, true, 1u, 0u, 2u, 0x6c454353u, 1u);

    // 5. 00567550: audio_service_stream_start_00567550
    run_stream_start({0u, true, 4, 0, 0x100u, 0x05u, 1000u, 0x40u, 0u, true});
    run_stream_start({1u, false, 4, 0, 0x100u, 0x05u, 1000u, 0x40u, 0u, true});
    run_stream_start({1u, true, 4, 4, 0x100u, 0x05u, 1000u, 0x40u, 0u, true});
    run_stream_start({1u, true, -1, 2, 0x100u, 0x05u, 1000u, 0x40u, 0u, true});
    run_stream_start({1u, true, 4, -1, 0x100u, 0x05u, 1000u, 0x40u, 0u, false});
    run_stream_start({1u, true, 4, 0, 0x100u, 0x05u, 1000u, 0x40u, 0u, false});
    run_stream_start({1u, true, 4, 0, 0x100u, 0x05u, 1000u, 0x40u, 1u, false});
    run_stream_start({1u, true, 4, 0, 0x100u, 0x05u, 1000u, 0u, 2u, true});
    run_stream_start({1u, true, 4, 2, 0x00001200u, 0x07u, 0x8003u, 0x180u, 0u, true});
    run_stream_start({1u, true, 4, 1, 0x00002000u, 0x0au, 0x1234u, 0x999u, 1u, true});
    run_stream_start({1u, true, 6, 3, 0x7fffff00u, 0x0cu, 0xabcd1234u, 0x55aa1122u, 2u, true});

    std::printf("audio_service_stream_start_original_x86_vs_cpp=PASS cases=%u events=%u\n", cases, events_total);
    return 0;
}
