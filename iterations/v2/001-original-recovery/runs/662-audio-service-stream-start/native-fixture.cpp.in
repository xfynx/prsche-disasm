        const U magic = (handle_mode == 2u) ? 0xdeadbeefu : 0x4d525453u;
        setup_codec_for_queue(codec_va, handle_va, magic, has_free, req0_va, req1_va,
                              state28, 0u, 0x222u, 0x333u, false);

        U cur = data_va;
        for (U c = 0u; c < chunk_count; ++c) {
            const U c_tag = (c + 1u == chunk_count) ? tag_arg : (0x41424300u + c);
