static void init_original_code() {
    const B body_0056b790[] = {@BODY_0056B790@};
    const B body_0056b800[] = {@BODY_0056B800@};
    const B body_0056b690[] = {@BODY_0056B690@};
    const B body_0056c040[] = {@BODY_0056C040@};
    const B body_00567550[] = {@BODY_00567550@};
    const B body_005a28a0[] = {@BODY_005A28A0@};

    static_assert(sizeof body_0056b790 == 105u, "0056b790 size");
    static_assert(sizeof body_0056b800 == 91u, "0056b800 size");
    static_assert(sizeof body_0056b690 == 250u, "0056b690 size");
    static_assert(sizeof body_0056c040 == 242u, "0056c040 size");
    static_assert(sizeof body_00567550 == 267u, "00567550 size");
    static_assert(sizeof body_005a28a0 == 254u, "005a28a0 size");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");
    std::memset(code, 0xcc, 4096u);

    orig_56b790 = code + 0x000u;
    orig_56b800 = code + 0x100u;
    orig_56b690 = code + 0x200u;
    orig_56c040 = code + 0x400u;
    orig_567550 = code + 0x600u;
    orig_5a28a0 = code + 0x800u;

    std::memcpy(orig_56b790, body_0056b790, sizeof body_0056b790);
    std::memcpy(orig_56b800, body_0056b800, sizeof body_0056b800);
    std::memcpy(orig_56b690, body_0056b690, sizeof body_0056b690);
    std::memcpy(orig_56c040, body_0056c040, sizeof body_0056c040);
    std::memcpy(orig_567550, body_00567550, sizeof body_00567550);
    std::memcpy(orig_5a28a0, body_005a28a0, sizeof body_005a28a0);

    auto reloc_rel = [&](B* fn, U off, U expected_disp, const void* target) {
        require(rd(fn, off) == expected_disp, "rel disp");
        wr(fn, off, address(target) - (address(fn) + off + 4u));
    };
    auto reloc_abs = [&](B* fn, U off, U expected_va, const void* target) {
        require(rd(fn, off) == expected_va, "abs va");
        wr(fn, off, address(target));
    };

    // 0056b790 relocations
    reloc_rel(orig_56b790, 0x00cu, 0xfffc6b10u, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56b790, 0x01cu, 0xfffc6b10u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_abs(orig_56b790, 0x02eu, 0x006a5df0u, &porsche::audio_stream_request_serial_006a5df0);
    reloc_abs(orig_56b790, 0x03eu, 0x006a5df0u, &porsche::audio_stream_request_serial_006a5df0);
    reloc_abs(orig_56b790, 0x045u, 0x006a5df0u, &porsche::audio_stream_request_serial_006a5df0);
    reloc_abs(orig_56b790, 0x04cu, 0x006a5df0u, &porsche::audio_stream_request_serial_006a5df0);
    reloc_rel(orig_56b790, 0x05cu, 0xfffc6ad0u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));

    // 0056b800 relocations
    reloc_rel(orig_56b800, 0x01eu, 0xfffc6a8eu, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56b800, 0x03au, 0xfffc6a82u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56b800, 0x050u, 0xfffc6a6cu, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));

    // 0056b690 relocations
    reloc_rel(orig_56b690, 0x012u, 0xfffffcdau, reinterpret_cast<const void*>(&porsche::audio_stream_handle_validate_0056b380));
    reloc_abs(orig_56b690, 0x01eu, 0x005bdbd0u, porsche::stream_err_queuefile_invalid_005bdbd0);
    reloc_abs(orig_56b690, 0x024u, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56b690, 0x028u, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56b690, 0x02eu, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56b690, 0x038u, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_rel(orig_56b690, 0x04au, 0x000000b2u, orig_56b790);
    reloc_rel(orig_56b690, 0x071u, 0x0003719bu, orig_5a28a0);
    reloc_rel(orig_56b690, 0x090u, 0x000000dcu, orig_56b800);
    reloc_rel(orig_56b690, 0x09du, 0xfffc6b7fu, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56b690, 0x0bfu, 0xfffc6b6du, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56b690, 0x0dcu, 0x000000f0u, reinterpret_cast<const void*>(&porsche::audio_stream_codec_advance_0056b860));
    reloc_rel(orig_56b690, 0x0eeu, 0x000000deu, reinterpret_cast<const void*>(&porsche::audio_stream_codec_advance_0056b860));

    // 0056c040 relocations
    reloc_rel(orig_56c040, 0x012u, 0xfffff32au, reinterpret_cast<const void*>(&porsche::audio_stream_handle_validate_0056b380));
    reloc_abs(orig_56c040, 0x01eu, 0x005bdd04u, porsche::stream_err_queuemem_invalid_005bdd04);
    reloc_abs(orig_56c040, 0x024u, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56c040, 0x028u, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56c040, 0x02eu, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56c040, 0x038u, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_rel(orig_56c040, 0x04au, 0xfffff702u, orig_56b790);
    reloc_rel(orig_56c040, 0x0a2u, 0xfffff71au, orig_56b800);
    reloc_rel(orig_56c040, 0x0afu, 0xfffc61bdu, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56c040, 0x0d1u, 0xfffc61abu, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56c040, 0x0e6u, 0xfffff736u, reinterpret_cast<const void*>(&porsche::audio_stream_codec_advance_0056b860));

    // 00567550 relocations
    reloc_abs(orig_567550, 0x001u, 0x006b499cu, &porsche::application_audio_device_state_006b48c0[0xdcu]);
    reloc_rel(orig_567550, 0x01du, 0xfffff7efu, reinterpret_cast<const void*>(&porsche::audio_stream_service_lookup_00566d60));
    reloc_rel(orig_567550, 0x062u, 0x000040dau, orig_56b690);
    reloc_rel(orig_567550, 0x082u, 0x00004a6au, orig_56c040);
    reloc_rel(orig_567550, 0x09eu, 0x000220deu, reinterpret_cast<const void*>(&porsche::audio_backend_lock_005896d0));
    reloc_rel(orig_567550, 0x0ffu, 0x0002209du, reinterpret_cast<const void*>(&porsche::audio_backend_unlock_005896f0));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");
}

static void prepare_arena() {
    for (U i = 0u; i < kArenaBytes; ++i) {
        arena[i] = static_cast<B>((i * 41u + 0x5au) & 0xffu);
    }
    porsche::shared_runtime_word_005deb74 = 0x11223344u;
    porsche::shared_runtime_word_005deb78 = 0x55667788u;
    porsche::diagnostic_handler_005debf0 =
        reinterpret_cast<void(__cdecl*)(const char*)>(mock_diagnostic_fn);
}

static void compare_traces() {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "abi");
    require(trace.ret == expected.ret, "return_value");
    require(trace.count == expected.count, "event_count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "ev_tag");
        require(trace.events[i].arg0 == expected.events[i].arg0, "ev_arg0");
        require(trace.events[i].arg1 == expected.events[i].arg1, "ev_arg1");
        require(trace.events[i].file_word == expected.events[i].file_word, "ev_file_word");
        require(trace.events[i].line_word == expected.events[i].line_word, "ev_line_word");
        require(trace.events[i].extra0 == expected.events[i].extra0, "ev_extra0");
        require(std::memcmp(trace.events[i].msg, expected.events[i].msg, kMsgCap) == 0, "ev_msg");
    }
    require(trace.final_file_word == expected.final_file_word, "final_file_word");
    require(trace.final_line_word == expected.final_line_word, "final_line_word");
    require(trace.final_req_serial == expected.final_req_serial, "final_req_serial");
    require(std::memcmp(&trace.fp, &expected.fp, sizeof trace.fp) == 0, "fp");
    require(std::memcmp(trace.memory, expected.memory, kArenaBytes) == 0, "arena_memory");

    ++cases;
    events_total += trace.count;
}

static void run_alloc_request(bool has_free, U init_serial, U req_low_word, U mutate_lock) {
    const U codec_va = address(arena);
    const U req0_va = address(arena) + 0x400u;
    const U req1_va = address(arena) + 0x600u;
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        prepare_arena();
        active_codec_va = codec_va;
        enter_mutates_lock = mutate_lock;
        new_lock_value = 0xdeadbeefu;
        mock_lookup_ret = 0u;
        porsche::audio_stream_request_serial_006a5df0 = init_serial;

        wr_va(codec_va + 0x04u, 0x11220001u);
        wr_va(codec_va + 0x58u, has_free ? req0_va : 0u);
        if (has_free) {
            wr_va(req0_va + 0x00u, req_low_word);
            wr_va(req0_va + 0x0cu, req1_va);
        }

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_alloc_request_0056b790)
                        : reinterpret_cast<void*>(orig_56b790);
        trace.abi_fail = invoke_1(fn, codec_va);
        trace.ret = captured_return;
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        trace.final_req_serial = porsche::audio_stream_request_serial_006a5df0;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0u) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

static void run_enqueue_request(bool has_tail, U mutate_lock) {
    const U codec_va = address(arena);
    const U req0_va = address(arena) + 0x400u;
    const U req1_va = address(arena) + 0x600u;
    const U target_req = has_tail ? req1_va : req0_va;
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        prepare_arena();
        active_codec_va = codec_va;
        enter_mutates_lock = mutate_lock;
        new_lock_value = 0xdeadbeefu;
        mock_lookup_ret = 0u;
        porsche::audio_stream_request_serial_006a5df0 = 0x100u;

        wr_va(codec_va + 0x04u, 0x11220002u);
        wr_va(codec_va + 0x4cu, has_tail ? req0_va : 0u);
