void __cdecl audio_stream_codec_advance_0056b860(void* codec, std::uint32_t offset) {
    require(trace.count < kMaxEvents, "event overflow");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof e);
    e.tag = kEvAdvance;
    const U codec_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(codec));
    e.arg0 = codec_va;
    e.arg1 = offset;
    if (codec_va != 0u) {
