using B = std::uint8_t;

enum : U {
    kArenaBytes = 8192u,
    kMaxEvents = 64u,
    kMsgCap = 128u,
};

enum EventTag : U {
    kEvHeapEnter = 1u,
    kEvHeapLeave = 2u,
    kEvAdvance = 3u,
    kEvLookup = 4u,
    kEvBackendLock = 5u,
    kEvBackendUnlock = 6u,
    kEvDiagnostic = 7u,
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U file_word;
    U line_word;
    U extra0;
    char msg[kMsgCap];
};

struct Trace {
    U ret;
    U abi_fail;
    U count;
    Event events[kMaxEvents];
    U final_file_word;
    U final_line_word;
    U final_req_serial;
