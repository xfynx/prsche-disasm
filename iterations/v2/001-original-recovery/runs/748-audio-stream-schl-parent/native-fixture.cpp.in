struct Event { U tag, a0, a1, a2, a3, ret; };
struct Token { U tag, value, payload, length; };
struct Trace {
    U ret, abi_fail, count;
    Event events[kMaxEvents];
    B device[0x18c];
    porsche::AudioStreamServiceStorage561 service;
    FpuSnapshot fp;
    B memory[kArenaBytes];
