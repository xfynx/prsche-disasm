alignas(256) static B arena[kArenaBytes];
alignas(16) static B fp_area[512];
static B fp_env[28];
static Trace trace{}, expected{};
static Token tokens[kMaxTokens]{};
static U token_count = 0u, token_cursor = 0u, alloc_cursor = 0u;
static U cases = 0u, events_total = 0u, which = 0u, captured_return = 0u;
static I voice_result = 0;
static bool shrink_callback_count = false;
static B* code = nullptr;
static B* orig_566ea0 = nullptr;

static U address(const void* p) { return static_cast<U>(reinterpret_cast<std::uintptr_t>(p)); }
static U rd(const void* p, U o = 0u) { U v = 0u; std::memcpy(&v, static_cast<const B*>(p) + o, 4u); return v; }
static void wr(void* p, U o, U v) { std::memcpy(static_cast<B*>(p) + o, &v, 4u); }
static void wr16(void* p, U o, std::uint16_t v) { std::memcpy(static_cast<B*>(p) + o, &v, 2u); }
static void wr8(void* p, U o, B v) { std::memcpy(static_cast<B*>(p) + o, &v, 1u); }
static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", why, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}
static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip, cases, which);
    std::fflush(stdout);
    ExitProcess(1);
    return EXCEPTION_CONTINUE_SEARCH;
}
static Event& event(U tag, U a0=0u, U a1=0u, U a2=0u, U a3=0u, U ret=0u) {
    require(trace.count < kMaxEvents, "event overflow");
    Event& e = trace.events[trace.count++];
    e = Event{tag,a0,a1,a2,a3,ret};
    return e;
}
static void capture_fp(FpuSnapshot& fp) {
    __asm fxsave fp_area
    __asm fnstenv fp_env
    __asm fldenv fp_env
    fp.control = static_cast<unsigned short>(rd(fp_area,0u));
    fp.status = static_cast<unsigned short>(rd(fp_area,2u));
    fp.tag = static_cast<unsigned short>(rd(fp_env,8u));
    fp.pad = 0u;
    fp.mxcsr = rd(fp_area,24u);
    for (U i=0u;i<8u;++i) {
        std::memcpy(fp.values+i*10u,fp_area+32u+i*16u,10u);
        if ((fp_area[4u] & (1u << (((fp.status >> 11u) + i) & 7u))) == 0u)
            std::memset(fp.values+i*10u,0,10u);
    }
}

namespace porsche {
ApplicationAudioDeviceStateStorage application_audio_device_state_006b48c0{};
AudioStreamServiceStorage561 audio_stream_service_storage_006b7740{};

std::int32_t __cdecl audio_token_read_00599760(void* state) {
    const U state_va = address(state);
    const U cursor = rd(reinterpret_cast<void*>(static_cast<std::uintptr_t>(state_va)));
    if (token_cursor >= token_count) {
        event(kEvToken,cursor,0xffu,0u,0u,0u);
        return 0;
    }
    const Token& t = tokens[token_cursor++];
    wr(reinterpret_cast<void*>(static_cast<std::uintptr_t>(state_va)),0u,cursor+1u);
    wr(reinterpret_cast<void*>(static_cast<std::uintptr_t>(state_va)),4u,t.tag);
    wr(reinterpret_cast<void*>(static_cast<std::uintptr_t>(state_va)),8u,t.value);
    wr(reinterpret_cast<void*>(static_cast<std::uintptr_t>(state_va)),12u,t.payload);
    wr(reinterpret_cast<void*>(static_cast<std::uintptr_t>(state_va)),16u,t.length);
    event(kEvToken,cursor,t.tag,t.value,t.length,1u);
    return 1;
}
std::uint32_t __cdecl application_audio_backend_allocate_0058aae0(std::uint32_t bytes) {
    const U off = 0x3000u + alloc_cursor;
    const U stride = (bytes + 15u) & ~15u;
    require(off + stride <= kArenaBytes,"alloc overflow");
    alloc_cursor += stride ? stride : 16u;
    const U result = address(arena+off);
    event(kEvAlloc,bytes,0u,0u,0u,result);
    return result;
}
std::uint32_t __cdecl audio_stream_copy_forward_00598a50(U dst,U src,U bytes) {
    if (bytes) std::memmove(reinterpret_cast<void*>(static_cast<std::uintptr_t>(dst)),
                            reinterpret_cast<const void*>(static_cast<std::uintptr_t>(src)),bytes);
    event(kEvCopy,dst,src,bytes,0u,dst);
    return dst;
}
void __cdecl audio_stream_codec_release_chunk_0056c620(U handle, void* chunk) {
    event(kEvRelease,handle,address(chunk));
}
std::int32_t __cdecl audio_stream_voice_start_005612a0(U slot,void* header,void* params,void* descriptor) {
    event(kEvVoiceStart,slot,address(header),address(params),address(descriptor),static_cast<U>(voice_result));
    return voice_result;
}
std::int32_t __cdecl audio_backend_channel_apply_00590e70(U handle,const void* params) {
    event(kEvApply,handle,address(params),0u,0u,0x1357u);
    return 0x1357;
}
