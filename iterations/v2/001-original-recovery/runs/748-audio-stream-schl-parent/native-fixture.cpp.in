enum : U { kArenaBytes = 16384u, kMaxEvents = 128u, kMaxTokens = 32u };
enum EventTag : U {
    kEvToken = 1u, kEvAlloc = 2u, kEvCopy = 3u, kEvRelease = 4u,
    kEvVoiceStart = 5u, kEvApply = 6u, kEvNotify0 = 7u, kEvNotify1 = 8u
