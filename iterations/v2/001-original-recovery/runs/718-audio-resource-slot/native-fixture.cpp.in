// Unused dependencies of actual canonical Run443 device owner: fail closed.
namespace porsche {
I __stdcall audio_direct_sound_create_00597f70(const void*,U*,void*){ExitProcess(92);return 0;}
void* __stdcall audio_platform_foreground_window(){ExitProcess(93);return nullptr;}
void* __stdcall audio_platform_desktop_window(){ExitProcess(94);return nullptr;}
