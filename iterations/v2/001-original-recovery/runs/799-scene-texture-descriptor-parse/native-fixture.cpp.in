// Native x86-vs-C++ differential fixture for Run799:
//   0044d7e0..0044d991 (434B) porsche::scene_texture_descriptor_parse_0044d7e0
//   0044d710..0044d7cf (194B) porsche::scene_texture_descriptor_shrink_mip_0044d710
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

#include <array>
#include <cstdint>
#include <cstdio>
