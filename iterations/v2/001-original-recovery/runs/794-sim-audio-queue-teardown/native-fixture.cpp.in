void* __cdecl allocate_00531ca0(const char* source, std::int32_t bytes, std::uint32_t heap_index) {
    const U tag_match = (source != nullptr && std::strcmp(source, "SFXBANK") == 0) ? 1u : 0u;
    push_event(kEvAllocate, tag_match, static_cast<U>(bytes), heap_index);
    std::memset(mock_alloc_buf, 0, sizeof(mock_alloc_buf));
    return mock_alloc_buf;
}

std::uint32_t __cdecl free_00531f90(void* allocation) {
    U kind = 0u;
    if (allocation == mock_pool_storage) {
        kind = 100u;
    } else if (allocation == mock_entries_bank0) {
        kind = 10u;
    } else if (allocation == mock_entries_bank1) {
        kind = 11u;
    } else if (allocation == mock_entries_bank2) {
        kind = 12u;
    } else if (allocation == mock_entries_bank3) {
        kind = 13u;
    } else if (allocation == mock_entries_bank4) {
        kind = 14u;
    } else if (allocation == mock_bank_entries_buf) {
        kind = 20u;
    }
    push_event(kEvFree, kind);
    return 0u;
}

