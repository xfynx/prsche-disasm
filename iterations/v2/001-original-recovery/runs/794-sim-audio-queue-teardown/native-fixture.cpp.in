    write_rel32(pfd30 + 0x065u, reinterpret_cast<const void*>(&porsche::audio_channel_stop_00565d60));
    write_u32(pfd30 + 0x06du, sec_va);
    write_rel32(pfd30 + 0x077u, reinterpret_cast<const void*>(&porsche::audio_channel_stop_00565d60));
    write_u32(pfd30 + 0x07fu, extra_va);
    write_rel32(pfd30 + 0x08bu, reinterpret_cast<const void*>(&porsche::audio_channel_stop_00565d60));
    write_u32(pfd30 + 0x099u, extra_va + 8u);
    write_u32(pfd30 + 0x0a3u, prim_va);
    write_u32(pfd30 + 0x0a9u, sec_va);
