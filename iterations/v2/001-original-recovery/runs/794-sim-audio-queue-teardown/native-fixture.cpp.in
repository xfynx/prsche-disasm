template <typename SetupFn, typename CallFn>
static void run_case(SetupFn setup, CallFn call_target, void* x86_target, void* cpp_target) {
    ++cases;
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        reset_all();
        setup();
        void* fn = (side == 0u) ? x86_target : cpp_target;
        call_target(fn);
        capture_fpu(&trace.fp);
        finalize_trace();
        if (trace.abi_fail != 0u) {
            fail("abi");
        }
        if (side == 0u) {
            expected = trace;
        } else if (std::memcmp(&expected, &trace, sizeof(Trace)) != 0) {
            fail("mismatch");
        }
    }
}

static const B kPeData5D19DC[30] = {
    0x53, 0x4e, 0x44, 0x62, 0x61, 0x6e, 0x6b, 0x61, 0x64, 0x64, 0x20, 0x66, 0x61, 0x69, 0x6c,
    0x65, 0x64, 0x20, 0x6f, 0x6e, 0x20, 0x73, 0x70, 0x65, 0x65, 0x63, 0x68, 0x21, 0x0a, 0x00
};
static const B kPeData5D19FC[8] = { 0x53, 0x46, 0x58, 0x42, 0x41, 0x4e, 0x4b, 0x00 };

int main() {
    if (std::memcmp(porsche::audio_speech_fail_text_005d19dc, kPeData5D19DC, 30u) != 0 ||
        std::memcmp(porsche::audio_sfxbank_tag_005d19fc, kPeData5D19FC, 8u) != 0) {
        fail("initial_data_mismatch");
    }
    if (porsche::audio_queue_consumer_00656ac8 != 0u ||
        porsche::audio_pool_base_00656acc != nullptr ||
        porsche::audio_pool_cursor_00656ae0 != 0 ||
        porsche::audio_queue_stall_00656af0 != 0u ||
        porsche::audio_pool_limit_00656afc != 0 ||
        porsche::audio_pool_end_0065737a != 0 ||
        porsche::audio_pool_split_00657380 != 0 ||
        porsche::audio_state_word_0065738c != 0 ||
        porsche::audio_state_dword_00657390 != 0u ||
        porsche::audio_state_dword_00657394 != 0u ||
        porsche::audio_state_word_0065739c != 0 ||
        porsche::audio_state_word_006573a0 != 0 ||
        porsche::audio_state_byte_006573a5 != 0u ||
        porsche::audio_state_byte_006573a6 != 0u ||
        porsche::audio_state_byte_006573a7 != 0u ||
        porsche::audio_queue_inflight_count_006573b4 != 0u) {
        fail("initial_bss_nonzero");
    }

    patch_all_originals();

    static const B kBankPayload[16] = { 'B', 'N', 'K', 'l', 4, 0, 1, 0, 9, 8, 7, 6, 5, 4, 3, 2 };

    // Case 1: audio_bank_record_set_004a8490 succeeds with open_res == 8.
    run_case(
        []() {
            porsche::application_audio_records_00656528[4] = { 2u, 15, -1, 0u, 0u, 0u };
            mock_bank_open_ret = 8;
            mock_bank_out_handle = 99u;
        },
        [](void* fn) {
            invoke_cdecl_4(fn, 2, 15, kBankPayload, 16u, &trace.abi_fail);
        },
        code + kOff4A8490, reinterpret_cast<void*>(&porsche::audio_bank_record_set_004a8490));

    // Case 2: audio_bank_record_set_004a8490 clears record when size == 0.
    run_case(
        []() {
            porsche::application_audio_records_00656528[1] = { 0u, 3, -1, 0x111u, 0u, 0u };
        },
        [](void* fn) {
            invoke_cdecl_4(fn, 0, 3, nullptr, 0u, &trace.abi_fail);
        },
        code + kOff4A8490, reinterpret_cast<void*>(&porsche::audio_bank_record_set_004a8490));

    // Case 3: audio_bank_record_set_004a8490 fails bank open (open_res == 0 >= 0) on speech bank 2.
    run_case(
        []() {
            porsche::application_audio_records_00656528[2] = { 2u, 22, -1, 0u, 0u, 0u };
            mock_bank_open_ret = 0;
            mock_bank_out_handle = 55u;
        },
        [](void* fn) {
            invoke_cdecl_4(fn, 2, 22, kBankPayload, 16u, &trace.abi_fail);
        },
        code + kOff4A8490, reinterpret_cast<void*>(&porsche::audio_bank_record_set_004a8490));

    // Case 4: audio_queue_pump_004af970 returns early when op_status == 0.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 5u;
            porsche::audio_queue_inflight_count_006573b4 = 2u;
            porsche::audio_queue_ring_00656b00[5].handle_04 = 0;
            porsche::audio_queue_ring_00656b00[5].id_14 = 123;
            mock_op_status = 0;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AF970, reinterpret_cast<void*>(&porsche::audio_queue_pump_004af970));

    // Case 5: audio_queue_pump_004af970 valid BNKL with flag_1d==0, index_18==-1, split exact match -> resets split & limit=0x7ffc, advances 62->63.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 62u;
            porsche::audio_queue_inflight_count_006573b4 = 1u;
            porsche::audio_pool_cursor_00656ae0 = 40;
            porsche::audio_pool_split_00657380 = 64;
            porsche::audio_pool_limit_00656afc = 100;
            porsche::audio_queue_stall_00656af0 = 1u;
            std::memcpy(mock_pool_storage + 48, kBankPayload, 16u);
            auto& q = porsche::audio_queue_ring_00656b00[62];
            q.raw_08 = 7u;
            q.handle_04 = 48;
            q.raw_0c = 16u;
            q.id_14 = 9;
            q.index_18 = -1;
            q.flag_1d = 0u;
            q.bank_1e = 2;
            mock_op_status = 1;
            mock_op_completed = 16u;
            mock_sim_rets[0] = -1;
            mock_sim_rets[1] = 10; // non -1 -> no stall
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AF970, reinterpret_cast<void*>(&porsche::audio_queue_pump_004af970));

    // Case 6: audio_queue_pump_004af970 stalls when second sim_boundary returns -1.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 0u;
            std::memcpy(mock_pool_storage + 16, kBankPayload, 16u);
            auto& q = porsche::audio_queue_ring_00656b00[0];
            q.raw_08 = 3u;
            q.handle_04 = 16;
            q.raw_0c = 16u;
            q.id_14 = -1;
            q.index_18 = -1;
            q.flag_1d = 0u;
            q.bank_1e = 2;
            mock_sim_rets[0] = -1;
            mock_sim_rets[1] = -1;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AF970, reinterpret_cast<void*>(&porsche::audio_queue_pump_004af970));

    // Case 7: audio_queue_pump_004af970 invalid magic clears bank entries and wraps consumer 63 -> 0.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 63u;
            porsche::audio_pool_cursor_00656ae0 = 20;
            porsche::audio_pool_split_00657380 = 0;
            porsche::audio_pool_end_0065737a = 200;
            porsche::application_audio_records_00656528[0] = { 0u, 2, -1, 0u, 0u, 0u };
            std::memcpy(mock_pool_storage + 32, kBankPayload, 16u);
            mock_pool_storage[35] = 'X'; // invalid magic != 'BNKl'
            auto& q = porsche::audio_queue_ring_00656b00[63];
            q.handle_04 = 32;
            q.raw_0c = 16u;
            q.id_14 = -1;
            q.index_18 = 2;
            q.flag_1d = 1u;
            q.bank_1e = 0;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AF970, reinterpret_cast<void*>(&porsche::audio_queue_pump_004af970));

    // Case 8: audio_queue_pump_004af970 invalid hdr[4]!=4 with split!=end advances cursor & limit.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 1u;
            porsche::audio_pool_cursor_00656ae0 = 10;
            porsche::audio_pool_split_00657380 = 500;
            std::memcpy(mock_pool_storage + 32, kBankPayload, 16u);
            mock_pool_storage[36] = 5u; // hdr[4] != 4
            auto& q = porsche::audio_queue_ring_00656b00[1];
            q.handle_04 = 32;
            q.raw_0c = 16u;
            q.id_14 = -1;
            q.index_18 = 1;
            q.flag_1d = 0u;
            q.bank_1e = 0;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AF970, reinterpret_cast<void*>(&porsche::audio_queue_pump_004af970));

    // Case 9: audio_queue_pump_004af970 handle_04 == -1 clears pending record and advances consumer.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 2u;
            porsche::application_audio_records_00656528[3] = { 0u, 1, -1, 0u, 0u, 0u };
            auto& q = porsche::audio_queue_ring_00656b00[2];
            q.handle_04 = -1;
            q.index_18 = 1;
            q.flag_1d = 0u;
            q.bank_1e = 0;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AF970, reinterpret_cast<void*>(&porsche::audio_queue_pump_004af970));

    // Case 10: application_sim_boundary_004afd30 flushes 2 queue entries, stops handles, and resets scalars.
    run_case(
        []() {
            porsche::audio_queue_consumer_00656ac8 = 0u;
            porsche::audio_queue_read_pos_00656af4 = 2u;
            porsche::audio_queue_head_00656ae4 = 0u;
            porsche::audio_queue_tail_00657300 = 2u;
            for (int i = 0; i < 2; ++i) {
                porsche::audio_queue_ring_00656b00[i].handle_04 = -1;
                porsche::audio_queue_ring_00656b00[i].bank_1e = 2;
                porsche::audio_queue_ring_00656b00[i].flag_1d = 1u;
                porsche::audio_queue_ring_00656b00[i].index_18 = i;
            }
            porsche::frame_audio_primary_handle_006573a8 = 11;
            porsche::frame_audio_secondary_handle_006573ac = 22;
            porsche::frame_audio_extra_handles_00656ae8[0] = 33;
            porsche::frame_audio_extra_handles_00656ae8[1] = 44;
            porsche::audio_state_byte_006573a6 = 9u;
            porsche::audio_pool_limit_00656afc = 123;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AFD30, reinterpret_cast<void*>(&porsche::application_sim_boundary_004afd30));

    // Case 11: application_sim_boundary_004afe50 closes all 5 banks (0..4) and frees pool base.
    run_case(
        []() {
            porsche::audio_queue_banks_00657308[0] = { 0x100u, 1u, mock_entries_bank0, 1 };
            porsche::audio_queue_banks_00657308[1] = { 0x101u, 0u, mock_entries_bank1, 1 };
            porsche::audio_queue_banks_00657308[2] = { 0x102u, 1u, nullptr, 1 };
            porsche::audio_queue_banks_00657308[3] = { 0x103u, 0u, mock_entries_bank3, 1 };
            porsche::audio_queue_banks_00657308[4] = { 0x104u, 1u, mock_entries_bank4, 1 };
            porsche::audio_pool_base_00656acc = mock_pool_storage;
            porsche::audio_queue_consumer_00656ac8 = 0u;
            porsche::audio_queue_read_pos_00656af4 = 0u;
        },
        [](void* fn) {
            invoke_cdecl_0(fn, &trace.abi_fail);
        },
        code + kOff4AFE50, reinterpret_cast<void*>(&porsche::application_sim_boundary_004afe50));

    std::printf("sim_audio_queue_teardown_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
