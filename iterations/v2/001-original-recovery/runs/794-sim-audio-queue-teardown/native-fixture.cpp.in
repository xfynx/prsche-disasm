        push ebx
        push esi
        push edi
        mov saved_sp, esp
        mov saved_bp, ebp
        mov ebx, 0x11223344
        mov esi, 0x55667788
        mov edi, 0x99aabbcc
        mov eax, target
        call eax
        cmp esp, saved_sp
        jne bad_abi
        cmp ebp, saved_bp
        jne bad_abi
        cmp ebx, 0x11223344
        jne bad_abi
        cmp esi, 0x55667788
        jne bad_abi
        cmp edi, 0x99aabbcc
        je ok_abi
    bad_abi:
        mov bad, 1
        mov esp, saved_sp
        mov ebp, saved_bp
    ok_abi:
        pop edi
        pop esi
        pop ebx
    }
    *abi_fail = bad;
}

