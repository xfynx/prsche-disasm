static void patch_all_originals() {
    code = static_cast<B*>(::VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    if (!code) {
        fail("virtual_alloc");
    }
    std::memcpy(code + kOff4AFD30, kBody4AFD30, sizeof(kBody4AFD30));
    std::memcpy(code + kOff4AFE50, kBody4AFE50, sizeof(kBody4AFE50));
    std::memcpy(code + kOff4AF970, kBody4AF970, sizeof(kBody4AF970));
    std::memcpy(code + kOff4A8490, kBody4A8490, sizeof(kBody4A8490));

    const U consumer_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_consumer_00656ac8));
    const U pool_base_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_pool_base_00656acc));
    const U cursor_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_pool_cursor_00656ae0));
    const U head_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_head_00656ae4));
    const U extra_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::frame_audio_extra_handles_00656ae8[0]));
    const U stall_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_stall_00656af0));
    const U read_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_read_pos_00656af4));
    const U limit_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_pool_limit_00656afc));
    const U ring_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_ring_00656b00[0]));
    const U tail_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_tail_00657300));
    const U banks_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_banks_00657308[0]));
    const U end_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_pool_end_0065737a));
    const U split_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_pool_split_00657380));
    const U tag_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::frame_audio_tag_00657388));
    const U w38c_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_word_0065738c));
    const U d390_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_dword_00657390));
    const U d394_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_dword_00657394));
    const U w39c_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_word_0065739c));
    const U w3a0_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_word_006573a0));
    const U mode_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::frame_audio_mode_006573a4));
    const U b3a5_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_byte_006573a5));
    const U b3a6_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_byte_006573a6));
    const U b3a7_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_state_byte_006573a7));
