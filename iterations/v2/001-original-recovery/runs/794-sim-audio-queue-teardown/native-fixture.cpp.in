    const U sec_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::frame_audio_secondary_handle_006573ac));
    const U inflight_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::audio_queue_inflight_count_006573b4));
    const U rec_base = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::application_audio_records_00656528[0]));
    const U rec_end = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::application_audio_records_00656528[32]));
    const U seq_va = static_cast<U>(reinterpret_cast<std::uintptr_t>(&porsche::startup_sequence_word_00606ac4));

    // Patch 004AFD30.
    B* pfd30 = code + kOff4AFD30;
    write_u32(pfd30 + 0x001u, consumer_va);
    write_u32(pfd30 + 0x007u, read_va);
