static void write_u32(B* p, U value) {
    std::memcpy(p, &value, sizeof(value));
}

static void write_rel32(B* site, const void* target) {
    const I rel = static_cast<I>(
        reinterpret_cast<std::uintptr_t>(target) -
        (reinterpret_cast<std::uintptr_t>(site) + 4u));
    std::memcpy(site, &rel, sizeof(rel));
}

static void fail(const char* why) {
    std::printf("sim_audio_queue_teardown_original_x86_vs_cpp=FAIL case=%u side=%u reason=%s\n",
                cases, which, why);
    std::exit(1);
}

static void push_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u) {
    if (trace.count >= kMaxEvents) {
        fail("event_overflow");
    }
    trace.events[trace.count++] = Event{tag, a0, a1, a2};
    ++events_total;
}

