std::int32_t __cdecl application_sim_boundary_004a8570(std::int32_t first,
                                                       std::int32_t second,
                                                       std::int32_t flag) {
    push_event(kEvSimBoundary, static_cast<U>(first), static_cast<U>(second), static_cast<U>(flag));
    const I ret = mock_sim_rets[mock_sim_call_idx & 7u];
    ++mock_sim_call_idx;
    if (ret == -1) {
        for (int i = 0; i < 32; ++i) {
            if (application_audio_records_00656528[i].channel_04 == -1) {
                application_audio_records_00656528[i].raw_00 = static_cast<U>(first);
                application_audio_records_00656528[i].channel_04 = second;
                application_audio_records_00656528[i].handle_08 = -1;
                break;
            }
        }
    }
    return ret;
}

