static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_ptr(U p) {
    if (p == 0u) return 0u;
    if (p >= address(str_buf_a) && p < address(str_buf_a) + sizeof(str_buf_a)) {
        return 0xa1000000u + (p - address(str_buf_a));
    }
    if (p >= address(member_buf_arena) && p < address(member_buf_arena) + sizeof(member_buf_arena)) {
        return 0xa2000000u + (p - address(member_buf_arena));
    }
    if (p >= address(mgr_arena) && p < address(mgr_arena) + sizeof(mgr_arena)) {
        return 0xa3000000u + (p - address(mgr_arena));
    }
    if (p == address(movie_service_obj_a)) return 0xa4000001u;
    if (p == address(movie_service_obj_b)) return 0xa4000002u;
    if (p == address(&shared_obj)) return 0xa5000000u;
    return p;
}

static void copy_text(char* dst, std::size_t cap, const char* src) {
    if (src == nullptr) {
        std::snprintf(dst, cap, "<null>");
        return;
    }
    std::snprintf(dst, cap, "%s", src);
}

static Event& push_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u, const char* text = nullptr) {
    require(trace.count < 48u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    if (text != nullptr) {
        copy_text(e.text, sizeof(e.text), text);
    }
    return e;
}

