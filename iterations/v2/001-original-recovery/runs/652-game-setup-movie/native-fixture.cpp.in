void __cdecl game_setup_object_init_00403520(void* object, std::uint32_t bytes) {
    push_event(kEvObjInit, object != nullptr ? 1u : 0u, bytes);
    auto* obj = static_cast<StringObj*>(object);
    if (stub_cfg.init_cap == 0u) {
        obj->begin = 0u;
        obj->current = 0u;
        obj->end = 0u;
    } else {
        obj->begin = address(str_buf_a);
        obj->current = address(str_buf_a);
        obj->end = address(str_buf_a) + stub_cfg.init_cap;
        str_buf_a[0] = 0x7fu; // verify 004dd4a0 clears *movie.current = 0
    }
}

