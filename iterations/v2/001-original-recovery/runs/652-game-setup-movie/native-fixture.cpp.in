                   reinterpret_cast<const void*>(&porsche::game_setup_update_00560030));
    relocate_abs32(slot_4dd4a0, 0x010u, 0x0065b334u, address(&fixture_load_base));
    relocate_abs32(slot_4dd4a0, 0x01du, 0x005d999cu, address(orig_str_5d999c));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x023u, 0x005a0fbfu,
                   reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x033u, 0x0059d9b0u,
                   reinterpret_cast<const void*>(&porsche::resource_open_quiet_0059d9b0));
    relocate_abs32(slot_4dd4a0, 0x039u, 0x0065b32cu, address(&fixture_earts_base));
    relocate_abs32(slot_4dd4a0, 0x048u, 0x005d998cu, address(orig_str_5d998c));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x04eu, 0x005a0fbfu,
                   reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_abs32(slot_4dd4a0, 0x053u, 0x0069ed0cu, address(&porsche::game_setup_movie_service_0069ed0c));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x05eu, 0x00536080u,
                   reinterpret_cast<const void*>(&orig_movie_service_begin_thiscall));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x068u, 0x0059dc30u,
                   reinterpret_cast<const void*>(&porsche::game_setup_file_exists_0059dc30));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x08au, 0x00403520u,
                   reinterpret_cast<const void*>(&orig_object_init_thiscall));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x09fu, 0x0059e440u, slot_59e440);
    relocate_abs32(slot_4dd4a0, 0x0afu, 0x006bd9b0u, address(&iat_render_begin_006bd9b0));
    relocate_abs32(slot_4dd4a0, 0x0b5u, 0x006bd91cu, address(&iat_render_reset_006bd91c));
    relocate_abs32(slot_4dd4a0, 0x0bbu, 0x006bd970u, address(&iat_render_prepare_006bd970));
    relocate_abs32(slot_4dd4a0, 0x0c1u, 0x006bd948u, address(&iat_render_update_006bd948));
    relocate_abs32(slot_4dd4a0, 0x0c8u, 0x006bd978u, address(&iat_render_finish_006bd978));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x0e2u, 0x004dc850u,
                   reinterpret_cast<const void*>(&porsche::game_setup_movie_004dc850));
    relocate_abs32(slot_4dd4a0, 0x0ffu, 0x005e4fe8u, address(&fixture_heap_state_005e4fe8));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x110u, 0x0059ecd0u,
                   reinterpret_cast<const void*>(&porsche::context_table_release_0059ecd0));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x11du, 0x005322b0u,
                   reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x136u, 0x005322c0u,
                   reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    relocate_abs32(slot_4dd4a0, 0x13eu, 0x0069ed0cu, address(&porsche::game_setup_movie_service_0069ed0c));
    relocate_rel32(slot_4dd4a0, 0x004dd4a0u, 0x146u, 0x00536050u,
                   reinterpret_cast<const void*>(&orig_movie_service_end_thiscall));
}

static void reset_common() {
    std::memset(&trace, 0, sizeof trace);
    std::memset(str_buf_a, 0x33, sizeof str_buf_a);
    std::memset(member_buf_arena, 0x44, sizeof member_buf_arena);
    std::memset(mgr_arena, 0, sizeof mgr_arena);
    fixture_heap_state_005e4fe8 = static_cast<void*>(mgr_arena);
    put(mgr_arena, 0x28u, 0x778899aau); // pool lock
    for (U b = 0u; b < 32u; ++b) {
        put(mgr_arena, 0x28u + 0x0cu + b * 4u, 0x90000000u + b);
    }
    std::memset(movie_service_holder_a, 0, sizeof movie_service_holder_a);
    std::memset(movie_service_holder_b, 0, sizeof movie_service_holder_b);
    std::memset(movie_service_obj_a, 0x11, sizeof movie_service_obj_a);
    std::memset(movie_service_obj_b, 0x22, sizeof movie_service_obj_b);
    put(movie_service_holder_a, 4u, address(movie_service_obj_a));
    put(movie_service_holder_b, 4u, address(movie_service_obj_b));
    porsche::game_setup_movie_service_0069ed0c = static_cast<void*>(movie_service_holder_a);
}

static void snapshot_state() {
    trace.final_obj = shared_obj;
    trace.final_obj.begin = normalize_ptr(shared_obj.begin);
    trace.final_obj.current = normalize_ptr(shared_obj.current);
    trace.final_obj.end = normalize_ptr(shared_obj.end);
    std::memcpy(trace.final_str_buf, str_buf_a, sizeof str_buf_a);
    std::memcpy(trace.final_member_buf, member_buf_arena, sizeof member_buf_arena);
    std::memcpy(trace.final_mgr, mgr_arena, sizeof mgr_arena);
}

static void verify_trace(bool check_obj) {
    require(trace.abi_fail == 0u, "x86 ABI");
    require(expected.abi_fail == 0u, "cpp ABI");
    require(trace.ret_eax == expected.ret_eax, "ret_eax");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        const Event& a = trace.events[i];
        const Event& b = expected.events[i];
        require(a.tag == b.tag, "event tag");
        require(a.a0 == b.a0, "event a0");
        require(a.a1 == b.a1, "event a1");
        require(a.a2 == b.a2, "event a2");
        require(a.a3 == b.a3, "event a3");
        require(std::strcmp(a.text, b.text) == 0, "event text");
    }
    if (check_obj) {
        require(trace.final_obj.begin == expected.final_obj.begin, "obj.begin");
        require(trace.final_obj.current == expected.final_obj.current, "obj.current");
        require(trace.final_obj.end == expected.final_obj.end, "obj.end");
        require(std::memcmp(trace.final_str_buf, expected.final_str_buf, sizeof str_buf_a) == 0, "str_buf");
        require(std::memcmp(trace.final_member_buf, expected.final_member_buf, sizeof member_buf_arena) == 0, "member_buf");
    }
    require(std::memcmp(trace.final_mgr, expected.final_mgr, sizeof mgr_arena) == 0, "mgr_arena");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof(Fpu)) == 0, "FPU");
}

static void setup_insert_env(const char* init_text, U cap_bytes, const char* insert_src) {
    reset_common();
    std::memset(&shared_obj, 0, sizeof shared_obj);
    if (cap_bytes != 0u) {
        const U init_len = (init_text != nullptr) ? static_cast<U>(std::strlen(init_text)) : 0u;
        shared_obj.begin = address(str_buf_a);
        if (init_len != 0u) {
            std::memcpy(str_buf_a, init_text, init_len);
        }
        str_buf_a[init_len] = 0u;
        shared_obj.current = address(str_buf_a) + init_len;
        shared_obj.end = address(str_buf_a) + cap_bytes;
    }
    std::memset(input_scratch, 0x55, sizeof input_scratch);
    if (insert_src != nullptr) {
        std::memcpy(input_scratch, insert_src, std::strlen(insert_src) + 1u);
    }
}

static void run_insert_case(const char* init_text, U cap_bytes, const char* insert_src, U first_off, U last_off) {
    const char* first = reinterpret_cast<const char*>(input_scratch + first_off);
    const char* last = reinterpret_cast<const char*>(input_scratch + last_off);
    if (first_off >= 0x80000000u) {
        // Use str_buf_a self-overlap view when requested.
        const U lo = first_off - 0x80000000u;
        const U hi = last_off - 0x80000000u;
        first = reinterpret_cast<const char*>(str_buf_a + lo);
        last = reinterpret_cast<const char*>(str_buf_a + hi);
    }

    setup_insert_env(init_text, cap_bytes, insert_src);
    seed_fpu();
    trace.abi_fail = invoke_thiscall2(slot_472860, &shared_obj, address(first), address(last), trace.ret_eax);
    capture_fpu(trace.fpu);
    trace.ret_eax = normalize_ptr(trace.ret_eax);
    snapshot_state();
    expected = trace;

    setup_insert_env(init_text, cap_bytes, insert_src);
    seed_fpu();
    void* cpp_ret = nullptr;
    {
        auto* fn = &porsche::context_string_insert_00472860;
        U eax_out = 0u;
        trace.abi_fail = invoke_thiscall2(reinterpret_cast<void*>(fn), &shared_obj,
                                          address(first), address(last), eax_out);
        cpp_ret = reinterpret_cast<void*>(static_cast<std::uintptr_t>(eax_out));
    }
    capture_fpu(trace.fpu);
    trace.ret_eax = normalize_ptr(address(cpp_ret));
    snapshot_state();
    verify_trace(true);
    ++cases;
}

struct OpenCase {
    const char* init_text;
    U cap_bytes;
    bool roots_enabled;
    const char* root_path;
    const char* fallback_path;
    U exists_mask;
    bool mutate_missing;
    void (__cdecl* missing_cb)(const char*, std::int32_t);
    const char* path;
};

static void setup_open_env(const OpenCase& c) {
    reset_common();
    stub_cfg = {};
    stub_cfg.exists_mask = c.exists_mask;
    stub_cfg.mutate_missing_on_exists = c.mutate_missing;

    porsche::file_roots_enabled_006af370 = c.roots_enabled ? 1 : 0;
    std::memset(porsche::file_root_006af168, 0, sizeof porsche::file_root_006af168);
    std::memset(porsche::file_fallback_006af26c, 0, sizeof porsche::file_fallback_006af26c);
    if (c.root_path != nullptr) {
        std::snprintf(porsche::file_root_006af168, sizeof porsche::file_root_006af168, "%s", c.root_path);
    }
    if (c.fallback_path != nullptr) {
        std::snprintf(porsche::file_fallback_006af26c, sizeof porsche::file_fallback_006af26c, "%s", c.fallback_path);
    }
    porsche::missing_file_006afbe4 = c.missing_cb;

    const U init_len = static_cast<U>(std::strlen(c.init_text));
    shared_obj.begin = address(str_buf_a);
    std::memcpy(str_buf_a, c.init_text, init_len + 1u);
    shared_obj.current = address(str_buf_a) + init_len;
    shared_obj.end = address(str_buf_a) + c.cap_bytes;
}

static void run_open_case(const OpenCase& c) {
    setup_open_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl2(slot_59e440, address(c.path), address(&shared_obj), trace.ret_eax);
    capture_fpu(trace.fpu);
    trace.ret_eax &= 0xffu;
    snapshot_state();
    expected = trace;

    setup_open_env(c);
    seed_fpu();
    U eax_out = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::game_setup_resource_open_result_0059e440),
        address(c.path), address(&shared_obj), eax_out);
    capture_fpu(trace.fpu);
    trace.ret_eax = eax_out & 0xffu;
    snapshot_state();
    verify_trace(true);

    // Also exercise the canonical void entry point declared in porsche/game_setup.hpp.
    setup_open_env(c);
    seed_fpu();
    U void_eax = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::game_setup_resource_open_0059e440),
        address(c.path), address(&shared_obj), void_eax);
    capture_fpu(trace.fpu);
    trace.ret_eax = expected.ret_eax; // void entry has no semantic return value
    snapshot_state();
    verify_trace(true);
    ++cases;
}

struct MovieCase {
    const char* load_base;
    const char* earts_base;
    bool roots_enabled;
    const char* root_path;
    const char* fallback_path;
    U exists_mask;
    void (__cdecl* missing_cb)(const char*, std::int32_t);
    U setup_exists;
    U init_cap;
    bool switch_service;
    U movie_stop_out;
};

static void setup_movie_env(const MovieCase& c) {
    reset_common();
    stub_cfg = {};
    stub_cfg.exists_mask = c.exists_mask;
    stub_cfg.setup_file_exists_ret = c.setup_exists;
    stub_cfg.init_cap = c.init_cap;
    stub_cfg.switch_service_on_play = c.switch_service;
    stub_cfg.movie_stop_out = c.movie_stop_out;

    fixture_load_base = c.load_base;
    fixture_earts_base = c.earts_base;
    porsche::file_roots_enabled_006af370 = c.roots_enabled ? 1 : 0;
    std::memset(porsche::file_root_006af168, 0, sizeof porsche::file_root_006af168);
    std::memset(porsche::file_fallback_006af26c, 0, sizeof porsche::file_fallback_006af26c);
    if (c.root_path != nullptr) {
        std::snprintf(porsche::file_root_006af168, sizeof porsche::file_root_006af168, "%s", c.root_path);
    }
    if (c.fallback_path != nullptr) {
        std::snprintf(porsche::file_fallback_006af26c, sizeof porsche::file_fallback_006af26c, "%s", c.fallback_path);
    }
    porsche::missing_file_006afbe4 = c.missing_cb;
    std::memset(&shared_obj, 0, sizeof shared_obj);
}

static void run_movie_case(const MovieCase& c) {
    setup_movie_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(slot_4dd4a0);
    capture_fpu(trace.fpu);
    snapshot_state();
    expected = trace;

    setup_movie_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(reinterpret_cast<void*>(&porsche::game_setup_movie_004dd4a0));
    capture_fpu(trace.fpu);
    snapshot_state();
    verify_trace(false);
    ++cases;
}

int main() {
    init();

    // 1. context_string_insert_00472860 cases.
    run_insert_case("abc", 16u, "XYZ", 0u, 0u);          // empty [first, last)
    run_insert_case("abc", 16u, "X", 0u, 1u);            // in-place 1-byte insert (tail_len == 0 still calls 005a1a40)
    run_insert_case("abc", 16u, "XYZ", 0u, 3u);          // in-place multi-byte insert
    run_insert_case("abc", 7u, "XYZ", 0u, 3u);           // exact max_len boundary (3+3 == 7-1 -> in-place)
    run_insert_case("abc", 6u, "XYZ", 0u, 3u);           // grow by 1 past max_len (3+3 > 6-1 -> bucket 0 free)
    run_insert_case("abcdef", 16u, "1234567890", 0u, 10u); // grow with insert_len > old_len (bucket 1 free)
    run_insert_case("0123456789ab", 17u, "Z", 0u, 1u);   // grow with old_len > insert_len (bucket 2 free)
    {
        // Build long initial string of length 255 in 0x100 (256B) vs 256 in 0x101 (257B) buffers.
        char big[260];
        std::memset(big, 'A', 255);
        big[255] = '\0';
        run_insert_case(big, 0x100u, "XY", 0u, 2u);     // old_bytes == 0x100u -> small pool freelist bucket 31
        big[255] = 'A';
        big[256] = '\0';
        run_insert_case(big, 0x101u, "XY", 0u, 2u);     // old_bytes == 0x101u -> context_table_release_0059ecd0
    }
    run_insert_case("hello", 16u, "", 0x80000001u, 0x80000004u); // overlapping self-slice [begin+1, begin+4)

    // 2. game_setup_resource_open_0059e440 / _result cases.
    run_open_case({"", 8u, false, "", "", 0u, false, nullptr, "inPC-av.mad"});             // unrooted grow (0 -> 11 > 7)
    run_open_case({"long_existing_path_0123", 32u, false, "", "", 0u, false, nullptr, "a.mad"}); // unrooted shrink (calls 005a1a40)
    run_open_case({"a.mad", 16u, false, "", "", 0u, false, nullptr, "b.mad"});              // unrooted same length (no 005a1a40)
    run_open_case({"", 32u, true, "P:\\", "F:\\", 1u, false, &fixture_missing_a, "m.mad"}); // primary root hit
    run_open_case({"", 32u, true, "P:\\", "F:\\", 2u, false, &fixture_missing_a, "m.mad"}); // fallback root hit
    run_open_case({"", 32u, true, "P:\\", "", 0u, false, &fixture_missing_a, "m.mad"});     // miss, empty fallback, cb a
    run_open_case({"", 32u, true, "P:\\", "F:\\", 0u, true, &fixture_missing_a, "m.mad"});  // miss, fallback miss, cb mutated to b
    run_open_case({"long_existing_path", 32u, true, "P:\\", "F:\\", 0u, false, nullptr, "m.mad"}); // miss shrink to 005e8e50 ""
    run_open_case({"", 8u, true, "P:\\", "F:\\", 0u, false, &fixture_missing_a, "m.mad"});  // miss on empty string (cur_len==0, len==0)

    // 3. game_setup_movie_004dd4a0 cases.
    run_movie_case({"L:\\", "E:\\", false, "", "", 0u, nullptr, 0u, 8u, false, 0u});        // file_exists == 0
    run_movie_case({"L:\\", "E:\\", false, "", "", 0u, nullptr, 1u, 8u, false, 1u});        // unrooted play, grow 8B->15B, free bucket 1
    run_movie_case({"L:\\", "E:\\", true, "P:\\", "F:\\", 1u, &fixture_missing_a, 1u, 8u, true, 0u}); // rooted primary hit + service switch
    run_movie_case({"L:\\", "E:\\", true, "P:\\", "F:\\", 2u, &fixture_missing_a, 1u, 64u, false, 0u}); // rooted fallback hit, fits 64B
    run_movie_case({"L:\\", "E:\\", true, "P:\\", "F:\\", 0u, &fixture_missing_a, 1u, 8u, false, 0u});  // rooted miss -> 005e8e50, 8B free bucket 0
    run_movie_case({"L:\\", "E:\\", false, "", "", 0u, nullptr, 1u, 0x100u, false, 0u});    // bytes == 0x100u -> small pool bucket 31
    run_movie_case({"L:\\", "E:\\", false, "", "", 0u, nullptr, 1u, 0x101u, false, 0u});    // bytes == 0x101u -> context_table_release_0059ecd0

    std::printf("game_setup_movie_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
