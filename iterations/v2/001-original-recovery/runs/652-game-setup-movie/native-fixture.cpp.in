std::int32_t __cdecl file_exists_00561b80(const char* path) {
    std::int32_t hit = 0;
    if (path != nullptr) {
        if (std::strncmp(path, "P:\\", 3) == 0 && (stub_cfg.exists_mask & 1u) != 0u) {
            hit = 1;
        } else if (std::strncmp(path, "F:\\", 3) == 0 && (stub_cfg.exists_mask & 2u) != 0u) {
            hit = 1;
        }
    }
    if (stub_cfg.mutate_missing_on_exists) {
        missing_file_006afbe4 = &fixture_missing_b;
    }
    push_event(kEvExists561b80, static_cast<U>(hit), 0u, 0u, 0u, path);
    return hit;
}

std::int32_t __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 256u, format, args);
    va_end(args);
    push_event(kEvFormat, 0u, 0u, 0u, 0u, output);
    return static_cast<std::int32_t>(n);
}

