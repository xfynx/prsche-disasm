static U invoke_2(void* fn, U a0, U a1) {
    U saved_sp = 0u;
    U saved_bp = 0u;
    U fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp, esp
        mov saved_bp, ebp
        push a1
        push a0
        mov ebx, 0x13579bdf
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        call fn
        mov captured_return, eax
        add esp, 8
        cmp esp, saved_sp
        jne bad_abi
        cmp ebp, saved_bp
        jne bad_abi
        cmp ebx, 0x13579bdf
        jne bad_abi
        cmp esi, 0x2468ace0
        jne bad_abi
        cmp edi, 0x10203040
        je ok_abi
    bad_abi:
        mov fail, 1
    ok_abi:
        mov esp, saved_sp
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static U invoke_3(void* fn, U a0, U a1, U a2) {
    U saved_sp = 0u;
    U saved_bp = 0u;
    U fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp, esp
        mov saved_bp, ebp
        push a2
        push a1
        push a0
        mov ebx, 0x13579bdf
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        call fn
        mov captured_return, eax
        add esp, 12
        cmp esp, saved_sp
        jne bad_abi
        cmp ebp, saved_bp
        jne bad_abi
        cmp ebx, 0x13579bdf
        jne bad_abi
        cmp esi, 0x2468ace0
        jne bad_abi
        cmp edi, 0x10203040
        je ok_abi
    bad_abi:
        mov fail, 1
    ok_abi:
        mov esp, saved_sp
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static void init_original_code() {
    const B body_0056b860[] = {@BODY_0056B860@};
    const B body_0056ba20[] = {@BODY_0056BA20@};
    const B body_0056ba80[] = {@BODY_0056BA80@};
    static_assert(sizeof body_0056b860 == 433u, "0056b860 size");
    static_assert(sizeof body_0056ba20 == 85u, "0056ba20 size");
    static_assert(sizeof body_0056ba80 == 97u, "0056ba80 size");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");
    std::memset(code, 0xcc, 4096u);

    orig_56b860 = code + 0x000u;
    orig_56ba20 = code + 0x200u;
    orig_56ba80 = code + 0x300u;

    std::memcpy(orig_56b860, body_0056b860, sizeof body_0056b860);
    std::memcpy(orig_56ba20, body_0056ba20, sizeof body_0056ba20);
    std::memcpy(orig_56ba80, body_0056ba80, sizeof body_0056ba80);

    auto reloc_rel = [&](B* fn, U off, U expected_disp, const void* target) {
        require(rd(fn, off) == expected_disp, "rel disp");
        wr(fn, off, address(target) - (address(fn) + off + 4u));
    };
    auto reloc_abs = [&](B* fn, U off, U expected_va, const void* target) {
        require(rd(fn, off) == expected_va, "abs va");
        wr(fn, off, address(target));
    };

    // 0056b860 relocations
    reloc_rel(orig_56b860, 0x00du, 0xfffc6a3fu, reinterpret_cast<const void*>(&porsche::heap_enter_005322b0));
    reloc_rel(orig_56b860, 0x046u, 0xfffc6a16u, reinterpret_cast<const void*>(&porsche::heap_leave_005322c0));
    reloc_rel(orig_56b860, 0x070u, 0x0000021cu, reinterpret_cast<const void*>(&porsche::audio_stream_codec_refill_0056baf0));
    reloc_rel(orig_56b860, 0x101u, 0xffffd13bu, reinterpret_cast<const void*>(&porsche::request_open_00568aa0));
    reloc_abs(orig_56b860, 0x113u, 0x005bdc24u, porsche::stream_err_unable_to_open_005bdc24);
    reloc_abs(orig_56b860, 0x119u, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56b860, 0x11du, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56b860, 0x123u, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56b860, 0x12du, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_abs(orig_56b860, 0x13au, 0x0056ba20u, orig_56ba20);
    reloc_rel(orig_56b860, 0x140u, 0xffffc71cu, reinterpret_cast<const void*>(&porsche::operation_callback_005680c0));
    reloc_rel(orig_56b860, 0x153u, 0xffffd129u, reinterpret_cast<const void*>(&porsche::request_close_00568ae0));
    reloc_abs(orig_56b860, 0x165u, 0x005bdbfcu, porsche::stream_err_unable_to_close_005bdbfc);
    reloc_abs(orig_56b860, 0x16bu, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56b860, 0x16fu, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56b860, 0x175u, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56b860, 0x17fu, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_abs(orig_56b860, 0x18cu, 0x0056ba80u, orig_56ba80);
    reloc_rel(orig_56b860, 0x192u, 0xffffc6cau, reinterpret_cast<const void*>(&porsche::operation_callback_005680c0));
    reloc_rel(orig_56b860, 0x1a5u, 0x000000e7u, reinterpret_cast<const void*>(&porsche::audio_stream_codec_refill_0056baf0));

    // 0056ba20 relocations
    reloc_rel(orig_56ba20, 0x00du, 0xffffc3bfu, reinterpret_cast<const void*>(&porsche::operation_complete_00567df0));
    reloc_abs(orig_56ba20, 0x023u, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56ba20, 0x027u, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56ba20, 0x02du, 0x005bdc4cu, porsche::stream_err_unable_to_open_file_005bdc4c);
    reloc_abs(orig_56ba20, 0x033u, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56ba20, 0x03du, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_rel(orig_56ba20, 0x04cu, 0x00000080u, reinterpret_cast<const void*>(&porsche::audio_stream_codec_refill_0056baf0));

    // 0056ba80 relocations
    reloc_rel(orig_56ba80, 0x00du, 0xffffc35fu, reinterpret_cast<const void*>(&porsche::operation_complete_00567df0));
    reloc_rel(orig_56ba80, 0x01du, 0xffffcfffu, reinterpret_cast<const void*>(&porsche::request_open_00568aa0));
    reloc_abs(orig_56ba80, 0x030u, 0x005bdc24u, porsche::stream_err_unable_to_open_005bdc24);
    reloc_abs(orig_56ba80, 0x036u, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    reloc_abs(orig_56ba80, 0x03au, 0x005bd978u, porsche::stream_source_file_005bd978);
    reloc_abs(orig_56ba80, 0x040u, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    reloc_abs(orig_56ba80, 0x04au, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    reloc_abs(orig_56ba80, 0x053u, 0x0056ba20u, orig_56ba20);
    reloc_rel(orig_56ba80, 0x059u, 0xffffc5e3u, reinterpret_cast<const void*>(&porsche::operation_callback_005680c0));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");
}

static void prepare_arena() {
    for (U i = 0u; i < kArenaBytes; ++i) {
        arena[i] = static_cast<B>((i * 41u + 0x5au) & 0xffu);
    }
    porsche::shared_runtime_word_005deb74 = 0x11223344u;
    porsche::shared_runtime_word_005deb78 = 0x55667788u;
    porsche::diagnostic_handler_005debf0 =
        reinterpret_cast<void(__cdecl*)(const char*)>(mock_diagnostic_fn);
}

static void compare_traces() {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "abi");
    require(trace.count == expected.count, "event_count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "ev_tag");
        require(trace.events[i].arg0 == expected.events[i].arg0, "ev_arg0");
        require(trace.events[i].arg1 == expected.events[i].arg1, "ev_arg1");
        require(trace.events[i].arg2 == expected.events[i].arg2, "ev_arg2");
        require(trace.events[i].arg3 == expected.events[i].arg3, "ev_arg3");
        require(trace.events[i].arg4 == expected.events[i].arg4, "ev_arg4");
        require(trace.events[i].file_word == expected.events[i].file_word, "ev_file_word");
        require(trace.events[i].line_word == expected.events[i].line_word, "ev_line_word");
        require(trace.events[i].extra0 == expected.events[i].extra0, "ev_extra0");
        require(trace.events[i].extra1 == expected.events[i].extra1, "ev_extra1");
        require(std::memcmp(trace.events[i].msg, expected.events[i].msg, kMsgCap) == 0, "ev_msg");
    }
    require(trace.final_file_word == expected.final_file_word, "final_file_word");
    require(trace.final_line_word == expected.final_line_word, "final_line_word");
    require(std::memcmp(&trace.fp, &expected.fp, sizeof trace.fp) == 0, "fp");
    require(std::memcmp(trace.memory, expected.memory, kArenaBytes) == 0, "arena_memory");

    ++cases;
    events_total += trace.count;
}

static void run_open_done(
    U op_handle,
    I status,
    U op168,
    U op_complete_ret,
    U offset30,
    U field34,
    const char* path) {
    const U codec_va = address(arena);
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        prepare_arena();
        active_stream_va = codec_va;
        enter_mutates_lock = 0u;
        enter_mutates_write44 = 0u;
        leave_mutates_write44 = 0u;
        mock_op_complete_ret = op_complete_ret;
        mock_request_open_ret = 0u;
        mock_request_close_ret = 0u;
        mock_chain_callbacks = 0u;

        wr_va(codec_va + 0x30u, offset30);
        wr_va(codec_va + 0x34u, field34);
        wr_va(codec_va + 0x48u, 0xabcdef01u);
        wr_va(codec_va + 0x50u, 0u);
        wr_va(codec_va + 0x160u, 0x88887777u);
        wr_va(codec_va + 0x164u, 0x11112222u);
        wr_va(codec_va + 0x168u, op168);
        std::memset(arena + 0x5cu, 0x55, 64u);
        copy_cstr(reinterpret_cast<char*>(arena + 0x5cu), 256u, path);

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_open_done_0056ba20)
                        : reinterpret_cast<void*>(orig_56ba20);
        trace.abi_fail = invoke_3(fn, op_handle, static_cast<U>(status), codec_va);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0u) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

