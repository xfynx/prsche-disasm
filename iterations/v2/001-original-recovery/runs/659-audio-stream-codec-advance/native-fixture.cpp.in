        wr_va(codec_va + 0x30u, offset30);
        wr_va(codec_va + 0x50u, 0u);
        wr_va(codec_va + 0x160u, handle160);
        wr_va(codec_va + 0x164u, 0x33334444u);
        wr_va(codec_va + 0x168u, op168);
        std::memset(arena + 0x5cu, 0x44, 64u);
        copy_cstr(reinterpret_cast<char*>(arena + 0x5cu), 256u, path);

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_close_done_0056ba80)
                        : reinterpret_cast<void*>(orig_56ba80);
        trace.abi_fail = invoke_3(fn, op_handle, static_cast<U>(status), codec_va);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0u) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

struct AdvanceCase {
    bool has_req0;
    U req0_status;
    bool has_req1;
    U req1_status;
    U req_mem_backed;
    U req_init_off11c;
    const char* req_path;
    const char* codec_path;
    U codec_handle160;
    U codec_write44;
    U codec_state28;
    U arg_offset;
    U req_open_ret;
    U req_close_ret;
    U op_complete_ret;
    U chain_callbacks;
    U mutate_lock;
    U mutate_write44;
};

static void run_advance(const AdvanceCase& c) {
    const U codec_va = address(arena);
    const U req0_va = address(arena) + 0x200u;
    const U req1_va = address(arena) + 0x400u;
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        prepare_arena();
        active_stream_va = codec_va;
        enter_mutates_lock = c.mutate_lock;
        new_lock_value = 0xdeadbeefu;
        enter_mutates_write44 = c.mutate_write44;
        new_enter_write44 = c.codec_write44 + 0x100u;
        leave_mutates_write44 = c.mutate_write44;
        new_leave_write44 = c.codec_write44 + 0x200u;
        mock_op_complete_ret = c.op_complete_ret;
        mock_request_open_ret = c.req_open_ret;
        mock_request_close_ret = c.req_close_ret;
        mock_chain_callbacks = c.chain_callbacks;
        mock_cb_status = 0;

        wr_va(codec_va + 0x04u, 0x11220001u);
        wr_va(codec_va + 0x28u, c.codec_state28);
        wr_va(codec_va + 0x30u, c.arg_offset);
        wr_va(codec_va + 0x44u, c.codec_write44);
        wr_va(codec_va + 0x48u, 0x99887766u);
        wr_va(codec_va + 0x50u, c.has_req0 ? req0_va : 0u);
        wr_va(codec_va + 0x160u, c.codec_handle160);
        wr_va(codec_va + 0x164u, 0x55443322u);
        wr_va(codec_va + 0x168u, 0x00abcdefu);
        std::memset(arena + 0x5cu, 0x33, 64u);
        copy_cstr(reinterpret_cast<char*>(arena + 0x5cu), 256u, c.codec_path);

        if (c.has_req0) {
            wr_va(req0_va + 0x04u, c.req0_status);
            wr_va(req0_va + 0x08u, c.has_req1 ? req1_va : 0u);
            wr_va(req0_va + 0x0cu, c.has_req1 ? req1_va : 0u);
            wr_va(req0_va + 0x10u, c.req_mem_backed);
            wr_va(req0_va + 0x11cu, c.req_init_off11c);
            wr_va(req0_va + 0x124u, 0x77777777u);
            copy_cstr(reinterpret_cast<char*>(arena + 0x200u + 0x14u), 256u, c.req_path);
        }
        if (c.has_req1) {
            // Put distinct +0x08 vs +0x0c in req0 when testing req0->0x0c vs req0->0x08
            wr_va(req0_va + 0x08u, 0u);
            wr_va(req1_va + 0x04u, c.req1_status);
            wr_va(req1_va + 0x0cu, 0u);
            wr_va(req1_va + 0x10u, c.req_mem_backed);
            wr_va(req1_va + 0x11cu, c.req_init_off11c);
            wr_va(req1_va + 0x124u, 0x66666666u);
            copy_cstr(reinterpret_cast<char*>(arena + 0x400u + 0x14u), 256u, c.req_path);
        }

        std::memset(&trace, 0, sizeof trace);
        __asm fninit
        void* fn = side ? reinterpret_cast<void*>(&porsche::audio_stream_codec_advance_0056b860)
                        : reinterpret_cast<void*>(orig_56b860);
        trace.abi_fail = invoke_2(fn, codec_va, c.arg_offset);
        trace.final_file_word = porsche::shared_runtime_word_005deb74;
        trace.final_line_word = porsche::shared_runtime_word_005deb78;
        capture_fp(trace.fp);
        std::memcpy(trace.memory, arena, kArenaBytes);
        if (side == 0u) {
            std::memcpy(&expected, &trace, sizeof trace);
        }
    }
    compare_traces();
}

int main() {
    SetUnhandledExceptionFilter(fault_handler);

    // Check initial production state before any fixture writes.
    require(porsche::shared_runtime_word_005deb74 == 0u, "initial_005deb74");
    require(porsche::shared_runtime_word_005deb78 == 0u, "initial_005deb78");

    // Check exact .rdata bytes against raw PE before relocation.
    require(sizeof porsche::stream_err_unable_to_close_005bdbfc == sizeof raw_str_005bdbfc &&
            std::memcmp(porsche::stream_err_unable_to_close_005bdbfc, raw_str_005bdbfc, sizeof raw_str_005bdbfc) == 0,
            "rdata_005bdbfc");
    require(sizeof porsche::stream_err_unable_to_open_005bdc24 == sizeof raw_str_005bdc24 &&
            std::memcmp(porsche::stream_err_unable_to_open_005bdc24, raw_str_005bdc24, sizeof raw_str_005bdc24) == 0,
            "rdata_005bdc24");
    require(sizeof porsche::stream_err_unable_to_open_file_005bdc4c == sizeof raw_str_005bdc4c &&
            std::memcmp(porsche::stream_err_unable_to_open_file_005bdc4c, raw_str_005bdc4c, sizeof raw_str_005bdc4c) == 0,
            "rdata_005bdc4c");
    require(sizeof porsche::stream_source_file_005bd978 == sizeof raw_str_005bd978 &&
            std::memcmp(porsche::stream_source_file_005bd978, raw_str_005bd978, sizeof raw_str_005bd978) == 0,
            "rdata_005bd978");

    init_original_code();

    // 1. 0056ba20: open_done
    // Failure path: operation_complete returns 0 -> 2-arg diagnostic with codec+0x5c
    run_open_done(0x1111u, -1, 0x2222u, 0u, 0x77u, 0x88u, "audio/track01.asf");
    // Success path: operation_complete returns handle -> stores codec+0x160 and calls refill(codec, codec+0x30)
    run_open_done(0x3333u, 0, 0x4444u, 0x55667788u, 0x99u, 0x11u, "audio/track02.asf");

    // 2. 0056ba80: close_done
    // Failure path: request_open returns 0 -> 0x206 diagnostic
    run_close_done(0x1010u, 0, 0x2020u, 0x3030u, 0x44u, "audio/next.asf", 0u, 0u, 0u);
    // Success path: request_open returns non-zero -> registers open_done callback (and chains to open_done -> refill)
    run_close_done(0x1011u, -5, 0x2021u, 0x3031u, 0x55u, "audio/chain.asf", 0x9001u, 1u, 0xaa11bb22u);

    // 3. 0056b860: advance
    // No active request (codec+0x50 == 0) -> sets codec+0x28 = 0, preserves saved lock across heap_enter/leave
    run_advance({false, 0u, false, 0u, 0u, 0u, "", "old.asf", 0u, 0x1000u, 2u, 0x12u, 0u, 0u, 0u, 0u, 1u, 0u});
    // Current request status != 1 and next == 0 -> sets codec+0x28 = 0, does NOT clear codec+0x50
    run_advance({true, 3u, false, 0u, 0u, 0u, "a.asf", "old.asf", 0u, 0x1000u, 2u, 0x13u, 0u, 0u, 0u, 0u, 0u, 0u});
    // Current request status == 1, memory-backed (req+0x10 == 1) -> lock + write44 mutation checks + refill
    run_advance({true, 1u, false, 0u, 1u, 0x400u, "ignored", "keep.asf", 0x7777u, 0x1200u, 1u, 0x22u, 0u, 0u, 0u, 0u, 1u, 1u});
    // Current request status != 1, chains to req->next (even if req->next->status == 99), same path -> direct refill with req+0x11c
    run_advance({true, 3u, true, 99u, 0u, 0x380u, "music/same.asf", "music/same.asf", 0x7777u, 0x1400u, 1u, 0x33u, 0u, 0u, 0u, 0u, 0u, 0u});
    // Path mismatch, handle == 0, request_open fails -> strcpy + 0x291 diagnostic
    run_advance({true, 1u, false, 0u, 0u, 0x200u, "music/new_open_fail.asf", "music/old.asf", 0u, 0x1500u, 1u, 0x44u, 0u, 0u, 0u, 0u, 0u, 0u});
    // Path mismatch, handle == 0, request_open succeeds -> registers open_done and chains to refill
    run_advance({true, 1u, false, 0u, 0u, 0x240u, "music/new_open_ok.asf", "music/old.asf", 0u, 0x1600u, 1u, 0x55u, 0x8001u, 0u, 0x9988u, 1u, 0u, 0u});
    // Path mismatch, handle != 0, request_close fails -> strcpy + 0x29c diagnostic
    run_advance({true, 1u, false, 0u, 0u, 0x280u, "music/close_fail.asf", "music/old.asf", 0x44556677u, 0x1700u, 1u, 0x66u, 0u, 0u, 0u, 0u, 0u, 0u});
    // Path mismatch, handle != 0, request_close succeeds -> full 2-step chain close_done -> open_done -> refill
    run_advance({true, 1u, false, 0u, 0u, 0x2c0u, "music/full_chain.asf", "music/old.asf", 0x44556677u, 0x1800u, 1u, 0x77u, 0x8003u, 0x8002u, 0xccddeeffu, 2u, 0u, 0u});

    std::printf("audio_stream_codec_advance_original_x86_vs_cpp=PASS cases=%u events=%u\n", cases, events_total);
    return 0;
}
