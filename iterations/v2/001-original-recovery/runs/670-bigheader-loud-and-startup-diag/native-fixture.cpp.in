enum EventTag : U {
    kEvDevice = 1u,
    kEvAtomic = 2u,
    kEvCallback = 3u,
    kEvFormat = 4u,
    kEvExists = 5u,
    kEvMissing = 6u,
    kEvVsprintf = 7u,
    kEvSink = 8u,
};

struct Event {
    U tag;
    U a0;
    U a1;
    U a2;
    U a3;
    U a4;
    U args[8];
    char text[96];
};

struct Fpu {
    unsigned short control, status;
    B tag, padding[3], values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U count;
    Event events[16];
    U final_group;
    U final_missing_cb;
    char sink_text[1024];
    Fpu fpu;
};

static Trace trace{};
static Trace expected{};

struct StubCfg {
    bool mutate_group_in_device;
    bool invoke_atomic_cb;
