    relocate_abs32(slot_59dea0, 0x085u, 0x006af26cu, address(porsche::file_fallback_006af26c));
    relocate_abs32(slot_59dea0, 0x08fu, 0x006af26cu, address(porsche::file_fallback_006af26c));
    relocate_abs32(slot_59dea0, 0x098u, 0x005cc588u, address(orig_str_5cc588));
