std::int32_t __cdecl file_load_bigheader_callback_00562100(
    std::uint32_t group, void* opaque_context) {
    const auto* const ctx = static_cast<const ResourceAtomicContext*>(opaque_context);
    push_event(
        kEvCallback,
        group,
        ctx != nullptr ? ctx->opaque_08 : 0u,
        ctx != nullptr ? ctx->callback_diagnostic_flag : 0u,
        0u,
        0u,
        ctx != nullptr ? ctx->path : nullptr);
    return static_cast<std::int32_t>(stub_cfg.callback_ret);
}

std::uint32_t __cdecl file_device_name_00568e90(const char* path) {
    U dev = 0x10u;
    if (path != nullptr) {
        for (const char* p = path; *p != '\0'; ++p) {
            dev = dev * 33u + static_cast<B>(*p);
        }
    }
    if (stub_cfg.mutate_group_in_device) {
        resource_leaf_group_005df770 ^= 0x10101u;
    }
    push_event(kEvDevice, dev, path != nullptr ? 1u : 0u, 0u, 0u, 0u, path);
    return dev;
}

std::int32_t __cdecl resource_leaf_atomic_dispatch_00568d50(
    ResourceLeafAtomicCallback callback,
    std::uint32_t device,
    std::uint32_t group,
    void* opaque_context) {
    const auto* const ctx = static_cast<const ResourceAtomicContext*>(opaque_context);
    const U cb_ok = (callback == &file_load_bigheader_callback_00562100) ? 1u : 0u;
    push_event(
        kEvAtomic,
        cb_ok,
        device,
        group,
        ctx != nullptr ? ctx->opaque_08 : 0u,
        ctx != nullptr ? ctx->callback_diagnostic_flag : 0u,
        ctx != nullptr ? ctx->path : nullptr);
    if (stub_cfg.invoke_atomic_cb && callback != nullptr) {
        return callback(group, opaque_context);
    }
    return static_cast<std::int32_t>(stub_cfg.atomic_ret);
}

std::int32_t __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 260u, format, args);
    va_end(args);
    push_event(kEvFormat, 0u, 0u, 0u, 0u, 0u, output);
    return static_cast<std::int32_t>(n);
}

std::int32_t __cdecl file_exists_00561b80(const char* path) {
    std::int32_t hit = 0;
    if (path != nullptr) {
        if (std::strncmp(path, file_root_006af168, std::strlen(file_root_006af168)) == 0 &&
            (stub_cfg.exists_mask & 1u) != 0u) {
            hit = 1;
        } else if (file_fallback_006af26c[0] != '\0' &&
                   std::strncmp(path, file_fallback_006af26c, std::strlen(file_fallback_006af26c)) == 0 &&
                   (stub_cfg.exists_mask & 2u) != 0u) {
            hit = 1;
        }
    }
    if (stub_cfg.mutate_missing_on_exists) {
        missing_file_006afbe4 = &fixture_missing_b;
    }
    push_event(kEvExists, static_cast<U>(hit), 0u, 0u, 0u, 0u, path);
    return hit;
}

int __cdecl application_diagnostic_mono_vsprintf_005a299e(
    char* output, const char* format, const std::uint32_t* arguments) {
    require(output != nullptr, "vsprintf null output");
    require(arguments != nullptr, "vsprintf null arguments");
    require(stub_cfg.vsprintf_len < 1024u, "vsprintf len");
    vsprintf_buffer_origin = output;
    for (U i = 0u; i < stub_cfg.vsprintf_len; ++i) {
        output[i] = static_cast<char>('A' + (i % 26u));
    }
    output[stub_cfg.vsprintf_len] = '\0';
    push_event(
        kEvVsprintf,
        stub_cfg.vsprintf_len,
        static_cast<U>(stub_cfg.vsprintf_ret),
        stub_cfg.vararg_count,
        0u,
        0u,
        format,
        arguments,
        stub_cfg.vararg_count);
    return static_cast<int>(stub_cfg.vsprintf_ret);
}

void __cdecl startup_diagnostic_sink_0059fc20(const char* text) {
    require(text != nullptr, "sink null text");
    require(vsprintf_buffer_origin != nullptr, "sink before vsprintf");
    const U offset = address(text) - address(vsprintf_buffer_origin);
    const U len = static_cast<U>(std::strlen(text));
    require(len < sizeof(trace.sink_text), "sink len");
    std::memcpy(trace.sink_text, text, len + 1u);
    push_event(kEvSink, offset, len, 0u, 0u, 0u, text);
}

