static void relocate_rel32(B* slot, U base_va, U patch_offset, U target_va, const void* dst) {
    const std::int32_t expected_rel = static_cast<std::int32_t>(target_va - (base_va + patch_offset + 4u));
    std::int32_t actual_rel = 0;
    std::memcpy(&actual_rel, slot + patch_offset, 4u);
    require(actual_rel == expected_rel, "rel32 check");
    const std::int32_t rel = static_cast<std::int32_t>(
        address(dst) - (address(slot) + patch_offset + 4u));
    std::memcpy(slot + patch_offset, &rel, 4u);
}

static void relocate_abs32(B* slot, U patch_offset, U expected_va, U new_val) {
    U actual = 0u;
    std::memcpy(&actual, slot + patch_offset, 4u);
    require(actual == expected_va, "abs32 check");
    std::memcpy(slot + patch_offset, &new_val, 4u);
}

