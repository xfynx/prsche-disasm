                   reinterpret_cast<const void*>(&porsche::file_device_name_00568e90));
    relocate_abs32(slot_5620c0, 0x032u, 0x00562100u,
                   address(reinterpret_cast<const void*>(&porsche::file_load_bigheader_callback_00562100)));
    relocate_rel32(slot_5620c0, 0x005620c0u, 0x037u, 0x00568d50u,
                   reinterpret_cast<const void*>(&porsche::resource_leaf_atomic_dispatch_00568d50));

    // 0059dea0
    relocate_abs32(slot_59dea0, 0x001u, 0x006af370u, address(&porsche::file_roots_enabled_006af370));
    relocate_rel32(slot_59dea0, 0x0059dea0u, 0x048u, 0x005620c0u, slot_5620c0);
    relocate_abs32(slot_59dea0, 0x064u, 0x006af168u, address(porsche::file_root_006af168));
    relocate_abs32(slot_59dea0, 0x069u, 0x005cc588u, address(orig_str_5cc588));
    relocate_rel32(slot_59dea0, 0x0059dea0u, 0x06fu, 0x005a0fbfu,
