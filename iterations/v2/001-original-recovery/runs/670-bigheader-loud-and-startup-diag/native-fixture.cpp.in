static void seed_fpu() {
    __asm {
        fninit
        fldpi
        fld1
        fldln2
        faddp st(1), st(0)
        fsave floating
        frstor floating
    }
}

static void capture_fpu(Fpu& fpu) {
    B raw[108]{};
    U mxcsr = 0u;
    __asm {
        fsave raw
        stmxcsr mxcsr
        frstor raw
    }
    fpu.control = static_cast<unsigned short>(raw[0] | (raw[1] << 8));
    fpu.status = static_cast<unsigned short>(raw[4] | (raw[5] << 8));
    fpu.full_tag = static_cast<unsigned short>(raw[8] | (raw[9] << 8));
    fpu.tag = 0;
    for (int i = 0; i < 8; ++i) {
        if (((fpu.full_tag >> (i * 2)) & 3) != 3) {
            fpu.tag |= static_cast<B>(1u << i);
        }
    }
    std::memcpy(fpu.values, raw + 28, 80);
    fpu.mxcsr = mxcsr & 0xffffffc0u;
}

static U invoke_cdecl2(void* fn, U a0, U a1, U& out_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 0x13572468
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        push a1
        push a0
        call fn
        add esp, 8
        mov eax_out, eax
        pushfd
        pop eax
        and eax, 0x400
        jne abi_bad
        cmp esp, before
        jne abi_bad
        cmp ebp, frame
        jne abi_bad
        cmp ebx, 0x13572468
        jne abi_bad
        cmp esi, 0x2468ace0
        jne abi_bad
        cmp edi, 0x10203040
        je abi_ok
    abi_bad:
        mov fail, 1
    abi_ok:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    out_eax = eax_out;
    return fail;
}

static U invoke_cdecl_varargs(void* fn, const U* args9) {
    U before = 0u, frame = 0u, fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 0x13572468
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        mov ecx, 9
        mov edx, args9
    push_loop:
        dec ecx
        push dword ptr [edx + ecx * 4]
        test ecx, ecx
        jnz push_loop
        call fn
        add esp, 36
        pushfd
        pop eax
        and eax, 0x400
        jne abi_bad
        cmp esp, before
        jne abi_bad
        cmp ebp, frame
        jne abi_bad
        cmp ebx, 0x13572468
        jne abi_bad
        cmp esi, 0x2468ace0
        jne abi_bad
        cmp edi, 0x10203040
        je abi_ok
    abi_bad:
        mov fail, 1
    abi_ok:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

struct CaseEnv {
    StubCfg stub;
    const char* root;
    const char* fallback;
    char roots_enabled;
    void(__cdecl* missing_cb)(const char*, std::int32_t);
    U group;
};

static void setup_env(const CaseEnv& c) {
    stub_cfg = c.stub;
    vsprintf_buffer_origin = nullptr;
    std::memset(&trace, 0, sizeof(trace));
    porsche::resource_leaf_group_005df770 = c.group;
    std::memset(porsche::file_root_006af168, 0, sizeof(porsche::file_root_006af168));
    std::memset(porsche::file_fallback_006af26c, 0, sizeof(porsche::file_fallback_006af26c));
    if (c.root != nullptr) {
        std::snprintf(porsche::file_root_006af168, sizeof(porsche::file_root_006af168), "%s", c.root);
    }
    if (c.fallback != nullptr) {
        std::snprintf(porsche::file_fallback_006af26c, sizeof(porsche::file_fallback_006af26c), "%s", c.fallback);
    }
    porsche::file_roots_enabled_006af370 = c.roots_enabled;
    porsche::missing_file_006afbe4 = c.missing_cb;
}

static void capture_state() {
    trace.final_group = porsche::resource_leaf_group_005df770;
    trace.final_missing_cb = normalize_missing_cb(porsche::missing_file_006afbe4);
}

static void compare_traces() {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "ABI");
    require(trace.ret_eax == expected.ret_eax, "EAX");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) == 0, "event");
    }
    require(trace.final_group == expected.final_group, "005df770");
    require(trace.final_missing_cb == expected.final_missing_cb, "006afbe4");
    require(std::memcmp(trace.sink_text, expected.sink_text, sizeof(trace.sink_text)) == 0, "sink_text");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof(trace.fpu)) == 0, "FPU");
    ++cases;
}

static void check_5620c0(const CaseEnv& c, const char* path, U flags) {
    setup_env(c);
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl2(slot_5620c0, address(path), flags, eax_orig);
    trace.ret_eax = eax_orig;
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::file_load_bigheader_005620c0),
        address(path), flags, eax_cpp);
    trace.ret_eax = eax_cpp;
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

static void check_59dea0(const CaseEnv& c, const char* name, U flags) {
    setup_env(c);
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl2(slot_59dea0, address(name), flags, eax_orig);
    trace.ret_eax = eax_orig;
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::resource_load_bigheader_0059dea0),
        address(name), flags, eax_cpp);
    trace.ret_eax = eax_cpp;
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

static void check_59fd90(const CaseEnv& c, const char* fmt, const U* varargs8) {
    U args9[9] = {address(fmt), 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
    for (U i = 0u; i < 8u; ++i) {
        args9[i + 1u] = varargs8[i];
    }

    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl_varargs(slot_59fd90, args9);
    trace.ret_eax = 0u;
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl_varargs(
        reinterpret_cast<void*>(&porsche::startup_diagnostic_format_0059fd90), args9);
    trace.ret_eax = 0u;
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

int main() {
    // Verify production initial state BEFORE fixture resets.
    require(porsche::resource_leaf_group_005df770 == 0x64u, "initial 005df770");
    require(porsche::file_roots_enabled_006af370 == 0, "initial 006af370");
    require(porsche::missing_file_006afbe4 == nullptr, "initial 006afbe4");

    load_originals();

    const CaseEnv base_env{
        {false, false, 0x12345678u, 0x87654321u, 1u, false, 16u, 16, 4u},
        "R:\\", "F:\\", 0, nullptr, 0x64u
    };

    // 1. file_load_bigheader_005620c0 (63B)
    check_5620c0(base_env, "header_a.viv", 0u);
    check_5620c0(base_env, nullptr, 0xdeadbeefu);
    {
        CaseEnv env = base_env;
        env.stub.mutate_group_in_device = true;
        check_5620c0(env, "header_b.viv", 7u);
    }
    {
        CaseEnv env = base_env;
        env.stub.invoke_atomic_cb = true;
        check_5620c0(env, "header_cb_hi.viv", 9u);
        env.stub.callback_ret = 0u;
        check_5620c0(env, "header_cb_zero.viv", 0x11u);
    }

    // 2. resource_load_bigheader_0059dea0 (206B)
    check_59dea0(base_env, "unrooted.viv", 0u);
    check_59dea0(base_env, "unrooted_flags.viv", 0x80000001u);
    {
        CaseEnv env = base_env;
        env.roots_enabled = 1;
        env.stub.exists_mask = 1u;
        check_59dea0(env, "primary.viv", 2u);

        env.roots_enabled = -1;
        env.stub.exists_mask = 2u;
        check_59dea0(env, "fallback.viv", 3u);

        env.roots_enabled = 1;
        env.stub.exists_mask = 0u;
        env.missing_cb = &fixture_missing_a;
        check_59dea0(env, "missing_a.viv", 4u);

        env.stub.mutate_missing_on_exists = true;
        env.missing_cb = nullptr;
        check_59dea0(env, "missing_mut.viv", 5u);

        env.fallback = "";
        env.stub.mutate_missing_on_exists = false;
        env.missing_cb = &fixture_missing_a;
        check_59dea0(env, "no_fallback.viv", 6u);

        env.missing_cb = nullptr;
        check_59dea0(env, "no_fallback_nocb.viv", 7u);

        env.fallback = "F:\\";
        env.stub.exists_mask = 1u;
        env.stub.invoke_atomic_cb = true;
        check_59dea0(env, "end2end_loud.viv", 11u);
    }

    // 3. startup_diagnostic_format_0059fd90 (46B)
    {
        static const char payload_str[] = "diag-payload";
        const U va_zero[8] = {};
        const U va_mix[8] = {
            0x80000000u, 0x12345678u, address(payload_str), 0xffffffffu,
            0x11223344u, 0x55667788u, 0x99aabbccu, 0xddeeff00u
        };

        for (U len : {0u, 1u, 31u, 252u, 512u, 1023u}) {
            CaseEnv env = base_env;
            env.stub.vsprintf_len = len;
            env.stub.vsprintf_ret = static_cast<std::int32_t>(len);
            env.stub.vararg_count = 0u;
            check_59fd90(env, "plain_fmt", va_zero);

            env.stub.vararg_count = 8u;
            check_59fd90(env, "msg=%d/%x/%s/%u", va_mix);
        }

        // Verify ignored vsprintf return (-1 and 0) still calls sink with buffer.
        CaseEnv env = base_env;
        env.stub.vsprintf_len = 17u;
        env.stub.vsprintf_ret = -1;
        env.stub.vararg_count = 3u;
        check_59fd90(env, "neg_ret=%d:%x:%s", va_mix);
    }

    std::printf("bigheader_loud_startup_diag_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
