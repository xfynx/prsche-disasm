    relocate_rel32(slot_59dea0, 0x0059dea0u, 0x0a8u, 0x00561b80u,
                   reinterpret_cast<const void*>(&porsche::file_exists_00561b80));
    relocate_abs32(slot_59dea0, 0x0b4u, 0x006afbe4u, address(&porsche::missing_file_006afbe4));

    // 0059fd90
    relocate_rel32(slot_59fd90, 0x0059fd90u, 0x019u, 0x005a299eu,
