    const U kind = cfg_dev_type & 0xffu;
    if (kind == 2u && offset >= 0x0cu && offset < 0x2cu) {
        const U bit = offset - 0x0cu;
        return ((cfg_present_btn_mask >> bit) & 1u) ? 0u : 0x80070002u;
