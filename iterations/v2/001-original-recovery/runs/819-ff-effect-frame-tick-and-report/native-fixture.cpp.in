namespace porsche {

int __cdecl formatter_stdio_printf_005a177b(const char* fmt, ...) {
    char buf[256];
    va_list ap;
    va_start(ap, fmt);
    const int n = std::vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    push_event(kEvPrintf, fnv1a(fmt, std::strlen(fmt)), fnv1a(buf, std::strlen(buf)));
    return n;
}

void __cdecl frame_control_slot_release_005338d0(std::int32_t slot) {
    push_event(kEvSlotRelease, static_cast<U>(slot));
}

void __cdecl frame_control_slot_download_00533760(std::int32_t slot) {
    push_event(kEvSlotDownload, static_cast<U>(slot));
}

void* __cdecl fe_input_getstate_00532e10(std::uint32_t index, std::uint32_t mode) {
    push_event(kEvGetState, index, mode);
    return mock_dev_caps;
}

} // namespace porsche

static I __stdcall x87_trunc_helper(double d) {
    return static_cast<I>(d);
}

__declspec(naked) static void __cdecl mock_ftol_005a0f98() {
    __asm {
        sub esp, 8
        fstp qword ptr [esp]
        call x87_trunc_helper
        ret
    }
}

static void write_u32(B* p, U v) { std::memcpy(p, &v, 4u); }
static void write_f32(B* p, float v) { std::memcpy(p, &v, 4u); }
static void write_u16(B* p, std::uint16_t v) { std::memcpy(p, &v, 2u); }
static void write_rel32(B* site, const void* tgt) {
    const I rel = static_cast<I>(
        reinterpret_cast<std::uintptr_t>(tgt) -
        (reinterpret_cast<std::uintptr_t>(site) + 4u));
    std::memcpy(site, &rel, 4u);
}

