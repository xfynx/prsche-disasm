}

static U call_x86_8(void* fn, U a0, U a1, U a2, U a3, U a4, U a5, U a6, U a7) {
    U s0 = 0u, s1 = 0u, r = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        push a7
        push a6
        push a5
        push a4
        push a3
        push a2
        push a1
        push a0
        call fn
        add esp, 32
        mov r, eax
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
    return r;
}

static void reset_ff_state(U mode, U clock_tick, U dev_caps0, float spd_mph, float rpm, U gear, U off_road, float steer_z, U air_flag) {
    using namespace porsche;
    std::memset(frame_control_ff_state_005e9408, 0, sizeof(frame_control_ff_state_005e9408));
    std::memset(frame_control_effects_0069cb10, 0, sizeof(frame_control_effects_0069cb10));
    std::memset(input_slots_006be040, 0, sizeof(input_slots_006be040));
    std::memset(mock_car, 0, sizeof(mock_car));
    std::memset(mock_wheels, 0, sizeof(mock_wheels));

    ff_effect_cooldown_005e9540 = 0;
    startup_clock_word_006559e0 = clock_tick;
    application_state_006573e8.word(0x00657424u) = mode;

    ff_init_gain_00657bc8 = 100u;
    ff_init_config_00657be8 = 80u;
    ff_init_config_00657c08 = 75u;
    ff_init_config_00657c28 = 90u;
    ff_init_config_00657c48 = 60u;

    mock_dev_caps[0] = dev_caps0;
    mock_start_seq = 0u;
    mock_start_hrs[0] = 0u; mock_start_hrs[1] = 0u; mock_start_hrs[2] = 0u; mock_start_hrs[3] = 0u;
    mock_acquire_hr = 0u;

    input_slots_006be040[0].device = &kInputDev;
    for (U i = 0u; i < 4u; ++i) {
        frame_control_effects_0069cb10[i].duration_08 = 0xffffffffu;
        frame_control_effects_0069cb10[i].type_bytes_2c = (i == 0u) ? 4u : ((i == 3u) ? 24u : 16u);
        frame_control_effects_0069cb10[i].effect_object_88 = &kMockEffects[i];
        frame_control_effects_0069cb10[i].input_slot_8c = 0;
        const I slot_i = static_cast<I>(i);
        std::memcpy(frame_control_ff_state_005e9408 + 0x18u + i * 2u, &slot_i, 2u);
    }

    const U car_u = static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_car));
    std::memcpy(frame_control_ff_state_005e9408 + 0x04u, &car_u, 0u);
    const U one = 1u;
    std::memcpy(frame_control_ff_state_005e9408 + 0x04u, &one, 4u);
    std::memcpy(frame_control_ff_state_005e9408 + 0x0cu, &car_u, 4u);

    write_f32(mock_car + 0x35cu, spd_mph);
    write_u16(mock_car + 0x418u, static_cast<std::uint16_t>(air_flag));
    write_f32(mock_car + 0x424u, steer_z);
    write_u32(mock_car + 0x464u, gear);
    write_f32(mock_car + 0x4e8u, 2.5f);
    write_f32(mock_car + 0x4e4u, 3.0f);
    write_f32(mock_car + 0x4e8u + 4u, 4.0f);
    write_f32(mock_car + 0x55cu, 1200.0f);
    write_f32(mock_car + 0x560u, -250.0f);
    write_f32(mock_car + 0x564u, 75.0f);
    write_f32(mock_car + 0xd64u, -1.6f);
    write_u32(mock_car + 0xdb0u, off_road);
    write_f32(mock_car + 0xdb4u, rpm);
    write_f32(mock_car + 0x11c0u, 0.25f);

    for (U i = 0u; i < 20u; ++i) {
        const U w_u = static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_wheels[i]));
        write_u32(mock_car + 0x768u + i * 4u, w_u);
        if (i == 0u || i == 2u) {
            write_u16(mock_wheels[i] + 0x26u, 1u);
            write_f32(mock_wheels[i] + 0x60u, 20.0f);
            write_f32(mock_wheels[i] + 0x164u, 5.0f);
            mock_wheels[i][0x48u] = 1u;
            mock_wheels[i][0x4au] = 1u;
        } else if (i == 1u) {
            write_u16(mock_wheels[i] + 0x26u, 9u);
            write_f32(mock_wheels[i] + 0x60u, 10.0f);
            write_f32(mock_wheels[i] + 0x164u, 32.0f);
            mock_wheels[i][0x48u] = 1u;
        }
    }
}

static void snapshot_ff_state() {
    using namespace porsche;
    std::memcpy(trace.ff_state_words, frame_control_ff_state_005e9408, sizeof(frame_control_ff_state_005e9408));
    trace.cooldown = ff_effect_cooldown_005e9540;
    for (U i = 0u; i < 4u; ++i) {
        const auto& e = frame_control_effects_0069cb10[i];
        trace.eff_dur[i] = e.duration_08;
        trace.eff_gain[i] = e.gain_10;
        trace.eff_btn[i] = e.trigger_button_14;
        trace.eff_dir[i] = e.direction_78;
        trace.eff_field80[i] = e.field_80;
        trace.eff_type_bytes[i] = e.type_bytes_2c;
        trace.eff_type_hash[i] = fnv1a(e.type_specific_34, e.type_bytes_2c);
        trace.eff_env_hash[i] = fnv1a(e.spare_64 + 4u, 16u);
    }
}

static void compare_traces() {
    if (trace.abi_fail != 0u) fail("abi");
    if (expected.abi_fail != 0u) fail("abi_exp");
    if (trace.ret != expected.ret) fail("ret");
    if (trace.out_abs != expected.out_abs || trace.out_signed != expected.out_signed) fail("steer_out");
    if (std::memcmp(&trace.out_fp, &expected.out_fp, sizeof(double)) != 0) fail("fp_ret");
    if (trace.count != expected.count) fail("event_count");
    for (U i = 0u; i < trace.count; ++i) {
        if (std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) != 0) {
            fail("event_mismatch");
        }
    }
    if (std::memcmp(trace.ff_state_words, expected.ff_state_words, sizeof(trace.ff_state_words)) != 0) fail("ff_state");
    if (trace.cooldown != expected.cooldown) fail("cooldown");
    if (std::memcmp(trace.eff_dur, expected.eff_dur, sizeof(trace.eff_dur)) != 0) fail("eff_dur");
    if (std::memcmp(trace.eff_gain, expected.eff_gain, sizeof(trace.eff_gain)) != 0) fail("eff_gain");
    if (std::memcmp(trace.eff_btn, expected.eff_btn, sizeof(trace.eff_btn)) != 0) fail("eff_btn");
    if (std::memcmp(trace.eff_dir, expected.eff_dir, sizeof(trace.eff_dir)) != 0) fail("eff_dir");
    if (std::memcmp(trace.eff_field80, expected.eff_field80, sizeof(trace.eff_field80)) != 0) fail("eff_field80");
    if (std::memcmp(trace.eff_type_hash, expected.eff_type_hash, sizeof(trace.eff_type_hash)) != 0) fail("eff_type_hash");
    if (std::memcmp(trace.eff_env_hash, expected.eff_env_hash, sizeof(trace.eff_env_hash)) != 0) fail("eff_env_hash");
    verify_fpu(trace.fp, expected.fp);
}

template <class Setup, class RunOrig, class RunCpp>
static void run_case(Setup setup, RunOrig run_orig, RunCpp run_cpp) {
    ++cases;
    which = 0u;
    std::memset(&trace, 0, sizeof(trace));
    setup();
    run_orig();
    capture_fpu(&trace.fp);
    expected = trace;

    which = 1u;
    std::memset(&trace, 0, sizeof(trace));
    setup();
    run_cpp();
    capture_fpu(&trace.fp);
    compare_traces();
}

int main(int argc, char** argv) {
    verify_pe_data_bytes(argc > 1 ? argv[1] : "local/game/Porsche.exe");
    init_original_code();

    // Case 1: 004123e0 gate checks (car == null, enabled == 0, mode >= 2, gain == 0)
    run_case(
        []() { reset_ff_state(2u, 100u, 0u, 10.0f, 3000.0f, 3u, 1u, 1.0f, 0u); },
        []() { call_x86_0(code + kOff4123E0); snapshot_ff_state(); },
        []() { porsche::ff_effect_frame_tick_004123e0(); snapshot_ff_state(); });

    // Case 2: 004123e0 car[0x424] < 0 -> release rumble & spring + set zeroSpdFlag
    run_case(
        []() {
            reset_ff_state(0u, 100u, 0u, 10.0f, 3000.0f, 3u, 1u, -0.5f, 0u);
            U one = 1u;
            std::memcpy(porsche::frame_control_ff_state_005e9408 + 0x118u, &one, 4u);
            std::memcpy(porsche::frame_control_ff_state_005e9408 + 0x128u, &one, 4u);
        },
        []() { call_x86_0(code + kOff4123E0); snapshot_ff_state(); },
        []() { porsche::ff_effect_frame_tick_004123e0(); snapshot_ff_state(); });

    // Case 3: 004123e0 car[0x418] != 0 -> airborne release & resetFlag=1, then landing triggers collision + cooldown=2
    run_case(
        []() {
            reset_ff_state(0u, 200u, 0x600u, 45.0f, 6500.0f, 3u, 1u, 1.0f, 1u);
            U one = 1u;
            std::memcpy(porsche::frame_control_ff_state_005e9408 + 0x118u, &one, 4u);
            std::memcpy(porsche::frame_control_ff_state_005e9408 + 0x128u, &one, 4u);
        },
        []() {
            call_x86_0(code + kOff4123E0);
            write_u16(mock_car + 0x418u, 0u);
            call_x86_0(code + kOff4123E0);
            snapshot_ff_state();
        },
        []() {
            porsche::ff_effect_frame_tick_004123e0();
            write_u16(mock_car + 0x418u, 0u);
            porsche::ff_effect_frame_tick_004123e0();
            snapshot_ff_state();
        });

    // Case 4: 004123e0 normal driving frame (gear 3, speed 45mph, rpm 6500, off_road=1, timer=1 -> expires, clamp steer high)
    run_case(
        []() {
            reset_ff_state(0u, 300u, 0u, 45.0f, 6500.0f, 3u, 1u, 1.0f, 0u);
            U one = 1u;
            std::memcpy(porsche::frame_control_ff_state_005e9408 + 0x124u, &one, 4u);
            write_f32(mock_car + 0x11c0u, -0.5f); // (-(-0.5))*32500 = +16250 -> clamped to 10000
            write_f32(mock_car + 0x560u, 150.0f); // positive branch
        },
        []() { call_x86_0(code + kOff4123E0); snapshot_ff_state(); },
        []() { porsche::ff_effect_frame_tick_004123e0(); snapshot_ff_state(); });

    // Case 5: 004128b0 gear switch coverage (gears 1, 2, 4, 5, 6, 7, 8, 9, 10, 11, speed < 2mph)
    run_case(
        []() { reset_ff_state(0u, 400u, 0u, 12.0f, 2000.0f, 6u, 1u, 1.0f, 0u); },
        []() {
            const U gears[] = {6u, 1u, 2u, 4u, 5u, 7u, 8u, 9u, 10u, 11u};
            for (U g : gears) {
                write_u32(mock_car + 0x464u, g);
                write_f32(mock_car + 0x35cu, 12.0f + static_cast<float>(g) * 5.0f);
                call_x86_1(code + kOff4128B0, static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_car)));
            }
            snapshot_ff_state();
        },
        []() {
            const U gears[] = {6u, 1u, 2u, 4u, 5u, 7u, 8u, 9u, 10u, 11u};
            for (U g : gears) {
                write_u32(mock_car + 0x464u, g);
                write_f32(mock_car + 0x35cu, 12.0f + static_cast<float>(g) * 5.0f);
                porsche::ff_effect_update_speed_gear_004128b0(mock_car);
            }
            snapshot_ff_state();
        });

    // Case 6: 00533880 retry on 0x80040205 (DIERR_UNPLUGGED) + 0x8007000c + 00533b40 active check
    run_case(
        []() {
            reset_ff_state(0u, 500u, 0u, 20.0f, 3000.0f, 2u, 1u, 1.0f, 0u);
            mock_start_hrs[0] = 0x80040205u;
            mock_start_hrs[1] = 1u;
            mock_acquire_hr = 0u;
            porsche::frame_control_effects_0069cb10[1].duration_08 = 500u;
            porsche::frame_control_effects_0069cb10[1].field_80 = 1u;
        },
        []() {
            const U r1 = call_x86_4(code + kOff533880,
                static_cast<U>(reinterpret_cast<std::uintptr_t>(&kInputDev)),
                static_cast<U>(reinterpret_cast<std::uintptr_t>(&kMockEffects[0])), 1u, 0u);
            const U a0 = call_x86_1(code + kOff533B40, 0u);
            const U a1 = call_x86_1(code + kOff533B40, 1u);
            trace.ret = r1 ^ (a0 << 8u) ^ (a1 << 16u);
            snapshot_ff_state();
        },
        []() {
            const U r1 = porsche::ff_effect_start_retry_00533880(&kInputDev, &kMockEffects[0], 1u, 0u);
            const U a0 = porsche::ff_effect_slot_active_00533b40(0);
            const U a1 = porsche::ff_effect_slot_active_00533b40(1);
            trace.ret = r1 ^ (a0 << 8u) ^ (a1 << 16u);
            snapshot_ff_state();
        });

    // Case 7: 00533810 + 00533910 start_mode=3 + button/duration clamp + 00412730 steer scale + 005a177b VA report
    run_case(
        []() { reset_ff_state(0u, 600u, 0u, 20.0f, 7000.0f, 2u, 1u, 1.0f, 0u); },
        []() {
            U dur = 0x200000u; U gain = 50u; I btn = 3; U dir = 90u;
            U env[4] = {1u, 2u, 3u, 4u}; U ts[4] = {9u, 8u, 7u, 6u};
            porsche::formatter_stdio_printf_005a177b(porsche::startup_audio_heap_fmt_005d1400, 1234u);
            porsche::formatter_stdio_printf_005a177b(porsche::startup_mem_left_fmt_005d6e3c, 5678u);
            call_x86_1(code + kOff533810, 0u);
            call_x86_8(code + kOff533910, 1u, 2u,
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(ts)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&dur)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&gain)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&btn)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&dir)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(env)));
            // Also exercise start_mode=3 on slot 1 via 00533910
            call_x86_8(code + kOff533910, 1u, 3u, 0u, 0u, 0u, 0u, 0u, 0u);
            call_x86_3(code + kOff412730,
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_car)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&trace.out_abs)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&trace.out_signed)));
            snapshot_ff_state();
        },
        []() {
            U dur = 0x200000u; U gain = 50u; I btn = 3; U dir = 90u;
            U env[4] = {1u, 2u, 3u, 4u}; U ts[4] = {9u, 8u, 7u, 6u};
            porsche::startup_sequence_report_005a177b(0x005d1400u, 1234u);
            porsche::startup_sequence_report_005a177b(0x005d6e3cu, 5678u);
            porsche::ff_effect_slot_start_00533810(0);
            porsche::ff_effect_update_params_00533910(1, 2u, ts, &dur, &gain, &btn, &dir, env);
            porsche::ff_effect_update_params_00533910(1, 3u, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr);
            porsche::ff_effect_scale_steer_00412730(mock_car, &trace.out_abs, &trace.out_signed);
            snapshot_ff_state();
        });

    // Case 8: 00412730 clamp high (-0.5f -> 10000) + 00412cf0 long-duration cooldown ((20000<<7)/900000 = 2)
    run_case(
        []() {
            reset_ff_state(0u, 700u, 0x600u, 20.0f, 7000.0f, 2u, 1u, 1.0f, 0u);
            write_f32(mock_car + 0x11c0u, -0.5f);
        },
        []() {
            I dir = 0;
            U dur = 20000u;
            U str = 8000u;
            call_x86_3(code + kOff412CF0,
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&dir)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&dur)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&str)));
            call_x86_3(code + kOff412730,
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_car)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&trace.out_abs)),
                       static_cast<U>(reinterpret_cast<std::uintptr_t>(&trace.out_signed)));
            snapshot_ff_state();
        },
        []() {
            I dir = 0;
            U dur = 20000u;
            U str = 8000u;
            porsche::ff_effect_trigger_collision_00412cf0(&dir, &dur, &str);
            porsche::ff_effect_scale_steer_00412730(mock_car, &trace.out_abs, &trace.out_signed);
            snapshot_ff_state();
        });

    std::printf("ff_effect_frame_tick_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
