static void fail(const char* why) {
    std::printf("ff_effect_frame_tick_original_x86_vs_cpp=FAIL case=%u side=%u reason=%s\n",
                cases, which, why);
    std::exit(1);
}

static void push_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u) {
    if (trace.count >= kMaxEvents) fail("event_overflow");
    trace.events[trace.count++] = Event{tag, a0, a1, a2, a3};
    ++events_total;
}

static U fnv1a(const void* data, std::size_t n) {
    const B* p = static_cast<const B*>(data);
    U h = 2166136261u;
    for (std::size_t i = 0; i < n; ++i) {
        h ^= p[i];
        h *= 16777619u;
    }
    return h;
}

static void capture_fpu(FpuSnapshot* out) {
    std::memset(fp_area, 0, sizeof(fp_area));
    std::memset(fp_env, 0, sizeof(fp_env));
    __asm {
        fnstenv fp_env
        fxsave fp_area
    }
    std::memcpy(&out->control, fp_env + 0, 2);
    std::memcpy(&out->status, fp_env + 4, 2);
    std::memcpy(&out->tag, fp_env + 8, 2);
    out->pad = 0u;
    std::memcpy(out->values, fp_area + 32, 80);
    std::memcpy(&out->mxcsr, fp_area + 24, 4);
}

static void verify_fpu(const FpuSnapshot& a, const FpuSnapshot& b) {
    if (a.control != b.control || a.status != b.status || a.tag != b.tag || a.mxcsr != b.mxcsr) {
        fail("fpu_ctrl");
    }
    if (std::memcmp(a.values, b.values, sizeof(a.values)) != 0) {
        fail("fpu_regs");
    }
}

// Mock COM objects: IDirectInputEffect (slot 6 = SetParameters, slot 7 = Start) + InputDevice (acquire_1c)
struct MockEffectObj {
    void* const* vtable;
    U id;
};
static U mock_start_seq = 0u;
static U mock_start_hrs[4] = {0u, 0u, 0u, 0u};
static U mock_acquire_hr = 0u;
static U mock_dev_caps[4] = {0u, 0u, 0u, 0u};

static std::uint32_t __stdcall mock_eff_set_params(void* self, void* entry_ptr, std::uint32_t flags) {
    auto* eff = static_cast<MockEffectObj*>(self);
    auto* e = static_cast<const porsche::FeEffectEntry*>(entry_ptr);
    push_event(kEvEffectSetParams, eff->id, flags, e->gain_10, static_cast<U>(e->direction_78));
    return 0u;
}

static std::uint32_t __stdcall mock_eff_start(void* self, std::uint32_t iters, std::uint32_t flags) {
    auto* eff = static_cast<MockEffectObj*>(self);
    const U hr = mock_start_hrs[mock_start_seq < 4u ? mock_start_seq++ : 3u];
    push_event(kEvEffectStart, eff->id, iters, flags, hr);
    return hr;
}

static std::uint32_t __stdcall mock_dev_acquire(void* self) {
    (void)self;
    push_event(kEvDevAcquire, mock_acquire_hr);
    return mock_acquire_hr;
}

static void* const kEffectVtable[8] = {
    nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
