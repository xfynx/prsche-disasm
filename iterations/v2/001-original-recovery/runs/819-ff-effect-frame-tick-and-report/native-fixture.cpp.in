static void verify_pe_data_bytes(const char* pe_path) {
    FILE* f = std::fopen(pe_path, "rb");
    if (f == nullptr) fail("open_pe");
    struct Span { U file_off; const void* ptr; U len; };
    const Span spans[] = {
        {0x1d1400u, porsche::startup_audio_heap_fmt_005d1400, 26u},
        {0x1d6e3cu, porsche::startup_mem_left_fmt_005d6e3c, 36u},
        {0x1b23f8u, &kRdata005b23f8, 4u},
        {0x1b2758u, &kRdata005b2758, 4u},
        {0x1b2768u, &kRdata005b2768, 4u},
        {0x1b2770u, &kRdata005b2770, 8u},
        {0x1b2778u, &kRdata005b2778, 8u},
        {0x1b2780u, &kRdata005b2780, 8u},
        {0x1b3284u, &kRdata005b3284, 4u},
    };
    B buf[64];
    for (const auto& sp : spans) {
        std::fseek(f, static_cast<long>(sp.file_off), SEEK_SET);
        if (std::fread(buf, 1, sp.len, f) != sp.len || std::memcmp(buf, sp.ptr, sp.len) != 0) {
            std::fclose(f);
            fail("pe_data_mismatch");
        }
    }
    std::fclose(f);
}

static void init_original_code() {
    kInputVtable.acquire_1c = &mock_dev_acquire;
    code = static_cast<B*>(
        VirtualAlloc(nullptr, kCodeBytes, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    if (code == nullptr) fail("virtualalloc");
    std::memset(code, 0xcc, kCodeBytes);
    std::memcpy(code + kOff4123E0, kBody4123E0, sizeof(kBody4123E0));
    std::memcpy(code + kOff412730, kBody412730, sizeof(kBody412730));
    std::memcpy(code + kOff4127A0, kBody4127A0, sizeof(kBody4127A0));
    std::memcpy(code + kOff4128B0, kBody4128B0, sizeof(kBody4128B0));
    std::memcpy(code + kOff412CF0, kBody412CF0, sizeof(kBody412CF0));
    std::memcpy(code + kOff4938A0, kBody4938A0, sizeof(kBody4938A0));
    std::memcpy(code + kOff493980, kBody493980, sizeof(kBody493980));
    std::memcpy(code + kOff533810, kBody533810, sizeof(kBody533810));
    std::memcpy(code + kOff533880, kBody533880, sizeof(kBody533880));
    std::memcpy(code + kOff533910, kBody533910, sizeof(kBody533910));
    std::memcpy(code + kOff533B40, kBody533B40, sizeof(kBody533B40));

    static const U kJtTargets[11] = {
        0x00412b20u, 0x00412b72u, 0x00412b5cu, 0x00412c03u, 0x00412b67u, 0x00412befu,
        0x00412c0eu, 0x00412c24u, 0x00412c1cu, 0x00412b72u, 0x00412c0eu,
    };
    const U base4128b0 = static_cast<U>(reinterpret_cast<std::uintptr_t>(code + kOff4128B0));
    for (U i = 0u; i < 11u; ++i) {
        kJumpTable412C98[i] = base4128b0 + (kJtTargets[i] - 0x004128b0u);
    }

    for (const auto& r : kRelocs) {
        write_u32(code + r.base + r.off,
                  static_cast<U>(reinterpret_cast<std::uintptr_t>(resolve_global(r.va))));
    }
    for (const auto& c : kCalls) {
        write_rel32(code + c.base + c.off, resolve_callee(c.va));
    }
}

static void call_x86_0(void* fn) {
    U s0 = 0u, s1 = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        call fn
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
}

static U call_x86_1(void* fn, U a0) {
    U s0 = 0u, s1 = 0u, r = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        push a0
        call fn
        add esp, 4
        mov r, eax
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
    return r;
}

static U call_x86_3(void* fn, U a0, U a1, U a2) {
    U s0 = 0u, s1 = 0u, r = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        push a2
        push a1
        push a0
        call fn
        add esp, 12
        mov r, eax
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
    return r;
}

static U call_x86_4(void* fn, U a0, U a1, U a2, U a3) {
    U s0 = 0u, s1 = 0u, r = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        push a3
        push a2
        push a1
        push a0
        call fn
        add esp, 16
