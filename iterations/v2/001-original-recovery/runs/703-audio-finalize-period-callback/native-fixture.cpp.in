#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdio>
#include <cstring>
#include <initializer_list>
#include "audio_finalize_period_703.hpp"

using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;
using namespace porsche;

namespace porsche {
// Fixture-local canonical owners (game build: these live in accepted TUs).
ApplicationAudioDeviceStateStorage application_audio_device_state_006b48c0{};
ApplicationAudioRecord006564a0 application_audio_records_006564a0[8]{};
} // namespace porsche

enum : U { kMaxEvents = 32u, kNameWords = 16u };

enum EventTag : U {
    kBankOpen = 1u, kBankSize = 2u, kAlloc = 3u, kBankCopy = 4u,
    kFree = 5u, kNoop = 6u, kReport = 7u, kLock = 8u, kUnlock = 9u,
    kDsApply = 10u, kPeriodReset = 11u, kPeriodConfigure = 12u,
};

struct StateSnapshot {
    B device[0x18cu];
    B records[8u * 0x10u];
    U slots[3u];
    U target[1u];
};

struct Event {
    U tag, a0, a1, a2;
    U name[kNameWords];
    U detail[kNameWords];
    StateSnapshot state;
};

struct Trace {
    U abi_fail, ret_eax, exception[3], count;
    Event events[kMaxEvents];
    StateSnapshot final_state;
};

static Trace trace{};
static Trace expected{};
static U cases = 0u, events_total = 0u;

// Scenario knobs (harness only, reset before each side of a case).
static U bank_index_scenario = 0u, status_scenario = 7u, size_scenario = 0x40u;
static U copied_size_scenario = 0x10u, kind_scenario = 0u, flags_scenario = 0u;
static U period_scenario = 0u, dev_b_scenario = 0u, dev_c_scenario = 0u;
static U dev_kind_word_scenario = 0u;
static U size_return_count = 0u;
static U alloc_ptr = 0x0a0b0c0du;

static B* code = nullptr;
static B* slot_4a6bc0 = nullptr;
static B* slot_5901b0 = nullptr;

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}
static U word_at(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}
static void put(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}
static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static void capture_state(StateSnapshot& s) {
    std::memcpy(s.device, application_audio_device_state_006b48c0.backing.data(),
                sizeof s.device);
    std::memcpy(s.records, application_audio_records_006564a0, sizeof s.records);
    std::memcpy(s.slots, audio_period_handler_slots_006b16b0, sizeof s.slots);
    std::memcpy(s.target, audio_period_default_target_005e25b0, sizeof s.target);
}

static void record_words(U* dst, const char* text) {
    std::memset(dst, 0, kNameWords * sizeof(U));
    if (text != nullptr) {
        U length = 0u;
        while (length < kNameWords * sizeof(U) && text[length] != '\0') ++length;
        std::memcpy(dst, text, length + 1u);
    }
}

static Event& record_event(U tag, U a0, U a1, U a2) {
    require(trace.count < kMaxEvents, "bounded event count");
    Event& e = trace.events[trace.count++];
    e.tag = tag; e.a0 = a0; e.a1 = a1; e.a2 = a2;
    std::memset(e.name, 0, sizeof e.name);
    std::memset(e.detail, 0, sizeof e.detail);
    capture_state(e.state);
    return e;
}

namespace porsche {

// Controlled bank endpoints. The open endpoint writes the scenario bank index
// through its out pointer, reproducing the original out-parameter contract.
std::int32_t __cdecl audio_bank_open_00565b60(std::uint32_t* out_index,
                                              const void* handle) {
    *out_index = bank_index_scenario;
    Event& e = record_event(kBankOpen, address(handle), bank_index_scenario, 0u);
    (void)e;
    return static_cast<std::int32_t>(status_scenario);
}
std::int32_t __cdecl audio_bank_get_size_00565b30(std::int32_t bank_index) {
    const U size = (size_return_count++ == 0u) ? size_scenario : copied_size_scenario;
    Event& e = record_event(kBankSize, static_cast<U>(bank_index), size, 0u);
    (void)e;
    return static_cast<std::int32_t>(size);
}
std::int32_t __cdecl audio_bank_copy_00565ad0(void* dst_buffer,
                                               std::int32_t bank_index) {
    Event& e = record_event(kBankCopy, address(dst_buffer),
                            static_cast<U>(bank_index), 0u);
    (void)e;
    return 0;
}
void* __cdecl allocate_00531ca0(const char* source, std::int32_t bytes,
                                std::uint32_t heap_index) {
    Event& e = record_event(kAlloc, static_cast<U>(bytes), heap_index, alloc_ptr);
    record_words(e.name, source);
    return reinterpret_cast<void*>(static_cast<std::uintptr_t>(alloc_ptr));
}
std::uint32_t __cdecl free_00531f90(void* allocation) {
    Event& e = record_event(kFree, address(allocation), 0u, 0u);
    (void)e;
    return 0u;
}
void __cdecl startup_service_noop_00516950() {
    record_event(kNoop, 0u, 0u, 0u);
}
void __cdecl render_display_texture_report_005a177b(const char* format,
                                                     std::uint32_t detail) {
    // The stack buffer address differs between original and compiler frames;
    // record stable string contents, never the raw local pointer.
    Event& e = record_event(kReport, 0u, 0u, 0u);
    record_words(e.name, format);
    record_words(e.detail, reinterpret_cast<const char*>(detail));
}
void __cdecl audio_backend_lock_005896d0() {
    record_event(kLock, 0u, 0u, 0u);
}
void __cdecl audio_backend_unlock_005896f0() {
    record_event(kUnlock, 0u, 0u, 0u);
}
std::int32_t __cdecl audio_ds_apply_property_0058e780(std::uint32_t a,
                                                      std::uint32_t b,
                                                      std::uint32_t c) {
    Event& e = record_event(kDsApply, a, b, c);
    (void)e;
    return 0;
}
void __cdecl audio_period_reset_00598e80() {
    record_event(kPeriodReset, 0u, 0u, 0u);
}
void __cdecl audio_period_configure_00598d10(std::uint32_t kind_word,
                                             std::uint32_t target_va) {
    Event& e = record_event(kPeriodConfigure, kind_word, target_va, 0u);
    (void)e;
}

} // namespace porsche

static U invoke_cdecl(void* fn, const U* args, U argc, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ecx, argc
        mov eax, args
        test ecx, ecx
        je call_target
    push_args:
        dec ecx
        push dword ptr [eax + ecx * 4]
        test ecx, ecx
        jne push_args
    call_target:
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov ecx, argc
        lea esp, [esp + ecx * 4]
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        jne bad
        pushfd
        pop eax
        test eax, 400h
        jz done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static int exception_record(EXCEPTION_POINTERS* e) {
    trace.exception[0] = e->ExceptionRecord->ExceptionCode;
    trace.exception[1] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[0]);
    trace.exception[2] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[1]);
    return EXCEPTION_EXECUTE_HANDLER;
}

static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word_at(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}
static void relocate_rel32(B* slot, U slot_va, U off, U expected_target_va,
                           const void* target) {
    require(off >= 1u && (slot[off - 1u] == 0xe8u || slot[off - 1u] == 0xe9u),
            "exact relative call/jump opcode");
    const U actual = slot_va + off + 4u + word_at(slot, off);
    require(actual == expected_target_va, "exact relative relocation target");
    const U next_ip = address(slot + off + 4u);
    put(slot, off, address(target) - next_ip);
}

static void reset_tables() {
    for (U i = 0u; i < sizeof(ApplicationAudioDeviceStateStorage); ++i) {
        application_audio_device_state_006b48c0.preceding_data()[i] =
            static_cast<B>(i * 7u + 3u);
    }
    std::memset(application_audio_records_006564a0, 0,
                sizeof application_audio_records_006564a0);
    std::memset(audio_period_handler_slots_006b16b0, 0,
                sizeof audio_period_handler_slots_006b16b0);
    std::memcpy(audio_period_default_target_005e25b0, "\x46\x58\x00\x00", 4u);
    // 006b4a10 [+0x150], 006b4a14 [+0x154], word 006b48da [+0x1a].
    put(&application_audio_device_state_006b48c0[0x150u], 0u, dev_b_scenario);
    put(&application_audio_device_state_006b48c0[0x154u], 0u, dev_c_scenario);
    {
        U word = dev_kind_word_scenario & 0xffffu;
        std::memcpy(&application_audio_device_state_006b48c0[0x1au], &word, 2u);
    }
    size_return_count = 0u;
}

static void compare_traces(bool check_eax) {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "original ABI");
    require(trace.exception[0] == 0u && expected.exception[0] == 0u, "no exceptions");
    if (check_eax) require(trace.ret_eax == expected.ret_eax, "return value mismatch");
    require(trace.count == expected.count, "event count mismatch");
    for (U i = 0u; i < trace.count && i < kMaxEvents; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "event tag mismatch");
        require(trace.events[i].a0 == expected.events[i].a0, "event a0 mismatch");
        require(trace.events[i].a1 == expected.events[i].a1, "event a1 mismatch");
        require(trace.events[i].a2 == expected.events[i].a2, "event a2 mismatch");
        require(std::memcmp(trace.events[i].name, expected.events[i].name,
                            sizeof trace.events[i].name) == 0, "event name mismatch");
        require(std::memcmp(trace.events[i].detail, expected.events[i].detail,
                            sizeof trace.events[i].detail) == 0, "event detail mismatch");
        require(std::memcmp(&trace.events[i].state, &expected.events[i].state,
                            sizeof(StateSnapshot)) == 0, "event state mismatch");
    }
    require(std::memcmp(&trace.final_state, &expected.final_state,
                        sizeof(StateSnapshot)) == 0, "final state mismatch");
}

static void run_case(void* orig_fn, void* cpp_fn, const U* args, U argc,
                     bool check_eax) {
    ++cases;
    std::memset(&trace, 0, sizeof trace);
    reset_tables();
    __try { trace.abi_fail = invoke_cdecl(orig_fn, args, argc, trace.ret_eax); }
    __except (exception_record(GetExceptionInformation())) {}
    capture_state(trace.final_state);
    expected = trace;

    std::memset(&trace, 0, sizeof trace);
    reset_tables();
    __try { trace.abi_fail = invoke_cdecl(cpp_fn, args, argc, trace.ret_eax); }
    __except (exception_record(GetExceptionInformation())) {}
    capture_state(trace.final_state);
    events_total += trace.count;
    compare_traces(check_eax);
}

static void init() {
    static const B body_4a6bc0[] = {@BODY_004A6BC0@};
    static const B body_5901b0[] = {@BODY_005901B0@};
    static const B str_5d141c[] = {@STR_005D141C@};

    require(sizeof body_4a6bc0 == 193u, "193-byte original body 004a6bc0");
    require(sizeof body_5901b0 == 153u, "153-byte original body 005901b0");
    require(sizeof str_5d141c == 38u, "38-byte original literal 005d141c");
    require(std::memcmp(str_5d141c, audio_bank_add_fail_text_005d141c, 38u) == 0,
            "raw add-fail literal bytes");
    require(std::memcmp(audio_period_default_target_005e25b0,
                        "\x46\x58\x00\x00", 4u) == 0,
            "raw 005e25b0 cell bytes");
    require(audio_period_handler_slots_006b16b0[0] == 0u &&
                audio_period_handler_slots_006b16b0[1] == 0u &&
                audio_period_handler_slots_006b16b0[2] == 0u,
            "initial handler slot state");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                        PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "raw executable allocation");
    slot_4a6bc0 = code + 0u;
    slot_5901b0 = code + 512u;
    std::memcpy(slot_4a6bc0, body_4a6bc0, sizeof body_4a6bc0);
    std::memcpy(slot_5901b0, body_5901b0, sizeof body_5901b0);

    // 004a6bc0: seven relative callees, one literal pointer and three record
    // table displacements.
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x31u, 0x00565b60u,
                   reinterpret_cast<const void*>(&audio_bank_open_00565b60));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x45u, 0x00565b30u,
                   reinterpret_cast<const void*>(&audio_bank_get_size_00565b30));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x4fu, 0x00531ca0u,
                   reinterpret_cast<const void*>(&allocate_00531ca0));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x5cu, 0x00565ad0u,
                   reinterpret_cast<const void*>(&audio_bank_copy_00565ad0));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x62u, 0x00531f90u,
                   reinterpret_cast<const void*>(&free_00531f90));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x6eu, 0x00565b30u,
                   reinterpret_cast<const void*>(&audio_bank_get_size_00565b30));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x88u, 0x00516950u,
                   reinterpret_cast<const void*>(&startup_service_noop_00516950));
    relocate_abs32(slot_4a6bc0, 0x8eu, 0x005d141cu,
                   address(audio_bank_add_fail_text_005d141c));
    relocate_rel32(slot_4a6bc0, 0x004a6bc0u, 0x93u, 0x005a177bu,
                   reinterpret_cast<const void*>(&render_display_texture_report_005a177b));
    relocate_abs32(slot_4a6bc0, 0xa7u, 0x006564a0u,
                   address(application_audio_records_006564a0));
    relocate_abs32(slot_4a6bc0, 0xb1u, 0x006564a8u,
                   address(application_audio_records_006564a0) + 8u);
    relocate_abs32(slot_4a6bc0, 0xb7u, 0x006564acu,
                   address(application_audio_records_006564a0) + 0x0cu);

    // 005901b0: device-state cells, handler-slot displacements, the opaque
    // default target address, and five relative callees. The stored handler
    // constants 0x00598a70/0x00598a90/0x00598ae0 are data constants on both
    // sides and are deliberately NOT relocated.
    relocate_rel32(slot_5901b0, 0x005901b0u, 0x03u, 0x005896d0u,
                   reinterpret_cast<const void*>(&audio_backend_lock_005896d0));
    relocate_abs32(slot_5901b0, 0x15u, 0x006b4a14u,
                   address(&application_audio_device_state_006b48c0[0x154u]));
    relocate_abs32(slot_5901b0, 0x1bu, 0x006b4a10u,
                   address(&application_audio_device_state_006b48c0[0x150u]));
    relocate_rel32(slot_5901b0, 0x005901b0u, 0x23u, 0x0058e780u,
                   reinterpret_cast<const void*>(&audio_ds_apply_property_0058e780));
    relocate_abs32(slot_5901b0, 0x36u, 0x006b16b0u,
                   address(&audio_period_handler_slots_006b16b0[0]));
    relocate_abs32(slot_5901b0, 0x3bu, 0x006b16b4u,
                   address(&audio_period_handler_slots_006b16b0[1]));
    relocate_abs32(slot_5901b0, 0x40u, 0x006b16b8u,
                   address(&audio_period_handler_slots_006b16b0[2]));
    relocate_rel32(slot_5901b0, 0x005901b0u, 0x45u, 0x00598e80u,
                   reinterpret_cast<const void*>(&audio_period_reset_00598e80));
    relocate_rel32(slot_5901b0, 0x005901b0u, 0x4au, 0x005896f0u,
                   reinterpret_cast<const void*>(&audio_backend_unlock_005896f0));
    relocate_abs32(slot_5901b0, 0x52u, 0x006b4a10u,
                   address(&application_audio_device_state_006b48c0[0x150u]));
    relocate_abs32(slot_5901b0, 0x5cu, 0x005e25b0u,
                   address(audio_period_default_target_005e25b0));
    relocate_abs32(slot_5901b0, 0x66u, 0x006b48dau,
                   address(&application_audio_device_state_006b48c0[0x1au]));
    relocate_rel32(slot_5901b0, 0x005901b0u, 0x6cu, 0x00598d10u,
                   reinterpret_cast<const void*>(&audio_period_configure_00598d10));
    relocate_abs32(slot_5901b0, 0x75u, 0x006b16b0u,
                   address(&audio_period_handler_slots_006b16b0[0]));
    relocate_abs32(slot_5901b0, 0x7fu, 0x006b16b4u,
                   address(&audio_period_handler_slots_006b16b0[1]));
    relocate_abs32(slot_5901b0, 0x89u, 0x006b16b8u,
                   address(&audio_period_handler_slots_006b16b0[2]));
    relocate_rel32(slot_5901b0, 0x005901b0u, 0x92u, 0x005896f0u,
                   reinterpret_cast<const void*>(&audio_backend_unlock_005896f0));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0,
            "instruction cache");
}

int main() {
    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
    SetUnhandledExceptionFilter([](EXCEPTION_POINTERS* p) -> LONG {
        std::printf("divergence fault=%08lx eip=%p case=%u\n",
                    p->ExceptionRecord->ExceptionCode,
                    p->ExceptionRecord->ExceptionAddress, cases);
        std::fflush(stdout);
        ExitProcess(1);
        return EXCEPTION_EXECUTE_HANDLER;
    });
    init();

    static const char* const texts[] = {
        "", "a", "bank", "C:\\GAMES\\bank", "\\rooted", "a\\b\\c",
        "trailing\\", "sample",
    };
    U args4[4] = {};
    // Kind 0: 004a6bc0 differential.
    for (const char* text : texts) {
        for (U st : {0u, 7u, 8u, 9u, 0xffffffffu}) {
            for (U bi : {0u, 1u, 7u}) {
                for (U k : {0u, 1u, 7u}) {
                    for (I br : {0, 1, 0x40, -7}) {
                        bank_index_scenario = bi;
                        status_scenario = st;
                        kind_scenario = k;
                        args4[0] = address(text);
                        args4[1] = static_cast<U>(br);
                        args4[2] = 0x1111u;
                        args4[3] = k;
                        run_case(slot_4a6bc0,
                                 reinterpret_cast<void*>(
                                     &audio_bank_finalize_004a6bc0),
                                 args4, 4u, true);
                    }
                }
            }
        }
    }

    // Kind 1: 005901b0 differential. Low-byte flag combinations, period values,
    // device word/halfword and the side-effect probe are swept.
    U args2[2] = {};
    for (U fl : {0u, 0x20u, 0x80u, 0xa0u, 0x01u, 0xffu}) {
        for (U per : {0u, 1u, 2u, 0xffffffffu}) {
            for (U b : {0u, 0x1234u, 0xfffffff0u}) {
                for (U c : {0u, 0x5678u}) {
                    for (U w : {0u, 0x00ffu}) {
                        flags_scenario = fl;
                        period_scenario = per;
                        dev_b_scenario = b;
                        dev_c_scenario = c;
                        dev_kind_word_scenario = w;
                        args2[0] = fl;
                        args2[1] = per;
                        run_case(slot_5901b0,
                                 reinterpret_cast<void*>(
                                     &audio_period_callback_005901b0),
                                 args2, 2u, false);
                    }
                }
            }
        }
    }

    std::printf("audio_finalize_period_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
