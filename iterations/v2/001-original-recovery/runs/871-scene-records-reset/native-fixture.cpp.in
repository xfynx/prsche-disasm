void reset(unsigned scenario) {
    mode=scenario;event_count=random_index=0;
    std::memset(events,0,sizeof events);
    for(unsigned j=0;j<2;++j) {
        for(U i=0;i<records[j].size();++i) records[j][i]=static_cast<B>(i*13+j*29+scenario);
        // Disjoint normal emitter records; only the documented prefix is used.
        samples[j]=from_bits((scenario%11==10) ? 0x7fc12345u : bits(float(int((scenario+j*3)%9)-3)*0.25f));
        put(records[j].data(),0,bits(scenario%3==0 ? samples[j] : -7.0f));
        put(records[j].data(),8,(scenario%4==0) ? 3 : 0);
        put(records[j].data(),0x862c,bits(float((scenario%5)+1)*4.0f));
        const U off[]={0x860c,0x8618,0x8628,0x8604,0x8610,0x861c};
        const float vals[]={1.25f,-3.5f,0.0f,-10.0f,0.03125f,123.75f};
        for(U i=0;i<6;++i) put(records[j].data(),off[i],bits(vals[i]+float(j)));
    }
    stage[0]=0xabcdef01;stage[1]=reinterpret_cast<U>(records[0].data());
    stage[2]=reinterpret_cast<U>(records[(scenario&16) ? 0 : 1].data());stage[3]=0x12340000;
    scene_stage_58b80_00627e08=stage;
    second_session_random_state_005ceae0=0x87654321u+scenario*997u;
    second_session_random_multiplier_005ceae4=(scenario&1) ? 0xffffcd15u : 0x075bcd15u;
}
void sample80(Sampler fn, void* record, void* output) {
    __asm {
        mov ecx, record
        call fn
        mov eax, output
        fstp tbyte ptr [eax]
    }
}
void check_samplers(unsigned scenario) {
    const Sampler candidates[]={scene_record_sample_00459510,scene_record_sample_00459560,scene_record_sample_004595b0};
    for (unsigned j=0;j<3;++j) {
        reset(scenario);
        // Include fractional products beyond binary64 precision after adding the offset.
        const U scale[]={0x860c,0x8618,0x8628}, base[]={0x8604,0x8610,0x861c};
        put(records[0].data(),scale[j],0x45800001+scenario);
        put(records[0].data(),base[j],0x21ffffff+scenario);
        const auto seed=second_session_random_state_005ceae0;
        std::array<B,10> expected{},actual{};
        sample80(original_sampler[j],records[0].data(),expected.data());
        auto next=second_session_random_state_005ceae0;
        second_session_random_state_005ceae0=seed;
        sample80(candidates[j],records[0].data(),actual.data());
        require(expected==actual && next==second_session_random_state_005ceae0,"ST0 and RNG");
        ++cases;
    }
}
void invoke(Parent f) {
    U before,after,bs,saved_esi,saved_edi;
    __asm { mov before,esp }
    __asm { push ebx }
    __asm { push esi }
    __asm { push edi }
    __asm { mov ebx,0x11223344 }
    __asm { mov esi,0x55667788 }
    __asm { mov edi,0x12345678 }
    __asm { call f }
    __asm { mov bs,ebx }
    __asm { mov saved_esi,esi }
    __asm { mov saved_edi,edi }
    __asm { pop edi }
    __asm { pop esi }
    __asm { pop ebx }
    __asm { mov after,esp }
    require(before==after && bs==0x11223344 && saved_esi==0x55667788 && saved_edi==0x12345678,"cdecl ABI");
}
void check(Parent oracle,U scenario) {
    reset(scenario);invoke(oracle);
    const auto first=records[0],second=records[1];
    const U seed=second_session_random_state_005ceae0;
    U expected_events[32];std::memcpy(expected_events,events,sizeof events);
    const U expected_count=event_count,expected_random=random_index;
    reset(scenario);invoke(session_scene_records_reset_00459260);
    require(records[0]==first && records[1]==second,"all record bytes including gaps");
    require(stage[0]==0 && seed==second_session_random_state_005ceae0,"stage and random state");
    require(expected_count==event_count && expected_random==random_index && std::memcmp(events,expected_events,sizeof events)==0,"call order and arguments");
    ++cases;
}
