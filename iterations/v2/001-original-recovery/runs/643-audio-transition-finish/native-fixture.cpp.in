    I start_ret;
    U locate_switch_root_on_out;
    U ramp_switch_root;
    U volume_switch_root;
    U entry_count_mode; // 0 = normal names, 1 = alt names (only "*-" matches)
};

static ScenarioCfg cfg{};
static U prng_idx = 0u;
static U tick_idx = 0u;

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u cpp=%u\n", msg, cases, static_cast<U>(cpp_side));
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_root_ptr(U p) {
    if (p == 0u) return 0u;
    if (p == address(root_a_buf)) return 0xa0000001u;
    if (p == address(root_b_buf)) return 0xa0000002u;
    const U base_a = address(root_a_buf);
    if (p > base_a && p < base_a + sizeof(root_a_buf)) {
        return 0xa1000000u + (p - base_a);
    }
    const U base_b = address(root_b_buf);
    if (p > base_b && p < base_b + sizeof(root_b_buf)) {
        return 0xa2000000u + (p - base_b);
    }
    return p;
}

static void record_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u,
                         const char* s0 = nullptr, const char* s1 = nullptr) {
    require(trace.count < 600u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    if (s0 != nullptr) {
        std::strncpy(e.s0, s0, sizeof(e.s0) - 1u);
    }
    if (s1 != nullptr) {
        std::strncpy(e.s1, s1, sizeof(e.s1) - 1u);
    }
}

static bool wildcard_match_ci(const char* text, const char* pat) {
    if (*pat == '\0') {
        return *text == '\0';
    }
    if (*pat == '*') {
        if (wildcard_match_ci(text, pat + 1)) {
            return true;
        }
        return (*text != '\0') && wildcard_match_ci(text + 1, pat);
    }
    if (*pat == '?') {
        return (*text != '\0') && wildcard_match_ci(text + 1, pat + 1);
    }
    auto lower_ch = [](char c) -> char {
        return (c >= 'A' && c <= 'Z') ? static_cast<char>(c + 32) : c;
    };
    return (*text != '\0') && (lower_ch(*text) == lower_ch(*pat)) &&
           wildcard_match_ci(text + 1, pat + 1);
}

static const char* const kEntryNames[8] = {
    "menu_loop",
    "race_fast",
    "trk-boss",
    "trk-menu",
    "sfx_hit",
    "win_fanfare",
    "trk-win",
    "end_credits",
};

namespace porsche {

ApplicationStateArena application_state_006573e8{};
std::uint32_t audio_resource_query_root_00656ab4 = 0u;

std::uint32_t& ApplicationStateArena::word(std::uint32_t va) {
    require(va >= application_state_base_va, "arena va low");
    const std::size_t off = static_cast<std::size_t>(va - application_state_base_va);
    require(off + 4u <= application_state_bytes && (off % 4u) == 0u, "arena va bounds");
    return words_[off / 4u];
}

std::uint32_t __cdecl audio_resource_locate_005666f0(
    std::uint32_t source, std::uint32_t name, std::uint32_t index,
    std::uint32_t out1, std::uint32_t out2) {
    record_event(kEvLocate, source, name, index, out1 != 0u ? 1u : 0u);
    if (out1 != 0u) {
        U* const out_ptr = reinterpret_cast<U*>(static_cast<std::uintptr_t>(out1));
        const U prev_val = *out_ptr;
        record_event(kEvLocate, 0xeeeeeeeeu, prev_val, out2, 0u);
        *out_ptr = 0x400u + (index & 0xffu);
        if (cfg.locate_switch_root_on_out != 0u) {
            audio_resource_query_root_00656ab4 = address(root_b_buf);
        }
        return 0x22000000u + (source ^ index);
    }
    const char* entry = kEntryNames[index % 8u];
    return address(entry);
}

std::uint32_t __cdecl audio_transition_pattern_match_004a5f90(
    const char* text, char* pattern) {
    require(text != nullptr && pattern != nullptr, "pattern match non-null");
    const char saved0 = pattern[0];
    pattern[0] = saved0; // Assert writable pattern buffer.
    const U res = wildcard_match_ci(text, pattern) ? 1u : 0u;
    record_event(kEvPatMatch, res, 0u, 0u, 0u, text, pattern);
    return res;
}

std::int32_t __cdecl formatter_entry_raw_005a0fbf(
    char* output, const char* format, const std::uint32_t* raw_arguments) {
    require(output != nullptr && format != nullptr && raw_arguments != nullptr, "formatter non-null");
    const char* arg = reinterpret_cast<const char*>(static_cast<std::uintptr_t>(raw_arguments[0]));
    const int n = std::snprintf(output, 128u, format, arg);
    record_event(kEvFormat, static_cast<U>(n), 0u, 0u, 0u, format, output);
    return static_cast<std::int32_t>(n);
}

std::uint32_t __cdecl render_seed_prng_next_00538040() {
    const U v = cfg.prng_seq[prng_idx % cfg.prng_len];
    ++prng_idx;
    record_event(kEvPrng, v);
    return v;
}

std::uint32_t __stdcall platform_get_tick_count() {
    const U v = cfg.tick_seq[tick_idx % cfg.tick_len];
    ++tick_idx;
    record_event(kEvTick, v);
    return v;
}

std::int32_t __cdecl audio_stream_service_ramp_00566ae0(
    std::int32_t slot, std::int32_t ms, std::int32_t target) {
    record_event(kEvRamp, static_cast<U>(slot), static_cast<U>(ms), static_cast<U>(target));
    if (cfg.ramp_switch_root != 0u) {
        audio_resource_query_root_00656ab4 = address(root_b_buf);
    }
    return 0;
}

std::int32_t __cdecl audio_stream_service_volume_00567810(
    std::int32_t slot, std::uint32_t volume) {
    record_event(kEvVolume, static_cast<U>(slot), volume);
    if (cfg.volume_switch_root != 0u) {
        audio_resource_query_root_00656ab4 = address(root_b_buf);
    }
    return 0;
}

std::int32_t __cdecl audio_stream_service_status_00567850(std::int32_t slot) {
    record_event(kEvStatus, static_cast<U>(slot), static_cast<U>(cfg.status_ret));
    return cfg.status_ret;
}

std::int32_t __cdecl audio_service_stream_start_00567720(
    std::uint32_t channel, std::uint32_t mode,
    std::uint32_t data, std::uint32_t size) {
    record_event(kEvStreamStart, channel, mode, normalize_root_ptr(data), size);
    return cfg.start_ret;
}

std::uint32_t __cdecl frame_services_boundary_004ae3c0(std::uint32_t zero) {
    record_event(kEvBoundary4ae3c0, zero);
    return audio_resource_query_root_00656ab4;
}

