using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static_assert(sizeof(porsche::audio_transition_wildcard_fmt_005d1c1c) == 5u,
              "5-byte wildcard format string");
static_assert(sizeof(porsche::audio_transition_word_0065b928) == 4u,
              "4-byte transition override word");

static U address(const void* p) { return static_cast<U>(reinterpret_cast<std::uintptr_t>(p)); }
static U word(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}
static void put(void* p, U o, U v) { std::memcpy(static_cast<B*>(p) + o, &v, 4u); }

static B root_a_buf[0x200] = {};
static B root_b_buf[0x200] = {};
static char pattern_buf[128] = {};
alignas(16) static B floating[512] = {};

static U cases = 0u;
static bool cpp_side = false;

static B* code = nullptr;
static B* slot_4ae4d0 = nullptr;
static B* slot_4ae8c0 = nullptr;
static U iat_get_tick_count = 0u;

enum EventTag : U {
    kEvLocate = 1u,
    kEvPatMatch = 2u,
    kEvFormat = 3u,
    kEvPrng = 4u,
    kEvTick = 5u,
    kEvRamp = 6u,
    kEvVolume = 7u,
    kEvStreamStart = 8u,
    kEvStatus = 9u,
    kEvBoundary4ae3c0 = 10u,
};

struct Event {
    U tag;
    U a0;
    U a1;
    U a2;
    U a3;
    char s0[64];
    char s1[80];
};

struct Fpu {
    unsigned short control, status;
    B tag, padding[3], values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U exception[3];
    U count;
    Event events[600];
    B final_root_a[0x200];
    B final_root_b[0x200];
    U final_root_ptr;
    U final_word_65b928;
    U final_word_657a5c;
    B final_fmt_5d1c1c[5];
    char final_pattern[128];
    Fpu fpu;
};

static Trace trace{};
static Trace expected{};

struct ScenarioCfg {
    U prng_seq[8];
    U prng_len;
    U tick_seq[8];
    U tick_len;
