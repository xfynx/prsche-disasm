static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u kind=%u\n", why, cases, side, kind);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static LONG WINAPI fault(EXCEPTION_POINTERS* info) {
    std::printf("divergence native-fault %08lx case=%u side=%u kind=%u\n",
                info->ExceptionRecord->ExceptionCode, cases, side, kind);
    std::fflush(stdout);
    ExitProcess(7);
    return EXCEPTION_CONTINUE_SEARCH;
}

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* p, U offset = 0u) {
    U value = 0u;
    std::memcpy(&value, static_cast<const B*>(p) + offset, sizeof value);
    return value;
}

static void store32(void* p, U offset, U value) {
    std::memcpy(static_cast<B*>(p) + offset, &value, sizeof value);
}

static void push_event(U event_kind, U a, U b = 0u, U c = 0u) {
    require(event_count < kMaxEvents, "event bound");
    events[event_count++] = Event{event_kind, a, b, c};
}

static U count_state(I state) {
    U count = 0u;
    for (const auto& entry : porsche::frame_control_effects_0069cb10) {
        if (entry.input_slot_8c == state) {
            ++count;
        }
    }
    return count;
}

static U __stdcall effect_release_08(void* raw) {
    auto* const effect = static_cast<MockEffect*>(raw);
    const auto& entry = porsche::frame_control_effects_0069cb10[effect->id & 31u];
    push_event(kEvRelease08, effect->id, entry.field_80,
               static_cast<U>(entry.input_slot_8c));
    return 0x08000000u | effect->id;
}

static U __stdcall effect_release_20(void* raw) {
    auto* const effect = static_cast<MockEffect*>(raw);
    auto& entry = porsche::frame_control_effects_0069cb10[effect->id & 31u];
    push_event(kEvRelease20, effect->id, entry.field_80,
               static_cast<U>(entry.input_slot_8c));
    if (callback_mode == 1u) {
        entry.field_80 = 0xf00d0000u | effect->id;
        entry.input_slot_8c = static_cast<I>((effect->id + 3u) & 31u);
    }
    return 0x20000000u | effect->id;
}

static U __stdcall effect_download_28(void* raw) {
    auto* const effect = static_cast<MockEffect*>(raw);
    const U call = download_calls++;
    push_event(kEvDownload28, effect->id, call);
    if (callback_mode == 2u && call == 0u) {
        return 0x8007000cu;
    }
    return 0x28000000u | effect->id;
}

static U __stdcall effect_unload_2c(void* raw) {
    auto* const effect = static_cast<MockEffect*>(raw);
    push_event(kEvUnload2c, effect->id);
    return 0x2c000000u | effect->id;
}

static U __stdcall device_acquire(void* raw) {
    auto* const device = static_cast<MockDevice*>(raw);
    push_event(kEvAcquire, device->id);
    return callback_mode == 2u ? 1u : 0u;
}

static U __stdcall device_ff_command(void* raw, U command) {
    auto* const device = static_cast<MockDevice*>(raw);
    push_event(kEvFfCommand, device->id, command, count_state(static_cast<I>(device->id)));
    if (command == 2u && callback_mode == 1u) {
        porsche::frame_control_effects_0069cb10[31].field_80 = 0xfeed0031u;
    }
    if (command == 1u && callback_mode == 1u) {
        porsche::frame_control_effects_0069cb10[31].input_slot_8c =
            static_cast<I>(device->id);
        porsche::frame_control_effects_0069cb10[31].effect_object_88 = &effects[31];
    }
    return 0x60000000u | (command << 8u) | device->id;
}

static U __stdcall device_create_effect(void* raw, const void*, void* descriptor,
                                        void** out_effect, void*) {
    auto* const device = static_cast<MockDevice*>(raw);
    const U delta = address(descriptor) - address(porsche::frame_control_effects_0069cb10);
    require(delta % 0x90u == 0u && delta / 0x90u < 32u, "create descriptor record");
    const U record = delta / 0x90u;
    push_event(kEvCreate48, device->id, record);
    *out_effect = &effects[record];
    return 0u;
}

