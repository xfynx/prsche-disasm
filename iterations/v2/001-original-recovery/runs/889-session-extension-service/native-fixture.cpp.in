struct CaseSpec {
    I player_count;
    U player_flags[kMaxPlayers];
    std::int16_t player_ids[kMaxPlayers];
    U g657414;
    U g6573f0;
    I tick_rate;
    float rate_scale;
    U oom_main_mask;
    U oom_pool_mask;
};

static void setup_state(const CaseSpec& cs) {
    std::memset(g_players, 0x11, sizeof(g_players));
    std::memset(g_main_arena, 0x22, sizeof(g_main_arena));
    std::memset(g_pool_arena, 0x33, sizeof(g_pool_arena));
    std::memset(g_reset_obj, 0x44, sizeof(g_reset_obj));
    std::memcpy(g_reset_obj + 4, &cs.rate_scale, sizeof(cs.rate_scale));
    porsche::session_reset_object_005e752c =
        reinterpret_cast<porsche::SessionResetObject0040e3b0*>(g_reset_obj);
    porsche::global_00657414 = cs.g657414;
    porsche::global_006573f0 = cs.g6573f0;
    porsche::session_extension_tick_rate_005e7540 = cs.tick_rate;
    porsche::session_extension_any_mode20_005e67a0 = 0xdeadbeefu;
    porsche::application_active_player_count_005e8b58 = cs.player_count;
    for (U i = 0u; i < kMaxPlayers; ++i) {
        std::memcpy(g_players[i] + 0x08u, &cs.player_ids[i], sizeof(cs.player_ids[i]));
        std::memcpy(g_players[i] + 0x52cu, &cs.player_flags[i], sizeof(cs.player_flags[i]));
        g_players[i][0x7fu] = 0u;
        porsche::application_player_object_table_005e8b34[i] = fn_addr(g_players[i]);
        porsche::session_player_extension_slots_005e6774[i] =
            reinterpret_cast<void*>(static_cast<std::uintptr_t>(0xfeed0000u + i));
    }
    g_main_next = 0u;
    g_pool_next = 0u;
    g_main_alloc_call = 0u;
    g_pool_alloc_call = 0u;
    g_oom_main_mask = cs.oom_main_mask;
    g_oom_pool_mask = cs.oom_pool_mask;
}

static void canonicalize_obj(B* buf, U words) {
    for (U w = 0u; w < words; ++w) {
        U val = 0u;
        std::memcpy(&val, buf + w * 4u, 4u);
        const U c = canonical_ptr(reinterpret_cast<const void*>(static_cast<std::uintptr_t>(val)));
        std::memcpy(buf + w * 4u, &c, 4u);
    }
}

static void capture_snap(Snapshot& s, U ret_val) {
    s.ret = ret_val;
    s.active_count = static_cast<U>(porsche::application_active_player_count_005e8b58);
    s.any_mode20 = porsche::session_extension_any_mode20_005e67a0;
    for (U i = 0u; i < kMaxPlayers; ++i) {
        s.slots[i] = canonical_ptr(porsche::session_player_extension_slots_005e6774[i]);
    }
    std::memcpy(s.players, g_players, sizeof(g_players));
    std::memcpy(s.main_arena, g_main_arena, sizeof(g_main_arena));
    std::memcpy(s.pool_arena, g_pool_arena, sizeof(g_pool_arena));
    for (U i = 0u; i < kMaxMainObjs; ++i) {
        canonicalize_obj(s.main_arena[i], kMainObjSize / 4u);
    }
    for (U i = 0u; i < kMaxPoolObjs; ++i) {
        canonicalize_obj(s.pool_arena[i], kPoolObjSize / 4u);
    }
    s.log = (active_side == 0u) ? g_orig_log : g_cpp_log;
}

static void fail(const char* label, const char* detail) {
    std::printf("session_extension_service_original_x86_vs_cpp=FAIL (%s: %s)\n", label, detail);
    std::exit(1);
}

static void compare_snaps(const char* label) {
    if (g_orig_snap.ret != g_cpp_snap.ret) fail(label, "ret");
    if (g_orig_snap.active_count != g_cpp_snap.active_count) fail(label, "active_count");
    if (g_orig_snap.any_mode20 != g_cpp_snap.any_mode20) fail(label, "any_mode20");
    if (std::memcmp(g_orig_snap.slots, g_cpp_snap.slots, sizeof(g_orig_snap.slots)) != 0) fail(label, "slots");
    if (std::memcmp(g_orig_snap.players, g_cpp_snap.players, sizeof(g_orig_snap.players)) != 0) fail(label, "players");
    if (std::memcmp(g_orig_snap.main_arena, g_cpp_snap.main_arena, sizeof(g_orig_snap.main_arena)) != 0) fail(label, "main_arena");
    if (std::memcmp(g_orig_snap.pool_arena, g_cpp_snap.pool_arena, sizeof(g_orig_snap.pool_arena)) != 0) fail(label, "pool_arena");
    if (g_orig_snap.log.count != g_cpp_snap.log.count ||
        std::memcmp(g_orig_snap.log.op, g_cpp_snap.log.op, g_orig_snap.log.count * sizeof(U)) != 0 ||
        std::memcmp(g_orig_snap.log.val, g_cpp_snap.log.val, g_orig_snap.log.count * sizeof(U)) != 0) {
        fail(label, "log");
    }
    ++cases;
}

using VoidFn = void(__cdecl*)();
using Ctor1Fn = void*(__fastcall*)(void*, void*, void*);
using Ctor2Fn = void*(__fastcall*)(void*, void*, void*, U);
using DtorFn = void*(__fastcall*)(void*, void*, U);
using FiniFn = void(__fastcall*)(void*, void*);
using Slot2Fn = U(__fastcall*)(void*, void*);

static void run_service_and_teardown(const char* label, const CaseSpec& cs, U dtor_flags) {
    // Pass 1: verify constructed state immediately after 00406520 (all vtables & fields intact).
    for (U side = 0u; side < 2u; ++side) {
        active_side = side;
        if (side == 0u) g_orig_log.count = 0u;
        else g_cpp_log.count = 0u;
        setup_state(cs);
        if (side == 0u) {
            reinterpret_cast<VoidFn>(code + kSlot406520)();
        } else {
            porsche::session_extension_service_00406520();
        }
        capture_snap((side == 0u) ? g_orig_snap : g_cpp_snap, 0u);
    }
    compare_snaps(label);

    // Pass 2: verify constructed + vtable[1] / helper vtable[2] teardown behavior.
    for (U side = 0u; side < 2u; ++side) {
        active_side = side;
        if (side == 0u) g_orig_log.count = 0u;
        else g_cpp_log.count = 0u;
        setup_state(cs);
        if (side == 0u) {
            reinterpret_cast<VoidFn>(code + kSlot406520)();
        } else {
            porsche::session_extension_service_00406520();
        }
        for (I i = 0; i < cs.player_count; ++i) {
            void* const ext = porsche::session_player_extension_slots_005e6774[i];
            if (ext != nullptr) {
                void* sub = nullptr;
                std::memcpy(&sub, static_cast<const B*>(ext) + 8u, sizeof(sub));
                if (sub != nullptr) {
                    const auto* const svt = *static_cast<const U* const*>(sub);
                    (void)reinterpret_cast<Slot2Fn>(svt[2])(sub, nullptr);
                }
                const auto* const vt = *static_cast<const U* const*>(ext);
                reinterpret_cast<DtorFn>(vt[1])(ext, nullptr, dtor_flags);
            }
        }
        capture_snap((side == 0u) ? g_orig_snap : g_cpp_snap, 0u);
    }
    compare_snaps(label);
}

static void run_direct_tests() {
    CaseSpec base{};
    base.player_count = 1;
    base.player_ids[0] = -3;
    base.player_flags[0] = 0x40u;
    base.g657414 = 1u;
    base.g6573f0 = 2u;
    base.tick_rate = 190;
    base.rate_scale = 2.5f;

    // Test 00406790 replacing an existing non-null subobject at +0x08.
    for (U side = 0u; side < 2u; ++side) {
        active_side = side;
        if (side == 0u) g_orig_log.count = 0u;
        else g_cpp_log.count = 0u;
        setup_state(base);
        void* const obj = g_main_arena[15];
        void* const old_sub = g_pool_arena[15];
        std::memset(obj, 0xaa, 0x20u);
        std::memset(old_sub, 0xbb, 8u);
        const U old_vt = fn_addr((side == 0u) ? static_cast<const void*>(orig_vt_005b2500)
                                              : static_cast<const void*>(porsche::session_extension_vtable_005b2500));
        std::memcpy(old_sub, &old_vt, 4u);
        std::memcpy(static_cast<B*>(old_sub) + 4u, &porsche::application_player_object_table_005e8b34[0], 4u);
        std::memcpy(static_cast<B*>(obj) + 8u, &old_sub, 4u);
        void* ret = nullptr;
        if (side == 0u) {
            ret = reinterpret_cast<Ctor1Fn>(code + kSlot406790)(obj, nullptr, g_players[0]);
        } else {
            ret = porsche::session_extension_base_ctor_00406790(obj, nullptr, g_players[0]);
        }
        capture_snap((side == 0u) ? g_orig_snap : g_cpp_snap, canonical_ptr(ret));
    }
    compare_snaps("direct_406790_replace");

    // Test 00406840 directly with null +0x08 and non-null +0x08, and 00406800 flags=0/1.
    for (U has_sub = 0u; has_sub < 2u; ++has_sub) {
        for (U side = 0u; side < 2u; ++side) {
            active_side = side;
            if (side == 0u) g_orig_log.count = 0u;
            else g_cpp_log.count = 0u;
            setup_state(base);
            void* const obj = g_main_arena[14];
            if (has_sub != 0u) {
                if (side == 0u) reinterpret_cast<Ctor1Fn>(code + kSlot406790)(obj, nullptr, g_players[0]);
                else porsche::session_extension_base_ctor_00406790(obj, nullptr, g_players[0]);
            } else {
                std::memset(obj, 0, 0x18u);
            }
            if (side == 0u) reinterpret_cast<FiniFn>(code + kSlot406840)(obj, nullptr);
            else porsche::session_extension_base_fini_00406840(obj, nullptr);
            capture_snap((side == 0u) ? g_orig_snap : g_cpp_snap, 0u);
        }
        compare_snaps(has_sub ? "direct_406840_nonnull" : "direct_406840_null");
    }

    // Test 00403d80 directly.
    for (U side = 0u; side < 2u; ++side) {
        active_side = side;
        if (side == 0u) g_orig_log.count = 0u;
        else g_cpp_log.count = 0u;
        setup_state(base);
        const U r = (side == 0u)
            ? reinterpret_cast<Slot2Fn>(code + kSlot403D80)(g_pool_arena[0], nullptr)
            : porsche::session_extension_helper_slot2_00403d80(g_pool_arena[0], nullptr);
        capture_snap((side == 0u) ? g_orig_snap : g_cpp_snap, r);
    }
    compare_snaps("direct_403d80");
}

int main() {
    init_code();

    // 1. Zero active players.
    {
        CaseSpec cs{};
        cs.player_count = 0;
        run_service_and_teardown("zero_players", cs, 1u);
    }

    // 2. Single-flag branch coverage across all 5 branches + tick modes + flag 0x40 + OOM.
    const U branch_flags[] = {0x04u, 0x08u, 0x10u, 0x20u, 0x60u, 0x00u, 0x40u};
    const U mode657414[] = {0u, 1u};
    const U mode6573f0[] = {0u, 2u, 4u, 7u};
    const I tick_rates[] = {0, 1, 5, 190, -15};

    for (U bi = 0u; bi < sizeof(branch_flags) / sizeof(branch_flags[0]); ++bi) {
        for (U g14 : mode657414) {
            for (U g3f0 : mode6573f0) {
                CaseSpec cs{};
                cs.player_count = 1;
                cs.player_flags[0] = branch_flags[bi];
                cs.player_ids[0] = static_cast<std::int16_t>(bi - 2);
                cs.g657414 = g14;
                cs.g6573f0 = g3f0;
                cs.tick_rate = tick_rates[bi % 5u];
                cs.rate_scale = 1.75f;
                run_service_and_teardown("single_branch", cs, (bi & 1u) ? 1u : 0u);
            }
        }
    }

    // 3. Multi-player mixed flags (hits all 5 branches + multiple mode20 indices + pool/main OOM).
    {
        CaseSpec cs{};
        cs.player_count = 7;
        cs.player_flags[0] = 0x04u;
        cs.player_flags[1] = 0x20u;
        cs.player_flags[2] = 0x08u;
        cs.player_flags[3] = 0x10u;
        cs.player_flags[4] = 0x00u;
        cs.player_flags[5] = 0x60u;
        cs.player_flags[6] = 0x04u | 0x08u; // precedence: 0x04 before 0x08
        for (I i = 0; i < 7; ++i) cs.player_ids[i] = static_cast<std::int16_t>(100 + i);
        cs.g657414 = 1u;
        cs.g6573f0 = 2u;
        cs.tick_rate = 190;
        cs.rate_scale = 3.25f;
        run_service_and_teardown("mixed_7players", cs, 1u);

        cs.oom_main_mask = (1u << 1) | (1u << 4);
        cs.oom_pool_mask = (1u << 2);
        run_service_and_teardown("mixed_7players_oom", cs, 1u);

        // Single mode20 whose alloc fails -> any_mode20 stays 0; then succeeds -> any_mode20 = 1.
        CaseSpec cs2{};
        cs2.player_count = 2;
        cs2.player_flags[0] = 0x20u;
        cs2.player_flags[1] = 0x00u;
        cs2.player_ids[0] = 7;
        cs2.player_ids[1] = 8;
        cs2.oom_main_mask = 1u << 0;
        run_service_and_teardown("mode20_oom", cs2, 1u);
    }

    run_direct_tests();

    std::printf("session_extension_service_original_x86_vs_cpp=PASS cases=%u events=%u\n", cases, events_total);
    return 0;
}
