static void patch_rel(U slot, U offset, const void* target) {
    const std::intptr_t disp =
        reinterpret_cast<std::intptr_t>(target) -
        reinterpret_cast<std::intptr_t>(code + slot + offset + 4u);
    const auto rel = static_cast<std::int32_t>(disp);
    std::memcpy(code + slot + offset, &rel, 4u);
}

static void patch_abs(U slot, U offset, const void* target) {
    const U addr = static_cast<U>(reinterpret_cast<std::uintptr_t>(target));
    std::memcpy(code + slot + offset, &addr, 4u);
}

static U fn_addr(const void* fn) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(fn));
}

