void __cdecl session_extension_clear_0040b490() {
    record_event(1u, 0u);
}

void* __cdecl session_extension_allocate_0040b530(std::uint32_t size) {
    const U call_idx = g_pool_alloc_call++;
    if ((g_oom_pool_mask & (1u << (call_idx & 31u))) != 0u) {
        record_event(4u, 0xffffffffu);
        return nullptr;
    }
    const U idx = g_pool_next++;
    if (idx >= kMaxPoolObjs || size > kPoolObjSize) {
        std::abort();
    }
    std::memset(g_pool_arena[idx], 0xcd, kPoolObjSize);
    record_event(4u, (size << 16) | idx);
    return g_pool_arena[idx];
}

void __cdecl session_extension_release_0040b570(void* pointer) {
    const U idx = arena_index(pointer, &g_pool_arena[0][0], kPoolObjSize, kMaxPoolObjs);
    record_event(5u, idx);
}

void* __cdecl startup_network_allocate_0059ef90(std::uint32_t size) {
    const U call_idx = g_main_alloc_call++;
    if ((g_oom_main_mask & (1u << (call_idx & 31u))) != 0u) {
        record_event(2u, 0xffffffffu);
        return nullptr;
    }
    const U idx = g_main_next++;
    if (idx >= kMaxMainObjs || size > kMainObjSize) {
        std::abort();
    }
    std::memset(g_main_arena[idx], 0xa5, kMainObjSize);
    record_event(2u, (size << 16) | idx);
    return g_main_arena[idx];
}

std::uint32_t __cdecl application_release_0059f050(void* address) {
    const U idx = arena_index(address, &g_main_arena[0][0], kMainObjSize, kMaxMainObjs);
    record_event(3u, idx);
    return 1u;
}

