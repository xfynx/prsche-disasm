static U vtable_tag(U v) {
    if (v == fn_addr(orig_vt_005b25b0) || v == fn_addr(porsche::session_extension_vtable_005b25b0)) return 1u;
    if (v == fn_addr(orig_vt_005b25a0) || v == fn_addr(porsche::session_extension_vtable_005b25a0)) return 2u;
    if (v == fn_addr(orig_vt_005b2594) || v == fn_addr(porsche::session_extension_vtable_005b2594)) return 3u;
    if (v == fn_addr(orig_vt_005b2500) || v == fn_addr(porsche::session_extension_vtable_005b2500)) return 4u;
    if (v == fn_addr(orig_vt_005b2544) || v == fn_addr(porsche::session_extension_vtable_005b2544)) return 5u;
    if (v == fn_addr(orig_vt_005b2560) || v == fn_addr(porsche::session_extension_vtable_005b2560)) return 6u;
    if (v == fn_addr(orig_vt_005b2588) || v == fn_addr(porsche::session_extension_vtable_005b2588)) return 7u;
    if (v == fn_addr(orig_vt_005b2510) || v == fn_addr(porsche::session_extension_vtable_005b2510)) return 8u;
    if (v == fn_addr(orig_vt_005b2570) || v == fn_addr(porsche::session_extension_vtable_005b2570)) return 9u;
    if (v == fn_addr(orig_vt_005b24d0) || v == fn_addr(porsche::session_extension_vtable_005b24d0)) return 10u;
    if (v == fn_addr(orig_vt_005b24b0) || v == fn_addr(porsche::session_extension_vtable_005b24b0)) return 11u;
    return v;
}

static U canonical_ptr(const void* p) {
    if (!p) return 0u;
    const U v = fn_addr(p);
    const U vt = vtable_tag(v);
    if (vt != v) return 0x80000000u | vt;
    const U pi = arena_index(p, &g_players[0][0], kPlayerSize, kMaxPlayers);
    if (pi != 0xffffffffu) return 0x81000000u | pi;
    const U mi = arena_index(p, &g_main_arena[0][0], kMainObjSize, kMaxMainObjs);
    if (mi != 0xffffffffu) return 0x82000000u | mi;
    const U qi = arena_index(p, &g_pool_arena[0][0], kPoolObjSize, kMaxPoolObjs);
    if (qi != 0xffffffffu) return 0x83000000u | qi;
    if (p == &porsche::session_extension_mode_table_005cbd20[0]) return 0x84000000u;
    if (p == porsche::session_extension_mode_table_005cbd20[0].items) return 0x85000000u;
    return v;
}

