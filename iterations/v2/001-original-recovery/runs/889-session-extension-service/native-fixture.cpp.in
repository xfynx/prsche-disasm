struct EventLog {
    U count;
    U op[kMaxEvents];
    U val[kMaxEvents];
};

static EventLog g_orig_log{};
static EventLog g_cpp_log{};

static void record_event(U op, U val) {
    EventLog& log = (active_side == 0u) ? g_orig_log : g_cpp_log;
    if (log.count < kMaxEvents) {
        log.op[log.count] = op;
        log.val[log.count] = val;
    }
    ++log.count;
    ++events_total;
}

static U arena_index(const void* p, const B* base, U stride, U count) {
    const auto addr = reinterpret_cast<std::uintptr_t>(p);
    const auto baddr = reinterpret_cast<std::uintptr_t>(base);
    if (addr >= baddr && addr < baddr + static_cast<std::uintptr_t>(stride * count)) {
        const auto diff = static_cast<U>(addr - baddr);
        if ((diff % stride) == 0u) {
            return diff / stride;
        }
    }
    return 0xffffffffu;
}

