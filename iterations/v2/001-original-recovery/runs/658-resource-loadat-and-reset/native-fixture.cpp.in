int main() {
    init();

    // 1. Direct 00561e90 coverage: max_bytes clamping (<=0 -> 0x7fffffff vs >0),
    //    open success/failure, diag_flag 0/1/nonzero, mid-call context & handle mutations,
    //    signed/unsigned read counts.
    for (U max_b : {0u, 1u, 16u, 0x7fffffffu, 0x80000000u, 0xffffffffu}) {
        for (bool open_ok : {false, true}) {
            for (U diag_flag : {0u, 1u, 2u}) {
                CaseEnv c{};
                c.group = 0x64u;
                c.open_ok = open_ok;
                c.handle_val = 0x12340001u;
                c.read_ret = (max_b == 16u) ? 0x80000010u : 12u;
                c.mutate_ctx_in_open = open_ok && (max_b == 1u);
                c.mutate_handle_in_read = open_ok && (max_b == 16u);
                check_561e90(c, 0x64u, "data\\stream.abk", address(load_buffer), max_b, diag_flag);
            }
        }
    }

    // 2. Direct 00561e40 and 00561f20 coverage: passthrough and end-to-end callback execution,
    //    plus group reload ordering across file_device_name_00568e90.
    for (bool invoke_cb : {false, true}) {
        for (bool open_ok : {false, true}) {
            for (bool mutate_grp : {false, true}) {
                CaseEnv c{};
                c.group = 0x44u;
                c.invoke_callback = invoke_cb;
                c.atomic_ret = 0xdead0042u;
                c.mutate_group_in_device = mutate_grp;
                c.open_ok = open_ok;
                c.handle_val = 0x22220001u;
                c.read_ret = 24u;
                check_561e40(c, "art\\hud.fsh", load_buffer, 0u);
                check_561f20(c, "art\\hud.fsh", load_buffer, 32u);
            }
        }
    }

    // 3. Direct and end-to-end 0059db50 coverage: unrooted lengths 0..15, primary hit,
    //    fallback hit, empty fallback, both miss with/without missing_file_006afbe4,
    //    and mid-call mutation of missing_file_006afbe4.
    {
        const char* names[] = {"", "a", "ab", "abc", "abcd", "sfx\\menu.bnk"};
        for (const char* nm : names) {
            CaseEnv c{};
            c.group = 0x64u;
            c.invoke_callback = true;
            c.open_ok = true;
            c.handle_val = 0x33330001u;
            c.read_ret = 8u;
            c.roots_enabled = false;
            check_59db50(c, nm, load_buffer, 8u);
        }

        for (U mask : {0u, 1u, 2u, 3u}) {
            for (const char* fb : {"", "F:\\"}) {
                for (bool mutate : {false, true}) {
                    for (auto cb :
                         {static_cast<void(__cdecl*)(const char*, std::int32_t)>(nullptr),
                          &fixture_missing_a}) {
                        CaseEnv c{};
                        c.group = 0x77u;
                        c.invoke_callback = true;
                        c.open_ok = (mask != 0u);
                        c.handle_val = 0x44440001u;
                        c.read_ret = 16u;
                        c.roots_enabled = true;
                        c.root_path = "P:\\";
                        c.fallback_path = fb;
                        c.exists_mask = mask;
                        c.mutate_missing = mutate;
                        c.missing_cb = cb;
                        check_59db50(c, "menu.bnk", load_buffer, 0u);
                    }
                }
            }
        }
    }

    // 4. Direct 00566880 coverage: kind 0, 1, 2, 3, 0xffffffff.
    for (U kind : {0u, 1u, 2u, 3u, 0xffffffffu}) {
        CaseEnv c{};
        c.audio_kind = kind;
        c.read_be_ret = (kind == 1u) ? 0x1234u : 0x89abcdefu;
        check_566880(c, address(audio_source_arena));
    }

    // 5. Direct 004adf50 coverage: full 512B arena comparison with distinct seed patterns.
    for (B seed_xor : {B(0x00u), B(0x5au), B(0xa5u)}) {
        CaseEnv c{};
        c.query_seed_xor = seed_xor;
        check_4adf50(c);
    }

    std::printf("resource_loadat_and_reset_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
