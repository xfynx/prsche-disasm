        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_ptr(U p) {
    if (p == 0u) return 0u;
    if (p >= address(load_buffer) && p < address(load_buffer) + sizeof(load_buffer)) {
        return 0xa1000000u + (p - address(load_buffer));
    }
    if (p >= address(audio_source_arena) &&
        p < address(audio_source_arena) + sizeof(audio_source_arena)) {
        return 0xa2000000u + (p - address(audio_source_arena));
    }
    if (p >= address(query_root_arena) &&
        p < address(query_root_arena) + sizeof(query_root_arena)) {
        return 0xa3000000u + (p - address(query_root_arena));
    }
    if (last_atomic_ctx != nullptr && p == address(last_atomic_ctx)) {
        return 0xa4000000u;
    }
    return p;
}

static void copy_text(char* dst, std::size_t cap, const char* src) {
    if (src == nullptr) {
        std::snprintf(dst, cap, "<null>");
        return;
    }
    std::snprintf(dst, cap, "%s", src);
}

static Event& push_event(
    U tag,
    U a0 = 0u,
    U a1 = 0u,
    U a2 = 0u,
    U a3 = 0u,
    U a4 = 0u,
    const char* text = nullptr) {
    require(trace.count < 24u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    e.a4 = a4;
    if (text != nullptr) {
        copy_text(e.text, sizeof(e.text), text);
    }
    return e;
}

