    setup_env(c);
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl3(slot_561e40, address(path), address(buf), max_bytes, eax_orig);
    trace.ret_eax = eax_orig;
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
