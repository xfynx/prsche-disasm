static void check_4adf50(const CaseEnv& c) {
    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(slot_4adf50);
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(c);
    seed_fpu();
    trace.abi_fail = invoke_cdecl0(
        reinterpret_cast<void*>(&porsche::audio_resource_query_root_reset_004adf50));
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
