        reinterpret_cast<const void*>(&porsche::render_descriptor_read_be_0056e290));
    relocate_rel32(
        slot_566880, 0x00566880u, 0x02fu, 0x0056e290u,
        reinterpret_cast<const void*>(&porsche::render_descriptor_read_be_0056e290));

    // Relocate 004adf50.
    for (const U off : {0x002u, 0x010u, 0x01cu, 0x025u, 0x02eu, 0x037u, 0x040u, 0x048u, 0x051u,
                        0x05au, 0x063u, 0x06cu, 0x075u, 0x07eu, 0x087u, 0x090u, 0x09cu}) {
        relocate_abs32(
            slot_4adf50, off, 0x00656ab4u, address(&porsche::audio_resource_query_root_00656ab4));
    }
}

struct CaseEnv {
    U group;
    bool invoke_callback;
    U atomic_ret;
    bool mutate_group_in_device;
    bool open_ok;
    U handle_val;
    U read_ret;
    bool mutate_ctx_in_open;
    bool mutate_handle_in_read;
    bool roots_enabled;
    const char* root_path;
    const char* fallback_path;
    U exists_mask;
    bool mutate_missing;
    void(__cdecl* missing_cb)(const char*, std::int32_t);
    U audio_kind;
    U read_be_ret;
    B query_seed_xor;
};

static void setup_env(const CaseEnv& c) {
    std::memset(&trace, 0, sizeof trace);
    for (U i = 0u; i < sizeof(load_buffer); ++i) {
        load_buffer[i] = static_cast<B>(i ^ 0x3cu);
    }
    for (U i = 0u; i < sizeof(audio_source_arena); ++i) {
        audio_source_arena[i] = static_cast<B>(i ^ 0x55u);
    }
    for (U i = 0u; i < sizeof(query_root_arena); ++i) {
        query_root_arena[i] = static_cast<B>((i ^ c.query_seed_xor) | 1u);
    }

    porsche::resource_leaf_group_005df770 = c.group;
    porsche::file_roots_enabled_006af370 = c.roots_enabled ? 1 : 0;
    std::memset(porsche::file_root_006af168, 0, sizeof porsche::file_root_006af168);
    std::memset(porsche::file_fallback_006af26c, 0, sizeof porsche::file_fallback_006af26c);
    if (c.root_path != nullptr) {
        std::snprintf(
            porsche::file_root_006af168, sizeof porsche::file_root_006af168, "%s", c.root_path);
    }
    if (c.fallback_path != nullptr) {
        std::snprintf(
            porsche::file_fallback_006af26c,
            sizeof porsche::file_fallback_006af26c,
            "%s",
            c.fallback_path);
    }
    porsche::missing_file_006afbe4 = c.missing_cb;
    porsche::audio_resource_query_root_00656ab4 = address(query_root_arena);
    porsche::diagnostic_handler_005debf0 = &porsche::diagnostic_entry_658;
    porsche::shared_runtime_word_005deb74 = 0u;
    porsche::diagnostic_line_005deb78 = 0u;

    last_handle_slot = nullptr;
    last_atomic_ctx = nullptr;
    stub_cfg = {};
    stub_cfg.group = c.group;
    stub_cfg.invoke_callback = c.invoke_callback;
    stub_cfg.atomic_ret = c.atomic_ret;
    stub_cfg.mutate_group_in_device = c.mutate_group_in_device;
    stub_cfg.open_ok = c.open_ok;
    stub_cfg.handle_val = c.handle_val;
    stub_cfg.read_ret = c.read_ret;
    stub_cfg.mutate_ctx_in_open = c.mutate_ctx_in_open;
    stub_cfg.mutate_handle_in_read = c.mutate_handle_in_read;
    stub_cfg.exists_mask = c.exists_mask;
    stub_cfg.mutate_missing_on_exists = c.mutate_missing;
    stub_cfg.audio_kind = c.audio_kind;
    stub_cfg.read_be_ret = c.read_be_ret;
}

static void capture_state() {
    std::memcpy(trace.final_load_buf, load_buffer, sizeof trace.final_load_buf);
    std::memcpy(trace.final_query_root, query_root_arena, sizeof trace.final_query_root);
    const char* const src = porsche::diagnostic_file_005deb74();
    trace.final_diag_file_ok =
        (src != nullptr && std::strcmp(src, orig_str_5bcd00) == 0) ? 1u : 0u;
    trace.final_diag_line = porsche::diagnostic_line_005deb78;
    trace.final_group = porsche::resource_leaf_group_005df770;
    trace.final_missing_cb = normalize_missing_cb(porsche::missing_file_006afbe4);
}

static void compare_traces() {
    require(trace.abi_fail == 0u, "original ABI");
    require(expected.abi_fail == 0u, "recovered ABI");
    require(trace.ret_eax == expected.ret_eax, "return value");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "event tag");
        require(trace.events[i].a0 == expected.events[i].a0, "event a0");
        require(trace.events[i].a1 == expected.events[i].a1, "event a1");
        require(trace.events[i].a2 == expected.events[i].a2, "event a2");
        require(trace.events[i].a3 == expected.events[i].a3, "event a3");
        require(trace.events[i].a4 == expected.events[i].a4, "event a4");
        require(std::strcmp(trace.events[i].text, expected.events[i].text) == 0, "event text");
    }
    require(
        std::memcmp(trace.final_load_buf, expected.final_load_buf, sizeof trace.final_load_buf) == 0,
        "load buffer");
    require(
        std::memcmp(
            trace.final_query_root, expected.final_query_root, sizeof trace.final_query_root) == 0,
        "query root memory");
    require(trace.final_diag_file_ok == expected.final_diag_file_ok, "005deb74");
    require(trace.final_diag_line == expected.final_diag_line, "005deb78");
    require(trace.final_group == expected.final_group, "005df770");
    require(trace.final_missing_cb == expected.final_missing_cb, "006afbe4");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof trace.fpu) == 0, "FPU state");
    ++cases;
}

static void check_561e90(
    const CaseEnv& c, U group, const char* path, U buffer_addr, U max_bytes, U diag_flag) {
    porsche::ResourceAtomicContext ctx{path, buffer_addr, max_bytes, diag_flag};
    setup_env(c);
    last_atomic_ctx = &ctx;
    seed_fpu();
    U eax_orig = 0u;
    trace.abi_fail = invoke_cdecl2(slot_561e90, group, address(&ctx), eax_orig);
    trace.ret_eax = eax_orig;
    capture_state();
    capture_fpu(trace.fpu);
    expected = trace;

    ctx = {path, buffer_addr, max_bytes, diag_flag};
    setup_env(c);
    last_atomic_ctx = &ctx;
    seed_fpu();
    U eax_cpp = 0u;
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::file_loadat_callback_00561e90),
        group,
        address(&ctx),
        eax_cpp);
    trace.ret_eax = eax_cpp;
    capture_state();
    capture_fpu(trace.fpu);
    std::swap(trace, expected);
    compare_traces();
}

