static void base() {
    memset(&initial,0x5a,sizeof(initial));
    for(U t=0;t<2;++t) for(U i=0;i<512;++i) {
        initial.groups[t][i].header=ptr(work.headers[t][i]);
        put(initial.headers[t][i]+6,static_cast<std::uint16_t>(i+t*0x8000));
    }
    for(U t=0;t<2;++t) for(U i=0;i<8;++i) {
        put(initial.channels[t][i],0x81000000u+t*0x100u+i);
        initial.channels[t][i][0xe]=2;
        initial.channels[t][i][0xf]=0; // active byte is not consulted.
    }
    put(initial.physical+0x10+0x18,std::uint16_t{3});
    put(initial.physical+0x10+0xe4,std::int16_t{3});
    put(initial.physical+0x10+0x140,ptr(work.channels[0]));
    put(initial.physical+0x10+0x144,ptr(group_base(0)));
    initial.physical[0x10+0xdc]=1;
