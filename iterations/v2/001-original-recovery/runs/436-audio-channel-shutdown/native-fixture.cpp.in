static bool init_slab() {
    slab=static_cast<std::uint8_t*>(VirtualAlloc(nullptr,4096,MEM_COMMIT|MEM_RESERVE,PAGE_EXECUTE_READWRITE));
    if(!slab) return false;
    static const std::uint8_t raw[]={ @BODY_005659f0@ };
    memcpy(slab,raw,sizeof(raw));
    struct Abs { U offset,va,state_offset; };
    const Abs absolute[]={ {1,0x6b499c,0xdc},{0x21,0x6b48d8,0x18},{0x2e,0x6b48d8,0x18},
        {0x61,0x6b4a04,0x144},{0x73,0x6b49a4,0xe4},{0x7e,0x6b4a00,0x140},
        {0x98,0x6b4a00,0x140},{0xa2,0x6b49a4,0xe4},{0xc1,0x6b4a04,0x144} };
    for (const auto& a:absolute) {
        if(get<U>(slab+a.offset)!=a.va) return false;
        put(slab+a.offset,ptr(application_audio_device_state_006b48c0.data()+a.state_offset));
    }
    struct Rel { U offset,va; const void* target; };
    const Rel relative[]={ {0x28,0x5659f0,slab},
        {0x45,0x590070,reinterpret_cast<const void*>(&application_audio_validate_channel_00590070)},
        {0x5a,0x5896d0,reinterpret_cast<const void*>(&audio_backend_lock_005896d0)},
        {0x92,0x565d60,reinterpret_cast<const void*>(&audio_channel_stop_00565d60)},
        {0xbb,0x565990,reinterpret_cast<const void*>(&application_audio_release_group_00565990)},
        {0xd4,0x5896f0,reinterpret_cast<const void*>(&audio_backend_unlock_005896f0)} };
    for (const auto& r:relative) {
        if(slab[r.offset]!=0xe8 || 0x5659f0+r.offset+5+get<U>(slab+r.offset+1)!=r.va) return false;
        put(slab+r.offset+1,ptr(r.target)-ptr(slab+r.offset+5));
    }
    return FlushInstructionCache(GetCurrentProcess(),slab,sizeof(raw))!=0;
}
// Explicit cdecl call with preserved-register and stack checks. Setup/push/call
// are harness code; the copied 223 bytes are the complete unmodified body.
static __declspec(noinline) I invoke(Fn fn,I argument) {
    U before,after,result_bx,result_si,result_di,bp_before,bp_after; I result;
    __asm {
        mov before,esp
        mov bp_before,ebp
        mov ebx,0x13579bdf
        mov esi,0x2468ace0
        mov edi,0x55aa33cc
        mov eax,fn
        push argument
        call eax
        add esp,4
        mov result,eax
        mov after,esp
        mov result_bx,ebx
        mov result_si,esi
        mov result_di,edi
        mov bp_after,ebp
    }
    if(before!=after || result_bx!=0x13579bdf || result_si!=0x2468ace0 || result_di!=0x55aa33cc || bp_before!=bp_after) abi_ok=false;
    return result;
}
static I __cdecl facade_call(I index) { application_audio_shutdown_channels_005659f0(index); return 0x12345678; }
static void load() {
    work=initial;
    stable_hash=2166136261u;
    for (U i=0;i<sizeof(work);++i) { stable_hash ^= reinterpret_cast<std::uint8_t*>(&work)[i]; stable_hash*=16777619u; }
    memcpy(application_audio_device_state_006b48c0.backing.data(),work.physical,sizeof(work.physical));
    memcpy(audio_backend_lock_cs_006b1800,work.cs,sizeof(work.cs));
    trace_count=stop_calls=validate_calls=release_calls=0;
}
static void save(Scene& out) {
    memcpy(work.physical,application_audio_device_state_006b48c0.backing.data(),sizeof(work.physical));
    memcpy(work.cs,audio_backend_lock_cs_006b1800,sizeof(work.cs));
