}
int main() {
    // Observe production initialization before any synthetic reset.
    for(auto b:application_audio_device_state_006b48c0.backing) if(b) return 2;
    for(U i=0;i<24;++i) if(audio_backend_lock_cs_006b1800[i]) return 2;
    if(ptr(&audio_backend_channel_count_006b49a4)!=ptr(application_audio_device_state_006b48c0.data()+0xe4) ||
       ptr(&audio_backend_channels_006b4a00)!=ptr(application_audio_device_state_006b48c0.data()+0x140) ||
       ptr(&audio_backend_lock_depth_006b499f)!=ptr(application_audio_device_state_006b48c0.data()+0xdf)) return 2;
    if(!init_slab()) return 3;
    for(U active: {0u,1u,0x80u,0xffu}) for(I arg: {-1,0,2,127,128,255,-2,-128}) {
        base(); initial.physical[0x10+0xdc]=static_cast<std::uint8_t>(active);
        input=arg; reject_all=true;
