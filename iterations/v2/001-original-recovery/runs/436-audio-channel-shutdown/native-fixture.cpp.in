    }
    for(std::int16_t channels: {std::int16_t{-32768},std::int16_t{-1},std::int16_t{0},std::int16_t{1},std::int16_t{3}})
        for(U depth: {0u,1u,255u}) for(U f:{0u,1u}) {
            base(); put(initial.physical+0x10+0xe4,channels); initial.physical[0x10+0xdf]=static_cast<std::uint8_t>(depth);
            facade=f!=0; if(!check("count-depth-facade")) return 1;
        }
    for(I group: {-128,-2,0,2,127,128,255}) {
        base(); input=group;
        for(U i=0;i<8;++i) initial.channels[0][i][0xe]=static_cast<std::uint8_t>(group);
        if(!check("signed-group-byte")) return 1;
    }
    for(U mutation=1;mutation<=6;++mutation) for(U fire:{1u,2u}) {
        base(); mode=mutation; threshold=fire;
        if(!check("child-state-change")) return 1;
    }
    base(); mode=13; if(!check("lock-before-capture")) return 1;
    // No-match records must advance; count is checked after every record.
    base(); initial.channels[0][0][0xe]=1; initial.channels[0][1][0xe]=1;
    if(!check("skip-to-final")) return 1;
    for(U mutation=7;mutation<=12;++mutation) {
        base(); input=-1; mode=mutation; if(!check("recursive-state-change")) return 1;
    }
    for(std::uint16_t groups: {std::uint16_t{0},std::uint16_t{1},std::uint16_t{3},std::uint16_t{0x8000},std::uint16_t{0xffff}}) {
        base(); input=-1; reject_all=true; put(initial.physical+0x10+0x18,groups);
        if(!check("unsigned-group-count")) return 1;
    }
    base(); input=-1; if(!check("recursive-release-errors-ignored")) return 1;
    base(); input=-1; facade=true; if(!check("recursive-facade")) return 1;
    printf("audio_shutdown_original_x86_vs_cpp=PASS cases=%u abi=PASS\n",cases);
