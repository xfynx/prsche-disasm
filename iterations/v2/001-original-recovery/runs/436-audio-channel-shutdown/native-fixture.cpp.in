static U cases;
static bool check(const char* name) {
    load(); I ro=invoke(reinterpret_cast<Fn>(slab),input);
    if(facade) ro=0x12345678;
    save(output_o); count_o=trace_count; memcpy(trace_o,trace,trace_count*sizeof(Event));
    load(); I rc=invoke(facade ? facade_call : application_audio_stop_channel_005659f0,input);
    save(output_c);
    ++cases;
    if(!abi_ok || ro!=rc || count_o!=trace_count || memcmp(trace_o,trace,trace_count*sizeof(Event)) || memcmp(&output_o,&output_c,sizeof(Scene))) {
        printf("divergence %s input=%d mode=%u original=%d cpp=%d traces=%u/%u abi=%u\n",name,input,mode,ro,rc,count_o,trace_count,abi_ok);
        return false;
