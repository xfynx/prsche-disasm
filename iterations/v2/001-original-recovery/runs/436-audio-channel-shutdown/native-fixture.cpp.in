namespace porsche {
void __stdcall platform_initialize_critical_section(void* p) { rec(1,ptr(p)); }
void __stdcall platform_delete_critical_section(void* p) { rec(2,ptr(p)); }
void __stdcall platform_enter_critical_section(void* p) {
