                  reinterpret_cast<const void*>(&porsche::render_seed_prng_next_00538040));
    relocate_call(slot_4ad9c0, 0x425u, 0x004adde5u, 0x00567810u,
                  reinterpret_cast<const void*>(&porsche::audio_stream_service_volume_00567810));
    relocate_call(slot_4ad9c0, 0x438u, 0x004addf8u, 0x004ad8b0u,
                  reinterpret_cast<const void*>(&porsche::audio_service_play_004ad8b0));
}

static void compare_traces(bool check_ret_lo, bool check_ret_hi) {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "abi");
    if (check_ret_lo) {
        require(trace.ret_lo == expected.ret_lo, "ret_lo");
    }
    if (check_ret_hi) {
        require(trace.ret_hi == expected.ret_hi, "ret_hi");
    }
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) == 0, "event");
    }
    require(std::memcmp(trace.final_root_a, expected.final_root_a, sizeof(trace.final_root_a)) == 0,
            "final_root_a");
    require(std::memcmp(trace.final_root_b, expected.final_root_b, sizeof(trace.final_root_b)) == 0,
            "final_root_b");
    require(std::memcmp(trace.final_split, expected.final_split, sizeof(trace.final_split)) == 0,
            "final_split");
    require(std::memcmp(trace.final_out_words, expected.final_out_words,
                        sizeof(trace.final_out_words)) == 0,
            "final_out_words");
    require(trace.final_root_ptr == expected.final_root_ptr, "final_root_ptr");
    require(std::memcmp(&trace.fpu, &expected.fpu, sizeof(Fpu)) == 0, "fpu");
}

static void snapshot_trace() {
    std::memcpy(trace.final_root_a, root_a_buf, sizeof(root_a_buf));
    std::memcpy(trace.final_root_b, root_b_buf, sizeof(root_b_buf));
    std::memcpy(trace.final_split, split_buf, sizeof(split_buf));
    std::memcpy(trace.final_out_words, out_words, sizeof(out_words));
    trace.final_root_ptr = normalize_root_ptr(porsche::audio_resource_query_root_00656ab4);
}

static void reset_env(const ScenarioCfg& c) {
    cfg = c;
    prng_idx = 0u;
    tick_idx = 0u;
    std::memset(&trace, 0, sizeof(trace));
    std::memset(root_a_buf, 0xaa, sizeof(root_a_buf));
    std::memset(root_b_buf, 0xbb, sizeof(root_b_buf));
    std::memset(chan_buf, 0xcc, sizeof(chan_buf));
    std::memset(entries_buf, 0xdd, sizeof(entries_buf));
    std::memset(slot_rec_buf, 0xee, sizeof(slot_rec_buf));
    std::memset(split_buf, 0x77, sizeof(split_buf));
    std::memset(out_words, 0x55, sizeof(out_words));
    std::memset(tag_buf, 0, sizeof(tag_buf));
    std::memset(porsche::audio_stream_slots_006b7cc0, 0, sizeof(porsche::audio_stream_slots_006b7cc0));
    porsche::application_audio_device_state_006b48c0.backing.fill(0u);
    porsche::audio_resource_query_root_00656ab4 = address(root_a_buf);
}

static ScenarioCfg default_cfg() {
    ScenarioCfg c{};
    c.window_active = 1u;
    c.lookup_null = 0u;
    c.status_ret = 0;
    c.start_ret = 0x42;
    c.end_4ad6c0_ret = 0x11223344u;
    c.locate_ret = 0x55667788u;
    c.locate_size = 0x9000u;
    c.prng_seq[0] = 0x11u;
    c.prng_seq[1] = 0x22u;
    c.prng_len = 2u;
    c.tick_seq[0] = 0x100u;
    c.tick_seq[1] = 0x200u;
    c.tick_len = 2u;
    return c;
}

static void test_mul64(U a, U b) {
    ++cases;
    auto run_one = [&](bool use_cpp) {
        cpp_side = use_cpp;
        reset_env(default_cfg());
        void* fn = use_cpp
            ? reinterpret_cast<void*>(&porsche::audio_u32_mul64_00590d80)
            : slot_590d80;
        seed_fpu();
        trace.abi_fail = invoke_cdecl2_u64(fn, a, b, trace.ret_lo, trace.ret_hi);
        capture_fpu(trace.fpu);
        snapshot_trace();
    };
    run_one(false);
    expected = trace;
    run_one(true);
    compare_traces(true, true);
}

static void test_div32(U lo, U hi, U divisor) {
