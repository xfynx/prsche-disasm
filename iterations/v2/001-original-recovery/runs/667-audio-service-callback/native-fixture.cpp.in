int __cdecl formatter_text_compare_n_005a2210(
    const char* first, const char* second, std::uint32_t n) {
    int diff = 0;
    if (n != 0u) {
        U i = 0u;
        do {
            const char c1 = ascii_lower(first[i]);
            const char c2 = ascii_lower(second[i]);
            diff = static_cast<int>(static_cast<unsigned char>(c1)) -
                   static_cast<int>(static_cast<unsigned char>(c2));
            if (diff != 0 || c1 == '\0') {
                break;
            }
            ++i;
        } while (i < n);
    }
    record_event(kEvCompareN, n, static_cast<U>(diff), 0u, 0u, first, second);
    return diff;
}

std::uint32_t __stdcall platform_get_tick_count() {
    const U v = cfg.tick_seq[tick_idx % cfg.tick_len];
    ++tick_idx;
    record_event(kEvTick, v);
    return v;
}

