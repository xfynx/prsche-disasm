    relocate_call(slot_4ad9c0, 0x284u, 0x004adc44u, 0x005a2210u,
                  reinterpret_cast<const void*>(&porsche::formatter_text_compare_n_005a2210));
    relocate_call(slot_4ad9c0, 0x2b1u, 0x004adc71u, 0x00566ae0u,
                  reinterpret_cast<const void*>(&porsche::audio_stream_service_ramp_00566ae0));
    relocate_call(slot_4ad9c0, 0x2d5u, 0x004adc95u, 0x00567850u,
                  reinterpret_cast<const void*>(&porsche::audio_stream_service_status_00567850));
    relocate_call(slot_4ad9c0, 0x2f3u, 0x004adcb3u, 0x00567740u,
                  reinterpret_cast<const void*>(&porsche::audio_stream_service_reset_00567740));
    relocate_call(slot_4ad9c0, 0x330u, 0x004adcf0u, 0x005666f0u,
