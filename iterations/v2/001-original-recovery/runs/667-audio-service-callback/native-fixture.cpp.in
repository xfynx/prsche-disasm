            : slot_590df0;
        seed_fpu();
        trace.abi_fail = invoke_cdecl3(fn, lo, hi, divisor, trace.ret_lo);
        capture_fpu(trace.fpu);
        snapshot_trace();
    };
    run_one(false);
    expected = trace;
    run_one(true);
    compare_traces(true, false);
}

