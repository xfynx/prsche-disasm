static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u cpp=%u\n", msg, cases, static_cast<U>(cpp_side));
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_root_ptr(U p) {
    if (p == 0u) return 0u;
    if (p == address(root_a_buf)) return 0xa0000001u;
    if (p == address(root_b_buf)) return 0xa0000002u;
    const U base_a = address(root_a_buf);
    if (p > base_a && p < base_a + sizeof(root_a_buf)) {
        return 0xa1000000u + (p - base_a);
    }
    const U base_b = address(root_b_buf);
    if (p > base_b && p < base_b + sizeof(root_b_buf)) {
        return 0xa2000000u + (p - base_b);
    }
    return p;
}

static void record_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u,
                         const char* s0 = nullptr, const char* s1 = nullptr) {
    require(trace.count < 64u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    if (s0 != nullptr) {
        std::snprintf(e.s0, sizeof(e.s0), "%s", s0);
    }
    if (s1 != nullptr) {
        std::snprintf(e.s1, sizeof(e.s1), "%s", s1);
    }
}

static char ascii_lower(char c) {
    return (c >= 'A' && c <= 'Z') ? static_cast<char>(c + 32) : c;
}

