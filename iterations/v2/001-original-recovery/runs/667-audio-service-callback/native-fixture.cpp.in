    relocate_call(slot_4ad9c0, 0x115u, 0x004adad5u, 0x00566ae0u,
                  reinterpret_cast<const void*>(&porsche::audio_stream_service_ramp_00566ae0));
    relocate_call(slot_4ad9c0, 0x11du, 0x004adaddu, 0x004ad6c0u,
                  reinterpret_cast<const void*>(&porsche::splash_progress_resource_end_004ad6c0));
    relocate_call(slot_4ad9c0, 0x189u, 0x004adb49u, 0x00566ae0u,
                  reinterpret_cast<const void*>(&porsche::audio_stream_service_ramp_00566ae0));
    relocate_call(slot_4ad9c0, 0x191u, 0x004adb51u, 0x004ad6c0u,
                  reinterpret_cast<const void*>(&porsche::splash_progress_resource_end_004ad6c0));
    relocate_call(slot_4ad9c0, 0x235u, 0x004adbf5u, 0x004ad950u, slot_4ad950);
    relocate_call(slot_4ad9c0, 0x24au, 0x004adc0au, 0x005a2210u,
                  reinterpret_cast<const void*>(&porsche::formatter_text_compare_n_005a2210));
    relocate_call(slot_4ad9c0, 0x267u, 0x004adc27u, 0x005a2210u,
