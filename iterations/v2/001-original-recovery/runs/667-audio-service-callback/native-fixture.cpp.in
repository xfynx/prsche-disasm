    compare_traces(false, false);
}

template <typename SetupFn>
static void test_callback(const ScenarioCfg& c_in, SetupFn setup_fn) {
    ++cases;
    auto run_one = [&](bool use_cpp) {
        cpp_side = use_cpp;
        reset_env(c_in);
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        put(chan_buf, 0x00u, address(entries_buf));
        put(chan_buf, 0x0cu, 2u);
        chan_buf[0x16u] = 2u;
        const std::uint16_t d2c = 0x1000u;
        const std::uint16_t d30 = 0x2000u;
        std::memcpy(chan_buf + 0x2cu, &d2c, 2u);
        std::memcpy(chan_buf + 0x30u, &d30, 2u);
        porsche::audio_stream_slots_006b7cc0[2] = address(slot_rec_buf);
        put(slot_rec_buf, 0x20u, 100u);
        put(slot_rec_buf, 0x24u, 200u);
        put(entries_buf, 0x04u, 0x101u);
        put(entries_buf, 0x08u, 1u);
        put(entries_buf, 0x14u, 0x4000u);
        put(entries_buf, 0x18u, 0x8000u);
        put(entries_buf, 0x1cu, 0x120u);
        setup_fn();
        void* fn = use_cpp
            ? reinterpret_cast<void*>(&porsche::application_audio_service_callback_004ad9c0)
            : slot_4ad9c0;
        seed_fpu();
        trace.abi_fail = invoke_cdecl2(fn, 0x1111u, 0x2222u, trace.ret_lo);
        capture_fpu(trace.fpu);
        snapshot_trace();
    };
    run_one(false);
    expected = trace;
    run_one(true);
    compare_traces(true, false);
}

static void init_root(B* buf, U source, U state, I slot, I count, I cur_idx,
                      U f00 = 0x7fu, U f10 = 0u, U f18 = 0u, U f1c = 0u,
                      U f24 = 0u, U f6c = 1u, U f84 = 1u, U f90 = 0x101u) {
    put(buf, 0x00u, f00);
    put(buf, 0x08u, static_cast<U>(count));
    put(buf, 0x0cu, static_cast<U>(cur_idx));
    put(buf, 0x10u, f10);
    put(buf, 0x14u, state);
    put(buf, 0x18u, f18);
    put(buf, 0x1cu, f1c);
    put(buf, 0x20u, 0u);
    put(buf, 0x24u, f24);
    put(buf, 0x28u, address(tag_buf));
    put(buf, 0x6cu, f6c);
    put(buf, 0x70u, static_cast<U>(slot));
    put(buf, 0x74u, 0u);
    put(buf, 0x84u, f84);
    put(buf, 0x88u, source);
    put(buf, 0x8cu, 0u);
    put(buf, 0x90u, f90);
}

int main() {
    require(sizeof(porsche::audio_service_tag_vic_005d1bd4) == sizeof(orig_str_5d1bd4) &&
                std::memcmp(porsche::audio_service_tag_vic_005d1bd4, orig_str_5d1bd4, 4u) == 0,
            "raw str 5d1bd4");
    require(sizeof(porsche::audio_service_tag_win_005d1bd8) == sizeof(orig_str_5d1bd8) &&
                std::memcmp(porsche::audio_service_tag_win_005d1bd8, orig_str_5d1bd8, 4u) == 0,
            "raw str 5d1bd8");
    require(sizeof(porsche::audio_service_tag_lose_005d1bdc) == sizeof(orig_str_5d1bdc) &&
                std::memcmp(porsche::audio_service_tag_lose_005d1bdc, orig_str_5d1bdc, 5u) == 0,
            "raw str 5d1bdc");

    setup_original_code();

    // 1. 00590d80 (32x32->64 unsigned multiply)
    test_mul64(0u, 0u);
    test_mul64(0x12345678u, 1000u);
    test_mul64(0xffffffffu, 0xffffffffu);
    test_mul64(0xdeadbeefu, 0xfeedfaceu);

    // 2. 00590df0 (64/32 restoring division)
    test_div32(0u, 0u, 1000u);
    test_div32(0x12345678u, 0x00000100u, 0x00010000u);
    test_div32(0xffffffffu, 0x80000000u, 3u);
    test_div32(0x12345678u, 0x00000001u, 0u);

    // 3. 005616b0 (slot total)
    test_slot_total(0u, 0x10u, 0x20u);
    test_slot_total(15u, 0xfffffff0u, 0x20u);

    // 4. 00590e20 (stream lookup)
    test_stream_lookup(-1, 0u, 2, 0);
    test_stream_lookup(0x101, 1u, 2, 0);
    test_stream_lookup(0x101, 0u, 0, 0);
    test_stream_lookup(0x101, 0u, static_cast<B>(-1), 0);
    test_stream_lookup(0x101, 0u, 3, 2);
    test_stream_lookup(0x101, 0u, 3, 5);

    // 5. 00566a40 (slot info)
    test_slot_info(0u, 0u, 1, 2, 1000u, 2u, 10u, 20u);
    test_slot_info(1u, 1u, 1, 2, 1000u, 2u, 10u, 20u);
    test_slot_info(1u, 0u, 1, 0, 1000u, 2u, 10u, 20u);
    test_slot_info(1u, 0u, 1, 2, 0u, 2u, 10u, 20u);
    test_slot_info(1u, 0u, 1, static_cast<B>(-2), 0x8000u, 2u, 0x00500000u, 0x00100000u);

    // 6. 00566910 (stream info)
    test_stream_info(0u, 0u, 0x101, 2, 0, 0, 100u, 300u, 50u, 1000u, 2000u);
    test_stream_info(1u, 0u, -5, 2, 0, 0, 100u, 300u, 50u, 1000u, 2000u);
    test_stream_info(1u, 1u, 0x101, 2, 0, 0, 100u, 300u, 50u, 1000u, 2000u);
    test_stream_info(1u, 0u, 0x101, 2, 5, 0, 100u, 300u, 50u, 1000u, 2000u);
    test_stream_info(1u, 0u, 0x101, 2, 0, 0xffffffffu, 100u, 300u, 50u, 1000u, 2000u);
    test_stream_info(1u, 0u, 0x101, 2, 0, 1u, 0x00500000u, 0x00900000u, 0x00500000u, 0x8000u, 0x4000u);
    test_stream_info(1u, 0u, 0x101, 2, 1, 1u, 0x00500000u, 0x00100000u, 0x00500000u, 0x8000u, 0xc000u);

    // 7. 004ad950 (split)
    test_split("");
    test_split("alpha");
    test_split("foo-bar");
    test_split("foo-win-tail");
    test_split("a-b-c-d");
    test_split("12345678901234567890123456789012345-xyz");
    test_split("a-12345678901234567890123456789012345");

    // 8. 004ad9c0 (service callback)
    // Early exits
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 0u, 0u, 1, 2, 0);
    });
    {
        ScenarioCfg c = default_cfg();
        c.window_active = 0u;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 0u, 1, 2, 0);
        });
    }
    // Pre-transition ramp-out triggered (root[0xa0] > root[0xa4] && root[0xa4] < 550)
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 1u, 1, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 0u);
        put(entries_buf, 0x14u, 0x1000u);
        put(entries_buf, 0x18u, 0x2000u); // root[0xa0] = 1000
        put(entries_buf, 0x1cu, 0x120u);  // root[0xa4] = 70 < 550 (0x226)
        std::snprintf(tag_buf, sizeof(tag_buf), "other");
    });
    // Pre-transition boundary: root[0xa4] == 0x226 (550) must NOT trigger ramp-out
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 1u, 1, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 1u);
        put(entries_buf, 0x14u, 0x1000u);
        put(entries_buf, 0x18u, 0x2000u); // root[0xa0] = 1000 > 550
        put(entries_buf, 0x1cu, 0x8d0u);  // root[0xa4] = (2256*1000)/4096 = 550 == 0x226!
    });
    // State 2: root[0x6c] == 0 -> -4 stop
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 0u);
    });
    // State 2: root[0x6c] != 0 && slot < 0 -> -3 stop
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, -1, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 1u);
    });
    // State 2: root[0x6c] != 0 && slot >= 0 && count==0 (00566a40 sets 008c=0) -> exit 0
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 1u);
        chan_buf[0x16u] = 0u;
    });
    // State 2: tag comparisons ("LOSE-1", "los", "WIN-2", "VIC-3", "other")
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0);
        std::snprintf(tag_buf, sizeof(tag_buf), "LOSE-1");
    });
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0);
        std::snprintf(tag_buf, sizeof(tag_buf), "los");
    });
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0);
        std::snprintf(tag_buf, sizeof(tag_buf), "WIN-2");
    });
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0);
        std::snprintf(tag_buf, sizeof(tag_buf), "VIC-3");
    });
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 2u, 1, 2, 0);
        std::snprintf(tag_buf, sizeof(tag_buf), "trk-other");
    });
    // State != 0 && != 2: status nonzero -> return 0
    {
        ScenarioCfg c = default_cfg();
        c.status_ret = 1;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 1u, 1, 2, 0);
        });
    }
    // State == 3, status == 0 -> reset, state becomes 0
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 3u, 1, 2, 0);
    });
    // State == 1, status == 0 -> locate (including signed int8_t entry byte!) & start stream
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 1u, 1, 2, 1);
        root_a_buf[0xe8u + 1u] = 0xfeu; // signed -2 -> 0xfffffffe
    });
    // State == 0: 0x8c != 0 -> return 0
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 0u, 1, 2, 0);
    });
    // State == 0, 0x8c == 0, cur_idx == -1 -> return 0
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 0u, 1, 2, -1);
        chan_buf[0x16u] = 0u;
    });
    // State == 0, count == 1 -> cur_idx = 0, volume, play
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 0u, 1, 1, 3);
        chan_buf[0x16u] = 0u;
    });
    // State == 0, count == 2, random -> PRNG + tickCount, next_idx = 1
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 0u, 1, 2, 0, 0x7fu, 0u, 0u, 0u, 1u);
        chan_buf[0x16u] = 0u;
    });
    // State == 0, count == 0 -> skip index update, volume, skip play
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 0u, 1, 0, 0);
        chan_buf[0x16u] = 0u;
    });
    // State == 0, count == 5, sequential wrap
    test_callback(default_cfg(), [] {
        init_root(root_a_buf, 1u, 0u, 1, 5, 4, 0x7fu, 0u, 0u, 0u, 0u);
        chan_buf[0x16u] = 0u;
    });
    // State == 0, count == 5, random with negative sum & INT_MIN sum
    {
        ScenarioCfg c = default_cfg();
        c.prng_seq[0] = 0x80000001u;
        c.tick_seq[0] = 0x00000000u;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 0u, 1, 5, 2, 0x7fu, 0u, 0u, 0u, 1u);
            chan_buf[0x16u] = 0u;
        });
    }
    {
        ScenarioCfg c = default_cfg();
        c.prng_seq[0] = 0x80000000u;
        c.tick_seq[0] = 0x00000000u;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 0u, 1, 5, 2, 0x7fu, 0u, 0u, 0u, 1u);
            chan_buf[0x16u] = 0u;
        });
    }
    // Root-switch reload tests across calls
    {
        ScenarioCfg c = default_cfg();
        c.switch_root_in_ramp = 1u;
        c.switch_root_in_end = 1u;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 2u, 1, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 0u);
            init_root(root_b_buf, 2u, 2u, 3, 2, 0, 0x7fu, 0u, 0u, 0u, 0u, 0u);
        });
    }
    {
        ScenarioCfg c = default_cfg();
        c.switch_root_in_reset = 1u;
        c.switch_root_in_locate = 1u;
        c.switch_root_in_start = 1u;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 1u, 1, 2, 0);
            init_root(root_b_buf, 2u, 1u, 3, 2, 1);
            root_b_buf[0xe8u + 1u] = 7u;
        });
    }
    {
        ScenarioCfg c = default_cfg();
        c.switch_root_in_volume = 1u;
        c.switch_root_in_play = 1u;
        test_callback(c, [] {
            init_root(root_a_buf, 1u, 0u, 1, 3, 1);
            init_root(root_b_buf, 2u, 0u, 3, 3, 1);
            chan_buf[0x16u] = 0u;
        });
    }

    std::printf("audio_service_callback_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}

