static void test_stream_lookup(I handle, U lookup_null, B count_byte, I match_idx) {
    ++cases;
    auto run_one = [&](bool use_cpp) {
        cpp_side = use_cpp;
        ScenarioCfg c = default_cfg();
        c.lookup_null = lookup_null;
        reset_env(c);
        put(chan_buf, 0x00u, address(entries_buf));
        chan_buf[0x16u] = count_byte;
        for (I i = 0; i < 4; ++i) {
            put(entries_buf, static_cast<U>(i) * 0x2cu + 0x04u,
                (i == match_idx) ? static_cast<U>(handle) : static_cast<U>(0x7000 + i));
        }
        void* fn = use_cpp
            ? reinterpret_cast<void*>(&porsche::audio_service_stream_lookup_00590e20)
            : slot_590e20;
        seed_fpu();
        trace.abi_fail = invoke_cdecl1(fn, static_cast<U>(handle), trace.ret_lo);
        capture_fpu(trace.fpu);
        snapshot_trace();
    };
    run_one(false);
    expected = trace;
    run_one(true);
    compare_traces(true, false);
}

static void test_slot_info(B active, U lookup_null, I slot, B count_byte,
                           std::uint16_t denom, U pcm_idx, U v20, U v24) {
    ++cases;
    auto run_one = [&](bool use_cpp) {
        cpp_side = use_cpp;
        ScenarioCfg c = default_cfg();
        c.lookup_null = lookup_null;
        reset_env(c);
        porsche::application_audio_device_state_006b48c0[0xdcu] = active;
        put(chan_buf, 0x00u, address(entries_buf));
        put(chan_buf, 0x0cu, pcm_idx);
        chan_buf[0x16u] = count_byte;
        std::memcpy(chan_buf + 0x2cu, &denom, 2u);
        put(entries_buf, 0x04u, 0x12340102u);
        porsche::audio_stream_slots_006b7cc0[pcm_idx & 0xfu] = address(slot_rec_buf);
        put(slot_rec_buf, 0x20u, v20);
        put(slot_rec_buf, 0x24u, v24);
        void* fn = use_cpp
            ? reinterpret_cast<void*>(&porsche::audio_service_slot_info_00566a40)
            : slot_566a40;
        seed_fpu();
        trace.abi_fail = invoke_cdecl2(fn, static_cast<U>(slot), address(out_words), trace.ret_lo);
        capture_fpu(trace.fpu);
        snapshot_trace();
    };
    run_one(false);
    expected = trace;
    run_one(true);
    compare_traces(true, false);
}

static void test_stream_info(B active, U lookup_null, I handle, B count_byte,
                             I match_idx, U entry_s08, U entry_14, U entry_18, U entry_1c,
                             std::uint16_t denom2c, std::uint16_t denom30) {
    ++cases;
    auto run_one = [&](bool use_cpp) {
        cpp_side = use_cpp;
        ScenarioCfg c = default_cfg();
        c.lookup_null = lookup_null;
        reset_env(c);
        porsche::application_audio_device_state_006b48c0[0xdcu] = active;
        put(chan_buf, 0x00u, address(entries_buf));
        chan_buf[0x16u] = count_byte;
        std::memcpy(chan_buf + 0x2cu, &denom2c, 2u);
        std::memcpy(chan_buf + 0x30u, &denom30, 2u);
        for (I i = 0; i < 4; ++i) {
            const U off = static_cast<U>(i) * 0x2cu;
            put(entries_buf, off + 0x04u,
                (i == match_idx) ? static_cast<U>(handle) : static_cast<U>(0x8000 + i));
            put(entries_buf, off + 0x08u, entry_s08);
            put(entries_buf, off + 0x14u, entry_14);
            put(entries_buf, off + 0x18u, entry_18);
            put(entries_buf, off + 0x1cu, entry_1c);
        }
        void* fn = use_cpp
            ? reinterpret_cast<void*>(&porsche::audio_service_stream_info_00566910)
            : slot_566910;
        seed_fpu();
        trace.abi_fail = invoke_cdecl2(fn, static_cast<U>(handle), address(out_words), trace.ret_lo);
        capture_fpu(trace.fpu);
        snapshot_trace();
    };
    run_one(false);
    expected = trace;
    run_one(true);
    compare_traces(true, false);
}

