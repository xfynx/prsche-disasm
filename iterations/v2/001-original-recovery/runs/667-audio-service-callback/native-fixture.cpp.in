static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}

static void relocate_call(B* slot, U off, U orig_va, U orig_target, const void* target) {
    const U actual = orig_va + 4u + word(slot, off);
    require(actual == orig_target, "exact relative call target");
    put(slot, off, address(target) - (address(slot) + off + 4u));
}

