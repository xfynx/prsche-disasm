static void prepare(U salt) {
    std::memset(&trace, 0, sizeof trace);
    porsche::render_depthconv_palette_ptr_005de2f8 = palette_source;
    for (U i = 0u; i < 256u; ++i) {
        palette_source[i] = 0x81000000u ^ (i * 0x010203u) ^ (salt * 0x010101u);
        porsche::render_depthconv_palette_scratch_006bda20[i] = 0x5a5a0000u ^ (i * 0x13u) ^ salt;
    }
    for (U i = 0u; i < sizeof(src_buf); ++i) {
        src_buf[i] = static_cast<B>((i * 29u + salt * 7u + 3u) & 0xffu);
        dst_buf[i] = static_cast<B>((0xa5u ^ (i * 11u) ^ salt) & 0xffu);
    }
    // Include interesting 16-bit boundary pixels at the start of src_buf.
    const std::uint16_t edge16[8] = {
        0x0000u, 0xffffu, 0xf800u, 0x07e0u, 0x001fu, 0x1234u, 0x8000u, 0x7fffu
    };
    std::memcpy(src_buf, edge16, sizeof edge16);
}

