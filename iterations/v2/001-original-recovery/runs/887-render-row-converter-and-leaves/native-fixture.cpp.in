std::uint32_t __cdecl render_color_pack_00537ed0(std::uint32_t color) {
    const U r = ((color >> 16) & 0xffu) * 7u;
    const U g = ((color >> 8) & 0xffu) * 13u;
    const U b = (color & 0xffu) * 3u;
    const U res = (r ^ g ^ b ^ (color >> 24)) & 0xffu;
    event(4u, color, res);
    return res;
}

void __cdecl heap_copy_dispatch_005323e0(void* dst, const void* src, std::uint32_t bytes) {
    event(5u, static_cast<U>(dst == dst_buf) | (static_cast<U>(src == src_buf) << 1), bytes);
    if (bytes > 0u && bytes <= sizeof(dst_buf)) {
        std::memcpy(dst, src, bytes);
    }
}

static void palette_call(U kind, std::uint16_t* dst, const std::uint32_t* src, I count) {
    event(kind, static_cast<U>(count), src == palette_source);
    for (I i = 0; i < count; ++i) {
        dst[i] = static_cast<std::uint16_t>((src[i] ^ (kind * 0x1111u)) & 0xffffu);
    }
}

