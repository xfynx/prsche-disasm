        porsche::render_depthconv_palette_ptr_005de2f8 =
            reinterpret_cast<U*>(static_cast<std::uintptr_t>(0x11223344u));
        void* fn = side == 0u ? static_cast<void*>(slot_534b90)
                              : reinterpret_cast<void*>(&porsche::render_shape_row_converter_00534b90);
        const U result = invoke_cdecl3(fn, ptr(shape), target_type,
                                       static_cast<U>(direct_mode), trace.abi_fail);
        snapshot_534b90(result);
        if (side == 0u) expected = trace;
        else require(std::memcmp(&trace, &expected, sizeof trace) == 0,
                     "00534b90 trace");
    }
}

static void run_leaf_case(U idx, void* cpp_fn, I count, bool use_lut, U key_val) {
    ++cases;
    for (side = 0u; side < 2u; ++side) {
        prepare(cases * 31u + idx * 7u);
        porsche::render_color_lut_0069e0ac = use_lut ? color_lut : nullptr;
        porsche::render_palette_color_key_006a6420 = key_val;
        void* fn = side == 0u ? static_cast<void*>(leaf_stubs[idx].addr) : cpp_fn;
        (void)invoke_cdecl3(fn, ptr(dst_buf), ptr(src_buf), static_cast<U>(count), trace.abi_fail);
        require(trace.abi_fail == 0u, "leaf ABI");
        trace.dst_hash = hash_bytes(dst_buf, sizeof(dst_buf));
        if (side == 0u) expected = trace;
        else require(std::memcmp(&trace, &expected, sizeof trace) == 0,
                     "leaf trace");
    }
}

