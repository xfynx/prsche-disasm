template <typename Fn>
static U fn_ptr(Fn* fn) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(reinterpret_cast<const void*>(fn)));
}

static U rd(const void* p, U offset = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + offset, sizeof v);
    return v;
}

static void wr(void* p, U offset, U value) {
    std::memcpy(static_cast<B*>(p) + offset, &value, sizeof value);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", msg, cases, side);
        std::fflush(stdout);
        ExitProcess(10u);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx case=%u side=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip, cases, side);
    std::fflush(stdout);
    ExitProcess(10u);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void event(U kind, U a0, U a1 = 0u) {
    require(trace.event_count < 24u, "event capacity");
    trace.events[trace.event_count++] = {kind, a0, a1};
}

static U hash_bytes(const void* p, U size) {
    const auto* b = static_cast<const B*>(p);
    U h = 2166136261u;
    for (U i = 0u; i < size; ++i) h = (h ^ b[i]) * 16777619u;
    return h;
}

