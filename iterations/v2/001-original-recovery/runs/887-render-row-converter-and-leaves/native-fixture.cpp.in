static U invoke_cdecl3(void* fn, U a0, U a1, U a2, U& abi_fail) {
    U result = 0u, fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push a2
        push a1
        push a0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov result, eax
        add esp, 12
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
    return result;
}

static void bind_abs32(B* base, U size, U old_va, U new_va, U expected_hits) {
    U hits = 0u;
    for (U i = 0u; i + 4u <= size; ++i) {
        if (rd(base, i) == old_va) {
            wr(base, i, new_va);
            ++hits;
            i += 3u;
        }
    }
    require(hits == expected_hits, "bind_abs32 count");
}

static void bind_rel32(B* base, U base_va, U offset, U original_target, U replacement) {
    require(base[offset] == 0xe8u, "bind_rel32 opcode");
    const U decoded = base_va + offset + 5u + rd(base, offset + 1u);
    require(decoded == original_target, "bind_rel32 target");
    wr(base, offset + 1u, replacement - (ptr(base) + offset + 5u));
}

