        reinterpret_cast<void*>(&porsche::render_row_4_to_8_00570150),
        reinterpret_cast<void*>(&porsche::render_row_8_copy_00570190),
        reinterpret_cast<void*>(&porsche::render_row_565_to_8_005701b0),
        reinterpret_cast<void*>(&porsche::render_row_565_to_1555_005702f0),
        reinterpret_cast<void*>(&porsche::render_row_4_to_16_lut_005703a0),
        reinterpret_cast<void*>(&porsche::render_row_8_to_16_lut_005703f0),
        reinterpret_cast<void*>(&porsche::render_row_16_copy_00570470),
        reinterpret_cast<void*>(&porsche::render_row_565_to_4444_key_005705a0),
        reinterpret_cast<void*>(&porsche::render_row_8_to_24_lut_00570650),
        reinterpret_cast<void*>(&porsche::render_row_565_to_24_00570690),
        reinterpret_cast<void*>(&porsche::render_row_24_copy_00570700),
        reinterpret_cast<void*>(&porsche::render_row_8888_to_24_00570720),
        reinterpret_cast<void*>(&porsche::render_row_8_to_32_lut_00570750),
        reinterpret_cast<void*>(&porsche::render_row_4444_to_8888_005708a0),
        reinterpret_cast<void*>(&porsche::render_row_24_to_8888_00570a00),
        reinterpret_cast<void*>(&porsche::render_row_32_copy_00570a80),
    };
    const I counts[] = {-1, 0, 1, 2, 3, 7, 16};
    for (U i = 0u; i < 18u; ++i) {
        for (I c : counts) {
            run_leaf_case(i, cpp_leaves[i], c, false, 0x1234u);
            if (i == 4u || i == 9u) {
                run_leaf_case(i, cpp_leaves[i], c, true, 0xf800u);
            }
        }
