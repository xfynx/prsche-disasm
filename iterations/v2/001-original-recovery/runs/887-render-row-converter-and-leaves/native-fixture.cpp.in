    // End-to-end call through converter returned by render_shape_row_converter_00534b90.
    ++cases;
    alignas(4) U shape[8] = {};
    shape[0] = 0xa55a0002u;
    prepare(999u);
    void* returned = porsche::render_shape_row_converter_00534b90(shape, 0x7du, 1);
    require(returned == cpp_leaves[14], "returned row converter pointer");
    reinterpret_cast<void(__cdecl*)(void*, const void*, I)>(returned)(dst_buf, src_buf, 8);
    require(rd(dst_buf, 0u) == palette_source[src_buf[0]], "end-to-end converter call");

    std::printf("render_row_converter_887_original_x86_vs_cpp=PASS cases=%u\n", cases);
    std::fflush(stdout);
