static void run_read_pixel(
    const char* name, B bpp, B win_mode, U win_state, U format_bits, U lock_ok, I x, I y) {
    ++cases;
    U esp_b = 0u, esp_a = 0u, ebx_b = 0u, esi_b = 0u, edi_b = 0u, ebp_b = 0u;
    U ebx_a = 0u, esi_a = 0u, edi_a = 0u, ebp_a = 0u, ret_raw = 0u;
    B* raw_fn = code_570d50;

    reset_env(0x78u, bpp, win_mode, win_state, format_bits, 0u, 0, 0, 32, 32);
    fake_lock_ok = lock_ok;
    std::memset(&expected, 0, sizeof(expected));
    cur = &expected;
    __asm {
        mov ebx_b, ebx
        mov esi_b, esi
        mov edi_b, edi
        mov ebp_b, ebp
        mov esp_b, esp
        push y
        push x
        mov eax, raw_fn
        call eax
        add esp, 8
        mov esp_a, esp
        mov ret_raw, eax
        mov ebx_a, ebx
        mov esi_a, esi
        mov edi_a, edi
        mov ebp_a, ebp
    }
    expected.ret = ret_raw;
    expected.abi_fail = (esp_b != esp_a || ebx_b != ebx_a || esi_b != esi_a || edi_b != edi_a || ebp_b != ebp_a) ? 1u : 0u;
    std::memcpy(expected.fb, fb_mem, sizeof(fb_mem));

    reset_env(0x78u, bpp, win_mode, win_state, format_bits, 0u, 0, 0, 32, 32);
    fake_lock_ok = lock_ok;
    std::memset(&actual, 0, sizeof(actual));
    cur = &actual;
    actual.ret = porsche::render_buffer_read_pixel_00570d50(x, y);
    actual.abi_fail = 0u;
    std::memcpy(actual.fb, fb_mem, sizeof(fb_mem));
    check_snap(name);
}

