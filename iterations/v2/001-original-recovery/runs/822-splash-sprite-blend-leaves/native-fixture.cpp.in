namespace porsche {

std::uint32_t window_shutdown_config_005de620[12]{};
std::uint8_t& window_shutdown_mode_005de630 =
    reinterpret_cast<std::uint8_t*>(window_shutdown_config_005de620)[0x10];
std::uint32_t& window_shutdown_state_005de64c = window_shutdown_config_005de620[11];
std::uint32_t splash_progress_format_005dead0 = 0u;
std::uint32_t render_thrash_exports_006bd910[43]{};
std::uint32_t render_pixel_palette_006b4b20[256]{};

std::uint32_t __cdecl render_color_888_to_565_00572f30(std::uint32_t color) {
    return ((color & 0x00f80000u) >> 8u) |
           ((color & 0x0000fc00u) >> 5u) |
           ((color >> 3u) & 0x1fu);
}

std::uint32_t __cdecl render_color_888_to_1555_00572f5b(std::uint32_t color) {
    if (color == 0u) {
        return 0u;
    }
    return 0x8000u |
           ((color & 0x00f80000u) >> 9u) |
           ((color & 0x0000f800u) >> 6u) |
           ((color >> 3u) & 0x1fu);
}

std::uint32_t __cdecl texture_depth_format_00535380(std::uint32_t depth) {
    record_event(3u, depth, 0u, 0u, 0u);
    return (depth == 32u) ? 0x7du : 0x78u;
}

void* __cdecl render_shape_convert_type_00534d40(
    const void* shape, std::uint32_t target_type,
    std::int32_t use_dither, std::int32_t direct_mode) {
    record_event(4u, addr_u32(shape), target_type, static_cast<U>(use_dither), static_cast<U>(direct_mode));
    return conv_out_buf;
}

void* __cdecl render_buffer_address_00574050(std::int32_t x, std::int32_t y) {
    record_event(5u, static_cast<U>(x), static_cast<U>(y), 0u, 0u);
    const U idx = (static_cast<U>(y & 15) * 48u + static_cast<U>(x & 15) * 2u) % (kFbBytes - 64u);
    return &fb_mem[idx];
}

void __cdecl render_buffer_select_00556910(std::int32_t x, std::int32_t y, std::uint32_t pixel) {
    record_event(6u, static_cast<U>(x), static_cast<U>(y), pixel, 0u);
}

std::uint32_t __cdecl render_buffer_convert_00574b70(std::uint32_t pixel) {
    record_event(7u, pixel, 0u, 0u, 0u);
    if ((pixel & 0xffffu) == 0x1111u) {
        return 0x00abcdefu; // zero dst alpha test case
    }
    return 0x80214365u | ((pixel & 0x0fu) << 2u);
}

std::uint32_t __cdecl render_descriptor_bits_00537f90(const void* descriptor_format) {
    const auto* const bytes = static_cast<const B*>(descriptor_format);
    record_event(8u, addr_u32(bytes), static_cast<U>(bytes[0]), 0u, 0u);
    return (bytes[0] == 0x7eu) ? 15u : ((bytes[0] == 0x78u) ? 16u : 32u);
}

std::uint32_t __cdecl render_buffer_read_word_0056e2a8(const void* src, std::int32_t bytes) {
    const auto* const p = static_cast<const B*>(src) + bytes - 4;
    U val = 0u;
    std::memcpy(&val, p, sizeof(val));
    const U shift = static_cast<U>((-bytes) * 8 + 32) & 0x1fu;
    return val >> shift;
}

std::int32_t __cdecl splash_shape_row_stride_005712f0(const void* shape) {
    const auto* const bytes = static_cast<const B*>(shape);
    std::int16_t w16 = 0;
    std::memcpy(&w16, bytes + 4u, sizeof(w16));
    const I width = w16;
    if (bytes[0] == 0x7bu) {
        return width;
    }
    I bpp = static_cast<I>(render_descriptor_bits_00537f90(shape));
    if (bpp == 15) {
        bpp = 16;
    }
    return (bpp * width + 7) >> 3;
}

void* __cdecl render_sprite_sample_0058ccbf_unused() { return nullptr; }
std::uint32_t __cdecl render_sprite_sample_0058ccbf(
    const void*, std::int32_t, std::int32_t, std::int32_t) { return 0u; }
void __cdecl splash_progress_free_00531f90(void*) {}

} // namespace porsche

int main() {
    init_original_code();

    if (row_stride_addr_822() != reinterpret_cast<const void*>(&porsche::splash_shape_row_stride_005712f0)) {
        std::printf("divergence row-stride-alias-mismatch\n");
        std::fflush(nullptr);
        return 10;
    }

    // 1. 005350a0: depth conversion wrapper.
    run_convert_depth("conv-depth-32", 32u);
    run_convert_depth("conv-depth-16", 16u);

    // 2. 00563ab0: filter ratio (1LL << 32) / abs_scale.
    run_filter_select("filter-0x10000", 0x10000);
    run_filter_select("filter-0x290", 0x290);
    run_filter_select("filter-neg-0x8000", -0x8000);

    // 3. 00570d50: read pixel across bpp {4,8,15,16,24,32,7} and thrash lock vs framebuffer.
    run_read_pixel("read-4bpp-even", 4u, 0u, 0u, 2u, 1u, 4, 3);
    run_read_pixel("read-4bpp-odd", 4u, 0u, 0u, 2u, 1u, 5, 3);
    run_read_pixel("read-8bpp-fb", 8u, 0xffu, 0u, 2u, 1u, 6, 4);
    run_read_pixel("read-15bpp-thrash", 15u, 1u, 0u, 2u, 1u, 7, 5);
    run_read_pixel("read-16bpp-thrash-state1", 16u, 1u, 1u, 2u, 1u, 7, 5);
    run_read_pixel("read-24bpp-thrash", 24u, 1u, 0u, 3u, 1u, 3, 2);
    run_read_pixel("read-32bpp-thrash", 32u, 1u, 0u, 1u, 1u, 2, 1);
    run_read_pixel("read-invalid-bpp-default", 7u, 0u, 0u, 2u, 1u, 2, 1);

    // 4. 00573b20: direct sprite blend across clip edges, 565 fastpath, alpha 0/255/dst0, flags 0/1.
    run_blend_direct("blend-clip-left", 0x78u, 16u, 0u, 0u, 0u, 1, 5, 0x80ffffffu);
    run_blend_direct("blend-clip-right", 0x78u, 16u, 0u, 0u, 0u, 20, 5, 0x80ffffffu);
    run_blend_direct("blend-clip-top", 0x78u, 16u, 0u, 0u, 0u, 5, 2, 0x80ffffffu);
    run_blend_direct("blend-clip-bottom", 0x78u, 16u, 0u, 0u, 0u, 5, 20, 0x80ffffffu);
    run_blend_direct("blend-565-fastpath", 0x78u, 16u, 0u, 1u, 0u, 5, 6, 0x80abcdefu);
    run_blend_direct("blend-alpha-ff", 0x6du, 16u, 0u, 0u, 0u, 5, 6, 0xff123456u);
    run_blend_direct("blend-alpha-00", 0x6du, 16u, 0u, 0u, 0u, 5, 6, 0x00123456u);
    run_blend_direct("blend-flag0-normal", 0x6du, 16u, 0u, 0u, 0u, 5, 6, 0x80abcdefu);
    run_blend_direct("blend-flag0-round-carry", 0x6du, 16u, 0u, 0u, 0u, 5, 6, 0x800f0f0fu);
    run_blend_direct("blend-flag1-premul", 0x6du, 16u, 0u, 0u, 1u, 5, 6, 0x80abcdefu);

    // Force dst_argb alpha == 0 path (fb_mem byte/word at (4,4) -> 0x1111).
    reset_env(0x6du, 16u, 0u, 0u, 2u, 0u, 2, 3, 20, 20);
    {
        ++cases;
        U esp_b = 0u, esp_a = 0u, ebx_b = 0u, esi_b = 0u, edi_b = 0u, ebp_b = 0u;
        U ebx_a = 0u, esi_a = 0u, edi_a = 0u, ebp_a = 0u;
        B* raw_fn = code_573b20;
        auto* const p16 = reinterpret_cast<B*>(porsche::render_buffer_address_00574050(4, 4));
        p16[0] = 0x11u;
        p16[1] = 0x11u;
        std::memset(&expected, 0, sizeof(expected));
        cur = &expected;
        __asm {
            mov ebx_b, ebx
            mov esi_b, esi
            mov edi_b, edi
            mov ebp_b, ebp
            mov esp_b, esp
            push 0x80123456
            push 4
            push 4
            mov eax, raw_fn
            call eax
            add esp, 12
            mov esp_a, esp
            mov ebx_a, ebx
            mov esi_a, esi
            mov edi_a, edi
            mov ebp_a, ebp
        }
        expected.abi_fail = (esp_b != esp_a || ebx_b != ebx_a || esi_b != esi_a || edi_b != edi_a || ebp_b != ebp_a) ? 1u : 0u;
        std::memcpy(expected.fb, fb_mem, sizeof(fb_mem));
        cur = nullptr;

        reset_env(0x6du, 16u, 0u, 0u, 2u, 0u, 2, 3, 20, 20);
        auto* const p16_act = reinterpret_cast<B*>(porsche::render_buffer_address_00574050(4, 4));
        p16_act[0] = 0x11u;
        p16_act[1] = 0x11u;
        std::memset(&actual, 0, sizeof(actual));
        cur = &actual;
        porsche::render_sprite_blend_direct_00573b20(4, 4, 0x80123456u);
        actual.abi_fail = 0u;
        std::memcpy(actual.fb, fb_mem, sizeof(fb_mem));
        check_snap("blend-dst-alpha-0");
    }

    // 5. 005712f0 canonical ABI alias to Run611 splash_shape_row_stride_005712f0.
    run_stride_alias("stride-pal8", 0x7bu, 17);
    run_stride_alias("stride-1555", 0x7eu, 17);
    run_stride_alias("stride-32", 0x7du, 17);

    std::printf("splash_sprite_blend_leaves_822_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
