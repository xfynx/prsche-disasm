static void setup_cam(
    U f78, U f7c, U f80, U f84_bits, U f88, U f8c, U f90, U f94_bits, U f98, U f9c_bits, U fa0_bits) {
    std::memset(g_cam_buf, 0x55, sizeof(g_cam_buf));
    g_cam_vtable[0x38u / 4u] = reinterpret_cast<void*>(&mock_vslot_38);
    g_cam_vtable[0x40u / 4u] = reinterpret_cast<void*>(&mock_vslot_40);
    store32(g_cam_buf, 0x00u, address(g_cam_vtable));
    store32(g_cam_buf, 0x78u, f78);
    store32(g_cam_buf, 0x7cu, f7c);
    store32(g_cam_buf, 0x80u, f80);
    store32(g_cam_buf, 0x84u, f84_bits);
    store32(g_cam_buf, 0x88u, f88);
    store32(g_cam_buf, 0x8cu, f8c);
    store32(g_cam_buf, 0x90u, f90);
    store32(g_cam_buf, 0x94u, f94_bits);
    store32(g_cam_buf, 0x98u, f98);
    store32(g_cam_buf, 0x9cu, f9c_bits);
    store32(g_cam_buf, 0xa0u, fa0_bits);
    store32(g_cam_buf, 0xb4u, 0x41100000u);
    store32(g_cam_buf, 0xb8u, 0xc0a00000u);
    store32(g_cam_buf, 0xbcu, 0x3fc00000u);
}

static void check_leaves() {
    setup_cam(11u, 1u, 1u, 0x40200000u, 0u, 1u, 1u, 0x41400000u, 1u, 0x42200000u, 0x42b40000u);

    auto check_u32 = [](B* slot, U(__fastcall* fn)(const void*, void*), const char* name) {
        ++cases;
        const U o = reinterpret_cast<U(__fastcall*)(const void*, void*)>(slot)(g_cam_buf, nullptr);
        const U c = fn(g_cam_buf, nullptr);
        require(o == c, name);
    };
    auto check_f32 = [](B* slot, float(__fastcall* fn)(const void*, void*), const char* name) {
        ++cases;
        const float o = reinterpret_cast<float(__fastcall*)(const void*, void*)>(slot)(g_cam_buf, nullptr);
        const float c = fn(g_cam_buf, nullptr);
        require(f32_bits(o) == f32_bits(c), name);
    };

    check_u32(slot_00469a80, porsche::camera_elem_u32_80_00469a80, "00469a80");
    check_f32(slot_00469a90, porsche::camera_elem_f32_84_00469a90, "00469a90");
    check_u32(slot_00469aa0, porsche::camera_elem_u32_88_00469aa0, "00469aa0");
    check_u32(slot_00469ab0, porsche::camera_elem_u32_8c_00469ab0, "00469ab0");
    check_u32(slot_00469ac0, porsche::camera_elem_u32_78_00469ac0, "00469ac0");
    check_u32(slot_00469ad0, porsche::camera_elem_u32_90_00469ad0, "00469ad0");
    check_f32(slot_00469ae0, porsche::camera_elem_f32_94_00469ae0, "00469ae0");
    check_u32(slot_00469af0, porsche::camera_elem_u32_98_00469af0, "00469af0");
    check_f32(slot_00469b00, porsche::camera_elem_f32_9c_00469b00, "00469b00");
    check_f32(slot_00469b10, porsche::camera_elem_f32_a0_00469b10, "00469b10");
    check_u32(slot_0046af50, porsche::camera_elem_u32_7c_0046af50, "0046af50");

    // 00469b20
    ++cases;
    U ov[3]{}, cv[3]{};
    void* or_b2 = reinterpret_cast<void*(__fastcall*)(void*, void*, void*)>(slot_00469b20)(g_cam_buf, nullptr, ov);
    void* cr_b2 = porsche::camera_elem_vec3_b4_00469b20(g_cam_buf, nullptr, cv);
    require(or_b2 == ov && cr_b2 == cv && std::memcmp(ov, cv, 12u) == 0, "00469b20");

    // 0046d980 (including sign-extension of high bit in low 16 bits, index 0xffff -> -1)
    g_vec_elements[0] = 0x12340000u;
    g_vec_elements[1] = address(g_cam_buf);
    g_vec_elements[2] = 0x56780000u;
    g_vec_header[0] = address(&g_vec_elements[1]);
    g_vec_header[1] = address(&g_vec_elements[3]);
    for (U idx : {0u, 1u, 0x00010000u, 0xffffffffu}) {
        for (bool null_cast : {false, true}) {
            ++cases;
            g_cast_null = null_cast;
            g_event_count = 0u;
            void* o_elem = reinterpret_cast<void*(__cdecl*)(U)>(slot_0046d980)(idx);
            const U o_ev = g_event_count;
            Event o_evs[kMaxEvents];
            std::memcpy(o_evs, g_events, o_ev * sizeof(Event));

            g_event_count = 0u;
            void* c_elem = porsche::scene_camera_elem_at_0046d980(idx);
            require(o_elem == c_elem, "0046d980 ret");
            require(g_event_count == o_ev && std::memcmp(g_events, o_evs, o_ev * sizeof(Event)) == 0, "0046d980 ev");
        }
    }
}

static void check_entry_fe_call_00413960() {
    g_vec_elements[1] = address(g_cam_buf);
    g_vec_header[0] = address(&g_vec_elements[1]);
    g_vec_header[1] = address(&g_vec_elements[2]);

    struct Scenario {
        bool cast_null;
        U s3e8;
        U s408;
        U slot_f3c;
        U slot_f40;
        U f78;
        U f7c;
        U f80;
        U f88;
        U f8c;
        U f90;
        U f98;
    };

    const Scenario scenarios[] = {
        {true,  0u, 0u, 0x0bu, 0x0fu, 11u, 1u, 1u, 0u, 1u, 1u, 1u}, // cam == nullptr
        {false, 3u, 1u, 0x0au, 0x00u, 11u, 1u, 1u, 0u, 1u, 1u, 1u}, // state==3,408!=0,f78==11,f3c==10 early ret
        {false, 3u, 1u, 0x0bu, 0x00u, 11u, 1u, 1u, 0u, 1u, 1u, 1u}, // state==3,408!=0,f78==11,f3c!=10 set bit3
        {false, 3u, 0u, 0x0bu, 0x0fu, 7u,  0u, 1u, 0u, 1u, 1u, 1u}, // f7c==0, all inner ifs true, f3c==11
        {false, 1u, 1u, 0x09u, 0x0fu, 7u,  0u, 0u, 1u, 0u, 0u, 0u}, // f7c==0, all inner ifs false, f3c!=11
        {false, 2u, 1u, 0x0bu, 0x0fu, 5u,  1u, 1u, 0u, 1u, 1u, 1u}, // f7c!=0, all inner ifs true (incl vslot38/40), f3c==11
        {false, 2u, 1u, 0x0bu, 0x0fu, 5u,  1u, 0u, 1u, 0u, 0u, 0u}, // f7c!=0, f88!=0, f80==0, f3c==11
    };

    for (const auto& sc : scenarios) {
        ++cases;
        g_cast_null = sc.cast_null;
        setup_cam(sc.f78, sc.f7c, sc.f80, 0x40200000u, sc.f88, sc.f8c, sc.f90, 0x41400000u, sc.f98, 0x42200000u, 0x42b40000u);

        std::array<B, 0x218u> init_table;
        init_table.fill(0xaau);
        std::memcpy(init_table.data() + (0x00627ea8u - 0x00627e80u), &sc.f80, 4u); // initial float slot_ea8
        store32(init_table.data(), 0x00627ea8u - 0x00627e80u, 0x41000000u);
        store32(init_table.data(), 0x00627f3cu - 0x00627e80u, 0xdead0000u | sc.slot_f3c);
        init_table[0x00627f40u - 0x00627e80u] = static_cast<B>(sc.slot_f40);

        // Run original x86
        g_orig_state_006573e8 = sc.s3e8;
        g_orig_state_00657408 = sc.s408;
        std::memcpy(g_orig_view_slot_table, init_table.data(), 0x218u);
        g_event_count = 0u;
        reinterpret_cast<void(__cdecl*)(U)>(slot_00413960)(0u);
        const U o_ev = g_event_count;
        Event o_evs[kMaxEvents];
        std::memcpy(o_evs, g_events, o_ev * sizeof(Event));

        // Run C++
        porsche::application_state_006573e8.word(0x006573e8u) = sc.s3e8;
        porsche::application_state_006573e8.word(0x00657408u) = sc.s408;
        std::memcpy(porsche::view_slot_table_00627e80, init_table.data(), 0x218u);
        g_event_count = 0u;
        porsche::entry_fe_call_00413960(0u);

        require(g_event_count == o_ev && std::memcmp(g_events, o_evs, o_ev * sizeof(Event)) == 0, "00413960 ev");
        require(std::memcmp(g_orig_view_slot_table, porsche::view_slot_table_00627e80, 0x218u) == 0, "00413960 view_slot_table");
    }
}

int main() {
    init();
    check_leaves();
    check_entry_fe_call_00413960();
    std::printf("entry_fe_call_832_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
