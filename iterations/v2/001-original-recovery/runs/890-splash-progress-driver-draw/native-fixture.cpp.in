    bind_rel32(slot_572b40, 0x00572b40u, 0x39u, 0x00537f90u, fn_ptr(&porsche::render_descriptor_bits_00537f90));
    bind_rel32(slot_572b40, 0x00572b40u, 0x49u, 0x005712f0u, fn_ptr(&porsche::splash_shape_row_stride_005712f0));
    bind_rel32(slot_572b40, 0x00572b40u, 0x15du, 0x00534b90u, fn_ptr(&porsche::render_shape_row_converter_00534b90));
    bind_rel32(slot_572b40, 0x00572b40u, 0x23cu, 0x005712f0u, fn_ptr(&porsche::splash_shape_row_stride_005712f0));

    // Bind 00572ee0
    bind_abs32(slot_572ee0, sizeof b_572ee0, 0x006bd94cu, ptr(&thrash_ref(0x006bd94cu)), 2u);
    bind_rel32(slot_572ee0, 0x00572ee0u, 0x3au, 0x00531f90u, fn_ptr(&porsche::free_00531f90));
    bind_rel32(slot_572ee0, 0x00572ee0u, 0x43u, 0x00531f90u, fn_ptr(&porsche::free_00531f90));

    // 15 span wrappers
    const B b_390[] = {@BODY_0053D390@}; const B b_3b0[] = {@BODY_0053D3B0@}; const B b_3d0[] = {@BODY_0053D3D0@};
    const B b_3f0[] = {@BODY_0053D3F0@}; const B b_410[] = {@BODY_0053D410@}; const B b_430[] = {@BODY_0053D430@};
    const B b_450[] = {@BODY_0053D450@}; const B b_470[] = {@BODY_0053D470@}; const B b_490[] = {@BODY_0053D490@};
    const B b_4b0[] = {@BODY_0053D4B0@}; const B b_4d0[] = {@BODY_0053D4D0@}; const B b_4f0[] = {@BODY_0053D4F0@};
    const B b_510[] = {@BODY_0053D510@}; const B b_530[] = {@BODY_0053D530@}; const B b_550[] = {@BODY_0053D550@};
    const struct { U va; const B* raw; U sz; U call_off; U target_va; U target_host; } sdefs[15] = {
        {0x0053d390u, b_390, sizeof b_390, 0x12u, 0x005b0000u, fn_ptr(&porsche::heap_copy_005b0000)},
        {0x0053d3b0u, b_3b0, sizeof b_3b0, 0x12u, 0x005b0000u, fn_ptr(&porsche::heap_copy_005b0000)},
        {0x0053d3d0u, b_3d0, sizeof b_3d0, 0x16u, 0x005b0000u, fn_ptr(&porsche::heap_copy_005b0000)},
        {0x0053d3f0u, b_3f0, sizeof b_3f0, 0x12u, 0x005b0c00u, ptr(slot_5b0c00)},
        {0x0053d410u, b_410, sizeof b_410, 0x12u, 0x005b0c00u, ptr(slot_5b0c00)},
        {0x0053d430u, b_430, sizeof b_430, 0x16u, 0x005b0c00u, ptr(slot_5b0c00)},
        {0x0053d450u, b_450, sizeof b_450, 0x12u, 0x005b0100u, fn_ptr(&porsche::heap_copy_005b0100)},
        {0x0053d470u, b_470, sizeof b_470, 0x12u, 0x005b0100u, fn_ptr(&porsche::heap_copy_005b0100)},
        {0x0053d490u, b_490, sizeof b_490, 0x16u, 0x005b0100u, fn_ptr(&porsche::heap_copy_005b0100)},
        {0x0053d4b0u, b_4b0, sizeof b_4b0, 0x12u, 0x005b02c0u, fn_ptr(&porsche::heap_copy_005b02c0)},
        {0x0053d4d0u, b_4d0, sizeof b_4d0, 0x12u, 0x005b02c0u, fn_ptr(&porsche::heap_copy_005b02c0)},
        {0x0053d4f0u, b_4f0, sizeof b_4f0, 0x16u, 0x005b02c0u, fn_ptr(&porsche::heap_copy_005b02c0)},
        {0x0053d510u, b_510, sizeof b_510, 0x12u, 0x005b0480u, fn_ptr(&porsche::heap_copy_005b0480)},
        {0x0053d530u, b_530, sizeof b_530, 0x12u, 0x005b0480u, fn_ptr(&porsche::heap_copy_005b0480)},
        {0x0053d550u, b_550, sizeof b_550, 0x16u, 0x005b0480u, fn_ptr(&porsche::heap_copy_005b0480)},
    };
    for (U i = 0u; i < 15u; ++i) {
        span_stubs[i] = code + 0x1000u + i * 0x40u;
        std::memcpy(span_stubs[i], sdefs[i].raw, sdefs[i].sz);
        bind_rel32(span_stubs[i], sdefs[i].va, sdefs[i].call_off, sdefs[i].target_va, sdefs[i].target_host);
    }

    require(FlushInstructionCache(GetCurrentProcess(), code, 16384u) != 0, "FlushInstructionCache");
}

static void reset_state(U salt, I sw, I sh) {
    std::memset(&trace, 0, sizeof trace);
    heap_cursor = 0u;
    talloc_calls = 0u;
    alloc_calls = 0u;
    tile_create_calls = 0u;
    porsche::render_choptex_handle_006a6450 = nullptr;
    porsche::render_choptex_color_005dfb7c = 0xabcdef01u ^ salt;
    std::memset(src_shape, 0, sizeof src_shape);
    wr(src_shape, 0u, 0xa55a0004u);
    wr(src_shape, 4u, static_cast<U>(sw & 0xffff) | (static_cast<U>(sh & 0xffff) << 16));
    for (U i = 16u; i < sizeof(src_shape); ++i) {
        src_shape[i] = static_cast<B>((i * 19u + salt) & 0xffu);
    }
    for (U i = 0u; i < sizeof(src_buf); ++i) {
        src_buf[i] = static_cast<B>((i * 23u + salt + 5u) & 0xffu);
        dst_buf[i] = static_cast<B>((0xc3u ^ (i * 7u) ^ salt) & 0xffu);
    }
}

static void run_driver_draw_case(B mode, U state, I backend, U sse_w, U mmx_w, U caps_w, U tfree_ret, bool pre_handle) {
    ++cases;
    for (side = 0u; side < 2u; ++side) {
        reset_state(cases * 17u, 100, 80);
        porsche::window_shutdown_mode_005de630 = mode;
        porsche::window_shutdown_state_005de64c = state;
        porsche::render_fill_backend_005decd8 = backend;
        porsche::shared_runtime_word_005deb1c = sse_w;
        porsche::copy_flag_005deb18 = mmx_w;
        force_about_caps_word = caps_w;
        force_tfree_ret = tfree_ret;
        fail_alloc_at = 0u; fail_tile_create_at = 0u; fail_talloc_at = 0u; force_conv_null = 0u;
        if (pre_handle) {
            auto* h = static_cast<porsche::RenderChopTex*>(bump_alloc(sizeof(porsche::RenderChopTex)));
            h->textures[0] = 0x5111u;
            h->textures[1] = 0x5222u;
            h->tile_shape = bump_alloc(16u + 64u * 64u * 2u);
            wr(h->tile_shape, 0u, 0x00000078u);
            wr(h->tile_shape, 4u, 64u | (64u << 16));
            porsche::render_choptex_handle_006a6450 = h;
        }
        void* fn = side == 0u ? static_cast<void*>(slot_53d570)
                              : reinterpret_cast<void*>(&porsche::splash_progress_driver_draw_0053d570);
        (void)invoke_cdecl3(fn, ptr(src_shape), 13u, static_cast<U>(-7), trace.abi_fail);
        require(trace.abi_fail == 0u, "53d570 ABI");
        trace.backend_val = static_cast<U>(porsche::render_fill_backend_005decd8);
        trace.handle_null = (porsche::render_choptex_handle_006a6450 == nullptr) ? 1u : 0u;
        if (side == 0u) expected = trace;
        else if (std::memcmp(&trace, &expected, sizeof trace) != 0) {
            std::printf("diff exp_cnt=%u got_cnt=%u exp_be=%u got_be=%u exp_hn=%u got_hn=%u\n",
                        expected.event_count, trace.event_count, expected.backend_val,
                        trace.backend_val, expected.handle_null, trace.handle_null);
            const U n = expected.event_count < trace.event_count ? expected.event_count : trace.event_count;
            for (U i = 0u; i < n; ++i) {
                if (std::memcmp(&expected.events[i], &trace.events[i], sizeof(Event)) != 0) {
                    std::printf("first_ev[%u] exp=(%u,%x,%x,%x,%x) got=(%u,%x,%x,%x,%x)\n",
                                i, expected.events[i].kind, expected.events[i].a0, expected.events[i].a1,
                                expected.events[i].a2, expected.events[i].a3,
                                trace.events[i].kind, trace.events[i].a0, trace.events[i].a1,
                                trace.events[i].a2, trace.events[i].a3);
                    break;
                }
            }
            require(false, "53d570 trace");
        }
    }
}

static void run_create_case(I depth, U f_alloc, U f_tile, U f_talloc) {
    ++cases;
    for (side = 0u; side < 2u; ++side) {
        reset_state(cases * 29u, 64, 64);
        fail_alloc_at = f_alloc; fail_tile_create_at = f_tile; fail_talloc_at = f_talloc;
        void* fn = side == 0u ? static_cast<void*>(slot_572a90)
                              : reinterpret_cast<void*>(&porsche::render_choptex_create_00572a90);
        const U res = invoke_cdecl4(fn, 64u, 32u, static_cast<U>(depth), 3u, trace.abi_fail);
        require(trace.abi_fail == 0u, "572a90 ABI");
        if (res != 0u) {
            const auto* c = reinterpret_cast<const porsche::RenderChopTex*>(static_cast<std::uintptr_t>(res));
            trace.result = c->textures[0] ^ (c->textures[1] << 8) ^ (rd(c->tile_shape, 0u) & 0xffu);
        } else {
            trace.result = 0u;
        }
        if (side == 0u) expected = trace;
        else require(std::memcmp(&trace, &expected, sizeof trace) == 0, "572a90 trace");
    }
}

static void run_draw_case(I sw, I sh, I tw, I th, I x, I y, I dw, I dh, U conv_null) {
    ++cases;
    for (side = 0u; side < 2u; ++side) {
        reset_state(cases * 37u, sw, sh);
        force_conv_null = conv_null;
        porsche::RenderChopTex chop{};
        chop.textures[0] = 0x3001u;
        chop.textures[1] = 0x3002u;
        chop.tile_shape = bump_alloc(16u + static_cast<U>(tw * th * 2));
        wr(chop.tile_shape, 0u, 0x00000078u);
        wr(chop.tile_shape, 4u, static_cast<U>(tw & 0xffff) | (static_cast<U>(th & 0xffff) << 16));
        void* fn = side == 0u ? static_cast<void*>(slot_572b40)
                              : reinterpret_cast<void*>(&porsche::render_choptex_draw_00572b40);
        trace.result = invoke_cdecl6(fn, ptr(&chop), ptr(src_shape),
                                     static_cast<U>(x), static_cast<U>(y),
                                     static_cast<U>(dw), static_cast<U>(dh), trace.abi_fail);
        require(trace.abi_fail == 0u, "572b40 ABI");
        if (side == 0u) expected = trace;
        else require(std::memcmp(&trace, &expected, sizeof trace) == 0, "572b40 trace");
    }
}

static void run_free_case(bool null_chop, U t0, U t1, bool has_tile, U tfree_ret) {
    ++cases;
    for (side = 0u; side < 2u; ++side) {
        reset_state(cases * 41u, 16, 16);
        force_tfree_ret = tfree_ret;
        porsche::RenderChopTex* chop = nullptr;
        if (!null_chop) {
            chop = static_cast<porsche::RenderChopTex*>(bump_alloc(sizeof(porsche::RenderChopTex)));
            chop->textures[0] = t0;
            chop->textures[1] = t1;
            chop->tile_shape = has_tile ? bump_alloc(32u) : nullptr;
        }
        void* fn = side == 0u ? static_cast<void*>(slot_572ee0)
                              : reinterpret_cast<void*>(&porsche::render_choptex_free_00572ee0);
        trace.result = invoke_cdecl1(fn, ptr(chop), trace.abi_fail);
        require(trace.abi_fail == 0u, "572ee0 ABI");
        if (side == 0u) expected = trace;
        else require(std::memcmp(&trace, &expected, sizeof trace) == 0, "572ee0 trace");
    }
}

static void run_span_and_fpu_cases() {
    const U offsets[] = {0u, 1u, 2u, 3u, 4u, 7u};
    const U sizes[] = {0u, 1u, 3u, 7u, 15u, 31u, 64u, 135u, 259u};
    for (U d_off : offsets) {
        for (U sz : sizes) {
            ++cases;
            for (side = 0u; side < 2u; ++side) {
                reset_state(cases * 13u, 16, 16);
                void* fn = side == 0u ? static_cast<void*>(slot_5b0c00)
                                      : reinterpret_cast<void*>(&porsche::heap_copy_005b0c00);
                (void)invoke_cdecl3(fn, ptr(dst_buf + d_off), ptr(src_buf + (d_off & 3u)), sz, trace.abi_fail);
                require(trace.abi_fail == 0u, "5b0c00 ABI");
                trace.dst_hash = hash_bytes(dst_buf, sizeof(dst_buf));
                if (side == 0u) expected = trace;
                else require(std::memcmp(&trace, &expected, sizeof trace) == 0, "5b0c00 trace");
            }
        }
    }

    void* const cpp_spans[15] = {
        reinterpret_cast<void*>(&porsche::render_span_scalar_16_0053d390),
        reinterpret_cast<void*>(&porsche::render_span_scalar_24_0053d3b0),
        reinterpret_cast<void*>(&porsche::render_span_scalar_32_0053d3d0),
        reinterpret_cast<void*>(&porsche::render_span_fpu_16_0053d3f0),
        reinterpret_cast<void*>(&porsche::render_span_fpu_24_0053d410),
        reinterpret_cast<void*>(&porsche::render_span_fpu_32_0053d430),
        reinterpret_cast<void*>(&porsche::render_span_mmx_a_16_0053d450),
        reinterpret_cast<void*>(&porsche::render_span_mmx_a_24_0053d470),
        reinterpret_cast<void*>(&porsche::render_span_mmx_a_32_0053d490),
        reinterpret_cast<void*>(&porsche::render_span_mmx_b_16_0053d4b0),
        reinterpret_cast<void*>(&porsche::render_span_mmx_b_24_0053d4d0),
        reinterpret_cast<void*>(&porsche::render_span_mmx_b_32_0053d4f0),
        reinterpret_cast<void*>(&porsche::render_span_sse_16_0053d510),
        reinterpret_cast<void*>(&porsche::render_span_sse_24_0053d530),
        reinterpret_cast<void*>(&porsche::render_span_sse_32_0053d550),
    };
    const U counts[] = {0u, 1u, 5u, 17u};
    for (U i = 0u; i < 15u; ++i) {
        for (U c : counts) {
            ++cases;
            for (side = 0u; side < 2u; ++side) {
                reset_state(cases * 7u, 16, 16);
                void* fn = side == 0u ? static_cast<void*>(span_stubs[i]) : cpp_spans[i];
                (void)invoke_cdecl3(fn, ptr(dst_buf), ptr(src_buf), c, trace.abi_fail);
                require(trace.abi_fail == 0u, "span ABI");
                trace.dst_hash = hash_bytes(dst_buf, sizeof(dst_buf));
                if (side == 0u) expected = trace;
                else require(std::memcmp(&trace, &expected, sizeof trace) == 0, "span trace");
            }
        }
    }
}

} // namespace

int main() {
    AddVectoredExceptionHandler(1, fault_handler);
    init_fixture();

    // Hardware mode combinations
    run_driver_draw_case(1u, 0u, -1, 0u, 0u, 1u, 1u, false);
    run_driver_draw_case(2u, 0u, -1, 0u, 0u, 2u, 0u, false);
    run_driver_draw_case(1u, 0u, 2, 1u, 1u, 1u, 1u, true);

    // Software mode combinations (all 5 backends + auto-detect)
    run_driver_draw_case(0u, 0u, -1, 1u, 1u, 0u, 1u, false);
    run_driver_draw_case(0xffu, 0u, -1, 0u, 1u, 0u, 1u, false);
    run_driver_draw_case(1u, 1u, -1, 0u, 0u, 0u, 1u, false);
    for (I b = 0; b <= 4; ++b) {
        run_driver_draw_case(0u, 0u, b, 0u, 0u, 0u, 1u, false);
    }

    // 00572a90 create & error exits
    run_create_case(6, 0u, 0u, 0u);
    run_create_case(7, 0u, 0u, 0u);
    run_create_case(6, 1u, 0u, 0u);
    run_create_case(6, 0u, 1u, 0u);
    run_create_case(6, 0u, 0u, 1u);
    run_create_case(6, 0u, 0u, 2u);

    // 00572b40 tiling, remainder clamping, scaling, failure
    run_draw_case(100, 80, 64, 64, 10, 20, 200, 120, 0u);
    run_draw_case(64, 64, 64, 64, -5, 0, 64, 64, 0u);
    run_draw_case(130, 30, 64, 32, 0, 0, 260, 60, 0u);
    run_draw_case(0, 64, 64, 64, 0, 0, 64, 64, 0u);
    run_draw_case(64, 64, 64, 64, 0, 0, 64, 64, 1u);

    // 00572ee0 free paths
    run_free_case(true, 0u, 0u, false, 1u);
    run_free_case(false, 0x11u, 0x22u, true, 1u);
    run_free_case(false, 0u, 0x22u, false, 0u);

    // 005b0c00 + 15 span copy wrappers
    run_span_and_fpu_cases();

    std::printf("render_driver_draw_890_original_x86_vs_cpp=PASS cases=%u\n", cases);
    std::fflush(stdout);
    return 0;
}
