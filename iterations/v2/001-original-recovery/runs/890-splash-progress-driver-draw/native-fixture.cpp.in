template <typename Fn>
static U fn_ptr(Fn* fn) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(reinterpret_cast<const void*>(fn)));
}

static U rd(const void* p, U offset = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + offset, sizeof v);
    return v;
}

static void wr(void* p, U offset, U value) {
    std::memcpy(static_cast<B*>(p) + offset, &value, sizeof value);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", msg, cases, side);
        std::fflush(stdout);
        ExitProcess(10u);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx eax=%08lx esp=%08lx ebp=%08lx case=%u side=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip,
                p->ContextRecord->Eax, p->ContextRecord->Esp, p->ContextRecord->Ebp,
                cases, side);
    std::fflush(stdout);
    ExitProcess(10u);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void event(U kind, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u) {
    require(trace.event_count < 512u, "event capacity");
    trace.events[trace.event_count++] = {kind, a0, a1, a2, a3};
}

static U hash_bytes(const void* p, U size) {
    const auto* b = static_cast<const B*>(p);
    U h = 2166136261u;
    for (U i = 0u; i < size; ++i) h = (h ^ b[i]) * 16777619u;
    return h;
}

static void* bump_alloc(U bytes) {
    const U aligned = (bytes + 15u) & ~15u;
    require(heap_cursor + aligned <= sizeof(heap_arena), "heap_arena");
    void* p = heap_arena + heap_cursor;
    heap_cursor += aligned;
    return p;
}

static void __cdecl rec_row_conv(void* dst, const void* src, I count) {
    const U sh = count > 0 ? hash_bytes(src, static_cast<U>(count) * 2u) : 0u;
    event(30u, static_cast<U>(count), sh, rd(src, 0u));
    for (I i = 0; i < count; ++i) {
        const std::uint16_t v = static_cast<const std::uint16_t*>(src)[i];
        static_cast<std::uint16_t*>(dst)[i] = static_cast<std::uint16_t>(v ^ 0x5a5au);
    }
}

