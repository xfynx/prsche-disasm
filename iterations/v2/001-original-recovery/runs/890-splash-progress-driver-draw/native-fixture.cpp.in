void* __cdecl application_allocator_entry_00531f70(
    const char* source, std::uint32_t bytes, std::uint32_t heap_index) {
    ++alloc_calls;
    const U tag_ok = (source != nullptr && std::strcmp(source, "CHOP texes") == 0) ? 1u : 0u;
    if (alloc_calls == fail_alloc_at) {
        event(1u, tag_ok, bytes, heap_index, 0u);
        return nullptr;
    }
    void* p = bump_alloc(bytes);
    event(1u, tag_ok, bytes, heap_index, 1u);
    return p;
}

