    event(2u, p != nullptr ? 1u : 0u);
    return 1u;
}

void __cdecl heap_fill_0053c290(void* dst, std::uint32_t val, std::uint32_t bytes) {
    event(3u, bytes, val);
    std::memset(dst, static_cast<int>(val & 0xffu), bytes);
}

std::uint32_t __cdecl render_descriptor_format_00556880(std::uint32_t depth) {
    const U fmt = (depth == 6u) ? 0x7eu : 0x78u;
    event(4u, depth, fmt);
    return fmt;
}

std::uint32_t __cdecl render_descriptor_bits_00537f90(const void* descriptor) {
    const U t = rd(descriptor, 0u) & 0xffu;
    const U b = (t == 0x7eu) ? 15u : ((t == 0x78u || t == 0x04u) ? 16u : 32u);
    event(5u, t, b);
    return b;
}

std::int32_t __cdecl splash_shape_row_stride_005712f0(const void* shape) {
    const I w = static_cast<std::int16_t>(rd(shape, 4u) & 0xffffu);
    const U t = rd(shape, 0u) & 0xffu;
    const I bpp = (t == 0x7eu || t == 0x78u || t == 0x04u) ? 2 : 4;
    const I stride = ((w * bpp) + 3) & ~3;
    event(6u, t, static_cast<U>(w), static_cast<U>(stride));
    return stride;
}

void* __cdecl scene_texture_shape_create_00574c70(
    std::int32_t w, std::int32_t h, std::int32_t depth, std::uint32_t flags) {
    ++tile_create_calls;
    if (tile_create_calls == fail_tile_create_at) {
        event(7u, static_cast<U>(w), static_cast<U>(h), static_cast<U>(depth), 0u);
        return nullptr;
    }
    B* p = static_cast<B*>(bump_alloc(16u + static_cast<U>(w * h * 4)));
    std::memset(p, 0, 16u + static_cast<U>(w * h * 4));
    wr(p, 0u, 0xabcd0000u | (depth == 15 ? 0x7eu : 0x78u));
    wr(p, 4u, static_cast<U>(w & 0xffff) | (static_cast<U>(h & 0xffff) << 16));
    event(7u, static_cast<U>(w), static_cast<U>(h), static_cast<U>(depth), flags);
    return p;
}

void* __cdecl render_shape_row_converter_00534b90(
    const void* shape, std::uint32_t target_type, std::int32_t direct_mode) {
    const U st = rd(shape, 0u) & 0xffu;
    event(8u, st, target_type, static_cast<U>(direct_mode), force_conv_null);
    if (force_conv_null != 0u) {
        return nullptr;
    }
    return reinterpret_cast<void*>(&rec_row_conv);
}

void __cdecl render_shape_transfer_00571630(
    const void* shape, std::int32_t x, std::int32_t y, const void* const* table) {
    U table_idx = 99u;
    const void* const* expected_tbls[5] = {
        render_span_table_scalar_005dec38,
        render_span_table_fpu_005dec58,
        render_span_table_mmx_a_005dec78,
        render_span_table_mmx_b_005dec98,
        render_span_table_sse_005decb8,
    };
    for (U i = 0u; i < 5u; ++i) {
        if (table == reinterpret_cast<const void* const*>(tables_raw[i]) || table == expected_tbls[i]) {
            table_idx = i;
            break;
        }
    }
    require(table_idx < 5u, "known span table");
    // Compare all 8 table slots (normalizing raw VA stubs vs C++ pointers).
    const U slot5 = ptr(table[5]);
    const U slot6 = ptr(table[6]);
    const U slot7 = ptr(table[7]);
    event(9u, static_cast<U>(x), static_cast<U>(y), table_idx, (slot5 ^ (slot6 << 4) ^ (slot7 << 8)));
}

