static void bind_abs32(B* base, U size, U old_va, U new_va, U expected_hits) {
    U hits = 0u;
    for (U i = 0u; i + 4u <= size; ++i) {
        if (rd(base, i) == old_va) {
            wr(base, i, new_va);
            ++hits;
            i += 3u;
        }
    }
    require(hits == expected_hits, "bind_abs32 count");
}

static void bind_rel32(B* base, U base_va, U offset, U original_target, U replacement, B opcode = 0xe8u) {
    require(base[offset] == opcode, "bind_rel32 opcode");
    const U decoded = base_va + offset + 5u + rd(base, offset + 1u);
    require(decoded == original_target, "bind_rel32 target");
    wr(base, offset + 1u, replacement - (ptr(base) + offset + 5u));
}

