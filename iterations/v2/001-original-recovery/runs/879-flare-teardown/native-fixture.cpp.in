static void __fastcall destroy(void* p,void*,unsigned flags){ev(1,(static_cast<U*>(p)-&objects[0][0])*4);ev(2,flags);static_cast<U*>(p)[1]^=0x13456789;if(scenario&1)slots[9]=0;}
