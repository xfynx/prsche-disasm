using Fn=decltype(&porsche::scene_flare_teardown_0045db10);
static Fn prepare(){
 auto* code=static_cast<B*>(VirtualAlloc(nullptr,4096,MEM_RESERVE|MEM_COMMIT,PAGE_READWRITE));require(code!=nullptr,"alloc");memcpy(code,original,sizeof original);
