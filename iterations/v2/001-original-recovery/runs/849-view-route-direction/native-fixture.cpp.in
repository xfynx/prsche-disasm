enum : U { kMaxEvents = 256u, kArenaBytes = 0x20000u };

struct SideChannel {
    B arena[kArenaBytes];
    U arena_used;
    B heap_state[0x100u];
    U heap_lock_obj;
    Event events[kMaxEvents];
    U event_count;
};

