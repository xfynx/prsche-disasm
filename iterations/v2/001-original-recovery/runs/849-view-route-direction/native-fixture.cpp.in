static void side_reset(SideChannel* s) {
    std::memset(s, 0, sizeof(*s));
    store32(s->heap_state, 0x28u, addr32(&s->heap_lock_obj));
}

static void log_event(U kind, U a = 0u, U b = 0u, U c = 0u, U d = 0u) {
    if (g_active_side->event_count < kMaxEvents) {
        Event& ev = g_active_side->events[g_active_side->event_count++];
        ev.kind = kind;
        ev.a = a;
        ev.b = b;
        ev.c = c;
        ev.d = d;
    }
}

static void* side_alloc_bytes(U bytes) {
    const U aligned = (bytes + 15u) & ~15u;
    require(g_active_side->arena_used + aligned <= kArenaBytes, "arena_overflow");
    void* const p = g_active_side->arena + g_active_side->arena_used;
    g_active_side->arena_used += aligned;
    std::memset(p, 0xcd, aligned);
    return p;
}

static U side_rel_ptr(const SideChannel* s, U raw) {
    if (raw == 0u) {
        return 0u;
    }
    const U base = addr32(s->arena);
    if (raw >= base && raw < base + kArenaBytes) {
        return 0x10000000u + (raw - base);
    }
    const U hbase = addr32(s->heap_state);
    if (raw >= hbase && raw < hbase + sizeof(s->heap_state)) {
        return 0x20000000u + (raw - hbase);
    }
    if (raw == addr32(&s->heap_lock_obj)) {
        return 0x30000000u;
    }
    return raw;
}

