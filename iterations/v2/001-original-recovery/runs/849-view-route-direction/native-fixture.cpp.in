void __cdecl transform_vectors_00532a40(
    I count, const float* input_vec3, const void* matrix_3x3, float* output_vec3) {
    const float* const m = static_cast<const float*>(matrix_3x3);
    for (I i = 0; i < count; ++i) {
        const float x = input_vec3[i * 3 + 0];
        const float y = input_vec3[i * 3 + 1];
        const float z = input_vec3[i * 3 + 2];
        output_vec3[i * 3 + 0] = x * m[0] + y * m[3] + z * m[6];
        output_vec3[i * 3 + 1] = x * m[1] + y * m[4] + z * m[7];
        output_vec3[i * 3 + 2] = x * m[2] + y * m[5] + z * m[8];
    }
    log_event(kEvTransformVec, static_cast<U>(count),
        f32_bits(output_vec3[0]), f32_bits(output_vec3[1]), f32_bits(output_vec3[2]));
}

