// Controlled fake surface object (shared vtable layout for C++ and native x86)
// ---------------------------------------------------------------------------
struct FakeSurface {
    void** vtable;      // +0x00
    U pad04;            // +0x04
    std::uint16_t tag8; // +0x08
    std::uint16_t flags;// +0x0a
    U id;               // +0x0c (test id)
    float center[3];    // +0x10
    float normal[3];    // +0x1c
    float verts[4][3];  // +0x28
    I vcount;           // +0x58
    B contains_ret;     // +0x5c
    float hit_bounds[4];// +0x60: minx, maxx, minz, maxz (optional dynamic contains)
    bool use_box;
};

static void __fastcall surf_get_center(FakeSurface* s, void*, float* out_vec3) {
    out_vec3[0] = s->center[0];
    out_vec3[1] = s->center[1];
    out_vec3[2] = s->center[2];
    log_event(kEvSurfCenter, s->id);
}

static B __fastcall surf_contains(FakeSurface* s, void*, const float* pos) {
    B ret = s->contains_ret;
    if (s->use_box) {
        ret = (s->hit_bounds[0] <= pos[0] && pos[0] <= s->hit_bounds[1] &&
               s->hit_bounds[2] <= pos[2] && pos[2] <= s->hit_bounds[3]) ? 1u : 0u;
    }
    log_event(kEvSurfContains, s->id, ret);
    return ret;
}

static void __fastcall surf_get_normal(FakeSurface* s, void*, float* out_vec3) {
    out_vec3[0] = s->normal[0];
    out_vec3[1] = s->normal[1];
    out_vec3[2] = s->normal[2];
    log_event(kEvSurfNormal, s->id);
}

static const float* __fastcall surf_get_vertex(FakeSurface* s, void*, I idx) {
    log_event(kEvSurfVertex, s->id, static_cast<U>(idx));
    return s->verts[idx];
}

static I __fastcall surf_vertex_count(FakeSurface* s, void*) {
    log_event(kEvSurfVCount, s->id);
    return s->vcount;
}

