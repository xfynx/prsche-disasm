static void __cdecl diagnostic_record(const char* format, ...) {
    va_list args;
    va_start(args, format);
    const U type = va_arg(args, U);
    va_end(args);
    push_event(kEvDiagnostic, address(format), type, 0u);
}

void (__cdecl* diagnostic_handler_005debf0)(const char*) =
    reinterpret_cast<void (__cdecl*)(const char*)>(&diagnostic_record);

void* __cdecl render_resource_node_palette_00537fb0(const void* descriptor) {
    void* const ret = (lookup_mode == kLookupClut) ? lookup_result : nullptr;
    push_event(kEvLookup, address(descriptor), address(ret), 0u);
    return ret;
}

} // namespace porsche

static void fill_lcg(B* p, U n, U seed) {
    U rng = seed * 0x9e3779b9u + 0x13572468u;
    for (U i = 0u; i < n; ++i) {
        rng = rng * 1664525u + 1013904223u;
        p[i] = static_cast<B>(rng >> 13);
    }
}

static void init_fixture() {
    static const B body_5346d0[kBodyBytes] = {@BODY_005346d0@};

    code = static_cast<B*>(
        VirtualAlloc(nullptr, 8192u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc code");

    slot_5346d0 = code + 0x000u;
    std::memcpy(slot_5346d0, body_5346d0, kBodyBytes);

    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00537fb0u,
                 reinterpret_cast<const void*>(&porsche::render_resource_node_palette_00537fb0),
                 1u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00571160u,
                 reinterpret_cast<const void*>(&porsche::render_palette_rgb24_to_8888_00571160),
                 1u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00570820u,
                 reinterpret_cast<const void*>(&porsche::render_palette_565_to_8888_key_00570820),
                 1u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00570780u,
                 reinterpret_cast<const void*>(&porsche::render_palette_5551_to_8888_key_00570780),
                 2u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00570990u,
                 reinterpret_cast<const void*>(&porsche::render_palette_a565_to_8888_00570990),
                 1u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00570920u,
                 reinterpret_cast<const void*>(&porsche::render_palette_a555_to_8888_00570920),
                 1u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00570ff0u,
                 reinterpret_cast<const void*>(&porsche::render_palette_vga6_to_8888_00570ff0),
                 1u);
    relocate_rel(slot_5346d0, kBodyBytes, 0x005346d0u, 0x00570260u,
                 reinterpret_cast<const void*>(&porsche::render_palette_swap_rb555_00570260),
                 1u);
    relocate_abs(slot_5346d0, kBodyBytes, 0x005deb74u, &porsche::shared_runtime_word_005deb74, 1u);
    relocate_abs(slot_5346d0, kBodyBytes, 0x005deb78u, &porsche::shared_runtime_word_005deb78, 1u);
    relocate_abs(slot_5346d0, kBodyBytes, 0x005debf0u, &porsche::diagnostic_handler_005debf0, 1u);
    relocate_abs(slot_5346d0, kBodyBytes, 0x005bb3fcu, porsche::render_getclutptr_message_005bb3fc, 1u);
    relocate_abs(slot_5346d0, kBodyBytes, 0x005bb3e4u, porsche::render_clut16_file_005bb3e4, 1u);
    relocate_abs(slot_5346d0, kBodyBytes, 0x006b4b20u, porsche::render_pixel_palette_006b4b20, 1u);

    require(FlushInstructionCache(GetCurrentProcess(), code, 8192u) != 0, "FlushInstructionCache");
}

static void assert_traces_match() {
    require(expected.abi_fail == 0u, "original abi fail");
    require(trace.abi_fail == 0u, "cpp abi fail");
    require(trace.ret == expected.ret, "return pointer");
    require(trace.file_word == expected.file_word, "diagnostic file word");
    require(trace.line_word == expected.line_word, "diagnostic line word");
    require(trace.event_count == expected.event_count, "event count");
    for (U i = 0u; i < trace.event_count; ++i) {
        require(trace.events[i].kind == expected.events[i].kind, "event kind");
        require(trace.events[i].a == expected.events[i].a, "event arg0");
        require(trace.events[i].b == expected.events[i].b, "event arg1");
        require(trace.events[i].c == expected.events[i].c, "event arg2");
    }
    require(std::memcmp(trace.palette, expected.palette, kPaletteBytes) == 0, "palette bytes");
    require(std::memcmp(trace.descriptor, expected.descriptor, kDescriptorBytes) == 0,
            "descriptor bytes");
    check_fpu_clean(expected.fp, trace.fp);
}

static void snapshot_into(const B* palette, const B* descriptor) {
    trace.file_word = porsche::shared_runtime_word_005deb74;
    trace.line_word = porsche::shared_runtime_word_005deb78;
    std::memcpy(trace.palette, palette, kPaletteBytes);
    std::memcpy(trace.descriptor, descriptor, kDescriptorBytes);
}

static void fill_pixel_palette(U seed) {
    U rng = seed * 0x2545f491u + 0x6a09e667u;
    for (U i = 0u; i < 256u; ++i) {
        rng = rng * 1664525u + 1013904223u;
        put_word(porsche::render_pixel_palette_006b4b20, i * 4u, rng);
    }
}

static void seed_case(I count, U header, U seed) {
    fill_lcg(descriptor_buffer, sizeof descriptor_buffer, seed + 0x51u);
    put_word(descriptor_buffer, kClutOffset, header);
    put_word(descriptor_buffer, kClutOffset + 4u,
             0x12340000u | static_cast<U>(static_cast<std::uint16_t>(count)));
    fill_lcg(palette_buffer, sizeof palette_buffer, seed + 0x77u);
    fill_pixel_palette(seed + 0x99u);
    porsche::render_palette_color_key_006a6420 =
        (seed & 1u) ? 0x00001234u : 0x0000f800u;
    porsche::shared_runtime_word_005deb74 = 0u;
    porsche::shared_runtime_word_005deb78 = 0x5a5a5a5au;
}

static void run_side(U side, I count, U header, LookupMode mode) {
    std::memset(&trace, 0, sizeof trace);
    lookup_mode = mode;
    lookup_result = descriptor_buffer + kClutOffset;

    seed_case(count, header, cases + (mode == kLookupNull ? 7u : 0u));

    void* const fn = (side == 0u)
                         ? static_cast<void*>(slot_5346d0)
                         : reinterpret_cast<void*>(
                               &porsche::render_getclutptr_from_resource_005346d0);
    trace.ret = invoke_cdecl2(fn, address(descriptor_buffer), address(palette_buffer),
                              trace.fp, trace.abi_fail);
    snapshot_into(palette_buffer, descriptor_buffer);
}

static void one_case(I count, U header, LookupMode mode) {
    ++cases;
    for (U side = 0u; side < 2u; ++side) {
        which = side;
        run_side(side, count, header, mode);
        if (side == 0u) {
            expected = trace;
        }
    }
    assert_traces_match();
}

static void test_5346d0() {
    static const I counts[] = {-32768, -2, -1, 0, 1, 3, 16, 255, 256};
    static const U types[] = {
        0x2au, 0x24u, 0x29u, 0x2du, 0x2cu, 0x2eu, 0x22u, 0x23u,
        0x21u, 0x00u, 0xffu,
    };

    for (I count : counts) {
        for (U type : types) {
            one_case(count, type, kLookupClut);
        }
    }

    static const U high_headers[] = {0x55000029u, 0x2b000024u, 0xff00002au};
    for (U header : high_headers) {
        one_case(16, header, kLookupClut);
    }

    one_case(0, 0x2au, kLookupNull);
    one_case(16, 0x24u, kLookupNull);
}

int main() {
    AddVectoredExceptionHandler(1u, fault_handler);
    require(porsche::shared_runtime_word_005deb74 == 0u, "initial diagnostic file word");
    require(porsche::shared_runtime_word_005deb78 == 0u, "initial diagnostic line word");
    init_fixture();
    test_5346d0();
    std::printf("getclutptr_696_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
