using U = std::uint32_t;
using I = std::int32_t;
using H = std::uint16_t;
using B = std::uint8_t;

enum : U {
    kMaxEvents = 200u,
    kPaletteBytes = 0x400u,
    kDescriptorBytes = 0x800u,
    kClutOffset = 0x40u,
    kBodyBytes = 352u,
};

enum EventKind : U {
    kEvLookup = 1u,
    kEvDiagnostic = 2u,
};

enum LookupMode : U {
    kLookupNull = 0u,
    kLookupClut = 1u,
};

struct Event {
    U kind;
    U a;
    U b;
    U c;
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret;
    U file_word;
    U line_word;
    U event_count;
    Event events[kMaxEvents];
    B palette[kPaletteBytes];
    B descriptor[kDescriptorBytes];
    FpuSnapshot fp;
};

alignas(16) static B fp_area[512] = {};
static B fp_env[28] = {};

static B* code = nullptr;
static B* slot_5346d0 = nullptr;

static Trace trace{};
static Trace expected{};
static U cases = 0u;
static U which = 0u;
static U lookup_mode = kLookupClut;
static void* lookup_result = nullptr;
static B palette_buffer[kPaletteBytes + 0x40u];
static B descriptor_buffer[kDescriptorBytes + 0x40u];

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U word_at(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void put_word(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", msg, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode,
                p->ContextRecord->Eip,
                cases,
                which);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void seed_fpu() {
    const unsigned short cw = 0x037fu;
    __asm {
        fninit
        fldcw cw
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static void capture_fpu(FpuSnapshot& fp) {
    std::memset(&fp, 0, sizeof fp);
    __asm {
        fxsave fp_area
        fnstenv fp_env
        fldenv fp_env
    }
    fp.control = static_cast<unsigned short>(word_at(fp_area, 0u));
    fp.status = static_cast<unsigned short>(word_at(fp_area, 2u));
    fp.tag = static_cast<unsigned short>(word_at(fp_env, 8u));
    fp.pad = 0u;
    fp.mxcsr = word_at(fp_area, 24u);
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(fp.values + i * 10u, fp_area + 32u + i * 16u, 10u);
        if ((fp_area[4u] & (1u << (((fp.status >> 11u) + i) & 7u))) == 0u) {
            std::memset(fp.values + i * 10u, 0, 10u);
        }
    }
}

static void check_fpu_clean(const FpuSnapshot& orig_fp, const FpuSnapshot& cpp_fp) {
    require(orig_fp.control == cpp_fp.control, "FPU control");
    require(orig_fp.status == cpp_fp.status, "FPU status");
    require(orig_fp.tag == cpp_fp.tag, "FPU tag");
    require(orig_fp.mxcsr == cpp_fp.mxcsr, "FPU mxcsr");
    require(std::memcmp(orig_fp.values, cpp_fp.values, sizeof orig_fp.values) == 0, "FPU stack");
}

static U invoke_cdecl2(void* fn, U arg0, U arg1, FpuSnapshot& fp_out, U& abi_fail) {
    U out = 0u;
    U fail = 0u;
    U before = 0u;
    U frame = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg1
        push arg0
        mov eax, 0a5a5a500h
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        add esp, 8
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
    return out;
}

static void push_event(U kind, U a, U b, U c) {
    require(trace.event_count < kMaxEvents, "event overflow");
    Event& ev = trace.events[trace.event_count++];
    ev.kind = kind;
    ev.a = a;
    ev.b = b;
    ev.c = c;
}

static void relocate_rel(B* p, U n, U va_base, U target_va, const void* replacement,
                         U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 5u <= n; ++i) {
        if (p[i] == 0xe8u &&
            (va_base + i + 5u + static_cast<I>(word_at(p, i + 1u))) == target_va) {
            put_word(p, i + 1u,
                     address(replacement) - (address(p) + i + 5u));
            ++found;
            i += 4u;
        }
    }
    require(found == expected_count, "rel relocation count");
}

static void relocate_abs(B* p, U n, U old_va, const void* replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 4u <= n; ++i) {
        if (word_at(p, i) == old_va) {
            put_word(p, i, address(replacement));
            ++found;
            i += 3u;
        }
    }
    require(found == expected_count, "absolute relocation count");
}

