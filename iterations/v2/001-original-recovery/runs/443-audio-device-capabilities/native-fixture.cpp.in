    absolute(WINDOW,17,0x5b2294,&iat_foreground,1);absolute(WINDOW,17,0x5b2274,&iat_desktop,1);absolute(THUNK,6,0x5b2038,&iat_create,1);
    absolute(PROPERTY,258,0x6ad760,&audio_ds_device_006ad760,1);absolute(PROPERTY,258,0x6ad779,&audio_ds_property_available_006ad779,2);
    absolute(PROPERTY,258,0x6aefdc,&audio_ds_property_006aefdc,2);absolute(PROPERTY,258,0x6aefe0,&audio_ds_temporary_006aefe0,4);
    absolute(PROPERTY,258,0x5bfd40,audio_property_interface_guid_005bfd40,1);absolute(PROPERTY,258,0x5c17d8,audio_property_set_guid_005c17d8,1);
    absolute(CLEANUP,53,0x6aefdc,&audio_ds_property_006aefdc,2);absolute(CLEANUP,53,0x6aefe0,&audio_ds_temporary_006aefe0,2);
