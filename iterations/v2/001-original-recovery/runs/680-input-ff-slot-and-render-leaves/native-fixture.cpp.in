using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static_assert(sizeof(porsche::InputSlot) == 0x10cu);
static_assert(sizeof(porsche::input_slots_006be040) == 32u * 0x10cu);
static_assert(sizeof(porsche::frame_control_slot_fields_494) == 32u * 12u);
static_assert(sizeof(porsche::window_shutdown_config_005de620) == 48u);

enum : U {
    kMaxEvents = 64u,
    kFcRecordBytes = 0x90u,
};

enum EventKind : U {
    kEvFxDownload = 1u,
    kEvFxUnload = 2u,
    kEvAcquire = 3u,
    kEvFfCmd = 4u,
};

struct Event {
    U kind;
    U a0;
    U a1;
    U a2;
};

struct TestEffectVtable {
    void* other_00[10];
    U(__stdcall* download_28)(void*);
    U(__stdcall* unload_2c)(void*);
};

struct TestEffect {
    TestEffectVtable* vtable;
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_u32;
    U event_count;
    Event events[kMaxEvents];
    porsche::FrameControlSlotFields_494 fc_fields[32];
    porsche::FrameControlSlotFields_494 pre_call_fc_fields[32];
    FpuSnapshot fp;
};

alignas(16) static B fp_area[512] = {};
static B fp_env[28] = {};

static B* code = nullptr;
static B* slot_5337a0 = nullptr;
static B* slot_5337e0 = nullptr;
static B* slot_533730 = nullptr;
static B* slot_533760 = nullptr;
static B* slot_533120 = nullptr;
static B* slot_574080 = nullptr;

// Flat original 32 x 0x90-byte records for 0069cb90..0069dd8f.
alignas(16) static B orig_fc_slots[32u * kFcRecordBytes] = {};

static Trace trace{};
static Trace expected{};
static U cases = 0u;
static U which = 0u;

struct MockState {
    U dl_calls;
    U dl_hr0;
    U dl_hr1;
    U acq_hr;
    U unload_hr;
    TestEffectVtable* swap_fx_after_dl0;
    TestEffectVtable* swap_fx_after_acq;
    U ff_cmd_ret;
    bool ff_mutate_fc;
    U ff_mutate_slot;
    U ff_mutate_val;
};

static MockState mock{};
static porsche::InputVtable mock_dev_vt{};
static porsche::InputDevice mock_dev_main{};
static porsche::InputDevice mock_dev_other{};
static TestEffectVtable mock_fx_vt_main{};
static TestEffectVtable mock_fx_vt_alt{};
static TestEffect mock_fx_main{};

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U rd(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void wr(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", msg, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode,
                p->ContextRecord->Eip,
                cases,
                which);
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void seed_fpu() {
    const unsigned short cw = 0x037fu;
    __asm {
        fninit
        fldcw cw
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static void capture_fpu(FpuSnapshot& fp) {
    std::memset(&fp, 0, sizeof fp);
    __asm {
        fxsave fp_area
        fnstenv fp_env
        fldenv fp_env
    }
    fp.control = static_cast<unsigned short>(rd(fp_area, 0u));
    fp.status = static_cast<unsigned short>(rd(fp_area, 2u));
    fp.tag = static_cast<unsigned short>(rd(fp_env, 8u));
    fp.pad = 0u;
    fp.mxcsr = rd(fp_area, 24u);
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(fp.values + i * 10u, fp_area + 32u + i * 16u, 10u);
        if ((fp_area[4u] & (1u << (((fp.status >> 11u) + i) & 7u))) == 0u) {
            std::memset(fp.values + i * 10u, 0, 10u);
        }
    }
}

static void check_fpu_clean(const FpuSnapshot& orig_fp, const FpuSnapshot& cpp_fp) {
    require(orig_fp.control == cpp_fp.control, "FPU control");
    require(orig_fp.status == cpp_fp.status, "FPU status");
    require(orig_fp.tag == cpp_fp.tag, "FPU tag");
    require(orig_fp.mxcsr == cpp_fp.mxcsr, "FPU mxcsr");
    require(std::memcmp(orig_fp.values, cpp_fp.values, sizeof orig_fp.values) == 0, "FPU stack");
}

static U invoke_cdecl0(void* fn, FpuSnapshot& fp_out, U& abi_fail) {
    U out = 0u;
    U fail = 0u;
    U before = 0u;
    U frame = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0a5a5a500h
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
    return out;
}

static U invoke_cdecl1(void* fn, U arg0, FpuSnapshot& fp_out, U& abi_fail) {
    U out = 0u;
    U fail = 0u;
    U before = 0u;
    U frame = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg0
        mov eax, 0a5a5a500h
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        add esp, 4
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
    return out;
}

static U invoke_cdecl2(void* fn, U arg0, U arg1, FpuSnapshot& fp_out, U& abi_fail) {
    U out = 0u;
    U fail = 0u;
    U before = 0u;
    U frame = 0u;
    seed_fpu();
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg1
        push arg0
        mov eax, 0a5a5a500h
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        add esp, 8
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
bad:
        mov fail, 1
done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
    return out;
}

static void push_event(U kind, U a0, U a1, U a2) {
    require(trace.event_count < kMaxEvents, "event overflow");
    Event& ev = trace.events[trace.event_count++];
    ev.kind = kind;
    ev.a0 = a0;
    ev.a1 = a1;
    ev.a2 = a2;
}

static U __stdcall mock_fx_download_impl(void* fx_ptr, U vt_tag) {
    const U idx = mock.dl_calls++;
    const U hr = (idx == 0u) ? mock.dl_hr0 : mock.dl_hr1;
    push_event(kEvFxDownload, address(fx_ptr), (vt_tag << 16u) | idx, hr);
    auto* const fx = static_cast<TestEffect*>(fx_ptr);
    if (idx == 0u && mock.swap_fx_after_dl0 != nullptr) {
        fx->vtable = mock.swap_fx_after_dl0;
    }
    return hr;
}

static U __stdcall mock_fx_download_0(void* fx_ptr) {
    return mock_fx_download_impl(fx_ptr, 0u);
}

static U __stdcall mock_fx_download_1(void* fx_ptr) {
    return mock_fx_download_impl(fx_ptr, 1u);
}

static U __stdcall mock_fx_unload(void* fx_ptr) {
    push_event(kEvFxUnload, address(fx_ptr), 0u, mock.unload_hr);
    return mock.unload_hr;
}

static U __stdcall mock_acquire(void* device) {
    const U hr = mock.acq_hr;
    push_event(kEvAcquire, address(device), hr, 0u);
    if (mock.swap_fx_after_acq != nullptr) {
        mock_fx_main.vtable = mock.swap_fx_after_acq;
    }
    return hr;
}

static void capture_fc_from_orig(porsche::FrameControlSlotFields_494 out[32]) {
    for (U i = 0u; i < 32u; ++i) {
        out[i].active = rd(orig_fc_slots, i * kFcRecordBytes + 0u);
        out[i].device = rd(orig_fc_slots, i * kFcRecordBytes + 8u);
        out[i].state = rd(orig_fc_slots, i * kFcRecordBytes + 12u);
        for (U b = 0u; b < kFcRecordBytes; ++b) {
            if ((b >= 4u && b < 8u) || b >= 16u) {
                require(orig_fc_slots[i * kFcRecordBytes + b] == 0xaa, "fc padding intact");
            }
        }
    }
}

namespace porsche {

InputSlot input_slots_006be040[32] = {};
FrameControlSlotFields_494 frame_control_slot_fields_494[32] = {};
std::uint32_t window_shutdown_config_005de620[12] = {};

std::uint32_t __cdecl input_device_ff_command_00533160(
    InputDevice* device, std::uint32_t command) {
    if (which == 0u) {
        capture_fc_from_orig(trace.pre_call_fc_fields);
    } else {
        std::memcpy(trace.pre_call_fc_fields, frame_control_slot_fields_494,
                    sizeof trace.pre_call_fc_fields);
    }
    push_event(kEvFfCmd, address(device), command, mock.ff_cmd_ret);
    if (mock.ff_mutate_fc && mock.ff_mutate_slot < 32u) {
        if (which == 0u) {
            wr(orig_fc_slots, mock.ff_mutate_slot * kFcRecordBytes + 12u, mock.ff_mutate_val);
        } else {
            frame_control_slot_fields_494[mock.ff_mutate_slot].state = mock.ff_mutate_val;
        }
    }
    return mock.ff_cmd_ret;
}

} // namespace porsche

static void relocate_abs(B* p, U n, U old_va, U replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 4u <= n; ++i) {
        if (rd(p, i) == old_va) {
            wr(p, i, replacement);
            ++found;
            i += 3u;
        }
    }
    require(found == expected_count, "abs relocation count");
}

static void relocate_rel(B* p, U n, U va_base, U target_va, U replacement, U expected_count) {
    U found = 0u;
    for (U i = 0u; i + 5u <= n; ++i) {
        if (p[i] == 0xe8u && (va_base + i + 5u + rd(p, i + 1u)) == target_va) {
            wr(p, i + 1u, replacement - (address(p) + i + 5u));
            ++found;
            i += 4u;
        }
    }
    require(found == expected_count, "rel relocation count");
}

static void init_fixture() {
    for (U i = 0u; i < 12u; ++i) {
        require(porsche::window_shutdown_config_005de620[i] == 0u, "initial 005de620 zero");
    }

    static const B body_5337a0[54] = {@BODY_005337A0@};
    static const B body_5337e0[41] = {@BODY_005337E0@};
    static const B body_533730[40] = {@BODY_00533730@};
    static const B body_533760[64] = {@BODY_00533760@};
    static const B body_533120[60] = {@BODY_00533120@};
    static const B body_574080[29] = {@BODY_00574080@};

    code = static_cast<B*>(
        VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc code");

    slot_5337a0 = code + 0x000u;
    slot_5337e0 = code + 0x050u;
    slot_533730 = code + 0x090u;
    slot_533760 = code + 0x0d0u;
    slot_533120 = code + 0x130u;
    slot_574080 = code + 0x180u;

    std::memcpy(slot_5337a0, body_5337a0, 54u);
    std::memcpy(slot_5337e0, body_5337e0, 41u);
    std::memcpy(slot_533730, body_533730, 40u);
    std::memcpy(slot_533760, body_533760, 64u);
    std::memcpy(slot_533120, body_533120, 60u);
    std::memcpy(slot_574080, body_574080, 29u);

    // 005337e0 relocations
    relocate_abs(slot_5337e0, 41u, 0x0069cb9cu, address(orig_fc_slots + 12u), 1u);
    relocate_abs(slot_5337e0, 41u, 0x0069cb98u, address(orig_fc_slots + 8u), 1u);

    // 00533730 relocations
    relocate_abs(slot_533730, 40u, 0x0069cb9cu, address(orig_fc_slots + 12u), 1u);
    relocate_abs(slot_533730, 40u, 0x0069dd9cu,
                 address(orig_fc_slots + 32u * kFcRecordBytes + 12u), 1u);

    // 00533760 relocations
    relocate_abs(slot_533760, 64u, 0x0069cb9cu, address(orig_fc_slots + 12u), 1u);
    relocate_abs(slot_533760, 64u, 0x0069cb98u, address(orig_fc_slots + 8u), 1u);
    relocate_abs(slot_533760, 64u, 0x006be040u, address(porsche::input_slots_006be040), 1u);
    relocate_rel(slot_533760, 64u, 0x00533760u, 0x005337a0u, address(slot_5337a0), 1u);

    // 00533120 relocations
    relocate_abs(slot_533120, 60u, 0x0069cb9cu, address(orig_fc_slots + 12u), 1u);
    relocate_abs(slot_533120, 60u, 0x0069dd9cu,
                 address(orig_fc_slots + 32u * kFcRecordBytes + 12u), 1u);
    relocate_abs(slot_533120, 60u, 0x006be040u, address(porsche::input_slots_006be040), 1u);
    relocate_rel(
        slot_533120,
        60u,
        0x00533120u,
        0x00533160u,
        address(reinterpret_cast<const void*>(&porsche::input_device_ff_command_00533160)),
        1u);

    // 00574080 relocations
    relocate_abs(slot_574080, 29u, 0x005de644u,
                 address(&porsche::window_shutdown_config_005de620[9]), 1u);
    relocate_abs(slot_574080, 29u, 0x005de62eu,
                 address(reinterpret_cast<const B*>(porsche::window_shutdown_config_005de620) + 0x0eu),
                 1u);

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");

    std::memset(&mock_dev_vt, 0, sizeof mock_dev_vt);
    mock_dev_vt.acquire_1c = mock_acquire;
    mock_dev_main.vtable = &mock_dev_vt;
    mock_dev_other.vtable = &mock_dev_vt;

    std::memset(&mock_fx_vt_main, 0, sizeof mock_fx_vt_main);
    std::memset(&mock_fx_vt_alt, 0, sizeof mock_fx_vt_alt);
    mock_fx_vt_main.download_28 = mock_fx_download_0;
    mock_fx_vt_main.unload_2c = mock_fx_unload;
    mock_fx_vt_alt.download_28 = mock_fx_download_1;
    mock_fx_vt_alt.unload_2c = mock_fx_unload;
    mock_fx_main.vtable = &mock_fx_vt_main;
}

static void assert_traces_match(U ret_mask) {
    require(expected.abi_fail == 0u, "original abi fail");
    require(trace.abi_fail == 0u, "cpp abi fail");
    if (ret_mask != 0u) {
        require((trace.ret_u32 & ret_mask) == (expected.ret_u32 & ret_mask), "return value");
    }
    require(trace.event_count == expected.event_count, "event count");
    for (U i = 0u; i < trace.event_count; ++i) {
        require(trace.events[i].kind == expected.events[i].kind, "event kind");
        require(trace.events[i].a0 == expected.events[i].a0, "event a0");
        require(trace.events[i].a1 == expected.events[i].a1, "event a1");
        require(trace.events[i].a2 == expected.events[i].a2, "event a2");
    }
    require(std::memcmp(trace.fc_fields, expected.fc_fields, sizeof trace.fc_fields) == 0,
            "frame control fields");
    require(std::memcmp(trace.pre_call_fc_fields, expected.pre_call_fc_fields,
                        sizeof trace.pre_call_fc_fields) == 0,
            "pre-call frame control fields");
    check_fpu_clean(expected.fp, trace.fp);
}

static void seed_fc_records(U base_seed, U default_state) {
    std::memset(orig_fc_slots, 0xaa, sizeof orig_fc_slots);
    for (U i = 0u; i < 32u; ++i) {
        const U active = base_seed + i * 3u + 1u;
        const U dev = address(&mock_fx_main);
        const U state = default_state;
        porsche::frame_control_slot_fields_494[i].active = active;
        porsche::frame_control_slot_fields_494[i].device = dev;
        porsche::frame_control_slot_fields_494[i].state = state;
        wr(orig_fc_slots, i * kFcRecordBytes + 0u, active);
        wr(orig_fc_slots, i * kFcRecordBytes + 8u, dev);
        wr(orig_fc_slots, i * kFcRecordBytes + 12u, state);
    }
}

static void set_fc_slot(U slot, U active, U dev, U state) {
    porsche::frame_control_slot_fields_494[slot].active = active;
    porsche::frame_control_slot_fields_494[slot].device = dev;
    porsche::frame_control_slot_fields_494[slot].state = state;
    wr(orig_fc_slots, slot * kFcRecordBytes + 0u, active);
    wr(orig_fc_slots, slot * kFcRecordBytes + 8u, dev);
    wr(orig_fc_slots, slot * kFcRecordBytes + 12u, state);
}

static void test_5337a0() {
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::input_effect_download_005337a0);
    struct Case5337a0 {
        U hr0;
        U acq_hr;
        U hr1;
        bool swap0;
        bool swap_acq;
    };
    static const Case5337a0 table[] = {
        {0x00000000u, 0u, 0u, false, false},
        {0x80004005u, 0u, 0u, false, false},
        {0x8007000bu, 0u, 0u, false, false},
        {0x8007001fu, 0u, 0u, false, false},
        {0x80040204u, 0u, 0u, false, false},
        {0x80040206u, 0u, 0u, false, false},
        {0x8007000cu, 0x00000000u, 0x00000000u, false, false},
        {0x8007001eu, 0x00000000u, 0x00000001u, false, false},
        {0x80040205u, 0x00000000u, 0x8007001eu, false, false},
        {0x8007000cu, 0x00000000u, 0x80004005u, true, false},
        {0x8007001eu, 0x00000000u, 0x00000000u, false, true},
        {0x8007000cu, 0x00000001u, 0x00000000u, false, false},
        {0x8007001eu, 0x80070005u, 0x00000000u, false, false},
        {0x80040205u, 0x8007000cu, 0x00000000u, true, false},
    };

    for (const auto& c : table) {
        ++cases;
        for (U side = 0u; side < 2u; ++side) {
            which = side;
            std::memset(&trace, 0, sizeof trace);
            std::memset(&mock, 0, sizeof mock);
            mock.dl_hr0 = c.hr0;
            mock.acq_hr = c.acq_hr;
            mock.dl_hr1 = c.hr1;
            mock.swap_fx_after_dl0 = c.swap0 ? &mock_fx_vt_alt : nullptr;
            mock.swap_fx_after_acq = c.swap_acq ? &mock_fx_vt_alt : nullptr;
            mock_fx_main.vtable = &mock_fx_vt_main;

            void* const fn = (side == 0u) ? slot_5337a0 : cpp_fn;
            trace.ret_u32 = invoke_cdecl2(
                fn, address(&mock_dev_main), address(&mock_fx_main), trace.fp, trace.abi_fail);
            if (side == 0u) {
                expected = trace;
            }
        }
        assert_traces_match(0xffffffffu);
    }
}

static void test_5337e0() {
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::frame_control_slot_unload_005337e0);
    static const I slots[] = {-2147483647 - 1, -1, 0, 1, 15, 31, 32, 33, 2147483647};
    static const U states[] = {0xffffffffu, 0u, 1u, 31u};

    for (I slot : slots) {
        for (U st : states) {
            ++cases;
            for (U side = 0u; side < 2u; ++side) {
                which = side;
                std::memset(&trace, 0, sizeof trace);
                std::memset(&mock, 0, sizeof mock);
                mock.unload_hr = 0x12345678u;
                mock_fx_main.vtable = &mock_fx_vt_main;
                seed_fc_records(0x20u, 0xffffffffu);
                if (slot >= 0 && slot < 32) {
                    set_fc_slot(static_cast<U>(slot), 1u, address(&mock_fx_main), st);
                }
                void* const fn = (side == 0u) ? slot_5337e0 : cpp_fn;
                (void)invoke_cdecl1(fn, static_cast<U>(slot), trace.fp, trace.abi_fail);
                if (side == 0u) {
                    capture_fc_from_orig(trace.fc_fields);
                    expected = trace;
                } else {
                    std::memcpy(trace.fc_fields, porsche::frame_control_slot_fields_494,
                                sizeof trace.fc_fields);
                }
            }
            assert_traces_match(0u);
        }
    }
}

static void test_533730() {
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::frame_control_slot_find_free_00533730);
    struct Case533730 {
        I free_slot;
        U fill_state;
        I extra_free;
    };
    static const Case533730 table[] = {
        {0, 0u, -1},
        {1, 0u, 5},
        {15, 2u, 20},
        {30, 0xfffffffeu, 31},
        {31, 7u, -1},
        {-1, 0u, -1},
        {-1, 0x12345678u, -1},
        {-1, 0xfffffffeu, -1},
    };

    for (const auto& c : table) {
        ++cases;
        for (U side = 0u; side < 2u; ++side) {
            which = side;
            std::memset(&trace, 0, sizeof trace);
            seed_fc_records(0x30u, c.fill_state);
            if (c.free_slot >= 0) {
                set_fc_slot(static_cast<U>(c.free_slot), 0u, address(&mock_fx_main), 0xffffffffu);
            }
            if (c.extra_free >= 0) {
                set_fc_slot(static_cast<U>(c.extra_free), 0u, address(&mock_fx_main), 0xffffffffu);
            }
            void* const fn = (side == 0u) ? slot_533730 : cpp_fn;
            trace.ret_u32 = invoke_cdecl0(fn, trace.fp, trace.abi_fail);
            if (side == 0u) {
                capture_fc_from_orig(trace.fc_fields);
                expected = trace;
            } else {
                std::memcpy(trace.fc_fields, porsche::frame_control_slot_fields_494,
                            sizeof trace.fc_fields);
            }
        }
        assert_traces_match(0xffffffffu);
    }
}

