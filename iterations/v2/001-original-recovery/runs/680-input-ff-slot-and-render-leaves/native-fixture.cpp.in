static void test_533120() {
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::input_slot_reset_ff_00533120);
    struct Case533120 {
        I slot_index;
        bool has_device;
        U ff_ret;
        U match_mask;
        bool mutate_fc;
        U mutate_slot;
    };
    static const Case533120 table[] = {
        {0, true, 0x00000000u, 0x00000001u, false, 0u},
        {1, false, 0x80004005u, 0x00000000u, false, 0u},
        {2, true, 0x8007000cu, 0x80000000u, false, 0u},
        {15, true, 0x00000001u, 0x80010005u, false, 0u},
        {31, true, 0x00000000u, 0xffffffffu, false, 0u},
        {3, true, 0x80040205u, 0x00000008u, true, 3u},
        {31, true, 0x00000000u, 0x80000001u, true, 31u},
    };

    for (const auto& c : table) {
        ++cases;
        for (U side = 0u; side < 2u; ++side) {
            which = side;
            std::memset(&trace, 0, sizeof trace);
            std::memset(&mock, 0, sizeof mock);
            mock.ff_cmd_ret = c.ff_ret;
            mock.ff_mutate_fc = c.mutate_fc;
            mock.ff_mutate_slot = c.mutate_slot;
            mock.ff_mutate_val = static_cast<U>(c.slot_index);

            std::memset(porsche::input_slots_006be040, 0, sizeof porsche::input_slots_006be040);
            for (U i = 0u; i < 32u; ++i) {
                porsche::input_slots_006be040[i].device = (i & 1u) ? &mock_dev_other : &mock_dev_main;
            }
            porsche::input_slots_006be040[c.slot_index].device =
                c.has_device ? &mock_dev_main : nullptr;

            seed_fc_records(0x50u, 0xffffffffu);
            for (U i = 0u; i < 32u; ++i) {
                if ((c.match_mask & (1u << i)) != 0u) {
                    set_fc_slot(i, 100u + i, address(&mock_fx_main), static_cast<U>(c.slot_index));
                } else if ((i & 1u) == 0u) {
                    set_fc_slot(i, 200u + i, address(&mock_fx_main),
                                static_cast<U>((c.slot_index + 1) & 31));
                }
            }

            void* const fn = (side == 0u) ? slot_533120 : cpp_fn;
            trace.ret_u32 =
                invoke_cdecl1(fn, static_cast<U>(c.slot_index), trace.fp, trace.abi_fail);
            if (side == 0u) {
                capture_fc_from_orig(trace.fc_fields);
                expected = trace;
            } else {
                std::memcpy(trace.fc_fields, porsche::frame_control_slot_fields_494,
                            sizeof trace.fc_fields);
            }
        }
        assert_traces_match(0xffffffffu);
    }
}

static void test_574080() {
    void* const cpp_fn = reinterpret_cast<void*>(&porsche::render_pixel_offset_00574080);
    static const B bpps[] = {0u, 1u, 4u, 8u, 15u, 16u, 24u, 32u, 255u};
    static const U pitches[] = {0u, 640u, 1280u, 0xfffffb00u, 0x7fffffffu, 0xffffffffu};
    static const I xs[] = {0, 1, -1, 7, -7, 8, -8, 9, -9, 1023, -1023, 0x10000001, -0x10000001};
    static const I ys[] = {0, 1, -1, 17, -17, 480, -480, 0x00100001};

    for (B bpp : bpps) {
        for (U pitch : pitches) {
            for (I x : xs) {
                for (I y : ys) {
                    ++cases;
                    for (U side = 0u; side < 2u; ++side) {
                        which = side;
                        std::memset(&trace, 0, sizeof trace);
                        auto* const cfg_bytes =
                            reinterpret_cast<B*>(porsche::window_shutdown_config_005de620);
                        for (U i = 0u; i < 48u; ++i) {
                            cfg_bytes[i] = static_cast<B>(0x41u + i);
                        }
                        cfg_bytes[0x0eu] = bpp;
                        porsche::window_shutdown_config_005de620[9] = pitch;

                        void* const fn = (side == 0u) ? slot_574080 : cpp_fn;
                        trace.ret_u32 = invoke_cdecl2(
                            fn, static_cast<U>(x), static_cast<U>(y), trace.fp, trace.abi_fail);
                        if (side == 0u) {
                            expected = trace;
                        }
                    }
                    assert_traces_match(0xffffffffu);
                }
            }
        }
    }
}

int main(int argc, char**) {
    if (argc < 1) {
        return 2;
    }
    AddVectoredExceptionHandler(1u, fault_handler);
    init_fixture();

    test_5337a0();
    test_5337e0();
    test_533730();
    test_533760();
    test_533120();
    test_574080();

    std::printf("input_ff_slot_render_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
