    relocate_highlow(slot_0053c490, 0x0053c490u, 0x014u, 0x005b24a8u, &kConst_005b24a8);
    relocate_highlow(slot_005561d0, 0x005561d0u, 0x01fu, 0x005b253cu, &kConst_005b253c);
    relocate_call_rel32(slot_005561d0, 0x005561d0u, 0x003u, 0x00538040u, reinterpret_cast<const void*>(&porsche::render_seed_prng_next_00538040));

    FlushInstructionCache(GetCurrentProcess(), code_page, 8192u);
}

static void reset_env(U alloc_fail_mask, U lookup_fail_mask, U prng_seed) {
    g_event_count = 0u;
    g_arena_cursor = 0u;
    g_alloc_index = 0u;
    g_alloc_fail_mask = alloc_fail_mask;
    g_lookup_index = 0u;
    g_lookup_fail_mask = lookup_fail_mask;
    g_prng_step = prng_seed;
    std::memset(g_arena, 0xaa, sizeof(g_arena));
    std::memset(g_self_buf, 0xaa, sizeof(g_self_buf));
}

static void check_math_leaves() {
    const float sqrt_inputs[] = {0.0f, 1.0f, 2.0f, 0.25f, 13.375f, 1024.5f};
    for (float x : sqrt_inputs) {
        ++cases;
        const double orig_v = reinterpret_cast<double(__cdecl*)(float)>(slot_005327d0)(x);
        const double cpp_v = porsche::math_fsqrt_005327d0(x);
        require(f64_bits(orig_v) == f64_bits(cpp_v), "005327d0 fsqrt");
    }

    const float sin_inputs[] = {0.0f, 0.0078125f, 0.25f, 0.5f, 0.75f, 127.0f * 0.0078125f};
    for (float x : sin_inputs) {
        ++cases;
        const double orig_v = reinterpret_cast<double(__cdecl*)(float)>(slot_005327e0)(x);
        const double cpp_v = porsche::math_fsin_tau_005327e0(x);
        require(f64_bits(orig_v) == f64_bits(cpp_v), "005327e0 fsin");
    }

    // 0056e8f5 & 00532880 & 005328a0 & 005328d0 (including aliased out==a)
    struct VecPair { float a[3]; float b[3]; };
    const VecPair vp[] = {
        {{1.0f, 2.0f, 3.0f}, {4.0f, -5.0f, 6.0f}},
        {{0.3f, -1.7f, 2.9f}, {-0.5f, 0.8f, -1.2f}},
    };
    for (const auto& p : vp) {
        ++cases;
        float oa[3]{p.a[0], p.a[1], p.a[2]};
        float ob[3]{p.b[0], p.b[1], p.b[2]};
        float o_out[3]{};
        float ca[3]{p.a[0], p.a[1], p.a[2]};
        float cb[3]{p.b[0], p.b[1], p.b[2]};
        float c_out[3]{};
        float* or1 = reinterpret_cast<float*(__cdecl*)(const float*, const float*, float*)>(slot_0056e8f5)(oa, ob, o_out);
        float* cr1 = porsche::vec3_cross_raw_0056e8f5(ca, cb, c_out);
        require((or1 - oa) == (cr1 - ca), "0056e8f5 ret ptr");
        require(std::memcmp(o_out, c_out, sizeof(o_out)) == 0, "0056e8f5 out");

        ++cases;
        reinterpret_cast<void(__cdecl*)(const float*, const float*, float*)>(slot_00532880)(oa, ob, oa);
        porsche::vec3_cross_00532880(ca, cb, ca);
        require(std::memcmp(oa, ca, sizeof(oa)) == 0, "00532880 aliased out");

        ++cases;
        reinterpret_cast<void(__cdecl*)(const float*, const float*, float*)>(slot_005328a0)(p.a, p.b, o_out);
        porsche::vec3_cross_normalize_005328a0(p.a, p.b, c_out);
        require(std::memcmp(o_out, c_out, sizeof(o_out)) == 0, "005328a0 out");

        ++cases;
        reinterpret_cast<void(__cdecl*)(const float*, float*)>(slot_005328d0)(p.a, o_out);
        porsche::vec3_normalize_005328d0(p.a, c_out);
        require(std::memcmp(o_out, c_out, sizeof(o_out)) == 0, "005328d0 out");
    }

    // 0053c490 and 0053c5d0
    for (I cnt : {0, 1, 3}) {
        ++cases;
        float oa[12] = {1.f, 2.f, 3.f, 2.f,  -4.f, 5.f, 6.f, 2.f,  7.f, -8.f, 9.f, 4.f};
        float ca[12];
        std::memcpy(ca, oa, sizeof(oa));
        const float b[4] = {0.5f, -1.5f, 2.25f, 4.f};
        float o_out[12]{};
        float c_out[12]{};
        reinterpret_cast<void(__cdecl*)(I, const float*, const float*, float*)>(slot_0053c490)(cnt, oa, b, o_out);
        porsche::vec4_weighted_add_0053c490(cnt, ca, b, c_out);
        require(std::memcmp(o_out, c_out, sizeof(o_out)) == 0, "0053c490 out");

        ++cases;
        reinterpret_cast<void(__cdecl*)(I, const float*, float, float*)>(slot_0053c5d0)(cnt, oa, 0.25f, oa);
        porsche::vec4_scale_0053c5d0(cnt, ca, 0.25f, ca);
        require(std::memcmp(oa, ca, sizeof(oa)) == 0, "0053c5d0 aliased");
    }

    // 005561d0
    for (U seed : {0u, 7u, 99u}) {
        ++cases;
        reset_env(0u, 0u, seed);
        const float o_r = reinterpret_cast<float(__cdecl*)()>(slot_005561d0)();
        const U o_ev = g_event_count;
        Event o_evs[kMaxEvents];
        std::memcpy(o_evs, g_events, o_ev * sizeof(Event));

        reset_env(0u, 0u, seed);
        const float c_r = porsche::rand_unit_005561d0();
        require(f32_bits(o_r) == f32_bits(c_r), "005561d0 ret");
        require(g_event_count == o_ev && std::memcmp(g_events, o_evs, o_ev * sizeof(Event)) == 0, "005561d0 ev");
    }
}

static void check_thiscall_leaves() {
    // 00456790
    {
        ++cases;
        reset_env(0u, 0u, 0u);
        reinterpret_cast<void(__fastcall*)(void*, void*)>(slot_00456790)(g_self_buf, nullptr);
        std::array<B, 0x9000u> o_self;
        std::memcpy(o_self.data(), g_self_buf, sizeof(g_self_buf));

        reset_env(0u, 0u, 0u);
        porsche::scene_particle_slot_init_00456790(g_self_buf, nullptr);
        require(std::memcmp(o_self.data(), g_self_buf, sizeof(g_self_buf)) == 0, "00456790 mem");
    }

    // 004580e0 & 00458150
    {
        ++cases;
        reset_env(0u, 0u, 0u);
        reinterpret_cast<void(__fastcall*)(void*, void*)>(slot_004580e0)(g_self_buf, nullptr);
        std::array<B, 0x9000u> o_self;
        std::memcpy(o_self.data(), g_self_buf, sizeof(g_self_buf));

        reset_env(0u, 0u, 0u);
        porsche::scene_splt_zero_tables_004580e0(g_self_buf, nullptr);
        require(std::memcmp(o_self.data(), g_self_buf, sizeof(g_self_buf)) == 0, "004580e0 mem");

        ++cases;
        reset_env(0u, 0u, 0u);
        reinterpret_cast<void(__fastcall*)(void*, void*)>(slot_00458150)(g_self_buf, nullptr);
        std::memcpy(o_self.data(), g_self_buf, sizeof(g_self_buf));

        reset_env(0u, 0u, 0u);
        porsche::scene_splt_init_uvs_00458150(g_self_buf, nullptr);
        require(std::memcmp(o_self.data(), g_self_buf, sizeof(g_self_buf)) == 0, "00458150 mem");
    }

    // 00457920 across multiple quad orientations (exercising every sort swap + clamp)
    const float quads[][16] = {
        {1.0f, 1.4f, -0.55f, 1.0f,  -1.0f, 1.4f, -0.55f, 1.0f,  -1.0f, 0.8f, -0.95f, 1.0f,  1.0f, 0.8f, -0.95f, 1.0f},
        {-2.0f, 0.1f, 0.2f, 1.0f,   0.5f, 0.0f, 0.4f, 1.0f,    1.2f, 0.5f, -0.6f, 1.0f,   -0.8f, 0.9f, -0.3f, 2.0f},
        {0.0f, 0.2f, 0.1f, 1.0f,    0.3f, 0.1f, 0.2f, 1.0f,    0.1f, 0.15f, -0.5f, 1.0f,  0.4f, 0.4f, -0.8f, 1.0f},
    };
    for (const auto& q : quads) {
        ++cases;
        reset_env(0u, 0u, 0u);
        reinterpret_cast<void(__fastcall*)(void*, void*, const float*)>(slot_00457920)(g_self_buf, nullptr, q);
        std::array<B, 0x9000u> o_self;
        std::memcpy(o_self.data(), g_self_buf, sizeof(g_self_buf));

        reset_env(0u, 0u, 0u);
        porsche::scene_splt_quad_init_00457920(g_self_buf, nullptr, q);
        require(std::memcmp(o_self.data(), g_self_buf, sizeof(g_self_buf)) == 0, "00457920 mem");
    }
}

static void compare_particle_buffer(const B* orig, const B* cpp, bool skip_spec_pad, const char* tag) {
    if (!skip_spec_pad) {
        require(std::memcmp(orig, cpp, 0x8858u) == 0, tag);
        return;
    }
    require(std::memcmp(orig, cpp, 0x8655u) == 0, tag);
    require(std::memcmp(orig + 0x8658u, cpp + 0x8658u, 0x8858u - 0x8658u) == 0, tag);
}

static void check_ctors() {
    // 00456ed0 directly (normal + alloc fail masks)
    for (U mask : {0u, 1u, 2u, 3u}) {
        ++cases;
        U spec[21]{};
        for (U i = 0u; i < 21u; ++i) {
            spec[i] = 0x3f800000u + i;
        }
        reset_env(mask, 0u, 11u);
        void* o_ret = reinterpret_cast<void*(__fastcall*)(void*, void*, const void*)>(slot_00456ed0)(
            g_self_buf, nullptr, spec);
        const U o_ev = g_event_count;
        const U o_used = g_arena_cursor;
        Event o_evs[kMaxEvents];
        std::memcpy(o_evs, g_events, o_ev * sizeof(Event));
        std::array<B, 0x9000u> o_self;
        std::memcpy(o_self.data(), g_self_buf, sizeof(g_self_buf));
        std::array<B, kArenaBytes> o_arena;
        std::memcpy(o_arena.data(), g_arena, o_used);

        reset_env(mask, 0u, 11u);
        void* c_ret = porsche::scene_particle_emitter_ctor_00456ed0(g_self_buf, nullptr, spec);
        require(rel_ptr(o_ret) == rel_ptr(c_ret), "00456ed0 ret");
        require(g_arena_cursor == o_used, "00456ed0 arena used");
        require(g_event_count == o_ev && std::memcmp(g_events, o_evs, o_ev * sizeof(Event)) == 0, "00456ed0 ev");
        require(std::memcmp(o_arena.data(), g_arena, o_used) == 0, "00456ed0 arena");
        compare_particle_buffer(o_self.data(), g_self_buf, false, "00456ed0 self");
    }

    // 004577a0 directly (normal + alloc fail masks)
    const float quad[16] = {
        1.0f, 1.4f, -0.55f, 1.0f,  -1.0f, 1.4f, -0.55f, 1.0f,
        -1.0f, 0.8f, -0.95f, 1.0f,  1.0f, 0.8f, -0.95f, 1.0f,
    };
    for (U mask : {0u, 1u, 2u, 3u}) {
        ++cases;
        reset_env(mask, 0u, 0u);
        void* o_ret = reinterpret_cast<void*(__fastcall*)(void*, void*, const float*, U)>(slot_004577a0)(
            g_self_buf, nullptr, quad, 0x55aa1234u);
        const U o_ev = g_event_count;
        const U o_used = g_arena_cursor;
        Event o_evs[kMaxEvents];
        std::memcpy(o_evs, g_events, o_ev * sizeof(Event));
        std::array<B, 0x9000u> o_self;
        std::memcpy(o_self.data(), g_self_buf, sizeof(g_self_buf));
        std::array<B, kArenaBytes> o_arena;
        std::memcpy(o_arena.data(), g_arena, o_used);

        reset_env(mask, 0u, 0u);
        void* c_ret = porsche::scene_splt_emitter_ctor_004577a0(
            g_self_buf, nullptr, quad, 0x55aa1234u);
        require(rel_ptr(o_ret) == rel_ptr(c_ret), "004577a0 ret");
        require(g_arena_cursor == o_used, "004577a0 arena used");
        require(g_event_count == o_ev && std::memcmp(g_events, o_evs, o_ev * sizeof(Event)) == 0, "004577a0 ev");
        require(std::memcmp(o_arena.data(), g_arena, o_used) == 0, "004577a0 arena");
        require(std::memcmp(o_self.data(), g_self_buf, 0x67e4u) == 0, "004577a0 self");
    }

    // 00458c90 full cluster across quality tiers (0..3), lookup fallbacks, and alloc failures
    struct Cfg { U quality; I mode; U alloc_mask; U lookup_mask; };
    const Cfg cfgs[] = {
        {0u, 300, 0u, 0u},
        {1u, 60,  0u, 1u},     // snow tag miss -> fallback "snow"
        {2u, 140, 0u, 2u},     // rain tag miss -> fallback "rain"
        {3u, 220, 0u, 5u},     // both primary tags miss -> fallbacks "snow" and "rain"
        {0u, 300, 1u, 0u},     // snow alloc fail
        {0u, 300, 8u, 0u},     // rain alloc fail
        {0u, 300, 0x40u, 0u},  // splt alloc fail
    };
    for (const auto& cfg : cfgs) {
        ++cases;
        g_orig_particle_owner = reinterpret_cast<void*>(0x12340008u);
        g_orig_context_owner = reinterpret_cast<void*>(0x12340004u);
        porsche::scene_stage_particle_table_owner_00613e08 = g_orig_particle_owner;
        porsche::startup_context_table_owner_00613e04 = g_orig_context_owner;
        store32(g_orig_render_mode_state, 0x60u, static_cast<U>(cfg.mode));
        store32(g_orig_render_mode_state, 0x64u, cfg.quality);
        store32(porsche::render_mode_state_00619790, 0x60u, static_cast<U>(cfg.mode));
        store32(porsche::render_mode_state_00619790, 0x64u, cfg.quality);

        reset_env(cfg.alloc_mask, cfg.lookup_mask, 42u);
        void* o_ret = reinterpret_cast<void*(__fastcall*)(void*, void*)>(slot_00458c90)(g_self_buf, nullptr);
        const U o_ev = g_event_count;
        const U o_used = g_arena_cursor;
        Event o_evs[kMaxEvents];
        std::memcpy(o_evs, g_events, o_ev * sizeof(Event));
        std::array<B, 0x10u> o_self;
        std::memcpy(o_self.data(), g_self_buf, 0x10u);
        std::array<B, kArenaBytes> o_arena;
        std::memcpy(o_arena.data(), g_arena, o_used);

        reset_env(cfg.alloc_mask, cfg.lookup_mask, 42u);
        void* c_ret = porsche::scene_stage_58b80_ctor_00458c90(g_self_buf, nullptr);
        require(rel_ptr(o_ret) == rel_ptr(c_ret), "00458c90 ret");
        require(g_arena_cursor == o_used, "00458c90 arena used");
        require(g_event_count == o_ev && std::memcmp(g_events, o_evs, o_ev * sizeof(Event)) == 0, "00458c90 ev");
        require(std::memcmp(o_self.data(), g_self_buf, 0x10u) == 0, "00458c90 self");

        // Compare allocated buffers: if snow/rain succeeded, skip their 3 uninitialized stack-padding bytes at +0x8655..+0x8657.
        const U snow_ptr = load32(g_self_buf, 0x04u);
        const U rain_ptr = load32(g_self_buf, 0x08u);
        auto check_range = [&](U start, U end) {
            if (end > start) {
                require(std::memcmp(o_arena.data() + start, g_arena + start, end - start) == 0, "00458c90 arena");
            }
        };
        U pos = 0u;
        for (U p_addr : {snow_ptr, rain_ptr}) {
            if (p_addr != 0u) {
                const U off = p_addr - address(g_arena);
                check_range(pos, off + 0x8655u);
                pos = off + 0x8658u;
            }
        }
        check_range(pos, o_used);
    }
}

int main() {
    init();
    check_math_leaves();
    check_thiscall_leaves();
    check_ctors();
    std::printf("scene_stage_58b80_ctor_821_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
