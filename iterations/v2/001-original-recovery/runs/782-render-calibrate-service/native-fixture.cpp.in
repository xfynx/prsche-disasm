void* __cdecl startup_network_allocate_0059ef90(std::uint32_t bytes) {
    record_event(kEvAlloc44, bytes, alloc_mode, 0u);
    if (alloc_mode == 0u) {
        return nullptr;
    }
    std::memset(cal_buf, 0x22, bytes < sizeof cal_buf ? bytes : sizeof cal_buf);
    return &cal_buf[0];
}

void* __fastcall render_resource_node_state_ctor_005379d0(void* self, void* unused_edx) {
    (void)unused_edx;
    const U off = static_cast<U>(static_cast<const B*>(self) - &cal_buf[0]);
    record_event(kEvStateCtor, off, 0u, 0u);
    auto* p = static_cast<B*>(self);
    p[0] = 0x91u;
    p[4] = 0x92u;
    return self;
}

void __cdecl font_setstatef_0053e890(void* font, std::int32_t state, float value) {
    U bits = 0u;
