static void run_set_ops_case() {
    B* const fn_orig = code + 0x200u;
    void* const fn_cpp = reinterpret_cast<void*>(&porsche::render_service_set_ops_0053c8d0);
    U abi_orig = 0u, abi_cpp = 0u;
    const U tbl = ptr_u(&porsche::render_mouse_ops_table_005dfb60[0]);

    side = 0u;
    reset_state(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
    invoke_cdecl1_void(fn_orig, tbl, abi_orig);
    capture(expected, abi_orig);

    side = 1u;
    reset_state(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
    invoke_cdecl1_void(fn_cpp, tbl, abi_cpp);
    capture(trace, abi_cpp);

    compare_snapshots("0053c8d0");
