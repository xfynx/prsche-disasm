static void invoke_cdecl0_void(void* fn, U& abi_fail) {
    U fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je ok
    bad:
        mov fail, 1
    ok:
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
}

static void invoke_cdecl1_void(void* fn, U arg0, U& abi_fail) {
    U fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        add esp, 4
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je ok
    bad:
        mov fail, 1
    ok:
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
}

static void patch_rel(B* base, U off, U src_va, U target_va, U dst) {
    const U insn_next_va = src_va + off + 4u;
    require(static_cast<U>(static_cast<I>(insn_next_va) + static_cast<I>(load32(base + off))) == target_va,
            "patch_rel-mismatch");
    const I new_rel = static_cast<I>(dst - (ptr_u(base + off) + 4u));
    std::memcpy(base + off, &new_rel, sizeof new_rel);
}

static void patch_abs(B* base, U off, U expected_va, U actual_addr) {
    require(load32(base + off) == expected_va, "patch_abs-mismatch");
    std::memcpy(base + off, &actual_addr, sizeof actual_addr);
}

static B* setup_original_code() {
    static const B body_536870[] = { @BODY_00536870@ };
    static const B body_53c8d0[] = { @BODY_0053C8D0@ };
    static const B body_53c8e0[] = { @BODY_0053C8E0@ };
    static const B body_53d840[] = { @BODY_0053D840@ };
    static_assert(sizeof body_536870 == 216u, "00536870 size");
    static_assert(sizeof body_53c8d0 == 10u, "0053c8d0 size");
    static_assert(sizeof body_53c8e0 == 45u, "0053c8e0 size");
    static_assert(sizeof body_53d840 == 86u, "0053d840 size");

    B* const mem = static_cast<B*>(
        VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(mem != nullptr, "virtualalloc");
    std::memset(mem, 0xcc, 4096u);

    B* const s_536870 = mem + 0x000u;
    B* const s_53c8d0 = mem + 0x200u;
    B* const s_53c8e0 = mem + 0x300u;
    B* const s_53d840 = mem + 0x400u;
    std::memcpy(s_536870, body_536870, sizeof body_536870);
    std::memcpy(s_53c8d0, body_53c8d0, sizeof body_53c8d0);
    std::memcpy(s_53c8e0, body_53c8e0, sizeof body_53c8e0);
    std::memcpy(s_53d840, body_53d840, sizeof body_53d840);

    // 0053c8d0 patches
    patch_abs(s_53c8d0, 0x05u, 0x005dec08u, ptr_u(&porsche::render_service_ops_005dec08));

    // 0053d840 patches
    patch_abs(s_53d840, 0x01u, 0x0069eba4u, ptr_u(&porsche::render_service_indices_0069eba4));
    patch_abs(s_53d840, 0x10u, 0x0069eba0u, ptr_u(&porsche::render_service_capacity_0069eba0));
    patch_abs(s_53d840, 0x1cu, 0x0069eba0u, ptr_u(&porsche::render_service_capacity_0069eba0));
    patch_abs(s_53d840, 0x22u, 0x005dec08u, ptr_u(&porsche::render_service_ops_005dec08));
    patch_abs(s_53d840, 0x2fu, 0x0069eba0u, ptr_u(&porsche::render_service_capacity_0069eba0));
    patch_abs(s_53d840, 0x34u, 0x0069eba4u, ptr_u(&porsche::render_service_indices_0069eba4));
    patch_abs(s_53d840, 0x43u, 0x0069eba4u, ptr_u(&porsche::render_service_indices_0069eba4));
    patch_abs(s_53d840, 0x4cu, 0x0069eba0u, ptr_u(&porsche::render_service_capacity_0069eba0));

    // 0053c8e0 patches
    patch_abs(s_53c8e0, 0x01u, 0x0069eb94u, ptr_u(&porsche::render_service_initialized_0069eb94));
    patch_rel(s_53c8e0, 0x0cu, 0x0053c8e0u, 0x0053d840u, ptr_u(s_53d840));
    patch_abs(s_53c8e0, 0x11u, 0x005dfd8cu, ptr_u(&porsche::render_debug_font_005dfd8c[0]));
    patch_rel(s_53c8e0, 0x16u, 0x0053c8e0u, 0x0053c6c0u,
              ptr_u(reinterpret_cast<void*>(&porsche::render_debug_font_create_0053c6c0)));
    patch_abs(s_53c8e0, 0x1eu, 0x0069eb90u, ptr_u(&porsche::render_service_font_0069eb90));
    patch_abs(s_53c8e0, 0x24u, 0x0069eb94u, ptr_u(&porsche::render_service_initialized_0069eb94));

    // 00536870 patches
    patch_abs(s_536870, 0x01u, 0x0069de40u, ptr_u(&porsche::render_calibration_initialized_0069de40));
    patch_abs(s_536870, 0x0eu, 0x005dfb60u, ptr_u(&porsche::render_mouse_ops_table_005dfb60[0]));
    patch_rel(s_536870, 0x13u, 0x00536870u, 0x0053c8d0u, ptr_u(s_53c8d0));
    patch_rel(s_536870, 0x1bu, 0x00536870u, 0x0053c8e0u, ptr_u(s_53c8e0));
    patch_abs(s_536870, 0x20u, 0x0069ed0cu, ptr_u(&porsche::game_setup_movie_service_0069ed0c));
    patch_abs(s_536870, 0x26u, 0x0069de40u, ptr_u(&porsche::render_calibration_initialized_0069de40));
    patch_abs(s_536870, 0x3du, 0x0069de4cu, ptr_u(&porsche::render_calibration_flag_0069de4c));
    patch_rel(s_536870, 0x46u, 0x00536870u, 0x0059ef90u,
              ptr_u(reinterpret_cast<void*>(&porsche::startup_network_allocate_0059ef90)));
    patch_abs(s_536870, 0x56u, 0x0069eb90u, ptr_u(&porsche::render_service_font_0069eb90));
    patch_rel(s_536870, 0x5eu, 0x00536870u, 0x005379d0u,
              ptr_u(reinterpret_cast<void*>(&porsche::render_resource_node_state_ctor_005379d0)));
    patch_abs(s_536870, 0x64u, 0x005bb708u, ptr_u(&porsche::render_calibration_vtable_005bb708[0]));
    patch_abs(s_536870, 0x6cu, 0x0069ed0cu, ptr_u(&porsche::game_setup_movie_service_0069ed0c));
    patch_abs(s_536870, 0x75u, 0x0069de4cu, ptr_u(&porsche::render_calibration_flag_0069de4c));
    patch_abs(s_536870, 0x7du, 0x0069de48u, ptr_u(&porsche::render_calibration_cookie_0069de48));
    patch_rel(s_536870, 0x8fu, 0x00536870u, 0x0053e890u,
              ptr_u(reinterpret_cast<void*>(&porsche::font_setstatef_0053e890)));
    patch_rel(s_536870, 0x9fu, 0x00536870u, 0x0053e890u,
              ptr_u(reinterpret_cast<void*>(&porsche::font_setstatef_0053e890)));
    patch_abs(s_536870, 0xa8u, 0x0069eb90u, ptr_u(&porsche::render_service_font_0069eb90));
    patch_abs(s_536870, 0xaeu, 0x0069de44u, ptr_u(&porsche::render_calibration_object_0069de44));
    patch_rel(s_536870, 0xb4u, 0x00536870u, 0x00571a10u,
              ptr_u(reinterpret_cast<void*>(&porsche::render_font_prepare_00571a10)));
    patch_abs(s_536870, 0xbfu, 0x0069eb90u, ptr_u(&porsche::render_service_font_0069eb90));
    patch_abs(s_536870, 0xc5u, 0x0069de44u, ptr_u(&porsche::render_calibration_object_0069de44));
    patch_rel(s_536870, 0xcfu, 0x00536870u, 0x00571a10u,
              ptr_u(reinterpret_cast<void*>(&porsche::render_font_prepare_00571a10)));

    FlushInstructionCache(GetCurrentProcess(), mem, 4096u);
    return mem;
}

static void run_calibrate_case(
    U cal_init, U cal_flag, U svc_init, U svc_font, U svc_idx, U p_mode, U a_mode, U cookie) {
    B* const fn_orig = code + 0x000u;
    void* const fn_cpp = reinterpret_cast<void*>(&porsche::render_driver_calibrate_00536870);
    U abi_orig = 0u, abi_cpp = 0u;

    side = 0u;
    reset_state(cal_init, cal_flag, svc_init, svc_font, svc_idx, p_mode, a_mode, cookie);
    invoke_cdecl0_void(fn_orig, abi_orig);
    capture(expected, abi_orig);

    side = 1u;
    reset_state(cal_init, cal_flag, svc_init, svc_font, svc_idx, p_mode, a_mode, cookie);
    invoke_cdecl0_void(fn_cpp, abi_cpp);
    capture(trace, abi_cpp);

    compare_snapshots("00536870");
    ++cases;
}

static void run_init_indices_case(U svc_idx, I count) {
    B* const fn_orig = code + 0x400u;
    void* const fn_cpp = reinterpret_cast<void*>(&porsche::render_service_init_indices_0053d840);
    U abi_orig = 0u, abi_cpp = 0u;

    side = 0u;
    reset_state(0u, 0u, 0u, 0u, svc_idx, 0u, 0u, 0u);
    invoke_cdecl1_void(fn_orig, static_cast<U>(count), abi_orig);
    capture(expected, abi_orig);

    side = 1u;
    reset_state(0u, 0u, 0u, 0u, svc_idx, 0u, 0u, 0u);
    invoke_cdecl1_void(fn_cpp, static_cast<U>(count), abi_cpp);
    capture(trace, abi_cpp);

    compare_snapshots("0053d840");
    ++cases;
}

