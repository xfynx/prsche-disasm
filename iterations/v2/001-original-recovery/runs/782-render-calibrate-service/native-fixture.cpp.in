}

} // namespace

int main() {
    AddVectoredExceptionHandler(1, fault);
    code = setup_original_code();

    run_set_ops_case();
    for (U svc_idx : {0u, 1u}) {
        for (I count : {-3, 0, 1, 17, 400}) {
            run_init_indices_case(svc_idx, count);
        }
    }
    for (U svc_init : {0u, 1u}) {
        for (U svc_idx : {0u, 1u}) {
            run_init_service_case(svc_init, svc_idx);
        }
    }
    for (U cal_init : {0u, 1u}) {
        for (U cal_flag : {0u, 1u}) {
            for (U svc_init : {0u, 1u}) {
                for (U p_mode : {0u, 1u, 0x100u}) {
                    for (U a_mode : {0u, 1u}) {
                        run_calibrate_case(
                            cal_init, cal_flag, svc_init, svc_init, svc_init, p_mode, a_mode, 0x76543210u);
                    }
                }
            }
        }
    }

    std::printf("render_calibrate_service_782_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
