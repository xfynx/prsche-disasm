// Native x86-vs-C++ differential fixture for Run782 00536870, 0053c8d0, 0053c8e0, 0053d840.
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <initializer_list>

#include "render_calibrate_service_782.hpp"

using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

namespace {

enum : U {
    kEvProbe = 1u,
    kEvAlloc44 = 2u,
    kEvStateCtor = 3u,
    kEvSetStateF = 4u,
    kEvPrepare = 5u,
    kEvCreateFont = 6u,
    kEvOpsAlloc = 7u,
    kEvWrongSlot = 8u,
    kMaxEvents = 32u,
};

struct Event {
    U type;
    U a;
    U b;
    U c;
};

struct Snapshot {
    U abi_fail;
    U event_count;
    Event events[kMaxEvents];
    U cal_init;
    U cal_obj_tok;
    U cal_cookie;
    B cal_flag;
    U svc_font_tok;
    U svc_init;
    I svc_cap;
    U svc_idx_tok;
    U svc_ops_tok;
    B cal_buf[0x2c];
    I idx_buf[512];
};

static U cases = 0u;
static U side = 0u;
static U probe_mode = 0u;
static U alloc_mode = 0u;
static U font_sentinel = 0x11112222u;
static U alt_ops_table[8]{};
static void* inner_vtable[2]{};
static B inner_obj[8]{};
static B outer_obj[0x20]{};
static B movie_service_obj[0x10]{};
static B cal_buf[0x2c]{};
static I idx_buf[512]{};
static Event events[kMaxEvents]{};
static U event_count = 0u;
static Snapshot trace{};
static Snapshot expected{};
static B* code = nullptr;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", why, cases, side);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static LONG WINAPI fault(EXCEPTION_POINTERS* info) {
    std::printf("divergence native-fault %08lx case=%u side=%u\n",
                info->ExceptionRecord->ExceptionCode, cases, side);
    std::fflush(stdout);
    ExitProcess(7);
    return EXCEPTION_CONTINUE_SEARCH;
}

static U ptr_u(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* p) {
    U v = 0u;
    std::memcpy(&v, p, sizeof v);
    return v;
}

static void store32(void* p, U v) {
    std::memcpy(p, &v, sizeof v);
}

static void record_event(U type, U a, U b, U c) {
    if (event_count < kMaxEvents) {
        events[event_count++] = Event{type, a, b, c};
    }
}

static std::uint8_t __fastcall mock_inner_probe(void* self, void* unused_edx) {
    (void)unused_edx;
    record_event(kEvProbe, (self == &inner_obj[0]) ? 1u : 0u, probe_mode, 0u);
    return static_cast<std::uint8_t>(probe_mode & 0xffu);
}

static I* __cdecl mock_ops_alloc_wrong(I bytes) {
    record_event(kEvWrongSlot, static_cast<U>(bytes), 0u, 0u);
    return &idx_buf[0];
}

static I* __cdecl mock_ops_alloc_slot5(I bytes) {
    record_event(kEvOpsAlloc, static_cast<U>(bytes), 0u, 0u);
    std::memset(idx_buf, 0x77, sizeof idx_buf);
    return &idx_buf[0];
}

static void reset_state(
    U cal_init_val,
    U cal_flag_val,
    U svc_init_val,
    U svc_font_present,
    U svc_idx_present,
    U p_mode,
    U a_mode,
    U cookie_val) {
    probe_mode = p_mode;
    alloc_mode = a_mode;
    event_count = 0u;
    std::memset(events, 0, sizeof events);
    std::memset(cal_buf, 0xaa, sizeof cal_buf);
    for (U i = 0u; i < 512u; ++i) {
        idx_buf[i] = static_cast<I>(0x55550000u + i);
    }

    store32(&inner_vtable[0], ptr_u(reinterpret_cast<void*>(&mock_inner_probe)));
    store32(&inner_obj[0], ptr_u(&inner_vtable[0]));
    store32(&outer_obj[0x18], ptr_u(&inner_obj[0]));
    store32(&movie_service_obj[0], ptr_u(&outer_obj[0]));
    store32(&movie_service_obj[4], cookie_val);

    for (U i = 0u; i < 8u; ++i) {
        porsche::render_mouse_ops_table_005dfb60[i] =
            (i == 5u) ? ptr_u(reinterpret_cast<void*>(&mock_ops_alloc_slot5))
                      : ptr_u(reinterpret_cast<void*>(&mock_ops_alloc_wrong));
        alt_ops_table[i] =
            (i == 5u) ? ptr_u(reinterpret_cast<void*>(&mock_ops_alloc_slot5))
                      : ptr_u(reinterpret_cast<void*>(&mock_ops_alloc_wrong));
    }

    porsche::game_setup_movie_service_0069ed0c = &movie_service_obj[0];
    porsche::render_calibration_initialized_0069de40 = cal_init_val;
    porsche::render_calibration_object_0069de44 = reinterpret_cast<void*>(0xdeadbeefu);
    porsche::render_calibration_cookie_0069de48 = 0x11223344u;
    porsche::render_calibration_flag_0069de4c = static_cast<B>(cal_flag_val);
    porsche::render_service_font_0069eb90 = svc_font_present ? &font_sentinel : nullptr;
    porsche::render_service_initialized_0069eb94 = svc_init_val;
    porsche::render_service_capacity_0069eba0 = -1;
    porsche::render_service_indices_0069eba4 = svc_idx_present ? &idx_buf[0] : nullptr;
    porsche::render_service_ops_005dec08 = &alt_ops_table[0];
}

static void capture(Snapshot& out, U abi_fail) {
    std::memset(&out, 0, sizeof out);
    out.abi_fail = abi_fail;
    out.event_count = event_count;
    std::memcpy(out.events, events, sizeof events);
    out.cal_init = porsche::render_calibration_initialized_0069de40;
    if (porsche::render_calibration_object_0069de44 == &cal_buf[0]) {
        out.cal_obj_tok = 1u;
    } else if (porsche::render_calibration_object_0069de44 == nullptr) {
        out.cal_obj_tok = 0u;
    } else {
        out.cal_obj_tok = ptr_u(porsche::render_calibration_object_0069de44);
    }
    out.cal_cookie = porsche::render_calibration_cookie_0069de48;
    out.cal_flag = porsche::render_calibration_flag_0069de4c;
    out.svc_font_tok = (porsche::render_service_font_0069eb90 == &font_sentinel) ? 1u : 0u;
    out.svc_init = porsche::render_service_initialized_0069eb94;
    out.svc_cap = porsche::render_service_capacity_0069eba0;
    out.svc_idx_tok = (porsche::render_service_indices_0069eba4 == &idx_buf[0]) ? 1u : 0u;
    if (porsche::render_service_ops_005dec08 == &porsche::render_mouse_ops_table_005dfb60[0]) {
        out.svc_ops_tok = 1u;
    } else if (porsche::render_service_ops_005dec08 == &alt_ops_table[0]) {
        out.svc_ops_tok = 2u;
    } else {
        out.svc_ops_tok = ptr_u(porsche::render_service_ops_005dec08);
    }
    std::memcpy(out.cal_buf, cal_buf, sizeof cal_buf);
    std::memcpy(out.idx_buf, idx_buf, sizeof idx_buf);
}

static void compare_snapshots(const char* label) {
    require(expected.abi_fail == 0u && trace.abi_fail == 0u, label);
    require(std::memcmp(&expected, &trace, sizeof(Snapshot)) == 0, label);
}

} // namespace

