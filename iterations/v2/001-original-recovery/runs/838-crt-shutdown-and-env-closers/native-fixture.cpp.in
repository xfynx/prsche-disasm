        const U ev3_alive = ::GetHandleInformation(ev3, &dummy) ? 1u : 0u;
        const U ev20_alive = ::GetHandleInformation(ev20, &dummy) ? 1u : 0u;
        trace.bool_flags = (piob[0]->flags != 0u ? 1u : 0u) |
                           (piob[3]->flags == 0u ? 2u : 0u) |
                           (piob[20] == nullptr ? 4u : 0u) |
