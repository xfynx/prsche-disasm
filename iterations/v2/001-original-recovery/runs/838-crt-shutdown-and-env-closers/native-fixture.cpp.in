        const int c_eq = cpp ? porsche::crt_mbsnbicoll_005a9a0b("AbC", "aBcZ", 3u) : orig_5a9a0b("AbC", "aBcZ", 3u);
        const int c_gt = cpp ? porsche::crt_mbsnbicoll_005a9a0b("abe", "abd", 3u) : orig_5a9a0b("abe", "abd", 3u);
        const int c_z1 = cpp ? porsche::crt_compare_string_a_005ad042(0u, 1u, "", 0, "x", 1, 1252u)
                             : orig_5ad042(0u, 1u, "", 0, "x", 1, 1252u);
        const int c_zn = cpp ? porsche::crt_compare_string_a_005ad042(0u, 1u, "", 0, "xy", -1, 1252u)
                             : orig_5ad042(0u, 1u, "", 0, "xy", -1, 1252u);
        trace.ret0 = c_lt;
        trace.ret1 = c_gt;
        trace.str_hash = fnv1a(m0);
        trace.bool_flags = (m0 == dbcs + 4 ? 1u : 0u) |
                           (c_eq == 0 ? 2u : 0u) |
                           (c_z1 == 1 ? 4u : 0u) |
                           (c_zn == 1 ? 8u : 0u);
    });

    std::printf("crt_shutdown_env_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
