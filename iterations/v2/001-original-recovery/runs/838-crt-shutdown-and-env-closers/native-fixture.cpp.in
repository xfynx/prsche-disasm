static U arena_loc(const void* p) {
    if (!p) return 0u;
    const auto a = reinterpret_cast<std::uintptr_t>(p);
    const auto base = reinterpret_cast<std::uintptr_t>(arena);
    if (a >= base && a < base + kArenaBytes) {
        return 0x10000000u + static_cast<U>(a - base);
    }
    return static_cast<U>(a);
}

static void* arena_alloc(U bytes) {
    const U hdr = 4u;
    const U sz = (bytes + 3u) & ~3u;
    if (arena_cursor + hdr + sz > kArenaBytes) return nullptr;
    B* p = arena + arena_cursor;
    std::memcpy(p, &bytes, 4u);
    std::memset(p + hdr, 0, sz);
    arena_cursor += hdr + sz;
    return p + hdr;
}

