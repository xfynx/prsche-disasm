static void reset_state() {
    std::memset(&trace, 0, sizeof(trace));
    std::memset(arena, 0, sizeof(arena));
    arena_cursor = 0u;
    std::memset(handle_bank0, 0, sizeof(handle_bank0));
    std::memset(handle_bank1, 0, sizeof(handle_bank1));
    std::memset(porsche::formatter_cleanup_handle_table_006c01e0, 0, sizeof(porsche::formatter_cleanup_handle_table_006c01e0));
    porsche::formatter_cleanup_handle_table_006c01e0[0] = handle_bank0;
    porsche::formatter_cleanup_handle_table_006c01e0[1] = handle_bank1;
    porsche::formatter_cleanup_handle_limit_006c02e0 = 64u;
    porsche::crt_nstream_006c1520 = 0;
    porsche::crt_piob_006c0508 = nullptr;
    porsche::exit_shutdown_mode_word_006afce0 = 0u;
    porsche::crt_env_initialized_006c1528 = 0u;
    porsche::crt_environ_006afcc8 = nullptr;
    porsche::crt_initenv_006afccc = nullptr;
    porsche::crt_wenviron_006afcd0 = nullptr;
    porsche::crt_compare_use_mode_006b0028 = 0u;
    std::memset(&porsche::formatter_locale_codepage_006c02ec, 0, sizeof(porsche::formatter_locale_codepage_006c02ec));
    porsche::formatter_locale_codepage_006c02ec.codepage = 1252u;
    porsche::formatter_locale_codepage_006c02ec.locale = 0u;
    porsche::formatter_locale_default_codepage_006afd90 = 1252u;
    mock_errno = 0;
    mock_doserrno = 0u;
    mock_flush_fail_mask = 0;
}

static void set_lowio(U fd, U os_handle, B flags) {
    B* rec = (fd < 32u ? handle_bank0 : handle_bank1) + (fd & 31u) * 36u;
    std::memcpy(rec, &os_handle, 4u);
    rec[4] = flags;
}

static porsche::FormatterOriginalDescriptor32* make_stream(U flags, U fid, char* base, char* tmp) {
    auto* s = static_cast<porsche::FormatterOriginalDescriptor32*>(arena_alloc(56u));
    s->flags = flags;
    s->base = base;
    s->cursor = base;
    std::memcpy(s->opaque_tail, &fid, 4u);
    std::memcpy(s->opaque_tail + 12, &tmp, 4u);
    if (tmp) {
        std::memset(s + 1, 0, 24u);
    }
    return s;
}

static void compare_traces(const Trace& a, const Trace& b) {
    if (a.count != b.count || a.ret0 != b.ret0 || a.ret1 != b.ret1 ||
        a.err_val != b.err_val || a.doserr_val != b.doserr_val ||
        a.str_hash != b.str_hash || a.bool_flags != b.bool_flags) {
        fail("trace_summary_mismatch");
    }
    for (U i = 0u; i < a.count; ++i) {
        if (a.codes[i] != b.codes[i] || a.arg0[i] != b.arg0[i] || a.arg1[i] != b.arg1[i]) {
            fail("trace_event_mismatch");
        }
    }
}

template <typename Fn>
static void run_case(Fn fn) {
    ++cases;
    which = 0u;
    reset_state();
    fn(false);
    expected = trace;

    which = 1u;
    reset_state();
    fn(true);
    compare_traces(expected, trace);
}

