        else orig_5a36d6();
        trace.bool_flags = (piob[3]->flags != 0u) ? 1u : 0u;
    });

    // Case 2: exit_shutdown_static_callback_005a36d6 with mode_word!=0 (flush + fcloseall, i>=3 closed, i>=20 freed, slots 0..2 untouched).
    run_case([&](bool cpp) {
        auto** piob = static_cast<porsche::FormatterOriginalDescriptor32**>(arena_alloc(22u * 4u));
        HANDLE ev3 = ::CreateEventA(nullptr, TRUE, FALSE, nullptr);
        HANDLE ev20 = ::CreateEventA(nullptr, TRUE, FALSE, nullptr);
        if (!ev3 || !ev20) fail("create_event");
        set_lowio(0u, static_cast<U>(reinterpret_cast<std::uintptr_t>(::GetStdHandle(STD_INPUT_HANDLE))), 0x01u);
        set_lowio(3u, static_cast<U>(reinterpret_cast<std::uintptr_t>(ev3)), 0x01u);
        set_lowio(20u, static_cast<U>(reinterpret_cast<std::uintptr_t>(ev20)), 0x01u);
        piob[0] = make_stream(0x01u, 0u, nullptr, nullptr);
        piob[1] = make_stream(0x02u, 1u, nullptr, nullptr);
        piob[2] = nullptr;
        char* buf3 = static_cast<char*>(arena_alloc(16u));
        char* tmp3 = static_cast<char*>(arena_alloc(12u));
        piob[3] = make_stream(0x8au, 3u, buf3, tmp3);
        piob[20] = make_stream(0x02u, 20u, nullptr, nullptr);
        ::InitializeCriticalSection(reinterpret_cast<CRITICAL_SECTION*>(piob[20] + 1));
        piob[21] = make_stream(0x00u, 21u, nullptr, nullptr);
        ::InitializeCriticalSection(reinterpret_cast<CRITICAL_SECTION*>(piob[21] + 1));
        porsche::crt_nstream_006c1520 = 22;
        porsche::crt_piob_006c0508 = piob;
        porsche::exit_shutdown_mode_word_006afce0 = 0x01u;
        if (cpp) porsche::exit_shutdown_static_callback_005a36d6();
        else orig_5a36d6();
