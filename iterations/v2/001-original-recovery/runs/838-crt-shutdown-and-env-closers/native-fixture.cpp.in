        if (hf == INVALID_HANDLE_VALUE) fail("create_temp_file");
        set_lowio(4u, static_cast<U>(reinterpret_cast<std::uintptr_t>(hf)), 0x01u);
        set_lowio(5u, 0xffffffffu, 0x01u);
        auto* s_ok = make_stream(0x4002u, 4u, nullptr, nullptr);
        auto* s_bad = make_stream(0x4002u, 5u, nullptr, nullptr);
