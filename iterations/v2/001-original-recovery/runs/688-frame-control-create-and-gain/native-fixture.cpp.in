        // duration/gain/button/repeat/direction corners on type 0
        {0, 1u, 1u, 3u, 0u, 1u, 0xffffffffu, 0xffffffffu, 0u, 0x1234u, 100u, 0u, 0x22u},
        {0, 1u, 1u, 3u, 0u, 1u, 0xffffffffu, 0x7fffffffu, 1u, 0x1234u, 100u, 0u, 0x22u},
