#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdio>
#include <cstring>
#include <initializer_list>
#include "audio_stream_channel_status_637.hpp"

namespace porsche {
ApplicationAudioDeviceStateStorage application_audio_device_state_006b48c0{};
std::uint32_t& audio_backend_channels_006b4a00 =
    *reinterpret_cast<std::uint32_t*>(application_audio_device_state_006b48c0.data() + 0x140);
} // namespace porsche

using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static U cases = 0u;
static U events_total = 0u;
static U kind_cfg = 0u;
static U lookup_present_cfg = 1u;
static I find_channel_cfg = 0;
static U unlock_reload_cfg = 0u;
static U boundary_ret_cfg = 0u;
static U boundary_mutate_cfg = 0u;
static bool cpp_side = false;

static B stream_obj_buf[0x100] = {};
static B channels_a_buf[6 * 0x70] = {};
static B channels_b_buf[6 * 0x70] = {};
alignas(16) static B floating[512] = {};

static B* code = nullptr;
static B* slot_567810 = nullptr;
static B* slot_567850 = nullptr;
static B* slot_591320 = nullptr;

template <typename T>
static std::uintptr_t address(const T& obj) {
    return reinterpret_cast<std::uintptr_t>(&obj);
}

static U word(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void put(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* s) {
    if (!ok) {
        std::printf("divergence %s case=%u kind=%u ch=%d cpp=%u\n",
                    s, cases, kind_cfg, find_channel_cfg, static_cast<U>(cpp_side));
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* e) {
    std::printf("native-fault code=%08lx eip=%08lx case=%u kind=%u cpp=%u\n",
                e->ExceptionRecord->ExceptionCode, e->ContextRecord->Eip,
                cases, kind_cfg, static_cast<U>(cpp_side));
    std::fflush(stdout);
    ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

enum EventTag : U {
    kEvLookup = 1u,
    kEvChannelVolume = 2u,
    kEvLock = 3u,
    kEvFindChannel = 4u,
    kEvUnlock = 5u,
};

struct Fpu {
    unsigned short control;
    unsigned short status;
    B tag;
    B padding[3];
    B values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct State {
    B device_backing[0x18cu];
    B stream_obj[0x100u];
    B channels_a[6 * 0x70u];
    B channels_b[6 * 0x70u];
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    State before;
};

struct Trace {
    U abi;
    U ret_eax;
    U count;
    Event events[16];
    State final;
    Fpu fpu;
};

static Trace trace = {};
static Trace expected = {};

static void snapshot(State& s) {
    std::memcpy(s.device_backing, porsche::application_audio_device_state_006b48c0.backing.data(),
                sizeof(s.device_backing));
    std::memcpy(s.stream_obj, stream_obj_buf, sizeof(s.stream_obj));
    std::memcpy(s.channels_a, channels_a_buf, sizeof(s.channels_a));
    std::memcpy(s.channels_b, channels_b_buf, sizeof(s.channels_b));
}

static void record_event(U tag, U arg0, U arg1) {
    require(trace.count < 16u, "event bound");
    Event& e = trace.events[trace.count++];
    e.tag = tag;
    e.arg0 = arg0;
    e.arg1 = arg1;
    snapshot(e.before);
}

namespace porsche {

U __cdecl audio_stream_service_lookup_00566d60(I slot) {
    record_event(kEvLookup, static_cast<U>(slot), 0u);
    if (lookup_present_cfg == 0u) {
        return 0u;
    }
    return static_cast<U>(address(stream_obj_buf));
}

U __cdecl frame_services_boundary_00566340(U handle, U volume) {
    record_event(kEvChannelVolume, handle, volume);
    if (boundary_mutate_cfg != 0u) {
        stream_obj_buf[0xe4u] = static_cast<B>(stream_obj_buf[0xe4u] ^ 0x33u);
    }
    return boundary_ret_cfg;
}

void __cdecl audio_backend_lock_005896d0() {
    record_event(kEvLock, 0u, 0u);
    application_audio_device_state_006b48c0[0xdfu] =
        static_cast<B>(application_audio_device_state_006b48c0[0xdfu] + 1u);
}

void __cdecl audio_backend_unlock_005896f0() {
    record_event(kEvUnlock, 0u, 0u);
    application_audio_device_state_006b48c0[0xdfu] =
        static_cast<B>(application_audio_device_state_006b48c0[0xdfu] - 1u);
    if (unlock_reload_cfg != 0u) {
        audio_backend_channels_006b4a00 = static_cast<U>(address(channels_b_buf));
    }
}

I __cdecl audio_backend_find_channel_00589d20(U handle) {
    record_event(kEvFindChannel, handle, 0u);
    return find_channel_cfg;
}

} // namespace porsche

static void capture_fpu(Fpu& f) {
    std::memset(&f, 0, sizeof(f));
    B env[28] = {};
    __asm {
        fxsave floating
        fnstenv env
        fldenv env
    }
    f.control = *reinterpret_cast<const unsigned short*>(floating);
    f.status = *reinterpret_cast<const unsigned short*>(floating + 2);
    f.tag = floating[4];
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(f.values + i * 10u, floating + 32u + i * 16u, 10u);
    }
    f.full_tag = *reinterpret_cast<const unsigned short*>(env + 8);
    f.mxcsr = *reinterpret_cast<const U*>(floating + 24);
}

static void seed_fpu(U precision, U rounding, U depth) {
    const unsigned short control =
        static_cast<unsigned short>(0x007fu | (precision << 8u) | (rounding << 10u));
    __asm {
        fninit
        fldcw control
    }
    for (U i = 0u; i < depth; ++i) {
        const U bits = 0x3f800001u + i;
        __asm fld dword ptr bits
    }
}

__declspec(noinline) static U invoke_cdecl1(void* fn, U a0, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, returned = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        push a0
        call fn
        add esp, 4
        mov returned, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je ok
    bad:
        mov fail, 1
    ok:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = returned;
    return fail;
}

__declspec(noinline) static U invoke_cdecl2(void* fn, U a0, U a1, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, returned = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        push a1
        push a0
        call fn
        add esp, 8
        mov returned, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je ok
    bad:
        mov fail, 1
    ok:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = returned;
    return fail;
}

static void reloc_abs32(B* slot, U off, U expected_va, std::uintptr_t target) {
    require(word(slot, off) == expected_va, "abs32 check");
    const U v = static_cast<U>(target);
    std::memcpy(slot + off, &v, 4u);
}

static void reloc_rel32(B* slot, U slot_va, U off, U expected_target_va, std::uintptr_t target) {
    require(off > 0u && slot[off - 1u] == 0xe8u, "expected call e8");
    const U actual_target = slot_va + off + 4u + word(slot, off);
    require(actual_target == expected_target_va, "rel32 check");
    const std::uintptr_t next_ip = reinterpret_cast<std::uintptr_t>(slot + off + 4u);
    const I disp = static_cast<I>(target - next_ip);
    std::memcpy(slot + off, &disp, 4u);
}

static void init_original_code() {
    for (U i = 0u; i < porsche::application_audio_device_state_006b48c0.backing.size(); ++i) {
        require(porsche::application_audio_device_state_006b48c0.backing[i] == 0u,
                "initial zero device state");
    }

    static const B body_567810[] = { @BODY_00567810@ };
    static const B body_567850[] = { @BODY_00567850@ };
    static const B body_591320[] = { @BODY_00591320@ };
    static_assert(sizeof(body_567810) == 64u, "00567810 byte size");
    static_assert(sizeof(body_567850) == 68u, "00567850 byte size");
    static_assert(sizeof(body_591320) == 83u, "00591320 byte size");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                        PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");
    std::memset(code, 0xcc, 4096u);

    slot_567810 = code + 0u;
    slot_567850 = code + 128u;
    slot_591320 = code + 256u;

    std::memcpy(slot_567810, body_567810, sizeof(body_567810));
    std::memcpy(slot_567850, body_567850, sizeof(body_567850));
    std::memcpy(slot_591320, body_591320, sizeof(body_591320));

    reloc_abs32(slot_567810, 0x01u, 0x006b499cu,
                address(porsche::application_audio_device_state_006b48c0[0xdcu]));
    reloc_rel32(slot_567810, 0x00567810u, 0x15u, 0x00566d60u,
                reinterpret_cast<std::uintptr_t>(&porsche::audio_stream_service_lookup_00566d60));
    reloc_rel32(slot_567810, 0x00567810u, 0x36u, 0x00566340u,
                reinterpret_cast<std::uintptr_t>(&porsche::frame_services_boundary_00566340));

    reloc_abs32(slot_567850, 0x01u, 0x006b499cu,
                address(porsche::application_audio_device_state_006b48c0[0xdcu]));
    reloc_rel32(slot_567850, 0x00567850u, 0x17u, 0x00566d60u,
                reinterpret_cast<std::uintptr_t>(&porsche::audio_stream_service_lookup_00566d60));
    reloc_rel32(slot_567850, 0x00567850u, 0x30u, 0x00591320u,
                reinterpret_cast<std::uintptr_t>(slot_591320));

    reloc_abs32(slot_591320, 0x01u, 0x006b499cu,
                address(porsche::application_audio_device_state_006b48c0[0xdcu]));
    reloc_rel32(slot_591320, 0x00591320u, 0x12u, 0x005896d0u,
                reinterpret_cast<std::uintptr_t>(&porsche::audio_backend_lock_005896d0));
    reloc_rel32(slot_591320, 0x00591320u, 0x1cu, 0x00589d20u,
                reinterpret_cast<std::uintptr_t>(&porsche::audio_backend_find_channel_00589d20));
    reloc_rel32(slot_591320, 0x00591320u, 0x2au, 0x005896f0u,
                reinterpret_cast<std::uintptr_t>(&porsche::audio_backend_unlock_005896f0));
    reloc_rel32(slot_591320, 0x00591320u, 0x36u, 0x005896f0u,
                reinterpret_cast<std::uintptr_t>(&porsche::audio_backend_unlock_005896f0));
    reloc_abs32(slot_591320, 0x3cu, 0x006b4a00u,
                address(porsche::audio_backend_channels_006b4a00));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");
}

static void compare_call(U kind, U a0, U a1) {
    kind_cfg = kind;
    State initial = {};
    snapshot(initial);

    for (U side = 0u; side < 2u; ++side) {
        cpp_side = (side != 0u);
        std::memcpy(porsche::application_audio_device_state_006b48c0.backing.data(),
                    initial.device_backing, sizeof(initial.device_backing));
        std::memcpy(stream_obj_buf, initial.stream_obj, sizeof(initial.stream_obj));
        std::memcpy(channels_a_buf, initial.channels_a, sizeof(initial.channels_a));
        std::memcpy(channels_b_buf, initial.channels_b, sizeof(initial.channels_b));
        std::memset(&trace, 0, sizeof(trace));

        const U prec = (cases % 3u == 0u) ? 0u : ((cases % 3u == 1u) ? 2u : 3u);
        const U rnd = cases % 4u;
        const U depth = cases % 9u;
        seed_fpu(prec, rnd, depth);
        Fpu before_fpu = {};
        capture_fpu(before_fpu);

        U ret_eax = 0u;
        if (kind == 0u) {
            void* fn = cpp_side ? reinterpret_cast<void*>(&porsche::audio_channel_status_00591320)
                                : reinterpret_cast<void*>(slot_591320);
            trace.abi = invoke_cdecl1(fn, a0, ret_eax);
        } else if (kind == 1u) {
            void* fn = cpp_side
                           ? reinterpret_cast<void*>(&porsche::audio_stream_service_status_00567850)
                           : reinterpret_cast<void*>(slot_567850);
            trace.abi = invoke_cdecl1(fn, a0, ret_eax);
        } else {
            void* fn = cpp_side
                           ? reinterpret_cast<void*>(&porsche::audio_stream_service_volume_00567810)
                           : reinterpret_cast<void*>(slot_567810);
            trace.abi = invoke_cdecl2(fn, a0, a1, ret_eax);
        }
        trace.ret_eax = ret_eax;
        capture_fpu(trace.fpu);
        require(trace.abi == 0u, "cdecl ABI");
        require(std::memcmp(&before_fpu, &trace.fpu, sizeof(Fpu)) == 0, "x87 preservation");
        snapshot(trace.final);

        if (side == 0u) {
            expected = trace;
        } else {
            require(expected.ret_eax == trace.ret_eax, "ret_eax mismatch");
            require(expected.count == trace.count, "event count mismatch");
            require(std::memcmp(expected.events, trace.events, trace.count * sizeof(Event)) == 0,
                    "event trace mismatch");
            require(std::memcmp(&expected.final, &trace.final, sizeof(State)) == 0,
                    "final state mismatch");
            require(std::memcmp(&expected.fpu, &trace.fpu, sizeof(Fpu)) == 0, "fpu mismatch");
            events_total += trace.count;
        }
    }
    ++cases;
}

static void reset_buffers(U seed) {
    std::memset(porsche::application_audio_device_state_006b48c0.backing.data(), 0x5au,
                porsche::application_audio_device_state_006b48c0.backing.size());
    porsche::application_audio_device_state_006b48c0[0xdfu] = 0u;
    porsche::audio_backend_channels_006b4a00 = static_cast<U>(address(channels_a_buf));

    for (U i = 0u; i < sizeof(stream_obj_buf); ++i) {
        stream_obj_buf[i] = static_cast<B>(seed * 23u + i + 5u);
    }
    for (U c = 0u; c < 6u; ++c) {
        for (U i = 0u; i < 0x70u; ++i) {
            channels_a_buf[c * 0x70u + i] = static_cast<B>(seed * 13u + c * 17u + i);
            channels_b_buf[c * 0x70u + i] = static_cast<B>(seed * 29u + c * 19u + i + 7u);
        }
    }
}

int main() {
    AddVectoredExceptionHandler(1, fault_handler);
    init_original_code();

    // 1. Test 00591320 (audio_channel_status_00591320)
    lookup_present_cfg = 1u;
    boundary_ret_cfg = 0u;
    boundary_mutate_cfg = 0u;
    for (U active : {0u, 1u, 0xffu}) {
        for (I ch : {-100, -1, 0, 1, 3, 5}) {
            if (active == 0u && ch != -1) {
                continue;
            }
            for (U reload : {0u, 1u}) {
                if (active == 0u && reload != 0u) {
                    continue;
                }
                for (B gain_byte : {0x00, 0x01, 0x33, 0x7f, 0x80, 0xfe, 0xff}) {
                    if (ch < 0 && gain_byte != 0x33) {
                        continue;
                    }
                    reset_buffers(cases + 1u);
                    porsche::application_audio_device_state_006b48c0[0xdcu] = static_cast<B>(active);
                    find_channel_cfg = ch;
                    unlock_reload_cfg = reload;
                    if (ch >= 0) {
                        channels_a_buf[static_cast<U>(ch) * 0x70u + 0x3du] = gain_byte;
                        channels_b_buf[static_cast<U>(ch) * 0x70u + 0x3du] =
                            static_cast<B>(gain_byte ^ 0x85u);
                    }
                    compare_call(0u, 0x80000001u + cases * 0x1111u, 0u);
                }
            }
        }
    }

    // 2. Test 00567850 (audio_stream_service_status_00567850)
    unlock_reload_cfg = 0u;
    for (U active : {0u, 1u, 0xffu}) {
        for (U present : {0u, 1u}) {
            if (active == 0u && present != 0u) {
                continue;
            }
            for (I ch : {-1, 0, 2, 4}) {
                if ((active == 0u || present == 0u) && ch != -1) {
                    continue;
                }
                for (B ch_gain : {0x00, 0x40, 0x7f, 0x80, 0xf6, 0xff}) {
                    if (ch < 0 && ch_gain != 0x40) {
                        continue;
                    }
                    for (B obj_gain : {0x00, 0x01, 0x55, 0x7f, 0x80, 0xfe, 0xff}) {
                        reset_buffers(cases + 3u);
                        porsche::application_audio_device_state_006b48c0[0xdcu] =
                            static_cast<B>(active);
                        lookup_present_cfg = present;
                        find_channel_cfg = ch;
                        put(stream_obj_buf, 0x08u, 0x55000000u + cases);
                        stream_obj_buf[0xe4u] = obj_gain;
                        if (ch >= 0) {
                            channels_a_buf[static_cast<U>(ch) * 0x70u + 0x3du] = ch_gain;
                        }
                        compare_call(1u, static_cast<U>(static_cast<I>(cases % 20u) - 2), 0u);
                    }
                }
            }
        }
    }

    // 3. Test 00567810 (audio_stream_service_volume_00567810)
    find_channel_cfg = 0;
    for (U active : {0u, 1u, 0xffu}) {
        for (U present : {0u, 1u}) {
            if (active == 0u && present != 0u) {
                continue;
            }
            for (U b_ret : {0u, 0xfffffff6u, 0x12345678u}) {
                if ((active == 0u || present == 0u) && b_ret != 0u) {
                    continue;
                }
                for (U b_mut : {0u, 1u}) {
                    if ((active == 0u || present == 0u) && b_mut != 0u) {
                        continue;
                    }
                    for (U vol : {0u, 1u, 0x7fu, 0x80u, 0xffu, 0x12345678u, 0xffffffffu}) {
                        reset_buffers(cases + 7u);
                        porsche::application_audio_device_state_006b48c0[0xdcu] =
                            static_cast<B>(active);
                        lookup_present_cfg = present;
                        boundary_ret_cfg = b_ret;
                        boundary_mutate_cfg = b_mut;
                        put(stream_obj_buf, 0x08u, 0x77000001u + cases);
                        stream_obj_buf[0xe4u] = 0x22u;
                        stream_obj_buf[0xe5u] = 0x44u;
                        compare_call(2u, static_cast<U>(static_cast<I>(cases % 20u) - 3), vol);
                    }
                }
            }
        }
    }

    __asm fninit
    std::printf("audio_stream_channel_status_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
