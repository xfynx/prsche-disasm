    sim_obj_0060ca7c = &mock_objs[29];

    sim_teardown_secondary_0060c7e8 = mock_raw_bufs[0];
    sim_teardown_buf_0060ab18 = mock_raw_bufs[1];
    sim_teardown_buf_0060ab10 = mock_raw_bufs[2];
    sim_teardown_buf_0060ab1c = mock_raw_bufs[3];

    sim_lists_refcount_0060c978 = static_cast<I>(refcount_in);
    sim_lists_free_buf_0060c974 = mock_raw_bufs[4];
    sim_lists_table_0060c968 = mock_raw_bufs[5];
    sim_lists_table_0060c964 = mock_raw_bufs[6];
    sim_pool_lock_00610a88 = mock_raw_bufs[7];

    auto init_vec = [](SimVector12_813& v, U mem_off, U len_bytes, U cap_bytes) {
        const U base = static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_vec_mem + mem_off));
        v.begin = base;
        v.end = base + len_bytes;
        v.capacity_end = base + cap_bytes;
    };
    init_vec(mock_vecs[0], 0u,    16u, cb_cap_pairs * 8u);
    init_vec(mock_vecs[1], 512u,  16u, cmp_cap_pairs * 8u);
    init_vec(mock_vecs[2], 1024u, 8u,  l1_cap_dw * 4u);
    init_vec(mock_vecs[3], 1536u, 8u,  l2_cap_dw * 4u);
    init_vec(mock_vecs[4], 2048u, 8u,  p_cap_dw * 4u);

    frame_callback_vector_0060c9f4 = reinterpret_cast<FrameVector_400*>(&mock_vecs[0]);
    frame_compact_vector_0060c9c4 = reinterpret_cast<FrameVector_400*>(&mock_vecs[1]);
    sim_lists_vec_0060c818 = &mock_vecs[2];
    sim_lists_vec_0060c904 = &mock_vecs[3];
    sim_pool_vec_00610a80 = &mock_vecs[4];
}

static void snapshot_teardown_state() {
    using namespace porsche;
    void* const cells[] = {
        sim_obj_0060ca14, sim_obj_0060ca18, sim_obj_0060ca1c, sim_obj_0060ca40,
        sim_obj_0060ca20, sim_obj_0060ca24, sim_obj_0060ca28, sim_obj_0060ca2c,
        sim_obj_0060c9f0, sim_obj_0060ca30, sim_obj_0060ca34, sim_obj_0060ca38,
        sim_obj_0060ca3c, sim_obj_0060ca44, sim_obj_0060ca4c, sim_obj_0060ca50,
        sim_obj_0060ca54, sim_obj_0060ca5c, sim_obj_0060ca48, sim_obj_0060c9b0,
        sim_obj_0060ca58, sim_obj_0060ca60, sim_obj_0060ca64, sim_obj_0060ca68,
        sim_obj_0060c9fc, sim_obj_0060c9c0, sim_obj_0060c9bc, sim_obj_0060ca0c,
        sim_obj_0060c9ac, sim_obj_0060ca7c,
        frame_callback_vector_0060c9f4, frame_compact_vector_0060c9c4,
        sim_lists_free_buf_0060c974, sim_lists_table_0060c968, sim_lists_table_0060c964,
        sim_lists_vec_0060c818, sim_lists_vec_0060c904, sim_pool_vec_00610a80
    };
    for (U i = 0u; i < 38u; ++i) {
        trace.ptrs_after[i] = id_of_ptr(cells[i]);
    }
    trace.refcount_after = sim_lists_refcount_0060c978;
    for (U i = 0u; i < 32u; ++i) {
        const U v = mock_heap_state.free_lists[i];
        trace.pool_heads[i] = (v >= 0xa000u && v < 0xa020u)
            ? v
            : id_of_ptr(reinterpret_cast<const void*>(static_cast<std::uintptr_t>(v)));
    }
    for (U i = 0u; i < 5u; ++i) {
        U nxt = 0u;
        std::memcpy(&nxt, mock_vec_mem + i * 512u + 4u, 4u);
        trace.freed_nexts[i] = nxt;
    }
}

static void compare_traces() {
    if (trace.abi_fail != 0u) fail("abi");
    if (expected.abi_fail != 0u) fail("abi_exp");
    if (trace.ret != expected.ret) fail("ret");
    if (trace.count != expected.count) fail("event_count");
    for (U i = 0u; i < trace.count; ++i) {
        if (std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) != 0) {
            fail("event_mismatch");
        }
    }
    if (std::memcmp(trace.table_nonnull, expected.table_nonnull, sizeof(trace.table_nonnull)) != 0) fail("table_nonnull");
    if (std::memcmp(trace.table_cc, expected.table_cc, sizeof(trace.table_cc)) != 0) fail("table_cc");
    if (std::memcmp(trace.table_38, expected.table_38, sizeof(trace.table_38)) != 0) fail("table_38");
    if (std::memcmp(trace.table_d0, expected.table_d0, sizeof(trace.table_d0)) != 0) fail("table_d0");
    if (std::memcmp(trace.slice_start, expected.slice_start, sizeof(trace.slice_start)) != 0) fail("slice_start");
    if (std::memcmp(trace.slice_end, expected.slice_end, sizeof(trace.slice_end)) != 0) fail("slice_end");
    if (std::memcmp(trace.slice_tag, expected.slice_tag, sizeof(trace.slice_tag)) != 0) fail("slice_tag");
    if (std::memcmp(trace.slice_data_off, expected.slice_data_off, sizeof(trace.slice_data_off)) != 0) fail("slice_data_off");
    if (trace.pool_total != expected.pool_total ||
        std::memcmp(trace.pool_copy, expected.pool_copy, trace.pool_total) != 0) fail("pool_copy");
    if (std::memcmp(trace.ptrs_after, expected.ptrs_after, sizeof(trace.ptrs_after)) != 0) fail("ptrs_after");
    if (trace.refcount_after != expected.refcount_after) fail("refcount_after");
    if (std::memcmp(trace.pool_heads, expected.pool_heads, sizeof(trace.pool_heads)) != 0) fail("pool_heads");
    if (std::memcmp(trace.freed_nexts, expected.freed_nexts, sizeof(trace.freed_nexts)) != 0) fail("freed_nexts");
    verify_fpu(trace.fp, expected.fp);
}

template <class Setup, class RunOrig, class RunCpp>
static void run_case(Setup setup, RunOrig run_orig, RunCpp run_cpp) {
    ++cases;
    which = 0u;
    std::memset(&trace, 0, sizeof(trace));
    setup();
    run_orig();
    capture_fpu(&trace.fp);
    expected = trace;

    which = 1u;
    std::memset(&trace, 0, sizeof(trace));
    setup();
    run_cpp();
    capture_fpu(&trace.fp);
    compare_traces();
}

int main(int argc, char** argv) {
    verify_pe_data_bytes(argc > 1 ? argv[1] : "local/game/Porsche.exe");
    init_original_code();

    run_case(
        []() {
            reset_audio_state(2u, "gt1");
            porsche::audio_channel_banks_00656aa8[1] = alloc_arena + 62000u;
        },
        []() {
            call_x86_2u(code + kOff4ACC10, static_cast<U>(-1), 0x00658374u);
            call_x86_2u(code + kOff4ACC10, 2u, 0x00658374u);
            call_x86_2u(code + kOff4ACC10, 1u, 0x00658374u);
            snapshot_audio_state();
        },
        []() {
            porsche::application_sim_boundary_004acc10(-1, 0x00658374u);
            porsche::application_sim_boundary_004acc10(2, 0x00658374u);
            porsche::application_sim_boundary_004acc10(1, 0x00658374u);
            snapshot_audio_state();
        });

    run_case(
        []() {
            reset_audio_state(2u, "gt1");
            mock_big_mode = 0u;
        },
        []() {
            const U va_ptr = static_cast<U>(reinterpret_cast<std::uintptr_t>(
                porsche::application_state_006573e8.characters(0x00658374u)));
            call_x86_2u(code + kOff4ACC10, 0u, va_ptr);
            snapshot_audio_state();
        },
        []() {
            porsche::application_sim_boundary_004acc10(0, 0x00658374u);
            snapshot_audio_state();
        });

    run_case(
        []() {
            reset_audio_state(1u, "box");
            mock_big_mode = 2u;
            mock_entry_count = 5u;
            std::strcpy(mock_entries[0].name, "eng.bnk");
            mock_entries[0].offset = 0x100u; mock_entries[0].size = 0x40u;
            std::strcpy(mock_entries[1].name, "badid.ect");
            mock_entries[1].offset = 0x200u; mock_entries[1].size = 768u;
            init_table_payload(mock_entries[1].data, 0x44414230u, 2u, 0u, 1, 0x10u, 6u, -1, 0u, 0u);
            std::strcpy(mock_entries[2].name, "badver.elt");
            mock_entries[2].offset = 0x300u; mock_entries[2].size = 768u;
            init_table_payload(mock_entries[2].data, 0x6c445243u, 3u, 0u, 2, 0x120u, 8u, -1, 0u, 0u);
            std::strcpy(mock_entries[3].name, "good.cct");
            mock_entries[3].offset = 0x400u; mock_entries[3].size = 768u;
            init_table_payload(mock_entries[3].data, 0x6c445243u, 2u, 0u, 3, 0x05u, 4u, 4, 0x02u, 5u);
            std::strcpy(mock_entries[4].name, "good.clt");
            mock_entries[4].offset = 0x500u; mock_entries[4].size = 768u;
            init_table_payload(mock_entries[4].data, 0x11111111u, 9u, 0u, 5, 0x08u, 7u, -1, 0u, 0u);
        },
        []() {
            const U va_ptr = static_cast<U>(reinterpret_cast<std::uintptr_t>(
                porsche::application_state_006573e8.characters(0x00658374u)));
            call_x86_2u(code + kOff4ACC10, 0u, va_ptr);
            snapshot_audio_state();
        },
        []() {
            porsche::application_sim_boundary_004acc10(0, 0x00658374u);
            snapshot_audio_state();
        });

    run_case(
        []() {
            reset_audio_state(2u, "hostignored");
            mock_big_mode = 1u;
            mock_entry_count = 5u;
            std::strcpy(mock_entries[0].name, "car.bnk");
            mock_entries[0].offset = 0x100u; mock_entries[0].size = 0x40u;
            std::strcpy(mock_entries[1].name, "a.ect");
            mock_entries[1].offset = 0x200u; mock_entries[1].size = 768u;
            init_table_payload(mock_entries[1].data, 0x6c445243u, 2u, 1u, 1, 0x10u, 6u, -1, 0u, 0u);
            std::strcpy(mock_entries[2].name, "b.elt");
            mock_entries[2].offset = 0x300u; mock_entries[2].size = 768u;
            init_table_payload(mock_entries[2].data, 0x6c445243u, 2u, 0u, 2, 0x04u, 8u, -1, 0u, 0u);
            std::strcpy(mock_entries[3].name, "c.cct");
            mock_entries[3].offset = 0x400u; mock_entries[3].size = 768u;
            init_table_payload(mock_entries[3].data, 0x6c445243u, 2u, 1u, 3, 0x05u, 4u, -1, 0u, 0u);
            std::strcpy(mock_entries[4].name, "d.clt");
            mock_entries[4].offset = 0x500u; mock_entries[4].size = 768u;
            init_table_payload(mock_entries[4].data, 0x6c445243u, 2u, 0u, 5, 0x08u, 7u, -1, 0u, 0u);
        },
        []() {
            static const char kHostCar[] = "993";
            call_x86_2u(code + kOff4ACC10, 1u,
                        static_cast<U>(reinterpret_cast<std::uintptr_t>(kHostCar)));
            snapshot_audio_state();
        },
        []() {
            static const char kHostCar[] = "993";
            porsche::application_sim_boundary_004acc10(
                1, static_cast<U>(reinterpret_cast<std::uintptr_t>(kHostCar)));
            snapshot_audio_state();
        });

    run_case(
        []() {
            reset_audio_state(2u, "gt1");
            mock_big_mode = 3u;
            mock_entry_count = 4u;
            oom_size_trigger = 0x44u;
            std::strcpy(mock_entries[0].name, "oom.bnk");
            mock_entries[0].offset = 0x100u; mock_entries[0].size = 0x44u;
            std::strcpy(mock_entries[1].name, "a.ect");
            mock_entries[1].offset = 0x200u; mock_entries[1].size = 768u;
            init_table_payload(mock_entries[1].data, 0x6c445243u, 2u, 0u, 1, 0x04u, 4u, -1, 0u, 0u);
            std::strcpy(mock_entries[2].name, "b.elt");
            mock_entries[2].offset = 0x300u; mock_entries[2].size = 768u;
            init_table_payload(mock_entries[2].data, 0x6c445243u, 2u, 0u, 2, 0x04u, 4u, -1, 0u, 0u);
            std::strcpy(mock_entries[3].name, "d.clt");
            mock_entries[3].offset = 0x500u; mock_entries[3].size = 768u;
            init_table_payload(mock_entries[3].data, 0x6c445243u, 2u, 0u, 3, 0x04u, 4u, -1, 0u, 0u);
        },
        []() {
            const U va_ptr = static_cast<U>(reinterpret_cast<std::uintptr_t>(
                porsche::application_state_006573e8.characters(0x00658374u)));
            call_x86_2u(code + kOff4ACC10, 0u, va_ptr);
            snapshot_audio_state();
        },
        []() {
            porsche::application_sim_boundary_004acc10(0, 0x00658374u);
            snapshot_audio_state();
        });

    run_case(
        []() {},
        []() {
            static const U src[4] = {11u, 22u, 33u, 44u};
            U dst[4] = {0u, 0u, 0u, 0u};
            const U r1 = call_x86_copy(code + kOff436710, src, src + 3, dst);
            const U r2 = call_x86_copy(code + kOff436710, src + 2, src + 1, dst);
            trace.ret = (r1 - static_cast<U>(reinterpret_cast<std::uintptr_t>(dst))) ^
                        ((r2 - static_cast<U>(reinterpret_cast<std::uintptr_t>(dst))) << 8u) ^
                        (dst[0] * 3u + dst[1] * 5u + dst[2] * 7u);
        },
        []() {
            static const U src[4] = {11u, 22u, 33u, 44u};
            U dst[4] = {0u, 0u, 0u, 0u};
            const U* p1 = porsche::sim_teardown_copy_dwords_00436710(src, src + 3, dst);
            const U* p2 = porsche::sim_teardown_copy_dwords_00436710(src + 2, src + 1, dst);
            trace.ret = static_cast<U>((p1 - dst) * 4) ^
                        (static_cast<U>((p2 - dst) * 4) << 8u) ^
                        (dst[0] * 3u + dst[1] * 5u + dst[2] * 7u);
        });

    run_case(
        []() { setup_teardown_full(2u, 8u, 40u, 64u, 65u, 16u); },
        []() { call_x86_0(code + kOff425330); snapshot_teardown_state(); },
        []() { porsche::application_sim_boundary_00425330(); snapshot_teardown_state(); });

    run_case(
        []() {
            setup_teardown_full(1u, 8u, 40u, 64u, 65u, 16u);
            porsche::sim_teardown_secondary_0060c7e8 = nullptr;
        },
        []() { call_x86_0(code + kOff425330); snapshot_teardown_state(); },
        []() { porsche::application_sim_boundary_00425330(); snapshot_teardown_state(); });

    run_case(
        []() {
            setup_teardown_full(1u, 0u, 0u, 0u, 0u, 0u);
            porsche::sim_lists_vec_0060c818 = nullptr;
            porsche::sim_lists_vec_0060c904 = nullptr;
            porsche::sim_pool_vec_00610a80 = nullptr;
        },
        []() { call_x86_0(code + kOff425330); snapshot_teardown_state(); },
        []() { porsche::application_sim_boundary_00425330(); snapshot_teardown_state(); });

    std::printf("sim_audio_and_frame_teardown_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    return 0;
}
