static U id_of_ptr(const void* p) {
    if (p == nullptr) return 0u;
    const U addr = static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
    for (U i = 0u; i < alloc_count; ++i) {
        if (alloc_ptrs[i] == addr) return 0x100u + i;
    }
    for (U i = 0u; i < 5u; ++i) {
        if (p == &mock_vecs[i]) return 0x200u + i;
    }
    for (U i = 0u; i < 8u; ++i) {
        if (p == mock_raw_bufs[i]) return 0x300u + i;
    }
    const U base = static_cast<U>(reinterpret_cast<std::uintptr_t>(mock_vec_mem));
    if (addr >= base && addr < base + sizeof(mock_vec_mem)) {
        return 0x400u + (addr - base);
    }
    if (p == kMockBigPtr) return 0x500u;
    if (p == kMockFileHandle) return 0x501u;
    if (p == &mock_heap_state.pool_lock) return 0x600u;
    if (p == reinterpret_cast<const void*>(0x12340001u)) return 0x700u;
    return 0x9999u;
}

