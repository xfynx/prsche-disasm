static void* handle_big_request(U ev_tag, const char* name, U flags) {
    push_event(ev_tag, fnv1a(name, std::strlen(name)), flags);
    if (mock_big_mode == 1u && std::strstr(name, "16.viv") != nullptr && std::strstr(name, "sd7a") == nullptr) {
        return kMockBigPtr;
    }
    if (mock_big_mode == 2u && std::strstr(name, "16.viv") == nullptr && std::strstr(name, "sd7a") == nullptr) {
        return kMockBigPtr;
    }
    if (mock_big_mode == 3u && std::strstr(name, "sd7a.viv") != nullptr) {
        return kMockBigPtr;
    }
    return nullptr;
}

