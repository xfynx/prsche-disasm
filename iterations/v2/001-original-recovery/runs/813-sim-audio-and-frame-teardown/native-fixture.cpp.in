static void verify_pe_data_bytes(const char* pe_path) {
    FILE* f = std::fopen(pe_path, "rb");
    if (f == nullptr) fail("open_pe");
    struct Span { U file_off; const char* ptr; U len; };
    const Span spans[] = {
        {0x1d1ad4u, porsche::audio_file_ver_err_005d1ad4, 33u},
        {0x1d1af8u, porsche::audio_file_id_err_005d1af8, 28u},
        {0x1d1b14u, porsche::audio_engine_tables_tag_005d1b14, 14u},
        {0x1d1b24u, porsche::audio_clt_ext_005d1b24, 5u},
        {0x1d1b2cu, porsche::audio_cct_ext_005d1b2c, 5u},
        {0x1d1b34u, porsche::audio_elt_ext_005d1b34, 5u},
        {0x1d1b3cu, porsche::audio_ect_ext_005d1b3c, 5u},
        {0x1d1b44u, porsche::audio_engine_oom_fmt_005d1b44, 28u},
        {0x1d1b60u, porsche::audio_sd7a_viv_fmt_005d1b60, 11u},
        {0x1d1b6cu, porsche::audio_sd7a16_viv_fmt_005d1b6c, 13u},
        {0x1d1b7cu, porsche::audio_name_viv_fmt_005d1b7c, 9u},
        {0x1d1b88u, porsche::audio_name16_viv_fmt_005d1b88, 11u},
        {0x1d1b94u, porsche::audio_engine_tag_005d1b94, 13u},
    };
    B buf[64];
    for (const auto& sp : spans) {
        std::fseek(f, static_cast<long>(sp.file_off), SEEK_SET);
        if (std::fread(buf, 1, sp.len, f) != sp.len || std::memcmp(buf, sp.ptr, sp.len) != 0) {
            std::fclose(f);
            fail("pe_data_mismatch");
        }
    }
    std::fclose(f);
}

static void init_original_code() {
    code = static_cast<B*>(
        VirtualAlloc(nullptr, kCodeBytes, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    if (code == nullptr) fail("virtualalloc");
    std::memset(code, 0xcc, kCodeBytes);
    std::memcpy(code + kOff4ACC10, kBody4ACC10, sizeof(kBody4ACC10));
    std::memcpy(code + kOff425330, kBody425330, sizeof(kBody425330));
    std::memcpy(code + kOff419DC0, kBody419DC0, sizeof(kBody419DC0));
    std::memcpy(code + kOff41E2C0, kBody41E2C0, sizeof(kBody41E2C0));
    std::memcpy(code + kOff436710, kBody436710, sizeof(kBody436710));
    std::memcpy(code + kOff434F00, kBody434F00, sizeof(kBody434F00));
    for (const auto& r : kRelocs) {
        write_u32(code + r.base + r.off,
                  static_cast<U>(reinterpret_cast<std::uintptr_t>(resolve_global(r.va))));
    }
    for (const auto& c : kCalls) {
        write_rel32(code + c.base + c.off, resolve_callee(c.va));
    }
}

static void call_x86_2u(void* fn, U a0, U a1) {
    U s0 = 0u, s1 = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        push a1
        push a0
        call fn
        add esp, 8
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
}

static void call_x86_0(void* fn) {
    U s0 = 0u, s1 = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        call fn
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
}

static U call_x86_copy(void* fn, const U* a0, const U* a1, U* a2) {
    U s0 = 0u, s1 = 0u, r = 0u;
    __asm {
        mov esi, 0x22223333
        mov edi, 0x44445555
        mov s0, esp
        push a2
        push a1
        push a0
        call fn
        add esp, 12
        mov r, eax
        mov s1, esp
        cmp esi, 0x22223333
        je ok_si
        mov trace.abi_fail, 1
    ok_si:
        cmp edi, 0x44445555
        je ok_di
        mov trace.abi_fail, 2
    ok_di:
    }
    if (s0 != s1) trace.abi_fail = 3u;
    return r;
}

static void init_table_payload(B* dst, U magic, B version, B preflag, B tag0, U off0, U len0, B tag1, U off1, U len1) {
    std::memset(dst, 0, 768);
    write_u32(dst + 0u, magic);
    dst[4] = version;
    dst[5] = preflag;
    for (U j = 0u; j < 8u; ++j) {
        dst[0x20u + j] = 0xffu;
    }
    if (static_cast<signed char>(tag0) > -1) {
        dst[0x20u + 0u] = tag0;
        const U slot_a = 0x128u;
        const U slot_b = 0x148u;
        const U curve_off = 0x180u;
        write_u32(dst + slot_a, curve_off - slot_a);
        write_u32(dst + slot_b, curve_off - slot_b);
        std::memset(dst + curve_off + off0, static_cast<int>(tag0 + 0x31u), len0);
    }
    if (static_cast<signed char>(tag1) > -1) {
        dst[0x20u + 3u] = tag1;
        const U slot_a = 0x128u + 12u;
        const U slot_b = 0x148u + 12u;
        write_u32(dst + slot_a, 0x170u - slot_a);
        write_u32(dst + slot_b, 0x170u - slot_b);
        std::memset(dst + 0x170u + off1, static_cast<int>(tag1 + 0x41u), len1);
    }
}

static void reset_audio_state(U quality, const char* car_name) {
    using namespace porsche;
    alloc_cursor = 0u;
    alloc_count = 0u;
    oom_size_trigger = 0u;
    std::memset(alloc_arena, 0, sizeof(alloc_arena));
    audio_channel_banks_00656aa8[0] = nullptr;
    audio_channel_banks_00656aa8[1] = nullptr;
    static char prefix_buf[] = "C:\\audio\\";
    application_audio_path_prefix_0065b318 = prefix_buf;
    application_state_006573e8.word(0x0065741cu) = 1u;
    application_state_006573e8.word(0x00657c98u) = quality;
    std::strcpy(application_state_006573e8.characters(0x006582f4u + 0x580u), "911");
    std::strcpy(application_state_006573e8.characters(0x00658374u), car_name);
    application_audio_records_006564a0[0].raw_00 = 0x1234567au;
    application_audio_records_006564a0[1].raw_00 = 0x89abcdefu;
    mock_entry_count = 0u;
    std::memset(mock_entries, 0, sizeof(mock_entries));
}

static void snapshot_audio_state() {
    using namespace porsche;
    for (U s = 0u; s < 2u; ++s) {
        const B* tbl = static_cast<const B*>(audio_channel_banks_00656aa8[s]);
        trace.table_nonnull[s] = tbl != nullptr ? 1u : 0u;
        if (tbl != nullptr) {
            std::memcpy(&trace.table_cc[s], tbl + 0xccu, 4u);
            std::memcpy(&trace.table_38[s], tbl + 0x38u, 4u);
            trace.table_d0[s] = tbl[0xd0u];
            U pool_u = 0u;
            std::memcpy(&pool_u, tbl + 0x754u, 4u);
            if (s == 0u || audio_channel_banks_00656aa8[0] == nullptr) {
                for (U i = 0u; i < 32u; ++i) {
                    const U off = 0x2d4u + i * 0x0cu;
                    std::memcpy(&trace.slice_start[i], tbl + off + 0u, 2u);
                    std::memcpy(&trace.slice_end[i], tbl + off + 2u, 2u);
                    U data_u = 0u;
                    std::memcpy(&data_u, tbl + off + 4u, 4u);
                    trace.slice_tag[i] = tbl[off + 8u];
                    trace.slice_data_off[i] = (pool_u != 0u && data_u != 0u) ? (data_u - pool_u) : 0xffffffffu;
                    if (trace.slice_end[i] > trace.slice_start[i]) {
                        const U span = static_cast<U>(trace.slice_end[i] - trace.slice_start[i]);
                        if (trace.slice_data_off[i] != 0xffffffffu && trace.slice_data_off[i] + span <= sizeof(trace.pool_copy)) {
                            std::memcpy(trace.pool_copy + trace.slice_data_off[i],
                                        reinterpret_cast<const void*>(static_cast<std::uintptr_t>(data_u)),
                                        span);
                            if (trace.slice_data_off[i] + span > trace.pool_total) {
                                trace.pool_total = trace.slice_data_off[i] + span;
                            }
                        }
                    }
                }
            }
        }
    }
}

