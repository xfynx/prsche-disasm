#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include "audio_stream_scdl_chunk_740.hpp"

using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

enum : U {
    kArenaBytes = 8192u,
    kScratchArenaBytes = 4096u,
    kMaxEvents = 64u,
    kScratchSnapBytes = 256u,
};

enum EventTag : U {
    kEvBackendLock = 1u,
    kEvBackendUnlock = 2u,
    kEvVirtualAlloc = 3u,
    kEvVirtualFree = 4u,
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U arg2;
    U arg3;
    U ret;
};

struct Trace {
    U ret;
    U abi_fail;
    U count;
    Event events[kMaxEvents];
    B final_device_state[0x18c];
    U final_stream_slots[16];
    U last_alloc_bytes;
    B last_scratch_at_free[kScratchSnapBytes];
    FpuSnapshot fp;
    B memory[kArenaBytes];
};

alignas(256) static B arena[kArenaBytes];
alignas(256) static B scratch_arena[kScratchArenaBytes];
alignas(16) static B fp_area[512];
static B fp_env[28];

static Trace trace{};
static Trace expected{};

static U cases = 0u;
static U events_total = 0u;
static U which = 0u;
static U captured_return = 0u;

static B* code = nullptr;
static B* orig_5615c0 = nullptr;
static B* orig_566b40 = nullptr;
static B* orig_567060 = nullptr;

using VirtualAllocFn = void* (__stdcall*)(void*, U, U, U);
using VirtualFreeFn = U (__stdcall*)(void*, U, U);
static VirtualAllocFn iat_virtual_alloc = nullptr;
static VirtualFreeFn iat_virtual_free = nullptr;

static U address(const void* p) { return static_cast<U>(reinterpret_cast<std::uintptr_t>(p)); }

static U rd(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void wr(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void wr_u16(void* p, U o, std::uint16_t v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 2u);
}

static void wr_va(U va, U v) {
    std::memcpy(reinterpret_cast<void*>(static_cast<std::uintptr_t>(va)), &v, 4u);
}

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u which=%u\n", why, cases, which);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx case=%u which=%u\n",
                p->ExceptionRecord->ExceptionCode, p->ContextRecord->Eip, cases, which);
    std::fflush(stdout);
    ExitProcess(1);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void capture_fp(FpuSnapshot& fp) {
    __asm fxsave fp_area
    __asm fnstenv fp_env
    __asm fldenv fp_env
    fp.control = static_cast<unsigned short>(rd(fp_area, 0u));
    fp.status = static_cast<unsigned short>(rd(fp_area, 2u));
    fp.tag = static_cast<unsigned short>(rd(fp_env, 8u));
    fp.pad = 0u;
    fp.mxcsr = rd(fp_area, 24u);
    for (U i = 0u; i < 8u; ++i) {
        std::memcpy(fp.values + i * 10u, fp_area + 32u + i * 16u, 10u);
        if ((fp_area[4u] & (1u << (((fp.status >> 11u) + i) & 7u))) == 0u) {
            std::memset(fp.values + i * 10u, 0, 10u);
        }
    }
}

static Event& push_event(U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u, U ret = 0u) {
    require(trace.count < kMaxEvents, "event overflow");
    Event& e = trace.events[trace.count++];
    e.tag = tag;
    e.arg0 = a0;
    e.arg1 = a1;
    e.arg2 = a2;
    e.arg3 = a3;
    e.ret = ret;
    return e;
}

namespace porsche {

ApplicationAudioDeviceStateStorage application_audio_device_state_006b48c0{};
std::uint32_t audio_stream_slots_006b7cc0[16]{};

void __cdecl audio_backend_lock_005896d0() {
    push_event(kEvBackendLock);
}

void __cdecl audio_backend_unlock_005896f0() {
    push_event(kEvBackendUnlock);
}

void* __stdcall platform_virtual_alloc(
    void* lpAddress,
    std::uint32_t dwSize,
    std::uint32_t flAllocationType,
    std::uint32_t flProtect) {
    void* res = nullptr;
    if (dwSize != 0u) {
        require(dwSize <= kScratchArenaBytes, "scratch size bound");
        std::memset(scratch_arena, 0xCC, dwSize);
        res = scratch_arena;
    }
    trace.last_alloc_bytes = dwSize;
    push_event(kEvVirtualAlloc, address(lpAddress), dwSize, flAllocationType, flProtect, address(res));
    return res;
}

std::uint32_t __stdcall platform_virtual_free(
    void* lpAddress,
    std::uint32_t dwSize,
    std::uint32_t dwFreeType) {
    const U snap_len = (trace.last_alloc_bytes < kScratchSnapBytes)
        ? trace.last_alloc_bytes : kScratchSnapBytes;
    std::memset(trace.last_scratch_at_free, 0, kScratchSnapBytes);
    if (lpAddress != nullptr && snap_len != 0u) {
        std::memcpy(trace.last_scratch_at_free, lpAddress, snap_len);
    }
    push_event(kEvVirtualFree, address(lpAddress), dwSize, dwFreeType, 0u, 1u);
    return 1u;
}

} // namespace porsche

static U invoke_2(void* fn, U a0, U a1) {
    U saved_sp = 0u;
    U saved_bp = 0u;
    U fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp, esp
        mov saved_bp, ebp
        push a1
        push a0
        mov ebx, 0x13579bdf
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        call fn
        mov captured_return, eax
        add esp, 8
        cmp esp, saved_sp
        jne bad_abi
        cmp ebp, saved_bp
        jne bad_abi
        cmp ebx, 0x13579bdf
        jne bad_abi
        cmp esi, 0x2468ace0
        jne bad_abi
        cmp edi, 0x10203040
        je ok_abi
    bad_abi:
        mov fail, 1
    ok_abi:
        mov esp, saved_sp
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static U invoke_4(void* fn, U a0, U a1, U a2, U a3) {
    U saved_sp = 0u;
    U saved_bp = 0u;
    U fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp, esp
        mov saved_bp, ebp
        push a3
        push a2
        push a1
        push a0
        mov ebx, 0x13579bdf
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        call fn
        mov captured_return, eax
        add esp, 16
        cmp esp, saved_sp
        jne bad_abi
        cmp ebp, saved_bp
        jne bad_abi
        cmp ebx, 0x13579bdf
        jne bad_abi
        cmp esi, 0x2468ace0
        jne bad_abi
        cmp edi, 0x10203040
        je ok_abi
    bad_abi:
        mov fail, 1
    ok_abi:
        mov esp, saved_sp
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

static void verify_initial_state() {
    for (U i = 0u; i < 0x18cu; ++i) {
        require(porsche::application_audio_device_state_006b48c0.backing[i] == 0u,
                "initial device_state bss non-zero");
    }
    for (U i = 0u; i < 16u; ++i) {
        require(porsche::audio_stream_slots_006b7cc0[i] == 0u,
                "initial stream_slots bss non-zero");
    }
}

static void init_originals() {
    static const B body_5615c0[] = {@BODY_005615C0@};
    static const B body_566b40[] = {@BODY_00566B40@};
    static const B body_567060[] = {@BODY_00567060@};

    code = static_cast<B*>(VirtualAlloc(nullptr, 8192u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "code alloc");
    std::memset(code, 0xCC, 8192u);

    orig_5615c0 = code + 0x0000u;
    orig_566b40 = code + 0x0200u;
    orig_567060 = code + 0x0600u;

    std::memcpy(orig_5615c0, body_5615c0, sizeof body_5615c0);
    std::memcpy(orig_566b40, body_566b40, sizeof body_566b40);
    std::memcpy(orig_567060, body_567060, sizeof body_567060);

    auto patch_rel32 = [](B* fn, U disp_off, const void* target) {
        const U src_next = address(fn + disp_off + 4u);
        wr_va(address(fn + disp_off), address(target) - src_next);
    };

    // 005615c0 relocations
    wr_va(address(orig_5615c0 + 0x001u), address(&porsche::application_audio_device_state_006b48c0[0xdcu]));
    wr_va(address(orig_5615c0 + 0x018u), address(porsche::audio_stream_slots_006b7cc0));
    patch_rel32(orig_5615c0, 0x01du, reinterpret_cast<const void*>(porsche::audio_backend_lock_005896d0));
    patch_rel32(orig_5615c0, 0x036u, reinterpret_cast<const void*>(porsche::audio_backend_unlock_005896f0));
    patch_rel32(orig_5615c0, 0x0b7u, reinterpret_cast<const void*>(porsche::audio_backend_unlock_005896f0));

    // 00566b40 indirect IAT call slots (005b2144 VirtualAlloc, 005b2148 VirtualFree)
    iat_virtual_alloc = porsche::platform_virtual_alloc;
    iat_virtual_free = porsche::platform_virtual_free;
    wr_va(address(orig_566b40 + 0x0b7u), address(&iat_virtual_alloc));
    wr_va(address(orig_566b40 + 0x1f1u), address(&iat_virtual_free));

    // 00567060 relocations (calls into original 00566b40 and 005615c0)
    patch_rel32(orig_567060, 0x031u, orig_566b40);
    patch_rel32(orig_567060, 0x0aeu, orig_5615c0);

    FlushInstructionCache(GetCurrentProcess(), code, 8192u);
}

static void reset_trace_state() {
    std::memset(arena, 0xA5, sizeof arena);
    std::memset(scratch_arena, 0x5A, sizeof scratch_arena);
    std::memset(porsche::application_audio_device_state_006b48c0.backing.data(), 0, 0x18cu);
    std::memset(porsche::audio_stream_slots_006b7cc0, 0, sizeof porsche::audio_stream_slots_006b7cc0);
    std::memset(&trace, 0, sizeof trace);
}

static void finish_trace(U abi_fail) {
    trace.ret = captured_return;
    trace.abi_fail = abi_fail;
    std::memcpy(trace.final_device_state, porsche::application_audio_device_state_006b48c0.backing.data(), 0x18cu);
    std::memcpy(trace.final_stream_slots, porsche::audio_stream_slots_006b7cc0, sizeof trace.final_stream_slots);
    capture_fp(trace.fp);
    std::memcpy(trace.memory, arena, kArenaBytes);
}

static void compare_traces() {
    require(trace.abi_fail == 0u && expected.abi_fail == 0u, "abi_fail");
    require(trace.ret == expected.ret, "return value mismatch");
    require(trace.count == expected.count, "event count mismatch");
    for (U i = 0u; i < trace.count; ++i) {
        require(std::memcmp(&trace.events[i], &expected.events[i], sizeof(Event)) == 0, "event mismatch");
    }
    require(trace.last_alloc_bytes == expected.last_alloc_bytes, "last_alloc_bytes mismatch");
    require(std::memcmp(trace.last_scratch_at_free, expected.last_scratch_at_free, kScratchSnapBytes) == 0,
            "scratch buffer at free mismatch");
    require(std::memcmp(trace.final_device_state, expected.final_device_state, 0x18cu) == 0,
            "device state mismatch");
    require(std::memcmp(trace.final_stream_slots, expected.final_stream_slots, sizeof trace.final_stream_slots) == 0,
            "stream slots mismatch");
    require(std::memcmp(&trace.fp, &expected.fp, sizeof(FpuSnapshot)) == 0, "fpu snapshot mismatch");
    require(std::memcmp(trace.memory, expected.memory, kArenaBytes) == 0, "arena memory mismatch");
    ++cases;
    events_total += trace.count;
}

template <typename Setup>
static void run_case_2(void* orig_fn, void* cpp_fn, U a0, U a1, Setup setup) {
    which = 0u;
    reset_trace_state();
    setup();
    const U orig_fail = invoke_2(orig_fn, a0, a1);
    finish_trace(orig_fail);
    expected = trace;

    which = 1u;
    reset_trace_state();
    setup();
    const U cpp_fail = invoke_2(cpp_fn, a0, a1);
    finish_trace(cpp_fail);
    compare_traces();
}

template <typename Setup>
static void run_case_4(void* orig_fn, void* cpp_fn, U a0, U a1, U a2, U a3, Setup setup) {
    which = 0u;
    reset_trace_state();
    setup();
    const U orig_fail = invoke_4(orig_fn, a0, a1, a2, a3);
    finish_trace(orig_fail);
    expected = trace;

    which = 1u;
    reset_trace_state();
    setup();
    const U cpp_fail = invoke_4(cpp_fn, a0, a1, a2, a3);
    finish_trace(cpp_fail);
    compare_traces();
}

static void init_slot_record(
    U slot_idx,
    B* rec,
    U next_id,
    std::uint16_t used0,
    std::uint16_t used1,
    std::uint16_t capacity,
    std::uint16_t write_idx,
    U total_bytes,
    B sub_count) {
    std::memset(rec, 0x31, 0x400u);
    porsche::audio_stream_slots_006b7cc0[slot_idx] = address(rec);
    wr(rec, 0x04u, next_id);
    wr_u16(rec, 0x10u, used0);
    wr_u16(rec, 0x12u, used1);
    wr_u16(rec, 0x14u, 7u);
    wr_u16(rec, 0x16u, 9u);
    wr_u16(rec, 0x18u, capacity);
    wr_u16(rec, 0x1eu, write_idx);
    wr(rec, 0x20u, total_bytes);
    rec[0x36u] = sub_count;
}

static void run_push_chunk_cases() {
    void* const cpp_fn = reinterpret_cast<void*>(porsche::audio_stream_slot_push_chunk_005615c0);
    B* const rec = arena + 0x0400u;
    B* const items = arena + 0x0100u;

    // 1. audio inactive -> returns -10
    run_case_2(orig_5615c0, cpp_fn, 0u, address(items), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 0u;
        init_slot_record(0u, rec, 5u, 0u, 0u, 4u, 0u, 100u, 2);
        wr(items, 0x04u, 64u);
    });

    // 2. ring full (used == capacity - 1) -> lock, unlock, -13
    run_case_2(orig_5615c0, cpp_fn, 3u, address(items), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_slot_record(3u, rec, 12u, 7u, 1u, 8u, 2u, 500u, 2);
        wr(items, 0x04u, 128u);
    });

    // 3. capacity == 1, used == 0 (boundary full check: used >= capacity - 1)
    run_case_2(orig_5615c0, cpp_fn, 1u, address(items), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_slot_record(1u, rec, 1u, 0u, 0u, 1u, 0u, 0u, 1);
        wr(items, 0x04u, 32u);
    });

    // 4. sub_count == 0 -> no channel pointers copied, still advances counters and wraps
    run_case_2(orig_5615c0, cpp_fn, 2u, address(items), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_slot_record(2u, rec, 42u, 1u, 2u, 4u, 1u, 1024u, 0);
        wr(items, 0x04u, 256u);
    });

    // 5. sub_count == 2, mid ring
    run_case_2(orig_5615c0, cpp_fn, 5u, address(items), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_slot_record(5u, rec, 0x100u, 1u, 3u, 6u, 2u, 2000u, 2);
        wr(items, 0x04u, 320u);
        wr(items, 0x0cu, 0x11112222u);
        wr(items, 0x10u, 0x33334444u);
    });

    // 6. sub_count == 4, write_idx == capacity - 1 -> wraps write_idx to 0
    run_case_2(orig_5615c0, cpp_fn, 15u, address(items), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_slot_record(15u, rec, 99u, 2u, 2u, 4u, 3u, 800u, 4);
        wr(items, 0x04u, 512u);
        wr(items, 0x0cu, 0xaaaa0001u);
        wr(items, 0x10u, 0xaaaa0002u);
        wr(items, 0x14u, 0xaaaa0003u);
        wr(items, 0x18u, 0xaaaa0004u);
    });
}

static void fill_pattern(B* p, U n, U seed) {
    for (U i = 0u; i < n; ++i) {
        p[i] = static_cast<B>((seed + i * 37u + (i >> 2) * 13u) & 0xffu);
    }
}

static void run_deinterleave_cases() {
    void* const cpp_fn = reinterpret_cast<void*>(porsche::audio_stream_deinterleave_chunk_00566b40);
    B* const data = arena + 0x0200u;

    // 7. mode 3 mono len=0
    run_case_4(orig_566b40, cpp_fn, address(data), 0u, 1u, 3u, [&]() {
        fill_pattern(data, 64u, 1u);
    });

    // 8. mode 3 mono len=1 (15 bytes shifted from +8 to +4)
    run_case_4(orig_566b40, cpp_fn, address(data), 1u, 1u, 3u, [&]() {
        fill_pattern(data, 128u, 7u);
    });

    // 9. mode 3 mono len=29 (2 blocks -> 30 bytes shifted)
    run_case_4(orig_566b40, cpp_fn, address(data), 29u, 1u, 3u, [&]() {
        fill_pattern(data, 128u, 19u);
    });

    // 10. mode 3 stereo len=28 (1 block -> copy_bytes=19, nibble_count=30)
    run_case_4(orig_566b40, cpp_fn, address(data), 28u, 2u, 3u, [&]() {
        fill_pattern(data, 256u, 31u);
    });

    // 11. mode 3 stereo len=57 (3 blocks -> copy_bytes=49, nibble_count=90)
    run_case_4(orig_566b40, cpp_fn, address(data), 57u, 2u, 3u, [&]() {
        fill_pattern(data, 512u, 43u);
    });

    // 12. mode 2 mono len=16 -> early return 0
    run_case_4(orig_566b40, cpp_fn, address(data), 16u, 1u, 2u, [&]() {
        fill_pattern(data, 64u, 55u);
    });

    // 13. mode 2 stereo len=0 -> VirtualAlloc(0) -> nullptr, VirtualFree(nullptr)
    run_case_4(orig_566b40, cpp_fn, address(data), 0u, 2u, 2u, [&]() {
        fill_pattern(data, 64u, 61u);
    });

    // 14. mode 2 stereo len=17 -> odd byte count (rep movsd + 1 byte tail)
    run_case_4(orig_566b40, cpp_fn, address(data), 17u, 2u, 2u, [&]() {
        fill_pattern(data, 128u, 73u);
    });

    // 15. mode 0 mono len=12 -> early return 0
    run_case_4(orig_566b40, cpp_fn, address(data), 12u, 1u, 0u, [&]() {
        fill_pattern(data, 64u, 83u);
    });

    // 16. mode 0 stereo len=9 -> copy_bytes=18 (16-bit deinterleave + 2-byte tail)
    run_case_4(orig_566b40, cpp_fn, address(data), 9u, 2u, 0u, [&]() {
        fill_pattern(data, 128u, 97u);
    });

    // 17. mode 1 and mode 9 unsupported -> early return 0
    run_case_4(orig_566b40, cpp_fn, address(data), 16u, 2u, 1u, [&]() {
        fill_pattern(data, 64u, 101u);
    });
    run_case_4(orig_566b40, cpp_fn, address(data), 16u, 2u, 9u, [&]() {
        fill_pattern(data, 64u, 109u);
    });
}

static void init_scdl_stream(
    B* stream,
    B* entry_table,
    U slot_idx,
    std::int8_t entry_idx,
    B channels,
    B codec_mode,
    B offset_mode) {
    std::memset(stream, 0x22, 0x60u);
    wr(stream, 0x00u, address(entry_table));
    wr(stream, 0x0cu, slot_idx);
    stream[0x17u] = static_cast<B>(entry_idx);
    stream[0x2eu] = channels;
    stream[0x2fu] = codec_mode;
    stream[0x3bu] = offset_mode;
}

static void init_entry(B* entry, U sample_handle, I first_id, I last_id, U bytes, U count) {
    std::memset(entry, 0x44, 0x2cu);
    wr(entry, 0x04u, sample_handle);
    wr(entry, 0x08u, static_cast<U>(first_id));
    wr(entry, 0x0cu, static_cast<U>(last_id));
    wr(entry, 0x1cu, bytes);
    wr(entry, 0x20u, count);
}

static void run_service_scdl_cases() {
    void* const cpp_fn = reinterpret_cast<void*>(porsche::audio_stream_service_chunk_scdl_00567060);
    B* const stream = arena + 0x0080u;
    B* const entry_base = arena + 0x0200u;
    B* const chunk = arena + 0x0800u;
    B* const rec = arena + 0x1000u;

    // 18. interleaved mode, codec 2, mono, entry_idx=0, entry[+8] == -1 (<0 updates first_id)
    run_case_2(orig_567060, cpp_fn, address(stream), address(chunk), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_scdl_stream(stream, entry_base, 0u, 0, 1u, 2u, 0u);
        init_entry(entry_base, 0x77770001u, -1, 0, 100u, 2u);
        init_slot_record(0u, rec, 50u, 0u, 0u, 8u, 0u, 400u, 1);
        fill_pattern(chunk, 128u, 11u);
        wr(chunk, 0x08u, 24u);
    });

    // 19. interleaved mode, codec 3, stereo, chunk_len=28, entry_idx=2, entry[+8] == 0 (not updated)
    run_case_2(orig_567060, cpp_fn, address(stream), address(chunk), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_scdl_stream(stream, entry_base, 4u, 2, 2u, 3u, 0u);
        init_entry(entry_base + 2u * 0x2cu, 0x77770002u, 0, 3, 200u, 5u);
        init_slot_record(4u, rec, 75u, 1u, 1u, 6u, 3u, 900u, 2);
        fill_pattern(chunk, 256u, 23u);
        wr(chunk, 0x08u, 28u);
    });

    // 20. interleaved mode, codec 0, stereo, chunk_len=11, entry_idx=1, entry[+8] == -9
    run_case_2(orig_567060, cpp_fn, address(stream), address(chunk), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_scdl_stream(stream, entry_base, 7u, 1, 2u, 0u, 0u);
        init_entry(entry_base + 0x2cu, 0x77770003u, -9, -1, 0u, 0u);
        init_slot_record(7u, rec, 10u, 0u, 0u, 4u, 3u, 50u, 2);
        fill_pattern(chunk, 256u, 37u);
        wr(chunk, 0x08u, 11u);
    });

    // 21. offset-table mode (stream[0x3b] == 1), 3 channels, negative entry_idx == -1
    run_case_2(orig_567060, cpp_fn, address(stream), address(chunk), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_scdl_stream(stream, entry_base, 2u, -1, 3u, 0u, 1u);
        init_entry(entry_base - 0x2cu, 0x77770004u, 7, 15, 300u, 4u);
        init_slot_record(2u, rec, 16u, 1u, 1u, 8u, 1u, 1200u, 3);
        fill_pattern(chunk, 256u, 49u);
        wr(chunk, 0x08u, 64u);
        wr(chunk, 0x0cu, 0x20u);
        wr(chunk, 0x10u, 0x40u);
        wr(chunk, 0x14u, 0x60u);
    });

    // 22. offset-table mode, 4 channels, inactive audio (push returns -10, scdl still returns 1)
    run_case_2(orig_567060, cpp_fn, address(stream), address(chunk), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 0u;
        init_scdl_stream(stream, entry_base, 9u, 0, 4u, 0u, 2u);
        init_entry(entry_base, 0x77770005u, -5, 1, 10u, 1u);
        init_slot_record(9u, rec, 30u, 0u, 0u, 4u, 0u, 0u, 4);
        fill_pattern(chunk, 256u, 67u);
        wr(chunk, 0x08u, 48u);
        wr(chunk, 0x0cu, 0x10u);
        wr(chunk, 0x10u, 0x20u);
        wr(chunk, 0x14u, 0x30u);
        wr(chunk, 0x18u, 0x40u);
    });

    // 23. interleaved mode, codec 3, stereo, slot full (push returns -13, scdl returns 1)
    run_case_2(orig_567060, cpp_fn, address(stream), address(chunk), [&]() {
        porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
        init_scdl_stream(stream, entry_base, 11u, 0, 2u, 3u, 0u);
        init_entry(entry_base, 0x77770006u, -1, 0, 0u, 0u);
        init_slot_record(11u, rec, 88u, 3u, 3u, 4u, 2u, 700u, 2);
        fill_pattern(chunk, 256u, 89u);
        wr(chunk, 0x08u, 28u);
    });
}

int main() {
    SetUnhandledExceptionFilter(fault_handler);
    verify_initial_state();
    init_originals();

    run_push_chunk_cases();
    run_deinterleave_cases();
    run_service_scdl_cases();

    std::printf(
        "audio_stream_scdl_chunk_original_x86_vs_cpp=PASS cases=%u events=%u\n",
        cases,
        events_total);
    return 0;
}
