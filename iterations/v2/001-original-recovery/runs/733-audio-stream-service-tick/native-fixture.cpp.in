enum : U {
    kArenaBytes = 8192u,
    kMaxEvents = 64u,
    kMsgCap = 96u,
};

enum EventTag : U {
    kEvGuardCallback = 1u,
    kEvBackendLock = 2u,
    kEvBackendUnlock = 3u,
    kEvSlotTotal = 4u,
    kEvFindChannel = 5u,
    kEvNextVoice = 6u,
    kEvDeviceCancel = 7u,
    kEvVoiceStart = 8u,
    kEvStreamGet = 9u,
    kEvReleaseChunk = 10u,
