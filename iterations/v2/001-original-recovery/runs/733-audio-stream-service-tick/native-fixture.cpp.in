    reloc_rel(orig_567270, 0x080u, 0xffffa43cu, reinterpret_cast<const void*>(&porsche::network_lifecycle_device_cancel_00561730));
    reloc_rel(orig_567270, 0x095u, 0xffff9f97u, reinterpret_cast<const void*>(&porsche::audio_stream_voice_start_005612a0));
    reloc_rel(orig_567270, 0x0afu, 0x00029b4du, orig_590e70);
    reloc_rel(orig_567270, 0x0c0u, 0xfffffebcu, orig_5671f0);
    reloc_rel(orig_567270, 0x0d7u, 0xffffa335u, orig_561680);
    reloc_rel(orig_567270, 0x0f3u, 0x000051d9u, reinterpret_cast<const void*>(&porsche::audio_stream_get_0056c540));
    reloc_rel(orig_567270, 0x101u, 0xfffffdfbu, orig_567170);
    reloc_abs(orig_567270, 0x11fu, 0x006b7780u, porsche::audio_stream_service_storage_006b7740.slots + 16u);
    reloc_rel(orig_567270, 0x12eu, 0x0002234eu, reinterpret_cast<const void*>(&porsche::audio_backend_unlock_005896f0));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");
}

static void reset_base_state(U seed) {
    std::memset(&trace, 0, sizeof trace);
    for (U i = 0u; i < kArenaBytes; ++i) {
        arena[i] = static_cast<B>((i * 37u + seed * 13u + 0x5au) & 0xffu);
    }
    for (U i = 0u; i < 0x18cu; ++i) {
        porsche::application_audio_device_state_006b48c0.backing[i] =
            static_cast<B>((i * 17u + seed) & 0xffu);
    }
    wr(porsche::application_audio_device_state_006b48c0.data(), 0x74u, address(&mock_guard_callback));
    porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;

    std::memset(&porsche::audio_stream_service_storage_006b7740, 0,
                sizeof porsche::audio_stream_service_storage_006b7740);
    for (U i = 0u; i < 16u; ++i) {
        porsche::audio_stream_slots_006b7cc0[i] = 0u;
    }

    porsche::shared_runtime_word_005deb74 = 0x11223344u;
    porsche::shared_runtime_word_005deb78 = 0x55667788u;
    porsche::diagnostic_handler_005debf0 =
        reinterpret_cast<void(__cdecl*)(const char*)>(mock_diagnostic_fn);

    mock_voice_cursor = 0u;
    mock_get_cursor = 0u;
}

static void finalize_and_check() {
    trace.ret = captured_return;
    trace.final_file_word = porsche::shared_runtime_word_005deb74;
    trace.final_line_word = porsche::shared_runtime_word_005deb78;
    std::memcpy(trace.final_device_state,
                porsche::application_audio_device_state_006b48c0.backing.data(),
                0x18cu);
    trace.final_service_storage = porsche::audio_stream_service_storage_006b7740;
    std::memcpy(trace.final_stream_slots, porsche::audio_stream_slots_006b7cc0, 64u);
    capture_fp(trace.fp);
    std::memcpy(trace.memory, arena, kArenaBytes);
    require(trace.abi_fail == 0u, "abi");

    if (which == 0u) {
        expected = trace;
    } else {
        require(trace.ret == expected.ret, "return_value");
        require(trace.count == expected.count, "event_count");
        for (U i = 0u; i < trace.count; ++i) {
            require(trace.events[i].tag == expected.events[i].tag, "ev_tag");
            require(trace.events[i].arg0 == expected.events[i].arg0, "ev_arg0");
            require(trace.events[i].arg1 == expected.events[i].arg1, "ev_arg1");
            require(trace.events[i].arg2 == expected.events[i].arg2, "ev_arg2");
            require(trace.events[i].arg3 == expected.events[i].arg3, "ev_arg3");
            require(trace.events[i].extra0 == expected.events[i].extra0, "ev_extra0");
            require(trace.events[i].extra1 == expected.events[i].extra1, "ev_extra1");
            require(std::memcmp(trace.events[i].msg, expected.events[i].msg, kMsgCap) == 0, "ev_msg");
        }
        require(trace.final_file_word == expected.final_file_word, "final_file_word");
        require(trace.final_line_word == expected.final_line_word, "final_line_word");
        require(std::memcmp(trace.final_device_state, expected.final_device_state, 0x18cu) == 0,
                "final_device_state");
        require(std::memcmp(&trace.final_service_storage, &expected.final_service_storage,
                            sizeof trace.final_service_storage) == 0,
                "final_service_storage");
        require(std::memcmp(trace.final_stream_slots, expected.final_stream_slots, 64u) == 0,
                "final_stream_slots");
        require(std::memcmp(&trace.fp, &expected.fp, sizeof trace.fp) == 0, "fp");
        require(std::memcmp(trace.memory, expected.memory, kArenaBytes) == 0, "arena_memory");
        ++cases;
        events_total += trace.count;
    }
}

// Helper to build a valid codec + tap in arena for 0056b380 validation.
static U setup_valid_codec(U codec_off, U tap_index, U avail_bytes, U state28, bool valid_magic = true) {
    const U codec_va = address(arena + codec_off);
    wr_va(codec_va + 0x00u, valid_magic ? 0x4d525453u : 0x54534340u);
    wr_va(codec_va + 0x28u, state28);
    const U tap_va = codec_va + 0x6cu + tap_index * 0x18u;
    wr_va(tap_va + 0x00u, codec_va);
    wr_va(tap_va + 0x04u, tap_index);
    wr_va(tap_va + 0x08u, avail_bytes);
    return tap_va;
}

static void test_00561680() {
    const std::int16_t caps[] = {0, 1, 8, 32, -5, 32767};
    const std::int16_t useds[] = {0, 1, 7, 31, -10, 100};
    for (U active : {0u, 1u, 255u}) {
        for (U slot : {0u, 3u, 15u}) {
            for (std::int16_t cap : caps) {
                for (std::int16_t used : useds) {
                    for (which = 0u; which < 2u; ++which) {
                        reset_base_state(cases + slot);
                        porsche::application_audio_device_state_006b48c0[0xdcu] = static_cast<B>(active);
                        const U rec_va = address(arena + 0x100u + slot * 0x40u);
                        porsche::audio_stream_slots_006b7cc0[slot] = rec_va;
                        wr_u16(rec_va + 0x18u, static_cast<std::uint16_t>(cap));
                        wr_u16(rec_va + 0x10u, static_cast<std::uint16_t>(used));
                        void* const fn = (which == 0u)
                            ? reinterpret_cast<void*>(orig_561680)
                            : reinterpret_cast<void*>(&porsche::audio_stream_slot_free_chunks_00561680);
                        trace.abi_fail = invoke_1(fn, slot);
                        finalize_and_check();
                    }
                }
            }
        }
    }
}

