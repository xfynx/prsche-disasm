static void verify_initial_state() {
    static_assert(sizeof raw_str_005bde44 == 41u, "005bde44 size");
    static_assert(sizeof raw_str_005bde70 == 38u, "005bde70 size");
    static_assert(sizeof raw_str_005bd978 == 19u, "005bd978 size");
    require(std::memcmp(porsche::stream_err_gettable_invalid_handle_005bde44, raw_str_005bde44, 41u) == 0,
            "initial 005bde44 bytes");
    require(std::memcmp(porsche::stream_err_state_invalid_handle_005bde70, raw_str_005bde70, 38u) == 0,
            "initial 005bde70 bytes");
    require(std::memcmp(porsche::stream_source_file_005bd978, raw_str_005bd978, 19u) == 0,
            "initial 005bd978 bytes");
    for (B b : porsche::application_audio_device_state_006b48c0.backing) {
        require(b == 0u, "initial 006b48c0 zero");
    }
    for (U i = 0u; i < 16u; ++i) {
        require(porsche::audio_stream_service_storage_006b7740.slots[i] == 0u, "initial 006b7740 slots zero");
        require(porsche::audio_stream_service_storage_006b7740.index_map[i] == 0, "initial 006b7740 map zero");
        require(porsche::audio_stream_slots_006b7cc0[i] == 0u, "initial 006b7cc0 zero");
    }
}

static void init_original_code() {
