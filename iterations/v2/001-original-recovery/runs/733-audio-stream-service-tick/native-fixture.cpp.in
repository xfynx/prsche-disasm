void (__cdecl* diagnostic_handler_005debf0)(const char*) =
    reinterpret_cast<void(__cdecl*)(const char*)>(mock_diagnostic_fn);

void __cdecl audio_backend_lock_005896d0() {
    push_event(kEvBackendLock);
}

void __cdecl audio_backend_unlock_005896f0() {
    push_event(kEvBackendUnlock);
}

std::uint32_t __cdecl audio_stream_slot_total_005616b0(std::uint32_t index) {
    push_event(kEvSlotTotal, index);
    return mock_slot_total_ret;
}

std::int32_t __cdecl audio_backend_find_channel_00589d20(std::uint32_t handle) {
    push_event(kEvFindChannel, handle);
    return mock_find_channel_ret;
}

std::uint32_t __cdecl audio_backend_next_voice_00590340(
    std::int32_t channel,
    std::uint32_t* voice_slot) {
    const U prev_slot = (voice_slot != nullptr) ? *voice_slot : 0xdeadbeefu;
    push_event(kEvNextVoice, static_cast<U>(channel), prev_slot);
    if (mock_voice_cursor < mock_voice_count) {
        const U next_id = mock_voice_ids[mock_voice_cursor++];
        if (voice_slot != nullptr) {
            *voice_slot = next_id;
        }
        return 1u;
    }
    return 0u;
}

void __cdecl network_lifecycle_device_cancel_00561730(std::uint32_t handle) {
    push_event(kEvDeviceCancel, handle);
}

std::int32_t __cdecl audio_stream_voice_start_005612a0(
    std::uint32_t slot_index,
    void* header,
    void* params,
    void* descriptor) {
    const U hdr_va = address(header);
    const U prm_va = address(params);
    const U dsc_va = address(descriptor);
    push_event(
        kEvVoiceStart,
        slot_index,
        hdr_va,
        prm_va,
        dsc_va,
        hdr_va ? rd_va(hdr_va) : 0u,
        prm_va ? rd_va(prm_va) : 0u);
    return mock_voice_start_ret;
}

std::uint32_t __cdecl audio_stream_get_0056c540(std::uint32_t handle) {
    const U chunk = (mock_get_cursor < mock_get_len) ? mock_get_seq[mock_get_cursor++] : 0u;
    push_event(kEvStreamGet, handle, chunk);
    return chunk;
}

void __cdecl audio_stream_codec_release_chunk_0056c620(
    std::uint32_t codec_handle,
    void* chunk_header) {
    const U chunk_va = address(chunk_header);
    push_event(
        kEvReleaseChunk,
        codec_handle,
        chunk_va,
        chunk_va ? rd_va(chunk_va) : 0u);
}

std::int32_t __cdecl audio_stream_service_chunk_scdl_00567060(void* stream, void* chunk) {
    push_event(kEvChunkScdl, address(stream), address(chunk));
    return mock_scdl_ret;
}

std::int32_t __cdecl audio_stream_service_chunk_schl_00566ea0(
    std::uint32_t slot_index,
    void* chunk) {
    push_event(kEvChunkSchl, slot_index, address(chunk));
    return mock_schl_ret;
}

