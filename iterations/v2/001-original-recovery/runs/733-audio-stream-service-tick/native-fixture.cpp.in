};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U arg2;
    U arg3;
    U extra0;
    U extra1;
    char msg[kMsgCap];
};

struct Trace {
    U ret;
    U abi_fail;
    U count;
    Event events[kMaxEvents];
    U final_file_word;
    U final_line_word;
    B final_device_state[0x18c];
    porsche::AudioStreamServiceStorage561 final_service_storage;
    U final_stream_slots[16];
