static void test_0056c740_and_0056c790() {
    // Invalid handles (null, bad magic variants) and valid handles across tap indices/values.
    for (U mode = 0u; mode < 8u; ++mode) {
        for (U fn_sel = 0u; fn_sel < 2u; ++fn_sel) {
            for (which = 0u; which < 2u; ++which) {
                reset_base_state(cases + mode);
                U handle = 0u;
                if (mode == 1u) {
                    handle = setup_valid_codec(0x200u, 0u, 0x1234u, 2u, false);
                } else if (mode == 2u) {
                    handle = setup_valid_codec(0x200u, 2u, 0x1234u, 2u, false);
                    wr_va(address(arena + 0x200u), 0u);
                } else if (mode == 3u) {
                    handle = setup_valid_codec(0x200u, 0u, 0x1234u, 2u, false);
                    wr_va(address(arena + 0x200u), 0x4d525452u);
                } else if (mode == 4u) {
                    handle = setup_valid_codec(0x200u, 0u, 0x1234u, 2u, true);
                } else if (mode == 5u) {
                    handle = setup_valid_codec(0x200u, 0u, 0u, 0u, true);
                } else if (mode == 6u) {
                    handle = setup_valid_codec(0x200u, 4u, 0x3d0900u, 1u, true);
                } else if (mode == 7u) {
                    handle = setup_valid_codec(0x200u, 9u, 0x778899aau, 2u, true);
                }
                void* fn = nullptr;
                if (fn_sel == 0u) {
                    fn = (which == 0u)
                        ? reinterpret_cast<void*>(orig_56c740)
                        : reinterpret_cast<void*>(&porsche::audio_stream_codec_avail_0056c740);
                } else {
                    fn = (which == 0u)
                        ? reinterpret_cast<void*>(orig_56c790)
                        : reinterpret_cast<void*>(&porsche::audio_stream_codec_state_0056c790);
                }
                trace.abi_fail = invoke_1(fn, handle);
                finalize_and_check();
            }
        }
    }
}

static void test_005671f0() {
    const std::int8_t indices[] = {-1, 0, 1, 2};
    const U divisors[] = {0u, 1000u, 44100u};
    // 30000 distinguishes the original 0x3d0900 clamp from a materially lower
    // cap without overflowing the signed 16-bit wait field.
    const std::int16_t waits[] = {-100, -1, 0, 10, 500, 2000, 30000};
    const U avails[] = {0u, 5u, 1000u, 0x200000u, 0x3d0900u, 0x500000u};
    const U states[] = {0u, 1u, 2u, 3u};

    for (std::int8_t idx : indices) {
        for (U div : divisors) {
            for (std::int16_t wait_val : waits) {
                for (U avail : avails) {
                    for (U st : states) {
                        if (div == 0u && (avail != 0u || st != 0u)) continue;
                        if (wait_val <= 0 && (avail != 0u || st != 0u)) continue;
                        for (which = 0u; which < 2u; ++which) {
                            reset_base_state(cases);
                            const U stream_va = address(arena + 0x100u);
                            const U entries_base = address(arena + 0x400u);
                            const U codec_handle = setup_valid_codec(0x800u, 1u, avail, st);
                            wr_va(stream_va + 0x00u, entries_base);
                            wr_va(stream_va + 0x04u, codec_handle);
                            wr_u8(stream_va + 0x17u, static_cast<B>(idx));
                            const U entry_va = entries_base + static_cast<U>(static_cast<I>(idx) * 0x2c);
                            wr_va(entry_va + 0x10u, div);
                            wr_u16(entry_va + 0x28u, static_cast<std::uint16_t>(wait_val));

                            void* const fn = (which == 0u)
                                ? reinterpret_cast<void*>(orig_5671f0)
                                : reinterpret_cast<void*>(&porsche::audio_stream_service_check_refill_005671f0);
                            trace.abi_fail = invoke_1(fn, stream_va);
                            finalize_and_check();
                        }
                    }
                }
            }
        }
    }
}

static void test_00567020_00567140_00567170() {
    for (std::int8_t idx : {std::int8_t(-4), std::int8_t(-1), std::int8_t(0), std::int8_t(2), std::int8_t(15)}) {
        for (U fn_sel = 0u; fn_sel < 2u; ++fn_sel) {
            for (which = 0u; which < 2u; ++which) {
                reset_base_state(cases);
                const U stream_va = address(arena + 0x100u);
                const U entries_base = address(arena + 0x400u);
                const U chunk_va = address(arena + 0x700u);
                wr_va(stream_va + 0x00u, entries_base);
                wr_va(stream_va + 0x04u, 0xCAFE1234u);
                wr_u8(stream_va + 0x17u, static_cast<B>(idx));
                wr_va(chunk_va + 0x00u, 0x6c434353u);
                wr_va(chunk_va + 0x08u, 0x89abcdefu);

                void* fn = nullptr;
                if (fn_sel == 0u) {
                    fn = (which == 0u)
                        ? reinterpret_cast<void*>(orig_567020)
                        : reinterpret_cast<void*>(&porsche::audio_stream_service_chunk_sccl_00567020);
                } else {
                    fn = (which == 0u)
                        ? reinterpret_cast<void*>(orig_567140)
                        : reinterpret_cast<void*>(&porsche::audio_stream_service_chunk_scel_00567140);
                }
                trace.abi_fail = invoke_2(fn, stream_va, chunk_va);
                finalize_and_check();
            }
        }
    }

    const U tags[] = {0x6c444353u, 0x6c484353u, 0x6c454353u, 0x6c434353u, 0x11223344u, 0u};
    for (U slot : {0u, 4u, 15u}) {
        for (U tag : tags) {
            for (I ret_override : {0, 1}) {
                for (which = 0u; which < 2u; ++which) {
                    reset_base_state(cases);
                    mock_scdl_ret = ret_override;
                    mock_schl_ret = ret_override;
                    const U stream_va = address(arena + 0x100u);
                    const U entries_base = address(arena + 0x400u);
                    const U chunk_va = address(arena + 0x700u);
                    porsche::audio_stream_service_storage_006b7740.slots[slot] = stream_va;
                    wr_va(stream_va + 0x00u, entries_base);
                    wr_va(stream_va + 0x04u, 0x77770000u + slot);
                    wr_u8(stream_va + 0x17u, 1u);
                    wr_va(chunk_va + 0x00u, tag);
                    wr_va(chunk_va + 0x08u, 0x55aa55aau);

                    void* const fn = (which == 0u)
                        ? reinterpret_cast<void*>(orig_567170)
                        : reinterpret_cast<void*>(&porsche::audio_stream_service_handle_chunk_00567170);
                    trace.abi_fail = invoke_2(fn, slot, chunk_va);
                    finalize_and_check();
                }
            }
        }
    }
}

static void test_00567270() {
    // 1. Guard callback returns non-zero vs zero with all empty slots.
    for (U guard_ret : {0u, 1u, 0xffffffffu}) {
        for (which = 0u; which < 2u; ++which) {
            reset_base_state(cases);
            mock_guard_ret = guard_ret;
            void* const fn = (which == 0u)
                ? reinterpret_cast<void*>(orig_567270)
                : reinterpret_cast<void*>(&porsche::audio_stream_service_tick_00567270);
            trace.abi_fail = invoke_0(fn);
            finalize_and_check();
        }
    }

    // 2. State 2 transition + voice start + optional channel apply + refill check + chunk drain loop.
    for (U state14 : {0u, 1u, 2u}) {
        for (U count16 : {0u, 1u}) {
            for (U locked_tot : {0u, 2u}) {
                for (U flag19 : {0u, 1u}) {
                    for (U refill_block : {0u, 1u}) {
                        for (I free_chunks : {-1, 0, 2, 12}) {
                            if (count16 == 0u && (locked_tot != 0u || flag19 != 0u || refill_block != 0u || free_chunks != 2)) continue;
                            if (state14 != 2u && (locked_tot != 0u || flag19 != 0u)) continue;
                            for (which = 0u; which < 2u; ++which) {
                                reset_base_state(cases);
                                mock_guard_ret = 0u;
                                mock_slot_total_ret = locked_tot;
                                mock_find_channel_ret = (flag19 != 0u) ? 2 : -1;
                                mock_voice_count = 2u;
                                mock_voice_start_ret = 0x3344;
                                mock_scdl_ret = 1;
                                mock_schl_ret = 1;

                                const U slot = 2u;
                                const U stream_va = address(arena + 0x100u);
                                const U entries_base = address(arena + 0x300u);
                                const U codec_handle = setup_valid_codec(0x600u, 0u, 0x3d0900u, 2u);
                                const U slot_rec_va = address(arena + 0xa00u);

                                porsche::audio_stream_service_storage_006b7740.slots[slot] = stream_va;
                                porsche::audio_stream_slots_006b7cc0[3u] = slot_rec_va;
                                if (free_chunks < 0) {
                                    porsche::application_audio_device_state_006b48c0[0xdcu] = 0u;
                                } else {
                                    porsche::application_audio_device_state_006b48c0[0xdcu] = 1u;
                                    wr_u16(slot_rec_va + 0x18u, static_cast<std::uint16_t>(free_chunks + 5));
                                    wr_u16(slot_rec_va + 0x10u, 4u);
                                }

                                wr_va(stream_va + 0x00u, entries_base);
                                wr_va(stream_va + 0x04u, codec_handle);
                                wr_va(stream_va + 0x08u, 0x9999u);
                                wr_va(stream_va + 0x0cu, 3u);
                                wr_u8(stream_va + 0x14u, static_cast<B>(state14));
                                wr_u8(stream_va + 0x16u, static_cast<B>(count16));
                                wr_u8(stream_va + 0x17u, 0u);
                                wr_u8(stream_va + 0x19u, static_cast<B>(flag19));
                                wr_va(stream_va + 0x30u, 0xAABBCCDDu);
                                wr_va(stream_va + 0x9cu, 0x12345678u);
                                for (U i = 0u; i < 0x15u; ++i) {
                                    wr_va(stream_va + 0x88u + i * 4u, 0xE0000000u + i);
                                }

                                wr_va(entries_base + 0x10u, refill_block ? 1000u : 0u);
                                wr_u16(entries_base + 0x28u, refill_block ? static_cast<std::uint16_t>(-1) : 0u);

                                // Prepare 12 chunks in arena for drain loop (tests default budget=10 and state1 budget).
                                mock_get_len = 12u;
                                const U chunk_tags[4] = {0x6c434353u, 0x6c454353u, 0x6c444353u, 0x6c484353u};
                                for (U k = 0u; k < 12u; ++k) {
                                    const U c_va = address(arena + 0xc00u + k * 0x20u);
                                    wr_va(c_va + 0x00u, chunk_tags[k & 3u]);
                                    wr_va(c_va + 0x08u, 0x7000u + k);
                                    mock_get_seq[k] = c_va;
                                }

                                void* const fn = (which == 0u)
                                    ? reinterpret_cast<void*>(orig_567270)
                                    : reinterpret_cast<void*>(&porsche::audio_stream_service_tick_00567270);
                                trace.abi_fail = invoke_0(fn);
                                finalize_and_check();
                            }
                        }
                    }
                }
            }
        }
    }

    // 3. Drain loop edge cases: chunk==0 on first call, chunk!=0 followed by chunk==0 preserving edi=1, and handler returning 0 early stop.
    for (U edge = 0u; edge < 3u; ++edge) {
        for (which = 0u; which < 2u; ++which) {
            reset_base_state(cases);
            mock_guard_ret = 0u;
            const U slot = 7u;
            const U stream_va = address(arena + 0x100u);
            const U entries_base = address(arena + 0x300u);
            const U codec_handle = setup_valid_codec(0x600u, 0u, 0u, 0u);
            porsche::audio_stream_service_storage_006b7740.slots[slot] = stream_va;
            wr_va(stream_va + 0x00u, entries_base);
            wr_va(stream_va + 0x04u, codec_handle);
            wr_u8(stream_va + 0x14u, 0u);
            wr_u8(stream_va + 0x16u, 1u);
            wr_u8(stream_va + 0x17u, 0u);
            wr_va(entries_base + 0x10u, 0u);

            const U c0 = address(arena + 0xc00u);
            wr_va(c0 + 0x00u, 0x6c444353u);
            mock_get_len = 4u;
            if (edge == 0u) {
                mock_get_seq[0] = 0u;
                mock_get_seq[1] = c0;
                mock_scdl_ret = 1;
            } else if (edge == 1u) {
                mock_get_seq[0] = c0;
                mock_get_seq[1] = 0u;
                mock_get_seq[2] = c0;
                mock_get_seq[3] = 0u;
                mock_scdl_ret = 1;
            } else {
                mock_get_seq[0] = c0;
                mock_get_seq[1] = c0;
                mock_scdl_ret = 0;
            }

            void* const fn = (which == 0u)
                ? reinterpret_cast<void*>(orig_567270)
                : reinterpret_cast<void*>(&porsche::audio_stream_service_tick_00567270);
            trace.abi_fail = invoke_0(fn);
            finalize_and_check();
        }
    }
}

int main() {
    AddVectoredExceptionHandler(1u, fault_handler);
    verify_initial_state();
    init_original_code();

    test_00561680();
    test_005616d0();
    test_00599710_and_00590e70();
    test_0056c740_and_0056c790();
    test_005671f0();
    test_00567020_00567140_00567170();
    test_00567270();

    std::printf("audio_stream_service_tick_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events_total);
    std::fflush(stdout);
    return 0;
}
