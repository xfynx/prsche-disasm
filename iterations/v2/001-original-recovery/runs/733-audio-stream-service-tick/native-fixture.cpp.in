    static_assert(sizeof body_0056c740 == 75u, "0056c740 size");
    static_assert(sizeof body_0056c790 == 75u, "0056c790 size");
    static_assert(sizeof body_00590e70 == 113u, "00590e70 size");
    static_assert(sizeof body_00599710 == 3u, "00599710 size");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "VirtualAlloc");
    std::memset(code, 0xcc, 4096u);

    orig_561680 = code + 0x000u;
    orig_5616d0 = code + 0x080u;
    orig_567020 = code + 0x100u;
    orig_567140 = code + 0x180u;
    orig_567170 = code + 0x200u;
    orig_5671f0 = code + 0x300u;
    orig_567270 = code + 0x400u;
    orig_56c740 = code + 0x600u;
    orig_56c790 = code + 0x680u;
    orig_590e70 = code + 0x700u;
    orig_599710 = code + 0x7c0u;

