    static_assert(sizeof body_00561680 == 38u, "00561680 size");
    static_assert(sizeof body_005616d0 == 45u, "005616d0 size");
    static_assert(sizeof body_00567020 == 50u, "00567020 size");
    static_assert(sizeof body_00567140 == 37u, "00567140 size");
    static_assert(sizeof body_00567170 == 125u, "00567170 size");
    static_assert(sizeof body_005671f0 == 119u, "005671f0 size");
