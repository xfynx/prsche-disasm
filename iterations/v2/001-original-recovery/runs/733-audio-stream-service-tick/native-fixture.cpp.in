static U invoke_0(void* fn) {
    U saved_sp = 0u;
    U saved_bp = 0u;
    U fail = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov saved_sp, esp
        mov saved_bp, ebp
        mov ebx, 0x13579bdf
        mov esi, 0x2468ace0
        mov edi, 0x10203040
        call fn
        mov captured_return, 0
        cmp esp, saved_sp
        jne bad_abi
        cmp ebp, saved_bp
        jne bad_abi
        cmp ebx, 0x13579bdf
        jne bad_abi
        cmp esi, 0x2468ace0
        jne bad_abi
        cmp edi, 0x10203040
        je ok_abi
    bad_abi:
        mov fail, 1
    ok_abi:
        mov esp, saved_sp
        pop edi
        pop esi
        pop ebx
    }
    return fail;
}

