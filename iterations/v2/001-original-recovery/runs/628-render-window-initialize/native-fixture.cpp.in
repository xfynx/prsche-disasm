void __stdcall render_window_callback_00575770(std::uint32_t a, std::uint32_t b) { volatile U tag = (a + b) ^ 0x575770u; (void)tag; }
void __stdcall render_window_callback_005757d0(std::uint32_t a, std::uint32_t b) { volatile U tag = (a ^ b) ^ 0x5757d0u; (void)tag; }

