static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_abort_cleanup(U raw) {
    if (active_side == 0u) {
        if (raw == address(slot_5757f0)) {
            return kCanonicalAbortCleanup;
        }
        require(raw != address(reinterpret_cast<const void*>(&porsche::render_window_abort_cleanup_005757f0)),
                "x86 side must not hold cpp abort cleanup address");
    } else {
        if (raw == address(reinterpret_cast<const void*>(&porsche::render_window_abort_cleanup_005757f0))) {
            return kCanonicalAbortCleanup;
        }
        require(raw != address(slot_5757f0),
                "cpp side must not hold x86 slot_5757f0 address");
    }
    return raw;
}

static void capture_state(StateSnapshot& s) {
    s.tex_width = porsche::render_display_texture_width_005deac8;
    s.tex_height = porsche::render_display_texture_height_005deacc;
    s.thread_lock = address(porsche::thread_start_lock_006a57d8);
    s.hwnd = address(porsche::window_hwnd_006b7bf8);
    s.library_started = porsche::render_library_started_006a64b8;
    s.exit_registered = porsche::render_window_exit_registered_006a64bc;
    s.abort_cleanup = normalize_abort_cleanup(porsche::diagnostic_abort_cleanup_005deb8c);
    s.thrash_slot19 = porsche::render_thrash_exports_006bd910[19];
    s.thrash_slot27 = porsche::render_thrash_exports_006bd910[27];
}

static void capture_fpu(Fpu& f) {
    std::memset(&f, 0, sizeof f);
    B env[28];
    __asm {
        fxsave floating
        fnstenv env
        fldenv env
    }
    f.control = *reinterpret_cast<unsigned short*>(floating);
    f.status = *reinterpret_cast<unsigned short*>(floating + 2);
    f.tag = floating[4];
    std::memset(f.padding, 0, 3);
    f.full_tag = *reinterpret_cast<unsigned short*>(env + 8);
    f.mxcsr = *reinterpret_cast<U*>(floating + 24);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((f.status >> 11) + i) & 7u;
        if (f.tag & (1u << physical)) {
            std::memcpy(f.values + i * 10u, floating + 32u + i * 16u, 10u);
        } else {
            std::memset(f.values + i * 10u, 0, 10u);
        }
    }
}

static void seed_fpu() {
    unsigned short cw = 0x027fu;
    U mxcsr = 0x9f80u;
    __asm {
        fninit
        fldcw cw
        ldmxcsr mxcsr
        fld1
    }
}

static void record_event(U tag, U arg0 = 0u, U arg1 = 0u, U arg2 = 0u) {
    require(trace.count < kMaxEvents, "bounded event count");
    Event& e = trace.events[trace.count++];
    e.tag = tag;
    e.arg0 = arg0;
    e.arg1 = arg1;
    e.arg2 = arg2;
    capture_state(e.state);
}

static U __stdcall mock_thrash_setstate_alt(U key, U value) {
    record_event(kEvSetStateAlt, key, value, 0u);
    return (key == 0x25u) ? cfg_setstate_25_ret : 1u;
}

static U __stdcall mock_thrash_setstate(U key, U value) {
    record_event(kEvSetState, key, value, 0u);
    if (cfg_setstate_swap_slot27 && key == 0x12u) {
        porsche::render_thrash_exports_006bd910[27] =
            address(reinterpret_cast<const void*>(&mock_thrash_setstate_alt));
    }
    return (key == 0x25u) ? cfg_setstate_25_ret : 1u;
}

static U __stdcall mock_thrash_init() {
    record_event(kEvThrashInit, cfg_thrash_init_ret, 0u, 0u);
    return cfg_thrash_init_ret;
}

