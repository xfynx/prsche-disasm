void __cdecl thread_exit_register_00557380(void(__cdecl* callback)()) {
    const U raw = address(reinterpret_cast<const void*>(callback));
    U normalized = raw;
    if (active_side == 0u) {
        require(raw == address(slot_575810), "x86 side must register slot_575810");
        normalized = kCanonicalExitCleanup;
    } else {
        require(raw == address(reinterpret_cast<const void*>(&render_window_exit_cleanup_00575810)),
                "cpp side must register render_window_exit_cleanup_00575810");
        normalized = kCanonicalExitCleanup;
    }
    record_event(kEvThreadExitRegister, normalized, 0u, 0u);
}

