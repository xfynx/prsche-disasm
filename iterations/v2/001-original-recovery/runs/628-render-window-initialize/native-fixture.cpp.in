using U = std::uint32_t;
using B = std::uint8_t;

static U address(const void* p) { return reinterpret_cast<U>(p); }
static U word(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}
static void put(void* p, U o, U v) { std::memcpy(static_cast<B*>(p) + o, &v, 4u); }

enum : U {
    kMaxEvents = 16u,
    kCanonicalExitCleanup = 0x00575810u,
    kCanonicalAbortCleanup = 0x005757f0u,
};

enum EventTag : U {
    kEvHeapLockCreate = 1u,
    kEvWindowPrepare = 2u,
    kEvWindowInit = 3u,
    kEvSetState = 4u,
    kEvSetStateAlt = 5u,
    kEvStartupWindowHandle = 6u,
    kEvThrashInit = 7u,
    kEvSchedulerRegister = 8u,
    kEvThreadExitRegister = 9u,
    kEvRenderShutdown = 10u,
};

