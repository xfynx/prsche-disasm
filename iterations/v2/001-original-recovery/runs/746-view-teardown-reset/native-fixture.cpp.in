using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static U cases = 0u;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", why, cases);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* base, U off = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(base) + off, 4u);
    return v;
}

static void store32(void* base, U off, U v) {
    std::memcpy(static_cast<B*>(base) + off, &v, 4u);
}

enum : U {
    kEvEnter = 1u,
    kEvLeave = 2u,
    kEvPoolFree = 3u,
    kEvRelease = 4u,
};

struct Event {
    U kind;
    U a;
    U b;
    U c;
};

enum : U {
    kMaxEvents = 256u,
    kTreeCount = 8u,
    kNodeCount = 48u,
};

struct Snapshot {
    U abi_fail;
    U event_count;
    std::array<Event, kMaxEvents> events;
    std::array<B, 0x80u> ctx_bytes;
    std::array<B, 0x20u> view_bytes;
    std::array<std::array<B, 0x08u>, kTreeCount> trees;
    std::array<std::array<B, 0x20u>, kTreeCount> heads;
    std::array<std::array<B, 0x20u>, kNodeCount> nodes;
};

static Event g_events[kMaxEvents];
static U g_event_count = 0u;

static alignas(8) B g_ctx_buf[0x80u];
static void* g_heap_ctx_ptr = g_ctx_buf;
static alignas(8) B g_lock_buf[0x20u];
static alignas(8) B g_view_buf[0x20u];
static alignas(8) B g_trees[kTreeCount][0x08u];
static alignas(8) B g_heads[kTreeCount][0x20u];
static alignas(8) B g_nodes[kNodeCount][0x20u];
static alignas(8) B g_sentinel_free[0x10u];

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c};
}

namespace porsche {

void* __cdecl application_context_heap_state_005e4fe8() {
    return g_heap_ctx_ptr;
}

void __cdecl heap_enter_005322b0(void* lock) {
    record_event(kEvEnter, address(lock));
}

void __cdecl heap_leave_005322c0(void* lock) {
    record_event(kEvLeave, address(lock));
}

void __cdecl application_context_clear_004237d0(
    void* block, std::uint32_t bytes, std::uint32_t mode) {
    record_event(kEvPoolFree, address(block), bytes, mode);
}

std::uint32_t __cdecl application_release_0059f050(void* block) {
    record_event(kEvRelease, address(block));
    return 1u;
}

} // namespace porsche

