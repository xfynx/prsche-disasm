static U invoke_cdecl_1(const void* fn, U a0, U& ret_eax) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    U out_eax = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        push a0
        mov eax, fn
        call eax
        mov out_eax, eax
        add esp, 4
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_espc1
        mov esp, esp_before
        or abi_fail, 1
    ok_espc1:
        cmp ebx, 0x13572468
        je ok_ebxc1
        or abi_fail, 2
    ok_ebxc1:
        cmp esi, 0x24681357
        je ok_esic1
        or abi_fail, 4
    ok_esic1:
        cmp edi, 0x55aa33cc
        je ok_edic1
        or abi_fail, 8
    ok_edic1:
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = out_eax;
    return abi_fail;
}

static U invoke_cdecl_4(const void* fn, U a0, U a1, U a2, U a3, U& ret_eax) {
    U abi_fail = 0u;
    U esp_before = 0u;
    U esp_after = 0u;
    U out_eax = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov ebx, 0x13572468
        mov esi, 0x24681357
        mov edi, 0x55aa33cc
        mov esp_before, esp
        push a3
        push a2
        push a1
        push a0
        mov eax, fn
        call eax
        mov out_eax, eax
        add esp, 16
        mov esp_after, esp
        mov eax, esp_after
        cmp eax, esp_before
        je ok_espc4
        mov esp, esp_before
        or abi_fail, 1
    ok_espc4:
        cmp ebx, 0x13572468
        je ok_ebxc4
        or abi_fail, 2
    ok_ebxc4:
        cmp esi, 0x24681357
        je ok_esic4
        or abi_fail, 4
    ok_esic4:
        cmp edi, 0x55aa33cc
        je ok_edic4
        or abi_fail, 8
    ok_edic4:
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = out_eax;
    return abi_fail;
}

static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_alloc_cursor = 0u;
    g_alloc_fail = false;
    porsche::splash_progress_format_005dead0 = 0u;
    porsche::render_descriptor_flags_005deb60 = 0x10u;
    porsche::render_descriptor_option_005deb88 = 1u;
    porsche::texture_create_errors_005deb80 = 0u;
    porsche::shared_runtime_word_005deb74 = 0u;
    porsche::shared_runtime_word_005deb78 = 0u;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_alloc_pool, 0x5au, sizeof g_alloc_pool);
    for (U i = 0u; i < kInputBytes; ++i) {
        g_input_desc[i] = static_cast<B>((seed + i * 29u) & 0xffu);
    }
}

static void capture(Snapshot& out, U abi_fail, U ret_eax) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    out.errors_005deb80 = porsche::texture_create_errors_005deb80;
    const char* const df = porsche::diagnostic_file_005deb74();
    out.diag_file_hash = (df != nullptr) ? fnv1a(df) : 0u;
    out.diag_line = porsche::application_diagnostic_line_005deb78;
    std::memcpy(out.alloc_pool.data(), g_alloc_pool, kPoolBytes);
    out.alloc_used = g_alloc_cursor;
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c,
                tag);
    }
    require(orig.errors_005deb80 == cpp.errors_005deb80, tag);
    require(orig.diag_file_hash == cpp.diag_file_hash, tag);
    require(orig.diag_line == cpp.diag_line, tag);
    require(orig.alloc_used == cpp.alloc_used, tag);
    require(orig.alloc_pool == cpp.alloc_pool, tag);
    ++cases;
}

template <class Setup>
static void run_create_case(I w, I h, I d, U flags, Setup&& setup, const char* tag) {
    Snapshot orig{}, cpp{};
    U r0 = 0u, r1 = 0u;
    reset_fixtures(1u);
    setup();
    U f0 = invoke_cdecl_4(slot_00574c70, static_cast<U>(w), static_cast<U>(h),
                          static_cast<U>(d), flags, r0);
    capture(orig, f0, r0);
    reset_fixtures(1u);
    setup();
    U f1 = invoke_cdecl_4(
        reinterpret_cast<const void*>(&porsche::scene_texture_shape_create_00574c70),
        static_cast<U>(w), static_cast<U>(h), static_cast<U>(d), flags, r1);
    capture(cpp, f1, r1);
    check_equal(orig, cpp, tag);
}

template <class Setup>
static void run_shrink_case(Setup&& setup, const char* tag) {
    Snapshot orig{}, cpp{};
    U r0 = 0u, r1 = 0u;
    reset_fixtures(3u);
    setup();
    U f0 = invoke_cdecl_1(slot_005557d0, address(g_input_desc), r0);
    capture(orig, f0, r0);
    reset_fixtures(3u);
    setup();
    U f1 = invoke_cdecl_1(
        reinterpret_cast<const void*>(&porsche::scene_texture_descriptor_shrink_005557d0),
        address(g_input_desc), r1);
    capture(cpp, f1, r1);
    check_equal(orig, cpp, tag);
}

int main() {
    init();

    // 1. Direct 00574c70 shape create tests (valid depths, depth==0 fallback, invalid dims, invalid depth, OOM)
    for (I d : {0, 1, 4, 8, 15, 16, 24, 32, 0x115c, 7}) {
        run_create_case(13, 6, d, 0x10u, [=]() {
            porsche::splash_progress_format_005dead0 = (d == 0) ? 0u : 8u;
        }, "create depth matrix");
    }
    run_create_case(10, 4, 0, 0x10u, []() {
        porsche::splash_progress_format_005dead0 = 24u;
    }, "create default fallback");
    for (U diag : {0u, 1u}) {
        run_create_case(-1, 4, 16, 0x10u, [=]() {
            porsche::render_descriptor_option_005deb88 = diag;
        }, "create bad w<0");
        run_create_case(0x4001, 4, 16, 0x10u, [=]() {
            porsche::render_descriptor_option_005deb88 = diag;
        }, "create bad w>4000");
        run_create_case(8, -1, 16, 0x10u, [=]() {
            porsche::render_descriptor_option_005deb88 = diag;
        }, "create bad h<0");
        run_create_case(8, 0x2001, 16, 0x10u, [=]() {
            porsche::render_descriptor_option_005deb88 = diag;
        }, "create bad h>2000");
        run_create_case(8, 8, 99, 0x10u, [=]() {
            porsche::render_descriptor_option_005deb88 = diag;
        }, "create bad depth");
        run_create_case(8, 8, 16, 0x10u, [=]() {
            porsche::render_descriptor_option_005deb88 = diag;
            g_alloc_fail = true;
        }, "create oom");
    }

    run_create_case(0x4000, 4, 16, 0x10u, []() {
        porsche::render_descriptor_option_005deb88 = 1u;
        g_alloc_fail = true;
    }, "create exact max w");
    run_create_case(8, 0x2000, 16, 0x10u, []() {
        porsche::render_descriptor_option_005deb88 = 1u;
        g_alloc_fail = true;
    }, "create exact max h");

    // 2. Direct 005557d0 shrink tests: all switch format codes (mode 1..4 + default) & even/odd widths & h<=1
    const U valid_types[] = {
        0x03u, 0x42u, 0x50u, 0x68u, 0x7eu,
        0x05u, 0x6au, 0x7du,
        0x51u, 0x78u,
        0x52u, 0x6du,
    };
    for (U ty : valid_types) {
        for (W w : {static_cast<W>(8u), static_cast<W>(9u)}) {
            for (W h : {static_cast<W>(1u), static_cast<W>(6u)}) {
                run_shrink_case([=]() {
                    store32(g_input_desc, 0x00u, 0xaabbcc00u | ty);
                    store16(g_input_desc, 0x04u, w);
                    store16(g_input_desc, 0x06u, h);
                }, "shrink mode matrix");
            }
        }
    }
    for (U bad_ty : {0x00u, 0x04u, 0x7fu}) {
        run_shrink_case([=]() {
            store32(g_input_desc, 0x00u, 0x11223300u | bad_ty);
            store16(g_input_desc, 0x04u, 16u);
            store16(g_input_desc, 0x06u, 16u);
        }, "shrink unsupported");
    }

    std::printf("scene_texture_shrink_801_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
