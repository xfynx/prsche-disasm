    relocate_imm32(slot_00574c70, 0x146u, 0x005c0914u, kErrOutOfMemory);
    relocate_imm32(slot_00574c70, 0x14cu, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    relocate_call_rel32(slot_00574c70, 0x00574c70u, 0x162u, 0x0053c290u,
