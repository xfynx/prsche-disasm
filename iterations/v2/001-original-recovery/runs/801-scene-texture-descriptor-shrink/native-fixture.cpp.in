using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;
using W = std::uint16_t;

static U cases = 0u;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", why, cases);
        std::fflush(stdout);
        ExitProcess(7);
    }
}

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U load32(const void* base, U off = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(base) + off, 4u);
    return v;
}

static void store16(void* base, U off, W v) {
    std::memcpy(static_cast<B*>(base) + off, &v, 2u);
}

static void store32(void* base, U off, U v) {
    std::memcpy(static_cast<B*>(base) + off, &v, 4u);
}

static U fnv1a(const char* s) {
    U h = 2166136261u;
    while (*s != '\0') {
        h = (h ^ static_cast<B>(*s++)) * 16777619u;
    }
    return h;
}

enum : U {
    kEvFormat = 1u,
    kEvAlloc = 2u,
    kEvFill = 3u,
    kEvAvail = 4u,
    kEvDiag = 5u,
    kEvBits = 6u,
    kEvDepthFmt = 7u,
};

struct Event {
    U kind;
    U a;
    U b;
    U c;
};

enum : U { kMaxEvents = 32u, kPoolBytes = 16384u, kInputBytes = 16384u };

struct Snapshot {
    U abi_fail;
    U ret_eax;
    U event_count;
    std::array<Event, kMaxEvents> events;
    U errors_005deb80;
    U diag_file_hash;
    U diag_line;
    std::array<B, kPoolBytes> alloc_pool;
    U alloc_used;
};

static Event g_events[kMaxEvents];
static U g_event_count = 0u;

static alignas(16) B g_input_desc[kInputBytes];
static alignas(16) B g_alloc_pool[kPoolBytes];
static U g_alloc_cursor = 0u;
static bool g_alloc_fail = false;

static const char kSourceFile[] = "\\real\\cmn\\creates.c";
static const char kFmtShp[] = "SHP%dx%dx%d";
static const char kErrInvalidDims[] =
    "createshape - INVALID SHAPE DIMENSIONS\nrequested: %dx%dx%d maximum: %dx%d\n";
static const char kErrInvalidDepth[] =
    "createshape - INVALID DEPTH\nrequested: %dx%dx%d BPP MUST BE 1,4,8,15,16,24,OR 32\n";
static const char kErrOutOfMemory[] =
    "SHAPE_create - OUT OF MEMORY\nrequested: %dx%dx%d bytes: %d available: %d\n";

static void record_event(U kind, U a = 0u, U b = 0u, U c = 0u) {
    require(g_event_count < kMaxEvents, "event overflow");
    g_events[g_event_count++] = Event{kind, a, b, c};
}

static void __cdecl controlled_diag_report(const char* fmt, ...) {
    char buf[256];
    va_list args;
    va_start(args, fmt);
    std::vsnprintf(buf, sizeof buf, fmt, args);
    va_end(args);
    record_event(kEvDiag, fnv1a(fmt), fnv1a(buf));
}

namespace porsche {

U splash_progress_format_005dead0 = 0u;
U render_descriptor_flags_005deb60 = 0u;
U render_descriptor_option_005deb88 = 1u;
U texture_create_errors_005deb80 = 0u;
void (__cdecl* diagnostic_handler_005debf0)(const char*) =
    reinterpret_cast<void(__cdecl*)(const char*)>(&controlled_diag_report);

U __cdecl texture_depth_format_00535380(U depth) {
    U fmt = 0u;
    switch (depth) {
    case 1u: fmt = 0x79u; break;
    case 4u: fmt = 0x7au; break;
    case 8u: fmt = 0x7bu; break;
    case 15u: case 0x22bu: case 0x613u: fmt = 0x7eu; break;
    case 16u: case 0x235u: fmt = 0x78u; break;
    case 24u: case 0x378u: fmt = 0x7fu; break;
    case 32u: case 0x22b8u: fmt = 0x7du; break;
    case 0x115cu: fmt = 0x6du; break;
    default: fmt = 0u; break;
    }
    record_event(kEvDepthFmt, depth, fmt);
    return fmt;
}

U __cdecl render_descriptor_bits_00537f90(const void* descriptor_format) {
    const B fmt = static_cast<const B*>(descriptor_format)[0] & 0x7fu;
    U bits = 8u;
    switch (fmt) {
    case 0x79u: bits = 1u; break;
    case 0x7au: bits = 4u; break;
    case 0x7bu: case 0x03u: case 0x42u: case 0x50u: case 0x68u: bits = 8u; break;
    case 0x7eu: bits = 15u; break;
    case 0x78u: case 0x05u: case 0x51u: case 0x52u: case 0x6au: bits = 16u; break;
    case 0x7fu: case 0x6du: bits = 24u; break;
    case 0x7du: bits = 32u; break;
    case 0x44u: bits = 0u; break; // invalid depth probe test
    default: bits = 16u; break;
    }
    record_event(kEvBits, fmt, bits);
    return bits;
}

I __cdecl formatter_entry_005a0fbf(char* output, const char* format, ...) {
    va_list args;
    va_start(args, format);
    const int n = std::vsnprintf(output, 16u, format, args);
    va_end(args);
    record_event(kEvFormat, fnv1a(format), fnv1a(output));
    return n;
}

void* __cdecl allocate_00531ca0(const char* name, I bytes, U align) {
    record_event(kEvAlloc, fnv1a(name), static_cast<U>(bytes), align);
    if (g_alloc_fail) {
        return nullptr;
    }
    const U aligned = (static_cast<U>(bytes) + 15u) & ~15u;
    require(g_alloc_cursor + aligned <= kPoolBytes, "pool overflow");
    void* const p = g_alloc_pool + g_alloc_cursor;
    g_alloc_cursor += aligned;
    return p;
}

void __cdecl heap_fill_0053c290(void* dst, U value, U bytes) {
    record_event(kEvFill, address(dst), value, bytes);
    std::memset(dst, static_cast<int>(value & 0xffu), bytes);
}

U __cdecl startup_sequence_value_00569a90() {
    record_event(kEvAvail, 0x00100000u);
    return 0x00100000u;
}

} // namespace porsche

static B* code_page = nullptr;
static B* slot_005557d0 = nullptr;
static B* slot_00574c70 = nullptr;

static U g_jt1[5] = {};
static B g_idx_tbl[0x7cu] = {};
static U g_jt2[4] = {};

static void relocate_call_rel32(
    B* slot, U orig_base_va, U off, U expected_target_va, const void* replacement) {
    require(slot[off] == 0xe8u, "CALL rel32 opcode");
    const I old_disp = static_cast<I>(load32(slot, off + 1u));
    const U actual_target = (orig_base_va + off + 5u + static_cast<U>(old_disp)) & 0xffffffffu;
    require(actual_target == expected_target_va, "CALL rel32 target VA");
    const U new_disp = address(replacement) - address(slot + off + 5u);
    store32(slot, off + 1u, new_disp);
}

static void relocate_imm32(
    B* slot, U imm_off, U expected_addr, const void* replacement) {
    const U actual = load32(slot, imm_off);
    require(actual == expected_addr, "imm32/disp32 target");
    store32(slot, imm_off, address(replacement));
}

static void init() {
    static const B body_005557d0[] = {@BODY_005557D0@};
    static const B body_00574c70[] = {@BODY_00574C70@};
    require(sizeof body_005557d0 == 415u, "415B 005557d0");
    require(sizeof body_00574c70 == 465u, "465B 00574c70");

    code_page = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                             PAGE_EXECUTE_READWRITE));
    require(code_page != nullptr, "VirtualAlloc RWX");

    slot_005557d0 = code_page + 0x000u;
    slot_00574c70 = code_page + 0x200u;

    std::memcpy(slot_005557d0, body_005557d0, sizeof body_005557d0);
    std::memcpy(slot_00574c70, body_00574c70, sizeof body_00574c70);

    // 005557d0 switch tables (0x00555970, 0x00555984, 0x00555a00)
    const U jt1_vas[5] = {0x005557fbu, 0x00555810u, 0x00555802u, 0x00555809u, 0x00555967u};
    for (U i = 0u; i < 5u; ++i) {
        g_jt1[i] = address(slot_005557d0 + (jt1_vas[i] - 0x005557d0u));
    }
    std::memset(g_idx_tbl, 4, sizeof g_idx_tbl);
    g_idx_tbl[0x03u - 3u] = 0u;
    g_idx_tbl[0x42u - 3u] = 0u;
    g_idx_tbl[0x50u - 3u] = 0u;
    g_idx_tbl[0x68u - 3u] = 0u;
    g_idx_tbl[0x7eu - 3u] = 0u;
    g_idx_tbl[0x05u - 3u] = 1u;
    g_idx_tbl[0x6au - 3u] = 1u;
    g_idx_tbl[0x7du - 3u] = 1u;
    g_idx_tbl[0x51u - 3u] = 2u;
    g_idx_tbl[0x78u - 3u] = 2u;
    g_idx_tbl[0x52u - 3u] = 3u;
    g_idx_tbl[0x6du - 3u] = 3u;
    const U jt2_vas[4] = {0x0055587bu, 0x005558bau, 0x005558f7u, 0x00555934u};
    for (U i = 0u; i < 4u; ++i) {
        g_jt2[i] = address(slot_005557d0 + (jt2_vas[i] - 0x005557d0u));
    }

    // 00574c70 relocations
    relocate_imm32(slot_00574c70, 0x00cu, 0x005dead0u, &porsche::splash_progress_format_005dead0);
    relocate_call_rel32(slot_00574c70, 0x00574c70u, 0x01eu, 0x00535380u,
                        reinterpret_cast<const void*>(&porsche::texture_depth_format_00535380));
    relocate_call_rel32(slot_00574c70, 0x00574c70u, 0x02cu, 0x00537f90u,
                        reinterpret_cast<const void*>(&porsche::render_descriptor_bits_00537f90));
    relocate_call_rel32(slot_00574c70, 0x00574c70u, 0x077u, 0x00535380u,
                        reinterpret_cast<const void*>(&porsche::texture_depth_format_00535380));
    relocate_imm32(slot_00574c70, 0x084u, 0x005deb88u, &porsche::render_descriptor_option_005deb88);
    relocate_imm32(slot_00574c70, 0x094u, 0x005c0980u, kErrInvalidDepth);
    relocate_imm32(slot_00574c70, 0x09au, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    relocate_imm32(slot_00574c70, 0x09eu, 0x005c096cu, kSourceFile);
    relocate_imm32(slot_00574c70, 0x0a4u, 0x005deb78u, &porsche::shared_runtime_word_005deb78);
    relocate_imm32(slot_00574c70, 0x0aeu, 0x005debf0u, &porsche::diagnostic_handler_005debf0);
    relocate_imm32(slot_00574c70, 0x0d8u, 0x005c0960u, kFmtShp);
    relocate_call_rel32(slot_00574c70, 0x00574c70u, 0x0ebu, 0x005a0fbfu,
                        reinterpret_cast<const void*>(&porsche::formatter_entry_005a0fbf));
    relocate_call_rel32(slot_00574c70, 0x00574c70u, 0x0fbu, 0x00531ca0u,
                        reinterpret_cast<const void*>(&porsche::allocate_00531ca0));
    relocate_imm32(slot_00574c70, 0x10au, 0x005deb88u, &porsche::render_descriptor_option_005deb88);
    relocate_imm32(slot_00574c70, 0x118u, 0x005deb80u, &porsche::texture_create_errors_005deb80);
    relocate_imm32(slot_00574c70, 0x11eu, 0x005deb74u, &porsche::shared_runtime_word_005deb74);
    relocate_imm32(slot_00574c70, 0x122u, 0x005c096cu, kSourceFile);
