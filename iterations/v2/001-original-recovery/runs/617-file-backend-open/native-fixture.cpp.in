#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdio>
#include <cstring>
#include "file_backend_open_617.hpp"

using U = std::uint32_t;
using B = std::uint8_t;

static U address(const void* p) { return reinterpret_cast<U>(p); }
static U word(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}
static void put(void* p, U o, U v) { std::memcpy(static_cast<B*>(p) + o, &v, 4u); }

enum : U {
    kPathBufSize = 320u,
    kMaxEvents = 16u,
};

enum EventTag : U {
    kEvSearchChar = 1u,
    kEvCopyN = 2u,
    kEvDiskOpen = 3u,
    kEvEnumerate = 4u,
};

struct Event {
    U tag;
    U arg0;
    U arg1;
    U arg2;
    U arg3;
    U arg4;
    U arg5;
    U arg6;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U exception[3];
    U count;
    Event events[kMaxEvents];
};

static char current_test_path[kPathBufSize] = {};
static U current_test_path_len = 0u;
static U configured_disk_status = 0u;
static void* configured_disk_handle = nullptr;
static bool configured_enum_mutates_handle = false;
static void* configured_enum_handle = nullptr;
static U configured_enum_ret = 0u;

static Trace trace{};
static Trace expected{};

static U cases = 0u;
static U events = 0u;

static B* code = nullptr;
static B* slot_568900 = nullptr;

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U path_offset(const char* p) {
    if (p == nullptr) {
        return 0xfffffffeu;
    }
    const U ptr = address(p);
    const U base = address(current_test_path);
    if (ptr >= base && ptr <= base + current_test_path_len) {
        return ptr - base;
    }
    return 0xffffffffu;
}

static U fnv1a_32(const char* s) {
    U h = 0x811c9dc5u;
    for (U i = 0u; s[i] != '\0'; ++i) {
        h ^= static_cast<U>(static_cast<B>(s[i]));
        h *= 0x01000193u;
    }
    return h;
}

static void record_event(U tag, U arg0, U arg1, U arg2, U arg3, U arg4 = 0u, U arg5 = 0u, U arg6 = 0u) {
    require(trace.count < kMaxEvents, "bounded event count");
    Event& e = trace.events[trace.count++];
    e.tag = tag;
    e.arg0 = arg0;
    e.arg1 = arg1;
    e.arg2 = arg2;
    e.arg3 = arg3;
    e.arg4 = arg4;
    e.arg5 = arg5;
    e.arg6 = arg6;
}

namespace porsche {

IoList free_auxiliary_006a5c38 = {};

const char* __cdecl formatter_search_character_005a2780(const char* str, int ch) {
    record_event(kEvSearchChar, path_offset(str), static_cast<U>(ch), 0u, 0u);
    if (str == nullptr) {
        return nullptr;
    }
    return std::strchr(str, ch);
}

char* __cdecl formatter_error_copy_n_005a28a0(char* dst, const char* src, std::uint32_t count) {
    record_event(kEvCopyN, dst != nullptr ? 1u : 0u, path_offset(src), count, 0u);
    return std::strncpy(dst, src, count);
}

std::uint32_t __cdecl disk_physical_open_005919a0(const char* path, std::uint32_t mode,
                                                   std::uint32_t zero, void** out_handle) {
    record_event(kEvDiskOpen, path_offset(path), mode, zero, out_handle != nullptr ? 1u : 0u);
    if (out_handle != nullptr) {
        *out_handle = configured_disk_handle;
    }
    return configured_disk_status;
}

std::uint32_t __cdecl network_callback_enumerate_locked_00580e60(IoList* list,
                                                                 NetworkCallbackVisit488 visitor,
                                                                 std::uint32_t ctx_addr) {
    auto* c = reinterpret_cast<FileOpenContext_617*>(ctx_addr);
    require(c != nullptr, "non-null FileOpenContext_617");
    const U list_ok = (list == &free_auxiliary_006a5c38) ? 1u : 0u;
    const U visitor_va = reinterpret_cast<U>(visitor);
    const U prefix_ptr_ok = (c->prefix_ptr == &c->prefix_buf[0]) ? 1u : 0u;
    const U full_path_off = path_offset(c->full_path);
    const U handle_val = reinterpret_cast<U>(c->handle_or_tail);
    const U prefix_len = static_cast<U>(std::strlen(c->prefix_buf));
    const U prefix_hash = fnv1a_32(c->prefix_buf);
    record_event(kEvEnumerate, list_ok, visitor_va, prefix_ptr_ok, full_path_off,
                 c->status, handle_val, (prefix_len << 16u) ^ prefix_hash);
    if (configured_enum_mutates_handle) {
        c->handle_or_tail = configured_enum_handle;
    }
    return configured_enum_ret;
}

} // namespace porsche

static __declspec(noinline) void dirty_stack() {
    volatile B buf[512];
    for (U i = 0u; i < sizeof(buf); ++i) {
        buf[i] = static_cast<B>(0x5au ^ (i & 0xffu));
    }
}

static U invoke_cdecl_3arg(void* fn, U arg0, U arg1, U arg2, U& ret_eax) {
    dirty_stack();
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push arg2
        push arg1
        push arg0
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        add esp, 12
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static int exception_record(EXCEPTION_POINTERS* e) {
    trace.exception[0] = e->ExceptionRecord->ExceptionCode;
    trace.exception[1] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[0]);
    trace.exception[2] = static_cast<U>(e->ExceptionRecord->ExceptionInformation[1]);
    return EXCEPTION_EXECUTE_HANDLER;
}

static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}

static void relocate_rel32(B* slot, U slot_va, U off, U expected_target_va, const void* target) {
    require(off >= 1u && (slot[off - 1u] == 0xe8u || slot[off - 1u] == 0xe9u),
            "exact relative call/jump opcode");
    const U actual_target = slot_va + off + 4u + word(slot, off);
    require(actual_target == expected_target_va, "exact relative relocation target");
    const U next_ip = address(slot + off + 4u);
    put(slot, off, address(target) - next_ip);
}

static void init() {
    static const B body_568900[] = {@BODY_00568900@};
    require(sizeof body_568900 == 170u, "170-byte original body 00568900");

    code = static_cast<B*>(VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE,
                                        PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "raw executable allocation");
    slot_568900 = code + 0u;
    std::memcpy(slot_568900, body_568900, sizeof body_568900);

    relocate_rel32(slot_568900, 0x00568900u, 0x14u, 0x005a2780u,
                   reinterpret_cast<const void*>(&porsche::formatter_search_character_005a2780));
    relocate_rel32(slot_568900, 0x00568900u, 0x44u, 0x005a28a0u,
                   reinterpret_cast<const void*>(&porsche::formatter_error_copy_n_005a28a0));
    relocate_rel32(slot_568900, 0x00568900u, 0x67u, 0x005919a0u,
                   reinterpret_cast<const void*>(&porsche::disk_physical_open_005919a0));
    require(word(slot_568900, 0x8bu) == 0x005689b0u, "exact visitor 005689b0 literal");
    relocate_abs32(slot_568900, 0x90u, 0x006a5c38u, address(&porsche::free_auxiliary_006a5c38));
    relocate_rel32(slot_568900, 0x00568900u, 0x95u, 0x00580e60u,
                   reinterpret_cast<const void*>(&porsche::network_callback_enumerate_locked_00580e60));

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "instruction cache");
}

static void setup_case(const char* path, U disk_status, U disk_handle,
                       bool enum_mutates, U enum_handle, U enum_ret = 0u) {
    const U len = static_cast<U>(std::strlen(path));
    require(len < kPathBufSize, "bounded test path length");
    std::memset(current_test_path, 0, sizeof(current_test_path));
    std::memcpy(current_test_path, path, len + 1u);
    current_test_path_len = len;
    configured_disk_status = disk_status;
    configured_disk_handle = reinterpret_cast<void*>(static_cast<std::uintptr_t>(disk_handle));
    configured_enum_mutates_handle = enum_mutates;
    configured_enum_handle = reinterpret_cast<void*>(static_cast<std::uintptr_t>(enum_handle));
    configured_enum_ret = enum_ret;
}

static void compare_traces() {
    require(trace.abi_fail == 0u, "original ABI");
    require(expected.abi_fail == 0u, "cpp ABI");
    require(trace.exception[0] == 0u && expected.exception[0] == 0u, "no exceptions");
    require(trace.ret_eax == expected.ret_eax, "ret_eax mismatch");
    require(trace.count == expected.count, "event count mismatch");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "event tag mismatch");
        require(trace.events[i].arg0 == expected.events[i].arg0, "event arg0 mismatch");
        require(trace.events[i].arg1 == expected.events[i].arg1, "event arg1 mismatch");
        require(trace.events[i].arg2 == expected.events[i].arg2, "event arg2 mismatch");
        require(trace.events[i].arg3 == expected.events[i].arg3, "event arg3 mismatch");
        require(trace.events[i].arg4 == expected.events[i].arg4, "event arg4 mismatch");
        require(trace.events[i].arg5 == expected.events[i].arg5, "event arg5 mismatch");
        require(trace.events[i].arg6 == expected.events[i].arg6, "event arg6 mismatch");
    }
}

static void run_one(const char* path, U mode, U flags, U disk_status, U disk_handle,
                    bool enum_mutates, U enum_handle, U enum_ret = 0u) {
    ++cases;
    std::memset(&trace, 0, sizeof trace);
    setup_case(path, disk_status, disk_handle, enum_mutates, enum_handle, enum_ret);
    __try {
        trace.abi_fail = invoke_cdecl_3arg(slot_568900, address(current_test_path), mode, flags, trace.ret_eax);
    } __except (exception_record(GetExceptionInformation())) {
    }
    expected = trace;

    std::memset(&trace, 0, sizeof trace);
    setup_case(path, disk_status, disk_handle, enum_mutates, enum_handle, enum_ret);
    __try {
        trace.abi_fail = invoke_cdecl_3arg(
            reinterpret_cast<void*>(&porsche::file_backend_open_00568900),
            address(current_test_path), mode, flags, trace.ret_eax);
    } __except (exception_record(GetExceptionInformation())) {
    }
    events += trace.count;
    compare_traces();
}

int main() {
    init();

    // 1. Direct disk_physical_open_005919a0 paths (no '|' delimiter).
    const char* const direct_paths[] = {
        "data/car.viv",
        "",
        "tracks/zone01.trk",
        "dir\\sub/file_name.bin",
    };
    for (U p = 0u; p < 4u; ++p) {
        const char* const path = direct_paths[p];
        for (U mode : {0u, 1u, 0x103u}) {
            run_one(path, mode, 0u, 0u, 0x10001000u + p, false, 0u);
            run_one(path, mode, 1u, 0u, 0x20002000u + p, false, 0u);
            run_one(path, mode, 1u, 0u, 0x30003000u + p, true, 0x90009000u + p);
            run_one(path, mode, 0xffffffffu, 0u, 0u, true, 0x40004000u + p, 7u);
            run_one(path, mode, 1u, 1u, 0x50005000u + p, true, 0xdeadbeefu);
            run_one(path, mode, 0u, 0x80070002u, 0u, false, 0u);
        }
    }

    // 2. Pipe-delimited archive paths ('|' present).
    char long_pipe_path[240];
    std::memset(long_pipe_path, 'a', 180u);
    std::memcpy(long_pipe_path + 180u, "|nested/tail.dat", 17u);

    const char* const pipe_paths[] = {
        "archive.viv|member.bin",
        "|leading_pipe",
        "trailing_pipe|",
        "first.viv|second|third",
        "gamedata/audio/sfx.bnk|engine/idle.raw",
        long_pipe_path,
    };
    for (U p = 0u; p < 6u; ++p) {
        const char* const path = pipe_paths[p];
        for (U mode : {0u, 2u}) {
            run_one(path, mode, 0u, 0x77u, 0x11111111u, false, 0u);
            run_one(path, mode, 1u, 0x77u, 0x22222222u, false, 0u);
            run_one(path, mode, 1u, 0x77u, 0x33333333u, true, 0xbeef0000u + p);
            run_one(path, mode, 5u, 0u, 0u, true, 0xcafe0000u + p, 1u);
        }
    }

    std::printf("file_backend_open_original_x86_vs_cpp=PASS cases=%u events=%u\n",
                cases, events);
    return 0;
}
