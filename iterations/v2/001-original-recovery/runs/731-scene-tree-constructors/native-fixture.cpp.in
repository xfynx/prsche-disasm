    set_rel(slot_004558b0,119,0x004558b0,0x5322c0,reinterpret_cast<void*>(&heap_leave_005322c0),1,0xe8);
    set_rel(slot_004558b0,119,0x004558b0,0x59eeb0,reinterpret_cast<void*>(&application_context_new_head_0059eeb0),1,0xe8);
