// Native x86-vs-C++ differential fixture for Run716 scene-stage reset leaves.
// Original body bytes are injected by verify-v2-native-batch.py from the
// SHA-pinned Porsche.exe. ECX is a controlled oracle input: both the raw x86
// body and the C++ body store (entry_ECX >> 24) & 0xff at holder+8.
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#include "scene_stage_reset_716.hpp"
#include "scene_stage_stack_core_721.hpp"
#include "scene_blur_stage_726.hpp"
#include "scene_tree_constructors_731.hpp"
#include "startup_sequence_resource_table_649.hpp"
extern "C" void __cdecl scene_blur_chain_726(unsigned char*);
#include "porsche/application_alloc.hpp"
#include "porsche/application_context_base.hpp"
#include "porsche/heap.hpp"
#include "porsche/render_startup.hpp"

using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;
using namespace porsche;

enum : U {
    kEvAlloc = 1u, kEvContext = 2u, kEvLockEnter = 3u, kEvLockLeave = 4u,
    kEvNewHead = 5u, kEvMemberStorage = 6u,
};
enum : U { kMaxEvents = 64u, kNodeBytes = 0x20u };

struct Event { U kind, a, b, c, d; };
struct Snapshot {
    U event_count;
    Event events[kMaxEvents];
    U root_6115c0, root_627dfc, root_627dfc_holder;
    B allocations[12][0x50u];
    U tree_root, group_root;
    U matrix[256][8];
    U blur[8], clock, program, mode, resource;
    B node[kNodeBytes];
    B member[0x18u];
    U heap_list, heap_free, heap_free11;
    B extra_nodes[2][kNodeBytes];
};

static void require(bool ok, const char* why) {
    if (!ok) { std::printf("divergence %s\n", why); std::fflush(stdout); ExitProcess(7); }
}
static U fnv(const void* p, U count) {
    U h = 0x811c9dc5u; const B* b = static_cast<const B*>(p);
    for (U i = 0u; i < count; ++i) h = (h ^ b[i]) * 0x01000193u;
    return h;
}
static U address(const void* p) { return static_cast<U>(reinterpret_cast<std::uintptr_t>(p)); }
static U load_dword(const void* base, U off) { U v; std::memcpy(&v, static_cast<const B*>(base) + off, 4u); return v; }
static void store_dword(void* base, U off, U v) { std::memcpy(static_cast<B*>(base) + off, &v, 4u); }

// ---- controlled endpoints -------------------------------------------------
static Event events[kMaxEvents];
static U event_count = 0u;
static U cases = 0u;
static U which = 0u;
static U g_alloc_index = 0u;
static U g_fail_mask = 0u;
static U g_refill = 0u;

static alignas(8) B heap_state[0x80u];
static B buf4[4u], holder_buf[0x0cu], node_buf[kNodeBytes], member_buf[0x18u];
static B allocations[12][0x50u];
static B node_second[kNodeBytes], node_11[kNodeBytes];
static U opaque_word = 0u;
static B explicit_bytes[4];
static B root_cell[8u];
static B lookup_owner[12], lookup_tree[4], lookup_sentinel[28], lookup_node[28];
static U lookup_hit = 0;
static void* raw_lookup = nullptr;
static void* ctx_cell = heap_state;

static void record(U kind, U a = 0u, U b = 0u, U c = 0u, U d = 0u) {
    require(event_count < kMaxEvents, "event overflow");
    events[event_count++] = Event{kind, a, b, c, d};
}
static void reset_case() {
    event_count = 0u; g_alloc_index = 0u;
    std::memset(allocations, 0xcc, sizeof allocations);
    std::memset(scene_stage_matrix_00624de8, 0xa5, sizeof scene_stage_matrix_00624de8);
    scene_stage_tree_root_00627df0 = root_cell;
    scene_stage_group_root_006221d8 = root_cell;
    std::memcpy(explicit_bytes, &opaque_word, 4);
    std::memset(events, 0, sizeof events);
    std::memset(heap_state, 0, sizeof heap_state);
    std::memset(buf4, 0xcc, sizeof buf4);
    std::memset(holder_buf, 0xcc, sizeof holder_buf);
    std::memset(node_buf, 0xcc, sizeof node_buf);
    std::memset(member_buf, 0xcc, sizeof member_buf);
    std::memset(root_cell, 0xcc, sizeof root_cell);
    ctx_cell = heap_state;
    std::memset(lookup_owner, 0, sizeof lookup_owner);
    std::memset(lookup_sentinel, 0, sizeof lookup_sentinel);
    std::memset(lookup_node, 0, sizeof lookup_node);
    store_dword(lookup_owner, 8, address(lookup_tree));
    store_dword(lookup_tree, 0, address(lookup_sentinel));
    store_dword(lookup_sentinel, 4, lookup_hit ? address(lookup_node) : 0);
    store_dword(lookup_node, 16, 0); store_dword(lookup_node, 20, 0x52554c42);
    store_dword(lookup_node, 24, address(root_cell));
    startup_context_table_owner_00613e04 = lookup_owner;
    std::memset(scene_blur_matrix_0061bc78, 0xa5, sizeof scene_blur_matrix_0061bc78);
    scene_blur_clock_0061bcac = nullptr;
    scene_blur_program_0061bcb0 = scene_blur_mode_0061bcb4 = scene_blur_resource_0061bcb8 = nullptr;
    store_dword(heap_state, 0x28u, address(buf4));       // list head / lock
    store_dword(heap_state, 0x3cu, g_refill ? 0u : address(node_buf));
    std::memset(node_second,0xcc,sizeof node_second); std::memset(node_11,0xcc,sizeof node_11);
    store_dword(heap_state,0x78u,g_refill ? 0u : address(node_11));
    store_dword(node_second,4,0x11223344);
    store_dword(node_11,4,0x55667788);
    store_dword(node_buf,4,address(node_second));              // next free node
    scene_stage_root_006115c0 = reinterpret_cast<void*>(0x5eed0001u);
    scene_stage_root_00627dfc = root_cell;
}

namespace porsche {
void* startup_context_table_owner_00613e04 = nullptr;
U startup_sequence_word_00606ac4 = 0;
void* __fastcall startup_context_table_lookup_0044d320(void* self, void*, U a, U b) {
    return reinterpret_cast<void*(__fastcall*)(void*, void*, U, U)>(raw_lookup)(self, nullptr, a, b);
}
void* __fastcall scene_blur_program_ctor_00468240(void* self, void*, U a, U b, U c, U d, U e) {
    require(a==14 && b==4 && c==1 && d==0 && e==4, "blur ctor args");
    record(11, address(self), a, b, e); std::memset(self, 0x24, 40);
    return static_cast<B*>(self)+4;
}
void __fastcall scene_blur_program_setup_004685e0(void* self, void*, U a, U b, U c, U d, U e, U f) {
    require(!(a|b|c|d|e|f), "blur setup args"); record(12,address(self));
    if(self) store_dword(self,0,0x685e0);
}


void* __cdecl render_allocate_0059ef90(std::uint32_t size) {
    const U idx = g_alloc_index++;
    record(kEvAlloc, size, idx);
    if ((g_fail_mask & (1u << idx)) != 0u) return nullptr;
    require(idx < 12u && size <= 0x50u, "allocation bound");
    return allocations[idx];
}
void* __cdecl application_context_heap_state_005e4fe8() {
    // The original body reads the 005e4fe8 cell directly (MOV EAX,[...]);
    // this accessor is only the C++ transport for that same state read and
    // records no observable event.
    return heap_state;
}
void __cdecl heap_enter_005322b0(void* lock) { record(kEvLockEnter, address(lock)); }
void __cdecl heap_leave_005322c0(void* lock) { record(kEvLockLeave, address(lock)); }
void __cdecl application_context_new_head_0059eeb0(std::uint32_t kind, std::uint32_t slot) {
    record(kEvNewHead, kind, slot);
    if (g_refill != 0u) {
        require(kind==2 || kind==17,"pool refill kind");
        store_dword(heap_state,kind==2?0x3cu:0x78u,address(kind==2?node_buf:node_11));
    }
}
void* __cdecl application_context_member_storage_004211d0(std::uint32_t bytes, std::uint32_t mode) {
    record(kEvMemberStorage, bytes, mode);
    return member_buf;
}


void __fastcall scene_stage_tree_load_00455570(void* slot, void*) {
    record(8, address(slot), load_dword(slot, 0));
    store_dword(slot, 0, load_dword(slot, 0) ^ 0x20u);
}
void* __fastcall scene_stage_group_ctor_0059f070(void* self, void*) {
    record(10, address(self)); std::memset(self, 0x70, 0x4c);
    return static_cast<B*>(self) + 4; // original caller must use this return
}

} // namespace porsche

