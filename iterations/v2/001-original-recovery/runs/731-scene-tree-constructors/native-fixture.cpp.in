// ---- ABI wrapper: ECX is a controlled input -------------------------------
static U invoke(void* fn, U ecx_value, U& abi_fail) {
    U before = 0u, frame = 0u, fail = 0u, result = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0a5a5a500h
        mov ecx, ecx_value
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        mov edx, opaque_word
        mov dword ptr [esp-30h], edx
        lea eax, explicit_bytes
        push eax
        call fn
        add esp, 4
        mov result, eax
        cmp ecx, 0
        jne bad
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
    return result;
}

static void capture(Snapshot& out) {
    std::memcpy(out.blur, scene_blur_matrix_0061bc78, sizeof out.blur);
    out.clock=address(scene_blur_clock_0061bcac); out.program=address(scene_blur_program_0061bcb0);
    out.mode=address(scene_blur_mode_0061bcb4); out.resource=address(scene_blur_resource_0061bcb8);
    out.event_count = event_count;
    std::memcpy(out.events, events, event_count * sizeof(Event));
    out.root_6115c0 = address(scene_stage_root_006115c0);
    out.root_627dfc = address(scene_stage_root_00627dfc);
    out.root_627dfc_holder = scene_stage_root_00627dfc == nullptr
        ? 0u : load_dword(scene_stage_root_00627dfc, 0u);
    std::memcpy(out.allocations, allocations, sizeof allocations);
    out.tree_root = address(scene_stage_tree_root_00627df0);
    out.group_root = address(scene_stage_group_root_006221d8);
    std::memcpy(out.matrix, scene_stage_matrix_00624de8, sizeof out.matrix);
    std::memcpy(out.node, node_buf, sizeof node_buf);
    std::memcpy(out.member, member_buf, sizeof member_buf);
    std::memcpy(out.extra_nodes[0],node_second,sizeof node_second);
    std::memcpy(out.extra_nodes[1],node_11,sizeof node_11);
    out.heap_free11=load_dword(heap_state,0x78u);
    out.heap_list = load_dword(heap_state, 0x28u);
    out.heap_free = load_dword(heap_state, 0x3cu);
}
static void dump_events(const char* tag, const Snapshot& s) {
    std::printf("%s case=%u count=%u:", tag, cases, s.event_count);
    for (U i = 0u; i < s.event_count; ++i)
        std::printf(" [%u,%u,%u,%u,%u]", s.events[i].kind, s.events[i].a,
                    s.events[i].b, s.events[i].c, s.events[i].d);
    std::printf("\n");
    std::fflush(stdout);
}
static void dump_bytes(const char* tag, const B* a, const B* b, U n) {
    std::printf("%s case=%u:", tag, cases);
    for (U i = 0u; i < n; ++i)
        if (a[i] != b[i]) std::printf(" [%02x:%02x!=%02x]", i, a[i], b[i]);
    std::printf("\n");
    std::fflush(stdout);
}
static void assert_same(const Snapshot& exp, const Snapshot& act) {
    require(std::memcmp(act.blur, exp.blur, sizeof act.blur)==0, "blur matrix");
    require(act.clock==exp.clock && act.program==exp.program && act.mode==exp.mode && act.resource==exp.resource, "blur roots");
    if (act.event_count != exp.event_count) {
        dump_events("original", exp);
        dump_events("cpp", act);
    }
    require(act.event_count == exp.event_count, "event count");
    for (U i = 0u; i < exp.event_count; ++i) {
        require(act.events[i].kind == exp.events[i].kind, "event kind");
        require(act.events[i].a == exp.events[i].a, "event a");
        require(act.events[i].b == exp.events[i].b, "event b");
        require(act.events[i].c == exp.events[i].c, "event c");
        require(act.events[i].d == exp.events[i].d, "event d");
    }
    require(act.root_6115c0 == exp.root_6115c0, "root 006115c0");
    require(act.root_627dfc == exp.root_627dfc, "root 00627dfc");
    require(act.root_627dfc_holder == exp.root_627dfc_holder, "root holder");
    require(std::memcmp(act.allocations, exp.allocations, sizeof allocations) == 0, "allocation bytes");
    require(act.tree_root == exp.tree_root && act.group_root == exp.group_root, "721 roots");
    require(std::memcmp(act.matrix, exp.matrix, sizeof act.matrix) == 0, "matrix bytes");
    if (std::memcmp(act.node, exp.node, sizeof node_buf) != 0)
        dump_bytes("node-diff", exp.node, act.node, sizeof node_buf);
    require(std::memcmp(act.node, exp.node, sizeof node_buf) == 0, "node bytes");
    require(std::memcmp(act.member, exp.member, sizeof member_buf) == 0, "member bytes");
    require(act.heap_free11==exp.heap_free11,"pool11 head");
    require(std::memcmp(act.extra_nodes,exp.extra_nodes,sizeof act.extra_nodes)==0,"pool nodes");
    require(act.heap_list == exp.heap_list, "heap list");
    require(act.heap_free == exp.heap_free, "heap free");
}

static U abi_fail[2];
static void run_case(void* original, void* cpp, U ecx_value) {
    Snapshot snap[2];
    for (which = 0u; which < 2u; ++which) {
        reset_case();
        U af = 0u;
        if (which == 0u) (void)invoke(original, ecx_value, af);
        else             (void)invoke(cpp, ecx_value, af);
        abi_fail[which] = af;
        capture(snap[which]);
    }
    require(abi_fail[0] == 0u && abi_fail[1] == 0u, "abi fail");
    assert_same(snap[0], snap[1]);
    ++cases;
}


static void* invoke_constructor(void* fn, void* self, B* first) {
    U before=0, frame=0, fail=0; void* result=nullptr;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        mov ecx, self
        mov edx, 0deadc0deh
        push 0
        push first
        call fn
        mov result, eax
        cmp esp, before
        jne badctor
        cmp ebp, frame
        jne badctor
        cmp ebx, 13579bdfh
        jne badctor
        cmp esi, 2468ace0h
        jne badctor
        cmp edi, 10203040h
        je donector
    badctor:
        mov fail, 1
    donector:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    require(fail==0,"constructor ABI");
    return result;
}
static void constructor_case(void* original, void* cpp, U tag, bool alias) {
    Snapshot snap[2];
    for(which=0;which<2;++which) {
        reset_case();
        B* first=alias ? allocations[0]+9 : explicit_bytes+1;
        *first=static_cast<B>(tag);
        void* fn=which?cpp:original;
        void* result=invoke_constructor(fn,allocations[0],first);
        require(result==allocations[0],"constructor returned self");
        capture(snap[which]);
    }
    assert_same(snap[0],snap[1]); ++cases;
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* info) {
    std::printf("native-fault code=%08lx case=%u which=%u eip=%08lx\n",
        info->ExceptionRecord->ExceptionCode, cases, which, info->ContextRecord->Eip);
    std::fflush(stdout); ExitProcess(98);
    return EXCEPTION_CONTINUE_SEARCH;
}

int main(int argc, char** argv) {
    AddVectoredExceptionHandler(1u, fault_handler);
    require(argc == 2, "argv PE path");
    require(scene_stage_root_006115c0 == nullptr && scene_stage_root_00627dfc == nullptr, "production initial roots");
    require(scene_blur_clock_0061bcac==nullptr && scene_blur_program_0061bcb0==nullptr && scene_blur_mode_0061bcb4==nullptr && scene_blur_resource_0061bcb8==nullptr, "726 production roots");
    for(U word:scene_blur_matrix_0061bc78) require(word==0,"726 production matrix");
    prepare_code();

    require(scene_stage_tree_root_00627df0 == nullptr && scene_stage_group_root_006221d8 == nullptr, "721 production initial roots");
    for (const auto& row : scene_stage_matrix_00624de8)
        for (U word : row) require(word == 0, "721 production initial matrix");
    for(U refill=0;refill<2;++refill) for(U tag=0;tag<256;++tag) for(U alias=0;alias<2;++alias) {
        g_refill=refill; g_fail_mask=0; opaque_word=0x12abcdef;
        constructor_case(slot_00455830,reinterpret_cast<void*>(&scene_stage_tree_ctor_00455830),tag,alias!=0);
        constructor_case(slot_004558b0,reinterpret_cast<void*>(&scene_stage_tree_ctor_004558b0),tag,alias!=0);
    }
    const U patterns[] = {0u, 0x5a37ca18u, 0xffffffffu, 0x12345678u};
    const U masks[] = {0u, 1u, 4u, 8u, 16u, 32u, 64u, 128u, 256u};
    for (U hit=0; hit<2; ++hit) for (U pattern : patterns) for (U mask : masks) {
        lookup_hit=hit;
        opaque_word = pattern; g_fail_mask = mask; g_refill = 0;
        run_case(original_chain, reinterpret_cast<void*>(&scene_blur_chain_726), 0xdeadbeefu);
    }
    opaque_word = 0x89abcdefu; g_fail_mask = 0; g_refill = 1;
    run_case(original_chain, reinterpret_cast<void*>(&scene_blur_chain_726), 0x76543210u);
    std::printf("scene_tree_constructors_original_x86_vs_cpp=PASS cases=%u\n", cases);
    std::fflush(stdout);
    return 0;
}
