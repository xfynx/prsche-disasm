}

std::uint32_t __cdecl render_buffer_read_word_0056e2a8(const void* src, std::int32_t bytes) {
    const auto* const p = static_cast<const std::uint8_t*>(src) + bytes - 4;
    std::uint32_t val = 0u;
    std::memcpy(&val, p, sizeof val);
    const std::uint32_t shift = static_cast<std::uint32_t>((-bytes) * 8 + 32) & 0x1fu;
    return val >> shift;
}

void __cdecl render_mmx_empty_00573070() {
    __asm {
        emms
    }
}

void __cdecl render_shape_transfer_00571630(
    const void* shape, std::int32_t x, std::int32_t y, const void* const* table) {
    require(shape != nullptr && table != nullptr, "shape/table non-null");
    U type_00 = 0u;
    std::uint16_t w16 = 0u, h16 = 0u;
    std::memcpy(&type_00, static_cast<const B*>(shape) + 0, 4u);
    std::memcpy(&w16, static_cast<const B*>(shape) + 4, 2u);
    std::memcpy(&h16, static_cast<const B*>(shape) + 6, 2u);

    U table_id = 99u;
    if (side == 0u) {
        if (table == orig_table_5df880) table_id = 0u;
        else if (table == orig_table_5df8a0) table_id = 1u;
        else if (table == orig_table_5df8c0) table_id = 2u;
    } else {
        if (table == render_fill_table_scalar_005df880) table_id = 0u;
        else if (table == render_fill_table_mmx_005df8a0) table_id = 1u;
        else if (table == render_fill_table_sse_005df8c0) table_id = 2u;
    }
    require(table_id <= 2u, "table identity");
    require(table[5] == nullptr && table[6] == nullptr && table[7] == nullptr, "table null tail");

    const U packed_wh = static_cast<U>(w16) | (static_cast<U>(h16) << 16u);
    record_event(5u, type_00, packed_wh, static_cast<U>(x), static_cast<U>(y), table_id);

    using SpanFn = void*(__cdecl*)(void*, U, U);
    const U slot = active_span_slot % 5u;
    if (table_id == 1u || callback_mutate_backend == 3) {
        __asm {
            mov eax, 12345678h
            movd mm0, eax
        }
    }
    auto* const fn = reinterpret_cast<SpanFn>(const_cast<void*>(table[slot]));
    require(fn != nullptr, "span callback non-null");
    void* const ret = fn(span_buf + 32u, 0xdeadbeefu, 5u);
    record_event(6u, slot, static_cast<U>( static_cast<B*>(ret) - (span_buf + 32u) ));

    if (callback_mutate_backend != -99) {
        render_fill_backend_005decd8 = callback_mutate_backend;
    }
}

