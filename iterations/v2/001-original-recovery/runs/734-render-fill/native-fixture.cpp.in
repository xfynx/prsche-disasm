static U invoke_cdecl3_u32(void* fn, U a0, U a1, U a2, U& abi_fail) {
    U out = 0u, fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push a2
        push a1
        push a0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        mov out, eax
        add esp, 12
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
        emms
    }
    abi_fail = fail;
    return out;
}

static void patch_abs(B* base, U size, U old_va, U new_va, U expected_hits) {
    U hits = 0u;
    for (U i = 0u; i + 4u <= size; ++i) {
        if (rd(base, i) == old_va) {
            wr(base, i, new_va);
            ++hits;
            i += 3u;
        }
    }
    require(hits == expected_hits, "patch_abs count");
}

static void patch_rel(B* base, U offset, U va_start, U orig_target, U new_target) {
    require(base[offset] == 0xe8u, "patch_rel opcode");
    const U decoded = va_start + offset + 5u + rd(base, offset + 1u);
    require(decoded == orig_target, "patch_rel orig target");
    wr(base, offset + 1u, new_target - (ptr(base) + offset + 5u));
}

static void verify_initial_pe_state(const char* pe_path) {
    require(render_fill_backend_005decd8 == -1, "C++ initial 005decd8");
    require(render_fill_color_006a5bb8 == 0u, "C++ initial 006a5bb8");
    require(render_fill_mode_tables_005df8e0[0] == render_fill_table_scalar_005df880 &&
            render_fill_mode_tables_005df8e0[1] == render_fill_table_scalar_005df880 &&
            render_fill_mode_tables_005df8e0[2] == render_fill_table_scalar_005df880 &&
            render_fill_mode_tables_005df8e0[3] == render_fill_table_mmx_005df8a0 &&
            render_fill_mode_tables_005df8e0[4] == render_fill_table_sse_005df8c0,
            "C++ initial 005df8e0");

    FILE* f = std::fopen(pe_path, "rb");
    require(f != nullptr, "open PE");
    std::fseek(f, 0, SEEK_END);
    const long len = std::ftell(f);
    std::rewind(f);
    auto* pe = new B[static_cast<std::size_t>(len)];
    require(std::fread(pe, 1, static_cast<std::size_t>(len), f) == static_cast<std::size_t>(len), "read PE");
    std::fclose(f);

    const U nt = rd(pe, 0x3cu);
    const U base = rd(pe, nt + 52u);
    const U sections = pe[nt + 6u] | (static_cast<U>(pe[nt + 7u]) << 8u);
    const U optional = pe[nt + 20u] | (static_cast<U>(pe[nt + 21u]) << 8u);

    auto read_va_u32 = [&](U va) -> U {
        for (U i = 0u; i < sections; ++i) {
            const B* s = pe + nt + 24u + optional + i * 40u;
            const U vs = rd(s, 8u), rva = rd(s, 12u), rawsize = rd(s, 16u), raw = rd(s, 20u);
            const U delta = va - base - rva;
            if (delta < vs && delta + 4u <= vs) {
                if (delta + 4u <= rawsize) {
                    return rd(pe, raw + delta);
                }
                return 0u;
            }
        }
        require(false, "VA not in PE");
        return 0u;
    };

    require(read_va_u32(0x005decd8u) == 0xffffffffu, "PE initial 005decd8");
    require(read_va_u32(0x006a5bb8u) == 0u, "PE initial 006a5bb8");

    const U expected_5df880[8] = {0x562500u, 0x562520u, 0x562520u, 0x562540u, 0x562570u, 0u, 0u, 0u};
    const U expected_5df8a0[8] = {0x5625a0u, 0x5625c0u, 0x5625c0u, 0x562540u, 0x5625e0u, 0u, 0u, 0u};
    const U expected_5df8c0[8] = {0x562610u, 0x562630u, 0x562630u, 0x562540u, 0x562650u, 0u, 0u, 0u};
    const U expected_5df8e0[5] = {0x5df880u, 0x5df880u, 0x5df880u, 0x5df8a0u, 0x5df8c0u};
    for (U i = 0u; i < 8u; ++i) {
        require(read_va_u32(0x005df880u + i * 4u) == expected_5df880[i], "PE 005df880");
        require(read_va_u32(0x005df8a0u + i * 4u) == expected_5df8a0[i], "PE 005df8a0");
        require(read_va_u32(0x005df8c0u + i * 4u) == expected_5df8c0[i], "PE 005df8c0");
    }
    for (U i = 0u; i < 5u; ++i) {
        require(read_va_u32(0x005df8e0u + i * 4u) == expected_5df8e0[i], "PE 005df8e0");
    }
    delete[] pe;
}

