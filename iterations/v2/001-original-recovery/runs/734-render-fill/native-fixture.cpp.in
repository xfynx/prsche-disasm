    patch_abs(slot_562680, sizeof b_562680, 0x005de62cu, ptr(&window_shutdown_config_005de620[3]), 1u);
    patch_abs(slot_562680, sizeof b_562680, 0x00562800u, ptr(slot_562800), 1u);
    patch_abs(slot_562680, sizeof b_562680, 0x005627f0u, ptr(slot_5627f0), 1u);
    patch_abs(slot_562680, sizeof b_562680, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_abs(slot_562680, sizeof b_562680, 0x005decd8u, ptr(&render_fill_backend_005decd8), 3u);
    patch_abs(slot_562680, sizeof b_562680, 0x005deb1cu, ptr(&shared_runtime_word_005deb1c), 1u);
    patch_abs(slot_562680, sizeof b_562680, 0x005deb18u, ptr(&copy_flag_005deb18), 1u);
    patch_abs(slot_562680, sizeof b_562680, 0x005df8e0u, ptr(orig_table_5df8e0), 1u);
    patch_rel(slot_562680, 0x155u, 0x00562680u, 0x00571630u, ptr(reinterpret_cast<void*>(&render_shape_transfer_00571630)));
    patch_rel(slot_562680, 0x167u, 0x00562680u, 0x00573070u, ptr(slot_573070));

    // Relocate 10 span callbacks
    const U fn_scalar = ptr(reinterpret_cast<void*>(&heap_fill_scalar_005b0980_core));
    const U fn_mmx = ptr(reinterpret_cast<void*>(&heap_fill_mmx_005b0a40_core));
    const U fn_sse = ptr(reinterpret_cast<void*>(&heap_fill_sse_005b0b00_core));

    patch_abs(slot_562500, sizeof b_562500, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_562500, 0x11u, 0x00562500u, 0x005b0980u, fn_scalar);

    patch_abs(slot_562520, sizeof b_562520, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_562520, 0x14u, 0x00562520u, 0x005b0980u, fn_scalar);

    patch_rel(slot_562540, 0x0fu, 0x00562540u, 0x0056e2a8u, ptr(slot_56e2a8));
    patch_rel(slot_562540, 0x19u, 0x00562540u, 0x0056e301u, ptr(reinterpret_cast<void*>(&render_buffer_word_0056e301)));

    patch_abs(slot_562570, sizeof b_562570, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_562570, 0x18u, 0x00562570u, 0x005b0980u, fn_scalar);

    patch_abs(slot_5625a0, sizeof b_5625a0, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_5625a0, 0x11u, 0x005625a0u, 0x005b0a40u, fn_mmx);

    patch_abs(slot_5625c0, sizeof b_5625c0, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_5625c0, 0x14u, 0x005625c0u, 0x005b0a40u, fn_mmx);

    patch_abs(slot_5625e0, sizeof b_5625e0, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_5625e0, 0x18u, 0x005625e0u, 0x005b0a40u, fn_mmx);

    patch_abs(slot_562610, sizeof b_562610, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_562610, 0x11u, 0x00562610u, 0x005b0b00u, fn_sse);

    patch_abs(slot_562630, sizeof b_562630, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_562630, 0x14u, 0x00562630u, 0x005b0b00u, fn_sse);

    patch_abs(slot_562650, sizeof b_562650, 0x006a5bb8u, ptr(&render_fill_color_006a5bb8), 1u);
    patch_rel(slot_562650, 0x18u, 0x00562650u, 0x005b0b00u, fn_sse);

    require(FlushInstructionCache(GetCurrentProcess(), code, 4096u) != 0, "FlushInstructionCache");
}

static void prepare_state(
    B mode_byte, U state_4c, B shape_type, B bpp,
    I backend_init, U sse_flag, U mmx_flag,
    U clip_l, U clip_t, U clip_r, U clip_b,
    U color_init) {
    std::memset(&trace, 0, sizeof trace);
    for (U i = 0u; i < 12u; ++i) {
        window_shutdown_config_005de620[i] = 0x10000000u + i;
    }
    for (U i = 0u; i < 256u; ++i) {
        render_pixel_palette_006b4b20[i] = 0xff000000u | (i * 0x010203u);
    }
    window_shutdown_config_005de620[3] =
        static_cast<U>(shape_type) | (static_cast<U>(bpp) << 8u) | 0x00200000u;
    window_shutdown_config_005de620[5] = clip_l;
    window_shutdown_config_005de620[6] = clip_t;
    window_shutdown_config_005de620[7] = clip_r;
    window_shutdown_config_005de620[8] = clip_b;
    window_shutdown_mode_005de630 = mode_byte;
    window_shutdown_state_005de64c = state_4c;

    render_fill_backend_005decd8 = backend_init;
    shared_runtime_word_005deb1c = sse_flag;
    copy_flag_005deb18 = mmx_flag;
    render_fill_color_006a5bb8 = color_init;

    for (U i = 0u; i < kSpanBufBytes; ++i) {
        span_buf[i] = static_cast<B>((i * 37u + 11u) & 0xffu);
    }
}

static void snapshot_state() {
    require(trace.abi_fail == 0u, "ABI check");
    trace.color_after = render_fill_color_006a5bb8;
    trace.backend_after = render_fill_backend_005decd8;
    std::memcpy(trace.config_after, window_shutdown_config_005de620, sizeof trace.config_after);
    std::memcpy(trace.span_buf_after, span_buf, sizeof trace.span_buf_after);
}

static void run_562680_case(
    B mode_byte, U state_4c, B shape_type, B bpp,
    I backend_init, U sse_flag, U mmx_flag,
    I x, I y, U w, U h, U color, U fpu_mode,
    U span_slot, I mut_backend = -99) {
    ++cases;
    active_span_slot = span_slot;
    callback_mutate_backend = mut_backend;
    for (side = 0u; side < 2u; ++side) {
        prepare_state(mode_byte, state_4c, shape_type, bpp,
                      backend_init, sse_flag, mmx_flag,
                      10u, 20u, 110u, 220u, 0x77777777u);
        void* const fn = (side == 0u)
            ? static_cast<void*>(slot_562680)
            : reinterpret_cast<void*>(&splash_progress_draw_text_00562680);
        invoke_cdecl5_void(fn, static_cast<U>(x), static_cast<U>(y), w, h, color,
                           fpu_mode, trace.fp, trace.abi_fail);
        snapshot_state();
        if (side == 0u) {
            expected = trace;
        } else {
            require(std::memcmp(&trace, &expected, sizeof trace) == 0, "00562680 trace match");
        }
    }
}

static void run_537e00_case(
    B mode_byte, U state_4c, B shape_type, B bpp,
    I backend_init, U sse_flag, U mmx_flag,
    U clip_l, U clip_t, U clip_r, U clip_b,
    U color, U fpu_mode, U span_slot) {
    ++cases;
    active_span_slot = span_slot;
    callback_mutate_backend = -99;
    for (side = 0u; side < 2u; ++side) {
        prepare_state(mode_byte, state_4c, shape_type, bpp,
                      backend_init, sse_flag, mmx_flag,
                      clip_l, clip_t, clip_r, clip_b, 0x88888888u);
        void* const fn = (side == 0u)
            ? static_cast<void*>(slot_537e00)
            : reinterpret_cast<void*>(&render_display_fill_00537e00);
        invoke_cdecl1_void(fn, color, fpu_mode, trace.fp, trace.abi_fail);
        snapshot_state();
        if (side == 0u) {
            expected = trace;
        } else {
            require(std::memcmp(&trace, &expected, sizeof trace) == 0, "00537e00 trace match");
        }
    }
}

static void run_span_leaf_case(U leaf_index, U align_off, U count, U fill_color) {
    ++cases;
    void* const orig_fns[10] = {
        slot_562500, slot_562520, slot_562540, slot_562570,
        slot_5625a0, slot_5625c0, slot_5625e0,
        slot_562610, slot_562630, slot_562650,
    };
    void* const cpp_fns[10] = {
        reinterpret_cast<void*>(&render_fill_span_scalar_8_00562500),
        reinterpret_cast<void*>(&render_fill_span_scalar_16_00562520),
        reinterpret_cast<void*>(&render_fill_span_24_00562540),
        reinterpret_cast<void*>(&render_fill_span_scalar_32_00562570),
        reinterpret_cast<void*>(&render_fill_span_mmx_8_005625a0),
        reinterpret_cast<void*>(&render_fill_span_mmx_16_005625c0),
        reinterpret_cast<void*>(&render_fill_span_mmx_32_005625e0),
        reinterpret_cast<void*>(&render_fill_span_sse_8_00562610),
        reinterpret_cast<void*>(&render_fill_span_sse_16_00562630),
        reinterpret_cast<void*>(&render_fill_span_sse_32_00562650),
    };
    for (side = 0u; side < 2u; ++side) {
        prepare_state(0u, 0u, 0x7bu, 8u, 0, 0u, 0u, 0u, 0u, 64u, 64u, fill_color);
        void* const dst = span_buf + 32u + align_off;
        void* const fn = (side == 0u) ? orig_fns[leaf_index] : cpp_fns[leaf_index];
        const U ret = invoke_cdecl3_u32(fn, ptr(dst), 0x12345678u, count, trace.abi_fail);
        trace.ret_u32 = ret - ptr(dst);
        snapshot_state();
        if (side == 0u) {
            expected = trace;
        } else {
            require(std::memcmp(&trace, &expected, sizeof trace) == 0, "span leaf trace match");
        }
    }
}

int main(int argc, char** argv) {
    AddVectoredExceptionHandler(1, fault_handler);
    require(argc == 2, "PE path argument");
    init_fixture(argv[1]);

    // 1. Hardware 3D path of 00562680 across modes, bpp conversions, signed coordinates, FPU CW
    for (B mode : {static_cast<B>(1u), static_cast<B>(2u), static_cast<B>(0x7fu), static_cast<B>(0xfeu)}) {
        for (B bpp : {static_cast<B>(8u), static_cast<B>(15u), static_cast<B>(16u), static_cast<B>(24u), static_cast<B>(32u)}) {
            const U c0 = (bpp < 15u) ? 0x78u : 0x12345678u;
            const U c1 = (bpp < 15u) ? 0xefu : 0x00abcdefu;
            for (U fpu_mode : {0u, 1u}) {
                run_562680_case(mode, 0u, 0x6du, bpp, -1, 0u, 0u, -15, 25, 320u, 240u, c0, fpu_mode, 0u);
                run_562680_case(mode, 0u, 0x7bu, bpp, 3, 1u, 1u, 0, -1, 0xffffffffu, 0x80000001u, c1, fpu_mode, 0u);
            }
        }
    }

    // 2. Software path of 00562680: gates (mode=0, mode=0xff, state!=0), all switch bpp cases 0..33,
    // backend initialization (-1 with SSE/MMX/scalar flags) and pre-initialized backends 0..4,
    // plus post-00571630 backend reload to 3 vs 0.
    const B bpps[] = {0u, 3u, 4u, 5u, 7u, 8u, 9u, 14u, 15u, 16u, 17u, 24u, 32u};
    for (B bpp : bpps) {
        for (U flags : {0u, 1u, 2u, 3u}) {
            const U sse = (flags & 2u) ? 1u : 0u;
            const U mmx = (flags & 1u) ? 0x80000000u : 0u;
            run_562680_case(0u, 0u, 0x7bu, bpp, -1, sse, mmx, 12, 34, 64u, 48u, 0xa5b6c7d8u, 0u, bpp % 5u);
            run_562680_case(0xffu, 0u, 0x7du, bpp, -1, sse, mmx, -8, -16, 128u, 96u, 0x1f2e3d4cu, 0u, (bpp + 1u) % 5u);
            run_562680_case(1u, 0x1000u, 0x7eu, bpp, -1, sse, mmx, 100, 200, 1u, 1u, 0xffffffffu, 0u, (bpp + 2u) % 5u);
        }
        for (I preset : {0, 1, 2, 3, 4}) {
            run_562680_case(0u, 0u, 0x7bu, bpp, preset, 1u, 1u, 4, 8, 32u, 16u, 0x13579bdfu, 0u, static_cast<U>(preset));
        }
    }
    // Reload of 005decd8 after 00571630 returns
    run_562680_case(0u, 0u, 0x7bu, 16u, 0, 0u, 0u, 10, 20, 30u, 40u, 0x12345678u, 0u, 1u, 3);
    run_562680_case(0u, 0u, 0x7bu, 16u, 3, 0u, 1u, 10, 20, 30u, 40u, 0x12345678u, 0u, 1u, 0);

    // 3. Direct 00537e00 cases across hardware and software modes and clip rectangles
    const U rects[][4] = {
        {0u, 0u, 640u, 480u},
        {16u, 32u, 336u, 272u},
        {100u, 50u, 100u, 50u},
        {0xfffffff0u, 0xffffffe0u, 0x00000010u, 0x00000020u},
    };
    for (const auto& r : rects) {
        run_537e00_case(1u, 0u, 0x6du, 16u, -1, 0u, 0u, r[0], r[1], r[2], r[3], 0xff112233u, 0u, 0u);
        run_537e00_case(0u, 0u, 0x7bu, 8u, -1, 0u, 1u, r[0], r[1], r[2], r[3], 0x44556677u, 0u, 0u);
        run_537e00_case(1u, 0x2000u, 0x7fu, 32u, -1, 1u, 0u, r[0], r[1], r[2], r[3], 0x89abcdefu, 0u, 4u);
    }

    // 4. Direct span-fill callbacks 00562500..00562650 across alignments and counts
    for (U leaf = 0u; leaf < 10u; ++leaf) {
        for (U align_off : {0u, 1u, 2u, 3u, 4u, 7u, 15u}) {
            for (U count : {1u, 2u, 3u, 4u, 7u, 8u, 9u, 16u, 17u, 33u}) {
                run_span_leaf_case(leaf, align_off, count, 0xa1b2c3d4u ^ (leaf * 0x11111111u));
            }
        }
    }

    std::printf("render_fill_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
