static U ptr(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}

static U rd(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}

static void wr(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", msg, cases, side);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static LONG WINAPI fault_handler(EXCEPTION_POINTERS* p) {
    std::printf("divergence native-fault %08lx eip=%08lx case=%u side=%u\n",
                p->ExceptionRecord->ExceptionCode,
                p->ContextRecord->Eip,
                cases,
                side);
    std::fflush(stdout);
    ExitProcess(1);
    return EXCEPTION_CONTINUE_SEARCH;
}

static void record_event(U kind, U a0, U a1 = 0u, U a2 = 0u, U a3 = 0u, U a4 = 0u) {
    require(trace.event_count < kMaxEvents, "event capacity");
    trace.events[trace.event_count++] = {
        kind, a0, a1, a2, a3, a4,
        render_fill_color_006a5bb8,
        render_fill_backend_005decd8
    };
}

