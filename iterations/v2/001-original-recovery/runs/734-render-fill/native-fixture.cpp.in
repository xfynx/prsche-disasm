static void seed_fpu(U mode) {
    unsigned short cw = (mode == 1u) ? 0x027fu : 0x037fu;
    __asm {
        fninit
        fldcw cw
    }
}

static void capture_fpu(FpuSnapshot& fp) {
    std::memset(&fp, 0, sizeof fp);
    std::memset(fp_area, 0, sizeof fp_area);
    __asm {
        fxsave fp_area
    }
    std::memcpy(&fp.control, fp_area + 0, 2u);
    std::memcpy(&fp.status, fp_area + 2, 2u);
    fp.status &= 0xb8ffu;
    fp.tag = static_cast<unsigned short>(fp_area[4]);
    std::memcpy(&fp.mxcsr, fp_area + 24, 4u);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((static_cast<U>(fp.status) >> 11u) + i) & 7u;
        if ((fp_area[4] & (1u << physical)) != 0u) {
            std::memcpy(fp.values + i * 10u, fp_area + 32u + i * 16u, 10u);
        }
    }
}

static void invoke_cdecl1_void(void* fn, U a0, U fpu_mode, FpuSnapshot& fp_out, U& abi_fail) {
    U fail = 0u, before = 0u, frame = 0u;
    seed_fpu(fpu_mode);
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        push a0
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        call fn
        add esp, 4
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    capture_fpu(fp_out);
    abi_fail = fail;
}

static void invoke_cdecl5_void(void* fn, U a0, U a1, U a2, U a3, U a4, U fpu_mode, FpuSnapshot& fp_out, U& abi_fail) {
