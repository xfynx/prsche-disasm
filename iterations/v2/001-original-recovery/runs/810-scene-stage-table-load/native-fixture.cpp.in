static void reset_fixtures(U seed) {
    g_event_count = 0u;
    g_out_tag = 0xdeadbeefu;
    g_open_returns_data = true;
    g_open_has_owner = false;
    g_open_size = 0x80u;
    g_open_flag = 0u;
    std::memset(g_events, 0, sizeof g_events);
    std::memset(g_mapped_buf, static_cast<int>(0x40u + seed), sizeof g_mapped_buf);
    std::memset(g_table_buf, 0, sizeof g_table_buf);
    std::memset(g_self_obj, 0x11u, sizeof g_self_obj);
    std::memset(g_owner_obj, 0, sizeof g_owner_obj);
    store32(g_owner_obj, 0x00u, address(g_owner_vtable));
}

static void populate_table(U count) {
    store32(g_table_buf, 0x08u, count);
    for (U i = 0u; i < count; ++i) {
        store32(g_table_buf, 0x10u + i * 8u, 0x53485030u + i);
        store32(g_table_buf, 0x14u + i * 8u, 0x60u + i * 0x10u);
    }
    store32(g_table_buf, 0x10u + count * 8u, 0x53454e54u);
}

static void capture(Snapshot& out, U abi_fail, U ret_eax) {
    out.abi_fail = abi_fail;
    out.ret_eax = ret_eax;
    out.event_count = g_event_count;
    std::memcpy(out.events.data(), g_events, sizeof g_events);
    std::memcpy(out.mapped.data(), g_mapped_buf, sizeof g_mapped_buf);
    out.out_tag = g_out_tag;
}

static void check_equal(const Snapshot& orig, const Snapshot& cpp, const char* tag) {
    require(orig.abi_fail == 0u, tag);
    require(cpp.abi_fail == 0u, tag);
    require(orig.ret_eax == cpp.ret_eax, tag);
    require(orig.event_count == cpp.event_count, tag);
    for (U i = 0u; i < orig.event_count; ++i) {
        require(orig.events[i].kind == cpp.events[i].kind &&
                    orig.events[i].a == cpp.events[i].a &&
                    orig.events[i].b == cpp.events[i].b &&
                    orig.events[i].c == cpp.events[i].c &&
                    orig.events[i].d == cpp.events[i].d,
                tag);
    }
    require(orig.mapped == cpp.mapped, tag);
    require(orig.out_tag == cpp.out_tag, tag);
    ++cases;
}

int main() {
    init();

    // 1. 00537f30 & 00537f60 direct tests (count, in-bounds, out-of-bounds, negative index)
    for (U count : {0u, 3u, 5u}) {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(1u);
        populate_table(count);
        U f0 = invoke_cdecl_1(slot_00537f30, address(g_table_buf), r0);
        capture(orig, f0, r0);
        reset_fixtures(1u);
        populate_table(count);
        U f1 = invoke_cdecl_1(
            reinterpret_cast<const void*>(&porsche::scene_shape_table_count_00537f30),
            address(g_table_buf), r1);
        capture(cpp, f1, r1);
        check_equal(orig, cpp, "00537f30");

        for (I idx : {-1, 0, 2, 3, 5}) {
            reset_fixtures(1u);
            populate_table(count);
            f0 = invoke_cdecl_3_void(slot_00537f60, address(g_table_buf),
                                     static_cast<U>(idx), address(&g_out_tag));
            capture(orig, f0, 0u);
            reset_fixtures(1u);
            populate_table(count);
            f1 = invoke_cdecl_3_void(
                reinterpret_cast<const void*>(&porsche::scene_shape_table_tag_00537f60),
                address(g_table_buf), static_cast<U>(idx), address(&g_out_tag));
            capture(cpp, f1, 0u);
            check_equal(orig, cpp, "00537f60");
        }
    }

    // 2. 0059f880, 0059f8a0, 0059fb90 direct tests
    {
        Snapshot orig{}, cpp{};
        U r0 = 0u, r1 = 0u;
        reset_fixtures(2u);
        U f0 = invoke_thiscall_0(slot_0059f880, g_mapped_buf, r0);
        capture(orig, f0, 0u);
        reset_fixtures(2u);
        U f1 = invoke_thiscall_0(
            reinterpret_cast<const void*>(&porsche::scene_mapped_file_init_0059f880),
            g_mapped_buf, r1);
        capture(cpp, f1, 0u);
        check_equal(orig, cpp, "0059f880");

        for (U flag : {0u, 1u}) {
            for (U owner : {0u, 1u}) {
                for (U sz : {0u, 0x40u}) {
                    auto setup_mapped = [=]() {
                        store32(g_mapped_buf, 0x00u, owner ? address(g_owner_obj) : 0u);
                        store32(g_mapped_buf, 0x04u, address(g_table_buf));
                        store32(g_mapped_buf, 0x08u, 0x99u);
                        store32(g_mapped_buf, 0x0cu, sz);
                        g_mapped_buf[0x10u] = static_cast<B>(flag);
                    };
                    reset_fixtures(3u);
                    setup_mapped();
                    f0 = invoke_thiscall_0(slot_0059fb90, g_mapped_buf, r0);
                    capture(orig, f0, r0);
                    reset_fixtures(3u);
                    setup_mapped();
                    f1 = invoke_thiscall_0(
                        reinterpret_cast<const void*>(&porsche::scene_mapped_file_data_0059fb90),
                        g_mapped_buf, r1);
                    capture(cpp, f1, r1);
                    check_equal(orig, cpp, "0059fb90");
                }
            }
        }

        for (U has_data : {0u, 1u}) {
            for (U has_owner : {0u, 1u}) {
                auto setup_close = [=]() {
                    store32(g_mapped_buf, 0x00u, has_owner ? address(g_owner_obj) : 0u);
                    store32(g_mapped_buf, 0x04u, has_data ? address(g_table_buf) : 0u);
                    store32(g_mapped_buf, 0x08u, 0x77u);
                };
                reset_fixtures(4u);
                setup_close();
                f0 = invoke_thiscall_0(slot_0059f8a0, g_mapped_buf, r0);
                capture(orig, f0, 0u);
                reset_fixtures(4u);
                setup_close();
                f1 = invoke_thiscall_0(
                    reinterpret_cast<const void*>(&porsche::scene_mapped_file_close_0059f8a0),
                    g_mapped_buf, r1);
                capture(cpp, f1, 0u);
                check_equal(orig, cpp, "0059f8a0");
            }
        }
    }

    // 3. 0044d270 full table load cases (null table, 0 entries, 3 entries, owner vs page-release)
    const char path_str[] = "Data\\Fe\\common.fsh";
    for (bool has_data : {false, true}) {
        for (bool has_owner : {false, true}) {
            for (U count : {0u, 3u}) {
                Snapshot orig{}, cpp{};
                auto setup_load = [=]() {
                    g_open_returns_data = has_data;
                    g_open_has_owner = has_owner;
                    g_open_size = 0x100u;
                    g_open_flag = 0u;
                    populate_table(count);
                };
                reset_fixtures(5u);
                setup_load();
                U f0 = invoke_thiscall_2_void(
                    slot_0044d270, g_self_obj, address(path_str), 0x42u);
                capture(orig, f0, 0u);
                reset_fixtures(5u);
                setup_load();
                U f1 = invoke_thiscall_2_void(
                    reinterpret_cast<const void*>(&porsche::scene_stage_table_load_0044d270),
                    g_self_obj, address(path_str), 0x42u);
                capture(cpp, f1, 0u);
                check_equal(orig, cpp, "0044d270");
            }
        }
    }

    std::printf("scene_stage_table_load_810_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
