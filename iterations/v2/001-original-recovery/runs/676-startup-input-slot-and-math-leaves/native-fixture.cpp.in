#include "startup_input_slot_math_676.hpp"

using U = std::uint32_t;
using I = std::int32_t;
using B = std::uint8_t;

static_assert(sizeof(porsche::InputSlot) == 0x10cu);
static_assert(sizeof(porsche::input_slots_006be040) == 32u * 0x10cu);
static_assert(sizeof(porsche::fe_input_devices_005e8e60) == 32u);
static_assert(sizeof(porsche::frame_control_slot_fields_494) == 32u * 12u);

enum : U {
    kMaxEvents = 64u,
    kFillBufSize = 0x280u,
    kCanarySize = 16u,
    kFcRecordBytes = 0x90u,
};

enum EventKind : U {
    kEvFfCmd = 1u,
    kEvAcquire = 2u,
    kEvHeapFill = 3u,
    kEvGetState = 4u,
};

struct Event {
    U kind;
    U a0;
    U a1;
    U a2;
};

struct FpuSnapshot {
    unsigned short control;
    unsigned short status;
    unsigned short tag;
    unsigned short pad;
    B values[80];
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_u32;
    U event_count;
    Event events[kMaxEvents];
    porsche::FrameControlSlotFields_494 fc_fields[32];
    B fill_area[kCanarySize + kFillBufSize + kCanarySize];
    FpuSnapshot fp;
};

alignas(16) static B fp_area[512] = {};
static B fp_env[28] = {};

static B* code = nullptr;
static B* slot_532b50 = nullptr;
static B* slot_533160 = nullptr;
static B* slot_533480 = nullptr;
static B* slot_532ff0 = nullptr;
static B* slot_4116d0 = nullptr;
static B* slot_411710 = nullptr;

// Flat original 32 x 0x90-byte records for 0069cb90..0069dd8f.
alignas(16) static B orig_fc_slots[32u * kFcRecordBytes] = {};
alignas(16) static B fill_arena[kCanarySize + kFillBufSize + kCanarySize] = {};
alignas(16) static B caps_buf[64] = {};

static Trace trace{};
static Trace expected{};
static U cases = 0u;
static U which = 0u;

