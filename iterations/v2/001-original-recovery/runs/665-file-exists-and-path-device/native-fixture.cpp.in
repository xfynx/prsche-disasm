static const char orig_str_5cd1f4[2] = {@STR_005CD1F4@};

static U cases = 0u;
alignas(16) static B floating[512] = {};
alignas(16) static char str_arena[300] = {};
static B ctx_arena[64] = {};

enum EventTag : U {
    kEvFullPath = 1u,
    kEvCharUpper = 2u,
    kEvAlloc = 3u,
    kEvOpName = 4u,
    kEvQueue = 5u,
    kEvWait = 6u,
    kEvComplete = 7u,
};

struct Event {
    U tag;
    U a0;
    U a1;
    U a2;
    U a3;
    char text[128];
};

struct Fpu {
    unsigned short control, status;
    B tag, padding[3], values[80];
    unsigned short full_tag;
    U mxcsr;
};

struct Trace {
    U abi_fail;
    U ret_eax;
    U count;
    Event events[16];
    Fpu fpu;
};

static Trace trace{};
static Trace expected{};

struct StubCfg {
    char full_path[261];
    U full_path_ret;
    bool alloc_null;
    U queue_ret;
    U complete_ret;
};

static StubCfg stub_cfg{};
static porsche::FileOperation dummy_op{};
static const char* expected_str_base = nullptr;

static void require(bool ok, const char* msg) {
    if (!ok) {
        std::printf("divergence %s case=%u\n", msg, cases);
        std::fflush(stdout);
        ExitProcess(1);
    }
}

static U normalize_ptr(U p) {
    if (p == 0u) return 0u;
    if (p == address(&dummy_op)) return 0xa1000000u;
    if (p >= address(ctx_arena) && p < address(ctx_arena) + sizeof(ctx_arena)) {
        return 0xa2000000u + (p - address(ctx_arena));
    }
    if (expected_str_base != nullptr &&
        p >= address(expected_str_base) &&
        p <= address(expected_str_base) + 280u) {
        return 0xa3000000u + (p - address(expected_str_base));
    }
    return p;
}

static void copy_text(char* dst, std::size_t cap, const char* src) {
    if (src == nullptr) {
        std::snprintf(dst, cap, "<null>");
        return;
    }
    std::snprintf(dst, cap, "%s", src);
}

static Event& push_event(
    U tag, U a0 = 0u, U a1 = 0u, U a2 = 0u, U a3 = 0u, const char* text = nullptr) {
    require(trace.count < 16u, "event capacity");
    Event& e = trace.events[trace.count++];
    std::memset(&e, 0, sizeof(e));
    e.tag = tag;
    e.a0 = a0;
    e.a1 = a1;
    e.a2 = a2;
    e.a3 = a3;
    if (text != nullptr) {
        copy_text(e.text, sizeof(e.text), text);
    }
    return e;
}

static U __stdcall stub_get_full_path_name_a(
    const char* file_name, U buffer_length, char* buffer, char** file_part) {
    const U has_buf = (buffer != nullptr) ? 1u : 0u;
    const U has_part = (file_part != nullptr) ? 1u : 0u;
    push_event(kEvFullPath, buffer_length, has_buf, has_part, 0u, file_name);
    if (buffer != nullptr && buffer_length > 0u) {
        std::snprintf(buffer, buffer_length, "%s", stub_cfg.full_path);
        if (file_part != nullptr) {
            *file_part = buffer;
        }
    }
    return stub_cfg.full_path_ret;
}

static char* __stdcall stub_char_upper_a(char* text) {
    if (text != nullptr) {
        for (char* p = text; *p != '\0'; ++p) {
            if (*p >= 'a' && *p <= 'z') {
                *p = static_cast<char>(*p - ('a' - 'A'));
            }
        }
    }
    push_event(kEvCharUpper, text != nullptr ? 1u : 0u, 0u, 0u, 0u, text);
    return text;
}

