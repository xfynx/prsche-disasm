static void capture_fpu(Fpu& f) {
    std::memset(&f, 0, sizeof f);
    B env[28];
    __asm {
        fxsave floating
        fnstenv env
        fldenv env
    }
    f.control = *reinterpret_cast<unsigned short*>(floating);
    f.status = *reinterpret_cast<unsigned short*>(floating + 2);
    f.tag = floating[4];
    std::memset(f.padding, 0, 3);
    f.full_tag = *reinterpret_cast<unsigned short*>(env + 8);
    f.mxcsr = *reinterpret_cast<U*>(floating + 24);
    for (U i = 0u; i < 8u; ++i) {
        const U physical = ((f.status >> 11) + i) & 7u;
        if (f.tag & (1u << physical)) {
            std::memcpy(f.values + i * 10u, floating + 32u + i * 16u, 10u);
        } else {
            std::memset(f.values + i * 10u, 0, 10u);
        }
    }
}

static void seed_fpu() {
    __asm {
        fninit
        fldpi
        fld1
        faddp st(1), st(0)
        fstp st(0)
    }
}

static U invoke_cdecl1(void* fn, U arg0, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        push arg0
        call fn
        add esp, 4
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static U invoke_cdecl2(void* fn, U arg0, U arg1, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        push arg1
        push arg0
        call fn
        add esp, 8
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static U invoke_cdecl3(void* fn, U arg0, U arg1, U arg2, U& ret_eax) {
    U before = 0u, frame = 0u, fail = 0u, eax_out = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0cafe1234h
        mov ecx, 01234567h
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        push arg2
        push arg1
        push arg0
        call fn
        add esp, 12
        mov eax_out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        je done
    bad:
        mov fail, 1
    done:
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    ret_eax = eax_out;
    return fail;
}

static void relocate_abs32(B* slot, U off, U orig, U replacement) {
    require(word(slot, off) == orig, "exact absolute relocation offset");
    put(slot, off, replacement);
}

static void relocate_rel32(B* slot, U base_va, U off, U orig_target, const void* target) {
    const U insn_va = base_va + off + 4u;
    const U expected_rel = orig_target - insn_va;
    require(word(slot, off) == expected_rel, "exact relative offset");
    const U new_rel = address(target) - (address(slot) + off + 4u);
    put(slot, off, new_rel);
}

static void init() {
    require(porsche::platform_disk_get_full_path_name != nullptr, "initial fullpath");
    require(porsche::platform_disk_char_upper != nullptr, "initial charupper");
    require(sizeof(orig_str_5cd1f4) == 2u && std::strcmp(orig_str_5cd1f4, ".") == 0, "shared dot literal");

    porsche::platform_disk_get_full_path_name = stub_get_full_path_name_a;
    porsche::platform_disk_char_upper = stub_char_upper_a;

    static const B tail_5a2770[] = {@TAIL_005A2770@};
    static const B body_5a2780[] = {@BODY_005A2780@};
    static const B body_5916a0[] = {@BODY_005916A0@};
    static const B body_591760[] = {@BODY_00591760@};
    static const B body_568e90[] = {@BODY_00568E90@};
    static const B body_568260[] = {@BODY_00568260@};
    static const B body_533f00[] = {@BODY_00533F00@};
    static const B body_561b80[] = {@BODY_00561B80@};
    require(sizeof tail_5a2770 == 5u, "5-byte shared CRT tail 005a2770");
    require(sizeof body_5a2780 == 188u, "188-byte original body 005a2780");
    require(sizeof body_5916a0 == 111u, "111-byte original body 005916a0");
    require(sizeof body_591760 == 27u, "27-byte original body 00591760");
    require(sizeof body_568e90 == 35u, "35-byte original body 00568e90");
    require(sizeof body_568260 == 51u, "51-byte original body 00568260");
    require(sizeof body_533f00 == 52u, "52-byte original body 00533f00");
    require(sizeof body_561b80 == 20u, "20-byte original body 00561b80");

    code = static_cast<B*>(
        VirtualAlloc(nullptr, 4096u, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
    require(code != nullptr, "raw executable allocation");

    slot_5a2770 = code;
    slot_5a2780 = code + 0x010u;
    slot_5916a0 = code + 0x100u;
    slot_591760 = code + 0x200u;
    slot_568e90 = code + 0x300u;
    slot_568260 = code + 0x400u;
    slot_533f00 = code + 0x500u;
    slot_561b80 = code + 0x600u;

    std::memcpy(slot_5a2770, tail_5a2770, sizeof tail_5a2770);
    std::memcpy(slot_5a2780, body_5a2780, sizeof body_5a2780);
    std::memcpy(slot_5916a0, body_5916a0, sizeof body_5916a0);
    std::memcpy(slot_591760, body_591760, sizeof body_591760);
    std::memcpy(slot_568e90, body_568e90, sizeof body_568e90);
    std::memcpy(slot_568260, body_568260, sizeof body_568260);
    std::memcpy(slot_533f00, body_533f00, sizeof body_533f00);
    std::memcpy(slot_561b80, body_561b80, sizeof body_561b80);

    // Relocate 005916a0.
    relocate_rel32(slot_5916a0, 0x005916a0u, 0x012u, 0x005a2780u, slot_5a2780);
    relocate_abs32(slot_5916a0, 0x026u, 0x005cd1f4u, address(orig_str_5cd1f4));
    relocate_abs32(
        slot_5916a0, 0x03cu, 0x005b221cu, address(&porsche::platform_disk_get_full_path_name));
    relocate_abs32(
        slot_5916a0, 0x049u, 0x005b2290u, address(&porsche::platform_disk_char_upper));

    // Relocate 00591760.
    relocate_rel32(slot_591760, 0x00591760u, 0x006u, 0x005916a0u, slot_5916a0);

    // Relocate 00568e90.
    relocate_rel32(slot_568e90, 0x00568e90u, 0x009u, 0x005a2780u, slot_5a2780);
    relocate_rel32(slot_568e90, 0x00568e90u, 0x016u, 0x00591760u, slot_591760);

    // Relocate 00568260.
    relocate_rel32(slot_568260, 0x00568260u, 0x008u, 0x00568e90u, slot_568e90);
    relocate_rel32(
        slot_568260, 0x00568260u, 0x01au, 0x005682a0u,
        reinterpret_cast<const void*>(&porsche::operation_allocate_005682a0));
    relocate_rel32(
        slot_568260, 0x00568260u, 0x023u, 0x005684e0u,
        reinterpret_cast<const void*>(&porsche::operation_name_005684e0));
    relocate_rel32(
        slot_568260, 0x00568260u, 0x029u, 0x00568200u,
        reinterpret_cast<const void*>(&porsche::operation_queue_00568200));

    // Relocate 00533f00.
    relocate_rel32(slot_533f00, 0x00533f00u, 0x010u, 0x00568260u, slot_568260);
    relocate_rel32(
        slot_533f00, 0x00533f00u, 0x01fu, 0x00567f70u,
        reinterpret_cast<const void*>(&porsche::file_wait_00567f70));
    relocate_rel32(
        slot_533f00, 0x00533f00u, 0x025u, 0x00567df0u,
        reinterpret_cast<const void*>(&porsche::operation_complete_00567df0));

    // Relocate 00561b80.
    relocate_abs32(
        slot_561b80, 0x001u, 0x005df770u, address(&porsche::resource_leaf_group_005df770));
    relocate_rel32(slot_561b80, 0x00561b80u, 0x00cu, 0x00533f00u, slot_533f00);
}

struct CaseEnv {
    const char* full_path;
    U full_path_ret;
    U leaf_group;
    bool alloc_null;
    U queue_ret;
    U complete_ret;
};

static void setup_env(const CaseEnv& c) {
    std::memset(&trace, 0, sizeof trace);
    std::memset(&dummy_op, 0x5au, sizeof dummy_op);
    std::memset(ctx_arena, 0x33, sizeof ctx_arena);
    porsche::resource_leaf_group_005df770 = c.leaf_group;
    stub_cfg = {};
    if (c.full_path != nullptr) {
        std::snprintf(stub_cfg.full_path, sizeof stub_cfg.full_path, "%s", c.full_path);
    }
    stub_cfg.full_path_ret = c.full_path_ret;
    stub_cfg.alloc_null = c.alloc_null;
    stub_cfg.queue_ret = c.queue_ret;
    stub_cfg.complete_ret = c.complete_ret;
}

static void compare_traces() {
    require(trace.abi_fail == 0u, "original ABI");
    require(expected.abi_fail == 0u, "recovered ABI");
    require(trace.ret_eax == expected.ret_eax, "return value");
    require(trace.count == expected.count, "event count");
    for (U i = 0u; i < trace.count; ++i) {
        require(trace.events[i].tag == expected.events[i].tag, "event tag");
        require(trace.events[i].a0 == expected.events[i].a0, "event a0");
        require(trace.events[i].a1 == expected.events[i].a1, "event a1");
        require(trace.events[i].a2 == expected.events[i].a2, "event a2");
        require(trace.events[i].a3 == expected.events[i].a3, "event a3");
        require(std::strcmp(trace.events[i].text, expected.events[i].text) == 0, "event text");
    }
    require(trace.fpu.control == expected.fpu.control, "x87 control");
    require(trace.fpu.status == expected.fpu.status, "x87 status");
    require(trace.fpu.tag == expected.fpu.tag, "x87 tag");
    require(trace.fpu.full_tag == expected.fpu.full_tag, "x87 full tag");
    require(trace.fpu.mxcsr == expected.fpu.mxcsr, "mxcsr");
    require(std::memcmp(trace.fpu.values, expected.fpu.values, 80u) == 0, "x87 stack");
}

static void verify_strchr_case(const char* bytes, std::size_t len, U align_off, int ch) {
    ++cases;
    std::memset(str_arena, 0x77, sizeof str_arena);
    char* const s = str_arena + align_off;
    std::memcpy(s, bytes, len);
    expected_str_base = s;

    CaseEnv env{"", 0u, 0u, false, 0u, 0u};
    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl2(slot_5a2780, address(s), static_cast<U>(ch), trace.ret_eax);
    trace.ret_eax = normalize_ptr(trace.ret_eax);
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl2(
        reinterpret_cast<void*>(&porsche::formatter_search_character_005a2780),
        address(s),
        static_cast<U>(ch),
        trace.ret_eax);
    trace.ret_eax = normalize_ptr(trace.ret_eax);
    capture_fpu(trace.fpu);
    compare_traces();
    expected_str_base = nullptr;
}

static void verify_drive_letter_case(const char* path, const CaseEnv& env) {
    ++cases;
    expected_str_base = path;
    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl1(slot_5916a0, address(path), trace.ret_eax);
    trace.ret_eax &= 0xffu;
    capture_fpu(trace.fpu);
    expected = trace;

    setup_env(env);
    seed_fpu();
    trace.abi_fail = invoke_cdecl1(
        reinterpret_cast<void*>(&porsche::disk_path_drive_letter_005916a0),
        address(path),
        trace.ret_eax);
    trace.ret_eax &= 0xffu;
    capture_fpu(trace.fpu);
    compare_traces();
    expected_str_base = nullptr;
}

