using U = std::uint32_t;
using B = std::uint8_t;

static U address(const void* p) {
    return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));
}
static U word(const void* p, U o = 0u) {
    U v = 0u;
    std::memcpy(&v, static_cast<const B*>(p) + o, 4u);
    return v;
}
static void put(void* p, U o, U v) {
    std::memcpy(static_cast<B*>(p) + o, &v, 4u);
}

static B* code = nullptr;
static B* slot_5a2770 = nullptr;
static B* slot_5a2780 = nullptr;
static B* slot_5916a0 = nullptr;
static B* slot_591760 = nullptr;
static B* slot_568e90 = nullptr;
static B* slot_568260 = nullptr;
