FileOperation* __cdecl operation_allocate_005682a0(
    std::uint32_t type, std::uint8_t group, void* context, std::uint32_t device) {
    push_event(kEvAlloc, type, static_cast<U>(group), normalize_ptr(address(context)), device);
    return stub_cfg.alloc_null ? nullptr : &dummy_op;
}

void __cdecl operation_name_005684e0(FileOperation* op, const char* name) {
    push_event(kEvOpName, normalize_ptr(address(op)), 0u, 0u, 0u, name);
}

std::uint32_t __cdecl operation_queue_00568200(FileOperation* op) {
    push_event(kEvQueue, normalize_ptr(address(op)));
    return stub_cfg.queue_ret;
}

std::int32_t __cdecl file_wait_00567f70(std::uint32_t id) {
    push_event(kEvWait, id);
    return 0;
}

std::uint32_t __cdecl operation_complete_00567df0(std::uint32_t id) {
    push_event(kEvComplete, id);
    return stub_cfg.complete_ret;
}

