int main() {
    init();

    // 1. formatter_search_character_005a2780 across alignments 0..3, NUL hits, high-bit carries, and truncation.
    const char s_empty[] = "";
    const char s_short[] = "a|b";
    const char s_long[] = "0123456789abcdef|tail";
    const char s_hibyte[] = "\x80\x81\xfe\xff\x01\x7f|z";
    const int chars[] = {0, 0x100, 'a', '|', 0x17c, 'z', '9', 0x80, 0x180, 0xfe, 0xff, -1, 'Q'};
    for (U align = 0u; align < 4u; ++align) {
        for (int ch : chars) {
            verify_strchr_case(s_empty, sizeof s_empty, align, ch);
            verify_strchr_case(s_short, sizeof s_short, align, ch);
            verify_strchr_case(s_long, sizeof s_long, align, ch);
            verify_strchr_case(s_hibyte, sizeof s_hibyte, align, ch);
        }
    }

    // 2. disk_path_drive_letter_005916a0, disk_path_device_00591760, file_device_name_00568e90.
    struct PathCase {
        const char* path;
        CaseEnv env;
    };
    const PathCase path_cases[] = {
        {".", {"c:\\work\\porsche", 15u, 0u, false, 0u, 0u}},
        {"a:\\track.bin", {"a:\\track.bin", 12u, 0u, false, 0u, 0u}},
        {"z:rel", {"z:\\rel", 6u, 0u, false, 0u, 0u}},
        {"e:", {"e:", 2u, 0u, false, 0u, 0u}},
        {"c:\\bad|pipe", {"c:\\bad|pipe", 11u, 0u, false, 0u, 0u}},
        {"|", {"|", 1u, 0u, false, 0u, 0u}},
        {"\\\\server\\share\\file", {"\\\\server\\share\\file", 19u, 0u, false, 0u, 0u}},
        {"c;\\colonmiss", {"c;\\colonmiss", 12u, 0u, false, 0u, 0u}},
        {"short0", {"", 0u, 0u, false, 0u, 0u}},
        {"short1", {"d", 1u, 0u, false, 0u, 0u}},
        {"short1_colon", {"d:", 1u, 0u, false, 0u, 0u}},
        {"neg_len", {"f:\\neg", 0x80000002u, 0u, false, 0u, 0u}},
        {"hibyte_drv", {"\x81:\\hi", 5u, 0u, false, 0u, 0u}},
    };
    for (const PathCase& pc : path_cases) {
        verify_drive_letter_case(pc.path, pc.env);
        verify_path_device_case(pc.path, pc.env);
        verify_file_device_case(pc.path, pc.env);
    }

    // 3. request_exists_00568260.
    verify_request_exists_case(
        "d:\\cars\\911.viv", 0x123456abu, ctx_arena + 8, {"d:\\cars\\911.viv", 15u, 0u, false, 0x201u, 0u});
    verify_request_exists_case(
        "bad|name", 0x05u, nullptr, {"bad|name", 8u, 0u, false, 0x202u, 0u});
    verify_request_exists_case(
        "c:\\nullop.dat", 0x7fu, ctx_arena, {"c:\\nullop.dat", 12u, 0u, true, 0u, 0u});

    // 4. file_exists_sync_00533f00.
    verify_exists_sync_case(
        "c:\\ok.dat", 0x31u, {"c:\\ok.dat", 9u, 0u, false, 0x301u, 1u});
    verify_exists_sync_case(
        "c:\\miss.dat", 0x32u, {"c:\\miss.dat", 11u, 0u, false, 0x302u, 0u});
    verify_exists_sync_case(
        "c:\\failq.dat", 0x33u, {"c:\\failq.dat", 12u, 0u, false, 0u, 1u});
    verify_exists_sync_case(
        "c:\\negcomp.dat", 0x34u, {"c:\\negcomp.dat", 14u, 0u, false, 0x303u, 0xffffffffu});

    // 5. file_exists_00561b80.
    verify_exists_case(
        "c:\\gamedata\\audio.bnk", {"c:\\gamedata\\audio.bnk", 23u, 0x64u, false, 0x401u, 1u});
    verify_exists_case(
        "d:\\gamedata\\missing.bnk", {"d:\\gamedata\\missing.bnk", 25u, 0x12u, false, 0x402u, 0u});
    verify_exists_case(
        "e:\\pipe|blocked", {"e:\\pipe|blocked", 15u, 0x77u, false, 0u, 1u});
    verify_exists_case(
        ".", {"g:\\root\\.", 9u, 0xffu, false, 0x403u, 1u});

    std::printf("file_exists_and_path_device_original_x86_vs_cpp=PASS cases=%u\n", cases);
    return 0;
}
