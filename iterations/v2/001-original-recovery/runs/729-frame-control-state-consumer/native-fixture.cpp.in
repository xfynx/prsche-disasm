#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <initializer_list>

#include "frame_control_state_729.hpp"

using U = std::uint32_t;
using I = std::int32_t;
using S = std::int16_t;
using B = std::uint8_t;
using namespace porsche;

static B* code;
static U cases, side, mode, enabled, initial_index, pattern;
struct Trace { U abi, count; I calls[8]; B state[0x134]; };
static Trace trace, expected;

static void require(bool ok, const char* why) {
    if (!ok) {
        std::printf("divergence %s case=%u side=%u\n", why, cases, side);
        std::fflush(stdout);
        ExitProcess(1);
    }
}
static LONG WINAPI fault(EXCEPTION_POINTERS* e) {
    std::printf("divergence native-fault %08lx case=%u side=%u\n",
                e->ExceptionRecord->ExceptionCode, cases, side);
    std::fflush(stdout);
    ExitProcess(1);
    return EXCEPTION_CONTINUE_SEARCH;
}
static U ptr(const void* p) { return reinterpret_cast<U>(p); }
static U read_u32(const void* p) { U x; std::memcpy(&x, p, 4); return x; }
static void write_u32(void* p, U x) { std::memcpy(p, &x, 4); }
static void write_i16(void* p, S x) { std::memcpy(p, &x, 2); }

static void write_row(U row, S a, S b, S c, S d) {
    B* const p = frame_control_ff_state_005e9408 + 0x18u + row * 8u;
    write_i16(p + 0, a); write_i16(p + 2, b);
    write_i16(p + 4, c); write_i16(p + 6, d);
}

static void release_endpoint(I slot) {
    require(trace.count < 8, "endpoint bound");
    trace.calls[trace.count++] = slot;
    const U current = read_u32(frame_control_ff_state_005e9408 + 8u);
    if (mode == 1u && trace.count == 1u) {
        const U next = (current + 9u) & 31u;
        write_u32(frame_control_ff_state_005e9408 + 8u, next);
        write_row(next, static_cast<S>(-32768), 32767, -7, 39);
    } else if (mode == 2u && trace.count == 2u) {
        const U next = (current + 21u) & 31u;
        write_u32(frame_control_ff_state_005e9408 + 8u, next);
        write_row(next, 32767, static_cast<S>(-32768), 17, -29);
    } else if (mode == 3u && trace.count == 1u) {
        write_row(current, 101, -102, 103, -104);
    }
}

namespace porsche {
void __cdecl frame_control_slot_release_005338d0(std::int32_t slot) {
    release_endpoint(slot);
}
void __cdecl input_zero_memory_00532ff0(void*, std::uint32_t) { ExitProcess(91); }
bool __cdecl fe_input_any_attached_004116d0() { ExitProcess(92); return false; }
bool __cdecl fe_input_device_attached_00411710(std::int32_t) { ExitProcess(93); return false; }
void* __cdecl fe_input_getstate_00532e10(std::uint32_t, std::uint32_t) { ExitProcess(94); return nullptr; }
std::uint32_t __cdecl input_slot_enable_ff_005330a0(std::int32_t) { ExitProcess(95); return 0; }
std::int32_t __cdecl frame_control_slot_create_005334e0(std::int32_t, const FeEffectParams*) { ExitProcess(96); return -1; }
void __cdecl input_slot_set_ff_gain_005333a0(std::int32_t, std::int32_t) { ExitProcess(97); }
}

static U invoke_cdecl0(void* fn, U& abi_fail) {
    U out = 0u, fail = 0u, before = 0u, frame = 0u;
    __asm {
        push ebx
        push esi
        push edi
        mov before, esp
        mov frame, ebp
        mov eax, 0a5a5a500h
        mov ecx, 0cafebabeh
        mov edx, 0deadc0deh
        mov ebx, 13579bdfh
        mov esi, 2468ace0h
        mov edi, 10203040h
        cld
        call fn
        mov out, eax
        cmp esp, before
        jne bad
        cmp ebp, frame
        jne bad
        cmp ebx, 13579bdfh
        jne bad
        cmp esi, 2468ace0h
        jne bad
        cmp edi, 10203040h
        jne bad
        pushfd
        pop eax
        test eax, 400h
        jne bad
        jmp done
    bad:
        mov fail, 1
    done:
        cld
        mov esp, before
        pop edi
        pop esi
        pop ebx
    }
    abi_fail = fail;
    return out;
}

static bool initial_owner_state_is_zero(const char* path) {
    FILE* f = std::fopen(path, "rb");
    if (f == nullptr) return false;
    std::fseek(f, 0, SEEK_END);
    const long bytes = std::ftell(f);
    std::rewind(f);
    auto* image = new B[static_cast<std::size_t>(bytes)];
    if (std::fread(image, 1, static_cast<std::size_t>(bytes), f) != static_cast<std::size_t>(bytes)) {
        std::fclose(f); delete[] image; return false;
    }
    std::fclose(f);
    const U nt = read_u32(image + 0x3cu);
    const U base = read_u32(image + nt + 52u);
    const U section_count = image[nt + 6u] | (U(image[nt + 7u]) << 8u);
    const U optional = image[nt + 20u] | (U(image[nt + 21u]) << 8u);
    bool found = false, ok = true;
    for (U i = 0; i < section_count; ++i) {
        const B* section = image + nt + 24u + optional + i * 40u;
        const U virtual_size = read_u32(section + 8u);
        const U rva = read_u32(section + 12u);
        const U raw_size = read_u32(section + 16u);
        const U raw = read_u32(section + 20u);
        const U delta = 0x5e9408u - base - rva;
        if (delta >= virtual_size || 0x134u > virtual_size - delta) continue;
        found = true;
        for (U j = 0; j < 0x134u; ++j) {
            const B expected_byte = delta + j < raw_size ? image[raw + delta + j] : 0u;
            if (frame_control_ff_state_005e9408[j] != expected_byte) ok = false;
        }
    }
    delete[] image;
    return found && ok;
}

static void absolute(U offset, U size, U old, U replacement, U count) {
    U found = 0;
    for (U i = 0; i + 4u <= size; ++i) {
        if (read_u32(code + offset + i) == old) {
            write_u32(code + offset + i, replacement);
            ++found; i += 3u;
        }
    }
    require(found == count, "raw absolute relocation");
}
static void relative_call(U offset, U original_target, U new_target) {
    require(code[offset] == 0xe8u &&
            0x412030u + offset + 5u + read_u32(code + offset + 1u) == original_target,
            "raw relative call");
    write_u32(code + offset + 1u, new_target - ptr(code + offset + 5u));
}
static void init(const char* pe) {
    require(initial_owner_state_is_zero(pe), "Run695 canonical loader-zero state");
    code = static_cast<B*>(VirtualAlloc(nullptr, 4096, 0x3000, 0x40));
    require(code != nullptr, "allocate oracle code");
    const B body[] = {@BODY_00412030@};
    std::memcpy(code, body, sizeof(body));
    absolute(0, 91, 0x5e940c, ptr(frame_control_ff_state_005e9408) + 4u, 1);
    absolute(0, 91, 0x5e9410, ptr(frame_control_ff_state_005e9408) + 8u, 4);
    absolute(0, 91, 0x5e9424, ptr(frame_control_ff_state_005e9408) + 0x1cu, 1);
    absolute(0, 91, 0x5e9422, ptr(frame_control_ff_state_005e9408) + 0x1au, 1);
    absolute(0, 91, 0x5e9420, ptr(frame_control_ff_state_005e9408) + 0x18u, 1);
    absolute(0, 91, 0x5e9426, ptr(frame_control_ff_state_005e9408) + 0x1eu, 1);
    relative_call(0x17, 0x5338d0, ptr(reinterpret_cast<void*>(&frame_control_slot_release_005338d0)));
    relative_call(0x2b, 0x5338d0, ptr(reinterpret_cast<void*>(&frame_control_slot_release_005338d0)));
    relative_call(0x3f, 0x5338d0, ptr(reinterpret_cast<void*>(&frame_control_slot_release_005338d0)));
    relative_call(0x52, 0x5338d0, ptr(reinterpret_cast<void*>(&frame_control_slot_release_005338d0)));
    require(FlushInstructionCache(GetCurrentProcess(), code, 4096) != 0, "flush oracle");
}

static void seed() {
    std::memset(&trace, 0, sizeof(trace));
    std::memset(frame_control_ff_state_005e9408, 0xa5, 0x134u);
    write_u32(frame_control_ff_state_005e9408 + 4u, enabled);
    write_u32(frame_control_ff_state_005e9408 + 8u, initial_index);
    for (U row = 0; row < 32; ++row) {
        switch (pattern) {
        case 0: write_row(row, static_cast<S>(row), -1, static_cast<S>(31 - row), static_cast<S>(-32768)); break;
        case 1: write_row(row, 32767, static_cast<S>(-32768), 0, 31); break;
        case 2: write_row(row, -1, 0, 32767, static_cast<S>(-32768)); break;
        case 3: write_row(row, static_cast<S>(row - 16), static_cast<S>(16 - row), static_cast<S>(row & 1u ? 32767 : -32768), static_cast<S>(-static_cast<I>(row))); break;
        case 4: write_row(row, 0, 31, -1, 32767); break;
        default: write_row(row, static_cast<S>(-32768), 32767, 1, -1); break;
        }
    }
}

static void check() {
    ++cases;
    for (side = 0; side < 2; ++side) {
        seed();
        U abi = 0;
        (void)invoke_cdecl0(side == 0 ? static_cast<void*>(code)
                                      : reinterpret_cast<void*>(&application_main_function_00412030), abi);
        require(abi == 0, "cdecl ABI");
        trace.abi = abi;
        std::memcpy(trace.state, frame_control_ff_state_005e9408, sizeof(trace.state));
        if (side == 0) expected = trace;
        else require(std::memcmp(&trace, &expected, sizeof(trace)) == 0,
                     "event sequence and full owner state");
    }
}

int main(int argc, char** argv) {
    AddVectoredExceptionHandler(1, fault);
    require(argc == 2, "PE argument");
    init(argv[1]);
    const U gates[] = {0u, 1u, 0x80000000u};
    for (U gate : gates)
        for (U row = 0; row < 32; ++row)
            for (pattern = 0; pattern < 6; ++pattern)
                for (mode = 0; mode < 4; ++mode) {
                    enabled = gate; initial_index = row; check();
                }
    std::printf("frame_control_00412030_original_x86_vs_cpp=PASS cases=%u ABI=PASS owner695=PASS index_table_reloads=PASS signed_rows=0..31\n", cases);
    return 0;
}
